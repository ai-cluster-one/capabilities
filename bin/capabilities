# ---------------------------------------------------------------- I/O contract

def _emit(value) -> None:
    if isinstance(value, str):
        sys.stdout.write(value if value.endswith("\n") else value + "\n")
    else:
        sys.stdout.write(json.dumps(value, ensure_ascii=False, indent=2) + "\n")


def _die(exit_code: int, code: str, message: str, hint: str | None = None) -> NoReturn:
    err: dict = {"code": code, "message": message}
    if hint:
        err["hint"] = hint
    sys.stderr.write(json.dumps({"error": err}, ensure_ascii=False) + "\n")
    sys.exit(exit_code)


def _store_lost(kind, exc, trace) -> None:
    """A store connection lost where nothing caught it ends the command as the
    store being unreachable, exit 5, rather than with a traceback: the database
    library has already tried again everything it safely could."""
    driver = sys.modules.get("psycopg")
    if driver is None or not isinstance(exc, driver.OperationalError):
        _UNCAUGHT[0](kind, exc, trace)
        return
    try:
        _die(5, "store_unreachable",
             "the store stopped answering: " + " ".join(str(exc).split())[:300],
             "check the database setting with `capabilities store doctor`")
    except SystemExit:
        pass
    import atexit
    atexit._run_exitfuncs()
    sys.stdout.flush()
    sys.stderr.flush()
    os._exit(5)


_UNCAUGHT = [sys.excepthook]
sys.excepthook = _store_lost


def _warn(message: str) -> None:
    sys.stderr.write(json.dumps({"warning": message}, ensure_ascii=False) + "\n")


_STORE_MODULE = None


def _store_module():
    """Load the canonical records tier from the manager's shipped assets.

    Capability executables carry a stamped copy so a manager update cannot
    change them underneath a running installation. The manager is the owner of
    this source, so it consumes the source module directly instead of carrying
    a thirty-first generated copy.
    """
    global _STORE_MODULE
    if _STORE_MODULE is not None:
        return _STORE_MODULE
    path = _ASSET_ROOT / "contract" / "store.py"
    if not path.is_file():
        _die(5, "store_tier_missing", f"manager store tier not found: {path}",
             "reinstall or update the capabilities manager")
    spec = importlib.util.spec_from_file_location("capabilities_manager_store", path)
    if spec is None or spec.loader is None:
        _die(5, "store_tier_load_failed", f"cannot load manager store tier: {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    _STORE_MODULE = module
    return module


# The verbs that write a project record — policy, configuration, the project's
# identity and its wiring — and the machine ceiling. Under the read-only switch the manager refuses them;
# whether the switch is on is the store tier's answer, never the manager's own.
READ_ONLY_REFUSED_VERBS = ("agent set", "allow", "connections import", "disable",
                           "enable", "inherit", "init", "node add", "node remove",
                           "node set", "quarantine", "relabel", "set",
                           "store set", "store unset")


def _read_only_gate(verb: str) -> None:
    store = _store_module()
    if store.read_only_switch():
        _die(4, "read_only_switch",
             f"`capabilities {verb}` is refused: {store.READ_ONLY_ENV} is set, "
             "so this process changes no project record",
             "Do not lift the switch yourself — ask the user; the change has to "
             f"run in a process without {store.READ_ONLY_ENV}.")


def _read_only_report() -> dict | None:
    """What doctor says about the switch: nothing while it is off."""
    store = _store_module()
    if not store.read_only_switch():
        return None
    return {"variable": store.READ_ONLY_ENV, "on": True,
            "effect": store.READ_ONLY_EFFECT,
            "refused_here": list(READ_ONLY_REFUSED_VERBS)}


def _open_project_records(root: Path, *, project_only: bool = False):
    """The records surface for one project, raising the store tier's error. In
    store mode its connections and grants are read for the project's id, which
    a read takes in every state."""
    store = _store_module()
    envelope = _project_capabilities_dir(root)
    in_store = store.connections_mode(envelope) == "store"
    return store.open_records(
        envelope, _CONFIG_HOME, project_only=project_only, project_root=root,
        project_id=_project_id_state(root)["id"] if in_store else None)


def _store_error_exit(exc) -> int:
    """A store that cannot be reached or is busy is the network's exit code;
    every other records refusal is input."""
    return 5 if exc.slug in _store_module().STORE_ENVIRONMENT_SLUGS else 6


def _records_for(root: Path, *, project_only: bool = False):
    """The records surface for one project, with manager errors normalized."""
    store = _store_module()
    try:
        return _open_project_records(root, project_only=project_only)
    except store.StoreError as exc:
        _die(_store_error_exit(exc), exc.slug, exc.message, exc.hint)


def _guide_menu(guide_dir: Path, command: str) -> list[dict[str, str]]:
    menu = []
    files = sorted(guide_dir.glob("*.md")) if guide_dir.is_dir() else []
    for path in files:
        lines = path.read_text().splitlines()
        title = ""
        title_index = -1
        for index, line in enumerate(lines):
            if line.startswith("# "):
                title = line[2:].strip()
                title_index = index
                break
        paragraph = []
        for line in lines[title_index + 1:]:
            stripped = line.strip()
            if not stripped:
                if paragraph:
                    break
                continue
            if stripped.startswith("#"):
                break
            paragraph.append(stripped)
        topic = path.stem
        menu.append({
            "topic": topic,
            "title": title,
            "preview": " ".join(paragraph),
            "command": f"{command} guide {topic}",
        })
    return menu

# ---------------------------------------------------------------- shared shape

def _home_dirs() -> set[Path]:
    """Every directory that is a home directory of the account running this.

    $HOME answers for the process and moves wherever a caller points it; the
    password database answers for the account and cannot be pointed anywhere.
    A caller that redirects $HOME - a dev lane, a service under a supervisor, a
    sandbox - would otherwise carry the guard onto the home it invented and stop
    excluding the account's own, which is the one the machine registry sits in.
    """
    homes: set[Path] = set()
    candidates = [Path.home()]
    try:
        account = pwd.getpwuid(os.getuid()).pw_dir
    except (KeyError, OSError):
        account = ""
    # The account's field counts only when it is absolute. An empty or relative
    # one names no directory of its own: it resolves against the cwd, an empty
    # one to the cwd itself, so taken as a home it would stop the walk wherever
    # the process stands. Some service accounts carry an empty field.
    if os.path.isabs(account):
        candidates.append(Path(account))
    for candidate in candidates:
        try:
            homes.add(candidate.resolve())
        except OSError:
            continue
    return homes


def _is_machine_registry(path: Path) -> bool:
    """Whether this tree is a machine registry rather than a project envelope.

    The registry and the legacy project envelope share the name
    `.capabilities/`, and only the registry carries `.manager/` - the installer
    creates it before the manager has run once, and nothing writes that name
    anywhere else. A registry this manager was pointed at names itself too, so
    the one tree this process is the sole writer of is never read as a
    consumer's envelope even after its `.manager/` has been removed.
    """
    try:
        if path.resolve() == CAP_HOME.resolve():
            return True
    except OSError:
        return False
    return (path / ".manager").is_dir()


def _project_root() -> Path | None:
    """Nearest project root, walking up from $CLAUDE_PROJECT_DIR (else cwd):
    the first directory holding capabilities/, legacy .capabilities/,
    .contextkit/config.toml, .env(.local), or .git.
    Markers are read from the filesystem alone: the root is what the envelope
    location is resolved against, so resolving one cannot depend on the other.
    A home directory is never a project root (the machine registry lives in
    one), and a `.capabilities/` that is a machine registry names that registry
    rather than a legacy envelope."""
    start = os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
    here = Path(start).resolve()
    homes = _home_dirs()
    for d in (here, *here.parents):
        if d in homes:
            return None
        legacy = d / LEGACY_PROJECT_CAPABILITIES_REL
        # Either marker names a project. `settings.json` is the gate and
        # `project.json` the identity; either one alone is enough.
        if ((d / PROJECT_CAPABILITIES_REL / "settings.json").is_file()
                or (d / PROJECT_CAPABILITIES_REL / PROJECT_IDENTITY_REL).is_file()
                or (d / CONTEXTKIT_CONFIG_REL).is_file()
                or (legacy.is_dir() and not _is_machine_registry(legacy))
                or (d / ".env").exists()
                or (d / ".env.local").exists() or (d / ".git").is_dir()):
            return d
    return None


def _require_project() -> Path:
    root = _project_root()
    if root is None:
        _die(6, "no_project", "not inside a project",
             "run from a directory with capabilities/, .env, or a .git root")
    return root


_ENVELOPE_HOME: dict[Path, Path] = {}


def _validated_envelope(root: Path, raw: str, provider: str) -> Path:
    """Validate one owner-provided envelope without guessing a replacement."""
    if not raw.strip():
        _die(6, "project_envelope_empty",
             f"{provider} returned an empty capabilities envelope path",
             "repair the project context binding, then retry")
    candidate = Path(raw.strip()).expanduser()
    if not candidate.is_absolute():
        _die(6, "project_envelope_relative",
             f"{provider} returned a relative capabilities envelope path: {raw!r}",
             "the resolved project envelope must be absolute")
    try:
        resolved = candidate.resolve()
        resolved.relative_to(root.resolve())
    except (OSError, ValueError):
        _die(6, "project_envelope_outside_project",
             f"{provider} returned a capabilities envelope outside the project: {candidate}",
             f"the path must be inside {root.resolve()}")
    return resolved


def _handed_off_envelope(root: Path) -> str:
    """The handoff meant for THIS project root, or "" when there is none.

    $CAPABILITIES_PROJECT_ENVELOPE is inherited by every descendant process, and
    a descendant does not always stand in the project its parent stood in.
    $CAPABILITIES_PROJECT_ENVELOPE_ROOT names the root the handed value answers
    for, so a handoff that crossed a project boundary is passed over instead of
    being applied to the wrong project. A handoff supplied without that companion
    belongs to whoever launched the process and is honored as given, which is how
    a context owner composing through `capabilities context --fragment` hands its
    answer over in advance and is never called back mid-flight.
    """
    override = os.environ.get(ENVELOPE_ENV, "").strip()
    if not override:
        return ""
    scope = os.environ.get(ENVELOPE_ROOT_ENV, "").strip()
    if not scope:
        return override
    try:
        if Path(scope).expanduser().resolve() != root.resolve():
            return ""
    except OSError:
        return ""
    return override


def _record_file(cache_root: Path, key: str) -> Path:
    """Where this manager records one answer for one absolute project root.

    The file name only buckets roots apart; the entry's own `root` field is what
    proves identity, so two roots landing in one bucket cost a miss rather than
    a wrong answer.
    """
    return cache_root / f"{format(zlib.crc32(key.encode()), '08x')}.json"


def _envelope_witness(path) -> dict:
    """One input a recorded answer rests on, as that input stands right now."""
    try:
        seen = os.stat(path)
    except OSError:
        return {"path": str(path), "present": False}
    return {"path": str(path), "present": True,
            "size": seen.st_size, "mtime_ns": seen.st_mtime_ns}


def _cached_record(cache_root: Path, version: int, root: Path) -> dict | None:
    """The recorded entry for this root while every input it rests on holds.

    Every reader re-observes the inputs the record names and compares each of
    them whole. Anything at all in doubt — an unreadable file, an unexpected
    shape, an input that moved, an expiry already behind the clock or a write
    ahead of it — returns None and costs a full resolution, so the failure mode
    is slow and never wrong.
    """
    key = str(root.resolve())
    try:
        entry = json.loads(_record_file(cache_root, key).read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(entry, dict):
        return None
    if entry.get("version") != version or entry.get("root") != key:
        return None
    written, expires = entry.get("written_at"), entry.get("expires_at")
    if not isinstance(written, (int, float)) or not isinstance(expires, (int, float)):
        return None
    now = time.time()
    if now < written or now >= expires:
        return None
    witness = entry.get("witness")
    if not isinstance(witness, list):
        return None
    for observed in witness:
        if (not isinstance(observed, dict)
                or _envelope_witness(observed.get("path")) != observed):
            return None
    return entry


def _cached_envelope(root: Path) -> Path | None:
    """The recorded envelope for this root, while its record stands."""
    entry = _cached_record(ENVELOPE_CACHE_ROOT, ENVELOPE_CACHE_VERSION, root)
    if entry is None:
        return None
    envelope = Path(str(entry.get("envelope") or ""))
    if not envelope.is_absolute():
        return None
    try:
        envelope.resolve().relative_to(entry["root"])
    except (OSError, ValueError):
        return None
    return envelope


def _write_record(cache_root: Path, version: int, key: str, fields: dict,
                  witness: list[dict]) -> None:
    """Record one resolved answer with the inputs it rests on.

    The entry is written under a process-unique name beside its home and moved
    into place, so concurrent capability calls read a whole record or none.
    Writing is best effort throughout: a record that cannot be written costs
    speed and nothing else.
    """
    now = time.time()
    entry = {**fields, "version": version, "root": key, "witness": witness,
             "written_at": now, "expires_at": now + ENVELOPE_CACHE_TTL}
    path = _record_file(cache_root, key)
    tmp = path.with_name(f"{path.name}.{os.getpid()}.tmp")
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp.write_text(json.dumps(entry, sort_keys=True) + "\n")
        os.replace(tmp, path)
    except OSError:
        try:
            tmp.unlink()
        except OSError:
            pass


def _record_envelope(key: str, envelope: Path, witness: list[dict]) -> None:
    _write_record(ENVELOPE_CACHE_ROOT, ENVELOPE_CACHE_VERSION, key,
                  {"envelope": str(envelope)}, witness)


BODY_LAYERS = ("context", "assets", "routines", "capabilities")


def _body_path(raw, what: str, config_file: Path, root_allowed: bool = False) -> Path:
    """One relative, visible path inside the project, as a binding names it;
    the project root itself only where `root_allowed` (the body root)."""
    if not isinstance(raw, str) or not raw.strip():
        _die(6, "body_path_invalid", f"{config_file} declares {what} {raw!r}",
             "name a non-empty relative path inside the project")
    candidate = Path(raw.strip())
    if not candidate.parts or candidate.as_posix() == ".":
        if root_allowed:
            return Path(".")
        _die(6, "body_path_invalid", f"{config_file} declares {what} {raw!r}",
             "a layer is a folder inside the body, not the body itself")
    if candidate.is_absolute() or ".." in candidate.parts or candidate.parts[0].startswith("."):
        _die(6, "body_path_invalid", f"{config_file} declares {what} {raw!r}",
             "the body and its layers are visible folders inside the project, "
             'such as `root = "agent"`')
    return candidate


def _project_body(root: Path) -> dict:
    """Where the agent's body lives: its root folder and each layer in it.

    A ContextKit binding names them - `[body] root`, and `[sources] <layer>`
    inside it, the legacy `.capabilities` envelope fixed at the project root -
    and is read here directly; every other project keeps its layers at the
    project root."""
    body_root, declared = Path("."), {}
    config_file = root / CONTEXTKIT_CONFIG_REL
    if _contextkit_managed(root):
        import tomllib
        try:
            raw = tomllib.loads(config_file.read_text())
        except (OSError, ValueError) as exc:
            _die(6, "contextkit_config_invalid", f"{config_file} cannot be read: {exc}",
                 "repair the project context binding, then retry")
        body = raw.get("body") if isinstance(raw.get("body"), dict) else {}
        body_root = _body_path(body.get("root", "."), "body.root", config_file,
                               root_allowed=True)
        declared = raw.get("sources") if isinstance(raw.get("sources"), dict) else {}
    layers = {}
    for name in BODY_LAYERS:
        value = declared.get(name, name)
        if name == "capabilities" and isinstance(value, str) and value.strip() \
                and Path(value.strip()).as_posix() == LEGACY_PROJECT_CAPABILITIES_REL.as_posix():
            layers[name] = root / LEGACY_PROJECT_CAPABILITIES_REL
        else:
            layers[name] = root / body_root / _body_path(value, f"sources.{name}", config_file)
    return {"body_root": body_root, "layers": layers}


def _contextkit_envelope(root: Path) -> Path:
    """Where this project's ContextKit binding puts its envelope."""
    override = _handed_off_envelope(root)
    if override:
        return _validated_envelope(root, override, "environment handoff")
    return _validated_envelope(root, str(_project_body(root)["layers"]["capabilities"]),
                               "the ContextKit binding")


def _envelope_home(root: Path) -> Path:
    """The project's capabilities envelope, resolved once per invocation.

    A ContextKit binding names where the projects it binds keep it, and is read
    for it. Broken configured bindings fail closed. Every other project keeps
    the envelope at <root>/capabilities.

    An answer this manager resolved itself is recorded against the inputs it
    rests on — the project's context binding — so the next process on this
    machine reads it instead of reading the binding again. A handed-off answer is the caller's assertion about
    one invocation, so it outranks the record and is never written into it.
    """
    cached = _ENVELOPE_HOME.get(root)
    if cached is not None:
        return cached
    handoff = _handed_off_envelope(root)
    if handoff:
        home = _validated_envelope(root, handoff, "environment handoff")
    else:
        home = _cached_envelope(root)
        if home is None:
            witness = [_envelope_witness(root / CONTEXTKIT_CONFIG_REL)]
            if _contextkit_managed(root):
                home = _contextkit_envelope(root)
            else:
                home = root / PROJECT_CAPABILITIES_REL
            _record_envelope(str(root.resolve()), home, witness)
    _ENVELOPE_HOME[root] = home
    return home


def _project_capabilities_dir(root: Path) -> Path:
    """Active envelope, with read compatibility for legacy projects."""
    current = _envelope_home(root)
    legacy = root / LEGACY_PROJECT_CAPABILITIES_REL
    if ((current / "settings.json").is_file()
            or (current / PROJECT_IDENTITY_REL).is_file()
            or not legacy.is_dir()):
        return current
    return legacy


def _gate_file(root: Path) -> Path:
    return _project_capabilities_dir(root) / "settings.json"


def _contextkit_config_id(root: Path) -> str | None:
    """The id a ContextKit binding holds in `[identity] id`, or None.

    Read only to carry an id that lives nowhere else into project.json; it is
    never the project's id while project.json declares one."""
    try:
        import tomllib
        with (root / CONTEXTKIT_CONFIG_REL).open("rb") as handle:
            config = tomllib.load(handle)
    except (OSError, ValueError, ImportError):
        return None
    identity = config.get("identity") if isinstance(config, dict) else None
    ident = identity.get("id") if isinstance(identity, dict) else None
    return ident.strip() if isinstance(ident, str) and ident.strip() else None


def _project_json_id(root: Path) -> str | None:
    identity = _read_json(_project_capabilities_dir(root) / PROJECT_IDENTITY_REL)
    if not isinstance(identity, dict):
        return None
    return str(identity.get("id") or "").strip() or None


def _adopt_config_id(root: Path) -> str | None:
    """Carry a ContextKit-held id into project.json, once, where project.json
    declares none, and answer it. Under the read-only switch the id is
    answered and nothing is written; the next process without the switch
    writes it."""
    ident = _contextkit_config_id(root)
    if ident is None:
        return None
    if _store_module().read_only_switch():
        return ident
    identity_file = _project_capabilities_dir(root) / PROJECT_IDENTITY_REL
    identity = _read_json(identity_file) if identity_file.is_file() else None
    if not isinstance(identity, dict):
        identity = {"schema": PROJECT_IDENTITY_SCHEMA, "slug": _default_project_slug(root)}
    if str(identity.get("id") or "").strip():
        return str(identity["id"]).strip()
    identity["id"] = ident
    _write_json(identity_file, identity)
    return ident


def _handed_off_project_id(root: Path) -> str:
    """The project id handed down for THIS root, or "" when there is none.

    Scoped by $CAPABILITIES_PROJECT_ID_ROOT exactly as the envelope handoff is
    scoped by its companion: a handoff for another root is passed over, and one
    supplied without the companion is honored as given."""
    handed = os.environ.get(PROJECT_ID_ENV, "").strip()
    if not handed:
        return ""
    scope = os.environ.get(PROJECT_ID_ROOT_ENV, "").strip()
    if not scope:
        return handed
    try:
        if Path(scope).expanduser().resolve() != root.resolve():
            return ""
    except OSError:
        return ""
    return handed


def _project_id_state(root: Path) -> dict:
    """The project's id and where it came from.

    `capabilities/project.json` is the id's one home. A live handoff for this
    root is that id as the launching process read it, so it is used as given
    unless project.json now declares another, which a write refuses. A project
    whose project.json declares none takes the id its ContextKit binding holds,
    copied into project.json once."""
    declared = _project_json_id(root)
    handed = _handed_off_project_id(root)
    if handed and declared and handed != declared:
        state = {"state": "mismatch", "id": declared, "handed_id": handed}
    elif handed:
        state = {"state": "handed", "id": handed}
    else:
        if declared is None:
            declared = _adopt_config_id(root)
        state = {"state": "declared" if declared else "undeclared", "id": declared}
    state["project_json_id"] = declared
    return state


def _identity_refusal(state: dict) -> dict | None:
    """Why a write may not stamp this project's id, or None when it may.

    A project without an id is left to the caller, whose refusal already names
    `capabilities init`."""
    if state["state"] == "mismatch":
        return {"code": "project_id_mismatch",
                "message": f"project.json holds project id {state['project_json_id']}, "
                           f"but the process that started this one handed down "
                           f"{state['handed_id']}",
                "hint": "start the command again from the project itself, so the id "
                        "is read from its project.json"}
    return None


def _project_id_handoff(root: Path) -> dict[str, str]:
    """The id hand-down for a process launched to stand in `root`: the id a
    write may stamp there, scoped to that root, or nothing when none may be."""
    root = Path(root)
    state = _project_id_state(root)
    if not state["id"] or _identity_refusal(state) is not None:
        return {}
    return {PROJECT_ID_ENV: state["id"], PROJECT_ID_ROOT_ENV: str(root.resolve())}


def _project_id_for_write(root: Path) -> str | None:
    """The id a write stamps, or a refusal. None only where the project
    declares no id."""
    state = _project_id_state(root)
    refusal = _identity_refusal(state)
    if refusal:
        _die(6, refusal["code"], refusal["message"], refusal.get("hint"))
    return state["id"]


def cmd_path(json_output: bool, identity: bool = False) -> None:
    if not json_output:
        _die(6, "input", "path requires --json")
    root = _require_project().resolve()
    envelope = _envelope_home(root).resolve()
    if _handed_off_envelope(root):
        provider = "handoff"
    elif _contextkit_managed(root):
        provider = "contextkit"
    else:
        provider = "default"
    body = _project_body(root)
    answer = {
        "project_root": str(root),
        "project_envelope": str(envelope),
        "provider": provider,
        "body_root": body["body_root"].as_posix(),
        "layers": {name: str(path.resolve()) for name, path in body["layers"].items()},
    }
    if identity:
        state = _project_id_state(root)
        # Capabilities stamped with an earlier contract read `bound` and take
        # `contextkit_id` as the id a bound project answers to, so both carry
        # that meaning here: whether a ContextKit binding is present, and the
        # project's id (project.json's) where it is, else null.
        bound = _contextkit_managed(root)
        state["bound"] = bound
        state["contextkit_id"] = state["id"] if bound else None
        answer["project_identity"] = state
    _emit(answer)


def _read_json(path: Path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return None


def _write_json(path: Path, value) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n")
    tmp.replace(path)


def _atomic_write_text(path: Path, body: str) -> None:
    """Replace a file whole, so a host starting a session never reads half of it."""
    path.parent.mkdir(parents=True, exist_ok=True)
    mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o644
    with tempfile.NamedTemporaryFile("w", delete=False, dir=path.parent,
                                     prefix=f".{path.name}.", suffix=".tmp") as tmp:
        tmp_path = Path(tmp.name)
        try:
            tmp.write(body)
        except BaseException:
            tmp_path.unlink(missing_ok=True)
            raise
    tmp_path.chmod(mode)
    tmp_path.replace(path)


def _read_host_settings(path: Path) -> dict:
    """An existing host settings file as a JSON object; absent or blank reads as empty.

    A file that holds text but is not a JSON object is refused rather than
    replaced: it holds the person's own host configuration beside the manager's hooks.
    """
    if not path.exists() or not path.read_text().strip():
        return {}
    value = _read_json(path)
    if not isinstance(value, dict):
        _die(6, "host_settings_unreadable",
             f"{path} exists but is not a readable JSON object",
             "repair or remove it, then rerun `capabilities init`; the manager "
             "does not replace host settings it cannot read")
    return value


def _active_takeover_leases() -> list[dict]:
    """Scan account-global control roots for nonterminal durable takeovers."""
    root = _STATE_HOME / "telegram"
    leases = []
    if not root.is_dir():
        return leases
    for path in sorted(root.glob("*/control/takeover.json")):
        raw = _read_json(path)
        if not isinstance(raw, dict):
            leases.append({"path": str(path), "damaged": True})
        elif raw.get("state") != "restored":
            leases.append({**raw, "path": str(path)})
    return leases


def _assert_payload_mutable(name: str, session_id: str | None = None) -> None:
    """Freeze payload bytes referenced by any nonterminal takeover lease."""
    blockers = [lease for lease in _active_takeover_leases()
                if (lease.get("damaged") or lease.get("capability") == name)
                and (lease.get("damaged") or session_id is None
                     or lease.get("session_id") == session_id)]
    if blockers:
        _die(6, "takeover_payload_frozen",
             f"{name} payload is frozen by an active live takeover",
             json.dumps(blockers, sort_keys=True))


def _assert_session_without_takeover(session_id: str) -> None:
    """Retain session work while any matching durable lease is nonterminal."""
    blockers = [lease for lease in _active_takeover_leases()
                if lease.get("damaged") or lease.get("session_id") == session_id]
    if blockers:
        _die(6, "takeover_active", f"dev session {session_id} has an active live takeover",
             json.dumps(blockers, sort_keys=True))


@contextmanager
def _manager_mutation_guard():
    """Serialize manager writers and refuse cross-version lease mutation."""
    MANAGER_MUTATION_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with MANAGER_MUTATION_LOCK.open("a+") as handle:
        MANAGER_MUTATION_LOCK.chmod(0o600)
        fcntl.flock(handle, fcntl.LOCK_EX)
        leases = _active_takeover_leases()
        if leases:
            _die(6, "takeover_manager_frozen",
                 "manager mutation is blocked while a live takeover is active",
                 json.dumps(leases, sort_keys=True))
        yield


def _parse_env_file(path: Path) -> dict[str, str]:
    """Parse the small dotenv subset needed for manager-level project knobs."""
    try:
        lines = path.read_text().splitlines()
    except OSError:
        return {}
    out: dict[str, str] = {}
    for raw in lines:
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[7:].strip()
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", key):
            continue
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
            value = value[1:-1]
        out[key] = value
    return out


def _project_env(root: Path) -> dict[str, str]:
    merged = _parse_env_file(root / ".env")
    merged.update(_parse_env_file(root / ".env.local"))
    return merged


def _context_prompt(root: Path) -> str:
    prompt = (_project_env(root).get(CONTEXT_PROMPT_ENV)
              or os.environ.get(CONTEXT_PROMPT_ENV))
    if prompt and prompt.strip():
        return prompt.replace("\\n", "\n").strip()
    return DEFAULT_CONTEXT_PROMPT


def _contextkit_managed(root: Path) -> bool:
    """True when ContextKit has bound this project and owns host injection."""
    return (root / CONTEXTKIT_CONFIG_REL).is_file()


def _contextkit_handoff(root: Path, targets: list[str]) -> dict:
    target = "all" if len(targets) > 1 else targets[0]
    return {
        "owner": "contextkit",
        "config": str(root / CONTEXTKIT_CONFIG_REL),
        "capabilities_host_wiring": "skipped",
        "targets": targets,
        "refresh": f"contextkit build --target {target}",
    }


def _prune_session_hooks(path: Path, predicate) -> bool:
    """Remove only matching hook commands; preserve every unrelated setting."""
    value = _read_json(path)
    if not isinstance(value, dict):
        return False
    hooks = value.get("hooks")
    session = hooks.get("SessionStart") if isinstance(hooks, dict) else None
    if not isinstance(session, list):
        return False
    changed = False
    next_session = []
    for entry in session:
        if not isinstance(entry, dict):
            next_session.append(entry)
            continue
        commands = entry.get("hooks")
        if not isinstance(commands, list):
            next_session.append(entry)
            continue
        kept = [hook for hook in commands
                if not (isinstance(hook, dict) and predicate(hook))]
        if len(kept) != len(commands):
            changed = True
        if kept:
            updated = dict(entry)
            updated["hooks"] = kept
            next_session.append(updated)
    if changed:
        hooks["SessionStart"] = next_session
        _write_json(path, value)
    return changed


def _remove_generated_file(path: Path, marker: str) -> bool:
    try:
        owned = marker in path.read_text()
    except OSError:
        return False
    if not owned:
        return False
    path.unlink()
    return True


def _migrate_codex_legacy(root: Path) -> dict:
    """Migrate legacy Codex wiring (build-context.sh) to direct invocation.

    Returns findings and removed items. Ownership markers are mandatory - only
    manager-owned files are deleted. Non-owned files are reported as findings.
    """
    removed: list[str] = []
    findings: list[str] = []

    # Remove legacy compiler script if manager-owned
    legacy_compiler = root / ".codex" / "hooks" / "build-context.sh"
    try:
        compiler_owned = "Generated by `capabilities init --codex`" in legacy_compiler.read_text()
    except OSError:
        compiler_owned = False
    if legacy_compiler.exists() and not compiler_owned:
        findings.append(f"{legacy_compiler}: not manager-owned, skipping removal")
    elif compiler_owned:
        legacy_compiler.unlink()
        removed.append(str(legacy_compiler))
        # Remove legacy hook reference
        if _prune_session_hooks(
                root / CODEX_HOOKS_REL,
                lambda hook: ".codex/hooks/build-context.sh" in str(hook.get("command", ""))):
            removed.append("codex_legacy_hook")

    # Remove legacy context.md if manager-owned
    legacy_context = root / ".codex" / "generated" / "context.md"
    try:
        context_owned = "Generated by .codex/hooks/build-context.sh. Do not edit by hand." in legacy_context.read_text()
    except OSError:
        context_owned = False
    if legacy_context.exists() and not context_owned:
        findings.append(f"{legacy_context}: not manager-owned, skipping removal")
    elif context_owned:
        legacy_context.unlink()
        removed.append(str(legacy_context))

    return {"removed": removed, "findings": findings}


def _retire_capabilities_host_wiring(root: Path) -> list[str]:
    """Remove legacy capabilities-owned injection after ContextKit takes over.

    Ownership markers are mandatory: ContextKit and human-authored host files
    are never deleted. The Codex hook shares a command path with ContextKit, so
    it is retired only when the compiler at that path is capabilities-owned.
    """
    removed: list[str] = []
    claude_settings = root / ".claude" / "settings.json"
    if _prune_session_hooks(
            claude_settings,
            lambda hook: "capabilities context --claude" in str(hook.get("command", ""))):
        removed.append("claude_hook")
    claude_context = root / ".claude" / "rules" / "CAPABILITIES.md"
    if _remove_generated_file(claude_context, CONTEXT_BEGIN):
        removed.append(str(claude_context))

    # Remove legacy Codex compiler script (pre-direct-invocation)
    legacy_compiler = root / ".codex" / "hooks" / "build-context.sh"
    try:
        compiler_owned = "Generated by `capabilities init --codex`" in legacy_compiler.read_text()
    except OSError:
        compiler_owned = False
    if compiler_owned:
        legacy_compiler.unlink()
        removed.append(str(legacy_compiler))
        if _prune_session_hooks(
                root / CODEX_HOOKS_REL,
                lambda hook: ".codex/hooks/build-context.sh" in
                str(hook.get("command", ""))):
            removed.append("codex_legacy_hook")
    # Remove legacy compiled context.md (pre-direct-invocation)
    legacy_context = root / ".codex" / "generated" / "context.md"
    if _remove_generated_file(
            legacy_context,
            "Generated by .codex/hooks/build-context.sh. Do not edit by hand."):
        removed.append(str(legacy_context))
    # Remove current Codex capabilities fragment and hook
    if _prune_session_hooks(
            root / CODEX_HOOKS_REL,
            lambda hook: "capabilities context --codex" in str(hook.get("command", ""))):
        removed.append("codex_hook")
    codex_fragment = root / CODEX_CAPABILITIES_REL
    codex_link = root / CODEX_ROOT_LINK_REL
    if _codex_link_ok(root):
        codex_link.unlink()
        removed.append(str(codex_link))
    if _remove_generated_file(codex_fragment, CONTEXT_BEGIN):
        removed.append(str(codex_fragment))
    return removed


def _project_visibility_hint(name: str | None = None) -> list[str]:
    enable = (f"capabilities enable {name} --project" if name else
              "capabilities enable <name> --project")
    return [
        "Codex: run `capabilities init --codex` once in the consuming project, "
        f"then `{enable}`. After manual capabilities/ envelope edits, refresh "
        "with `capabilities context --codex`.",
        "Claude Code: run `capabilities init --claude` once in the consuming "
        f"project, then `{enable}`.",
        "No hand-authored project-root instruction markdown file is required or "
        "assumed. Do not create or edit generated capabilities context by hand; "
        "the manager owns .codex/generated/capabilities.md, its root "
        ".capabilities.md link, and .claude/rules/CAPABILITIES.md.",
        "ContextKit exception: when .contextkit/config.toml is present, ContextKit "
        "owns both host bindings and the combined context; use `contextkit build`.",
    ]


def _sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()

# ---------------------------------------------------------------- registry

def _registry_dir(name: str) -> Path:
    return CAP_HOME / name


def _reject_reserved_capability_name(name: str) -> None:
    if name in RESERVED_CAPABILITY_NAMES:
        _die(6, "reserved_capability_name",
             f"{name!r} is reserved for manager-owned storage under {CAP_HOME}",
             "choose another capability name")


def _script_path(name: str) -> Path:
    return _registry_dir(name) / name


def _installed() -> dict[str, dict]:
    """name -> meta.json for every registry entry that holds a script."""
    out: dict[str, dict] = {}
    if not CAP_HOME.is_dir():
        return out
    for d in sorted(CAP_HOME.iterdir()):
        if d.name.startswith(".") or not d.is_dir():
            continue
        if (d / d.name).is_file():
            out[d.name] = _read_json(d / "meta.json") or {}
    return out


def _snapshot_env() -> dict:
    """Subprocess env for snapshotting: outside any project, so never gated."""
    env = dict(os.environ)
    env.pop("CLAUDE_PROJECT_DIR", None)
    return env


def _run_script(script: Path, args: list[str], cwd: Path | None = None,
                env: dict | None = None, timeout: int = 60) -> tuple[int, str, str]:
    try:
        proc = subprocess.run(
            [str(script), *args], capture_output=True, text=True,
            cwd=str(cwd or script.parent), env=env or _snapshot_env(), timeout=timeout,
            start_new_session=True)
    except subprocess.TimeoutExpired:
        return (124, "", f"timed out after {timeout}s")
    except OSError as e:
        return (126, "", str(e))
    return (proc.returncode, proc.stdout, proc.stderr)

# ---------------------------------------------------------------- bin dir

def _manager_link_dirs() -> list[Path]:
    """Every directory holding the manager's own `capabilities` link, PATH
    entries first, then `~/.local/bin` and `~/bin`."""
    path_dirs = [Path(p).expanduser() for p in
                 os.environ.get("PATH", "").split(os.pathsep) if p]
    defaults = (Path.home() / ".local" / "bin", Path.home() / "bin")
    manager_home = (CAP_HOME / ".manager").resolve()
    found: list[Path] = []
    seen: set[Path] = set()
    for cand in (*path_dirs, *defaults):
        link = cand / "capabilities"
        try:
            if not (link.is_symlink()
                    and link.resolve().is_relative_to(manager_home)):
                continue
            key = cand.resolve()
        except (OSError, RuntimeError):
            continue
        if key not in seen:
            seen.add(key)
            found.append(cand)
    return found


def _link_dirs() -> list[Path]:
    """Every directory a capability link belongs in, the primary one first."""
    override = os.environ.get("CAPABILITIES_BIN")
    if override:
        return [Path(override).expanduser()]
    # The directories are the machine's, not the call's: wherever the
    # manager's own link already sits, so a call whose environment differs (a
    # service without the shell's CAPABILITIES_BIN) links where every other
    # call looks. A machine an older manager left with the manager linked in
    # two directories gets every link in both.
    found = _manager_link_dirs()
    if found:
        return found
    on_path = {Path(p).expanduser().resolve() for p in
               os.environ.get("PATH", "").split(os.pathsep) if p}
    for cand in (Path.home() / ".local" / "bin", Path.home() / "bin"):
        if cand.is_dir() and cand.resolve() in on_path:
            return [cand]
    return [Path.home() / ".local" / "bin"]


def _bin_dir() -> Path:
    return _link_dirs()[0]


# ---------------------------------------------------------------- manifest

REQUIRED_MANIFEST_FIELDS = ("name", "summary", "credentials",
                            "docs", "state", "inventory", "post_install")
SERVICE_DEPLOY_SCHEMA = "capabilities.service.deploy.v1"
SERVICE_MOUNT_TOKENS = ("{agent_home}", "{project_root}")


def _validate_service_deploy(deploy: object) -> list[str]:
    problems: list[str] = []
    if not isinstance(deploy, dict):
        return ["service.deploy is not an object"]
    if deploy.get("schema") != SERVICE_DEPLOY_SCHEMA:
        problems.append(f"service.deploy.schema must be {SERVICE_DEPLOY_SCHEMA!r}")
    if deploy.get("default_policy") not in ("auto", "disabled"):
        problems.append("service.deploy.default_policy must be auto|disabled")
    for field in ("command", "doctor"):
        value = deploy.get(field)
        if field == "doctor" and value is None:
            continue
        if (not isinstance(value, list) or not value
                or not all(isinstance(v, str) and v for v in value)):
            problems.append(f"service.deploy.{field} must be a non-empty argv list")
    environment = deploy.get("environment")
    if not isinstance(environment, dict):
        problems.append("service.deploy.environment is not an object")
    else:
        required = environment.get("required")
        if (not isinstance(required, list)
                or not all(isinstance(v, str) and re.match(r"^[A-Z_][A-Z0-9_]*$", v)
                           for v in required)
                or len(required) != len(set(required))):
            problems.append("service.deploy.environment.required must be a list of env keys")
        optional = environment.get("optional")
        if not isinstance(optional, list):
            problems.append("service.deploy.environment.optional is not a list")
        else:
            optional_names: set[str] = set()
            for entry in optional:
                if (not isinstance(entry, dict)
                        or not isinstance(entry.get("key"), str)
                        or not re.match(r"^[A-Z_][A-Z0-9_]*$", entry.get("key", ""))
                        or entry.get("key") in optional_names
                        or entry.get("key") in (required if isinstance(required, list) else [])):
                    problems.append(
                        f"service.deploy.environment.optional entry malformed: {entry!r}")
                else:
                    optional_names.add(entry["key"])
                if isinstance(entry, dict) and "default" in entry and not isinstance(entry["default"], str):
                    problems.append(
                        f"service.deploy.environment.optional default is not a string: {entry!r}")
    mounts = deploy.get("mounts")
    if not isinstance(mounts, list):
        problems.append("service.deploy.mounts is not a list")
    else:
        names: set[str] = set()
        for mount in mounts:
            if not isinstance(mount, dict):
                problems.append(f"service.deploy.mount entry malformed: {mount!r}")
                continue
            name = mount.get("name")
            if (not isinstance(name, str) or not re.match(r"^[a-z][a-z0-9_]*$", name)
                    or name in names):
                problems.append(f"service.deploy.mount name malformed or duplicated: {name!r}")
            else:
                names.add(name)
            if mount.get("kind") not in ("state", "shared"):
                problems.append(f"service.deploy.mount kind must be state|shared: {mount!r}")
            target = mount.get("target")
            if (not isinstance(target, str) or not target
                    or not (target.startswith("/")
                            or any(target == token or target.startswith(token + "/")
                                   for token in SERVICE_MOUNT_TOKENS))):
                problems.append(
                    "service.deploy.mount target must be absolute or start with "
                    f"a portable token {SERVICE_MOUNT_TOKENS}: {mount!r}")
    if deploy.get("restart") not in ("no", "on-failure", "always", "unless-stopped"):
        problems.append("service.deploy.restart is invalid")
    return problems


SERVICE_MACHINE_SCHEMA = "capabilities.service.machine.v1"
SERVICE_MACHINE_KEYS = ("schema", "command", "doctor", "projects", "config", "state")
SERVICE_MACHINE_VERBS = ("run", "status", "doctor", "join", "leave")


def _validate_service_machine(name: str, machine: object, verbs: object) -> list[str]:
    """`service.machine`: the once-per-machine mode of a bundled service.
    Unlike the rest of `service`, an unknown key is refused, so a key nothing
    reads cannot ride in."""
    if not isinstance(machine, dict):
        return ["service.machine is not an object"]
    problems: list[str] = []
    unknown = sorted(set(machine) - set(SERVICE_MACHINE_KEYS))
    if unknown:
        problems.append(f"service.machine has unknown key(s): {', '.join(unknown)}")
    if machine.get("schema") != SERVICE_MACHINE_SCHEMA:
        problems.append(f"service.machine.schema must be {SERVICE_MACHINE_SCHEMA!r}")
    for field in ("command", "doctor"):
        value = machine.get(field)
        if (not isinstance(value, list) or not value
                or not all(isinstance(v, str) and v for v in value)):
            problems.append(f"service.machine.{field} must be a non-empty argv list")
        elif value[0] != name or "service" not in value or "--machine" not in value:
            problems.append(
                f"service.machine.{field} must start with {name!r} and carry "
                "'service' and '--machine'")
    projects = machine.get("projects")
    home = f"$XDG_CONFIG_HOME/{name}/"
    if (not isinstance(projects, str) or not projects.startswith(home)
            or len(projects) == len(home)
            or ".." in projects[len(home):].split("/")):
        problems.append(
            f"service.machine.projects must be a file under {home} "
            "(the capability's own config home)")
    for field in ("config", "state"):
        if field in machine and (not isinstance(machine[field], str)
                                 or not machine[field]):
            problems.append(f"service.machine.{field} must be a non-empty string")
    listed = verbs if isinstance(verbs, list) else []
    missing = [verb for verb in SERVICE_MACHINE_VERBS if verb not in listed]
    if missing:
        problems.append(
            "a service declaring service.machine must list "
            f"{', '.join(missing)} in service.verbs")
    return problems


CONTRIBUTION_KEYS = ("path", "max_bytes")
# The largest context contribution any capability may declare, in UTF-8 bytes:
# the block is always loaded, so its ceiling is the manager's to hold.
CONTRIBUTION_MAX_BYTES = 32768
# The capability whose contribution is the project's memory, and the line
# ContextKit looks for in this block before it leaves out its own projection of
# the project's memory folder. The line is ContextKit's; it is composed only
# above a contribution that was composed, so an unavailable or empty one leaves
# ContextKit's projection in place and the session never goes without memory.
MEMORY_CAPABILITY = "memory"
MEMORY_CONTRIBUTION_MARKER = "<!-- contextkit:memory-contribution -->"


def _validate_contribution(contribution: object) -> list[str]:
    """`contribution`: the bounded block a capability adds to the project
    context after its stub line. As with `service.machine`, an unknown key is
    refused, so a key nothing reads cannot ride in."""
    if not isinstance(contribution, dict):
        return ["contribution is not an object"]
    problems: list[str] = []
    unknown = sorted(set(contribution) - set(CONTRIBUTION_KEYS))
    if unknown:
        problems.append(f"contribution has unknown key(s): {', '.join(unknown)}")
    path = contribution.get("path")
    parts = path.split("/") if isinstance(path, str) else []
    if (len(parts) < 2 or parts[0] != "state" or "\\" in path
            or any(part in ("", ".", "..") for part in parts)
            or not parts[-1].endswith(".md") or parts[-1] == ".md"):
        problems.append(
            "contribution.path must be a relative Markdown file under the "
            "capability's state/ folder")
    max_bytes = contribution.get("max_bytes")
    if (isinstance(max_bytes, bool) or not isinstance(max_bytes, int)
            or not 0 < max_bytes <= CONTRIBUTION_MAX_BYTES):
        problems.append(
            f"contribution.max_bytes must be an integer from 1 to {CONTRIBUTION_MAX_BYTES}")
    return problems


INVENTORY_NETWORK_MODES = ("none", "optional", "required")


FIELD_TYPES = ("string", "integer", "number", "boolean", "url", "email",
               "phone", "path", "enum", "list", "object")
SETTING_SCOPES = ("project", "global", "machine")
SETTING_APPLY = ("next_call", "reload", "restart")
SETTING_FORMATS = ("json", "toml")


def _validate_fields(where: str, fields, setting: bool = False) -> list[str]:
    """One list of declared fields: what a person is asked for, by key."""
    problems: list[str] = []
    if not isinstance(fields, list):
        return [f"{where} is not a list"]
    seen: set = set()
    for index, field in enumerate(fields):
        at = f"{where}[{index}]"
        if not isinstance(field, dict):
            problems.append(f"{at} is not an object")
            continue
        key = field.get("key")
        # A setting is named by its key at its scope: one key may live at two.
        name = (key, field.get("scope")) if setting else key
        if not isinstance(key, str) or not key.strip():
            problems.append(f"{at}.key missing or empty")
        elif name in seen:
            problems.append(f"{at}.key {key!r} is declared twice")
        else:
            seen.add(name)
        if field.get("type", "string") not in FIELD_TYPES:
            problems.append(f"{at}.type {field.get('type')!r} not {'|'.join(FIELD_TYPES)}")
        if field.get("type") == "enum" and not (
                isinstance(field.get("choices"), list) and field["choices"]
                and all(isinstance(c, str) for c in field["choices"])):
            problems.append(f"{at} is an enum without choices")
        for flag in ("secret", "required"):
            if flag in field and not isinstance(field[flag], bool):
                problems.append(f"{at}.{flag} is not a boolean")
        for text in ("label", "help"):
            if not isinstance(field.get(text), str) or not field[text].strip():
                problems.append(f"{at}.{text} missing or empty")
        if field.get("secret") and "env" in field and (
                not isinstance(field["env"], str) or "{ID}" not in field["env"]):
            problems.append(f"{at}.env must name the env key with {{ID}} in it")
        if setting:
            if field.get("scope") not in SETTING_SCOPES:
                problems.append(f"{at}.scope {field.get('scope')!r} not {'|'.join(SETTING_SCOPES)}")
            if field.get("apply") not in SETTING_APPLY:
                problems.append(f"{at}.apply {field.get('apply')!r} not {'|'.join(SETTING_APPLY)}")
            if field.get("secret"):
                problems.append(f"{at} is a secret, and settings hold none")
    return problems


def _validate_connections_declaration(declared) -> list[str]:
    if declared is None:
        return []
    if not isinstance(declared, dict) or set(declared) != {"fields", "setup", "link"}:
        return ["connections is not null or an object of fields, setup and link"]
    problems: list[str] = []
    if declared["fields"] is not None:
        problems += _validate_fields("connections.fields", declared["fields"])
    problems += _validate_fields("connections.setup", declared["setup"])
    link = declared["link"]
    if not isinstance(link, list):
        problems.append("connections.link is not a list")
    else:
        for index, method in enumerate(link):
            at = f"connections.link[{index}]"
            if not isinstance(method, dict):
                problems.append(f"{at} is not an object")
                continue
            for text in ("id", "label"):
                if not isinstance(method.get(text), str) or not method[text].strip():
                    problems.append(f"{at}.{text} missing or empty")
            argv = method.get("argv")
            if (not isinstance(argv, list) or not argv
                    or not all(isinstance(a, str) for a in argv)
                    or "--events" not in argv):
                problems.append(f"{at}.argv is a list of words carrying --events")
    return problems


def _validate_settings_declaration(declared) -> list[str]:
    if declared is None:
        return []
    if not isinstance(declared, dict) or set(declared) != {"homes", "keys"}:
        return ["settings is not null or an object of homes and keys"]
    problems: list[str] = []
    homes = declared["homes"]
    scopes: list = []
    if not isinstance(homes, list) or not homes:
        problems.append("settings.homes is not a non-empty list")
        homes = []
    for index, home in enumerate(homes):
        at = f"settings.homes[{index}]"
        if not isinstance(home, dict):
            problems.append(f"{at} is not an object")
            continue
        if home.get("scope") not in SETTING_SCOPES:
            problems.append(f"{at}.scope {home.get('scope')!r} not {'|'.join(SETTING_SCOPES)}")
        elif home["scope"] in scopes:
            problems.append(f"{at}.scope {home['scope']!r} has two homes")
        else:
            scopes.append(home["scope"])
        if home.get("format") not in SETTING_FORMATS:
            problems.append(f"{at}.format {home.get('format')!r} not {'|'.join(SETTING_FORMATS)}")
        path = home.get("path")
        if (not isinstance(path, str) or not path or path.startswith("/")
                or any(part in ("", ".", "..") for part in path.split("/"))):
            problems.append(f"{at}.path is a relative path inside the capability's folder")
        if "seed" in home and not isinstance(home["seed"], dict):
            problems.append(f"{at}.seed is the object a missing file starts as")
        if "inherits" in home and home["inherits"] not in SETTING_SCOPES:
            problems.append(f"{at}.inherits {home['inherits']!r} not {'|'.join(SETTING_SCOPES)}")
    for index, home in enumerate(homes):
        if isinstance(home, dict) and "inherits" in home and (
                home["inherits"] == home.get("scope") or home["inherits"] not in scopes):
            problems.append(f"settings.homes[{index}].inherits names no other home")
    problems += _validate_fields("settings.keys", declared["keys"], setting=True)
    if isinstance(declared["keys"], list):
        for index, key in enumerate(declared["keys"]):
            if isinstance(key, dict) and key.get("scope") in SETTING_SCOPES \
                    and key["scope"] not in scopes:
                problems.append(f"settings.keys[{index}] lives at {key['scope']!r}, "
                                "where no home is declared")
    return problems


def _validate_manifest(name: str, manifest) -> list[str]:
    """Mechanical shape check; returns a list of problems (empty = conformant)."""
    problems: list[str] = []
    if not isinstance(manifest, dict):
        return ["manifest is not a JSON object"]
    for field in REQUIRED_MANIFEST_FIELDS:
        if field not in manifest:
            problems.append(f"manifest missing field: {field}")
    if "protocol" in manifest:
        problems.append("manifest field 'protocol' was removed; the capability contract is unversioned")
    if manifest.get("name") != name:
        problems.append(f"manifest name {manifest.get('name')!r} != {name!r}")
    if not isinstance(manifest.get("summary"), str) or not manifest.get("summary", "").strip():
        problems.append("manifest summary missing or empty")
    creds = manifest.get("credentials")
    if isinstance(creds, dict):
        if creds.get("scope") not in ("project", "user"):
            problems.append(f"credentials.scope {creds.get('scope')!r} not project|user")
        keys = creds.get("keys")
        if not isinstance(keys, list):
            problems.append("credentials.keys is not a list")
        else:
            for k in keys:
                if not isinstance(k, dict) or "key" not in k:
                    problems.append(f"credentials.keys entry malformed: {k!r}")
    else:
        problems.append("credentials is not an object")
    docs = manifest.get("docs")
    if isinstance(docs, dict):
        if not isinstance(docs.get("base", ""), str):
            problems.append("docs.base is not a string")
        topics = docs.get("topics", [])
        if not isinstance(topics, list):
            problems.append("docs.topics is not a list")
        elif (not all(isinstance(topic, str) and topic for topic in topics)
              or topics != sorted(set(topics))):
            problems.append("docs.topics must be sorted unique non-empty strings")
    else:
        problems.append("docs is not an object")
    if not isinstance(manifest.get("state"), bool):
        problems.append("state is not a boolean")
    if "inventory" in manifest:
        inventory = manifest["inventory"]
        if inventory is not None:
            if not isinstance(inventory, dict):
                problems.append("inventory is not null or an object")
            elif inventory.get("network") not in INVENTORY_NETWORK_MODES:
                problems.append(
                    f"inventory.network {inventory.get('network')!r} not "
                    f"{'|'.join(INVENTORY_NETWORK_MODES)}")
    post = manifest.get("post_install")
    if not isinstance(post, list):
        problems.append("post_install is not a list")
    else:
        for step in post:
            if not isinstance(step, dict) or "cmd" not in step:
                problems.append(f"post_install entry malformed: {step!r}")
    service = manifest.get("service")
    if name == "telegram":
        state_version = manifest.get("service_state_version")
        if not isinstance(state_version, int) or state_version <= 0:
            problems.append("service_state_version must be a positive integer")
    if service is not None:
        if not isinstance(service, dict):
            problems.append("service is not an object")
        else:
            if not isinstance(service.get("name"), str) or not service.get("name", "").strip():
                problems.append("service.name missing or empty")
            if not isinstance(service.get("summary"), str) or not service.get("summary", "").strip():
                problems.append("service.summary missing or empty")
            verbs = service.get("verbs")
            if not isinstance(verbs, list) or not all(isinstance(v, str) for v in verbs):
                problems.append("service.verbs is not a list of strings")
            if "deploy" in service:
                problems.extend(_validate_service_deploy(service["deploy"]))
            if "machine" in service:
                problems.extend(_validate_service_machine(
                    name, service["machine"], verbs))
    if "contribution" in manifest:
        problems.extend(_validate_contribution(manifest["contribution"]))
    if "connections" in manifest:
        problems.extend(_validate_connections_declaration(manifest["connections"]))
    if "settings" in manifest:
        problems.extend(_validate_settings_declaration(manifest["settings"]))
    return problems

def _machine_reads_declared(text: str) -> tuple[tuple | None, str | None]:
    """A capability's `MACHINE_READS` as its source declares it, read without
    running it: `((), None)` when it declares none, `(verbs, None)` when the
    declaration is a literal tuple of verb names, `(None, problem)` otherwise."""
    import ast
    try:
        tree = ast.parse(text)
    except (SyntaxError, ValueError):
        return (), None
    node = None
    for stmt in tree.body:
        if isinstance(stmt, ast.Assign):
            targets = stmt.targets
        elif isinstance(stmt, ast.AnnAssign) and stmt.value is not None:
            targets = [stmt.target]
        else:
            continue
        if any(isinstance(t, ast.Name) and t.id == "MACHINE_READS" for t in targets):
            node = stmt.value
    if node is None:
        return (), None
    try:
        value = ast.literal_eval(node)
    except (ValueError, TypeError, SyntaxError, MemoryError, RecursionError):
        value = None
    if not isinstance(value, tuple) or not all(
            isinstance(verb, str) and verb for verb in value):
        return None, "MACHINE_READS must be a tuple of verb names"
    return value, None


def _link_verbs_declared(text: str) -> tuple[list | None, str | None]:
    """The verbs a capability's `LINK_METHODS` ceremonies run, as its source
    declares them, read without running it: `([], None)` when it declares
    none, `([(index, argv), ...], None)` when the declaration is a literal
    list of methods whose argv names the capability and then a verb, and
    `(None, problem)` otherwise. The contract lends these verbs the machine's
    connections outside any project, so they are checked as machine reads are.
    The capability each argv names is checked against the declared `NAME`."""
    import ast
    try:
        tree = ast.parse(text)
    except (SyntaxError, ValueError):
        return [], None
    node = None
    for stmt in tree.body:
        if isinstance(stmt, ast.Assign):
            targets = stmt.targets
        elif isinstance(stmt, ast.AnnAssign) and stmt.value is not None:
            targets = [stmt.target]
        else:
            continue
        if any(isinstance(t, ast.Name) and t.id == "LINK_METHODS" for t in targets):
            node = stmt.value
    if node is None:
        return [], None
    try:
        value = ast.literal_eval(node)
    except (ValueError, TypeError, SyntaxError, MemoryError, RecursionError):
        value = None
    if not isinstance(value, list) or not all(isinstance(m, dict) for m in value):
        return None, "LINK_METHODS must be a list of methods"
    verbs = []
    for index, method in enumerate(value):
        argv = method.get("argv")
        if (not isinstance(argv, list) or len(argv) < 2
                or not all(isinstance(a, str) and a for a in argv[:2])):
            return None, (f"LINK_METHODS[{index}].argv must name the capability "
                          "and the verb that links")
        verbs.append((index, argv))
    return verbs, None


def _name_declared(text: str) -> str | None:
    """The capability's `NAME` as its source states it literally, else None."""
    import ast
    try:
        tree = ast.parse(text)
    except (SyntaxError, ValueError):
        return None
    for stmt in tree.body:
        if (isinstance(stmt, ast.Assign) and isinstance(stmt.value, ast.Constant)
                and isinstance(stmt.value.value, str)
                and any(isinstance(t, ast.Name) and t.id == "NAME"
                        for t in stmt.targets)):
            return stmt.value.value
    return None


def _write_verbs_declared(text: str) -> set[str]:
    """Every verb name `WRITE_VERBS` states literally in the source."""
    import ast
    try:
        tree = ast.parse(text)
    except (SyntaxError, ValueError):
        return set()
    names: set[str] = set()
    for stmt in tree.body:
        if isinstance(stmt, ast.Assign):
            targets = stmt.targets
        elif isinstance(stmt, ast.AnnAssign) and stmt.value is not None:
            targets = [stmt.target]
        else:
            continue
        if any(isinstance(t, ast.Name) and t.id == "WRITE_VERBS" for t in targets):
            names |= {n.value for n in ast.walk(stmt.value)
                      if isinstance(n, ast.Constant) and isinstance(n.value, str)}
    return names


def _machine_reads_problems(script: Path, help_text: str | None = None,
                            env: dict | None = None) -> list[str]:
    """The verbs lent the machine's connections outside any project, checked
    where a capability is validated. The declared machine reads: a tuple of
    strings, each a verb the capability exposes - one its `help` names - and
    none of them a write verb. The verbs `LINK_METHODS` ceremonies run: each
    argv names this capability and then such a verb. A capability declaring
    neither has nothing to check, and its `help` is not run for it."""
    try:
        text = script.read_text()
    except (OSError, UnicodeDecodeError):
        return []
    declared, problem = _machine_reads_declared(text)
    links, link_problem = _link_verbs_declared(text)
    problems = [p for p in (problem, link_problem) if p]
    declared = [("MACHINE_READS names", verb) for verb in declared or ()]
    name = _name_declared(text) or script.name
    for index, argv in links or []:
        if argv[0] != name:
            problems.append(f"LINK_METHODS[{index}].argv runs {argv[0]!r}, "
                            f"not this capability {name!r}")
        declared.append((f"LINK_METHODS[{index}] links with", argv[1]))
    if not declared:
        return problems
    writes = _write_verbs_declared(text)
    problems += [f"{at} the write verb {verb!r}"
                 for at, verb in declared if verb in writes]
    if help_text is None:
        rc, help_text, _err = _run_script(script, ["help"], env=env)
        if rc != 0:
            return problems + [
                f"machine reads cannot be checked: `help` exited {rc}"]
    # `help` lists each ceremony's argv itself, so a linking verb is looked
    # for in the rest of it: one the capability documents as its own.
    own_help = help_text
    for _index, argv in links or []:
        own_help = own_help.replace(" ".join(argv), "")
    for at, verb in declared:
        if verb in writes:
            continue
        seen = help_text if at.startswith("MACHINE_READS") else own_help
        if not re.search(rf"(?<![\w-]){re.escape(verb)}(?![\w-])", seen):
            problems.append(f"{at} {verb!r}, a verb the "
                            "capability does not expose")
    return problems

# ---------------------------------------------------------------- snapshots

def _snapshot(name: str, script: Path, registry: Path | None = None) -> dict:
    """Run stub + manifest outside any project; persist snapshots keyed by hash."""
    reg = registry or _registry_dir(name)
    rc, stub_out, err = _run_script(script, ["stub"])
    if rc != 0:
        _die(6, "snapshot_failed", f"`{name} stub` exited {rc}", err.strip() or None)
    rc, man_out, err = _run_script(script, ["manifest", "--json"])
    if rc != 0:
        _die(6, "snapshot_failed", f"`{name} manifest --json` exited {rc}",
             err.strip() or None)
    try:
        manifest = json.loads(man_out)
    except ValueError:
        _die(6, "snapshot_failed", f"`{name} manifest --json` did not emit JSON")
    problems = _validate_manifest(name, manifest)
    if problems:
        _die(6, "manifest_invalid", f"{name}: manifest fails validation",
             "; ".join(problems))
    problems = _machine_reads_problems(script)
    if problems:
        _die(6, "machine_reads_invalid",
             f"{name}: MACHINE_READS or LINK_METHODS fails validation",
             "; ".join(problems))
    (reg / "stub").write_text(stub_out.strip() + "\n")
    _write_json(reg / "manifest.json", manifest)
    return manifest


def _load_snapshots(name: str) -> tuple[str | None, dict | None]:
    reg = _registry_dir(name)
    stub = None
    try:
        stub = (reg / "stub").read_text().strip()
    except OSError:
        pass
    return stub, _read_json(reg / "manifest.json")

# ---------------------------------------------------------------- install

def _bundle_ignore(_dir: str, names: list[str]) -> set[str]:
    ignored = set()
    for n in names:
        if n in {"__pycache__", ".git", ".hg", ".svn"}:
            ignored.add(n)
        elif n.endswith((".pyc", ".pyo", ".session", ".session-journal",
                         ".session-wal", ".session-shm")):
            ignored.add(n)
    return ignored


def _bundle_script(bundle: Path, name: str) -> Path | None:
    for cand in (bundle / name, bundle / "bin" / name):
        if cand.is_file():
            return cand
    return None


def _enclosing_bundle_for_script(script: Path, name: str) -> Path | None:
    """The bundle directory that owns a script path, when it matches the layout."""
    if script.name != name:
        return None
    candidates: list[Path] = []
    if script.parent.name == "bin":
        candidates.append(script.parent.parent)
    candidates.append(script.parent)
    for bundle in candidates:
        cand = _bundle_script(bundle, name)
        if cand is not None and cand.resolve() == script.resolve():
            return bundle
    return None


def _catalogue_archive_url(name: str, script_url: str) -> str | None:
    pattern = (
        rf"^https://raw\.githubusercontent\.com/([^/]+)/([^/]+)/([^/]+)/"
        rf"capabilities/{re.escape(name)}/bin/{re.escape(name)}$"
    )
    m = re.match(pattern, script_url.rstrip("/"))
    if not m:
        return None
    owner, repo, ref = m.groups()
    return f"https://codeload.github.com/{owner}/{repo}/tar.gz/{ref}"


def _extract_tar_safely(archive: Path, dest: Path) -> None:
    root = dest.resolve()
    with tarfile.open(archive, "r:gz") as tf:
        for member in tf.getmembers():
            target = (dest / member.name).resolve()
            if target != root and root not in target.parents:
                _die(5, "server_error", f"archive member escapes target: {member.name}")
            if member.isdir():
                target.mkdir(parents=True, exist_ok=True)
            elif member.isfile():
                src = tf.extractfile(member)
                if src is None:
                    continue
                target.parent.mkdir(parents=True, exist_ok=True)
                with target.open("wb") as out:
                    shutil.copyfileobj(src, out)
                os.chmod(target, member.mode & 0o777)


def _fetch_catalogue_bundle(name: str, script_url: str) -> tuple[bytes, Path, Path] | None:
    httpx = _httpx()
    archive_url = _catalogue_archive_url(name, script_url)
    if archive_url is None:
        return None
    tmp_root = Path(tempfile.mkdtemp(prefix="capabilities-bundle-"))
    try:
        try:
            resp = httpx.get(archive_url, follow_redirects=True, timeout=60.0)
        except httpx.HTTPError as e:
            _die(5, "network_error", f"fetch failed: {e}", archive_url)
        if resp.status_code != 200:
            _die(5, "server_error", f"fetch returned {resp.status_code}", archive_url)
        archive = tmp_root / "repo.tar.gz"
        archive.write_bytes(resp.content)
        _extract_tar_safely(archive, tmp_root)
        for root in sorted(p for p in tmp_root.iterdir() if p.is_dir()):
            bundle = root / "capabilities" / name
            cand = _bundle_script(bundle, name)
            if cand is not None:
                return cand.read_bytes(), tmp_root, bundle
        _die(3, "not_found", f"no bundled capability {name!r} in catalogue archive",
             archive_url)
    except BaseException:
        shutil.rmtree(tmp_root, ignore_errors=True)
        raise


def _resolve_source(name: str, from_ref: str | None) -> tuple[bytes, str, Path | None, Path | None]:
    """Return (script bytes, recorded source string, bundle dir, temp root)."""
    if from_ref and not re.match(r"^https?://", from_ref):
        p = Path(from_ref).expanduser().resolve()
        if p.is_dir():
            bundles = [p]
            repo_bundle = p / "capabilities" / name
            if repo_bundle.is_dir():
                bundles.append(repo_bundle)
            for bundle in bundles:
                cand = _bundle_script(bundle, name)
                if cand is not None:
                    return cand.read_bytes(), str(bundle), bundle, None
            _die(3, "not_found", f"no script for {name!r} under {p}",
                 f"expected {name}, bin/{name}, or capabilities/{name}/bin/{name}")
        if p.is_file():
            bundle = _enclosing_bundle_for_script(p, name)
            if bundle is not None:
                return p.read_bytes(), str(bundle), bundle, None
            return p.read_bytes(), str(p), None, None
        _die(3, "not_found", f"--from path does not exist: {p}")
    url = from_ref or f"{SOURCE}/capabilities/{name}/bin/{name}"
    httpx = _httpx()
    bundle = _fetch_catalogue_bundle(name, url)
    if bundle is not None:
        content, tmp_root, bundle_dir = bundle
        return content, url, bundle_dir, tmp_root
    try:
        resp = httpx.get(url, follow_redirects=True, timeout=30.0)
    except httpx.HTTPError as e:
        _die(5, "network_error", f"fetch failed: {e}", url)
    if resp.status_code == 404:
        _die(3, "not_found", f"no such capability in the catalogue: {name}", url)
    if resp.status_code != 200:
        _die(5, "server_error", f"fetch returned {resp.status_code}", url)
    return resp.content, url, None, None


def _install_payload(name: str, content: bytes, bundle_dir: Path | None,
                     registry: Path) -> Path:
    reg = registry
    reg.mkdir(parents=True, exist_ok=True)
    if bundle_dir is not None:
        source_script = _bundle_script(bundle_dir, name)
        shutil.copytree(bundle_dir, reg, dirs_exist_ok=True, ignore=_bundle_ignore)
        if source_script is not None:
            copied_script = reg / source_script.relative_to(bundle_dir)
            if copied_script != reg / name:
                script_dir = copied_script.parent
                copied_script.unlink(missing_ok=True)
                if script_dir != reg and not any(script_dir.iterdir()):
                    script_dir.rmdir()
    script = reg / name
    script.write_bytes(content)
    script.chmod(script.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    return script


def _validate_installed_payload(name: str, manifest: dict,
                                registry: Path | None = None) -> None:
    reg = registry or _registry_dir(name)
    topics = set((manifest.get("docs") or {}).get("topics") or [])
    guide_dir = reg / "guides"
    shipped = ({path.stem for path in guide_dir.glob("*.md")}
               if guide_dir.is_dir() else set())
    if topics != shipped:
        _die(6, "guide_bundle_incomplete",
             f"{name}: installed guide files do not match manifest topics",
             f"files={sorted(shipped)}, manifest={sorted(topics)}; "
             "install the full bundle")
    if manifest.get("service") is not None and not (reg / "service").is_dir():
        _die(6, "service_bundle_missing",
             f"{name}: manifest declares a service but service/ was not installed",
             "reinstall/update from a bundled source; public catalogue sources should "
             "install the full capability bundle")


def _prepare_payload(name: str, content: bytes, bundle_dir: Path | None,
                     temp_root: Path | None, source: str) -> tuple[Path, dict]:
    """Build and structurally validate a candidate away from the live registry.

    Authoring audit is an explicit command. Installation proves only the
    invariants introduced at this boundary: generated-contract integrity,
    declaration snapshots, and complete bundle layout.
    """
    _require_authoring_assets()
    CAP_HOME.mkdir(parents=True, exist_ok=True)
    stage = Path(tempfile.mkdtemp(prefix=f".{name}-stage-", dir=CAP_HOME))
    try:
        script = _install_payload(name, content, bundle_dir, stage)
        drift = _contract_drift(script.read_text(), _canonical_regions())
        if drift:
            _die(
                7,
                "install_validation_failed",
                f"{name} from {source} has generated contract drift",
                "; ".join(drift),
            )
        manifest = _snapshot(name, script, stage)
        _validate_installed_payload(name, manifest, stage)
        return stage, manifest
    except BaseException:
        shutil.rmtree(stage, ignore_errors=True)
        raise
    finally:
        if temp_root is not None:
            shutil.rmtree(temp_root, ignore_errors=True)


def _activate_payload(name: str, stage: Path) -> Path:
    """Atomically replace one registry entry, restoring the old copy on error."""
    def activate() -> Path:
        _assert_payload_mutable(name, os.environ.get("CAPABILITIES_DEV_SESSION"))
        reg = _registry_dir(name)
        backup = CAP_HOME / f".{name}-previous"
        if backup.exists():
            shutil.rmtree(backup)
        if reg.exists():
            reg.rename(backup)
        try:
            stage.rename(reg)
        except BaseException:
            if backup.exists() and not reg.exists():
                backup.rename(reg)
            raise
        shutil.rmtree(backup, ignore_errors=True)
        return reg / name
    if _MANAGER_MUTATION_DEPTH:
        return activate()
    MANAGER_MUTATION_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with MANAGER_MUTATION_LOCK.open("a+") as mutation:
        MANAGER_MUTATION_LOCK.chmod(0o600)
        fcntl.flock(mutation, fcntl.LOCK_EX)
        return activate()


def _payload_sha256(reg: Path, script: str | None = None) -> str:
    """Hash a payload tree.

    With `script`, a top-level script of that name is hashed at bin/<script>,
    where a source bundle carries it, so an installed copy answers with the
    payload_sha256 the generated catalogue records for its source.
    """
    h = hashlib.sha256()
    skip = {"meta.json", "stub", "manifest.json"}
    cache_dirs = {"__pycache__", ".pytest_cache", ".ruff_cache"}
    files = []
    for path in (p for p in reg.rglob("*") if p.is_file()):
        if (path.name in skip or cache_dirs.intersection(path.parts)
                or path.suffix in {".pyc", ".pyo", ".session"}
                or path.name.endswith((".session-journal", ".session-wal", ".session-shm"))):
            continue
        rel = path.relative_to(reg).as_posix()
        if script is not None and rel == script:
            rel = f"bin/{script}"
        files.append((reg / rel, rel, path))
    for _order, rel, path in sorted(files):
        h.update(rel.encode("utf-8") + b"\0")
        h.update(path.read_bytes())
        h.update(b"\0")
    return h.hexdigest()


def _symlink(name: str, script: Path) -> Path:
    bin_dirs = _link_dirs()
    for bin_dir in bin_dirs:
        bin_dir.mkdir(parents=True, exist_ok=True)
        link = bin_dir / name
        if link.is_symlink() or link.exists():
            link.unlink()
        link.symlink_to(script)
    on_path = {Path(p).expanduser().resolve() for p in
               os.environ.get("PATH", "").split(os.pathsep) if p}
    if not any(d.resolve() in on_path for d in bin_dirs):
        _warn(f"{bin_dirs[0]} is not on PATH — add it so `{name}` resolves by name")
    return bin_dirs[0] / name


MIGRATE_TIMEOUT_SECONDS = 120


def _migrate_tables(name: str, script: Path, manifest: dict) -> dict | None:
    """Run `<name> migrate` for a payload whose manifest declares tables in the
    machine's store, so its tables reach its code where the code arrives.

    It runs outside any project, as the snapshots do. A refusal is reported and
    never undoes the payload: the capability's own first call still migrates on
    its locked fallback path."""
    if manifest.get("tables") is not True:
        return None
    rc, out, err = _run_script(script, ["migrate"], timeout=MIGRATE_TIMEOUT_SECONDS)
    if rc == 0:
        try:
            report = json.loads(out)
        except ValueError:
            report = {}
        return {"ok": True, "applied": report.get("applied") or [],
                "version": report.get("version")}
    error = None
    for line in reversed(err.strip().splitlines()):
        try:
            error = json.loads(line)["error"]
            break
        except (ValueError, KeyError, TypeError):
            continue
    return {"ok": False, "exit": rc,
            "error": error or {"code": "migrate_failed",
                               "message": err.strip()[-500:] or f"exited {rc}"}}


def _scaffold_credentials(name: str, manifest: dict) -> list[str]:
    """Per declared scope. Returns human-facing notes. Never writes a secret."""
    notes: list[str] = []
    creds = manifest.get("credentials", {})
    keys = [k for k in creds.get("keys", []) if isinstance(k, dict)]
    if not keys:
        return notes
    required = [k["key"] for k in keys if k.get("required")]
    if creds.get("scope") == "user":
        cred_file = _CONFIG_HOME / name / "credentials.env"
        existing = ""
        if cred_file.exists():
            existing = cred_file.read_text()
        else:
            cred_file.parent.mkdir(parents=True, exist_ok=True)
            cred_file.touch(mode=0o600)
        added = []
        with cred_file.open("a") as f:
            for k in keys:
                if k["key"] not in existing:
                    note = k.get("note", "")
                    # The note is a full-line comment, never inline after `=`:
                    # the cascade parser does not strip inline comments (a `#`
                    # can be a legitimate secret character), so an inline note
                    # would be read as the value.
                    f.write(f"# {note}\n{k['key']}=\n" if note else f"{k['key']}=\n")
                    added.append(k["key"])
        if added:
            notes.append(f"fill {', '.join(added)} in {cred_file}")
    else:
        if required:
            notes.append(
                f"project scope: set {', '.join(required)} in the consuming "
                f"project's .env or .env.local")
    return notes


def cmd_install(name: str, from_ref: str | None, source_id: str | None,
                yes: bool, allow: bool = False) -> None:
    _reject_reserved_capability_name(name)
    _assert_payload_mutable(name)
    fresh = name not in _installed()
    # The tier is a fact about the official catalogue, so only a payload from
    # it arrives as core; one named by --from or --source merely carries the
    # name and arrives as any other capability does. The read-only switch
    # never opens a gate, so under it a core capability arrives as any other.
    core_arrival = (fresh and name in CORE_CAPABILITIES
                    and from_ref is None and source_id is None
                    and not _store_module().read_only_switch())
    provenance = {}
    if source_id:
        if from_ref:
            _die(6, "input", "install accepts either --from or --source, not both")
        from_ref, provenance = _source_install_ref(name, source_id)
    content, source, bundle_dir, temp_root = _resolve_source(name, from_ref)
    stage, manifest = _prepare_payload(name, content, bundle_dir, temp_root, source)
    _write_json(stage / "meta.json", {
        "name": name, "source": source, "source_type": "directory" if bundle_dir else "script",
        "sha256": _sha256(stage / name), "payload_sha256": _payload_sha256(stage),
        **provenance,
    })
    # A capability new to this machine arrives quarantined unless the install
    # allows it or it arrives as core; one already installed keeps the state it
    # has. The ceiling is written before the payload lands, so no moment exists
    # in which a fresh payload is installed and not yet quarantined.
    previous = _load_machine()["capabilities"].get(name)
    global_policy = None
    try:
        if fresh or allow:
            _write_machine(name, "allowed" if allow or core_arrival else "quarantined",
                           record=True)
        # A core capability also arrives enabled at global scope, unless that
        # scope already holds the user's own entry for it.
        if core_arrival:
            global_policy = _arrival_global_enable(name)
        script = _activate_payload(name, stage)
    except BaseException:
        if fresh or allow:
            _write_machine(name, previous["state"] if previous else None)
        if global_policy and not global_policy.get("pending"):
            _arrival_global_enable(name, undo=True)
        shutil.rmtree(stage, ignore_errors=True)
        raise
    reg = _registry_dir(name)
    link = _symlink(name, script)
    migrated = _migrate_tables(name, script, manifest)
    notes = _scaffold_credentials(name, manifest)
    post = manifest.get("post_install") or []
    ran = []
    if post and yes:
        for step in post:
            proc = subprocess.run(["sh", "-c", step["cmd"]], capture_output=True,
                                  text=True, env=_snapshot_env())
            ran.append({"cmd": step["cmd"], "exit": proc.returncode})
    _sync_skill()
    result = {
        "installed": name, "registry": str(reg), "symlink": str(link),
        "summary": manifest.get("summary"), "scope": manifest["credentials"]["scope"],
        "bundle": bool(bundle_dir),
        "machine": _machine_state(name),
        "project_visibility": _project_visibility_hint(name),
    }
    if result["machine"] == "quarantined":
        result["machine_hint"] = (
            f"{name} is quarantined on this machine: no project can use it "
            f"until the user runs `capabilities allow {name}`; an agent never "
            "lifts a quarantine itself")
    if global_policy:
        result["global_policy"] = global_policy
    if migrated is not None:
        result["migrate"] = migrated
    if notes:
        result["credentials"] = notes
    if post and not yes:
        result["post_install"] = [
            {"cmd": s["cmd"], "note": s.get("note", "")} for s in post]
        result["post_install_hint"] = \
            "declared idempotent — review and re-run install with --yes to execute"
    if ran:
        result["post_install_ran"] = ran
    _emit(result)


def cmd_uninstall(name: str, purge_credentials: bool) -> None:
    _reject_reserved_capability_name(name)
    _assert_payload_mutable(name)
    reg = _registry_dir(name)
    if not reg.is_dir():
        _die(3, "not_found", f"{name} is not installed")
    MANAGER_MUTATION_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with MANAGER_MUTATION_LOCK.open("a+") as mutation:
        fcntl.flock(mutation, fcntl.LOCK_EX)
        _assert_payload_mutable(name)
        removed_link = False
        for bin_dir in _link_dirs():
            if (bin_dir / name).is_symlink():
                (bin_dir / name).unlink()
                removed_link = True
        shutil.rmtree(reg)
    _write_machine(name, None)
    _sync_skill()
    result = {"uninstalled": name, "symlink_removed": removed_link}
    cred_file = _CONFIG_HOME / name / "credentials.env"
    if cred_file.exists():
        if purge_credentials:
            shutil.rmtree(cred_file.parent)
            result["credentials_purged"] = str(cred_file)
        else:
            result["credentials_kept"] = str(cred_file)
    _emit(result)


def cmd_update(name: str | None) -> None:
    if name:
        _reject_reserved_capability_name(name)
    targets = [name] if name else sorted(_installed())
    if name and not _registry_dir(name).is_dir():
        _die(3, "not_found", f"{name} is not installed")
    results = []
    for n in targets:
        _assert_payload_mutable(n)
        meta = _read_json(_registry_dir(n) / "meta.json") or {}
        source_id = meta.get("source_id")
        provenance = {}
        if source_id:
            source, provenance = _source_install_ref(n, source_id)
        else:
            source = meta.get("source")
        before = meta.get("payload_sha256")
        if before is None and _script_path(n).exists():
            before = _sha256(_script_path(n))
        content, source, bundle_dir, temp_root = _resolve_source(n, source)
        stage, manifest = _prepare_payload(n, content, bundle_dir, temp_root, source)
        after = _payload_sha256(stage)
        _write_json(stage / "meta.json", {
            "name": n, "source": source, "source_type": "directory" if bundle_dir else "script",
            "sha256": _sha256(stage / n), "payload_sha256": after,
            **provenance,
        })
        script = _activate_payload(n, stage)
        entry = {"name": n, "changed": before != after}
        migrated = _migrate_tables(n, script, manifest)
        if migrated is not None:
            entry["migrate"] = migrated
        results.append(entry)
    _sync_skill()
    _emit({"updated": results})


def _captured(fn, *args):
    """Run one step that may `_die`, returning (value, None) or (None, error)."""
    errors = io.StringIO()
    try:
        with redirect_stderr(errors):
            return fn(*args), None
    except SystemExit:
        for line in reversed(errors.getvalue().splitlines()):
            try:
                return None, json.loads(line)["error"]
            except (ValueError, KeyError, TypeError):
                continue
        return None, {"code": "check_failed", "message": "the check stopped without a reason"}


def _changelog_version(text: str | None) -> str | None:
    """The version a change log names: its newest entry's heading."""
    entries = _changelog_entries(text) if text else []
    return entries[0]["heading"] if entries else None


def _changelog_version_at(path: Path) -> str | None:
    try:
        return _changelog_version(path.read_text()) if path.is_file() else None
    except OSError:
        return None


def _changelog_version_from_url(url: str) -> str | None:
    httpx = _httpx()
    try:
        resp = httpx.get(url, follow_redirects=True, timeout=30.0)
    except httpx.HTTPError:
        return None
    return _changelog_version(resp.text) if resp.status_code == 200 else None


def _fetch_json(url: str, label: str) -> dict:
    httpx = _httpx()
    try:
        resp = httpx.get(url, follow_redirects=True, timeout=30.0)
    except httpx.HTTPError as exc:
        _die(5, "network_error", f"{label} fetch failed: {exc}", url)
    if resp.status_code != 200:
        _die(5, "server_error", f"{label} fetch returned {resp.status_code}", url)
    try:
        value = json.loads(resp.content)
    except ValueError as exc:
        _die(5, "server_error", f"{label} is not JSON: {exc}", url)
    if not isinstance(value, dict):
        _die(5, "server_error", f"{label} is not a JSON object", url)
    return value


def _catalogue_entry(catalog: object, name: str, where: str) -> dict:
    entries = catalog.get("capabilities") if isinstance(catalog, dict) else None
    if not isinstance(entries, dict):
        _die(5, "catalog_missing", f"{where} carries no generated capability catalogue")
    entry = entries.get(name)
    if not isinstance(entry, dict) or not entry.get("payload_sha256"):
        _die(3, "not_found", f"{where} carries no capability {name!r}")
    return entry


def _available_payload(name: str, meta: dict, refreshed: dict,
                       catalogues: dict) -> tuple[str, str, Callable[[], str | None]]:
    """Where `update` would fetch `name` from, and the payload it would find.

    Returns (source, catalogue hash, version reader). A registered source is
    brought forward exactly as `update` brings it forward, once per run; a
    catalogue URL is answered from the catalogue it publishes, fetched once.
    """
    source_id = meta.get("source_id")
    if source_id:
        if source_id not in refreshed:
            refreshed[source_id] = _captured(_refresh_source, source_id)
        _state, error = refreshed[source_id]
        if error is not None:
            _die(5, error.get("code", "source_unavailable"), error.get("message", ""),
                 error.get("hint"))
        root = _source_root(source_id)
        capdir = root / "capabilities" / name
        entry = _catalogue_entry(_read_json(root / ".capability-source" / "catalog.json"),
                                 name, f"source {source_id!r}")
        return source_id, entry["payload_sha256"], \
            lambda: _changelog_version_at(capdir / CHANGELOG_NAME)
    recorded = meta.get("source") or f"{SOURCE}/capabilities/{name}/bin/{name}"
    if not re.match(r"^https?://", recorded):
        p = Path(recorded)
        if p.is_dir():
            return recorded, _payload_sha256(p, name), \
                lambda: _changelog_version_at(p / CHANGELOG_NAME)
        if p.is_file():
            return recorded, _single_script_catalogue_sha256(name, p.read_bytes()), \
                lambda: None
        _die(3, "not_found", f"{name}'s recorded source no longer exists: {p}")
    script_rel = f"/capabilities/{name}/bin/{name}"
    if recorded.endswith(script_rel):
        base = recorded[:-len(script_rel)]
        if base not in catalogues:
            catalogues[base] = _captured(
                _fetch_json, f"{base}/.capability-source/catalog.json", "catalogue")
        catalog, error = catalogues[base]
        if error is not None:
            _die(5, error.get("code", "network_error"), error.get("message", ""),
                 error.get("hint"))
        entry = _catalogue_entry(catalog, name, f"the catalogue at {base}")
        return recorded, entry["payload_sha256"], lambda: _changelog_version_from_url(
            f"{base}/capabilities/{name}/{CHANGELOG_NAME}")
    httpx = _httpx()
    try:
        resp = httpx.get(recorded, follow_redirects=True, timeout=30.0)
    except httpx.HTTPError as exc:
        _die(5, "network_error", f"fetch failed: {exc}", recorded)
    if resp.status_code != 200:
        _die(5, "server_error", f"fetch returned {resp.status_code}", recorded)
    return recorded, _single_script_catalogue_sha256(name, resp.content), lambda: None


def _single_script_catalogue_sha256(name: str, content: bytes) -> str:
    """The catalogue hash of a payload that is one script and nothing else."""
    h = hashlib.sha256()
    h.update(f"bin/{name}".encode("utf-8") + b"\0")
    h.update(content)
    h.update(b"\0")
    return h.hexdigest()


def cmd_update_check(name: str | None) -> None:
    """Answer what `update` would change, changing nothing."""
    if name:
        _reject_reserved_capability_name(name)
    targets = [name] if name else sorted(_installed())
    if name and not _registry_dir(name).is_dir():
        _die(3, "not_found", f"{name} is not installed")
    refreshed: dict = {}
    catalogues: dict = {}
    rows = []
    for n in targets:
        reg = _registry_dir(n)
        meta = _read_json(reg / "meta.json") or {}
        installed = {"catalog_sha256": _payload_sha256(reg, n),
                     "version": _changelog_version_at(reg / CHANGELOG_NAME)}
        if meta.get("source_commit"):
            installed["source_commit"] = meta["source_commit"]
        row = {"name": n, "source": meta.get("source_id") or meta.get("source"),
               "installed": installed, "available": None, "update_available": False}
        found, error = _captured(_available_payload, n, meta, refreshed, catalogues)
        if error is not None:
            row["error"] = error
        else:
            source, available_sha, version_reader = found
            behind = available_sha != installed["catalog_sha256"]
            row["source"] = source
            row["available"] = {
                "catalog_sha256": available_sha,
                "version": version_reader() if behind else installed["version"]}
            row["update_available"] = behind
        rows.append(row)
    _emit({"checked": rows,
           "update_available": any(row["update_available"] for row in rows)})
    if any("error" in row for row in rows):
        sys.exit(5)


# ---------------------------------------------------------------- change logs

def _changelog_entries(text: str) -> list[dict[str, str]]:
    """Split a change log into its entries, in the log's own newest-first order.

    An entry is a `## ` heading and the body under it, and the heading is the
    entry's identity. A line inside a fenced block never opens an entry.
    """
    entries: list[tuple[str, list[str]]] = []
    fenced = False
    for line in text.splitlines():
        if line.lstrip().startswith(("```", "~~~")):
            fenced = not fenced
        if not fenced and line.startswith("## "):
            entries.append((line[3:].strip(), []))
        elif entries:
            entries[-1][1].append(line)
    return [{"heading": heading, "body": "\n".join(body).strip()}
            for heading, body in entries]


def _changelog_from_path(path: Path, label: str) -> tuple[str, str]:
    if not path.is_file():
        _die(3, "changelog_not_found", f"{label} carries no change log at {path}",
             "the source predates change logs or does not ship this one")
    try:
        return path.read_text(), str(path)
    except OSError as exc:
        _die(5, "changelog_unreadable", f"cannot read {path}: {exc}")


def _changelog_from_url(url: str, label: str) -> tuple[str, str]:
    httpx = _httpx()
    try:
        resp = httpx.get(url, follow_redirects=True, timeout=30.0)
    except httpx.HTTPError as exc:
        _die(5, "network_error", f"fetch failed: {exc}", url)
    if resp.status_code == 404:
        _die(3, "changelog_not_found", f"{label} carries no change log at its source",
             f"{url}: the source predates change logs or does not ship this one")
    if resp.status_code != 200:
        _die(5, "server_error", f"fetch returned {resp.status_code}", url)
    return resp.text, url


def _capability_changelog_source(name: str, meta: dict, from_ref: str | None,
                                 source_id: str | None) -> tuple[str, str]:
    """The capability's log as published where `update` would fetch it.

    A registered source is read from its local tree, as `search` reads it, so
    this stays a read; `source refresh` is what brings that tree forward.
    """
    if from_ref:
        p = Path(from_ref).expanduser().resolve()
        if p.is_file():
            return _changelog_from_path(p, name)
        if not p.is_dir():
            _die(3, "not_found", f"--from path does not exist: {p}")
        repo_bundle = p / "capabilities" / name
        bundle = repo_bundle if repo_bundle.is_dir() else p
        return _changelog_from_path(bundle / CHANGELOG_NAME, name)
    source_id = source_id or meta.get("source_id")
    if source_id:
        root = _source_author_root(source_id)
        if not root.is_dir():
            _die(5, "source_unavailable", f"source {source_id!r} has no local tree",
                 f"capabilities source refresh {source_id}")
        capdir = root / "capabilities" / name
        if not capdir.is_dir():
            _die(3, "not_found", f"source {source_id!r} has no capability {name!r}")
        return _changelog_from_path(capdir / CHANGELOG_NAME, name)
    recorded = meta.get("source")
    if recorded and not re.match(r"^https?://", recorded):
        p = Path(recorded)
        if p.is_dir():
            return _changelog_from_path(p / CHANGELOG_NAME, name)
        if p.is_file():
            _die(3, "changelog_not_found",
                 f"{name} was installed from a lone script, which carries no change log",
                 str(p))
        _die(3, "not_found", f"{name}'s recorded source no longer exists: {p}")
    url = recorded or f"{SOURCE}/capabilities/{name}/bin/{name}"
    script_rel = f"/capabilities/{name}/bin/{name}"
    if not url.endswith(script_rel):
        _die(3, "changelog_not_found",
             f"{name} was installed from a lone script, which carries no change log",
             url)
    return _changelog_from_url(url[:-len(f"bin/{name}")] + CHANGELOG_NAME, name)


def _active_manager_root() -> Path | None:
    """The release the manager on PATH runs from, located as it locates its assets."""
    try:
        executable = (_bin_dir() / "capabilities").resolve(strict=True)
    except OSError:
        return None
    root = executable.parent.parent
    return root if (root / "contract" / "preamble.py").is_file() else executable.parent


def cmd_changelog(name: str | None, kind: str, show_all: bool,
                  from_ref: str | None, source_id: str | None) -> None:
    """Print what changed for someone who already holds the thing.

    One reader for every log. The installed version is the newest entry of the
    installed copy's own log, so what is new is every published entry above
    the first one that copy already carries.
    """
    if kind == "capability":
        assert name is not None
        _reject_reserved_capability_name(name)
        target = name
        reg = _registry_dir(name)
        installed_here = (reg / name).is_file()
        meta = (_read_json(reg / "meta.json") or {}) if installed_here else {}
        text, read_from = _capability_changelog_source(
            name, meta, from_ref, source_id)
        installed_log = reg / CHANGELOG_NAME
        installed = {"registry": str(reg)} if installed_here else None
        if installed is not None and meta.get("source_commit"):
            installed["source_commit"] = meta["source_commit"]
    else:
        target = "capabilities" if kind == "manager" else "contract"
        rel = MANAGER_CHANGELOG_REL if kind == "manager" else CONTRACT_CHANGELOG_REL
        if from_ref:
            p = Path(from_ref).expanduser().resolve()
            if not p.exists():
                _die(3, "not_found", f"--from path does not exist: {p}")
            text, read_from = _changelog_from_path(p if p.is_file() else p / rel, target)
        else:
            text, read_from = _changelog_from_url(f"{SOURCE.rstrip('/')}/{rel}", target)
        release = _active_manager_root()
        installed_log = release / rel if release is not None else None
        installed = {"release": str(release)} if release is not None else None

    entries = _changelog_entries(text)
    note = None
    if installed is None:
        note = f"{target} is not installed here; this is its whole log"
        shown = entries
    else:
        carried = []
        if installed_log is not None and installed_log.is_file():
            try:
                carried = _changelog_entries(installed_log.read_text())
            except OSError:
                carried = []
            installed["log"] = str(installed_log)
        else:
            installed["log"] = None
            note = ("the installed copy predates change logs, so every entry "
                    "is newer than it")
        installed["version"] = carried[0]["heading"] if carried else None
        held = {entry["heading"] for entry in carried}
        since = []
        for entry in entries:
            if entry["heading"] in held:
                break
            since.append(entry)
        if held and len(since) == len(entries):
            note = (f"the installed version {installed['version']!r} is not in "
                    "the published log, so every entry is shown")
        shown = entries if show_all else since
    result = {"target": target, "kind": kind, "log": read_from,
              "installed": installed,
              "view": "all" if show_all or installed is None else "since-installed",
              "entries": shown}
    if note:
        result["note"] = note
    _emit(result)


def _manager_release_manifest_bytes(manifest: dict) -> bytes:
    return (json.dumps(manifest, ensure_ascii=False, indent=2, sort_keys=True)
            + "\n").encode()


def _valid_release_relpath(value: object) -> bool:
    if not isinstance(value, str) or not value \
            or not re.fullmatch(r"[A-Za-z0-9._/-]+", value):
        return False
    path = Path(value)
    return (not path.is_absolute() and value == path.as_posix()
            and all(part not in ("", ".", "..") for part in path.parts))


def _validate_manager_release_manifest(manifest: object) -> list[str]:
    problems: list[str] = []
    if not isinstance(manifest, dict):
        return ["release manifest is not a JSON object"]
    if manifest.get("schema") != MANAGER_RELEASE_SCHEMA:
        problems.append(
            f"release manifest schema must be {MANAGER_RELEASE_SCHEMA!r}")
    manager = manifest.get("manager")
    if not isinstance(manager, dict):
        problems.append("release manifest manager is not an object")
    else:
        if manager.get("path") != MANAGER_EXECUTABLE_REL:
            problems.append(
                f"release manifest manager.path must be {MANAGER_EXECUTABLE_REL!r}")
        if not re.fullmatch(r"[0-9a-f]{64}", str(manager.get("sha256") or "")):
            problems.append("release manifest manager.sha256 is invalid")
    assets = manifest.get("assets")
    if not isinstance(assets, dict) or not assets:
        problems.append("release manifest assets must be a non-empty object")
    else:
        valid_paths = [MANAGER_EXECUTABLE_REL, MANAGER_RELEASE_MANIFEST_REL]
        for rel, digest in assets.items():
            if not _valid_release_relpath(rel) or rel == MANAGER_EXECUTABLE_REL \
                    or rel == MANAGER_RELEASE_MANIFEST_REL:
                problems.append(f"release manifest asset path is invalid: {rel!r}")
            else:
                valid_paths.append(rel)
            if not re.fullmatch(r"[0-9a-f]{64}", str(digest or "")):
                problems.append(f"release manifest hash is invalid: {rel!r}")
        for index, left in enumerate(valid_paths):
            left_parts = tuple(part.casefold() for part in Path(left).parts)
            for right in valid_paths[index + 1:]:
                right_parts = tuple(part.casefold() for part in Path(right).parts)
                shorter = min(len(left_parts), len(right_parts))
                if left_parts[:shorter] == right_parts[:shorter]:
                    problems.append(
                        f"release manifest paths conflict: {left!r} and {right!r}")
    return problems


def _manager_release_payload(root: Path) -> tuple[dict | None, list[str]]:
    """Expected manifest for a source carrying the official manager."""
    manager = root / MANAGER_EXECUTABLE_REL
    manifest_path = root / MANAGER_RELEASE_MANIFEST_REL
    if not manager.is_file():
        return (None, [f"{MANAGER_RELEASE_MANIFEST_REL} exists without a manager"]
                if manifest_path.exists() else [])
    missing = [rel for rel in _MANAGER_RELEASE_ASSETS
               if not (root / rel).is_file()]
    if missing:
        return None, ["manager release assets are missing: " + ", ".join(missing)]
    payload = {
        "schema": MANAGER_RELEASE_SCHEMA,
        "manager": {
            "path": MANAGER_EXECUTABLE_REL,
            "sha256": _sha256(manager),
        },
        "assets": {
            rel: _sha256(root / rel) for rel in _MANAGER_RELEASE_ASSETS
        },
    }
    problems = _validate_manager_release_manifest(payload)
    if problems:
        return None, [
            "generated manager release manifest is invalid: "
            + "; ".join(problems)
        ]
    return payload, []


def _manager_release_parts(
    manifest: object, source: str
) -> tuple[dict, str, dict[str, str]]:
    problems = _validate_manager_release_manifest(manifest)
    if problems:
        _die(5, "manager_release_invalid",
             "incoming manager release manifest is invalid",
             f"{source}: {'; '.join(problems)}")
    assert isinstance(manifest, dict)
    manager = manifest["manager"]
    return manifest, manager["path"], dict(manifest["assets"])


def _verify_manager_release_bytes(
    manifest: dict, content: bytes, assets: dict[str, bytes], source: str
) -> None:
    expected_assets = manifest["assets"]
    if set(assets) != set(expected_assets):
        missing = sorted(set(expected_assets) - set(assets))
        extra = sorted(set(assets) - set(expected_assets))
        _die(5, "manager_release_incomplete",
             "incoming manager release files do not match its manifest",
             f"{source}: missing={missing}, extra={extra}")
    actual = hashlib.sha256(content).hexdigest()
    if actual != manifest["manager"]["sha256"]:
        _die(5, "manager_release_hash_mismatch",
             "incoming manager executable failed its release hash",
             f"{source}: expected {manifest['manager']['sha256']}, got {actual}")
    for rel, body in assets.items():
        actual = hashlib.sha256(body).hexdigest()
        if actual != expected_assets[rel]:
            _die(5, "manager_release_hash_mismatch",
                 f"incoming manager asset failed its release hash: {rel}",
                 f"{source}: expected {expected_assets[rel]}, got {actual}")


def _manager_release_from_root(
    root: Path, source: str
) -> tuple[bytes, dict[str, bytes], dict]:
    manifest_path = root / MANAGER_RELEASE_MANIFEST_REL
    manifest = _read_json(manifest_path)
    if manifest is None:
        _die(5, "manager_release_missing",
             f"incoming manager release has no {MANAGER_RELEASE_MANIFEST_REL}",
             f"{source}: index the release with `capabilities source index official`")
    manifest, manager_rel, asset_hashes = _manager_release_parts(
        manifest, str(manifest_path))
    try:
        content = (root / manager_rel).read_bytes()
        assets = {rel: (root / rel).read_bytes() for rel in asset_hashes}
    except OSError as exc:
        _die(5, "manager_release_incomplete",
             f"incoming manager release file cannot be read: {exc}", source)
    _verify_manager_release_bytes(manifest, content, assets, source)
    return content, assets, manifest


def _manager_release_from_remote(httpx) -> tuple[bytes, dict[str, bytes], dict, str]:
    manifest_url = f"{SOURCE.rstrip('/')}/{MANAGER_RELEASE_MANIFEST_REL}"

    def fetch(url: str, label: str) -> bytes:
        try:
            response = httpx.get(url, follow_redirects=True, timeout=30.0)
        except httpx.HTTPError as exc:
            _die(5, "network_error", f"{label} fetch failed: {exc}", url)
        if response.status_code != 200:
            _die(5, "server_error",
                 f"{label} fetch returned {response.status_code}", url)
        return response.content

    raw_manifest = fetch(manifest_url, "manager release manifest")
    try:
        parsed = json.loads(raw_manifest)
    except ValueError as exc:
        _die(5, "manager_release_invalid",
             f"incoming manager release manifest is not JSON: {exc}", manifest_url)
    manifest, manager_rel, asset_hashes = _manager_release_parts(
        parsed, manifest_url)
    content = fetch(f"{SOURCE.rstrip('/')}/{manager_rel}", "manager executable")
    assets = {
        rel: fetch(f"{SOURCE.rstrip('/')}/{rel}", f"manager asset {rel}")
        for rel in asset_hashes
    }
    _verify_manager_release_bytes(manifest, content, assets, manifest_url)
    return content, assets, manifest, manifest_url


def _activate_manager_release(
    content: bytes, assets: dict[str, bytes], source: str, manifest: dict
) -> dict:
    """Stage one verified versioned release, then atomically switch PATH."""
    if b"uv run" not in content.split(b"\n", 1)[0]:
        _die(5, "server_error", "manager payload does not look executable", source)
    _verify_manager_release_bytes(manifest, content, assets, source)
    manifest_bytes = _manager_release_manifest_bytes(manifest)
    release_id = hashlib.sha256(manifest_bytes).hexdigest()
    releases = CAP_HOME / ".manager" / "releases"
    release = releases / release_id
    manager_rel = manifest["manager"]["path"]
    manager = release / manager_rel
    files = {manager_rel: content, **assets,
             MANAGER_RELEASE_MANIFEST_REL: manifest_bytes}
    try:
        releases.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        _die(5, "manager_release_stage_failed",
             "could not prepare the manager release store", str(exc))
    release_repaired = False
    if release.exists():
        mismatched = []
        for rel, body in files.items():
            target = release / rel
            try:
                matches = target.is_file() and target.read_bytes() == body
            except OSError:
                matches = False
            if not matches:
                mismatched.append(rel)
        if mismatched:
            _die(5, "manager_release_corrupt",
                 "an existing staged manager release is incomplete or corrupt",
                 f"{release}: {', '.join(mismatched)}")
        try:
            executable = manager.stat().st_mode \
                & (stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
            if not executable:
                manager.chmod(
                    manager.stat().st_mode
                    | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
                release_repaired = True
        except OSError as exc:
            _die(5, "manager_release_corrupt",
                 "the staged manager release is not executable", str(exc))
    else:
        try:
            stage = Path(tempfile.mkdtemp(
                prefix=".manager-release-", dir=releases))
        except OSError as exc:
            _die(5, "manager_release_stage_failed",
                 "could not create a temporary manager release", str(exc))
        try:
            try:
                for rel, body in files.items():
                    target = stage / rel
                    target.parent.mkdir(parents=True, exist_ok=True)
                    target.write_bytes(body)
                staged_manager = stage / manager_rel
                staged_manager.chmod(
                    staged_manager.stat().st_mode
                    | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
                stage.rename(release)
            except OSError as exc:
                _die(5, "manager_release_stage_failed",
                     "could not publish the staged manager release", str(exc))
        finally:
            if stage.exists():
                shutil.rmtree(stage, ignore_errors=True)

    link = _bin_dir() / "capabilities"
    previous = None
    try:
        previous = link.resolve(strict=True)
    except OSError:
        legacy = CAP_HOME / ".manager" / "capabilities"
        if legacy.is_file():
            previous = legacy
    try:
        before = _sha256(previous) \
            if previous is not None and previous.is_file() else None
        manager_target = manager.resolve(strict=True)
    except OSError as exc:
        _die(5, "manager_release_corrupt",
             "the complete manager release cannot be read", str(exc))
    after = hashlib.sha256(content).hexdigest()
    link_changed = previous != manager_target or before != after
    # A manager link an older manager left in a second directory is relinked
    # too, so whichever one a call's PATH reaches runs this release.
    stale_links = []
    for other in _manager_link_dirs():
        other_link = other / "capabilities"
        try:
            if other.resolve() == link.parent.resolve():
                continue
            if other_link.resolve(strict=True) == manager_target:
                continue
        except OSError:
            pass
        stale_links.append(other_link)
    changed = release_repaired or link_changed or bool(stale_links)
    result = {
        "self_update": "updated" if changed else "already current",
        "manager": str(manager),
        "release": release_id,
        "release_manifest": str(release / MANAGER_RELEASE_MANIFEST_REL),
        "sha256_before": before,
        "sha256_after": after,
        "symlink": str(link),
        "source": source,
        "manager_assets": sorted(assets),
    }
    if stale_links:
        result["also_relinked"] = [str(other) for other in stale_links]
    for target_link in ([link] if link_changed else []) + stale_links:
        temporary_link = target_link.with_name(
            f".{target_link.name}.manager-release-{secrets.token_hex(8)}")
        try:
            target_link.parent.mkdir(parents=True, exist_ok=True)
            temporary_link.symlink_to(manager)
            os.replace(temporary_link, target_link)
        except OSError as exc:
            _die(5, "manager_release_activate_failed",
                 "the complete manager release was staged but could not be activated",
                 str(exc))
        finally:
            try:
                temporary_link.unlink(missing_ok=True)
            except OSError:
                pass
    return result


def cmd_self_update(from_ref: str | None = None) -> None:
    """Refresh the installed manager itself from the canonical source.

    The manager is not a capability — it has no registry entry, no snapshots,
    no gate. Versioned releases live under CAP_HOME/.manager/releases, with one
    atomic PATH symlink selecting the complete active release. install.sh is the
    first-install bootstrap; this is the ongoing update, a discoverable verb
    rather than a remembered curl one-liner. Idempotent when the complete
    release manifest already names the active target.
    """
    with _manager_mutation_guard():
        if from_ref:
            source_root = Path(from_ref).expanduser().resolve()
            asset_root = source_root if source_root.is_dir() else source_root.parent.parent
            content, assets, manifest = _manager_release_from_root(
                asset_root, f"local:{source_root}")
            _emit(_activate_manager_release(
                content, assets, f"local:{source_root}", manifest))
            return
        httpx = _httpx()
        checkout_result = None
        checkout = _marked_checkout(Path.cwd())
        if (checkout is not None and checkout == _REPO_ROOT.resolve()
                and _source_id_for_repo(checkout) == OFFICIAL_SOURCE_ID):
            identity = _git_checkout_identity(checkout)
            common = Path(identity["git_common_dir"])
            if common.parent.resolve() == checkout:
                checkout_result = cmd_source_register_checkout(
                    OFFICIAL_SOURCE_ID, emit_result=False)
        content, assets, manifest, source = _manager_release_from_remote(httpx)
        result = _activate_manager_release(content, assets, source, manifest)
        if checkout_result is not None:
            result["official_checkout"] = checkout_result
        _emit(result)


def cmd_self_update_check(from_ref: str | None = None) -> None:
    """Answer whether `self-update` would switch the manager, switching nothing.

    A release is named by the sha256 of its normalised manifest, the name
    `self-update` stages it under, so two releases are the same release exactly
    when `self-update` would leave the PATH symlink where it is.
    """
    if from_ref:
        source_root = Path(from_ref).expanduser().resolve()
        root = source_root if source_root.is_dir() else source_root.parent.parent
        source = f"local:{source_root}"
        manifest_path = root / MANAGER_RELEASE_MANIFEST_REL
        incoming = _read_json(manifest_path)
        if incoming is None:
            _die(5, "manager_release_missing",
                 f"incoming manager release has no {MANAGER_RELEASE_MANIFEST_REL}",
                 f"{source}: index the release with `capabilities source index official`")
        manifest, _rel, _assets = _manager_release_parts(incoming, str(manifest_path))
        read_version = lambda: _changelog_version_at(root / MANAGER_CHANGELOG_REL)
    else:
        source = f"{SOURCE.rstrip('/')}/{MANAGER_RELEASE_MANIFEST_REL}"
        manifest, _rel, _assets = _manager_release_parts(
            _fetch_json(source, "manager release manifest"), source)
        read_version = lambda: _changelog_version_from_url(
            f"{SOURCE.rstrip('/')}/{MANAGER_CHANGELOG_REL}")
    available_release = hashlib.sha256(
        _manager_release_manifest_bytes(manifest)).hexdigest()

    installed = None
    try:
        executable = (_bin_dir() / "capabilities").resolve(strict=True)
    except OSError:
        executable = None
    if executable is not None:
        release = executable.parent.parent
        current = _read_json(release / MANAGER_RELEASE_MANIFEST_REL)
        if current is not None and not _validate_manager_release_manifest(current):
            release_id = hashlib.sha256(
                _manager_release_manifest_bytes(current)).hexdigest()
            staged = CAP_HOME / ".manager" / "releases" / release_id
            if executable == (staged / current["manager"]["path"]).resolve():
                installed = {
                    "release": release_id,
                    "manager_sha256": _sha256(executable),
                    "version": _changelog_version_at(release / MANAGER_CHANGELOG_REL),
                }
    behind = installed is None or installed["release"] != available_release
    _emit({
        "installed": installed,
        "available": {
            "release": available_release,
            "manager_sha256": manifest["manager"]["sha256"],
            "version": read_version() if behind else installed["version"],
            "source": source,
        },
        "update_available": behind,
    })


def _capability_tier(name: str) -> str:
    """`core` for a capability the manager declares core, else `standard`."""
    return "core" if name in CORE_CAPABILITIES else "standard"


def cmd_list() -> None:
    entries = []
    root = _project_root()
    project_caps, global_caps = _policy_views(root)
    held = _machine_connections_store(root)
    for name, meta in _installed().items():
        stub, manifest = _load_snapshots(name)
        entry: dict = {"name": name,
                       "summary": (manifest or {}).get("summary", ""),
                       "tier": _capability_tier(name)}
        local = _gate_state(project_caps.get(name)) if root else "absent"
        global_state = _gate_state(global_caps.get(name))
        effective, source = _effective_gate_state(
            name, project_caps.get(name) if root else None, global_caps.get(name))
        if root:
            entry["project_gate"] = local
        entry["global_gate"] = global_state
        entry["effective"] = effective
        entry["source"] = source
        entry["machine"] = _machine_state(name)
        entry["machine_connections"] = (_machine_connections(name) if held is None
                                        else held.get(name, 0))
        entries.append(entry)
    known = set(global_caps) | (set(project_caps) if root else set())
    enabled_not_installed = []
    for name in sorted(known):
        effective, _ = _effective_gate_state(
            name, project_caps.get(name) if root else None, global_caps.get(name))
        if effective == "enabled" and name not in _installed():
            enabled_not_installed.append(name)
    out: dict = {"installed": entries}
    if root:
        out["project_envelope"] = str(_project_capabilities_dir(root))
    if enabled_not_installed:
        out["enabled_not_installed"] = enabled_not_installed
    _emit(out)

def _inventory_rows(root: Path) -> list[dict]:
    """One row per effective-enabled capability, from the registry snapshots
    and the project's own records — no capability is executed to build it."""
    project_caps, global_caps = _policy_views(root)
    installed = _installed()
    adapter = _records_for(root)
    rows: list[dict] = []
    try:
        for name in sorted(installed):
            effective, source = _effective_gate_state(
                name, project_caps.get(name), global_caps.get(name))
            if effective != "enabled":
                continue
            _stub, manifest = _load_snapshots(name)
            manifest = manifest or {}
            try:
                declared = adapter.connections(name, include_disabled=True) or {}
                default = adapter.get(name, "setting", "connection.default")
            except _store_module().StoreError as exc:
                declared, default = {}, None
                _warn(f"{name}: cannot read connections — {exc.message}")
            # A connection this project may not act on is still declared, and a
            # count that silently drops it reads as "none configured" when the
            # truth is "one, withheld".
            usable = sorted(cid for cid, e in declared.items() if e["enabled"])
            withheld = sorted(cid for cid, e in declared.items() if not e["enabled"])
            service = manifest.get("service") or None
            rows.append({
                "name": name,
                "summary": manifest.get("summary", ""),
                "tier": _capability_tier(name),
                "gate": {"effective": effective, "source": source},
                "connections": {"count": len(usable), "default": default,
                                "ids": usable, "withheld": withheld},
                "service": None if service is None else {
                    "name": service.get("name"),
                    "summary": service.get("summary"),
                    "verbs": service.get("verbs") or [],
                    "state": None, "detail": None, "ok": None, "problem": None},
                "inventory": {"declared": manifest.get("inventory") is not None,
                              "network": ((manifest.get("inventory") or {})
                                          .get("network"))},
            })
    finally:
        adapter.close()
    return rows


def _inventory_report(root: Path, name: str, network: bool) -> dict:
    """One capability's own report, or what went wrong asking for it."""
    script = _script_path(name)
    env = dict(os.environ)
    env["CLAUDE_PROJECT_DIR"] = str(root)
    args = ["inventory"] + (["--network"] if network else [])
    rc, out, err = _run_script(script, args, cwd=root, env=env,
                               timeout=120 if network else 30)
    if rc == 0:
        try:
            return {"report": json.loads(out)}
        except ValueError:
            return {"error": {"code": "bad_report", "message": "inventory was not JSON"}}
    try:
        return {"error": json.loads(err.strip().splitlines()[-1])["error"]}
    except (ValueError, IndexError, KeyError):
        return {"error": {"code": "inventory_failed",
                          "message": f"`{name} inventory` exited {rc}",
                          "hint": (err.strip().splitlines() or [""])[-1] or None}}


def _inventory_service_state(answer: dict) -> dict:
    """The service state a capability's own report gave, or why there is none.

    `unknown` is a state rather than a missing one, so a row whose capability
    could not be asked still says that it could not, and why. The verdict is
    the capability's too, passed through as given: `ok` is null wherever the
    capability gave none, so a reader never takes silence for health."""
    service = (answer.get("report") or {}).get("service")
    if isinstance(service, dict) and str(service.get("state") or "").strip():
        ok = service.get("ok") if isinstance(service.get("ok"), bool) else None
        problem = service.get("problem")
        return {"state": service["state"], "detail": service.get("detail"), "ok": ok,
                "problem": (problem if ok is False and isinstance(problem, str)
                            and problem.strip() else None)}
    if "error" in answer:
        return {"state": "unknown", "detail": answer["error"].get("message"),
                "ok": None, "problem": None}
    return {"state": "unknown",
            "detail": "the capability's inventory reports no service state",
            "ok": None, "problem": None}


def cmd_inventory(detail: bool, network: bool, wanted: list[str]) -> None:
    """What this project's capabilities are and what they hold.

    `list` answers for the machine — everything installed and how each is
    gated. This answers for one project: the capabilities an agent here can
    actually use, with their connections, their service, and — with --detail —
    each capability's own report of what it holds. The survey costs one
    process for each capability that ships a service, because that service's
    state is the capability's to read, and none for the rest; --detail spends
    exactly one per capability. Either way they are spent at the same time,
    which is the whole reason this lives here rather than in every caller."""
    root = _require_project()
    rows = _inventory_rows(root)
    if wanted:
        known = {row["name"] for row in rows}
        missing = [n for n in wanted if n not in known]
        if missing:
            _die(3, "not_found",
                 f"not enabled in this project: {', '.join(missing)}",
                 "run `capabilities list` for the gate")
        rows = [row for row in rows if row["name"] in set(wanted)]
    if network:
        detail = True
    # A declared service's state is part of every answer, and only the
    # capability can read it, so a capability that ships a service is asked for
    # its report even when no detail was asked for; the rest cost nothing.
    asked = [row for row in rows if detail or row["service"] is not None]
    if asked:
        with concurrent.futures.ThreadPoolExecutor(
                max_workers=min(8, len(asked))) as pool:
            answers = dict(zip(
                [row["name"] for row in asked],
                pool.map(lambda row: _inventory_report(root, row["name"], network),
                         asked)))
        for row in asked:
            answer = answers[row["name"]]
            if row["service"] is not None:
                row["service"].update(_inventory_service_state(answer))
            if detail:
                row["inventory"].update(answer)
    _emit({"project": {"root": str(root),
                       "envelope": str(_project_capabilities_dir(root))},
           "detail": detail, "network": network, "capabilities": rows})


# ---------------------------------------------------------------- dev sessions

def _dev_safe_id(value: str) -> bool:
    return re.fullmatch(r"[a-z0-9][a-z0-9-]{0,62}", value) is not None


def _dev_safe_env_key(value: str) -> bool:
    return re.fullmatch(r"[A-Z_][A-Z0-9_]*", value) is not None


def _dev_slug(value: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
    return (slug or "capability")[:40]


def _dev_git(
        repo: Path, *args: str, timeout: int = 60
) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            ["git", "-C", str(repo), *args], capture_output=True, text=True,
            timeout=timeout, check=False)
    except (OSError, subprocess.SubprocessError) as exc:
        _die(6, "git_failed", f"git {' '.join(args)} failed for {repo}", str(exc))


def _dev_git_value(repo: Path, *args: str) -> str:
    proc = _dev_git(repo, *args)
    if proc.returncode != 0:
        _die(6, "git_failed", f"git {' '.join(args)} failed for {repo}",
             proc.stderr.strip() or proc.stdout.strip() or None)
    return proc.stdout.strip()


def _dev_require_repo(path: str, role: str) -> Path:
    root = Path(path).expanduser().resolve()
    if not root.is_dir():
        _die(3, "not_found", f"{role} repository does not exist: {root}")
    top = _dev_git(root, "rev-parse", "--show-toplevel")
    if top.returncode != 0:
        _die(6, "not_git_repository", f"{role} is not a git repository: {root}")
    if Path(top.stdout.strip()).resolve() != root:
        _die(6, "repository_root_required", f"{role} must name the git root: {root}",
             f"repository root is {top.stdout.strip()}")
    return root


def _dev_state_dir(session_id: str) -> Path:
    if not _dev_safe_id(session_id):
        _die(6, "bad_session", f"invalid dev session id: {session_id!r}",
             "use lowercase letters, digits, and hyphens")
    return DEV_STATE_ROOT / session_id


def _dev_data_dir(session_id: str) -> Path:
    if not _dev_safe_id(session_id):
        _die(6, "bad_session", f"invalid dev session id: {session_id!r}")
    return DEV_DATA_ROOT / session_id


def _dev_session(session_id: str) -> dict:
    path = _dev_state_dir(session_id) / "session.json"
    data = _read_json(path)
    if isinstance(data, dict) and data.get("schema") == LEGACY_DEV_SESSION_SCHEMA:
        _die(6, "legacy_dev_session",
             f"dev session {session_id} uses unsupported schema v1",
             f"preserved state={path.parent}; data={_dev_data_dir(session_id)}")
    if not isinstance(data, dict) or data.get("schema") != DEV_SESSION_SCHEMA:
        _die(3, "dev_session_not_found", f"unknown dev session: {session_id}",
             "run `capabilities dev list`")
    return data


def _dev_branch_exists(repo: Path, branch: str) -> bool:
    return _dev_git(repo, "show-ref", "--verify", "--quiet",
                    f"refs/heads/{branch}").returncode == 0


def _dev_add_worktree(repo: Path, target: Path, branch: str, ref: str) -> str:
    base = _dev_git_value(repo, "rev-parse", "--verify", f"{ref}^{{commit}}")
    if _dev_branch_exists(repo, branch):
        _die(6, "branch_exists", f"dev branch already exists: {branch}")
    proc = _dev_git(repo, "worktree", "add", str(target), "-b", branch, ref,
                    timeout=120)
    if proc.returncode != 0:
        # `git worktree add -b` can leave the newly-created branch behind even
        # when worktree creation fails. It did not exist at entry, so removing
        # that exact branch is a rollback, not loss of caller-owned work.
        if _dev_branch_exists(repo, branch):
            _dev_git(repo, "branch", "-D", branch)
        _die(6, "worktree_failed", f"cannot create dev worktree {target}",
             proc.stderr.strip() or proc.stdout.strip() or None)
    return base


def _dev_rollback_worktree(repo: Path, target: Path, branch: str) -> None:
    """Best-effort rollback for a worktree/branch created by this invocation."""
    try:
        if target.exists():
            subprocess.run(
                ["git", "-C", str(repo), "worktree", "remove", "--force", str(target)],
                capture_output=True, text=True, timeout=120, check=False)
        subprocess.run(
            ["git", "-C", str(repo), "branch", "-D", branch],
            capture_output=True, text=True, timeout=60, check=False)
    except (OSError, subprocess.SubprocessError):
        pass


def _dev_resolve_source(source_ref: str | None) -> tuple[str, Path, str]:
    """Resolve the requested source without searching arbitrary directories."""
    if source_ref is None or source_ref == OFFICIAL_SOURCE_ID:
        binding = _official_checkout_binding()
        assert binding is not None
        return OFFICIAL_SOURCE_ID, Path(binding["path"]), str(binding["branch"])
    candidate = Path(source_ref).expanduser()
    if candidate.exists():
        repo = _dev_require_repo(str(candidate), "source")
        marker = _read_json(repo / "capabilities.repo.json")
        if not isinstance(marker, dict) or marker.get("kind") != "capability-source":
            _die(6, "not_capability_source",
                 f"source is missing a valid capabilities.repo.json: {repo}")
        source_id = _source_id_for_repo(repo) or f"path-{hashlib.sha256(str(repo).encode()).hexdigest()[:12]}"
        branch = _git_checkout_identity(repo).get("branch") or "main"
        return source_id, repo, str(branch)
    _validate_source_id(source_ref)
    entry = _source_entry(source_ref)
    if entry.get("kind") != "workspace":
        _die(6, "not_editable", f"source {source_ref!r} is not an editable workspace")
    repo = _dev_require_repo(str(_source_root(source_ref)), "source")
    return source_ref, repo, str(entry.get("ref") or "main")


def _dev_attach_project(project_ref: str | None, no_project: bool) -> dict | None:
    """Record, but never create or own, an attached consumer checkout."""
    if project_ref and no_project:
        _die(6, "input", "dev start accepts --project or --no-project, not both")
    if no_project:
        return None
    if project_ref is None:
        marked = _marked_checkout(Path.cwd())
        if marked is not None:
            _die(6, "project_selection_required",
                 "implicit project attachment is forbidden in a capability-source checkout",
                 "pass --project PATH or --no-project")
        project_ref = str(Path.cwd())
    repo = _dev_require_repo(project_ref, "attached project")
    identity = _git_checkout_identity(repo)
    return {
        "path": str(repo),
        "git_common_dir": identity["git_common_dir"],
        "starting_branch": identity.get("branch"),
        "starting_commit": identity["commit"],
    }


def _dev_project(session: dict, required: bool = True) -> Path | None:
    """Revalidate the recorded attached checkout before project execution."""
    project = session.get("project")
    if not isinstance(project, dict):
        if required:
            _die(6, "dev_project_required",
                 f"dev session {session['id']} has no attached project")
        return None
    path = Path(str(project.get("path") or "")).expanduser().resolve()
    if not path.is_dir():
        _die(6, "dev_project_moved", f"attached project is missing: {path}")
    identity = _git_checkout_identity(path)
    if identity["path"] != str(path) or identity["git_common_dir"] != project.get("git_common_dir"):
        _die(6, "dev_project_replaced",
             f"attached project identity changed at {path}")
    return path


def _dev_worktree_entries(repo: Path) -> list[dict]:
    """Parse Git's complete porcelain inventory, including detached trees."""
    proc = _dev_git(repo, "worktree", "list", "--porcelain")
    if proc.returncode != 0:
        _die(6, "git_failed", f"cannot enumerate worktrees for {repo}", proc.stderr.strip())
    entries: list[dict] = []
    current: dict = {}
    for line in [*proc.stdout.splitlines(), ""]:
        if not line:
            if current:
                entries.append(current)
                current = {}
            continue
        key, _, value = line.partition(" ")
        current[key] = value or True
    return entries


def _dev_worktree_map(repo: Path) -> dict[str, dict]:
    """Return branch-attached worktrees keyed by their full branch ref."""
    return {str(item.get("branch")): item for item in _dev_worktree_entries(repo)
            if item.get("branch")}


def _dev_candidate_scope(repo: Path, branch: str, base_ref: str,
                         worktree: Path | None) -> tuple[str, set[str], list[str]]:
    """Classify committed and working-tree paths; ambiguity is always shared."""
    merge = _dev_git(repo, "merge-base", base_ref, branch)
    if merge.returncode != 0:
        return "unknown", set(), []
    paths_proc = _dev_git(repo, "diff", "--name-only", merge.stdout.strip(), branch)
    if paths_proc.returncode != 0:
        return "unknown", set(), []
    paths = set(filter(None, paths_proc.stdout.splitlines()))
    if worktree is not None:
        status = _dev_git(worktree, "status", "--porcelain=v1", "--untracked-files=all")
        if status.returncode != 0:
            return "unknown", set(), sorted(paths)
        for line in status.stdout.splitlines():
            raw = line[3:]
            if " -> " in raw:
                raw = raw.split(" -> ", 1)[1]
            paths.add(raw.strip('"'))
    manager_changed, packages = _source_change_scope(sorted(paths))
    if manager_changed or any(not (path.startswith("capabilities/") or
                                   path == ".capability-source/catalog.json")
                              for path in paths):
        return "shared", packages, sorted(paths)
    return "package", packages, sorted(paths)


def _dev_existing_overlaps(repo: Path, capability: str, project: dict | None,
                           base_ref: str, allow_parallel: bool) -> list[dict]:
    """Discover managed and unmanaged dev work before creating another branch."""
    common = _git_checkout_identity(repo)["git_common_dir"]
    managed: dict[str, dict] = {}
    live_by_session = {
        str(lease.get("session_id")): lease for lease in _active_takeover_leases()
        if lease.get("session_id")
    }
    for summary in _dev_session_summaries():
        if summary.get("schema") != DEV_SESSION_SCHEMA:
            continue
        raw = _read_json(_dev_state_dir(summary["id"]) / "session.json")
        if isinstance(raw, dict) and raw.get("source", {}).get("git_common_dir") == common:
            managed[str(raw.get("source", {}).get("branch"))] = raw
    worktree_entries = _dev_worktree_entries(repo)
    worktrees = {str(item.get("branch")): item for item in worktree_entries
                 if item.get("branch")}
    requested_base = _dev_git_value(
        repo, "rev-parse", "--verify", f"{base_ref}^{{commit}}")
    refs = _dev_git(repo, "for-each-ref", "--format=%(refname:short)", "refs/heads/dev/*")
    if refs.returncode != 0:
        _die(6, "git_failed", "cannot enumerate local dev branches", refs.stderr.strip())
    blockers: list[dict] = []
    seen_branches: set[str] = set()
    for branch in sorted(filter(None, refs.stdout.splitlines())):
        seen_branches.add(branch)
        refname = f"refs/heads/{branch}"
        item = worktrees.get(refname)
        worktree = Path(str(item["worktree"])).resolve() if item and item.get("worktree") else None
        session = managed.get(branch)
        if session is not None:
            same_capability = session.get("capability") == capability
            same_project = (session.get("project") or {}).get("git_common_dir") == (
                project or {}).get("git_common_dir")
            if same_capability:
                live_takeover = session.get("id") in live_by_session
                blockers.append({
                    "kind": "managed", "session": session["id"], "branch": branch,
                    "worktree": str(worktree) if worktree else None,
                    "scope": "same-capability", "same_project": same_project,
                    "existing_base_commit": session.get("source", {}).get("base_commit"),
                    "requested_base_commit": requested_base,
                    "live_takeover": live_takeover,
                    "continuations": [
                        f"capabilities dev doctor {session['id']}",
                        f"capabilities dev check {session['id']}",
                        f"capabilities dev finish {session['id']}",
                        f"capabilities dev stop {session['id']}",
                    ],
                    "overrideable": allow_parallel and not live_takeover,
                })
                continue
        scope, packages, paths = _dev_candidate_scope(repo, branch, base_ref, worktree)
        if scope in ("unknown", "shared") or capability in packages:
            blockers.append({
                "kind": "managed" if session else "unmanaged", "branch": branch,
                "worktree": str(worktree) if worktree else None, "scope": scope,
                "packages": sorted(packages), "paths": paths, "overrideable": False,
                "requested_base_commit": requested_base,
            })
    primary = repo.resolve()
    for item in worktree_entries:
        if not item.get("detached") or not item.get("worktree"):
            continue
        worktree = Path(str(item["worktree"])).resolve()
        if worktree == primary:
            continue
        head = str(item.get("HEAD") or "")
        if not head:
            scope, packages, paths = "unknown", set(), []
        else:
            scope, packages, paths = _dev_candidate_scope(
                repo, head, base_ref, worktree)
        if scope in ("unknown", "shared") or capability in packages:
            blockers.append({
                "kind": "detached-worktree", "head": head or None,
                "worktree": str(worktree), "scope": scope,
                "packages": sorted(packages), "paths": paths,
                "requested_base_commit": requested_base,
                "overrideable": False,
            })
    for branch, damaged in managed.items():
        if branch not in seen_branches:
            blockers.append({
                "kind": "damaged-managed", "session": damaged.get("id"),
                "branch": branch, "scope": "unknown", "overrideable": False,
            })
    managed_ids = {str(session.get("id")) for session in managed.values()}
    for lease in _active_takeover_leases():
        if lease.get("damaged"):
            blockers.append({
                "kind": "damaged-live-takeover", "lease": lease.get("path"),
                "scope": "unknown", "overrideable": False,
            })
    for live_session, lease in sorted(live_by_session.items()):
        if live_session not in managed_ids and lease.get("capability") == capability:
            blockers.append({
                "kind": "orphaned-live-takeover", "session": live_session,
                "lease": lease.get("path"), "scope": "unknown",
                "overrideable": False,
            })
    hard = [item for item in blockers if not item.get("overrideable")]
    if hard:
        _die(6, "dev_overlap",
             f"existing capability work overlaps {capability!r}",
             json.dumps(hard, sort_keys=True))
    return blockers


def _dev_manager_target(source_worktree: Path) -> Path:
    """Pick the manager a session shells through.

    A source that vendors the manager puts it under development in the session,
    so the session must exercise the worktree candidate. Any other source has no
    manager under test, so the session pins the manager that created it.
    """
    vendored = source_worktree / MANAGER_EXECUTABLE_REL
    if vendored.is_file():
        return vendored
    return Path(__file__).resolve()


def cmd_dev_start(name: str, source_ref: str | None, project_ref: str | None,
                  no_project: bool, requested_session: str | None,
                  allow_parallel: bool) -> None:
    """Create one schema-v2 source worktree and optionally attach a live project."""
    _reject_reserved_capability_name(name)
    source_id, source_repo, git_ref = _dev_resolve_source(source_ref)
    attached = _dev_attach_project(project_ref, no_project)
    source_status = _dev_git(source_repo, "status", "--porcelain")
    if source_status.returncode != 0:
        _die(
            6,
            "git_failed",
            f"cannot inspect source integration checkout: {source_repo}",
            source_status.stderr.strip() or source_status.stdout.strip() or None,
        )
    if source_status.stdout.strip():
        _die(
            6,
            "source_checkout_dirty",
            f"source integration checkout is dirty: {source_repo}",
            "finish or move that work into its own dev session before starting another",
        )
    session_id = requested_session or (
        f"{_dev_slug(name)}-"
        f"{time.strftime('%Y%m%d-%H%M%S', time.gmtime())}-{os.getpid()}")
    if not _dev_safe_id(session_id):
        _die(6, "bad_session", f"invalid dev session id: {session_id!r}",
             "use lowercase letters, digits, and hyphens")
    state_dir = _dev_state_dir(session_id)
    data_dir = _dev_data_dir(session_id)
    if state_dir.exists() or data_dir.exists():
        _die(6, "session_exists", f"dev session already exists: {session_id}")
    source_branch = f"dev/{session_id}"
    source_worktree = data_dir / "source"

    # Resolve the base and discover all overlapping managed or manual work first.
    _dev_git_value(source_repo, "rev-parse", "--verify", f"{git_ref}^{{commit}}")
    release_state = _release_state_path(source_repo, git_ref)
    if release_state.exists():
        state = _read_json(release_state)
        detail = json.dumps(state, sort_keys=True) if isinstance(state, dict) \
            else "release state is unreadable or malformed"
        _die(6, "release_in_progress",
             f"an unfinished release blocks new dev sessions for {source_repo}:{git_ref}",
             f"{release_state}: {detail}")
    if _dev_branch_exists(source_repo, source_branch):
        _die(6, "branch_exists", f"dev branch already exists: {source_branch}")
    overlaps = _dev_existing_overlaps(
        source_repo, name, attached, git_ref, allow_parallel)

    paths = {
        "home": state_dir / "home",
        "registry": state_dir / "registry",
        "bin": state_dir / "bin",
        "config": state_dir / "config",
        "state": state_dir / "runtime-state",
        "cache": state_dir / "cache",
        "data": state_dir / "runtime-data",
        "logs": state_dir / "logs",
    }
    source_created = False
    try:
        state_dir.mkdir(parents=True)
        data_dir.mkdir(parents=True)
        source_base = _dev_add_worktree(
            source_repo, source_worktree, source_branch, git_ref)
        source_created = True
        for path in paths.values():
            path.mkdir(parents=True, exist_ok=True)
        manager_link = paths["bin"] / "capabilities"
        manager_target = _dev_manager_target(source_worktree)
        manager_link.symlink_to(manager_target)
        session = {
            "schema": DEV_SESSION_SCHEMA,
            "id": session_id,
            "capability": name,
            "created_at": int(time.time()),
            "manager": str(manager_target),
            "source": {
                "id": source_id, "repo": str(source_repo),
                "git_common_dir": _git_checkout_identity(source_repo)["git_common_dir"],
                "worktree": str(source_worktree),
                "branch": source_branch, "ref": git_ref, "base_commit": source_base,
            },
            "project": attached,
            "paths": {key: str(value) for key, value in paths.items()},
            "installed_payloads": {},
            # What the session writes on the schema it creates, so it drops
            # only a schema it made.
            "database_token": secrets.token_hex(16),
        }
        _write_json(state_dir / "session.json", session)
    except BaseException:
        if source_created:
            _dev_rollback_worktree(source_repo, source_worktree, source_branch)
        shutil.rmtree(state_dir, ignore_errors=True)
        shutil.rmtree(data_dir, ignore_errors=True)
        raise
    _emit({
        "ok": True, "session": session_id,
        "source_worktree": str(source_worktree),
        "source_branch": source_branch,
        "attached_project": attached["path"] if attached else None,
        "manager": str(manager_target),
        "parallel_overrides": overlaps,
        "isolated": {key: str(paths[key]) for key in
                     ("registry", "bin", "config", "state", "data", "cache",
                      "home", "logs")},
        "next_commands": [
            f"capabilities dev install {session_id} {name}",
            f"capabilities dev doctor {session_id}",
            f"capabilities dev exec {session_id} -- {name} help",
        ],
    })


# The database keys a process in a dev session's lane resolves its store from:
# the machine's database, bound to a schema of the session's own.
DEV_DB_KEYS = ("AGENTKIT_DB_URL", "AGENTKIT_DB_HOST", "AGENTKIT_DB_PORT", "AGENTKIT_DB_NAME",
               "AGENTKIT_DB_USER", "AGENTKIT_DB_PASSWORD", "AGENTKIT_DB_SCHEMA",
               "AGENTKIT_DB_SSLMODE", "AGENTKIT_DB_SSLROOTCERT",
               "AGENTKIT_DB_TRANSACTION_HOST", "AGENTKIT_DB_TRANSACTION_PORT")
# The tables a `dev run` projects an attached project's rows of one capability
# through, each with the column naming the capability.
DEV_PROJECTED_TABLES = (("capabilities_policy", "capability"),
                        ("capabilities_connections", "capability"),
                        ("capabilities_connection_grants", "capability"),
                        ("capabilities_identifiers", "capability"),
                        ("capabilities_settings", "capability"),
                        ("capabilities_settings_documents", "capability"))


def _dev_schema(session: dict) -> str:
    """The schema of the machine's database a dev session keeps as its own."""
    slug = re.sub(r"[^a-z0-9_]+", "_", str(session["id"]).lower()).strip("_")
    return ("dev_" + (slug or "session"))[:63]


def _dev_database(session: dict):
    """The machine's database, as the session's lane reaches it: the setting
    this machine resolves outside any project (its environment, then its store
    setting file), bound to the session's own schema through the setting's
    schema field, as the environment keys a process in the lane reads.
    (setting, keys), or None where no database resolves: the lane then has
    none, as before."""
    db = _db_module()
    try:
        setting = db.resolve_setting(None)
    except db.DbError:
        return None
    _dev_claim_schema(session, setting)
    keys = {"AGENTKIT_DB_SCHEMA": _dev_schema(session)}
    if setting.transaction_host is not None:
        keys["AGENTKIT_DB_TRANSACTION_HOST"] = setting.transaction_host
    if setting.transaction_port is not None:
        keys["AGENTKIT_DB_TRANSACTION_PORT"] = str(setting.transaction_port)
    if setting.url is not None:
        keys["AGENTKIT_DB_URL"] = setting.url
    else:
        keys.update({"AGENTKIT_DB_HOST": setting.host, "AGENTKIT_DB_PORT": str(setting.port),
                     "AGENTKIT_DB_NAME": setting.database, "AGENTKIT_DB_USER": setting.user,
                     "AGENTKIT_DB_SSLMODE": setting.sslmode})
        if setting.sslrootcert:
            keys["AGENTKIT_DB_SSLROOTCERT"] = setting.sslrootcert
        if setting.password:
            keys["AGENTKIT_DB_PASSWORD"] = setting.password
    return setting, keys


def _dev_schema_marker(session: dict) -> str | None:
    """The comment a session writes on the schema it creates."""
    token = session.get("database_token")
    return f"capabilities dev session {session['id']} {token}" if token else None


def _dev_claim_schema(session: dict, setting) -> None:
    """Before anything in the lane reaches the database, create the session's
    schema and mark it as the session's, or record that a schema of that name
    was already there and so is not the session's to drop. Once recorded it is
    not asked again; a database that cannot be reached is asked next time."""
    marker = _dev_schema_marker(session)
    if marker is None or isinstance(session.get("database_schema"), dict):
        return
    import dataclasses
    import psycopg
    from psycopg import sql
    db = _db_module()
    schema = _dev_schema(session)
    try:
        conn = db.connect(application_name="capabilities-dev",
                          setting=dataclasses.replace(setting, schema=schema),
                          transaction=True)
    except db.DbError:
        return
    try:
        with conn.transaction():
            held = conn.execute("SELECT 1 FROM pg_namespace WHERE nspname = %s",
                                (schema,)).fetchone()
            created = held is None and schema != setting.schema
            if created:
                conn.execute(sql.SQL("CREATE SCHEMA {}").format(sql.Identifier(schema)))
                conn.execute(sql.SQL("COMMENT ON SCHEMA {} IS {}").format(
                    sql.Identifier(schema), sql.Literal(marker)))
    except psycopg.Error:
        return
    finally:
        conn.close()
    session["database_schema"] = {"name": schema, "created": created}
    _write_json(_dev_state_dir(session["id"]) / "session.json", session)


def _dev_drop_schema(session: dict) -> dict | None:
    """Drop the session's schema as the session ends, where the session
    created it: its record says so and the schema still carries the session's
    mark. A schema the session found already there, the machine's own store
    schema, and one whose mark is not the session's are never dropped. None
    where the session holds no schema of its own."""
    held = session.get("database_schema")
    marker = _dev_schema_marker(session)
    if not isinstance(held, dict) or not held.get("created") or marker is None:
        return None
    schema = held.get("name")
    out = {"schema": schema, "dropped": False}
    if schema != _dev_schema(session):
        return {**out, "reason": "the recorded schema is not this session's name"}
    import dataclasses
    import psycopg
    from psycopg import sql
    db = _db_module()
    try:
        setting = db.resolve_setting(None)
    except db.DbError as exc:
        return {**out, "reason": f"no database resolves: {exc.message}"}
    if schema == setting.schema:
        return {**out, "reason": "it is the machine's own store schema"}
    try:
        conn = db.connect(application_name="capabilities-dev",
                          setting=dataclasses.replace(setting, schema=schema),
                          transaction=True)
    except db.DbError as exc:
        return {**out, "reason": f"the database cannot be reached: {exc.message}"}
    try:
        with conn.transaction():
            row = conn.execute(
                "SELECT obj_description(oid, 'pg_namespace') FROM pg_namespace "
                "WHERE nspname = %s", (schema,)).fetchone()
            if row is None:
                return {**out, "reason": "it is no longer there"}
            if row[0] != marker:
                return {**out, "reason": "it does not carry this session's mark"}
            conn.execute(sql.SQL("DROP SCHEMA {} CASCADE").format(sql.Identifier(schema)))
    except psycopg.Error as exc:
        return {**out, "reason": f"the drop failed: {exc}"}
    finally:
        conn.close()
    return {**out, "dropped": True}


def _dev_project_rows(setting, schema: str, agent_id: str, capability: str) -> dict:
    """Project an attached project's rows of one capability into the session's
    schema, where a store-reading project's records are read from in the lane:
    its registry row and nodes, the global marker, and its own and every
    agent's policy, connections, grants, identifiers and settings of that
    capability, each table brought to this code's version first. What the
    session schema held of them is replaced. Answers what was projected."""
    import dataclasses
    import psycopg
    from psycopg import sql
    db = _db_module()
    store = _store_module()
    real = setting.schema
    session_setting = dataclasses.replace(setting, schema=schema)
    conn = db.connect(application_name=store.STORE_OWNER, setting=session_setting,
                      transaction=True)
    counts: dict = {}
    try:
        major, minor = store.STORE_TABLES_VERSION
        db.migrate(conn, store.STORE_OWNER, store.record_table_steps(), major=major,
                   minor=minor)

        def columns(table: str, where: str) -> list[str]:
            return [row[0] for row in conn.execute(
                "SELECT column_name FROM information_schema.columns WHERE table_schema = %s "
                "AND table_name = %s AND is_generated = 'NEVER' AND identity_generation "
                "IS NULL ORDER BY ordinal_position", (where, table)).fetchall()]

        def copy(table: str, condition: sql.Composable, params: tuple) -> int:
            shared = [c for c in columns(table, schema) if c in set(columns(table, real))]
            if not shared:
                return 0
            names = sql.SQL(", ").join(sql.Identifier(c) for c in shared)
            conn.execute(sql.SQL("DELETE FROM {}.{} WHERE ").format(
                sql.Identifier(schema), sql.Identifier(table)) + condition, params)
            return conn.execute(sql.SQL("INSERT INTO {}.{} ({}) SELECT {} FROM {}.{} WHERE ")
                                .format(sql.Identifier(schema), sql.Identifier(table), names,
                                        names, sql.Identifier(real), sql.Identifier(table))
                                + condition, params).rowcount
        with conn.transaction():
            counts["capabilities_agents"] = copy(
                "capabilities_agents", sql.SQL("id = %s"), (agent_id,))
            counts["capabilities_agent_nodes"] = copy(
                "capabilities_agent_nodes", sql.SQL("agent_id = %s"), (agent_id,))
            conn.execute(sql.SQL("UPDATE {}.capabilities_global SET global_migrated_at = "
                                 "(SELECT global_migrated_at FROM {}.capabilities_global "
                                 "LIMIT 1)").format(sql.Identifier(schema),
                                                    sql.Identifier(real)))
            for table, column in DEV_PROJECTED_TABLES:
                by_agent = table != "capabilities_connections"
                condition = sql.SQL("{} = %s").format(sql.Identifier(column))
                params: tuple = (capability,)
                if by_agent:
                    condition = condition + sql.SQL(
                        " AND (agent_id IS NULL OR agent_id = %s)")
                    params = (*params, agent_id)
                counts[table] = copy(table, condition, params)
    except (db.DbError, psycopg.Error) as exc:
        _die(5, "dev_projection_failed",
             f"cannot project {capability}'s rows into the session schema {schema}: {exc}",
             "check the store with `capabilities store doctor`")
    finally:
        conn.close()
    return counts


def _dev_env(session: dict, inherit: list[str] | None = None) -> dict[str, str]:
    safe_keys = {
        "LANG", "LC_ALL", "LC_CTYPE", "TERM", "TMPDIR", "USER", "LOGNAME",
        "SHELL", "SSL_CERT_FILE", "SSL_CERT_DIR", "REQUESTS_CA_BUNDLE",
        "CURL_CA_BUNDLE", "NO_COLOR",
    }
    env = {key: value for key, value in os.environ.items()
           if key in safe_keys or key.startswith("LC_")}
    paths = session["paths"]
    canonical_bin = _bin_dir().resolve()
    inherited_path = os.pathsep.join(
        entry for entry in os.environ.get("PATH", os.defpath).split(os.pathsep)
        if entry and Path(entry).expanduser().resolve() != canonical_bin
    )
    env.update({
        "HOME": paths["home"],
        "CAPABILITIES_HOME": paths["registry"],
        "CAPABILITIES_BIN": paths["bin"],
        "XDG_CONFIG_HOME": paths["config"],
        "XDG_STATE_HOME": paths["state"],
        "XDG_DATA_HOME": paths["data"],
        "XDG_CACHE_HOME": paths["cache"],
        "CAPABILITIES_DEV_SESSION": session["id"],
        "CAPABILITIES_DEV_SOURCE": session["source"]["worktree"],
        "CAPABILITIES_DEV_SOURCE_ID": session["source"]["id"],
        "PATH": paths["bin"] + os.pathsep + inherited_path,
        "UV_CACHE_DIR": str(Path(paths["cache"]) / "uv"),
    })
    # Where a database resolves, the lane keeps its records in a schema of its
    # own in it, instead of a temporary config home with record files; the
    # node this machine runs as goes with it, since an agent whose records
    # moved is read per node.
    database = _dev_database(session)
    if database is not None:
        env.update(database[1])
        if os.environ.get("AGENT_NODE_NAME", "").strip():
            env["AGENT_NODE_NAME"] = os.environ["AGENT_NODE_NAME"]
    for key in inherit or []:
        if not _dev_safe_env_key(key):
            _die(6, "bad_env_key", f"invalid inherited env key: {key!r}")
        if key in DEV_MANAGED_ENV_KEYS or (database is not None and key in DEV_DB_KEYS):
            _die(6, "managed_env_key",
                 f"dev isolation owns environment key {key}; it cannot be inherited")
        if key not in os.environ:
            _die(6, "env_missing", f"cannot inherit unset env key: {key}")
        env[key] = os.environ[key]
    return env


def _dev_cwd(session: dict, requested: str | None) -> Path:
    choice = requested or "source"
    if choice == "source":
        return Path(session["source"]["worktree"])
    _die(6, "bad_dev_cwd", f"dev session has no cwd target {choice!r}",
         "dev exec is hermetic; use --cwd source or `dev run` for the attached project")


def cmd_dev_install(session_id: str, names: list[str]) -> None:
    if not names:
        _die(6, "input", "dev install needs at least one capability name")
    session = _dev_session(session_id)
    for name in names:
        _assert_payload_mutable(name, session_id)
    env = _dev_env(session)
    manager = Path(session["paths"]["bin"]) / "capabilities"
    cwd = _dev_cwd(session, None)
    installed = []
    for name in names:
        _reject_reserved_capability_name(name)
        proc = subprocess.run(
            # The session's own isolated machine: the payload under
            # development is allowed there, or nothing in the lane could run it.
            [str(manager), "install", name, "--from", session["source"]["worktree"],
             "--allow"],
            cwd=cwd, env=env, capture_output=True, text=True, timeout=300,
            check=False)
        if proc.returncode != 0:
            sys.stdout.write(proc.stdout)
            sys.stderr.write(proc.stderr)
            sys.exit(proc.returncode)
        try:
            installed.append(json.loads(proc.stdout))
        except ValueError:
            installed.append({"name": name, "output": proc.stdout.strip()})
        payload = Path(session["paths"]["registry"]) / name
        session.setdefault("installed_payloads", {})[name] = {
            "path": str(payload),
            "payload_sha256": _payload_sha256(payload),
            "executable": str(payload / name),
            "installed_at": int(time.time()),
        }
    _write_json(_dev_state_dir(session_id) / "session.json", session)
    _emit({
        "ok": True, "session": session_id, "installed": installed,
        "next_commands": [
            f"capabilities dev doctor {session_id}",
            f"capabilities dev exec {session_id} -- {names[0]} help",
        ],
    })


def cmd_dev_exec(session_id: str, command: list[str], cwd_choice: str | None,
                 inherit: list[str]) -> None:
    if not command:
        _die(6, "input", "dev exec needs a command after --")
    session = _dev_session(session_id)
    env = _dev_env(session, inherit)
    cwd = _dev_cwd(session, cwd_choice)
    if cwd == Path(session["source"]["worktree"]):
        env.pop("CLAUDE_PROJECT_DIR", None)
    name = command[0]
    canonical_names = set(_installed()) | {"capabilities"}
    if "/" not in name and name in canonical_names:
        candidate = Path(session["paths"]["bin"]) / name
        if not candidate.exists():
            _die(6, "dev_capability_not_installed",
                 f"{name} is available canonically but not in dev session {session_id}",
                 f"run `capabilities dev install {session_id} {name}`")
        resolved = shutil.which(name, path=env["PATH"])
        if not resolved or Path(resolved).resolve() != candidate.resolve():
            _die(6, "dev_path_escape", f"{name} does not resolve from the dev bin",
                 f"expected {candidate}")
    try:
        proc = subprocess.run(command, cwd=cwd, env=env, check=False)
    except FileNotFoundError:
        _die(3, "command_not_found", f"dev command not found: {name}")
    except OSError as exc:
        _die(6, "exec_failed", f"cannot execute dev command: {name}", str(exc))
    sys.exit(proc.returncode)


def _dev_changed_paths(session: dict) -> tuple[str, str, list[str]]:
    """Return base, head and committed/staged/unstaged/untracked changed paths."""
    source = session["source"]
    worktree = Path(source["worktree"])
    base = str(source.get("base_commit") or "")
    valid = _dev_git(worktree, "cat-file", "-e", f"{base}^{{commit}}")
    if not base or valid.returncode != 0:
        _die(6, "dev_base_invalid",
             f"session {session['id']} has a missing or invalid recorded base",
             "preserve the worktree and explicitly rehome the session")
    head = _dev_git_value(worktree, "rev-parse", "HEAD")
    paths = set(_dev_git_value(worktree, "diff", "--name-only", base, "HEAD").splitlines())
    paths.update(_dev_git_value(worktree, "diff", "--name-only", "--cached").splitlines())
    paths.update(_dev_git_value(worktree, "diff", "--name-only").splitlines())
    untracked = _dev_git_value(
        worktree, "ls-files", "--others", "--exclude-standard").splitlines()
    paths.update(untracked)
    return base, head, sorted(filter(None, paths))


def _validator_diagnosis(proc: subprocess.CompletedProcess, fallback: str) -> str:
    """The account a failed direct validator gave of itself, without its launcher's.

    The manager runs from a uv launcher, so whenever that launcher's cache is
    cold its own resolution reaches stderr ahead of anything the manager writes,
    and reading the stream whole reports the launcher instead of the validator.
    The I/O contract says which stream holds the account: exit 7 is a drift or
    conformance report on stdout, and every other failure is one line of JSON
    error envelope, last of what the manager wrote to stderr. Anything else -
    a validator that crashed, or one that said nothing at all - is passed
    through whole rather than trimmed to a line that may not be its point.
    """
    if proc.returncode == 7 and proc.stdout.strip():
        return proc.stdout.strip()
    written = [line.strip() for line in proc.stderr.splitlines() if line.strip()]
    if written:
        try:
            envelope = json.loads(written[-1])
        except ValueError:
            envelope = None
        if isinstance(envelope, dict) and "error" in envelope:
            return written[-1]
    return proc.stderr.strip() or proc.stdout.strip() or fallback


def _dev_check_report(session: dict) -> dict:
    """Run each direct validator once for the scope changed since session base."""
    session_id = str(session["id"])
    base, head, changed = _dev_changed_paths(session)
    source_root = Path(session["source"]["worktree"])
    manager_changed, packages = _source_validation_scope(source_root, changed)
    existing = sorted(name for name in packages
                      if (source_root / "capabilities" / name / "bin" / name).is_file())
    deleted = sorted(packages - set(existing))
    failures: dict[str, list[str]] = {}
    audited: list[str] = []
    manager = Path(session["paths"]["bin"]) / "capabilities"
    if manager_changed:
        proc = subprocess.run(
            [str(manager), "selfcheck"], cwd=source_root, env=_dev_env(session),
            capture_output=True, text=True, timeout=600, check=False)
        if proc.returncode != 0:
            failures.setdefault("manager", []).append(
                _validator_diagnosis(proc, f"selfcheck exited {proc.returncode}"))
    for name in existing:
        proc = subprocess.run(
            [str(manager), "audit", name, "--from", str(source_root)],
            cwd=source_root, env=_dev_env(session), capture_output=True,
            text=True, timeout=300, check=False)
        audited.append(name)
        if proc.returncode != 0:
            failures.setdefault(name, []).append(
                _validator_diagnosis(proc, f"audit exited {proc.returncode}"))
    status = _dev_git_value(source_root, "status", "--porcelain")
    staged_paths = _dev_git_value(source_root, "diff", "--name-only", "--cached").splitlines()
    staged_manager, staged_packages = _source_change_scope(staged_paths)
    if staged_manager or staged_packages:
        staged_tree = _dev_git_value(source_root, "write-tree")
        staged_report = _source_snapshot_report(
            source_root,
            staged_tree,
            manager_selfcheck=False,
            audit_names=set(staged_packages),
            catalog_baseline=_catalog_at_ref(source_root, head),
            audit=False,
        )
        stale_generated = {
            key for key in ("catalog", "manager-release")
            if key in staged_report["failures"]
        }
        if stale_generated:
            source_id = session["source"].get("id") or OFFICIAL_SOURCE_ID
            command = (
                f"cd {shlex.quote(str(source_root))} && "
                f"{shlex.quote(str(manager))} source index "
                f"{shlex.quote(str(source_id))} --staged")
            if "catalog" in stale_generated:
                failures.setdefault("catalog", []).append(
                    f"staged catalogue is stale; run exactly: {command}")
            if "manager-release" in stale_generated:
                failures.setdefault("manager-release", []).append(
                    f"staged manager release manifest is stale; run exactly: {command}")
    descendant = _dev_git(source_root, "merge-base", "--is-ancestor", base, head).returncode == 0
    publication_ready = not status and head != base and descendant
    immutable = None
    if publication_ready:
        immutable = _source_snapshot_report(
            source_root,
            head,
            manager_selfcheck=False,
            audit_names=set(existing),
            catalog_baseline=_catalog_at_ref(source_root, base),
            audit=False,
        )
        if not immutable["ok"]:
            failures.setdefault("immutable_tree", []).append(
                json.dumps({"contract": immutable["contract"],
                            "failures": immutable["failures"]}, sort_keys=True))
            publication_ready = False
    result = {
        "session": session_id,
        "base": base,
        "head": head,
        "scope_basis": "recorded-base+head+index+worktree+untracked",
        "changed_paths": changed,
        "manager_changed": manager_changed,
        "selected_packages": sorted(packages),
        "audited_packages": audited,
        "deleted_packages": deleted,
        "working_tree_clean": not bool(status),
        "publication_ready": publication_ready and not failures,
        "failures": failures,
        "ok": not failures,
    }
    return result


def cmd_dev_check(session_id: str) -> None:
    result = _dev_check_report(_dev_session(session_id))
    _emit(result)
    if not result["ok"]:
        sys.exit(7)


def _dev_connection_selector(args: list[str]) -> str | None:
    """Read standard connection selectors without altering child arguments."""
    found: list[str] = []
    index = 0
    while index < len(args):
        value = args[index]
        if value == "--connection":
            if index + 1 >= len(args):
                _die(6, "input", "--connection needs a value")
            found.append(args[index + 1])
            index += 2
            continue
        if value.startswith("--connection="):
            found.append(value.split("=", 1)[1])
        index += 1
    if len(set(found)) > 1:
        _die(6, "conflicting_connection", "multiple conflicting connection selectors")
    return found[0] if found else None


def _dev_select_connection(registry: dict, wanted: str | None) -> tuple[str, dict]:
    """Apply the shared flag/default/sole-entry selection contract."""
    conns = registry.get("connections")
    if not isinstance(conns, dict) or not conns:
        _die(6, "bad_config", "connections registry has no connections")
    if wanted:
        if wanted in conns:
            return wanted, conns[wanted] if isinstance(conns[wanted], dict) else {}
        matches = [(cid, entry) for cid, entry in conns.items()
                   if isinstance(entry, dict)
                   and str(entry.get("address") or "").lower() == wanted.lower()]
        if len(matches) == 1:
            return matches[0]
        _die(6, "unknown_connection", f"no connection matches {wanted!r}")
    default = registry.get("default")
    if default:
        if default not in conns:
            _die(6, "bad_default", f"default points to unknown connection {default!r}")
        entry = conns[default]
        return default, entry if isinstance(entry, dict) else {}
    if len(conns) == 1:
        cid = next(iter(conns))
        entry = conns[cid]
        return cid, entry if isinstance(entry, dict) else {}
    _die(6, "ambiguous_connection",
         "registry has multiple connections and no default; pass --connection ID")


def _resolved_registry(root: Path, capability: str, *,
                       project_only: bool = False) -> tuple[dict | None, str, str]:
    """Compose the legacy registry shape from resolved connection records.

    Development commands need the selected entry before launching a child so
    they can project only its credential values. They ask the same adapter the
    child will ask; the compatibility shape is local to this boundary.
    """
    adapter = _records_for(root, project_only=project_only)
    try:
        effective = adapter.connections(capability)
        default = adapter.get(capability, "setting", "connection.default")
        source = adapter.collection_source(capability, "connection")
        if not effective:
            return None, adapter.mode_of("connection"), source
        registry = {
            "default": default,
            "connections": {
                cid: {**row["value"], "allow_write": row["allow_write"]}
                for cid, row in effective.items()
            },
        }
        return registry, adapter.mode_of("connection"), source
    except _store_module().StoreError as exc:
        _die(6, exc.slug, exc.message, exc.hint)
    finally:
        adapter.close()


def _dev_redact(text: str, secrets: list[str]) -> str:
    """Replace exact known secret values before forwarding child output."""
    for secret in sorted(set(filter(None, secrets)), key=len, reverse=True):
        text = text.replace(secret, "[REDACTED]")
    return text


def cmd_dev_run(session_id: str, capability: str, args: list[str],
                project_only: bool) -> None:
    """Run one verified session payload with a short-lived selected-cap projection."""
    session = _dev_session(session_id)
    project = _dev_project(session)
    assert project is not None
    envelope = _project_capabilities_dir(project).resolve()
    payload = (session.get("installed_payloads") or {}).get(capability)
    if not isinstance(payload, dict):
        _die(6, "dev_capability_not_installed",
             f"{capability} is not installed in dev session {session_id}",
             f"run `capabilities dev install {session_id} {capability}`")
    registry = Path(session["paths"]["registry"]) / capability
    executable = registry / capability
    if not executable.is_file() or executable.resolve() != Path(payload["executable"]).resolve():
        _die(6, "dev_payload_invalid", f"session payload is missing or escaped: {executable}")
    if _payload_sha256(registry) != payload.get("payload_sha256"):
        _die(6, "dev_payload_drift", f"session payload changed after install: {capability}")
    manifest = _read_json(registry / "manifest.json")
    if not isinstance(manifest, dict):
        _die(6, "dev_manifest_missing", f"session payload has no manifest: {capability}")

    project_caps, global_caps = _policy_views(project)
    project_gate = project_caps.get(capability)
    global_gate = None if project_only else global_caps.get(capability)
    effective, gate_tier = _effective_gate_state(capability, project_gate, global_gate)
    if effective != "enabled":
        _die(4, "disabled", f"{capability} is disabled for attached project {project}")

    registry_data, registry_mode, registry_source = _resolved_registry(
        project, capability, project_only=project_only)
    selected_id = None
    selected_entry: dict = {}
    credentials = manifest.get("credentials") or {}
    try:
        connection_bearing = "contract: connections" in executable.read_text()
    except OSError:
        connection_bearing = registry_data is not None
    if connection_bearing:
        if not isinstance(registry_data, dict):
            _die(6, "connections_required",
                 f"{capability} requires a project connection registry"
                 if project_only else f"{capability} requires a connection registry")
        selected_id, selected_entry = _dev_select_connection(
            registry_data, _dev_connection_selector(args))

    project_values = _project_env(project)
    user_values = {} if project_only else _parse_env_file(
        _CONFIG_HOME / capability / "credentials.env")
    child_values: dict[str, str] = {}
    value_tiers: dict[str, str] = {}
    secrets: list[str] = []
    for spec in credentials.get("keys") or []:
        if not isinstance(spec, dict) or not isinstance(spec.get("key"), str):
            continue
        key = spec["key"]
        if project_values.get(key):
            value, tier = project_values[key], "project"
        elif user_values.get(key):
            value, tier = user_values[key], "user"
        elif os.environ.get(key):
            value, tier = os.environ[key], "process"
        else:
            continue
        child_values[key] = value
        value_tiers[key] = tier
        if spec.get("secret"):
            secrets.append(value)
    for field, raw_key in selected_entry.items():
        if not field.endswith("_env") or not isinstance(raw_key, str) \
                or not _dev_safe_env_key(raw_key):
            continue
        value = project_values.get(raw_key) or user_values.get(raw_key) or os.environ.get(raw_key)
        if value:
            child_values[raw_key] = value
            value_tiers[raw_key] = (
                "project" if project_values.get(raw_key) else
                "user" if user_values.get(raw_key) else "process")
            secrets.append(value)

    # Where a database resolves and the attached project reads its records
    # from the store, the selected capability's rows are projected into the
    # session's own schema, which the payload reads in place of the store's;
    # otherwise into a temporary config home as files, as before.
    database = _dev_database(session)
    store = _store_module()
    try:
        store_project = store.connections_mode(envelope) == "store"
    except store.StoreError:
        store_project = False
    projected = None
    if database is not None and store_project:
        agent_id = _project_json_id(project)
        if agent_id:
            projected = {"schema": _dev_schema(session),
                         "rows": _dev_project_rows(database[0], _dev_schema(session),
                                                   agent_id, capability)}
    projection_parent = Path(tempfile.mkdtemp(prefix="capabilities-dev-run-"))
    projection_parent.chmod(0o700)
    try:
        config = projection_parent / "config"
        config.mkdir(mode=0o700)
        if projected is None and gate_tier == "global":
            _write_json(config / "capabilities" / "settings.json",
                        {"capabilities": {capability: global_gate}})
        if (projected is None and registry_data is not None and registry_mode == "files"
                and not project_only):
            _write_json(config / capability / "connections.json", registry_data)
        env = _dev_env(session)
        env.update(child_values)
        env.update({
            "XDG_CONFIG_HOME": str(config),
            "CLAUDE_PROJECT_DIR": str(project),
            "CAPABILITIES_PROJECT_ENVELOPE": str(envelope),
            "CAPABILITIES_DEV_PROJECT": str(project),
            "CAPABILITIES_DEV_EXECUTION": "project",
            **_project_id_handoff(project),
        })
        if project_only:
            env["CAPABILITIES_RECORDS_PROJECT_ONLY"] = "1"
        proc = subprocess.run(
            [str(executable), *args], cwd=project, env=env,
            capture_output=True, text=True, check=False)
        diagnostic = {
            "mode": "project", "session": session_id, "capability": capability,
            "payload": str(executable), "attached_project": str(project),
            "project_envelope": str(envelope),
            "selected_connection": selected_id,
            "policy_tier": gate_tier, "connection_tier": registry_source,
            "value_tiers": value_tiers,
        }
        if database is not None:
            diagnostic["database_schema"] = _dev_schema(session)
        if projected is not None:
            diagnostic["projected_rows"] = projected["rows"]
        sys.stderr.write(json.dumps({"dev_run": diagnostic}, sort_keys=True) + "\n")
        sys.stdout.write(_dev_redact(proc.stdout, secrets))
        sys.stderr.write(_dev_redact(proc.stderr, secrets))
        sys.exit(proc.returncode)
    finally:
        shutil.rmtree(projection_parent, ignore_errors=True)


def _dev_live_lease_for_session(session_id: str) -> dict | None:
    """Return exactly one active Telegram lease for a session, fail on ambiguity."""
    matches = [lease for lease in _active_takeover_leases()
               if lease.get("session_id") == session_id]
    if len(matches) > 1:
        _die(6, "takeover_ambiguous",
             f"multiple live leases claim dev session {session_id}",
             json.dumps(matches, sort_keys=True))
    return matches[0] if matches else None


def _dev_live_inputs(session: dict) -> dict:
    """Resolve Telegram live policy, connection, state and process-only inputs."""
    project = _dev_project(session)
    assert project is not None
    envelope = _project_capabilities_dir(project).resolve()
    project_caps, _global_caps = _policy_views(project)
    gate = project_caps.get("telegram")
    if not isinstance(gate, dict) or gate.get("enabled") is not True:
        _die(4, "service_project_enable_required",
             "Telegram live mode requires explicit project enable")
    registry, registry_mode, registry_source = _resolved_registry(project, "telegram")
    if registry is None:
        _die(6, "connections_required", "Telegram live mode requires a connection registry")
    adapter = _records_for(project)
    try:
        settings = {key: row["value"] for key, row in
                    adapter.resolve("telegram", "setting").items()
                    if key != "connection.default"}
    except _store_module().StoreError as exc:
        _die(6, exc.slug, exc.message, exc.hint)
    finally:
        adapter.close()
    wanted = str(settings.get("connection")) if settings.get("connection") else None
    connection, entry = _dev_select_connection(registry, wanted)
    if not bool(entry.get("allow_write", False)):
        _die(4, "connection_read_only",
             f"Telegram connection {connection!r} does not allow writes")
    try:
        account_id = int(entry.get("expected_account_id"))
        if account_id <= 0:
            raise ValueError
    except (TypeError, ValueError):
        _die(6, "expected_account_required",
             f"Telegram connection {connection!r} needs a positive expected_account_id")
    session_path = Path(str(entry.get("session") or
                            (_STATE_HOME / "telegram" / connection / "session"))).expanduser()
    if not session_path.is_absolute():
        session_path = project / session_path
    project_values = _project_env(project)
    state_value = project_values.get("TELEGRAM_SERVICE_STATE_DIR")
    state_path = Path(state_value).expanduser() if state_value else session_path.parent / "service"
    if not state_path.is_absolute():
        state_path = project / state_path
    user_values = _parse_env_file(_CONFIG_HOME / "telegram" / "credentials.env")
    manifest = _read_json(Path(session["paths"]["registry"]) / "telegram" / "manifest.json")
    if not isinstance(manifest, dict):
        _die(6, "dev_manifest_missing", "session Telegram payload has no manifest")
    values: dict[str, str] = {}
    secrets_list: list[str] = []
    for spec in (manifest.get("credentials") or {}).get("keys") or []:
        if not isinstance(spec, dict) or not isinstance(spec.get("key"), str):
            continue
        key = spec["key"]
        value = project_values.get(key) or user_values.get(key) or os.environ.get(key)
        if value:
            values[key] = value
            if spec.get("secret"):
                secrets_list.append(value)
    for field, raw_key in entry.items():
        if not field.endswith("_env") or not isinstance(raw_key, str) \
                or not _dev_safe_env_key(raw_key):
            continue
        value = project_values.get(raw_key) or user_values.get(raw_key) or os.environ.get(raw_key)
        if value:
            values[raw_key] = value
            secrets_list.append(value)
    if state_value:
        values["TELEGRAM_SERVICE_STATE_DIR"] = state_value
    return {
        "project": project, "envelope": envelope, "registry": registry,
        "registry_mode": registry_mode, "registry_source": registry_source,
        "connection": connection, "entry": entry,
        "account_id": account_id, "session_path": session_path,
        "state_path": state_path.resolve(), "values": values,
        "secrets": secrets_list, "manifest": manifest,
    }


def _dev_live_env(session: dict, inputs: dict,
                  projection: Path) -> tuple[dict[str, str], Path]:
    """Create the lease-owned non-secret config projection for one live daemon."""
    if projection.exists():
        _die(6, "live_projection_exists", f"live projection already exists: {projection}")
    projection.mkdir(parents=True, mode=0o700)
    projection.chmod(0o700)
    config = projection / "config"
    config.mkdir(mode=0o700)
    if inputs["registry_mode"] == "files":
        _write_json(config / "telegram" / "connections.json", inputs["registry"])
    env = _dev_env(session)
    env.update(inputs["values"])
    env.update({
        "XDG_CONFIG_HOME": str(config),
        "XDG_STATE_HOME": str(_STATE_HOME),
        "CLAUDE_PROJECT_DIR": str(inputs["project"]),
        "CAPABILITIES_PROJECT_ENVELOPE": str(inputs["envelope"]),
        "CAPABILITIES_DEV_PROJECT": str(inputs["project"]),
        **_project_id_handoff(inputs["project"]),
    })
    return env, projection


def _dev_live_command(executable: Path, args: list[str], project: Path,
                      env: dict[str, str], secrets_list: list[str]) -> dict:
    """Run a Telegram control command and parse its redacted JSON result."""
    proc = subprocess.run([str(executable), *args], cwd=project, env=env,
                          capture_output=True, text=True, timeout=60, check=False)
    stdout = _dev_redact(proc.stdout, secrets_list)
    stderr = _dev_redact(proc.stderr, secrets_list)
    if proc.returncode != 0:
        _die(proc.returncode, "telegram_live_command_failed",
             f"Telegram control command failed: {' '.join(args)}",
             stderr.strip() or stdout.strip() or None)
    try:
        return json.loads(stdout)
    except ValueError:
        _die(6, "telegram_live_output_invalid",
             "Telegram control command did not return JSON", stdout.strip())


def _dev_live_transition(path: Path, lease: dict, state: str, **updates) -> dict:
    """Durably advance one lease before/after its corresponding process action."""
    lease.update(updates)
    lease["state"] = state
    lease["transition"] = int(lease.get("transition") or 0) + 1
    lease["updated_at"] = int(time.time())
    _write_json(path, lease)
    path.chmod(0o600)
    return lease


def _dev_pid_alive(pid: object) -> bool:
    """Return whether a positive PID still names a process we may inspect."""
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def _dev_live_reconcile_owner(lease: dict) -> None:
    """Prove or retire the lease's owner record without guessing at a PID."""
    lease_path = Path(str(lease["path"]))
    control = lease_path.parent
    owner_path = control / "owner.json"
    owner = _read_json(owner_path)
    if owner is None:
        if owner_path.exists():
            _die(6, "owner_record_malformed",
                 f"Telegram owner record is unreadable: {owner_path}")
        return
    if not isinstance(owner, dict):
        _die(6, "owner_record_malformed",
             f"Telegram owner record is invalid: {owner_path}")
    recorded = lease.get("development_owner")
    if isinstance(recorded, dict):
        identity_fields = (
            "launch_nonce", "pid", "mode", "dev_session_id", "project_root",
            "connection", "account_id", "cli_bundle_path",
        )
        matches = all(owner.get(key) == recorded.get(key) for key in identity_fields)
    elif owner.get("mode") == "development":
        # A crash can occur after the daemon publishes ownership but before the
        # lease records development_owner.  The remaining immutable provenance
        # still proves which dev payload and session created the process.
        matches = (
            owner.get("dev_session_id") == lease.get("session_id")
            and owner.get("project_root") == lease.get("project")
            and owner.get("connection") == lease.get("connection")
            and owner.get("account_id") == lease.get("account_id")
            and owner.get("cli_bundle_path") == lease.get("development_executable")
            and isinstance(owner.get("launch_nonce"), str)
            and bool(owner.get("launch_nonce"))
            and isinstance(owner.get("pid"), int)
        )
    else:
        previous = lease.get("previous_owner")
        matches = isinstance(previous, dict) and all(
            owner.get(key) == previous.get(key)
            for key in ("launch_nonce", "pid", "mode", "project_root",
                        "connection", "account_id", "cli_bundle_path")
        )
    if not matches:
        _die(6, "takeover_owner_mismatch",
             "current Telegram owner does not match the durable takeover lease",
             json.dumps(owner, sort_keys=True))
    if _dev_pid_alive(owner.get("pid")):
        return
    daemon_lock = (control / "daemon.lock").open("a+")
    (control / "daemon.lock").chmod(0o600)
    try:
        try:
            fcntl.flock(daemon_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            _die(6, "takeover_owner_uncertain",
                 "owner PID is absent but the account daemon lock is still held")
        current = _read_json(owner_path)
        if current != owner:
            _die(6, "takeover_owner_changed",
                 "Telegram ownership changed during recovery")
        owner_path.unlink(missing_ok=True)
    finally:
        daemon_lock.close()


def cmd_dev_live_start(session_id: str, adapter: str) -> None:
    """Take exclusive live ownership of one Telegram account for a dev payload."""
    if adapter != "telegram":
        _die(6, "live_adapter_unsupported", "only the telegram live adapter exists")
    session = _dev_session(session_id)
    payload = (session.get("installed_payloads") or {}).get("telegram")
    if not isinstance(payload, dict):
        _die(6, "dev_capability_not_installed",
             f"telegram is not installed in dev session {session_id}")
    if _dev_live_lease_for_session(session_id):
        _die(6, "takeover_active", f"session {session_id} already has a live takeover")
    inputs = _dev_live_inputs(session)
    account = inputs["account_id"]
    control = _STATE_HOME / "telegram" / str(account) / "control"
    projection_path = control / f"projection-{session_id}"
    lease_path = control / "takeover.json"
    ownership = _read_json(control / "ownership-v1.json")
    if (not isinstance(ownership, dict) or ownership.get("account_id") != account
            or ownership.get("protocol_version") != 1):
        _die(6, "ownership_migration_required",
             f"account {account} has not completed ownership-v1 cutover")
    if lease_path.exists():
        _die(6, "takeover_active", f"account {account} already has a takeover lease",
             str(lease_path))
    canonical = _script_path("telegram")
    canonical_manifest = _read_json(_registry_dir("telegram") / "manifest.json")
    if not canonical.is_file() or not isinstance(canonical_manifest, dict):
        _die(6, "canonical_telegram_missing", "canonical Telegram payload is unavailable")
    versions = [canonical_manifest.get("service_state_version"),
                inputs["manifest"].get("service_state_version")]
    marker = _read_json(inputs["state_path"] / "state-schema.json")
    disk_version = 1 if marker is None and not (inputs["state_path"] / "state-schema.json").exists() \
        else (marker or {}).get("version")
    if any(not isinstance(value, int) or value <= 0 for value in [*versions, disk_version]) \
            or versions[0] != versions[1] or versions[0] != disk_version:
        _die(6, "service_state_version_mismatch",
             f"disk/canonical/development versions differ: {disk_version}/{versions[0]}/{versions[1]}")

    canonical_env = dict(os.environ)
    canonical_env["CLAUDE_PROJECT_DIR"] = str(inputs["project"])
    canonical_env["CAPABILITIES_PROJECT_ENVELOPE"] = str(inputs["envelope"])
    canonical_env.update(_project_id_handoff(inputs["project"]))
    canonical_status = _dev_live_command(
        canonical, ["service", "status", "--connection", inputs["connection"]],
        inputs["project"], canonical_env, inputs["secrets"])
    owner = canonical_status.get("owner")
    if isinstance(owner, dict) and owner.get("project_root") != str(inputs["project"]):
        _die(6, "account_owned_elsewhere",
             f"Telegram account {account} is owned by another project",
             json.dumps(owner, sort_keys=True))

    control.mkdir(parents=True, exist_ok=True)
    control.chmod(0o700)
    mutation = MANAGER_MUTATION_LOCK.open("a+")
    fcntl.flock(mutation, fcntl.LOCK_EX)
    transition = (control / "transition.lock").open("a+")
    (control / "transition.lock").chmod(0o600)
    fcntl.flock(transition, fcntl.LOCK_EX)
    try:
        same_account = [active for active in _active_takeover_leases()
                        if active.get("account_id") == account]
        if same_account:
            _die(6, "takeover_active",
                 f"Telegram account {account} already has an active takeover",
                 json.dumps(same_account, sort_keys=True))
        if (_payload_sha256(Path(payload["path"])) != payload["payload_sha256"]
                or not Path(payload["executable"]).is_file()):
            _die(6, "dev_payload_drift",
                 "development Telegram payload changed before lease creation")
        locked_canonical_manifest = _read_json(_registry_dir("telegram") / "manifest.json")
        if ((locked_canonical_manifest or {}).get("service_state_version")
                != disk_version):
            _die(6, "service_state_version_mismatch",
                 "canonical Telegram version changed before lease creation")
        lease = {
            "schema": "capabilities.dev.live.telegram.v1",
            "capability": "telegram", "session_id": session_id,
            "account_id": account, "connection": inputs["connection"],
            "project": str(inputs["project"]),
            "project_git_common_dir": session["project"]["git_common_dir"],
            "state_path": str(inputs["state_path"]),
            "auth_session_path": str(inputs["session_path"]),
            "canonical_executable": str(canonical),
            "canonical_payload_sha256": _payload_sha256(_registry_dir("telegram")),
            "development_executable": payload["executable"],
            "development_payload_sha256": payload["payload_sha256"],
            "service_state_version": disk_version,
            "projection_path": str(projection_path),
            "restart_canonical": bool(canonical_status.get("running")),
            "previous_owner": owner,
            "transition": 0,
        }
        _dev_live_transition(lease_path, lease, "prepared")
    finally:
        mutation.close()

    if lease["restart_canonical"]:
        _dev_live_transition(lease_path, lease, "canonical_stopping")
        _dev_live_command(
            canonical, ["service", "stop", "--connection", inputs["connection"]],
            inputs["project"], canonical_env, inputs["secrets"])
    _dev_live_transition(lease_path, lease, "dev_starting")
    dev_env, projection = _dev_live_env(session, inputs, projection_path)
    dev_status = _dev_live_command(
        Path(payload["executable"]),
        ["service", "start", "--connection", inputs["connection"]],
        inputs["project"], dev_env, inputs["secrets"])
    deadline = time.time() + 30
    while not dev_status.get("healthy") and time.time() < deadline:
        time.sleep(0.5)
        dev_status = _dev_live_command(
            Path(payload["executable"]),
            ["service", "status", "--connection", inputs["connection"]],
            inputs["project"], dev_env, inputs["secrets"])
    owner = dev_status.get("owner")
    if (not isinstance(owner, dict) or owner.get("mode") != "development"
            or owner.get("dev_session_id") != session_id):
        _die(5, "development_owner_unproven",
             "development daemon did not publish matching ownership provenance")
    if not dev_status.get("healthy"):
        _die(5, "development_daemon_unhealthy",
             "development Telegram daemon did not prove healthy update synchronization",
             f"recover with `capabilities dev live recover {session_id} telegram --restore-canonical`")
    _dev_live_transition(lease_path, lease, "dev_running",
                         development_owner=owner)
    _emit({"session": session_id, "adapter": adapter, "lease": lease,
           "status": dev_status, "ok": True})


def cmd_dev_live_status(session_id: str, adapter: str) -> None:
    """Report durable lease and owner state without starting or stopping processes."""
    if adapter != "telegram":
        _die(6, "live_adapter_unsupported", "only the telegram live adapter exists")
    lease = _dev_live_lease_for_session(session_id)
    if lease is None:
        _emit({"session": session_id, "adapter": adapter, "active": False})
        return
    owner_path = Path(lease["path"]).parent / "owner.json"
    owner = _read_json(owner_path)
    _emit({"session": session_id, "adapter": adapter, "active": True,
           "lease": lease, "owner": owner,
           "continuation": f"capabilities dev live recover {session_id} telegram --restore-canonical"})


def cmd_dev_live_recover(session_id: str, adapter: str,
                         restore_canonical: bool) -> None:
    """Idempotently restore the recorded canonical state, even without session v2."""
    if adapter != "telegram" or not restore_canonical:
        _die(6, "input", "recovery requires telegram --restore-canonical")
    lease = _dev_live_lease_for_session(session_id)
    if lease is None:
        _die(3, "takeover_not_found", f"no active takeover for session {session_id}")
    control = Path(str(lease["path"])).parent
    transition_path = control / "transition.lock"
    transition = transition_path.open("a+")
    transition_path.chmod(0o600)
    fcntl.flock(transition, fcntl.LOCK_EX)
    try:
        _dev_live_recover_locked(session_id, adapter, lease)
    finally:
        transition.close()


def _dev_live_recover_locked(session_id: str, adapter: str, lease: dict) -> None:
    """Perform restoration while holding the account transition lock."""
    lease_path = Path(lease["path"])
    project = Path(str(lease.get("project") or "")).resolve()
    if not project.is_dir() or _git_checkout_identity(project)["git_common_dir"] != \
            lease.get("project_git_common_dir"):
        _die(6, "dev_project_replaced", f"recorded takeover project is invalid: {project}")
    canonical = Path(str(lease.get("canonical_executable") or ""))
    if (not canonical.is_file()
            or _payload_sha256(canonical.parent) != lease.get("canonical_payload_sha256")):
        _die(6, "canonical_payload_drift", "canonical Telegram payload changed during takeover")
    development = Path(str(lease.get("development_executable") or ""))
    if (not development.is_file()
            or _payload_sha256(development.parent) != lease.get("development_payload_sha256")):
        _die(6, "development_payload_drift",
             "development Telegram payload changed during takeover")
    state_marker_path = Path(str(lease.get("state_path"))) / "state-schema.json"
    state_marker = _read_json(state_marker_path)
    state_version = 1 if state_marker is None and not state_marker_path.exists() \
        else (state_marker or {}).get("version")
    canonical_manifest = _read_json(canonical.parent / "manifest.json")
    canonical_version = (canonical_manifest or {}).get("service_state_version")
    if (state_version != lease.get("service_state_version")
            or canonical_version != lease.get("service_state_version")):
        _die(6, "service_state_version_mismatch",
             "state or canonical payload version changed during takeover")
    env = dict(os.environ)
    env["CLAUDE_PROJECT_DIR"] = str(project)
    envelope = _project_capabilities_dir(project)
    env["CAPABILITIES_PROJECT_ENVELOPE"] = str(envelope)
    env.update(_project_id_handoff(project))
    connection = str(lease["connection"])
    secrets_list: list[str] = []
    _dev_live_reconcile_owner(lease)
    _dev_live_transition(lease_path, lease, "dev_stopping")
    _dev_live_command(canonical, ["service", "stop", "--connection", connection],
                      project, env, secrets_list)
    if lease.get("restart_canonical"):
        _dev_live_transition(lease_path, lease, "canonical_restarting")
        status = _dev_live_command(
            canonical, ["service", "start", "--connection", connection],
            project, env, secrets_list)
        deadline = time.time() + 30
        while not status.get("healthy") and time.time() < deadline:
            time.sleep(0.5)
            status = _dev_live_command(
                canonical, ["service", "status", "--connection", connection],
                project, env, secrets_list)
        owner = status.get("owner")
        if (not isinstance(owner, dict) or owner.get("mode") != "canonical"):
            _die(5, "canonical_restart_unproven",
                 "canonical Telegram daemon did not publish matching provenance")
        if not status.get("healthy"):
            _die(5, "canonical_restart_unhealthy",
                 "canonical Telegram daemon restarted but is not synchronizing updates",
                 str(lease_path))
    else:
        status = {"running": False}
    _dev_live_transition(lease_path, lease, "restored")
    projection = Path(str(lease.get("projection_path") or ""))
    if projection.is_dir() and projection.parent == lease_path.parent:
        shutil.rmtree(projection)
    lease_path.unlink()
    _emit({"session": session_id, "adapter": adapter, "restored": True,
           "canonical": status})


def _dev_git_status(worktree: Path) -> tuple[str | None, str | None]:
    if not worktree.is_dir():
        return None, "worktree is missing"
    status = _dev_git(worktree, "status", "--porcelain")
    if status.returncode != 0:
        return None, status.stderr.strip() or "git status failed"
    return status.stdout, None


def _dev_unpublished_commit_problem(info: dict, head: str | None) -> str | None:
    if head == info.get("base_commit"):
        return None
    merged = _dev_git(Path(info["repo"]), "merge-base", "--is-ancestor",
                      head, str(info.get("ref") or "main"))
    if merged.returncode == 0:
        return None
    upstream = str(info.get("ref") or "main")
    cherry = _dev_git(Path(info["repo"]), "cherry", upstream, head)
    patch_states = [line[:1] for line in cherry.stdout.splitlines() if line.strip()]
    if cherry.returncode == 0 and patch_states and all(
            state == "-" for state in patch_states):
        return None
    return f"unpublished commits on {info.get('branch')}: {head}"


def _dev_worktree_cleanup_obstacles(
        info: dict, discard_work: bool) -> tuple[list[str], list[str]]:
    """Split one worktree's cleanup obstacles into refusals and discardable work.

    An uncommitted tree and commits the recorded base ref never received are the
    session's own abandoned source work, and move to the discarded list only when
    the caller opted in. A worktree git cannot report on is never discardable:
    the read failed, so nothing establishes what the directory even holds.
    """
    if info.get("live"):
        return [], []
    worktree = Path(info["worktree"])
    status, error = _dev_git_status(worktree)
    if error:
        return [error], []
    discarded: list[str] = []
    if status:
        dirty = f"dirty worktree: {worktree}"
        if not discard_work:
            return [dirty], []
        discarded.append(dirty)
    head = _dev_git_value(worktree, "rev-parse", "HEAD")
    unpublished = _dev_unpublished_commit_problem(info, head)
    if not unpublished:
        return [], discarded
    if not discard_work:
        return [unpublished], discarded
    discarded.append(unpublished)
    return [], discarded


def _dev_cleanup_obstacles(
        session: dict, discard_work: bool) -> tuple[list[str], list[str]]:
    return _dev_worktree_cleanup_obstacles(session["source"], discard_work)


def _dev_cleanup_problems(session: dict) -> list[str]:
    return _dev_cleanup_obstacles(session, False)[0]


def cmd_dev_doctor(session_id: str) -> None:
    session = _dev_session(session_id)
    findings: list[str] = []
    source = session["source"]
    source_status, source_error = _dev_git_status(Path(source["worktree"]))
    if source_error:
        findings.append(source_error)
    manager = Path(session["paths"]["bin"]) / "capabilities"
    recorded_manager = session.get("manager")
    expected_manager = Path(recorded_manager) if isinstance(recorded_manager, str) \
        else Path(source["worktree"]) / MANAGER_EXECUTABLE_REL
    if not manager.is_symlink() or manager.resolve() != expected_manager.resolve():
        findings.append(f"dev manager link does not point to {expected_manager}")
    elif not manager.is_file():
        findings.append(f"dev manager link resolves to nothing: {expected_manager}")
    installed = []
    registry = Path(session["paths"]["registry"])
    bindir = Path(session["paths"]["bin"])
    recorded_payloads = session.get("installed_payloads") or {}
    if registry.is_dir():
        for path in sorted(registry.iterdir()):
            if path.name.startswith(".") or not (path / path.name).is_file():
                continue
            link = bindir / path.name
            recorded = recorded_payloads.get(path.name)
            current_hash = _payload_sha256(path)
            ok = (link.is_symlink()
                  and link.resolve() == (path / path.name).resolve()
                  and isinstance(recorded, dict)
                  and recorded.get("path") == str(path)
                  and recorded.get("payload_sha256") == current_hash)
            installed.append({
                "name": path.name, "executable": str(link), "ok": ok,
                "payload_sha256": current_hash,
                "recorded_payload_sha256": (recorded or {}).get("payload_sha256")
                if isinstance(recorded, dict) else None,
            })
            if not ok:
                findings.append(
                    f"{path.name} dev payload hash/path/symlink no longer matches session state")
    present = {item["name"] for item in installed}
    for name in sorted(set(recorded_payloads) - present):
        findings.append(f"{name} recorded dev payload is missing from the isolated registry")
    project = session.get("project")
    project_state = None
    if isinstance(project, dict):
        try:
            project_path = _dev_project(session)
            assert project_path is not None
            identity = _git_checkout_identity(project_path)
            project_state = {
                **project,
                "current_branch": identity.get("branch"),
                "current_commit": identity["commit"],
                "dirty": bool(_dev_git_value(project_path, "status", "--porcelain")),
            }
        except SystemExit:
            findings.append(f"attached project identity is invalid: {project.get('path')}")
    release_path = _release_state_path(
        Path(source["repo"]), str(source.get("ref") or "main"))
    release_raw = _read_json(release_path) if release_path.exists() else None
    _emit({
        "ok": not findings, "session": session_id,
        "source": {**source, "dirty": bool(source_status)},
        "project": project_state,
        "environment": {
            "registry": session["paths"]["registry"],
            "bin": session["paths"]["bin"],
            "home": session["paths"]["home"],
            "config": session["paths"]["config"],
            "state": session["paths"]["state"],
            "data": session["paths"]["data"],
            "cache": session["paths"]["cache"],
            "logs": session["paths"]["logs"],
        },
        "installed": installed,
        "live_takeover": _dev_live_lease_for_session(session_id),
        "release_state": ({
            "path": str(release_path), "valid": isinstance(release_raw, dict),
            "state": release_raw if isinstance(release_raw, dict) else None,
        } if release_path.exists() else None),
        "cleanup_ready": not _dev_cleanup_problems(session),
        "cleanup_problems": _dev_cleanup_problems(session),
        "findings": findings,
    })
    if findings:
        sys.exit(7)


def _dev_commit_identity(worktree: Path) -> list[str]:
    """Supply a committer identity only where git cannot determine one itself."""
    probe = _dev_git(worktree, "var", "GIT_COMMITTER_IDENT")
    if probe.returncode == 0 and probe.stdout.strip():
        return []
    return ["-c", "user.name=capabilities dev",
            "-c", "user.email=dev@capabilities.invalid"]


def _dev_bring_session_forward(session: dict) -> dict | None:
    """Re-home a session whose recorded base another release already overtook.

    The recorded base is where the session started, not an invariant: any
    release moves the tracked branch under every other open session. Bringing
    the branch forward is the session's own work, so it happens here, in the
    open, and the caller reports it. The author's commit is replayed, never
    rewritten silently, and a conflicting replay is refused with the paths a
    human needs.
    """
    session_id = str(session["id"])
    source = session["source"]
    worktree = Path(source["worktree"])
    repo = Path(source["repo"])
    ref = str(source.get("ref") or "main")
    base = str(source.get("base_commit") or "")
    if not base:
        return None
    resolved = _dev_git(repo, "rev-parse", "--verify", f"{ref}^{{commit}}")
    if resolved.returncode != 0:
        return None
    onto = resolved.stdout.strip()
    head = _dev_git_value(worktree, "rev-parse", "HEAD")
    if onto == base or head == base:
        return None
    if _release_state_path(repo, ref).exists():
        # An interrupted release owns this candidate; resuming it is the answer.
        return None
    if _dev_git(worktree, "merge-base", "--is-ancestor", head, onto).returncode == 0:
        # The prepared commit already reached the tracked branch.
        return None
    if _dev_git(worktree, "merge-base", "--is-ancestor", base, onto).returncode != 0:
        return None
    forward = {
        "previous_base": base, "previous_head": head, "onto": onto,
        "reason": f"{ref} advanced past the session base while the session was open",
    }
    if _dev_git(worktree, "merge-base", "--is-ancestor", onto, head).returncode == 0:
        forward["rebased"] = False
    else:
        rebase = _dev_git(
            worktree, *_dev_commit_identity(worktree), "rebase",
            "--onto", onto, base, timeout=300)
        if rebase.returncode != 0:
            conflicts = sorted({
                line for line in _dev_git(
                    worktree, "diff", "--name-only", "--diff-filter=U"
                ).stdout.splitlines() if line.strip()})
            _dev_git(worktree, "rebase", "--abort", timeout=300)
            _die(
                6,
                "dev_rebase_conflict",
                f"dev session {session_id} conflicts with {ref} at {onto} and must "
                "be brought forward by hand",
                "conflicting paths: "
                + (", ".join(conflicts) or "unreported by git")
                + f"; rebase {source.get('branch')} in {worktree} onto {onto}, "
                "resolve, commit, then finish again"
                + (f"; git said: {rebase.stderr.strip().splitlines()[-1]}"
                   if rebase.stderr.strip() else ""),
            )
        forward["rebased"] = True
    source["base_commit"] = onto
    _write_json(_dev_state_dir(session_id) / "session.json", session)
    forward["generated"] = _dev_regenerate_candidate_index(session)
    forward["candidate"] = _dev_git_value(worktree, "rev-parse", "HEAD")
    report = _dev_check_report(session)
    forward["validation"] = {
        "ok": report["ok"], "manager_changed": report["manager_changed"],
        "audited_packages": report["audited_packages"],
        "failures": report["failures"],
    }
    if not report["ok"]:
        _die(
            7,
            "dev_forward_validation_failed",
            f"dev session {session_id} was brought forward onto {onto} but no "
            "longer validates against that base",
            json.dumps(report["failures"], sort_keys=True),
        )
    return forward


def _dev_regenerate_candidate_index(session: dict) -> list[str]:
    """Rebuild the generated catalogue and manager manifest for the new base."""
    worktree = Path(session["source"]["worktree"])
    source_id = str(session["source"].get("id") or OFFICIAL_SOURCE_ID)
    manager = Path(session["paths"]["bin"]) / "capabilities"
    indexed = subprocess.run(
        [str(manager), "source", "index", source_id, "--staged"],
        cwd=worktree, env=_dev_env(session), capture_output=True, text=True,
        timeout=600, check=False)
    if indexed.returncode != 0:
        _die(
            7,
            "dev_forward_index_failed",
            f"could not rebuild the generated index for session {session['id']} "
            "on its new base",
            indexed.stdout.strip() or indexed.stderr.strip() or None,
        )
    staged = sorted({
        line for line in _dev_git(
            worktree, "diff", "--name-only", "--cached").stdout.splitlines()
        if line.strip()})
    if not staged:
        return []
    amended = _dev_git(
        worktree, *_dev_commit_identity(worktree), "commit", "--amend",
        "--no-edit", timeout=120)
    if amended.returncode != 0:
        _die(
            6,
            "dev_forward_amend_failed",
            "could not fold the regenerated index into the prepared commit",
            amended.stderr.strip() or amended.stdout.strip() or None,
        )
    return staged


def cmd_dev_finish(session_id: str) -> None:
    _assert_session_without_takeover(session_id)
    session = _dev_session(session_id)
    source = session["source"]
    source_worktree = Path(source["worktree"])
    source_status, source_error = _dev_git_status(source_worktree)
    if source_error:
        _die(6, "dev_source_unavailable", source_error)
    if source_status:
        _die(
            6,
            "dev_source_dirty",
            f"dev source worktree has uncommitted changes: {source_worktree}",
            "prepare one clean commit before finishing the session",
        )
    repo = Path(source["repo"])
    forward = _dev_bring_session_forward(session)
    candidate = _dev_git_value(source_worktree, "rev-parse", "HEAD")
    if candidate == source.get("base_commit"):
        _die(6, "dev_no_change", f"dev session {session_id} has no prepared commit")
    source_id = source.get("id") or _source_id_for_repo(repo)
    release = _source_release(
        repo,
        source_id,
        candidate,
        str(source.get("ref") or "main"),
        expected_base=str(source.get("base_commit") or "") or None,
    )
    cleanup = _dev_stop(session_id, False)
    if not cleanup.get("removed"):
        _die(
            7,
            "dev_cleanup_incomplete",
            "release succeeded but the dev session was not cleanup-ready",
            "; ".join(cleanup.get("problems") or []),
        )
    _emit({
        "session": session_id,
        "rebase": forward,
        "release": release,
        "cleanup": cleanup,
        "ok": True,
    })


def _dev_session_summaries() -> list[dict]:
    sessions = []
    if not DEV_STATE_ROOT.is_dir():
        return sessions
    for path in sorted(DEV_STATE_ROOT.iterdir()):
        data = _read_json(path / "session.json") if path.is_dir() else None
        if not isinstance(data, dict):
            if path.is_dir():
                sessions.append({
                    "id": path.name, "schema": None, "damaged": True,
                    "preserved_state": str(path),
                    "preserved_data": str(_dev_data_dir(path.name)),
                })
            continue
        if data.get("schema") == LEGACY_DEV_SESSION_SCHEMA:
            sessions.append({
                "id": data.get("id") or path.name,
                "schema": LEGACY_DEV_SESSION_SCHEMA,
                "legacy": True,
                "preserved_state": str(path),
                "preserved_data": str(_dev_data_dir(path.name)),
                "source_worktree": data.get("source", {}).get("worktree"),
                "consumer_worktree": (data.get("consumer") or {}).get("worktree"),
            })
            continue
        if data.get("schema") != DEV_SESSION_SCHEMA:
            sessions.append({
                "id": data.get("id") or path.name, "schema": data.get("schema"),
                "damaged": True, "preserved_state": str(path),
                "preserved_data": str(_dev_data_dir(path.name)),
            })
            continue
        source = data.get("source") or {}
        release_path = _release_state_path(
            Path(str(source.get("repo") or ".")), str(source.get("ref") or "main"))
        release = None
        if release_path.exists():
            raw_release = _read_json(release_path)
            release = {
                "path": str(release_path),
                "valid": isinstance(raw_release, dict),
                "state": raw_release if isinstance(raw_release, dict) else None,
            }
        payloads_ok = True
        for payload in (data.get("installed_payloads") or {}).values():
            if not isinstance(payload, dict):
                payloads_ok = False
                break
            payload_path = Path(str(payload.get("path") or ""))
            if (not payload_path.is_dir()
                    or _payload_sha256(payload_path) != payload.get("payload_sha256")):
                payloads_ok = False
                break
        sessions.append({
            "id": data["id"], "capability": data.get("capability"),
            "schema": data.get("schema"),
            "created_at": data.get("created_at"),
            "source_worktree": data.get("source", {}).get("worktree"),
            "attached_project": (data.get("project") or {}).get("path"),
            "installed_payloads_ok": payloads_ok,
            "release_state": release,
            "cleanup_ready": not _dev_cleanup_problems(data),
            "cleanup_problems": _dev_cleanup_problems(data),
        })
    return sessions


def cmd_dev_list() -> None:
    """Report schema-v2, legacy/damaged state, Git work and orphaned leases."""
    sessions = _dev_session_summaries()
    work: list[dict] = []
    binding = _official_checkout_binding(required=False)
    if binding is not None and binding.get("valid") is not False:
        repo = Path(binding["path"])
        worktree_entries = _dev_worktree_entries(repo)
        worktrees = {str(item.get("branch")): item for item in worktree_entries
                     if item.get("branch")}
        refs = _dev_git(repo, "for-each-ref", "--format=%(refname:short)",
                        "refs/heads/dev/*")
        if refs.returncode == 0:
            for branch in sorted(filter(None, refs.stdout.splitlines())):
                item = worktrees.get(f"refs/heads/{branch}")
                worktree = Path(str(item["worktree"])).resolve() \
                    if item and item.get("worktree") else None
                scope, packages, paths = _dev_candidate_scope(
                    repo, branch, str(binding["branch"]), worktree)
                work.append({
                    "branch": branch,
                    "worktree": str(worktree) if worktree else None,
                    "scope": scope, "packages": sorted(packages), "paths": paths,
                })
        for item in worktree_entries:
            if not item.get("detached") or not item.get("worktree"):
                continue
            worktree = Path(str(item["worktree"])).resolve()
            if worktree == repo.resolve():
                continue
            head = str(item.get("HEAD") or "")
            if head:
                scope, packages, paths = _dev_candidate_scope(
                    repo, head, str(binding["branch"]), worktree)
            else:
                scope, packages, paths = "unknown", set(), []
            work.append({
                "branch": None, "detached": True, "head": head or None,
                "worktree": str(worktree), "scope": scope,
                "packages": sorted(packages), "paths": paths,
            })
    _emit({"sessions": sessions, "git_work": work,
           "active_live_leases": _active_takeover_leases(),
           "state_root": str(DEV_STATE_ROOT), "data_root": str(DEV_DATA_ROOT)})


def _dev_remove_worktree(info: dict, discard_work: bool = False) -> None:
    if info.get("live"):
        return
    repo = Path(info["repo"])
    worktree = Path(info["worktree"])
    branch = info.get("branch")
    force = ["--force"] if discard_work else []
    proc = _dev_git(repo, "worktree", "remove", *force, str(worktree), timeout=120)
    if proc.returncode != 0:
        _die(6, "worktree_remove_failed", f"cannot remove worktree {worktree}",
             proc.stderr.strip() or proc.stdout.strip() or None)
    if branch and _dev_branch_exists(repo, branch):
        # Cleanup eligibility was checked against the recorded base ref first.
        proc = _dev_git(repo, "branch", "-D", branch)
        if proc.returncode != 0:
            _die(6, "branch_remove_failed", f"cannot remove preserved branch {branch}",
                 proc.stderr.strip() or proc.stdout.strip() or None)


def _dev_assert_owned_path(path: Path, root: Path) -> None:
    resolved = path.resolve()
    parent = root.resolve()
    if resolved == parent or parent not in resolved.parents:
        _die(6, "unsafe_dev_path", f"refusing cleanup outside dev root: {resolved}")


def _dev_stop(session_id: str, emit_result: bool,
              discard_work: bool = False) -> dict:
    MANAGER_MUTATION_LOCK.parent.mkdir(parents=True, exist_ok=True)
    mutation = MANAGER_MUTATION_LOCK.open("a+")
    fcntl.flock(mutation, fcntl.LOCK_EX)
    active = [lease for lease in _active_takeover_leases()
              if lease.get("session_id") == session_id]
    if active:
        if emit_result:
            _assert_session_without_takeover(session_id)
        mutation.close()
        return {"session": session_id, "removed": False,
                "problems": ["active live takeover"]}
    session = _dev_session(session_id)
    state_dir = _dev_state_dir(session_id)
    data_dir = _dev_data_dir(session_id)
    _dev_assert_owned_path(state_dir, DEV_STATE_ROOT)
    _dev_assert_owned_path(data_dir, DEV_DATA_ROOT)
    _dev_assert_owned_path(Path(session["source"]["worktree"]), data_dir)
    problems, discarded = _dev_cleanup_obstacles(session, discard_work)
    if problems:
        if emit_result:
            _die(6, "dev_cleanup_refused", f"dev session {session_id} is not removable",
                 "; ".join(problems))
        mutation.close()
        return {"session": session_id, "removed": False, "problems": problems}
    _dev_remove_worktree(session["source"], bool(discarded))
    # The schema the session made in the machine's database goes with it.
    schema = _dev_drop_schema(session)
    if data_dir.exists():
        shutil.rmtree(data_dir)
    if state_dir.exists():
        shutil.rmtree(state_dir)
    result = {"session": session_id, "removed": True}
    if schema is not None:
        result["database_schema"] = schema
    if discarded:
        result["discarded"] = discarded
    mutation.close()
    if emit_result:
        _emit(result)
    return result


def cmd_dev_stop(session_id: str, discard_work: bool = False) -> None:
    _dev_stop(session_id, True, discard_work)


def _dev_duration(value: str) -> int:
    match = re.fullmatch(r"([1-9][0-9]*)([smhd])", value)
    if not match:
        _die(6, "bad_duration", f"invalid duration: {value!r}",
             "use an integer followed by s, m, h, or d")
    amount = int(match.group(1))
    return amount * {"s": 1, "m": 60, "h": 3600, "d": 86400}[match.group(2)]


def cmd_dev_gc(older_than: str) -> None:
    cutoff = int(time.time()) - _dev_duration(older_than)
    removed, retained = [], []
    for summary in _dev_session_summaries():
        if int(summary.get("created_at") or 0) > cutoff:
            retained.append({"session": summary["id"], "reason": "younger than cutoff"})
            continue
        result = _dev_stop(summary["id"], False)
        (removed if result["removed"] else retained).append(
            result if result["removed"] else {
                "session": result["session"], "reason": "; ".join(result["problems"]),
            })
    _emit({"older_than": older_than, "removed": removed, "retained": retained})

# ---------------------------------------------------------------- gate

def _load_gate_file(path: Path) -> dict:
    gate = _read_json(path)
    if not path.exists():
        return {"capabilities": {}}
    if gate is None or not isinstance(gate, dict) \
            or not isinstance(gate.get("capabilities"), dict):
        _die(6, "bad_policy", f"{path} is not a capability policy",
             'expected {"capabilities": {"<name>": {"enabled": true}}}')
    for name, entry in gate["capabilities"].items():
        if not isinstance(name, str) or not name.strip() \
                or not isinstance(entry, dict) \
                or set(entry) != {"enabled"} \
                or not isinstance(entry.get("enabled"), bool):
            _die(6, "bad_policy", f"invalid capability policy entry {name!r} in {path}",
                 'each entry must be exactly {"enabled": true|false}')
    return gate


def _load_gate(root: Path) -> dict:
    return _load_gate_file(_gate_file(root))


def _policy_scopes(root: Path) -> tuple[dict, dict]:
    """Policy rows at each exact scope through the active records backend,
    raising the store tier's error. In store mode a scope's row for this node
    is read before its row for every node."""
    adapter = _open_project_records(root)
    try:
        return (adapter.resolve_scope("capabilities", "policy", "project"),
                adapter.resolve_scope("capabilities", "policy", "global"))
    finally:
        adapter.close()


def _policy_views_checked(root: Path) -> tuple[dict, dict]:
    """`_policy_views` for doctor: a store that cannot be used is raised, so it
    is reported as a finding rather than ending the report."""
    store = _store_module()
    envelope = _project_capabilities_dir(root)
    if store.records_mode(envelope) != "store":
        return _policy_views(root)
    return _policy_values(*_policy_scopes(root))


def _policy_views(root: Path | None) -> tuple[dict, dict]:
    """Policy values at each exact scope through the active records backend."""
    if root is None:
        return {}, _load_gate_file(GLOBAL_GATE_FILE)["capabilities"]
    try:
        project_rows, global_rows = _policy_scopes(root)
    except _store_module().StoreError as exc:
        _die(_store_error_exit(exc), exc.slug, exc.message, exc.hint)
    return _policy_values(project_rows, global_rows)


def _policy_values(project_rows: dict, global_rows: dict) -> tuple[dict, dict]:
    """Each scope's policy values, validated."""
    project = {key: row["value"] for key, row in project_rows.items()}
    global_ = {key: row["value"] for key, row in global_rows.items()}
    for scope, entries in (("project", project), ("global", global_)):
        for name, entry in entries.items():
            if (not isinstance(entry, dict) or set(entry) != {"enabled"}
                    or not isinstance(entry.get("enabled"), bool)):
                _die(6, "bad_policy",
                     f"invalid capability policy entry {name!r} at {scope} scope",
                     'each entry must be exactly {"enabled": true|false}')
    return project, global_


def _gate_state(entry) -> str:
    if isinstance(entry, dict) and entry.get("enabled") is True:
        return "enabled"
    if isinstance(entry, dict) and entry.get("enabled") is False:
        return "disabled"
    return "absent"


def _load_machine() -> dict:
    """The machine ceiling file; absent reads as an empty ceiling."""
    if not MACHINE_FILE.exists():
        return {"schema": MACHINE_SCHEMA, "capabilities": {}}
    data = _read_json(MACHINE_FILE)
    entries = data.get("capabilities") if isinstance(data, dict) else None
    if (not isinstance(data, dict) or data.get("schema") != MACHINE_SCHEMA
            or not isinstance(entries, dict)):
        _die(6, "bad_machine_state", f"{MACHINE_FILE} is not a machine ceiling",
             f'expected {{"schema": "{MACHINE_SCHEMA}", "capabilities": {{...}}}}')
    for name, entry in entries.items():
        if not isinstance(entry, dict) or entry.get("state") not in MACHINE_STATES:
            _die(6, "bad_machine_state",
                 f"invalid machine entry {name!r} in {MACHINE_FILE}",
                 'each entry must carry "state": "allowed"|"quarantined"')
    return data


def _machine_state(name: str) -> str:
    """`allowed` or `quarantined`; no entry, or no file, is allowed."""
    entry = _load_machine()["capabilities"].get(name)
    return entry["state"] if entry else "allowed"


def _machine_actor() -> str:
    try:
        return pwd.getpwuid(os.getuid()).pw_name
    except (KeyError, OSError):
        return os.environ.get("USER") or "unknown"


def _write_machine_locked(name: str, state: str | None, record: bool = False) -> bool:
    """Set one capability's machine state, or drop its entry with None.

    Returns whether the state changed; an absent entry counts as allowed. An
    unchanged state is left as it is unless `record` asks for the entry to be
    written anyway, as an install does. The caller holds the manager mutation
    lock."""
    data = _load_machine()
    entries = data["capabilities"]
    current = entries.get(name)
    if state is None:
        if current is None:
            return False
        entries.pop(name)
        changed = True
    else:
        changed = (current["state"] if current else "allowed") != state
        if not changed and not (record and current is None):
            return False
        entries[name] = {
            "state": state,
            "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "by": _machine_actor(),
        }
    data["schema"] = MACHINE_SCHEMA
    _atomic_write_text(MACHINE_FILE, json.dumps(
        data, ensure_ascii=False, indent=2, sort_keys=True) + "\n")
    return changed


def _write_machine(name: str, state: str | None, record: bool = False) -> bool:
    """Write the machine ceiling atomically under the manager mutation lock."""
    if _MANAGER_MUTATION_DEPTH:
        return _write_machine_locked(name, state, record)
    MANAGER_MUTATION_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with MANAGER_MUTATION_LOCK.open("a+") as mutation:
        MANAGER_MUTATION_LOCK.chmod(0o600)
        fcntl.flock(mutation, fcntl.LOCK_EX)
        return _write_machine_locked(name, state, record)


def _machine_connections_store(root: Path | None) -> dict | None:
    """{capability: count} of the connections the store holds as the global
    layer - every connection row, less those whose global grant is switched
    off - where the config home holds no connections file any more (it was
    discarded, or never held one) and the store's global rows exist; None
    where the files still answer or no store does."""
    if any(_CONFIG_HOME.glob("*/connections.json")):
        return None
    db = _db_module()
    try:
        setting = db.resolve_setting(root)
        conn = db.connect(application_name=_store_module().STORE_OWNER, setting=setting,
                          transaction=True)
    except Exception:
        return None
    try:
        if not _migrate_global_at(conn):
            return None
        out: dict = {}
        for name, count in _migrate_rows(
                conn, "SELECT c.capability, count(*) FROM capabilities_connections c "
                      "WHERE NOT EXISTS (SELECT 1 FROM capabilities_connection_grants g "
                      "WHERE g.agent_id IS NULL AND g.node IS NULL AND "
                      "g.capability = c.capability AND g.connection = c.name AND "
                      "g.enabled IS FALSE) GROUP BY c.capability"):
            out[name] = int(count)
        return out
    except Exception:
        return None
    finally:
        conn.close()


def _machine_connections(name: str) -> int:
    """How many connections this machine's global scope declares for `name`,
    leaving out those whose grant there resolves to disabled. Reads the
    non-secret connections file only: no secret, no network."""
    store = _store_module()
    records = store.FileRecords(_CONFIG_HOME / "no-project", _CONFIG_HOME)
    try:
        declared = records.resolve_scope(name, "connection", "global")
        grants = records.resolve_scope(name, "grant", "global")
    except store.StoreError as exc:
        _warn(f"{name}: cannot read global connections — {exc.message}")
        return 0
    return sum(1 for cid in declared
               if not (isinstance(grants.get(cid, {}).get("value"), dict)
                       and grants[cid]["value"].get("enabled") is False))


def cmd_machine(name: str, state: str) -> None:
    """`capabilities allow|quarantine <name>`: this machine's ceiling."""
    _reject_reserved_capability_name(name)
    if name not in _installed():
        _die(3, "not_found", f"{name} is not installed")
    changed = _write_machine(name, state)
    _emit({"capability": name, "machine": state, "changed": changed})


def _effective_gate_state(name: str, project_entry, global_entry) -> tuple[str, str]:
    if _machine_state(name) == "quarantined":
        return "disabled", "machine"
    project_state = _gate_state(project_entry)
    if project_state != "absent":
        return project_state, "project"
    global_state = _gate_state(global_entry)
    if global_state != "absent":
        return global_state, "global"
    return "disabled", "default"


def _merge_gate_values(legacy: Path, current: Path) -> dict | None:
    """Merge standard gate objects, or return None on a semantic conflict."""
    old = _read_json(legacy)
    new = _read_json(current)
    if not isinstance(old, dict) or not isinstance(new, dict):
        return None
    old_caps = old.get("capabilities")
    new_caps = new.get("capabilities")
    if not isinstance(old_caps, dict) or not isinstance(new_caps, dict):
        return None
    merged = dict(new)
    merged_caps = dict(new_caps)
    for name, entry in old_caps.items():
        if name in merged_caps and merged_caps[name] != entry:
            return None
        merged_caps[name] = entry
    for key, value in old.items():
        if key == "capabilities":
            continue
        if key in merged and merged[key] != value:
            return None
        merged.setdefault(key, value)
    merged["capabilities"] = merged_caps
    return merged


def _migrate_legacy_envelope(root: Path) -> list[str]:
    """Move legacy .capabilities/ into visible capabilities/ without data loss.

    A `.capabilities/` that is a machine registry is refused outright: the two
    share that name, and moving a registry breaks every path on the machine
    that points into it.

    The whole merge is preflighted before writes. Identical files coalesce;
    settings.json merges disjoint capability entries; .gitignore merges lines.
    Any other collision refuses the migration and leaves both trees untouched.
    """
    legacy = root / LEGACY_PROJECT_CAPABILITIES_REL
    current = _envelope_home(root)
    if not legacy.is_dir():
        return []
    if _is_machine_registry(legacy):
        _die(6, "envelope_is_machine_registry",
             f"cannot migrate {legacy} into {current}: that tree is a machine "
             "registry, not a legacy project envelope",
             "run this from a project directory instead of a home directory; "
             "neither tree was changed")
    conflicts: list[str] = []
    merged_gate: dict | None = None
    merged_gitignore: str | None = None
    for source in sorted(legacy.rglob("*")):
        rel = source.relative_to(legacy)
        target = current / rel
        if source.is_symlink():
            conflicts.append(f"legacy symlink: {rel}")
            continue
        if source.is_dir():
            if target.exists() and not target.is_dir():
                conflicts.append(str(rel))
            continue
        if not target.exists():
            continue
        if not target.is_file():
            conflicts.append(str(rel))
        elif rel == Path("settings.json"):
            merged_gate = _merge_gate_values(source, target)
            if merged_gate is None:
                conflicts.append(str(rel))
        elif rel == Path(".gitignore"):
            lines = list(dict.fromkeys([
                *target.read_text().splitlines(),
                *source.read_text().splitlines(),
            ]))
            merged_gitignore = "\n".join(lines).rstrip() + "\n"
        elif source.read_bytes() != target.read_bytes():
            conflicts.append(str(rel))
    if conflicts:
        _die(6, "envelope_conflict",
             "cannot migrate legacy .capabilities/ into capabilities/; "
             f"conflicting paths: {', '.join(conflicts)}",
             "merge those paths manually, then rerun `capabilities init`; "
             "neither tree was changed")

    current.mkdir(exist_ok=True)
    moved: list[str] = []
    for source in sorted(legacy.rglob("*"), key=lambda p: (len(p.parts), str(p))):
        if not source.is_dir():
            continue
        (current / source.relative_to(legacy)).mkdir(parents=True, exist_ok=True)
    for source in sorted(p for p in legacy.rglob("*") if p.is_file()):
        rel = source.relative_to(legacy)
        target = current / rel
        if target.exists():
            if rel == Path("settings.json") and merged_gate is not None:
                _write_json(target, merged_gate)
            elif rel == Path(".gitignore") and merged_gitignore is not None:
                target.write_text(merged_gitignore)
            source.unlink()
        else:
            target.parent.mkdir(parents=True, exist_ok=True)
            source.replace(target)
        moved.append(str(rel))
    for directory in sorted(
            (p for p in legacy.rglob("*") if p.is_dir()),
            key=lambda p: len(p.parts), reverse=True):
        directory.rmdir()
    legacy.rmdir()
    return moved


def _refuse_while_moving(root: Path) -> None:
    """Refuse, before any file is written, a write to an agent whose records
    are being moved into the store by `capabilities migrate`: until it
    finishes, only the migration on its master writes them."""
    store = _store_module()
    try:
        adapter = _open_project_records(root)
    except store.StoreError:
        return  # what keeps the records from opening is the write's own to say
    try:
        state = adapter._agent_now()
    except store.StoreError:
        state = None
    finally:
        adapter.close()
    try:
        store._refuse_frozen(state, adapter._guard_agent, getattr(adapter, "actor", None))
    except store.StoreError as exc:
        _die(_store_error_exit(exc), exc.slug, exc.message, exc.hint)


def _ensure_envelope(root: Path, new_agent: bool = False) -> list[str]:
    """Manager-owned project files: migrate, then scaffold gate + state guard.
    A new agent's identity declares its records in the store, so it gets no
    settings file."""
    _refuse_while_moving(root)
    migrated = _migrate_legacy_envelope(root)
    capdir = _envelope_home(root)
    capdir.mkdir(parents=True, exist_ok=True)
    gi = capdir / ".gitignore"
    if not gi.exists() or GITIGNORE_BODY.strip() not in gi.read_text():
        existing = gi.read_text() if gi.exists() else ""
        gi.write_text(existing + ("" if existing.endswith("\n") or not existing else "\n")
                      + GITIGNORE_BODY)
    identity = _ensure_project_identity(capdir, root)
    if new_agent and identity.get(_store_module().RECORDS_MODE_KEY) != "store":
        identity[_store_module().RECORDS_MODE_KEY] = "store"
        _write_json(capdir / PROJECT_IDENTITY_REL, identity)
    gate_file = capdir / "settings.json"
    # The file gate exists only in files mode; a project whose records are in
    # the store keeps its policy there and is marked by project.json.
    store = _store_module()
    try:
        in_store = store.records_mode(capdir) == "store"
    except store.StoreError:
        in_store = False  # the records backend refuses it on its own read
    if not gate_file.exists() and not in_store:
        _write_json(gate_file, {"capabilities": {}})
    return migrated


def _ensure_project_identity(capdir: Path, root: Path) -> dict:
    """Who this project is, minted once and committed.

    The id travels with the repository, so a laptop and a server resolve to the
    same project without being told. project.json is its one home: an id
    already written is never rewritten. Where it has none, an id a ContextKit
    binding holds is carried over, and otherwise one is minted here, offline."""
    identity_file = capdir / PROJECT_IDENTITY_REL
    if identity_file.is_file():
        identity = _read_json(identity_file)
        if not isinstance(identity, dict):
            return {}
        if str(identity.get("id") or "").strip():
            return identity
    else:
        identity = {"schema": PROJECT_IDENTITY_SCHEMA, "slug": _default_project_slug(root)}
    # Twelve hex characters, for the reason a document version has twelve:
    # an identifier nobody can read is an identifier nobody checks.
    identity["id"] = _contextkit_config_id(root) or "prj_" + secrets.token_hex(6)
    _write_json(identity_file, identity)
    return identity


def _default_project_slug(root: Path) -> str:
    """A first label from the directory name. It is written down precisely so
    the directory may be renamed afterwards without the project moving."""
    slug = re.sub(r"[^a-z0-9-]+", "-", root.name.lower()).strip("-")
    return slug or "project"


def cmd_relabel(slug: str) -> None:
    """Give this project a new label, keeping its id.

    The label lives in the project's identity file and nowhere else, so the
    rename is that one write. Records were never scoped by the label, and the
    directory on disk was never the label either, so renaming the directory
    remains a thing that needs no command at all.
    """
    root = _require_project()
    identity = _read_json(_envelope_home(root) / PROJECT_IDENTITY_REL)
    project_id = _project_id_for_write(root)
    if not isinstance(identity, dict) or not project_id:
        _die(6, "no_project_identity",
             f"{_envelope_home(root) / PROJECT_IDENTITY_REL} carries no project id",
             "run `capabilities init` in the project to mint its identity")
    store = _store_module()
    try:
        store._store_check("slug", slug, store.CAPABILITY_RE)
    except store.StoreError as exc:
        _die(6, exc.slug, exc.message, exc.hint)
    was = identity.get("slug")
    identity["slug"] = slug
    _write_json(_envelope_home(root) / PROJECT_IDENTITY_REL, identity)
    _emit({"ok": True, "project": str(root), "id": project_id,
           "slug": slug, "previous_slug": was,
           "identity": str(_envelope_home(root) / PROJECT_IDENTITY_REL),
           "unchanged": was == slug})


# ---------------------------------------------------------------- the kernel: agents and nodes

# The agent registry and the agent's nodes live in the store, in the contract's
# own tables, keyed by the id project.json declares. The manager alone writes
# them; `agent` and `node` answer for the project the call runs in.
AGENT_COLUMNS = ("id", "name", "description", "icon_sha", "onboarding_status",
                 "onboarding_routine", "migrating_since", "migrated_at",
                 "created_at", "updated_at")
AGENT_TEXT_FIELDS = {"--name": "name", "--description": "description",
                     "--onboarding-routine": "onboarding_routine"}
ONBOARDING_STATUSES = ("pending", "complete")
NODE_COLUMNS = ("node", "kind", "address", "is_master", "may_write", "target",
                "last_seen_at")
NODE_KINDS = ("mac", "server")
PNG_SIGNATURE = b"\x89PNG\r\n\x1a\n"


def _kernel_open(root: Path):
    """(connection, setting) for the project's store with the contract's tables
    migrated, or the store's refusal. The caller closes the connection."""
    db = _db_module()
    store = _store_module()
    try:
        setting = db.resolve_setting(root)
        conn = db.connect(application_name=store.STORE_OWNER, setting=setting,
                          transaction=True)
    except db.DbError as exc:
        _die(_store_error_exit(exc), exc.slug, exc.message, exc.hint)
    import psycopg
    try:
        major, minor = store.STORE_TABLES_VERSION
        db.migrate(conn, store.STORE_OWNER, store.record_table_steps(),
                   major=major, minor=minor)
    except db.DbError as exc:
        conn.close()
        _die(_store_error_exit(exc), exc.slug, exc.message, exc.hint)
    except psycopg.OperationalError as exc:
        conn.close()
        _die(5, "store_unreachable", f"cannot reach the store: {exc}",
             "check the database setting with `capabilities store doctor`")
    return conn, setting


def _kernel_agent_id(root: Path) -> str:
    agent_id = _project_id_for_write(root)
    if not agent_id:
        _die(6, "no_project_identity",
             f"{_project_capabilities_dir(root) / PROJECT_IDENTITY_REL} carries no project id",
             "run `capabilities init` in the project to mint its identity")
    return agent_id


def _kernel_run(root: Path, work):
    """Run `work(conn, agent_id)` in one transaction against the project's store
    and answer what it returns, with the store's errors as the manager's exits."""
    agent_id = _kernel_agent_id(root)
    conn, setting = _kernel_open(root)
    import psycopg
    try:
        with conn.transaction():
            return work(conn, agent_id), setting
    except psycopg.errors.UniqueViolation:
        raise
    except psycopg.OperationalError as exc:
        _die(5, "store_unreachable", f"cannot reach the store: {exc}",
             "check the database setting with `capabilities store doctor`")
    except psycopg.Error as exc:
        _die(5, "store_write_failed", f"the store refused the change: {exc}")
    finally:
        conn.close()


def _kernel_store_report(setting) -> dict:
    return {"level": setting.level, "schema": setting.schema}


def _agent_row(conn, agent_id: str) -> dict | None:
    stamp = _store_module()._stamp
    row = conn.execute(
        f"SELECT {', '.join(AGENT_COLUMNS)}, octet_length(icon) "
        "FROM capabilities_agents WHERE id = %s", (agent_id,)).fetchone()
    if row is None:
        return None
    agent = dict(zip(AGENT_COLUMNS, row[:-1]))
    for key in ("migrating_since", "migrated_at", "created_at", "updated_at"):
        agent[key] = stamp(agent[key])
    agent["icon_bytes"] = row[-1]
    return agent


def _ensure_agent_row(conn, agent_id: str) -> bool:
    """Register the agent with its id alone where it is not yet registered;
    True when this call registered it."""
    cur = conn.execute("INSERT INTO capabilities_agents (id) VALUES (%s) "
                       "ON CONFLICT (id) DO NOTHING", (agent_id,))
    return cur.rowcount == 1


def _new_agent_project(root: Path) -> bool:
    """Whether init is creating this agent: no identity, no settings file and
    no legacy envelope yet, so it has no records anywhere to move."""
    capdir = _envelope_home(root)
    return not (capdir / PROJECT_IDENTITY_REL).exists() \
        and not (capdir / "settings.json").exists() \
        and not (root / LEGACY_PROJECT_CAPABILITIES_REL).exists()


def _preflight_new_agent(root: Path) -> None:
    """A new agent starts in the store, so init refuses one before writing
    anything where it could not work there: no node name, no store, or a store
    whose global records have not moved from this machine's files."""
    store = _store_module()
    if not os.environ.get(store.NODE_NAME_ENV, "").strip():
        _die(6, "node_unnamed",
             f"{store.NODE_NAME_ENV} is not set: a new agent keeps its records in the "
             "store, read per node, and this machine names no node",
             f"set {store.NODE_NAME_ENV} to this machine's node name, then run "
             "`capabilities init` again")
    db = _db_module()
    try:
        setting = db.resolve_setting(root)
        conn = db.connect(application_name=store.STORE_OWNER, setting=setting,
                          transaction=True)
    except db.DbError as exc:
        hint = ("a new agent keeps its records in the store: configure it with "
                "`capabilities store set`, then run `capabilities init` again"
                if exc.slug == "store_not_configured" else exc.hint)
        _die(5 if exc.slug != "store_not_configured" else 6, exc.slug, exc.message, hint)
    try:
        global_at = _migrate_global_at(conn)
    finally:
        conn.close()
    if not global_at:
        _die(6, "global_not_migrated",
             "this store does not hold the global records yet, so a new agent "
             "started in it would not see this machine's global connections",
             "run `capabilities migrate --global --apply`, then `capabilities init` again")


def _register_agent_on_init(root: Path, new_agent: bool = False) -> dict:
    """init's registration of the agent row: written where a database resolves
    for the project, and otherwise reported, never failing init. A new agent
    is registered migrated with this node as its master."""
    agent_id = _project_json_id(root)
    if not agent_id:
        return {"registered": False, "reason": "no_project_identity"}
    db = _db_module()
    store = _store_module()
    try:
        setting = db.resolve_setting(root)
    except db.DbError as exc:
        if exc.slug == "store_not_configured":
            return {"registered": False, "reason": "store_not_configured"}
        return {"registered": False, "error": _db_error(exc)}
    import psycopg
    try:
        conn = db.connect(application_name=store.STORE_OWNER, setting=setting,
                          transaction=True)
    except db.DbError as exc:
        return {"registered": False, "error": _db_error(exc)}
    try:
        major, minor = store.STORE_TABLES_VERSION
        db.migrate(conn, store.STORE_OWNER, store.record_table_steps(),
                   major=major, minor=minor)
        node = os.environ.get(store.NODE_NAME_ENV, "").strip()
        with conn.transaction():
            created = _ensure_agent_row(conn, agent_id)
            if new_agent and node:
                conn.execute("UPDATE capabilities_agents SET migrated_at = now(), updated_at = now() "
                             "WHERE id = %s AND migrated_at IS NULL AND migrating_since IS NULL", (agent_id,))
                conn.execute("INSERT INTO capabilities_agent_nodes (agent_id, node, kind, "
                             "is_master) SELECT %s, %s, %s, true WHERE NOT EXISTS (SELECT 1 "
                             "FROM capabilities_agent_nodes WHERE agent_id = %s AND is_master) "
                             "ON CONFLICT (agent_id, node) DO NOTHING",
                             (agent_id, node, "mac" if sys.platform == "darwin" else "server",
                              agent_id))
        return {"registered": True, "id": agent_id, "created": created,
                "migrated": new_agent and bool(node),
                "store": _kernel_store_report(setting)}
    except db.DbError as exc:
        return {"registered": False, "error": _db_error(exc)}
    except psycopg.Error as exc:
        return {"registered": False,
                "error": {"code": "store_write_failed",
                          "message": f"registering the agent failed: {exc}"}}
    finally:
        conn.close()


def _kernel_options(args: list[str], valued: set[str], flags: set[str],
                    verb: str) -> tuple[list[str], dict]:
    """Split a kernel verb's arguments into positionals and options, refusing
    anything it does not take."""
    positionals, options, i = [], {}, 0
    while i < len(args):
        arg = args[i]
        name, eq, value = arg.partition("=")
        if name in valued:
            if not eq:
                if i + 1 >= len(args):
                    _die(6, "input", f"{name} needs a value")
                value, i = args[i + 1], i + 1
            if name in options:
                _die(6, "input", f"{name} given twice")
            options[name] = value
        elif arg in flags:
            options[arg] = True
        elif arg.startswith("--"):
            _die(6, "input", f"`capabilities {verb}` does not take {arg}",
                 "run `capabilities help` for the kernel verbs")
        else:
            positionals.append(arg)
        i += 1
    return positionals, options


def cmd_agent(args: list[str]) -> None:
    sub = args[0] if args else None
    root = _require_project()
    if sub == "show":
        pos, opts = _kernel_options(args[1:], {"--icon-out"}, {"--json"}, "agent show")
        if pos:
            _die(6, "input", "agent show takes no positional argument")

        def show(conn, agent_id):
            agent = _agent_row(conn, agent_id)
            icon = None
            if "--icon-out" in opts:
                found = conn.execute("SELECT icon FROM capabilities_agents WHERE id = %s",
                                     (agent_id,)).fetchone()
                icon = bytes(found[0]) if found and found[0] is not None else None
            return agent_id, agent, icon

        (agent_id, agent, icon), setting = _kernel_run(root, show)
        answer = {"ok": True, "project": str(root), "agent_id": agent_id,
                  "registered": agent is not None, "agent": agent,
                  "store": _kernel_store_report(setting)}
        if "--icon-out" in opts:
            if icon is None:
                _die(6, "no_icon", f"agent {agent_id} has no icon")
            out = Path(opts["--icon-out"]).expanduser()
            out.parent.mkdir(parents=True, exist_ok=True)
            out.write_bytes(icon)
            answer["icon_out"] = str(out.resolve())
        _emit(answer)
    elif sub == "set":
        _read_only_gate("agent set")
        pos, opts = _kernel_options(
            args[1:], {*AGENT_TEXT_FIELDS, "--icon", "--onboarding-status"},
            {"--no-icon", "--json"}, "agent set")
        if pos:
            _die(6, "input", "agent set takes no positional argument")
        values: dict = {}
        for flag_name, column in AGENT_TEXT_FIELDS.items():
            if flag_name in opts:
                values[column] = opts[flag_name].strip() or None
        if "--onboarding-status" in opts:
            status = opts["--onboarding-status"].strip()
            if status not in (*ONBOARDING_STATUSES, "none"):
                _die(6, "input", f"--onboarding-status {status!r} is not one of "
                     f"{', '.join(ONBOARDING_STATUSES)} or none")
            values["onboarding_status"] = None if status == "none" else status
        if "--icon" in opts and "--no-icon" in opts:
            _die(6, "input", "agent set takes --icon or --no-icon, not both")
        if "--icon" in opts:
            path = Path(opts["--icon"]).expanduser()
            try:
                data = path.read_bytes()
            except OSError as exc:
                _die(6, "input", f"--icon {path} cannot be read: {exc}")
            if not data.startswith(PNG_SIGNATURE):
                _die(6, "input", f"--icon {path} is not a PNG file")
            values["icon"] = data
            values["icon_sha"] = hashlib.sha256(data).hexdigest()
        elif "--no-icon" in opts:
            values["icon"] = None
            values["icon_sha"] = None
        if not values:
            _die(6, "input", "agent set needs at least one of --name, --description, "
                 "--icon, --no-icon, --onboarding-status, --onboarding-routine")

        def write(conn, agent_id):
            created = _ensure_agent_row(conn, agent_id)
            columns = list(values)
            assignments = ", ".join(f"{c} = %s" for c in columns)
            cur = conn.execute(
                f"UPDATE capabilities_agents SET {assignments}, updated_at = now() "
                f"WHERE id = %s AND ({', '.join(columns)}) IS DISTINCT FROM "
                f"({', '.join(['%s'] * len(columns))})",
                (*values.values(), agent_id, *values.values()))
            return agent_id, created, cur.rowcount == 1, _agent_row(conn, agent_id)

        (agent_id, created, changed, agent), setting = _kernel_run(root, write)
        _emit({"ok": True, "project": str(root), "agent_id": agent_id,
               "created": created, "changed": created or changed, "agent": agent,
               "store": _kernel_store_report(setting)})
    else:
        _die(6, "input", "agent needs a subcommand: show or set",
             "run `capabilities help`")


def _node_rows(conn, agent_id: str, node: str | None = None) -> list[dict]:
    stamp = _store_module()._stamp
    sql = (f"SELECT {', '.join(NODE_COLUMNS)} FROM capabilities_agent_nodes "
           "WHERE agent_id = %s")
    params: tuple = (agent_id,)
    if node is not None:
        sql, params = sql + " AND node = %s", (agent_id, node)
    rows = conn.execute(sql + " ORDER BY node", params).fetchall()
    out = []
    for row in rows:
        entry = dict(zip(NODE_COLUMNS, row))
        entry["last_seen_at"] = stamp(entry["last_seen_at"])
        out.append(entry)
    return out


def _node_name_arg(pos: list[str], verb: str) -> str:
    if len(pos) != 1 or not pos[0].strip():
        _die(6, "input", f"node {verb} needs exactly one node name")
    return pos[0].strip()


def _node_values(opts: dict) -> dict:
    """The columns a node add or set writes, from its options."""
    values: dict = {}
    if "--kind" in opts:
        kind = opts["--kind"].strip()
        if kind not in NODE_KINDS:
            _die(6, "input", f"--kind {kind!r} is not one of {', '.join(NODE_KINDS)}")
        values["kind"] = kind
    for flag_name, column in (("--address", "address"), ("--target", "target")):
        if flag_name in opts:
            values[column] = opts[flag_name].strip() or None
    for on, off, column in (("--master", "--no-master", "is_master"),
                            ("--may-write", "--no-may-write", "may_write")):
        if on in opts and off in opts:
            _die(6, "input", f"node takes {on} or {off}, not both")
        if on in opts:
            values[column] = True
        elif off in opts:
            values[column] = False
    return values


def _refuse_second_master(conn, agent_id: str, node: str) -> None:
    held = conn.execute(
        "SELECT node FROM capabilities_agent_nodes WHERE agent_id = %s AND is_master "
        "AND node <> %s FOR UPDATE", (agent_id, node)).fetchone()
    if held is not None:
        raise _KernelRefusal(
            "master_exists", f"agent {agent_id} already has master node {held[0]}",
            f"an agent has one master: run `capabilities node set {held[0]} "
            "--no-master` first, then make this node the master")


class _KernelRefusal(Exception):
    def __init__(self, code: str, message: str, hint: str | None = None):
        super().__init__(message)
        self.code, self.message, self.hint = code, message, hint


def cmd_node(args: list[str]) -> None:
    sub = args[0] if args else None
    root = _require_project()
    valued = {"--kind", "--address", "--target"}
    toggles = {"--master", "--no-master", "--may-write", "--no-may-write"}
    import psycopg
    if sub == "list":
        pos, _opts = _kernel_options(args[1:], set(), {"--json"}, "node list")
        if pos:
            _die(6, "input", "node list takes no positional argument")
        (agent_id, nodes), setting = _kernel_run(
            root, lambda conn, agent_id: (agent_id, _node_rows(conn, agent_id)))
        _emit({"ok": True, "project": str(root), "agent_id": agent_id,
               "nodes": nodes, "store": _kernel_store_report(setting)})
        return
    if sub not in ("add", "set", "remove"):
        _die(6, "input", "node needs a subcommand: add, set, list or remove",
             "run `capabilities help`")
    _read_only_gate(f"node {sub}")
    if sub == "remove":
        pos, _opts = _kernel_options(args[1:], set(), {"--json"}, "node remove")
        values: dict = {}
    else:
        pos, opts = _kernel_options(args[1:], valued, {*toggles, "--json"}, f"node {sub}")
        values = _node_values(opts)
    node = _node_name_arg(pos, sub)
    if sub == "add" and "kind" not in values:
        _die(6, "input", "node add needs --kind mac|server")
    if sub == "set" and not values:
        _die(6, "input", "node set needs at least one of --kind, --address, --target, "
             "--master, --no-master, --may-write, --no-may-write")

    def work(conn, agent_id):
        if sub == "add":
            _ensure_agent_row(conn, agent_id)
            if _node_rows(conn, agent_id, node):
                raise _KernelRefusal("node_exists",
                                     f"agent {agent_id} already has node {node}",
                                     f"change it with `capabilities node set {node}`")
            if values.get("is_master"):
                _refuse_second_master(conn, agent_id, node)
            columns = ["agent_id", "node", *values]
            conn.execute(
                f"INSERT INTO capabilities_agent_nodes ({', '.join(columns)}) "
                f"VALUES ({', '.join(['%s'] * len(columns))})",
                (agent_id, node, *values.values()))
            return agent_id, _node_rows(conn, agent_id, node)[0], True
        before = _node_rows(conn, agent_id, node)
        if not before:
            raise _KernelRefusal("node_unknown", f"agent {agent_id} has no node {node}",
                                 "run `capabilities node list` to see its nodes")
        if sub == "remove":
            conn.execute("DELETE FROM capabilities_agent_nodes "
                         "WHERE agent_id = %s AND node = %s", (agent_id, node))
            return agent_id, before[0], True
        if values.get("is_master"):
            _refuse_second_master(conn, agent_id, node)
        assignments = ", ".join(f"{c} = %s" for c in values)
        conn.execute(f"UPDATE capabilities_agent_nodes SET {assignments} "
                     "WHERE agent_id = %s AND node = %s",
                     (*values.values(), agent_id, node))
        after = _node_rows(conn, agent_id, node)[0]
        return agent_id, after, after != before[0]

    try:
        (agent_id, row, changed), setting = _kernel_run(root, work)
    except _KernelRefusal as exc:
        _die(6, exc.code, exc.message, exc.hint)
    except psycopg.errors.UniqueViolation:
        # Another writer made a master between the check and the write.
        _die(6, "master_exists", "this agent already has a master node",
             "run `capabilities node list` to see it")
    answer = {"ok": True, "project": str(root), "agent_id": agent_id,
              "store": _kernel_store_report(setting)}
    if sub == "remove":
        answer["removed"] = row
    else:
        answer.update(node=row, changed=changed)
    _emit(answer)


# ---------------------------------------------------------------- the store setting

STORE_VALUE_OPTIONS = {
    "--host": "host", "--port": "port", "--database": "database",
    "--user": "user", "--sslmode": "sslmode", "--sslrootcert": "sslrootcert",
    "--transaction-host": "transaction_host", "--transaction-port": "transaction_port",
}
STORE_SCHEMA_OPTION = "--schema"
STORE_PASSWORD_OPTIONS = ("--password-stdin", "--password-file", "--password-env")
# What a plain-text attempt reads when pg_hba.conf turns it away for lacking
# TLS: "no encryption" from Postgres 14 on, "SSL off" before it.
STORE_PLAIN_REFUSAL_MARKERS = ("no encryption", "SSL off")


def _store_set_args(args: list[str]) -> tuple[dict, tuple[str, str | None]]:
    """Parse `store set` strictly. No value an argument carries is echoed back,
    since a password put on argv by mistake must not reach the output too."""
    values: dict = {}
    sources: list[tuple[str, str | None]] = []
    i = 0
    while i < len(args):
        name, eq, inline = args[i].partition("=")
        if not name.startswith("--"):
            _die(6, "input", "`capabilities store set` takes options only",
                 "run `capabilities help` for its options")
        if name == "--password" or name.startswith("--password") and \
                name not in STORE_PASSWORD_OPTIONS:
            _die(6, "secret_on_argv",
                 "`capabilities store set` takes no password on its command line",
                 "pass it on stdin with --password-stdin, in a file with "
                 "--password-file PATH, or in an environment variable named by "
                 "--password-env KEY")
        if name == "--password-stdin":
            if eq:
                _die(6, "input", "--password-stdin takes no value")
            sources.append(("stdin", None))
            i += 1
            continue
        if name not in STORE_VALUE_OPTIONS and name not in STORE_PASSWORD_OPTIONS \
                and name != STORE_SCHEMA_OPTION:
            _die(6, "input", f"unknown store set option: {name}",
                 "run `capabilities help` for its options")
        if eq:
            value, i = inline, i + 1
        elif i + 1 < len(args):
            value, i = args[i + 1], i + 2
        else:
            _die(6, "input", f"{name} needs a value")
        if name == "--password-file":
            sources.append(("file", value))
        elif name == "--password-env":
            sources.append(("env", value))
        elif name == STORE_SCHEMA_OPTION:
            if "db_schema" in values:
                _die(6, "input", f"{name} is given twice")
            values["db_schema"] = value
        elif STORE_VALUE_OPTIONS[name] in values:
            _die(6, "input", f"{name} is given twice")
        else:
            values[STORE_VALUE_OPTIONS[name]] = value
    if len(sources) != 1:
        _die(6, "password_source",
             "`capabilities store set` needs exactly one password source",
             "one of --password-stdin, --password-file PATH or --password-env KEY")
    for field in ("host", "database", "user"):
        if field not in values:
            _die(6, "input", f"store set needs --{field}")
    return values, sources[0]


def _store_password(source: tuple[str, str | None]) -> str:
    kind, where = source
    if kind == "stdin":
        password = sys.stdin.read()
    elif kind == "file":
        try:
            password = Path(where).expanduser().read_text()
        except (OSError, UnicodeDecodeError) as exc:
            _die(6, "password_source",
                 f"cannot read the password file {where}: {exc.__class__.__name__}")
    else:
        if not where or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", where):
            _die(6, "password_source", "--password-env needs an environment variable name")
        password = os.environ.get(where) or ""
        if not password:
            _die(6, "password_source", f"the environment variable {where} is not set")
    if password.endswith("\n"):
        password = password[:-1]
        if password.endswith("\r"):
            password = password[:-1]
    if not password:
        _die(6, "password_source", "the password is empty")
    if any(ch in password for ch in "\n\r\0"):
        _die(6, "password_source", "the password holds a line break or NUL",
             "the password is kept as one line")
    return password


def _atomic_write_secret(path: Path, body: str) -> None:
    """Replace a secret file whole at mode 0600; it is never readable by others,
    not even as the temporary file it is written through."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.",
                                    suffix=".tmp")
    tmp_path = Path(tmp_name)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as handle:
            handle.write(body)
            handle.flush()
            os.fsync(handle.fileno())
        tmp_path.replace(path)
    except BaseException:
        tmp_path.unlink(missing_ok=True)
        raise
    path.chmod(0o600)


def _db_module():
    """The shared database library, which alone resolves which database a
    project uses. Imported on use, so every verb that never asks runs without
    it; the script header pins it."""
    try:
        from capabilities_contract import db
    except ImportError:
        _die(5, "driver_missing",
             "the shared database library capabilities-contract is not installed",
             "run the manager through its own script header, which pins it")
    return db


def _db_error(exc) -> dict:
    return {"code": exc.slug, "message": exc.message, "hint": exc.hint}


@contextmanager
def _db_environment_cleared():
    """The process environment without the cascade's keys, for the span of one
    question asked of a lower level."""
    db = _db_module()
    held = {key: os.environ.pop(key) for key in db.KEYS if key in os.environ}
    try:
        yield
    finally:
        os.environ.update(held)


def _db_level(ask) -> tuple[object | None, dict | None]:
    """One level's answer: its setting, or None when it does not answer, or the
    library's refusal of it."""
    db = _db_module()
    try:
        return ask(), None
    except db.DbError as exc:
        if exc.slug == "store_not_configured":
            return None, None
        return None, _db_error(exc)


def _db_store_project(project: str | None) -> Path | None:
    """The project the store verbs answer for: --project PATH, else the current
    project, else none, in which case the project level is not asked."""
    if project is None:
        return _project_root()
    root = Path(project).expanduser().resolve()
    if not root.is_dir():
        _die(6, "input", f"--project {project} is not a directory")
    return root


def _store_report(root: Path | None) -> tuple[dict, object | None, dict | None]:
    """`store show`: every level of the cascade for `root`, as the library
    answers each, secrets redacted, and the level in force. Each lower level is
    asked on its own - the levels above it held out of the question - so a
    level is reported whether or not it is the one in force; which one is in
    force is the library's own answer for the project."""
    db = _db_module()
    with tempfile.TemporaryDirectory(prefix="capabilities-store-") as empty:
        levels: dict = {}
        if root is not None:
            with _db_environment_cleared():
                found, error = _db_level(lambda: db.resolve_setting(root, config_home=empty))
            levels["project"] = {"asked": True, "answers": found is not None or error is not None,
                                 "setting": found.report() if found else None, "error": error}
        else:
            levels["project"] = {"asked": False, "answers": False, "setting": None,
                                 "error": None}
        found, error = _db_level(lambda: db.resolve_setting(None, config_home=empty))
        levels["environment"] = {"answers": found is not None or error is not None,
                                 "setting": found.report() if found else None, "error": error}
    path = db.setting_path()
    with _db_environment_cleared():
        found, error = _db_level(lambda: db.resolve_setting(None))
    levels["machine"] = {"path": str(path), "exists": path.exists(),
                         "answers": found is not None or error is not None,
                         "setting": found.report() if found else None, "error": error}
    in_force, refused = _db_level(lambda: db.resolve_setting(root))
    report = {"configured": in_force is not None,
              "project": str(root) if root is not None else None,
              "in_force": in_force.level if in_force is not None else None,
              "setting": in_force.report() if in_force is not None else None,
              "error": refused, "levels": levels}
    if refused is not None:
        report["in_force"] = next((level for level in db.LEVELS
                                   if levels[level]["answers"]), None)
    return report, in_force, refused


def _setting_file_version(path: Path) -> str | None:
    """The format version the file at `path` declares, or None when it is
    absent or declares none. A writer reads this before it replaces the file,
    and never replaces a version it does not know."""
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError):
        return None
    version = data.get("schema") if isinstance(data, dict) else None
    return version if isinstance(version, str) else None


def _refuse_unknown_store_version(path: Path) -> None:
    """A writer never replaces a setting whose format version it does not know."""
    version = _setting_file_version(path)
    if version is not None and version != _db_module().SETTING_FORMAT:
        _die(6, "store_setting_too_new",
             f"{path} is a {version} setting, which this manager does not know, "
             "so it is left as it is",
             "update the capabilities manager, or change the setting with the "
             "tool that wrote it")


def _store_setting_document(values: dict, schema: str | None) -> dict:
    """The machine file `store set` writes, without its password, proven
    readable by the library before anything is replaced: it is written to a
    scratch config home and read back there through the machine level alone, so
    a value the library would refuse is refused here, in the library's words."""
    db = _db_module()
    document = {"schema": db.SETTING_FORMAT, **values}
    for field in ("port", "transaction_port"):
        if isinstance(document.get(field), str) and document[field].isdigit():
            document[field] = int(document[field])
    document.setdefault("port", 5432)
    if schema is not None:
        document["db_schema"] = schema
    with tempfile.TemporaryDirectory(prefix="capabilities-store-") as scratch:
        probe = db.setting_path(scratch)
        probe.parent.mkdir(parents=True)
        probe.write_text(json.dumps(document))
        with _db_environment_cleared():
            try:
                db.resolve_setting(None, config_home=scratch)
            except db.DbError as exc:
                message = exc.message.replace(str(probe), "the setting")
                _die(6, exc.slug, message, exc.hint)
    return document


def _write_store_setting_locked(document: dict) -> bool:
    """Write the machine file whole."""
    path = _db_module().setting_path()
    _refuse_unknown_store_version(path)
    try:
        current = json.loads(path.read_text())
    except (OSError, ValueError):
        current = None
    _atomic_write_secret(path, json.dumps(
        document, ensure_ascii=False, indent=2, sort_keys=True) + "\n")
    return current != document


def _unset_store_setting_locked() -> bool:
    """Remove the machine file. True when it was there."""
    path = _db_module().setting_path()
    _refuse_unknown_store_version(path)
    changed = path.exists()
    path.unlink(missing_ok=True)
    return changed


def _with_store_lock(write):
    """Run one write of the setting under the manager mutation lock."""
    if _MANAGER_MUTATION_DEPTH:
        return write()
    MANAGER_MUTATION_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with MANAGER_MUTATION_LOCK.open("a+") as mutation:
        MANAGER_MUTATION_LOCK.chmod(0o600)
        fcntl.flock(mutation, fcntl.LOCK_EX)
        return write()


def cmd_store_show(project: str | None) -> None:
    _emit(_store_report(_db_store_project(project))[0])


def cmd_store_set(args: list[str]) -> None:
    _read_only_gate("store set")
    values, source = _store_set_args(args)
    if "sslmode" not in values:
        values["sslmode"] = "verify-full" if values.get("sslrootcert") else "require"
    root = values.get("sslrootcert")
    if root is not None and root != "system":
        path = Path(root).expanduser().resolve()
        if not path.is_file() or not os.access(path, os.R_OK):
            _die(6, "bad_store_setting", f"--sslrootcert {root} is not a readable file")
        values["sslrootcert"] = str(path)
    schema = values.pop("db_schema", None)
    document = _store_setting_document(values, schema)
    document["password"] = _store_password(source)
    changed = _with_store_lock(lambda: _write_store_setting_locked(document))
    _emit({**_store_report(_project_root())[0], "changed": changed})


def cmd_store_unset() -> None:
    _read_only_gate("store unset")
    changed = _with_store_lock(_unset_store_setting_locked)
    _emit({**_store_report(_project_root())[0], "changed": changed})


def _setting_secrets(setting) -> list[str]:
    """The secret values a setting carries, so an error text never shows one."""
    secrets = [setting.password] if setting.password else []
    if setting.url is not None:
        try:
            from psycopg.conninfo import conninfo_to_dict
            secrets += [str(value) for key, value in conninfo_to_dict(setting.url).items()
                        if key in ("password", "sslpassword") and value]
        except Exception:
            pass
        secrets.append(setting.url)
    return secrets


def _store_scrub(text, setting) -> str:
    text = " ".join(str(text).split())
    for secret in sorted(_setting_secrets(setting), key=len, reverse=True):
        text = text.replace(secret, "***")
    return text


def _store_connect(setting, sslmode: str | None = None):
    """One connection with the setting, `sslmode` replacing its own, through
    the arguments the library connects with, to the store's session address."""
    import psycopg
    kwargs = setting.connect_kwargs()
    if sslmode is not None:
        kwargs["sslmode"] = sslmode
    return psycopg.connect(**kwargs, application_name="capabilities", connect_timeout=10)


def _store_probe(setting, sslmode: str | None = None) -> tuple[dict | None, str | None]:
    """Open one connection with the setting, `sslmode` replacing its own, and
    say what the server negotiated; or the reason it was not opened."""
    import psycopg
    try:
        conn = _store_connect(setting, sslmode)
    except psycopg.Error as exc:
        return None, _store_scrub(exc, setting)
    try:
        with conn.cursor() as cur:
            cur.execute("SELECT current_setting('server_version'), s.ssl, s.version, "
                        "s.cipher FROM pg_stat_ssl s WHERE s.pid = pg_backend_pid()")
            row = cur.fetchone()
    except psycopg.Error as exc:
        return {}, _store_scrub(exc, setting)
    finally:
        conn.close()
    if row is None:
        return {}, "the server did not report this connection in pg_stat_ssl"
    return {"server_version": row[0], "ssl": bool(row[1]),
            "tls": {"version": row[2], "cipher": row[3]}}, None


def _store_schema_check(setting) -> dict:
    """Whether the setting's role may use its schema: USAGE and CREATE on it
    when it exists, CREATE on the database when it does not yet, because the
    first migration creates it there."""
    import psycopg
    name = setting.schema
    out = {"ok": False, "name": name, "exists": None}
    try:
        conn = _store_connect(setting)
    except psycopg.Error as exc:
        out["reason"] = f"not checked: {_store_scrub(exc, setting)}"
        return out
    try:
        with conn.cursor() as cur:
            cur.execute(
                "SELECT current_user, current_database(), n.oid IS NOT NULL, "
                "n.oid IS NOT NULL AND has_schema_privilege(n.oid, 'USAGE'), "
                "n.oid IS NOT NULL AND has_schema_privilege(n.oid, 'CREATE'), "
                "has_database_privilege(current_database(), 'CREATE') "
                "FROM (SELECT 1) one LEFT JOIN pg_namespace n ON n.nspname = %s",
                (name,))
            user, database, exists, usage, create, create_db = cur.fetchone()
    except psycopg.Error as exc:
        out["reason"] = f"not checked: {_store_scrub(exc, setting)}"
        return out
    finally:
        conn.close()
    out["exists"] = bool(exists)
    if exists:
        missing = [p for p, held in (("USAGE", usage), ("CREATE", create)) if not held]
        out["ok"] = not missing
        out["reason"] = (f"role {user} may use and create in schema {name}" if not missing
                         else f"role {user} lacks {' and '.join(missing)} on schema {name}")
    else:
        out["ok"] = bool(create_db)
        out["reason"] = (f"schema {name} does not exist yet, and role {user} may create "
                         f"it in database {database}" if create_db
                         else f"schema {name} does not exist and role {user} may not "
                              f"create schemas in database {database}")
    return out


def _store_transaction_check(setting, plain_allowed: bool) -> dict:
    """Whether the store's transaction address works as the library uses it: a
    transaction connection opened there, over TLS unless the setting allows
    plain text, runs a transaction bound to the setting's schema. A store with
    one address has nothing more to prove."""
    if not setting.has_transaction_address:
        return {"ok": True, "skipped": True,
                "reason": "the store has one address: every connection uses it"}
    db = _db_module()
    import psycopg
    shown = setting.report().get("transaction") or {}
    out = {"ok": False, "host": shown.get("host"), "port": shown.get("port")}
    try:
        conn = db.connect(application_name="capabilities", setting=setting,
                          transaction=True)
    except db.DbError as exc:
        out["error"] = f"{exc.slug}: {_store_scrub(exc.message, setting)}"
        return out
    try:
        found = conn.execute("SELECT current_setting('search_path')").fetchone()[0]
        conn.rollback()
        tls = bool(conn.pgconn.ssl_in_use)
    except psycopg.Error as exc:
        out["error"] = _store_scrub(exc, setting)
        return out
    finally:
        conn.close()
    out["tls"] = tls
    if not tls and not plain_allowed:
        out["error"] = "the transaction address was reached without TLS"
        return out
    if found != setting.schema:
        out["error"] = (f"a transaction there was bound to {found!r}, not to the "
                        f"setting's schema {setting.schema!r}")
        return out
    out["ok"] = True
    out["reason"] = (f"a transaction connection there runs bound to schema "
                     f"{setting.schema}")
    return out


def _host_is_local(host: object) -> bool:
    """Whether the host is this machine, as the library judges it for the TLS
    rule: a Unix socket directory, `localhost` or a loopback address."""
    from capabilities_contract.db._setting import host_is_local
    return host_is_local(host)


def cmd_store_doctor(project: str | None) -> None:
    root = _db_store_project(project)
    report, setting, refused = _store_report(root)
    if setting is None and refused is None:
        _die(3, "no_store_setting",
             "no database is configured for this project or this machine",
             "set AGENTKIT_DB_URL or the AGENTKIT_DB_* keys in the project's .env.local "
             "or the process environment, or record the machine's with "
             "`capabilities store set`")
    if setting is None:
        _die(6, refused["code"], refused["message"], refused["hint"])
    shown = setting.report()
    params = shown.get("url") if setting.url is not None else shown
    host = (params or {}).get("host")
    sslmode = (params or {}).get("sslmode")
    # A database on this machine is not reached across a network, so whether
    # its server refuses plain text is not asked of it, and one set to sslmode
    # disable is proven by a working connection rather than by TLS. A URL
    # naming no host reaches the local socket.
    local = True if not host else _host_is_local(host)
    plain_allowed = sslmode == "disable"
    tls: dict = {"ok": False}
    found, error = _store_probe(setting)
    if found:
        tls.update({"server_version": found["server_version"], "tls": found["tls"]})
        tls["ok"] = (found["ssl"] or plain_allowed) and error is None
        if not found["ssl"]:
            if plain_allowed:
                tls["reason"] = ("sslmode disable: a database on this machine is "
                                 "reached without TLS")
            else:
                tls["error"] = "the connection was opened without TLS"
    if error:
        tls["error"] = error
    if local:
        plain = {"ok": True, "skipped": True,
                 "reason": "not checked: the database is on this machine "
                           f"({host or 'local socket'}), not reached across a network"}
    else:
        plain_found, plain_error = _store_probe(setting, sslmode="disable")
        if plain_found is not None:
            plain = {"ok": False,
                     "reason": "the server accepted a plain-text connection: its "
                               "pg_hba.conf lets a client in without TLS"}
        elif any(marker in plain_error for marker in STORE_PLAIN_REFUSAL_MARKERS):
            plain = {"ok": True, "reason": plain_error}
        else:
            plain = {"ok": False,
                     "reason": "the plain-text attempt failed, but not as a refusal "
                               f"for lacking TLS: {plain_error}"}
    if tls["ok"]:
        schema = _store_schema_check(setting)
    else:
        schema = {"ok": False, "name": setting.schema, "exists": None,
                  "reason": "not checked: no connection to the database"
                  if plain_allowed else "not checked: no TLS connection to the database"}
    transaction = _store_transaction_check(setting, plain_allowed)
    out = {"ok": tls["ok"] and plain["ok"] and schema["ok"] and transaction["ok"],
           "project": report["project"], "in_force": report["in_force"],
           "setting": report["setting"], "levels": report["levels"],
           "sslmode": sslmode, "db_schema": setting.schema,
           "checks": {"tls": tls, "plain_text_refused": plain, "schema": schema,
                      "transaction": transaction}}
    _emit(out)
    if not out["ok"]:
        sys.exit(7)


def _deny_rule(name: str) -> str:
    return f"Bash({name}:*)"


def _edit_deny(root: Path, name: str, add: bool) -> bool:
    """Add/remove the harness deny rule in .claude/settings.json. True if changed."""
    settings_file = root / ".claude" / "settings.json"
    settings = _read_json(settings_file)
    if settings is None:
        if not add:
            return False
        settings = {}
    perms = settings.setdefault("permissions", {})
    deny = perms.setdefault("deny", [])
    rule = _deny_rule(name)
    changed = False
    if add and rule not in deny:
        deny.append(rule)
        changed = True
    if not add and rule in deny:
        deny.remove(rule)
        changed = True
    if changed:
        _write_json(settings_file, settings)
    return changed


def _gate_scope(project: bool, global_: bool) -> str:
    if project == global_:
        _die(6, "scope_required",
             "choose exactly one policy scope: --project or --global",
             "ask the user whether this capability should change only for the "
             "current project or globally for every project")
    return "project" if project else "global"


def _gate_source(adapter, root: Path, scope: str) -> str:
    """Name the exact policy file, or the store's policy table in a project
    whose records are in the store."""
    if adapter.mode_of("policy") == "store":
        return adapter.scope_source("capabilities", "policy", scope)
    return str(_gate_file(root) if scope == "project" else GLOBAL_GATE_FILE)


def _gate_node(node: str | None, root: Path | None, adapter=None) -> str | None:
    """The node a policy write names, or None for every node. Only the store
    holds a row for one node: files carry no node."""
    if node is None:
        return None
    if not node.strip():
        _die(6, "input", "--node needs a node name")
    if root is None or adapter is None or adapter.mode_of("policy") != "store":
        _die(6, "node_requires_store",
             "a policy row naming a node is kept only in the store: this "
             "project's gate is in files, and files carry no node, so a "
             "record written there is for every node",
             "import this project's records into its store with `capabilities "
             "connections import`, then write the row for the node")
    return node.strip()


def _stamp_policy(adapter, root: Path, scope: str) -> None:
    """A project policy row in the store carries the project id as its agent,
    so it is written only once the id is verified for this invocation."""
    if scope == "project" and adapter.mode_of("policy") == "store":
        _project_id_for_write(root)


def _refresh_after_gate(root: Path | None, result: dict, enabled: bool = False) -> None:
    if root is None:
        return
    if _contextkit_managed(root):
        result["context"] = _contextkit_handoff(root, ["codex", "claude"])
        return
    refreshed = _refresh_context(root)
    if refreshed:
        result["context"] = refreshed
    elif enabled:
        result["context_hint"] = _project_visibility_hint(result.get("enabled"))


def _set_gate(name: str, enabled: bool, scope: str, deny: bool = False,
              node: str | None = None) -> None:
    root = _project_root()
    migrated: list[str] = []
    if scope == "project":
        root = _require_project()
        migrated = _ensure_envelope(root)
    elif deny:
        _die(6, "input", "--deny is available only with --project")
    if deny and node is not None:
        _die(6, "input", "--deny takes no --node: the harness deny rule is the "
             "project's on every node")
    if root is not None:
        adapter = _records_for(root)
        try:
            node = _gate_node(node, root, adapter)
            _stamp_policy(adapter, root, scope)
            adapter.set("capabilities", "policy", name, {"enabled": enabled},
                        actor="capabilities", scope=scope, node=node)
            gate_source = _gate_source(adapter, root, scope)
        except _store_module().StoreError as exc:
            _die(_store_error_exit(exc), exc.slug, exc.message, exc.hint)
        finally:
            adapter.close()
    else:
        _gate_node(node, None)
        gate_file = GLOBAL_GATE_FILE
        gate = _load_gate_file(gate_file)
        gate["capabilities"].setdefault(name, {})["enabled"] = enabled
        _write_json(gate_file, gate)
        gate_source = str(gate_file)
    result: dict = {("enabled" if enabled else "disabled"): name,
                    "scope": scope, "gate": gate_source}
    if node is not None:
        result["node"] = node
    if migrated:
        result["migrated_from"] = str(root / LEGACY_PROJECT_CAPABILITIES_REL)
    if scope == "project" and enabled:
        if _edit_deny(root, name, add=False):
            result["deny_rule_removed"] = _deny_rule(name)
    elif scope == "project" and deny:
        _edit_deny(root, name, add=True)
        result["deny_rule"] = _deny_rule(name)
    if name not in _installed():
        result["note"] = f"{name} is not installed — run `capabilities install {name}`"
    elif enabled and _machine_state(name) == "quarantined":
        result["machine"] = "quarantined"
        result["warning"] = (
            f"{name} is quarantined on this machine, so it stays disabled in "
            f"every project; ask the user whether to run `capabilities allow {name}`")
        _warn(result["warning"])
    _refresh_after_gate(root, result, enabled)
    _emit(result)


def _arrival_global_enable(name: str, undo: bool = False) -> dict | None:
    """Write the global enable a core capability arrives with, as the global
    policy row of the store (the row for every agent and every node), and say
    where it went. No file is written: where no database resolves, or it does
    not answer, nothing is written and the enable is reported pending, for the
    master's `install` (or `capabilities enable --global`) to write. A row the
    store already holds for it is the user's and is left as it is, so nothing
    is written and None is returned. `undo` removes the row again when the
    install that wrote it fails."""
    db = _db_module()
    store = _store_module()
    root = _project_root()
    pending = {"enabled": True, "pending": True,
               "hint": f"no database answered, so no gate was written: run `capabilities "
                       f"enable {name} --global` in an agent whose records are in the "
                       "store, on its master"}
    try:
        setting = db.resolve_setting(root)
        conn = db.connect(application_name=store.STORE_OWNER, setting=setting,
                          transaction=True)
    except db.DbError as exc:
        return None if undo else {**pending, "reason": exc.slug}
    import psycopg
    try:
        major, minor = store.STORE_TABLES_VERSION
        db.migrate(conn, store.STORE_OWNER, store.record_table_steps(), major=major,
                   minor=minor)
        with conn.transaction():
            if undo:
                conn.execute("DELETE FROM capabilities_policy WHERE agent_id IS NULL AND "
                             "capability = %s AND node IS NULL", (name,))
                return None
            held = conn.execute(
                "SELECT enabled FROM capabilities_policy WHERE agent_id IS NULL AND "
                "capability = %s AND node IS NULL", (name,)).fetchone()
            if held is not None:
                return None
            conn.execute("INSERT INTO capabilities_policy (agent_id, capability, node, "
                         "enabled) VALUES (NULL, %s, NULL, true)", (name,))
        return {"enabled": True, "gate": f"store:{setting.schema}.capabilities_policy"}
    except (db.DbError, psycopg.Error) as exc:
        if undo:
            return None
        return {**pending, "reason": getattr(exc, "slug", None) or "store_unreachable"}
    finally:
        conn.close()


def _inherit_gate(name: str, scope: str, node: str | None = None) -> None:
    root = _project_root()
    if scope == "project":
        root = _require_project()
        _ensure_envelope(root)
    if root is not None:
        adapter = _records_for(root)
        try:
            node = _gate_node(node, root, adapter)
            _stamp_policy(adapter, root, scope)
            removed = adapter.delete("capabilities", "policy", name, scope=scope,
                                     node=node)
            gate_source = _gate_source(adapter, root, scope)
        except _store_module().StoreError as exc:
            _die(_store_error_exit(exc), exc.slug, exc.message, exc.hint)
        finally:
            adapter.close()
    else:
        _gate_node(node, None)
        gate_file = GLOBAL_GATE_FILE
        gate = _load_gate_file(gate_file)
        removed = gate["capabilities"].pop(name, None) is not None
        _write_json(gate_file, gate)
        gate_source = str(gate_file)
    result = {"inherited": name, "scope": scope, "removed": removed,
              "gate": gate_source}
    if node is not None:
        result["node"] = node
    _refresh_after_gate(root, result)
    _emit(result)

# ---------------------------------------------------------------- context

def _md_escape(s: str) -> str:
    return s.replace("\n", " ").strip()


def _front_matter(source: Path | str) -> dict:
    """Parse the YAML front-matter envelope: name + description lines only."""
    try:
        text = source.read_text() if isinstance(source, Path) else source
    except OSError:
        return {}
    if not text.startswith("---"):
        return {}
    out: dict = {}
    for line in text.split("\n", 50)[1:]:
        if line.strip() == "---":
            break
        m = re.match(r"^(name|description):\s*(.+)$", line.strip())
        if m:
            out[m.group(1)] = m.group(2).strip()
    return out


def _context_references(adapter, root: Path, name: str) -> list[str]:
    """The on-demand reference menu lines for one capability."""
    refs = []
    for key in adapter.document_keys(name):
        if not key.startswith("reference."):
            continue
        doc = adapter.document_read(name, key)
        if not doc:
            continue
        fm = _front_matter(doc["body"])
        if not fm.get("name"):
            continue
        path = adapter.document_path(name, key)
        target = (str(path.relative_to(root)) if path is not None
                  and path.is_relative_to(root)
                  else f"{name} refs show {key.removeprefix('reference.')}")
        desc = fm.get("description", "")
        refs.append(f"- `{target}` — {desc}".rstrip(" —"))
    return refs


def _context_contribution(root: Path, name: str, manifest: dict | None) -> list[str]:
    """The block a capability's manifest declares after its stub line.

    Files only: the capability keeps the file rendered, so composing reads it
    and never a store. Whatever stops the read costs this block alone, which
    one line in its place names along with the verb that rebuilds it."""
    if "contribution" not in (manifest or {}):
        return []
    contribution = manifest["contribution"]
    problem = None
    if _validate_contribution(contribution):
        problem = "its manifest declaration is malformed"
    else:
        state = _project_capabilities_dir(root) / name / "state"
        path = state.parent / contribution["path"]
        limit = contribution["max_bytes"]
        try:
            if not path.resolve().is_relative_to(state.resolve()):
                problem = "its file resolves outside the capability's state folder"
            else:
                with path.open("rb") as handle:
                    raw = handle.read(limit + 1)
                if len(raw) > limit:
                    problem = f"its file exceeds the declared {limit} bytes"
                else:
                    text = raw.decode("utf-8").strip("\n").rstrip()
                    if not text.strip():
                        return []
                    marker = ([MEMORY_CONTRIBUTION_MARKER] if name == MEMORY_CAPABILITY
                              else [])
                    return [*marker, text, ""]
        except FileNotFoundError:
            problem = "its file has not been rendered"
        except (OSError, RuntimeError, UnicodeDecodeError, ValueError) as exc:
            problem = f"its file is unreadable: {_md_escape(str(exc))}"
    return [f"The context contribution of `{name}` is unavailable: {problem}. "
            f"`{name} render` rebuilds it.", ""]


# Set by `init` alone: its offline part (envelope, identity, host wiring) never
# needs the database, so where the project's gate is in a store this process
# cannot reach - an image built without one - the context file says so and is
# written again by `capabilities context` where the store is.
_CONTEXT_WITHOUT_STORE = False


def _store_absent(exc) -> bool:
    """Whether a store error says only that no store answers here - none is
    configured, it cannot be reached, or it is busy - rather than that the
    project's own records are wrong."""
    return exc.slug == "store_not_configured" or \
        exc.slug in _store_module().STORE_ENVIRONMENT_SLUGS


def _compose_context(root: Path) -> str:
    """Deterministic injection body: gate, snapshots, and resolved records."""
    if _CONTEXT_WITHOUT_STORE:
        try:
            _policy_scopes(root)
        except _store_module().StoreError as exc:
            if not _store_absent(exc):
                _die(_store_error_exit(exc), exc.slug, exc.message, exc.hint)
            return "\n".join([
                "# Capabilities", "", CONTEXT_BEGIN, "", CAPABILITIES_CONTEXT_INTRO, "",
                "This project keeps its gate in the store, which was not reachable when "
                f"this file was written ({exc.slug}); `capabilities context` writes it "
                "again where the store is, as the session-start hook does.", "",
                CONTEXT_END]) + "\n"
    project_caps, global_caps = _policy_views(root)
    names = set(project_caps) | set(global_caps)
    enabled = sorted(
        name for name in names
        if _effective_gate_state(name, project_caps.get(name), global_caps.get(name))[0]
        == "enabled")
    lines: list[str] = [
        "# Capabilities", "", CONTEXT_BEGIN, "",
        CAPABILITIES_CONTEXT_INTRO, "",
    ]
    if not enabled:
        lines += ["No capabilities are enabled in this project. "
                  "`capabilities list` shows what is installed; "
                  "ask whether the user wants `capabilities enable <name> "
                  "--project` for this project or `--global` for every project.", ""]
    else:
        lines += [_context_prompt(root), ""]
    adapter = _records_for(root)
    try:
        for name in enabled:
            stub, manifest = _load_snapshots(name)
            lines.append(f"## {name}")
            lines.append("")
            if stub is None:
                lines += [f"Enabled but not installed — run `capabilities install {name}`.", ""]
                continue
            lines += [_md_escape(stub), ""]
            lines += _context_contribution(root, name, manifest)
            try:
                ids = adapter.resolve(name, "identifier")
                refs = _context_references(adapter, root, name)
            except _store_module().StoreError as exc:
                # One unreadable capability must not cost the others their block.
                lines += [f"Project records for `{name}` are unavailable: "
                          f"{_md_escape(exc.message)}. `capabilities doctor` "
                          f"names the repair.", ""]
                continue
            bullet: list[str] = []
            if ids:
                bullet.append(f"- Identifiers ({len(ids)}): run `capabilities ids {name}` "
                              f"for the full labelled list; `{name} ids get <label>` "
                              f"for a single value")
            topics = ((manifest or {}).get("docs") or {}).get("topics") or []
            if topics:
                bullet.append(f"- Guides (`{name} guide <topic>`): " + ", ".join(sorted(topics)))
            service = (manifest or {}).get("service")
            if isinstance(service, dict):
                verbs = service.get("verbs") or []
                verb_hint = ", ".join(str(v) for v in verbs[:8])
                summary = service.get("summary") or service.get("name") or "bundled service"
                line = f"- Service (`{name} service ...`): {summary}"
                if verb_hint:
                    line += f" (verbs: {verb_hint})"
                bullet.append(line)
                bullet.append(SERVICE_SUPERVISION_POINTER + (
                    f"start at `{SERVICE_SUPERVISION_CAPABILITY} help`."
                    if _registry_dir(SERVICE_SUPERVISION_CAPABILITY).is_dir()
                    else "it is not installed here."))
            if refs:
                if bullet:
                    bullet.append("")
                bullet.append("**References** (load on demand):")
                bullet.append("")
                bullet.extend(refs)
            if bullet:
                lines += bullet + [""]
    finally:
        adapter.close()
    lines.append(CONTEXT_END)
    return "\n".join(lines) + "\n"


def _refresh_context(root: Path) -> dict | None:
    """Regenerate placed context files that already exist. Quiet otherwise."""
    if _contextkit_managed(root):
        return None
    out = {}
    for host, rel in (("claude", CLAUDE_CAPABILITIES_REL),
                      ("codex", CODEX_CAPABILITIES_REL)):
        if (root / rel).exists():
            out[host] = str(_write_host_context(root, host)["path"])
    return out or None


def _write_host_context(root: Path, host: str) -> dict:
    """Rebuild one host's capabilities file and say how it differs from before.

    What was on disk before this rebuild is what a starting session loaded,
    so `created` and `changed` are exactly what that session must be told.
    """
    target = root / (CLAUDE_CAPABILITIES_REL if host == "claude"
                     else CODEX_CAPABILITIES_REL)
    try:
        before = target.read_text()
    except FileNotFoundError:
        before = None
    body = _compose_context(root)
    if body != before:
        _atomic_write_text(target, body)
    return {"path": target, "created": before is None,
            "changed": before is not None and body != before}


def _id_value(v) -> str:
    """A string inlines bare; anything else as compact JSON — both in a code span."""
    return f"`{v}`" if isinstance(v, str) else "`" + json.dumps(v, ensure_ascii=False) + "`"


def cmd_ids(name: str) -> None:
    """Render <name>'s project identifiers envelope as markdown.

    The full labelled list the session context points to: the manager renders
    the standard `{label: {value, note}}` envelope without the capability's
    help (DOCTRINE rule 4). `<name> ids get/set/rm` stays the per-value data
    interface on the capability itself.
    """
    root = _require_project()
    adapter = _records_for(root)
    try:
        resolved = adapter.resolve(name, "identifier")
    except _store_module().StoreError as exc:
        _die(_store_error_exit(exc), exc.slug, exc.message, exc.hint)
    finally:
        adapter.close()
    ids = {label: {"value": row["value"], "note": row["note"] or ""}
           for label, row in resolved.items()}
    if not ids:
        _emit(f"# {name} identifiers\n\n"
              f"None recorded for `{name}` in this project ({root}). The CLI "
              f"discovers and writes them with `{name} ids set <label> <value>`.")
        return
    lines = [f"# {name} identifiers", "",
             f"Structural lookups for `{name}` in this project ({root}). "
             f"Fetch a single raw value with `{name} ids get <label>`.", ""]
    for label, entry in sorted(ids.items()):
        entry = entry if isinstance(entry, dict) else {"value": entry}
        line = f"- **{label}**: {_id_value(entry.get('value'))}"
        note = entry.get("note")
        if note:
            line += f" — {note}"
        lines.append(line)
    _emit("\n".join(lines) + "\n")


def cmd_get(name: str, collection: str, key: str) -> None:
    """Read one resolved record through the same adapter capabilities use. In
    store mode a grant also says which node it names (null for every node) and
    whether it is the default pointer."""
    root = _require_project()
    adapter = _records_for(root)
    try:
        value = adapter.get(name, collection, key)
        if value is None:
            _die(3, "not_found", f"no resolved {name}/{collection}/{key}")
        _emit(value)
    except _store_module().StoreError as exc:
        _die(_store_error_exit(exc), exc.slug, exc.message, exc.hint)
    finally:
        adapter.close()


def cmd_set(name: str, collection: str, key: str,
            raw: str, note: str | None) -> None:
    """Write a human-owned project record without exposing a backend choice."""
    if collection not in {"connection", "grant", "setting"}:
        _die(6, "record_writer",
             f"capabilities set does not own collection {collection!r}",
             "writable here: connection, grant, setting; use policy, ids, or "
             "context verbs for their owned collections")
    try:
        value = json.loads(raw)
    except ValueError:
        value = raw
    root = _require_project()
    adapter = _records_for(root)
    try:
        in_store = adapter.mode_of(collection, key) == "store"
        if in_store:
            # A store row carries the project id as its agent, so the write
            # takes the id only once it is verified for this invocation.
            _project_id_for_write(root)
        adapter.set(name, collection, key, value,
                    actor="capabilities set", note=note)
        _emit({"set": {"capability": name, "collection": collection,
                       "key": key, "value": value},
               "records": {"mode": adapter.mode_of(collection, key),
                           "source": (adapter.collection_source(
                               name, "grant" if collection == "setting"
                               and key == "connection.default" else collection)
                               if in_store else adapter.source)}})
    except _store_module().StoreError as exc:
        _die(_store_error_exit(exc), exc.slug, exc.message, exc.hint)
    finally:
        adapter.close()


# ---------------------------------------------------------------- connections import

class _ImportRefused(Exception):
    def __init__(self, code: str, message: str, hint: str | None = None):
        super().__init__(message)
        self.code, self.message, self.hint = code, message, hint


def _import_names(envelope: Path) -> list[str]:
    """The capabilities whose connections this project's files can resolve:
    each one its envelope keeps a registry for, and each installed one the
    user's config home keeps a registry for."""
    store = _store_module()
    names: set[str] = set()
    if envelope.is_dir():
        for path in envelope.glob("*/connections.json"):
            names.add(path.parent.name)
    for name in _installed():
        if (_CONFIG_HOME / name / "connections.json").is_file():
            names.add(name)
    return sorted(n for n in names if store.CAPABILITY_RE.fullmatch(n))


def _import_gate(files) -> dict[str, bool]:
    """Whether each installed capability is enabled for this project as its
    files resolve the gate, under the machine ceiling."""
    scopes = {scope: {name: row["value"] for name, row in
                      files.resolve_scope("capabilities", "policy", scope).items()}
              for scope in ("project", "global")}
    return {name: _effective_gate_state(name, scopes["project"].get(name),
                                        scopes["global"].get(name))[0] == "enabled"
            for name in set(_installed()) | set(scopes["project"]) | set(scopes["global"])}


def _import_plan(files, names: list[str]) -> dict:
    """What the store must hold for this project to resolve from it what its
    files resolve for the connections it uses: per capability every identity
    its envelope declares, and an identity of the config home only where the
    capability is enabled for the project and the project may use that
    identity or points its default at it. Each one written gets an every-node
    grant where the project may use it, switched it off itself, or points its
    default at it. A grant carries the decision its fields resolved to across
    the files' scopes, and leaves a field no scope decided null, so
    `allow_write` still falls to WRITE_DEFAULT. A config-home identity the
    project does not use is returned beside the plan as skipped and never
    written; `specs` and `held` keep every identity and grant the files
    resolve, so a row an earlier import wrote is recognised as unchanged
    rather than taken for a conflict."""
    store = _store_module()
    plan: dict = {}
    skipped_by: dict[str, list[str]] = {}
    problems: list[str] = []
    try:
        gate = _import_gate(files)
    except (store.StoreError, AttributeError, TypeError) as exc:
        raise _ImportRefused(
            "import_unreadable",
            "this project's files cannot be imported as they resolve today: policy: "
            + str(getattr(exc, "message", exc)),
            "repair them (`capabilities doctor` names the faults), then import again")
    for name in names:
        try:
            identities = files.resolve(name, "connection")
            layers = files.config_layers(name, "grant")
            effective = files.connections(name, include_disabled=True)
            default = files.get(name, "setting", "connection.default")
        except store.StoreError as exc:
            problems.append(f"{name}: {exc.message}")
            continue
        if not identities:
            continue
        connections, grants, held, specs, skipped = {}, {}, {}, {}, []
        for cid, row in sorted(identities.items()):
            if not isinstance(row["value"], dict):
                problems.append(f"{name}: connection {cid!r} is not an object")
                continue
            decided, decided_at = store._grant_decisions(
                cid, [layer[cid] for layer in layers if cid in layer])
            allow_write = decided.get("allow_write")
            if allow_write is not None and not isinstance(allow_write, bool):
                problems.append(f"{name}: grant {cid!r} allow_write is not boolean")
                continue
            enabled = bool(effective[cid]["enabled"])
            specs[cid] = row["value"]
            switched_off = not enabled and (row["scope"] == "project"
                                            or decided_at.get("enabled") == "project")
            grant = None
            if enabled or switched_off or cid == default:
                grant = {"enabled": True if enabled else (False if switched_off else None),
                         "allow_write": allow_write, "is_default": cid == default}
                held[cid] = grant
            used = row["scope"] == "project" or (
                gate.get(name, False) and (enabled or cid == default))
            if not used:
                skipped.append(cid)
                continue
            connections[cid] = row["value"]
            if grant is not None:
                grants[cid] = grant
        if default is not None and default not in identities:
            problems.append(f"{name}: the default points to {default!r}, which no "
                            "connection declares")
        if skipped:
            skipped_by[name] = skipped
        if connections:
            plan[name] = {"connections": connections, "grants": grants,
                          "default": default, "specs": specs, "held": held}
    if problems:
        raise _ImportRefused(
            "import_unreadable",
            "this project's files cannot be imported as they resolve today: "
            + "; ".join(problems),
            "repair them (`capabilities doctor` names the faults), then import again")
    return plan, skipped_by


def _import_rows(conn, agent_id: str, plan: dict) -> dict:
    """Write what the store lacks of the connections this project uses, inside
    the caller's transaction, and refuse the whole import where a row the store
    already holds differs from what the files resolve, or where this project
    already holds a grant the files do not."""
    result: dict = {}
    conflicts: list[str] = []
    writes: list[tuple[str, tuple]] = []
    for name, wanted in plan.items():
        held = dict(conn.execute(
            "SELECT name, spec FROM capabilities_connections WHERE capability = %s",
            (name,)).fetchall())
        grants = {(cid, node): (enabled, allow_write, bool(is_default))
                  for cid, node, enabled, allow_write, is_default in conn.execute(
                      "SELECT connection, node, enabled, allow_write, is_default "
                      "FROM capabilities_connection_grants "
                      "WHERE agent_id = %s AND capability = %s", (agent_id, name)).fetchall()}
        report = {"connections": {"imported": [], "unchanged": []},
                  "grants": {"imported": [], "unchanged": []},
                  "default": wanted["default"]}
        for cid, spec in wanted["specs"].items():
            if cid not in held:
                if cid not in wanted["connections"]:
                    continue
                writes.append((
                    "INSERT INTO capabilities_connections (capability, name, spec) "
                    "VALUES (%s, %s, %s::jsonb)",
                    (name, cid, json.dumps(spec, ensure_ascii=False))))
                report["connections"]["imported"].append(cid)
            elif held[cid] == spec:
                report["connections"]["unchanged"].append(cid)
            else:
                conflicts.append(f"{name} connection {cid!r}: the store holds "
                                 f"{json.dumps(held[cid], sort_keys=True)}, the files "
                                 f"{json.dumps(spec, sort_keys=True)}")
        for cid, grant in wanted["held"].items():
            row = (grant["enabled"], grant["allow_write"], grant["is_default"])
            found = grants.pop((cid, None), None)
            if found is None:
                if cid not in wanted["grants"]:
                    continue
                writes.append((
                    "INSERT INTO capabilities_connection_grants (agent_id, capability, "
                    "connection, node, enabled, allow_write, is_default) "
                    "VALUES (%s, %s, %s, NULL, %s, %s, %s)", (agent_id, name, cid, *row)))
                report["grants"]["imported"].append(cid)
            elif found == row:
                report["grants"]["unchanged"].append(cid)
            else:
                conflicts.append(
                    f"{name} grant {cid!r} for every node: the store holds enabled="
                    f"{found[0]}, allow_write={found[1]}, is_default={found[2]}; the "
                    f"files resolve enabled={row[0]}, allow_write={row[1]}, "
                    f"is_default={row[2]}")
        for (cid, node), _row in sorted(grants.items(), key=lambda item: (item[0][0], item[0][1] or "")):
            conflicts.append(f"{name} grant {cid!r} for "
                             f"{'node ' + repr(node) if node else 'every node'}: the store "
                             "holds it and the files do not")
        result[name] = report
    if conflicts:
        raise _ImportRefused(
            "import_conflict",
            f"the store already holds {len(conflicts)} row(s) that differ from what "
            "this project's files resolve, and nothing was written: "
            + "; ".join(conflicts),
            "reconcile them - change the store row with `capabilities set`, or the "
            "files - and import again")
    for query, params in writes:
        conn.execute(query, params)
    return result


def _import_verify(files, stored, plan: dict) -> None:
    """The import holds only if the store now resolves, for this project on this
    node, the connections its files resolve among those the store holds - every
    one the plan writes, and any an earlier import left: the same usable
    entries, with the same values and writability under either WRITE_DEFAULT,
    the same withheld ones, and the same default pointer where the store holds
    the connection it names."""
    for name, wanted in plan.items():
        present: set = set(wanted["connections"])
        for write_default in (False, True):
            before = files.connections(name, write_default=write_default,
                                       include_disabled=True)
            after = stored.connections(name, write_default=write_default,
                                       include_disabled=True)
            present |= set(after)
            usable_before = {cid: (e["value"], e["allow_write"])
                             for cid, e in before.items() if e["enabled"] and cid in present}
            usable_after = {cid: (e["value"], e["allow_write"])
                            for cid, e in after.items() if e["enabled"]}
            withheld_after = {cid for cid, e in after.items() if not e["enabled"]}
            withheld_before = {cid for cid, e in before.items()
                               if not e["enabled"] and cid in present}
            if usable_before != usable_after or not withheld_before <= withheld_after:
                raise _ImportRefused(
                    "import_mismatch",
                    f"after the import the store would resolve {name}'s connections "
                    "differently from the files, so nothing was written",
                    "report this as a defect in `capabilities connections import`")
        default = files.get(name, "setting", "connection.default")
        if ((default if default in present else None)
                != stored.get(name, "setting", "connection.default")):
            raise _ImportRefused(
                "import_mismatch",
                f"after the import the store would point {name}'s default elsewhere "
                "than the files, so nothing was written",
                "report this as a defect in `capabilities connections import`")


def _import_identifier_names(envelope: Path) -> list[str]:
    """The capabilities whose identifiers this project's files can resolve:
    each one its envelope keeps identifiers for, and each installed one the
    user's config home keeps identifiers for."""
    store = _store_module()
    names: set[str] = set()
    if envelope.is_dir():
        for path in envelope.glob("*/identifiers.json"):
            names.add(path.parent.name)
    for name in _installed():
        if (_CONFIG_HOME / name / "identifiers.json").is_file():
            names.add(name)
    return sorted(n for n in names if store.CAPABILITY_RE.fullmatch(n))


def _import_records_plan(files, names: list[str]) -> dict:
    """The identifiers and policy rows the store must hold for this project to
    resolve from it what its files resolve: each scope's own entries, the
    project's under its id and the config home's as global rows."""
    store = _store_module()
    problems: list[str] = []
    identifiers: dict = {}
    for name in names:
        try:
            scopes = {scope: {label: (row["value"], row["note"] or "")
                              for label, row in files.resolve_scope(
                                  name, "identifier", scope).items()}
                      for scope in ("project", "global")}
        except (store.StoreError, AttributeError, TypeError) as exc:
            problems.append(f"{name} identifiers: {getattr(exc, 'message', exc)}")
            continue
        if scopes["project"] or scopes["global"]:
            identifiers[name] = scopes
    policy: dict = {}
    for scope in ("project", "global"):
        try:
            rows = files.resolve_scope("capabilities", "policy", scope)
        except store.StoreError as exc:
            problems.append(f"{scope} policy: {exc.message}")
            continue
        policy[scope] = {}
        for name, row in rows.items():
            value = row["value"]
            if (not isinstance(value, dict) or set(value) != {"enabled"}
                    or not isinstance(value.get("enabled"), bool)):
                problems.append(f"{scope} policy for {name!r} is not "
                                '{"enabled": true|false}')
                continue
            policy[scope][name] = value["enabled"]
    if problems:
        raise _ImportRefused(
            "import_unreadable",
            "this project's files cannot be imported as they resolve today: "
            + "; ".join(problems),
            "repair them (`capabilities doctor` names the faults), then import again")
    return {"identifiers": identifiers, "policy": policy}


def _import_record_rows(conn, agent_id: str, node: str, plan: dict) -> dict:
    """Write the identifiers and policy rows the store lacks, inside the
    caller's transaction. Refuse the whole import where a row the store holds
    differs from what the import would write, where this project holds a row
    the files do not, or where a global row the files do not have would apply
    to this project."""
    agent_of = {"project": agent_id, "global": None}
    conflicts: list[str] = []
    writes: list[tuple[str, tuple]] = []

    def scope_of(agent):
        return "global" if agent is None else "project"

    held_ids = {(scope_of(agent), cap, label): (value, note or "")
                for agent, cap, label, value, note in conn.execute(
                    "SELECT agent_id, capability, label, value, note "
                    "FROM capabilities_identifiers "
                    "WHERE agent_id IS NULL OR agent_id = %s", (agent_id,)).fetchall()}
    identifiers: dict = {}
    for cap, scopes in plan["identifiers"].items():
        report = identifiers[cap] = {}
        for scope, labels in scopes.items():
            done = report[scope] = {"imported": [], "unchanged": []}
            for label, wanted in sorted(labels.items()):
                found = held_ids.get((scope, cap, label))
                if found is None:
                    writes.append((
                        "INSERT INTO capabilities_identifiers "
                        "(agent_id, capability, label, value, note) "
                        "VALUES (%s, %s, %s, %s::jsonb, %s)",
                        (agent_of[scope], cap, label,
                         json.dumps(wanted[0], ensure_ascii=False), wanted[1])))
                    done["imported"].append(label)
                elif found == wanted:
                    done["unchanged"].append(label)
                else:
                    conflicts.append(
                        f"{cap} {scope} identifier {label!r}: the store holds "
                        f"{json.dumps({'value': found[0], 'note': found[1]}, sort_keys=True)}, "
                        f"the files {json.dumps({'value': wanted[0], 'note': wanted[1]}, sort_keys=True)}")
    for (scope, cap, label) in sorted(held_ids):
        wanted = plan["identifiers"].get(cap, {"project": {}, "global": {}})
        if label in wanted[scope]:
            continue
        if scope == "project":
            conflicts.append(f"{cap} project identifier {label!r}: the store holds "
                             "it and the files do not")
        elif label not in wanted["project"]:
            conflicts.append(f"{cap} global identifier {label!r}: the store holds "
                             "it for every project and this project's files do not "
                             "resolve it")

    held_policy = {(scope_of(agent), cap, row_node): enabled
                   for agent, cap, row_node, enabled in conn.execute(
                       "SELECT agent_id, capability, node, enabled "
                       "FROM capabilities_policy "
                       "WHERE agent_id IS NULL OR agent_id = %s", (agent_id,)).fetchall()}
    policy: dict = {}
    for scope in ("project", "global"):
        done = policy[scope] = {"imported": [], "unchanged": []}
        for cap, enabled in sorted(plan["policy"].get(scope, {}).items()):
            found = held_policy.get((scope, cap, None))
            if found is None:
                writes.append((
                    "INSERT INTO capabilities_policy (agent_id, capability, node, enabled) "
                    "VALUES (%s, %s, NULL, %s)", (agent_of[scope], cap, enabled)))
                done["imported"].append(cap)
            elif found == enabled:
                done["unchanged"].append(cap)
            else:
                conflicts.append(f"{cap} {scope} policy for every node: the store holds "
                                 f"enabled={found}, the files enabled={enabled}")
    for (scope, cap, row_node) in sorted(held_policy,
                                         key=lambda k: (k[0], k[1], k[2] or "")):
        where = f"node {row_node!r}" if row_node else "every node"
        if scope == "project":
            if row_node is None and cap in plan["policy"].get("project", {}):
                continue
            conflicts.append(f"{cap} project policy for {where}: the store holds it "
                             "and the files do not")
        elif row_node in (None, node) and cap not in plan["policy"].get("project", {}) \
                and (cap not in plan["policy"].get("global", {}) if row_node is None
                     else held_policy[(scope, cap, row_node)]
                     != plan["policy"].get("global", {}).get(cap)):
            conflicts.append(f"{cap} global policy for {where}: the store holds it for "
                             "every project and this project's files do not decide it")
    if conflicts:
        raise _ImportRefused(
            "import_conflict",
            f"the store already holds {len(conflicts)} row(s) that differ from what "
            "this project's files resolve, and nothing was written: "
            + "; ".join(conflicts),
            "reconcile them - change the store row (`<name> ids set`, `capabilities "
            "enable|disable|inherit`), or the files - and import again")
    for query, params in writes:
        conn.execute(query, params)
    return {"identifiers": identifiers, "policy": policy}


def _import_records_verify(files, stored, plan: dict) -> None:
    """The import holds only if the store now resolves, for this project on
    this node, the identifiers and the gate its files resolve, each from the
    same scope."""
    def identifiers(records, cap):
        return {label: (row["value"], row["note"] or "", row["scope"])
                for label, row in records.resolve(cap, "identifier").items()}

    def gate(records):
        return {name: (row["value"], row["scope"])
                for name, row in records.resolve("capabilities", "policy").items()}

    for cap in plan["identifiers"]:
        if identifiers(files, cap) != identifiers(stored, cap):
            raise _ImportRefused(
                "import_mismatch",
                f"after the import the store would resolve {cap}'s identifiers "
                "differently from the files, so nothing was written",
                "report this as a defect in `capabilities connections import`")
    if gate(files) != gate(stored):
        raise _ImportRefused(
            "import_mismatch",
            "after the import the store would resolve the policy gate differently "
            "from the files, so nothing was written",
            "report this as a defect in `capabilities connections import`")


def cmd_connections_import() -> None:
    """Import this project's records - connections, grants, identifiers and
    policy - from its files into its store and move the project to store mode,
    as one decision: the rows are written and checked to resolve as the files
    do in one transaction, and only then does project.json say `records:
    store`. A row the store already holds unchanged is left as it is, so a
    second run changes nothing; one that differs refuses the whole import."""
    _read_only_gate("connections import")
    store = _store_module()
    root = _require_project()
    envelope = _project_capabilities_dir(root)
    identity_file = envelope / PROJECT_IDENTITY_REL
    identity = _read_json(identity_file)
    if not isinstance(identity, dict):
        _die(6, "no_project_identity", f"{identity_file} is missing or unreadable",
             "run `capabilities init` in the project")
    agent_id = _project_id_for_write(root)
    if not agent_id:
        _die(6, "no_project_identity", f"{identity_file} carries no project id",
             "run `capabilities init` in the project to mint its identity")
    try:
        previous = ("store" if store.records_mode(envelope) == "store"
                    else "connections" if store.connections_mode(envelope) == "store"
                    else "files")
    except store.StoreError as exc:
        _die(6, exc.slug, exc.message, exc.hint)
    files = store.FileRecords(envelope, _CONFIG_HOME, agent_id, identity.get("slug"))
    names = _import_names(envelope)
    node = store.node_name()
    db = _db_module()
    try:
        setting = db.resolve_setting(root)
        conn = db.connect(application_name=store.STORE_OWNER, setting=setting,
                          transaction=True)
    except db.DbError as exc:
        _die(_store_error_exit(exc), exc.slug, exc.message, exc.hint)
    import psycopg
    try:
        plan, skipped = _import_plan(files, names)
        records_plan = _import_records_plan(files, _import_identifier_names(envelope))
        major, minor = store.STORE_TABLES_VERSION
        db.migrate(conn, store.STORE_OWNER, store.record_table_steps(),
                   major=major, minor=minor)
        with conn.transaction():
            # One import at a time per store, so two cannot both find a row
            # missing and both write it.
            conn.execute("LOCK TABLE capabilities_connections, "
                          "capabilities_connection_grants, capabilities_identifiers, "
                          "capabilities_policy IN SHARE ROW EXCLUSIVE MODE")
            imported = _import_rows(conn, agent_id, plan)
            records_imported = _import_record_rows(conn, agent_id, node, records_plan)
            stored = store.StoreRecords(envelope, _CONFIG_HOME, agent_id,
                                        identity.get("slug"), project_root=root,
                                        connection=conn, schema=setting.schema)
            _import_verify(files, stored, plan)
            _import_records_verify(files, stored, records_plan)
    except _ImportRefused as exc:
        _die(6 if exc.code != "import_mismatch" else 7, exc.code, exc.message, exc.hint)
    except store.StoreError as exc:
        _die(_store_error_exit(exc), exc.slug, exc.message, exc.hint)
    except db.DbError as exc:
        _die(_store_error_exit(exc), exc.slug, exc.message, exc.hint)
    except psycopg.OperationalError as exc:
        _die(5, "store_unreachable", f"cannot reach the store: {exc}",
             "check the database setting with `capabilities store doctor`")
    except psycopg.Error as exc:
        _die(5, "store_write_failed", f"importing into the store failed: {exc}")
    finally:
        conn.close()
    if previous != "store":
        identity = _read_json(identity_file) or identity
        identity[store.RECORDS_MODE_KEY] = "store"
        identity.pop(store.CONNECTIONS_MODE_KEY, None)
        _write_json(identity_file, identity)
    kept = [*envelope.glob("*/connections.json"), *envelope.glob("*/identifiers.json")]
    if (envelope / "settings.json").is_file():
        kept.append(envelope / "settings.json")
    _emit({"ok": True, "project": str(root), "agent_id": agent_id,
           "node": node, "mode": "store", "previous_mode": previous,
           "identity": str(identity_file),
           "store": {"level": setting.level, "sources": list(setting.sources),
                     "schema": setting.schema,
                     "tables": [store.STORE_CONNECTIONS_TABLE, store.STORE_GRANTS_TABLE,
                                store.STORE_IDENTIFIERS_TABLE, store.STORE_POLICY_TABLE]},
           "capabilities": imported,
           "skipped": skipped,
           "identifiers": records_imported["identifiers"],
           "policy": records_imported["policy"],
           "files_kept": sorted(str(p) for p in kept)})


# ---------------------------------------------------------------- migrate

# `capabilities migrate` moves one agent's file-held configuration into the
# store, on the agent's master node, by deliberate action: a dry run that
# writes nothing and lists every question code cannot answer; a write under
# the agent's `migrating_since` freeze; a verify that reads everything back
# through the store and compares it both ways with what the files resolved
# to; and a finalize that switches the agent with `migrated_at`, writes
# "records": "store", archives what git does not hold, removes the files and
# resumes the services it stopped. A journal per agent in the state home
# drives a run that was interrupted to its end.
MIGRATE_ACTOR = "migrate"
MIGRATE_JOURNAL_SCHEMA = "capabilities.migrate-journal.v1"
# Settings a capability kept beside its declared project home, folded into
# that home's document as it moves: tasks' conveyor.toml becomes the
# `escalation` table of the tasks settings, slack's policy.json the allow-list
# of the slack settings. Each names the file, its format, and the home the
# capability declares, for a capability whose manifest is not at hand.
MIGRATE_FOLDED_SETTINGS = {
    "slack": {"file": "policy.json", "format": "json",
              "home": {"scope": "project", "path": "service/settings.json", "format": "json"}},
    "tasks": {"file": "conveyor.toml", "format": "toml",
              "home": {"scope": "project", "path": "service/config.toml", "format": "toml",
                       "seed": {"version": 1}}},
}
# The allow-list keys of slack's policy.json, and the mode each falls back to
# where a document leaves it out.
MIGRATE_SLACK_MODES = {"default_channel_policy": "allowed_only",
                       "direct_messages.mode": "allowed_users"}
MIGRATE_SLACK_LISTS = ("allowed_users", "allowed_channels")
# The marker of a payload stamped with the contract that carries `migrate files`.
MIGRATE_CONTRACT_MARKER = "def _cmd_migrate_files("
MIGRATE_MOVER_TIMEOUT = 600
MIGRATE_SERVICE_TIMEOUT = 120
# What a host path in a settings value looks like: it names one machine's disk.
MIGRATE_HOST_PATH = re.compile(r"^(?:/Users/|/home/|/Volumes/|/private/|~/)")
# Text a consumer that reads a record or settings file directly carries.
MIGRATE_CONSUMER_PATTERNS = ("connections.json", "identifiers.json", "service/settings.json",
                             "service/config.toml", "conveyor.toml", "migrate-profiles",
                             "connections import", "workers import", "profiles import",
                             "automations import")
MIGRATE_CONSUMER_SUFFIXES = (".py", ".md", ".toml", ".sh", ".swift", ".ts", ".js",
                             ".yaml", ".yml")
MIGRATE_CONSUMER_SKIP = (".git", "node_modules", ".venv", "venv", "__pycache__",
                         ".contextkit", "dist", "build", "_tmp")
MIGRATE_HISTORICAL_DIRS = ("assets", "memory", "snapshots")
MIGRATE_HISTORICAL_NAMES = ("CHANGELOG", "CHANGES", "HISTORY")


class _MigrateRefusal(Exception):
    def __init__(self, code: str, message: str, hint: str | None = None,
                 exit_code: int = 6, detail: dict | None = None):
        super().__init__(message)
        self.code, self.message, self.hint = code, message, hint
        self.exit_code, self.detail = exit_code, detail or {}


def _migrate_refuse(exc: "_MigrateRefusal", answer: dict | None = None) -> NoReturn:
    """A refusal on stderr in the error envelope, carrying what the run found
    so far, so a person sees why and what remains."""
    body = {"code": exc.code, "message": exc.message}
    if exc.hint:
        body["hint"] = exc.hint
    if exc.detail:
        body["detail"] = exc.detail
    if answer is not None:
        body["report"] = answer
    sys.stderr.write(json.dumps({"error": body}, ensure_ascii=False, default=str) + "\n")
    sys.exit(exc.exit_code)


def _migrate_home(agent_id: str | None = None) -> Path:
    base = _STATE_HOME / "capabilities" / "migrate"
    return base / agent_id if agent_id else base


def _migrate_journal(agent_id: str) -> dict | None:
    found = _read_json(_migrate_home(agent_id) / "journal.json")
    return found if isinstance(found, dict) else None


def _migrate_journal_save(agent_id: str, journal: dict) -> None:
    path = _migrate_home(agent_id) / "journal.json"
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    journal["updated_at"] = _utc_now()
    tmp = path.with_name(f".journal.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(journal, ensure_ascii=False, indent=2, sort_keys=True,
                              default=str) + "\n")
    tmp.chmod(0o600)
    tmp.replace(path)


def _utc_now() -> str:
    import datetime as _dt
    return _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _migrate_options(args: list[str]) -> dict:
    opts: dict = {"roots": []}
    flags = {"--dry-run": "dry_run", "--apply": "apply", "--global": "global",
             "--discard": "discard", "--report": "report", "--json": "json"}
    i = 0
    while i < len(args):
        arg = args[i]
        name, eq, value = arg.partition("=")
        if arg in flags:
            opts[flags[arg]] = True
        elif name in ("--answers", "--root"):
            if not eq:
                if i + 1 >= len(args):
                    _die(6, "input", f"{name} needs a value")
                value, i = args[i + 1], i + 1
            if name == "--answers":
                if "answers" in opts:
                    _die(6, "input", "--answers given twice")
                opts["answers"] = value
            else:
                opts["roots"].append(value)
        else:
            _die(6, "input", f"`capabilities migrate` does not take {arg}",
                 "capabilities migrate [--dry-run|--apply] [--answers FILE] | --global "
                 "[--dry-run|--apply] [--answers FILE] | --discard | --report [--root PATH]")
        i += 1
    modes = [m for m in ("global", "discard", "report") if opts.get(m)]
    if len(modes) > 1:
        _die(6, "input", f"--{modes[0]} and --{modes[1]} are separate runs")
    if opts.get("dry_run") and opts.get("apply"):
        _die(6, "input", "--dry-run and --apply are opposites; give one")
    if (opts.get("discard") or opts.get("report")) and (opts.get("apply") or opts.get("answers")):
        _die(6, "input", "--discard and --report take no --apply or --answers")
    return opts


def _migrate_answers(path: str | None) -> dict:
    if not path:
        return {}
    try:
        found = json.loads(Path(path).expanduser().read_text())
    except (OSError, ValueError) as exc:
        _die(6, "input", f"cannot read the answers file {path}: {exc}")
    if not isinstance(found, dict):
        _die(6, "input", f"the answers file {path} must hold a JSON object")
    return found


def _migrate_dig(answers: dict, dotted: str):
    """One answer by the dotted id its question names; a key that itself holds
    a dot is matched whole at its level."""
    here = answers
    parts = dotted.split(".")
    i = 0
    while i < len(parts):
        if not isinstance(here, dict):
            return None
        for j in range(len(parts), i, -1):
            key = ".".join(parts[i:j])
            if key in here:
                here, i = here[key], j
                break
        else:
            return None
    return here


# --- where an agent's files are ---------------------------------------------------

def _migrate_body_envelope(root: Path) -> Path:
    """The envelope a root keeps, read through its body root without asking
    any program: `[body] root` of .contextkit/config.toml, else the root."""
    try:
        import tomllib
        config = tomllib.loads((root / CONTEXTKIT_CONFIG_REL).read_text())
        body = (config.get("body") or {}).get("root")
    except (OSError, ValueError, AttributeError):
        body = None
    base = root / body if isinstance(body, str) and body.strip() else root
    return base / PROJECT_CAPABILITIES_REL


def _migrate_root_id(envelope: Path, root: Path) -> str | None:
    identity = _read_json(envelope / PROJECT_IDENTITY_REL)
    found = str((identity or {}).get("id") or "").strip() if isinstance(identity, dict) else ""
    return found or _contextkit_config_id(root)


MIGRATE_SCAN_DEPTH = 3
MIGRATE_SCAN_SKIP = ("node_modules", "venv", "__pycache__", "Library", "dist", "build")


def _migrate_scan(base: Path, depth: int = MIGRATE_SCAN_DEPTH) -> list[Path]:
    """Every directory under `base`, `depth` levels down at most, that holds
    an envelope's gate or identity or a ContextKit binding: a root that may
    read this machine's config home."""
    out = []
    if depth <= 0:
        return out
    try:
        children = sorted(p for p in base.iterdir() if p.is_dir() and not p.is_symlink())
    except OSError:
        return out
    for child in children:
        if child.name.startswith(".") or child.name in MIGRATE_SCAN_SKIP:
            continue
        if ((child / PROJECT_CAPABILITIES_REL / "project.json").is_file()
                or (child / PROJECT_CAPABILITIES_REL / "settings.json").is_file()
                or (child / CONTEXTKIT_CONFIG_REL).is_file()):
            out.append(child)
        out.extend(_migrate_scan(child, depth - 1))
    return out


def _migrate_discover(given: list[str], scan: bool = False) -> list[dict]:
    """Every agent root this machine knows: the machine services' join lists,
    AgentKit's agent list where it is readable, the roots given, the project
    here, and every git worktree of those; each with its envelope read through
    its body root and its id. With `scan`, also every root found below the
    folders those roots sit in and below each root given."""
    found: dict[str, dict] = {}

    def add(raw, source: str) -> None:
        if not raw:
            return
        try:
            root = Path(str(raw)).expanduser().resolve()
        except OSError:
            return
        if not root.is_dir():
            return
        entry = found.setdefault(str(root), {"root": str(root), "sources": []})
        if source not in entry["sources"]:
            entry["sources"].append(source)

    for listing in sorted(_CONFIG_HOME.glob("*/service/projects.*")):
        name = listing.parent.parent.name
        try:
            if listing.suffix == ".toml":
                import tomllib
                body = tomllib.loads(listing.read_text())
            elif listing.suffix == ".json":
                body = json.loads(listing.read_text())
            else:
                continue
        except (OSError, ValueError):
            continue
        for entry in ((body or {}).get("projects") or {}).values():
            if isinstance(entry, dict):
                add(entry.get("root"), f"{name} service")
    agents = Path.home() / "Library" / "Application Support" / "AgentKit" / "agents.plist"
    if agents.is_file():
        try:
            import plistlib
            listed = plistlib.loads(agents.read_bytes())
        except Exception:
            listed = []
        for entry in listed if isinstance(listed, list) else []:
            if isinstance(entry, dict):
                add(entry.get("path"), "agentkit")
    for raw in given:
        add(raw, "given")
    here = _project_root()
    if here is not None:
        add(here, "here")
    if scan:
        homes = {Path.home().resolve(), Path("/")}
        bases = {Path(entry["root"]).parent for entry in found.values()}
        for raw in given:
            try:
                bases.add(Path(str(raw)).expanduser().resolve())
            except OSError:
                continue
        for base in sorted(bases - homes):
            for root in _migrate_scan(base):
                add(root, f"found under {base}")
    for entry in list(found.values()):
        try:
            proc = subprocess.run(["git", "-C", entry["root"], "worktree", "list",
                                   "--porcelain"], capture_output=True, text=True,
                                  timeout=20)
        except (OSError, subprocess.TimeoutExpired):
            continue
        for line in proc.stdout.splitlines() if proc.returncode == 0 else []:
            if line.startswith("worktree "):
                add(line[len("worktree "):], f"worktree of {entry['root']}")
    out = []
    for key in sorted(found):
        entry = found[key]
        root = Path(entry["root"])
        envelope = _migrate_body_envelope(root)
        # A root with only a ContextKit binding reads this machine's config
        # home as much as one with an envelope; the discard weighs it.
        if not envelope.is_dir() and not (scan and _contextkit_config_id(root)):
            continue
        entry.update(envelope=str(envelope), id=_migrate_root_id(envelope, root))
        out.append(entry)
    return out


# --- the store, read without writing ----------------------------------------------

def _migrate_connect(root: Path):
    """(connection, setting) for the root's database, the contract's tables
    left as they are; raises _MigrateRefusal with the store's own code."""
    db = _db_module()
    store = _store_module()
    try:
        setting = db.resolve_setting(root)
        conn = db.connect(application_name=store.STORE_OWNER, setting=setting,
                          transaction=True)
    except db.DbError as exc:
        raise _MigrateRefusal(exc.slug, exc.message, exc.hint,
                              exit_code=_store_error_exit(exc)) from None
    return conn, setting


def _migrate_rows(conn, query: str, params: tuple = ()) -> list[tuple]:
    """Rows of a read that answers nothing where the table is not there yet."""
    import psycopg
    try:
        rows = conn.execute(query, params).fetchall()
    except psycopg.errors.UndefinedTable:
        conn.rollback()
        return []
    conn.rollback()
    return rows


def _migrate_tables_pending(conn) -> dict | None:
    """What bringing the contract's tables to this code's version would run,
    read without a lock or a write: {from, to, steps}, None where they are
    current."""
    store = _store_module()
    db = _db_module()
    import psycopg
    major, minor = store.STORE_TABLES_VERSION
    try:
        conn.rollback()
        status = db.status(conn, store.STORE_OWNER, store.record_table_steps(),
                           major=major, minor=minor)
    except db.DbError as exc:
        raise _MigrateRefusal(exc.slug, exc.message, exc.hint,
                              exit_code=_store_error_exit(exc)) from None
    except psycopg.OperationalError as exc:
        raise _MigrateRefusal("store_unreachable", f"cannot reach the store: {exc}",
                              "check it with `capabilities store doctor`", exit_code=5) from None
    if status.state == "current":
        return None
    if status.state != "pending":
        raise _MigrateRefusal(status.state, f"the store's {store.STORE_OWNER} tables cannot "
                              f"be brought to {major}.{minor}: {status.state}",
                              "check them with `capabilities store doctor`")
    stored = (f"{status.stored_major}.{status.stored_minor}"
              if status.stored_major is not None else None)
    return {"from": stored, "to": f"{major}.{minor}", "steps": list(status.pending)}


def _migrate_read_only() -> None:
    """From here on every connection this process and the capabilities it
    runs open is read-only, so a dry run cannot change the store, its schema
    included, whatever it reaches."""
    flag = "-c default_transaction_read_only=on"
    current = os.environ.get("PGOPTIONS", "")
    if flag not in current:
        os.environ["PGOPTIONS"] = f"{current} {flag}".strip()


def _migrate_upgrade_tables(conn) -> list[str]:
    """The contract's tables brought to this code's version on an idle
    connection: the steps it applied, none where they were current."""
    store = _store_module()
    db = _db_module()
    import psycopg
    try:
        conn.rollback()
        major, minor = store.STORE_TABLES_VERSION
        result = db.migrate(conn, store.STORE_OWNER, store.record_table_steps(),
                            major=major, minor=minor)
    except db.DbError as exc:
        raise _MigrateRefusal(exc.slug, exc.message, exc.hint,
                              exit_code=_store_error_exit(exc)) from None
    except psycopg.OperationalError as exc:
        raise _MigrateRefusal("store_unreachable", f"cannot reach the store: {exc}",
                              "check it with `capabilities store doctor`", exit_code=5) from None
    return list(result.applied)


def _migrate_global_at(conn) -> str | None:
    rows = _migrate_rows(conn, "SELECT global_migrated_at FROM capabilities_global")
    return _store_module()._stamp(rows[0][0]) if rows and rows[0][0] else None


def _migrate_agent_state(conn, agent_id: str) -> dict | None:
    """The agent's registry row and nodes; on a store whose tables predate
    the registry, the row the upgrade would copy from ContextKit's registry,
    so a dry run there reads what the upgraded store would hold."""
    import psycopg
    try:
        state = _store_module()._agent_state(conn, agent_id)
    except psycopg.Error:
        conn.rollback()
        return None
    conn.rollback()
    if state is None and not _migrate_rows(
            conn, "SELECT 1 WHERE to_regclass('capabilities_agents') IS NOT NULL") \
            and _migrate_rows(conn, "SELECT 1 FROM contextkit_agents WHERE id = %s",
                              (agent_id,)):
        state = {"id": agent_id, "migrating_since": None, "migrated_at": None,
                 "nodes": {}, "master": None}
    return state


def _migrate_node_rows(conn, agent_id: str) -> dict:
    return {row[0]: dict(zip(NODE_COLUMNS, row)) for row in _migrate_rows(
        conn, f"SELECT {', '.join(NODE_COLUMNS)} FROM capabilities_agent_nodes "
              "WHERE agent_id = %s", (agent_id,))}


def _migrate_policy_rows(conn, agent_id: str | None) -> dict:
    return {(cap, node): enabled for cap, node, enabled in _migrate_rows(
        conn, "SELECT capability, node, enabled FROM capabilities_policy "
              "WHERE coalesce(agent_id, '') = coalesce(%s::text, '')", (agent_id,))}


def _migrate_identifier_rows(conn, agent_id: str | None) -> dict:
    return {(cap, label): (value, note or "") for cap, label, value, note in _migrate_rows(
        conn, "SELECT capability, label, value, note FROM capabilities_identifiers i "
              "WHERE coalesce(agent_id, '') = coalesce(%s::text, '') "
              "AND to_jsonb(i) ->> 'node' IS NULL",
        (agent_id,))}


def _migrate_grant_rows(conn, agent_id: str | None) -> dict:
    return {(cap, cid): (enabled, allow_write, bool(is_default))
            for cap, cid, enabled, allow_write, is_default in _migrate_rows(
                conn, "SELECT capability, connection, enabled, allow_write, is_default "
                      "FROM capabilities_connection_grants "
                      "WHERE coalesce(agent_id, '') = coalesce(%s::text, '') "
                      "AND node IS NULL", (agent_id,))}


def _migrate_connection_rows(conn) -> dict:
    return {(cap, name): spec for cap, name, spec in _migrate_rows(
        conn, "SELECT capability, name, spec FROM capabilities_connections")}


def _migrate_setting_rows(conn, agent_id: str | None, document: str) -> dict | None:
    """One settings document as its shared rows hold it, or None where the
    document does not exist."""
    store = _store_module()
    exists = _migrate_rows(
        conn, "SELECT generation FROM capabilities_settings_documents "
              "WHERE coalesce(agent_id, '') = coalesce(%s::text, '') AND capability = %s "
              "AND node IS NULL", (agent_id, document))
    rows = _migrate_rows(
        conn, "SELECT path, value FROM capabilities_settings "
              "WHERE coalesce(agent_id, '') = coalesce(%s::text, '') AND capability = %s "
              "AND node IS NULL", (agent_id, document))
    if not exists and not rows:
        return None
    return store.settings_tree([(list(path), value) for path, value in rows])


# --- what the files say -------------------------------------------------------------

def _migrate_manifests() -> dict:
    """Each installed capability's manifest: the one its install left in the
    registry, else the one its payload answers."""
    out: dict = {}
    for name in sorted(_installed()):
        manifest = _read_json(CAP_HOME / name / "manifest.json")
        if not isinstance(manifest, dict):
            rc, stdout, _err = _run_script(CAP_HOME / name / name, ["manifest", "--json"],
                                           timeout=120)
            try:
                manifest = json.loads(stdout) if rc == 0 else None
            except ValueError:
                manifest = None
        out[name] = manifest if isinstance(manifest, dict) else {}
    return out


def _migrate_outdated(names) -> list[str]:
    """Installed payloads stamped before the contract carried `migrate files`."""
    stale = []
    for name in sorted(names):
        try:
            text = (CAP_HOME / name / name).read_text(errors="replace")
        except OSError:
            stale.append(name)
            continue
        if MIGRATE_CONTRACT_MARKER not in text:
            stale.append(name)
    return stale


def _migrate_settings_homes(manifests: dict, scope: str) -> list[tuple[str, dict]]:
    out = []
    for name, manifest in sorted(manifests.items()):
        for home in ((manifest.get("settings") or {}).get("homes") or []):
            if isinstance(home, dict) and home.get("scope") == scope and home.get("path"):
                out.append((name, home))
    return out


def _migrate_read_document(path: Path, fmt: str) -> tuple[dict | None, str | None]:
    """A settings file as the document its reader takes: (document, problem)."""
    try:
        text = path.read_text()
    except FileNotFoundError:
        return None, None
    except OSError as exc:
        return None, f"cannot read {path}: {exc}"
    try:
        if fmt == "toml":
            import tomllib
            document = tomllib.loads(text)
        else:
            document = json.loads(text) if text.strip() else {}
    except ValueError as exc:
        return None, f"cannot read {path}: {exc}"
    if not isinstance(document, dict):
        return None, f"{path} does not hold an object"
    try:
        return json.loads(json.dumps(document, default=_migrate_toml_value)), None
    except (TypeError, ValueError) as exc:
        return None, f"{path} holds a value JSON cannot keep: {exc}"


def _migrate_toml_value(value):
    if hasattr(value, "isoformat"):
        return value.isoformat()
    raise TypeError(f"{type(value).__name__} is not JSON")


def _migrate_without(document: dict, paths: list) -> dict:
    out = json.loads(json.dumps(document))
    for path in paths or []:
        here = out
        for part in path[:-1]:
            here = here.get(part) if isinstance(here, dict) else None
        if isinstance(here, dict):
            here.pop(path[-1], None)
    return out


def _migrate_host_paths(document, prefix: tuple = ()) -> list[str]:
    found = []
    if isinstance(document, dict):
        for key, value in document.items():
            found.extend(_migrate_host_paths(value, (*prefix, str(key))))
    elif isinstance(document, list):
        for index, value in enumerate(document):
            found.extend(_migrate_host_paths(value, (*prefix, str(index))))
    elif isinstance(document, str) and MIGRATE_HOST_PATH.match(document):
        found.append(f"{'.'.join(prefix)} = {document}")
    return found


def _migrate_git_state(root: Path, paths: list[Path]) -> dict[str, str]:
    """Each path as git holds it: `tracked` (as committed), `modified`
    (working tree differs from the commit), `untracked`, `ignored`, or `none`
    where the root is no repository."""
    out = {str(p): "none" for p in paths}
    if not paths:
        return out
    try:
        inside = subprocess.run(["git", "-C", str(root), "rev-parse", "--show-toplevel"],
                                capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return out
    if inside.returncode != 0:
        return out
    for path in paths:
        try:
            tracked = subprocess.run(["git", "-C", str(root), "ls-files", "--error-unmatch",
                                      "--", str(path)], capture_output=True, timeout=20)
            if tracked.returncode == 0:
                changed = subprocess.run(["git", "-C", str(root), "diff", "--quiet", "HEAD",
                                          "--", str(path)], capture_output=True, timeout=20)
                out[str(path)] = "modified" if changed.returncode != 0 else "tracked"
                continue
            ignored = subprocess.run(["git", "-C", str(root), "check-ignore", "-q", "--",
                                      str(path)], capture_output=True, timeout=20)
            out[str(path)] = "ignored" if ignored.returncode == 0 else "untracked"
        except (OSError, subprocess.TimeoutExpired):
            continue
    return out


def _migrate_record_files(envelope: Path, manifests: dict) -> list[Path]:
    """Every record and settings file the envelope holds that the store keeps
    once the agent has moved: the gate, each capability's connections and
    identifiers, its project settings home and the settings files folded into it."""
    files = [envelope / "settings.json"]
    files += sorted(envelope.glob("*/connections.json"))
    files += sorted(envelope.glob("*/identifiers.json"))
    for name, home in _migrate_settings_homes(manifests, "project"):
        files.append(envelope / name / home["path"])
    for name, fold in MIGRATE_FOLDED_SETTINGS.items():
        files.append(envelope / name / fold["home"]["path"])
        files.append(envelope / name / fold["file"])
    seen, out = set(), []
    for path in files:
        if path.is_file() and str(path) not in seen:
            seen.add(str(path))
            out.append(path)
    return out


# --- the capabilities' own movers ---------------------------------------------------

def _migrate_movers(manifests: dict) -> list[str]:
    return [name for name, manifest in sorted(manifests.items())
            if manifest.get("migrate_files")]


def _migrate_mover_env(root: Path, agent_id: str | None = None) -> dict:
    """A capability's environment in the agent's project, its envelope and its
    id handed down so it asks the manager for neither, and so nothing writes
    the id into project.json before the migration does."""
    env = dict(os.environ)
    env["CLAUDE_PROJECT_DIR"] = str(root)
    env[ENVELOPE_ENV] = str(_project_capabilities_dir(root))
    env[ENVELOPE_ROOT_ENV] = str(root)
    if agent_id:
        env["CAPABILITIES_PROJECT_ID"] = agent_id
        env["CAPABILITIES_PROJECT_ID_ROOT"] = str(root)
    return env


def _migrate_run_movers(root: Path, names: list[str], action: str,
                        answers_file: Path, agent_id: str | None = None) -> dict:
    """`<name> migrate files <action>` for each capability that moves files of
    its own, in the project; a mover that refuses is reported with its error."""
    out: dict = {}
    for name in names:
        rc, stdout, stderr = _run_script(
            CAP_HOME / name / name, ["migrate", "files", action, "--answers",
                                     str(answers_file)],
            cwd=root, env=_migrate_mover_env(root, agent_id), timeout=MIGRATE_MOVER_TIMEOUT)
        report = None
        try:
            report = json.loads(stdout) if rc == 0 else None
        except ValueError:
            report = None
        if rc != 0 or not isinstance(report, dict):
            error = None
            for line in reversed((stderr or "").splitlines()):
                try:
                    error = json.loads(line).get("error")
                    break
                except (ValueError, AttributeError):
                    continue
            out[name] = {"ok": False, "exit": rc,
                         "error": error or {"code": "mover_failed",
                                            "message": (stderr or stdout or "").strip()[-2000:]}}
            continue
        report["ok"] = True
        out[name] = report
    return out


def _migrate_mover_answers(ctx: dict, answers: dict) -> Path:
    """The answers file handed to the movers, removed by the caller: the
    person's answers, with the master and every node of the agent added for
    them to map to."""
    body = {**answers, "_master": ctx["node"], "_nodes": sorted(ctx["known_nodes"])}
    with tempfile.NamedTemporaryFile("w", delete=False, prefix="capabilities-migrate-",
                                     suffix=".json") as handle:
        handle.write(json.dumps(body, ensure_ascii=False))
    path = Path(handle.name)
    path.chmod(0o600)
    return path


# --- one agent: preflight -----------------------------------------------------------

def _migrate_context(root: Path, opts: dict, answers: dict) -> dict:
    """What a run on this agent stands on, and each reason it may not write:
    `blockers` in the order a write refuses them."""
    store = _store_module()
    envelope = _project_capabilities_dir(root)
    identity_file = envelope / PROJECT_IDENTITY_REL
    identity = _read_json(identity_file)
    identity = identity if isinstance(identity, dict) else {}
    declared = str(identity.get("id") or "").strip() or None
    bound = _contextkit_config_id(root)
    ctx: dict = {"root": root, "envelope": envelope, "identity_file": identity_file,
                 "given_roots": opts.get("roots") or [], "answers": answers,
                 "identity": identity, "blockers": [], "questions": [], "warnings": [],
                 "slug": identity.get("slug") or _default_project_slug(root)}
    agent_id = declared or bound
    if declared and bound and declared != bound:
        wanted = answers.get("id")
        if wanted in (declared, bound):
            agent_id = wanted
        else:
            ctx["questions"].append({
                "id": "id", "answer": "id", "choices": [declared, bound],
                "question": f"{identity_file} declares id {declared} and "
                            f"{root / CONTEXTKIT_CONFIG_REL} declares {bound}: which id is "
                            "this agent's? The other is left behind"})
    if not agent_id:
        raise _MigrateRefusal("no_project_identity",
                              f"{identity_file} carries no project id and no "
                              f"{CONTEXTKIT_CONFIG_REL} holds one",
                              "give the agent an id with `capabilities init`, or archive it")
    ctx["agent_id"] = agent_id
    ctx["id_write"] = agent_id if agent_id != declared else None
    try:
        ctx["mode"] = ("store" if store.records_mode(envelope) == "store"
                       else "connections" if store.connections_mode(envelope) == "store"
                       else "files")
    except store.StoreError as exc:
        raise _MigrateRefusal(exc.slug, exc.message, exc.hint) from None
    node = os.environ.get(store.NODE_NAME_ENV, "").strip()
    ctx["node"] = node or None
    if not node:
        ctx["blockers"].append(_MigrateRefusal(
            "node_unnamed", f"{store.NODE_NAME_ENV} is not set: a migration names the node "
            "it runs on, the agent's master", f"set {store.NODE_NAME_ENV} for this machine "
            "(its shells and its launchd services), then run it again"))
    named = answers.get("node")
    if node and named is not None and named != node:
        ctx["blockers"].append(_MigrateRefusal(
            "node_mismatch", f"the answers name node {named!r} and this process runs as "
            f"{node!r} ({store.NODE_NAME_ENV})", "run it on the node the answers name, or "
            "correct the answers"))
    journal = _migrate_journal(agent_id)
    ctx["journal"] = journal
    if node and journal and journal.get("node") and journal["node"] != node \
            and journal.get("phase") != "finalized":
        ctx["blockers"].append(_MigrateRefusal(
            "node_mismatch", f"the open migration of {agent_id} was started on node "
            f"{journal['node']!r}, and this process runs as {node!r}",
            f"finish it on {journal['node']}"))
    conn, setting = _migrate_connect(root)
    ctx["setting"] = setting
    try:
        import psycopg
        try:
            conn.execute("SELECT 1").fetchone()
            conn.rollback()
        except psycopg.Error as exc:
            raise _MigrateRefusal("store_unreachable", f"the store does not answer: {exc}",
                                  "check it with `capabilities store doctor`",
                                  exit_code=5) from None
        ctx["state"] = _migrate_agent_state(conn, agent_id)
        ctx["nodes"] = _migrate_node_rows(conn, agent_id)
        ctx["global_migrated_at"] = _migrate_global_at(conn)
        ctx["tables_to_upgrade"] = _migrate_tables_pending(conn)
        held = (_migrate_agent_rows_held(conn, agent_id)
                if ctx["mode"] == "store" and not (ctx["state"] or {}).get("migrated_at")
                else True)
    finally:
        conn.close()
    if not held and _migrate_files_hold_records(ctx):
        # "records": "store" was written against another store: the one in
        # force holds none of this agent's rows, and its files hold some. A
        # person says which is the truth before either is lost.
        choice = answers.get("records")
        if choice == "files":
            ctx["mode"] = "files"
        elif choice != "store":
            ctx["questions"].append({
                "id": "records", "answer": "records", "choices": ["files", "store"],
                "question": f"{envelope / PROJECT_IDENTITY_REL} says the agent's records "
                            "are in the store, but the store in force holds none of its "
                            "connections, grants, identifiers or gate, and its files hold "
                            "some: are the files the truth (written to the store, as for an "
                            "agent in files mode) or the store (kept as it is, and the "
                            "files removed)?"})
    state = ctx["state"] or {}
    master = state.get("master")
    ctx["master"] = master
    if node and master and master != node:
        ctx["blockers"].append(_MigrateRefusal(
            "not_master", f"node {node} is not the master of agent {agent_id}; its master "
            f"is {master}", f"run `capabilities migrate` on {master}"))
    if not ctx["global_migrated_at"]:
        ctx["blockers"].append(_MigrateRefusal(
            "global_not_migrated", "the global records are not in the store yet: an "
            "agent's migration needs the rows every agent inherits",
            "run `capabilities migrate --global --apply` on the global master first"))
    manifests = _migrate_manifests()
    ctx["manifests"] = manifests
    outdated = _migrate_outdated(manifests)
    if outdated:
        ctx["blockers"].append(_MigrateRefusal(
            "payload_outdated", f"{len(outdated)} installed payload(s) are stamped with a "
            f"contract before `migrate files`: {', '.join(outdated)}",
            "update them with `capabilities update`, then run it again",
            detail={"payloads": outdated}))
    ctx["known_nodes"] = set(ctx["nodes"]) | ({node} if node else set())
    for name, answer in (answers.get("nodes") or {}).items():
        if isinstance(answer, dict) and answer.get("register") is True:
            ctx["known_nodes"].add(name)
    return ctx


def _migrate_agent_rows_held(conn, agent_id: str) -> bool:
    """Whether the store holds any grant, identifier or gate row of this
    agent."""
    for table in ("capabilities_connection_grants", "capabilities_identifiers",
                  "capabilities_policy"):
        rows = _migrate_rows(conn, f"SELECT 1 FROM {table} WHERE agent_id = %s LIMIT 1",
                             (agent_id,))
        if rows:
            return True
    return False


def _migrate_files_hold_records(ctx: dict) -> bool:
    """Whether this agent's own files resolve any connection, identifier or
    gate entry."""
    store = _store_module()
    envelope = ctx["envelope"]
    try:
        files = store.FileRecords(envelope, _CONFIG_HOME, ctx["agent_id"], ctx["slug"],
                                  include_global=False)
        if files.resolve_scope("capabilities", "policy", "project"):
            return True
        for name in sorted(set(_import_names(envelope))
                           | set(_import_identifier_names(envelope))):
            for collection in ("connection", "identifier"):
                if files.resolve_scope(name, collection, "project"):
                    return True
    except store.StoreError as exc:
        raise _MigrateRefusal("files_unreadable", exc.message,
                              "repair them (`capabilities doctor` names the faults)") from None
    return False


def _migrate_global_home(ctx: dict) -> Path:
    """The global layer an agent's files are read over while it moves: once
    the global rows exist, a config home made of them - the gate, the
    identifiers, and every connection the store holds with its global grant
    and default - so the plan and the verify read the agent's files over what
    it will inherit once it moved, and never over this machine's config home,
    which may hold other files or none (`migrate --discard`). Before the
    global rows exist, the config home itself."""
    if not ctx.get("global_migrated_at"):
        return _CONFIG_HOME
    if ctx.get("global_home"):
        return ctx["global_home"]
    import atexit
    # One place per agent, made afresh by every run, so a run killed before
    # its exit leaves nothing that accumulates.
    home = _migrate_home(ctx["agent_id"]) / "global-home"
    shutil.rmtree(home, ignore_errors=True)
    home.mkdir(parents=True, mode=0o700)
    atexit.register(shutil.rmtree, home, True)
    conn, _setting = _migrate_connect(ctx["root"])
    try:
        gate = {name: {"enabled": bool(enabled)} for name, enabled in _migrate_rows(
            conn, "SELECT capability, enabled FROM capabilities_policy "
                  "WHERE agent_id IS NULL AND node IS NULL")}
        identifiers: dict = {}
        for name, label, value, note in _migrate_rows(
                conn, "SELECT capability, label, value, note FROM capabilities_identifiers i "
                      "WHERE agent_id IS NULL AND to_jsonb(i) ->> 'node' IS NULL"):
            identifiers.setdefault(name, {})[label] = {"value": value, "note": note or ""}
        registries: dict = {}
        for name, cid, spec in _migrate_rows(
                conn, "SELECT capability, name, spec FROM capabilities_connections"):
            registries.setdefault(name, {"connections": {}})["connections"][cid] = dict(spec)
        for name, cid, allow_write, is_default in _migrate_rows(
                conn, "SELECT capability, connection, allow_write, is_default FROM "
                      "capabilities_connection_grants WHERE agent_id IS NULL AND node IS NULL"):
            entry = registries.get(name, {}).get("connections", {}).get(cid)
            if entry is None:
                continue
            if allow_write is not None:
                entry["allow_write"] = bool(allow_write)
            if is_default:
                registries[name]["default"] = cid
    finally:
        conn.close()
    _write_json(home / "capabilities" / "settings.json", {"capabilities": gate})
    for name, rows in identifiers.items():
        _write_json(home / name / "identifiers.json", rows)
    for name, registry in registries.items():
        _write_json(home / name / "connections.json", registry)
    ctx["global_home"] = home
    return home


# --- one agent: the plan ------------------------------------------------------------

def _migrate_records_plan(ctx: dict, answers: dict) -> dict:
    """The records rows this agent's files resolve to at its own scope, and
    what the store holds of them: connections, grants and the default pointer
    (where the files hold them), identifiers and the gate (where they hold
    those)."""
    store = _store_module()
    envelope, agent_id, mode = ctx["envelope"], ctx["agent_id"], ctx["mode"]
    files = store.FileRecords(envelope, _migrate_global_home(ctx), agent_id, ctx["slug"])
    plan: dict = {"connections": [], "grants": [], "identifiers": [], "policy": [],
                  "remove": [], "kept": [], "questions": []}
    if mode == "store":
        plan["kept"] = ["connection", "grant", "identifier", "policy"]
        return plan
    conn, _setting = _migrate_connect(ctx["root"])
    try:
        held_specs = _migrate_connection_rows(conn)
        held_grants = _migrate_grant_rows(conn, agent_id)
        held_ids = _migrate_identifier_rows(conn, agent_id)
        held_policy = _migrate_policy_rows(conn, agent_id)
    finally:
        conn.close()
    if mode == "files":
        try:
            wanted, _skipped = _import_plan(files, _import_names(envelope))
        except _ImportRefused as exc:
            raise _MigrateRefusal(exc.code, exc.message, exc.hint) from None
        renames = _migrate_renames(answers)
        for name, entry in sorted(wanted.items()):
            for cid, spec in sorted(entry["connections"].items()):
                qid = f"connections.{name}/{cid}"
                renamed = renames.get((name, cid))
                if renamed is not None:
                    problem = _migrate_rename_problem(name, cid, renamed, entry)
                    if problem:
                        raise _MigrateRefusal("input", f"the answer {qid} cannot rename the "
                                              f"connection: {problem}",
                                              "answer it with another name")
                held = held_specs.get((name, renamed or cid))
                if held is None:
                    outcome = "write"
                elif held == spec:
                    outcome = "held"
                else:
                    choice = None if renamed else _migrate_dig(answers, qid)
                    choice = choice if isinstance(choice, str) else None
                    outcome = {"files": "replace", "store": "kept"}.get(choice, "differs")
                    if outcome == "differs":
                        plan["questions"].append({
                            "id": qid, "answer": qid,
                            "choices": ["files", "store", {"rename": "<a new name>"}],
                            "question": f"{name} connection {(renamed or cid)!r} is in the "
                                        f"store as {json.dumps(held, sort_keys=True)} and "
                                        f"{cid!r} is in this agent's files as "
                                        f"{json.dumps(spec, sort_keys=True)}; every agent "
                                        "granted it reads the store's: keep the store's "
                                        "(this agent then uses it too), replace it with the "
                                        "files', or keep the store's for the others and "
                                        "give this agent's its own name?"})
                row = {"capability": name, "name": renamed or cid,
                       "spec": held if outcome == "kept" else spec,
                       "store": held, "outcome": outcome}
                if renamed:
                    row["renamed_from"] = cid
                if outcome == "kept":
                    row["files_spec"] = spec
                plan["connections"].append(row)
            for cid, grant in sorted(entry["grants"].items()):
                row = (grant["enabled"], grant["allow_write"], grant["is_default"])
                cid = renames.get((name, cid)) or cid
                held = held_grants.pop((name, cid), None)
                plan["grants"].append({"capability": name, "connection": cid,
                                       "enabled": row[0], "allow_write": row[1],
                                       "is_default": row[2],
                                       "outcome": "held" if held == row else "write"})
        for (name, cid), _row in sorted(held_grants.items()):
            plan["remove"].append({"kind": "grant", "capability": name, "name": cid})
    for name in _import_identifier_names(envelope):
        try:
            rows = files.resolve_scope(name, "identifier", "project")
        except store.StoreError as exc:
            raise _MigrateRefusal("files_unreadable", f"{name} identifiers: {exc.message}",
                                  "repair them (`capabilities doctor` names the faults)")
        for label, row in sorted(rows.items()):
            wanted = (row["value"], row["note"] or "")
            held = held_ids.pop((name, label), None)
            plan["identifiers"].append({"capability": name, "label": label,
                                        "value": wanted[0], "note": wanted[1],
                                        "outcome": "held" if held == wanted else "write"})
    for (name, label), _row in sorted(held_ids.items()):
        plan["remove"].append({"kind": "identifier", "capability": name, "name": label})
    try:
        gate = files.resolve_scope("capabilities", "policy", "project")
    except store.StoreError as exc:
        raise _MigrateRefusal("files_unreadable", f"policy: {exc.message}",
                              "repair it (`capabilities doctor` names the faults)")
    for name, row in sorted(gate.items()):
        value = row["value"]
        if (not isinstance(value, dict) or set(value) != {"enabled"}
                or not isinstance(value.get("enabled"), bool)):
            raise _MigrateRefusal("files_unreadable", f"the project gate for {name!r} is "
                                  'not {"enabled": true|false}',
                                  "repair it (`capabilities doctor` names the faults)")
        held = held_policy.pop((name, None), None)
        plan["policy"].append({"capability": name, "node": None,
                               "enabled": value["enabled"],
                               "outcome": "held" if held == value["enabled"] else "write"})
    ctx["held_node_policy"] = {key: value for key, value in held_policy.items() if key[1]}
    for (name, node), _enabled in sorted(held_policy.items(), key=lambda k: (k[0][0], k[0][1] or "")):
        if node is None:
            plan["remove"].append({"kind": "policy", "capability": name, "name": name})
    if mode == "connections":
        plan["kept"] = ["connection", "grant"]
    return plan


def _migrate_renames(answers: dict) -> dict:
    """{(capability, connection): new name} for every connection a person
    answered to rename: `connections.<capability>/<connection>` =
    {"rename": "<new name>"}."""
    out = {}
    for key, value in ((answers or {}).get("connections") or {}).items():
        name, _slash, cid = str(key).partition("/")
        if cid and isinstance(value, dict) and isinstance(value.get("rename"), str):
            out[(name, cid)] = value["rename"].strip()
    return out


def _migrate_rename_problem(name: str, cid: str, renamed: str, entry: dict) -> str | None:
    store = _store_module()
    if not store.KEY_RE.fullmatch(renamed):
        return f"{renamed!r} is not a connection name"
    if renamed == cid:
        return "the new name is the name it has"
    if renamed in entry["connections"]:
        return f"this agent's files already hold a {name} connection {renamed!r}"
    return None


def _migrate_rename_references(name: str, document, renames: dict):
    """A settings document whose `connection` names a connection renamed for
    this agent, naming it by its new name."""
    if isinstance(document, dict) and isinstance(document.get("connection"), str):
        new = renames.get((name, document["connection"]))
        if new:
            document = {**document, "connection": new}
    return document


def _migrate_fold(name: str, document: dict | None, folded: dict | None,
                  fold: dict, answers: dict, where: str) -> tuple:
    """A capability's settings document with the file folded into it that it
    kept beside it: (document, questions, warnings). The document is None
    where neither holds anything."""
    questions: list = []
    warnings: list = []
    if name == "slack":
        return _migrate_fold_slack(name, document, folded, answers, where)
    if folded is None:
        return document, questions, warnings
    if name == "tasks":
        out = json.loads(json.dumps(document if document is not None
                                    else fold["home"].get("seed") or {}))
        if "escalation" in out:
            warnings.append(f"tasks: {fold['file']} is not moved: the settings already "
                            "carry an `escalation` table, which is what the claim reads")
        else:
            out["escalation"] = folded
        return out, questions, warnings
    return document, questions, warnings


def _migrate_fold_slack(name: str, document: dict | None, folded: dict | None,
                        answers: dict, where: str) -> tuple:
    """slack's one allow-list, from its policy.json (what `slack read` and
    `post` may reach) and its service settings (what the service admits).
    A file that is absent holds nothing. An entry both hold keeps the service
    settings' own, with its role; an entry only one holds would newly be
    reached or admitted through the other, so each is asked - kept for both,
    or dropped from both - and nothing is written until it is answered; a
    mode the two read differently is asked too."""
    questions: list = []
    if folded is None and document is None:
        return None, questions, []
    policy, service = folded or {}, document or {}
    out = json.loads(json.dumps(service))
    modes = {key.split(".", 1)[0] for key in MIGRATE_SLACK_MODES}
    for key, value in policy.items():
        # The lists and modes are settled below, entry by entry.
        if key not in MIGRATE_SLACK_LISTS and key not in modes and key not in out:
            out[key] = json.loads(json.dumps(value))
    for key in MIGRATE_SLACK_LISTS:
        if key not in policy and key not in service:
            continue
        theirs, ours = policy.get(key, {}), service.get(key, {})
        if not isinstance(theirs, dict) or not isinstance(ours, dict):
            if key not in service:
                out[key] = theirs
            elif key in policy and theirs != ours:
                choice = _migrate_dig(answers, f"settings.{name}.{key}")
                if choice == "policy":
                    out[key] = theirs
                elif choice != "service":
                    questions.append(_migrate_fold_question(name, key, theirs, ours, where))
            continue
        merged = {}
        for ident in sorted(set(theirs) | set(ours)):
            if ident in ours and ident in theirs:
                merged[ident] = ours[ident]
                continue
            qid = f"settings.{name}.{key}.{ident}"
            choice = _migrate_dig(answers, qid)
            if choice == "keep":
                merged[ident] = ours[ident] if ident in ours else theirs[ident]
            elif choice != "drop":
                questions.append(_migrate_entry_question(qid, key, ident, ident in ours,
                                                         where))
        out[key] = merged
    for key, fallback in MIGRATE_SLACK_MODES.items():
        theirs = _migrate_fold_value(policy, key, fallback)
        ours = _migrate_fold_value(service, key, fallback)
        if theirs == ours:
            continue
        qid = f"settings.{name}.{key}"
        choice = _migrate_dig(answers, qid)
        if choice == "policy":
            _migrate_fold_put(out, key, theirs)
        elif choice != "service":
            # The service's stands as its settings say it, a mode left out
            # reading as its default.
            questions.append(_migrate_fold_question(name, key, theirs, ours, where))
    return out, questions, []


def _migrate_entry_question(qid: str, key: str, ident: str, in_service: bool,
                            where: str) -> dict:
    """The question for an allow-list entry only one of slack's two files
    holds: what keeping it would newly open, or dropping it close."""
    what = "user" if key == "allowed_users" else "channel"
    if in_service:
        held = (f"is in the service settings ({where}) only: the service admits "
                "it today and `slack read` and `post` cannot reach it")
        newly = f"`slack read` and `post` would newly reach this {what}"
    else:
        held = ("is in policy.json only: `slack read` and `post` reach it today and "
                "the service does not admit it")
        newly = ("the service would newly admit its direct messages" if what == "user"
                 else "the service would newly admit its mentions and catch up on its "
                      "history")
    return {"id": qid, "answer": qid, "choices": ["keep", "drop"],
            "question": f"slack {what} {ident} {held}. Once the agent has moved one "
                        f"allow-list decides both: keep it, and {newly}; or drop it, and "
                        "neither reaches it?"}


def _migrate_fold_value(document: dict, dotted: str, fallback):
    here = document
    for part in dotted.split("."):
        if not isinstance(here, dict) or part not in here:
            return fallback
        here = here[part]
    return here


def _migrate_fold_put(document: dict, dotted: str, value) -> None:
    parts = dotted.split(".")
    here = document
    for part in parts[:-1]:
        if not isinstance(here.get(part), dict):
            here[part] = {}
        here = here[part]
    here[parts[-1]] = value


def _migrate_fold_question(name: str, key: str, theirs, ours, where: str) -> dict:
    qid = f"settings.{name}.{key}"
    return {"id": qid, "answer": qid, "choices": ["policy", "service"],
            "question": f"{name}'s policy.json says {key} is {json.dumps(theirs)} and its "
                        f"service settings ({where}) say {json.dumps(ours)}; once it has "
                        "moved one allow-list decides both what `slack read` and `post` "
                        "reach and what the service admits: keep the policy's, or the "
                        "service's?"}


def _migrate_settings_document(entry: dict, answers: dict) -> tuple:
    """One settings entry's document as it moves: its home file less what a
    mover excludes, with the file it kept beside it folded in. (document,
    problem, questions, warnings); the document is None where there is none."""
    document, problem = _migrate_read_document(Path(entry["file"]), entry["format"])
    if problem:
        return None, problem, [], []
    if document is not None:
        document = _migrate_without(document, entry["excluded"])
    renames = _migrate_renames(answers)
    fold = MIGRATE_FOLDED_SETTINGS.get(entry["document"])
    if fold is None:
        return (_migrate_rename_references(entry["document"], document, renames),
                None, [], [])
    folded, problem = _migrate_read_document(Path(entry["fold"]), fold["format"])
    if problem:
        return None, problem, [], []
    document, questions, warnings = _migrate_fold(entry["document"], document, folded, fold,
                                                  answers, entry["file"])
    return (_migrate_rename_references(entry["document"], document, renames),
            None, questions, warnings)


def _migrate_settings_plan(ctx: dict, excludes: dict, answers: dict | None = None) -> dict:
    """Each settings document this agent keeps in files - every capability's
    project home, with the file it kept beside it folded in - as the rows it
    would become, and the questions and warnings the folding raised."""
    root, envelope = ctx["root"], ctx["envelope"]
    answers = answers or {}
    conn, _setting = _migrate_connect(root)
    homes = dict(_migrate_settings_homes(ctx["manifests"], "project"))
    for name, fold in MIGRATE_FOLDED_SETTINGS.items():
        homes.setdefault(name, fold["home"])
    out = {"settings": [], "questions": [], "warnings": []}
    try:
        for name, home in sorted(homes.items()):
            entry = {"document": name, "file": str(envelope / name / home["path"]),
                     "format": home.get("format") or "json",
                     "excluded": excludes.get(name) or []}
            if name in MIGRATE_FOLDED_SETTINGS:
                entry["fold"] = str(envelope / name / MIGRATE_FOLDED_SETTINGS[name]["file"])
            wanted, problem, questions, warnings = _migrate_settings_document(entry, answers)
            if problem:
                raise _MigrateRefusal("settings_unreadable", problem,
                                      "repair the file, then run it again")
            out["questions"].extend(questions)
            out["warnings"].extend(warnings)
            if wanted is None:
                continue
            held = _migrate_setting_rows(conn, ctx["agent_id"], name)
            out["settings"].append({**entry, "document_value": wanted,
                                    "outcome": "held" if held == wanted else "write",
                                    "host_paths": _migrate_host_paths(wanted)})
    finally:
        conn.close()
    return out


def _migrate_plan(ctx: dict, answers: dict) -> dict:
    """Everything a write would do for this agent, every question open, and
    every finding a person should see first. Writes nothing."""
    root = ctx["root"]
    plan: dict = {"questions": list(ctx["questions"]), "warnings": list(ctx["warnings"])}
    names = _migrate_movers(ctx["manifests"])
    answers_file = _migrate_mover_answers(ctx, answers)
    try:
        movers = _migrate_run_movers(root, names, "plan", answers_file, ctx["agent_id"])
    finally:
        answers_file.unlink(missing_ok=True)
    plan["movers"] = movers
    excludes: dict = {}
    nodes: dict = {}
    policy: list = []
    for name, report in movers.items():
        if not report.get("ok"):
            continue
        plan["questions"].extend(report.get("questions") or [])
        plan["warnings"].extend(f"{name}: {w}" for w in report.get("warnings") or [])
        if report.get("settings_exclude"):
            excludes[name] = report["settings_exclude"]
        for entry in report.get("nodes") or []:
            nodes[entry["node"]] = entry
        policy.extend(report.get("policy") or [])
    failed = {name: r["error"] for name, r in movers.items() if not r.get("ok")}
    plan["mover_failures"] = failed
    # One node per deployment target: registered by the master once a person
    # says so, since only then may placement name it.
    plan["nodes"] = []
    for node, entry in sorted(nodes.items()):
        registered = node in ctx["nodes"]
        given = (answers.get("nodes") or {}).get(node)
        register = given.get("register") if isinstance(given, dict) else None
        row = {**entry, "registered": registered,
               "address": (given or {}).get("address") if isinstance(given, dict) else None,
               "outcome": "held" if registered else
               "register" if register is True else
               "later" if register == "later" else "open"}
        plan["nodes"].append(row)
        if row["outcome"] == "open":
            plan["questions"].append({
                "id": f"nodes.{node}", "answer": f"nodes.{node}",
                "choices": [{"register": True, "address": "<host or IP, optional>"},
                            {"register": "later"}],
                "question": f"deployment target {entry.get('target')!r} runs as node "
                            f"{node!r}: register it as a server node of this agent now, or "
                            "later with `capabilities node add` before the migration can "
                            "finish?"})
    # A node the answers say to register - one a legacy automation runs on,
    # say - is registered with the rest.
    declared = {row["node"] for row in plan["nodes"]}
    for node, given in sorted((answers.get("nodes") or {}).items()):
        if node in declared or node in ctx["nodes"] or node == ctx["node"] \
                or not isinstance(given, dict) or given.get("register") is not True:
            continue
        plan["nodes"].append({"node": node, "kind": given.get("kind") or "server",
                              "target": given.get("target"), "registered": False,
                              "address": given.get("address"), "outcome": "register"})
        declared.add(node)
    # A node placement names that no target declares is a node to register
    # all the same.
    for node in sorted({row["node"] for row in policy} - declared - set(ctx["nodes"])
                       - {ctx["node"]}):
        given = (answers.get("nodes") or {}).get(node)
        register = given.get("register") if isinstance(given, dict) else None
        row = {"node": node, "kind": "server", "target": None, "registered": False,
               "address": given.get("address") if isinstance(given, dict) else None,
               "outcome": "register" if register is True else
               "later" if register == "later" else "open"}
        plan["nodes"].append(row)
        if row["outcome"] == "open":
            plan["questions"].append({
                "id": f"nodes.{node}", "answer": f"nodes.{node}",
                "choices": [{"register": True, "address": "<host or IP, optional>"},
                            {"register": "later"}],
                "question": f"services are placed on node {node!r}, which is not a node "
                            "of this agent: register it now, or later?"})
    waiting = {row["node"] for row in plan["nodes"] if row["outcome"] in ("later", "open")}
    plan["placement"] = [dict(row, outcome="write" if row["node"] in ctx["known_nodes"]
                              and row["node"] not in waiting else "deferred")
                         for row in policy]
    plan["records"] = _migrate_records_plan(ctx, answers)
    plan["questions"].extend(plan["records"].pop("questions"))
    settings = _migrate_settings_plan(ctx, excludes, answers)
    plan["settings"] = settings["settings"]
    plan["questions"].extend(settings["questions"])
    plan["warnings"].extend(settings["warnings"])
    for entry in plan["settings"]:
        for found in entry["host_paths"]:
            plan["warnings"].append(f"{entry['document']} settings carry a host path, which "
                                    f"every node will read: {found}")
    files = _migrate_record_files(ctx["envelope"], ctx["manifests"])
    mover_files = [Path(p) for r in movers.values() if r.get("ok")
                   for p in (r.get("files") or [])]
    plan["files"] = [str(p) for p in files + [p for p in mover_files if p not in files]]
    git = _migrate_git_state(root, [Path(p) for p in plan["files"]])
    plan["git"] = git
    for path, state in sorted(git.items()):
        if state == "modified":
            plan["warnings"].append(f"{path} differs from its committed copy; the working "
                                    "tree is what moves")
    if ctx["mode"] == "store":
        plan["stale"] = _migrate_stale(ctx)
    plan["verify_only"] = _migrate_siblings(ctx, plan["files"], ctx.get("given_roots") or [])
    return plan


def _migrate_stale(ctx: dict) -> list[str]:
    """For an agent whose records were already in the store: where its files
    still say otherwise. Never a failure; they are removed."""
    store = _store_module()
    envelope = ctx["envelope"]
    out = []
    try:
        files = store.FileRecords(envelope, _CONFIG_HOME, ctx["agent_id"], ctx["slug"],
                                  include_global=False)
        stored = store.StoreRecords(envelope, _CONFIG_HOME, ctx["agent_id"], ctx["slug"],
                                    include_global=False, project_root=ctx["root"])
        try:
            for name in sorted(set(_import_names(envelope))
                               | set(_import_identifier_names(envelope))):
                for collection in ("connection", "identifier"):
                    left = {k: r["value"] for k, r in
                            files.resolve_scope(name, collection, "project").items()}
                    right = {k: r["value"] for k, r in
                             stored.resolve_scope(name, collection, "project").items()}
                    for key in sorted(left):
                        if left.get(key) != right.get(key):
                            out.append(f"{name} {collection} {key}: the file says "
                                       f"{json.dumps(left.get(key), sort_keys=True)}, the "
                                       f"store {json.dumps(right.get(key), sort_keys=True)}")
            left = {k: r["value"] for k, r in
                    files.resolve_scope("capabilities", "policy", "project").items()}
            right = {k: r["value"] for k, r in
                     stored.resolve_scope("capabilities", "policy", "project").items()}
            for key in sorted(left):
                if left.get(key) != right.get(key):
                    out.append(f"policy {key}: the file says {json.dumps(left.get(key))}, "
                               f"the store {json.dumps(right.get(key))}")
        finally:
            stored.close()
    except store.StoreError as exc:
        out.append(f"the stale files could not all be read: {exc.message}")
    return out


def _migrate_siblings(ctx: dict, files: list[str], given: list[str]) -> list[dict]:
    """Other roots on this machine holding the same agent - a worktree, a
    deploy checkout: verify-only, their differences named, nothing written."""
    out = []
    here = Path(ctx["root"]).resolve()
    for entry in _migrate_discover(given):
        if entry.get("id") != ctx["agent_id"] or Path(entry["root"]) == here:
            continue
        other = Path(entry["envelope"])
        differences = []
        for path in files:
            try:
                relative = Path(path).relative_to(ctx["envelope"])
            except ValueError:
                continue
            mine, theirs = Path(path), other / relative
            if not theirs.is_file():
                differences.append(f"{relative}: absent there")
            elif theirs.read_bytes() != mine.read_bytes():
                differences.append(f"{relative}: differs")
        out.append({"root": entry["root"], "sources": entry["sources"],
                    "differences": differences})
    return out


def _migrate_git_main(root: Path) -> Path | None:
    """The main working tree of the repository a linked git worktree belongs
    to; None where the root is no linked worktree."""
    try:
        dirs = subprocess.run(["git", "-C", str(root), "rev-parse", "--path-format=absolute",
                               "--git-dir", "--git-common-dir"], capture_output=True,
                              text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return None
    lines = dirs.stdout.split()
    if dirs.returncode != 0 or len(lines) != 2:
        return None
    if Path(lines[0]).resolve() == Path(lines[1]).resolve():
        return None
    try:
        listed = subprocess.run(["git", "-C", str(root), "worktree", "list", "--porcelain"],
                                capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return None
    for line in listed.stdout.splitlines() if listed.returncode == 0 else []:
        if line.startswith("worktree "):
            return Path(line[len("worktree "):]).resolve()
    return None


_MIGRATE_MODE_RANK = {"files": 0, "connections": 1, "store": 2}


def _migrate_main_checkout(ctx: dict) -> dict | None:
    """The agent's main checkout, where this root is a second one of it: a
    linked git worktree of a checkout holding the same id, another root whose
    open migration journal names it, or another root of the same id whose
    records already went further into the store than this one's. A second
    checkout only verifies; its files never write, remove or freeze the
    agent's rows. None where this root is the agent's own."""
    store = _store_module()
    here = Path(ctx["root"]).resolve()
    agent_id = ctx["agent_id"]
    main = _migrate_git_main(here)
    if main is not None and main != here:
        envelope = _migrate_body_envelope(main)
        if _migrate_root_id(envelope, main) == agent_id:
            return {"root": str(main), "envelope": str(envelope),
                    "why": f"{here} is a linked git worktree of {main}"}
    journal = ctx.get("journal") or {}
    started = journal.get("root")
    if started and journal.get("phase") != "finalized":
        started_at = Path(started).resolve()
        if started_at != here and started_at.is_dir():
            return {"root": str(started_at),
                    "envelope": str(_migrate_body_envelope(started_at)),
                    "why": f"the open migration of {agent_id} was started in {started_at}"}
    mine = _MIGRATE_MODE_RANK.get(ctx["mode"], 0)
    for entry in _migrate_discover(ctx.get("given_roots") or []):
        other = Path(entry["root"]).resolve()
        if entry.get("id") != agent_id or other == here or _migrate_git_main(other):
            continue
        envelope = Path(entry["envelope"])
        try:
            theirs = ("store" if store.records_mode(envelope) == "store"
                      else "connections" if store.connections_mode(envelope) == "store"
                      else "files")
        except store.StoreError:
            continue
        if _MIGRATE_MODE_RANK[theirs] > mine:
            return {"root": str(other), "envelope": str(envelope),
                    "why": f"{other} already keeps the agent's records in the store "
                           f"({theirs}) and this root's files do not"}
    # Whether or not the checkout that put them there is on this disk: rows
    # this root's files do not keep there were written from another checkout,
    # and these files would overwrite and remove them.
    if ctx["mode"] == "store" or ((ctx.get("state") or {}).get("migrated_at")):
        return None
    if started and Path(started).resolve() == here:
        return None
    if str(here) == str((ctx.get("answers") or {}).get("checkout") or ""):
        return None
    conn, _setting = _migrate_connect(ctx["root"])
    try:
        held = {}
        for collection, table in (("grant", "capabilities_connection_grants"),
                                  ("identifier", "capabilities_identifiers"),
                                  ("policy", "capabilities_policy")):
            if ctx["mode"] == "connections" and collection == "grant":
                continue
            rows = _migrate_rows(conn, f"SELECT count(*) FROM {table} WHERE agent_id = %s",
                                 (agent_id,))
            if rows and rows[0][0]:
                held[collection] = int(rows[0][0])
    finally:
        conn.close()
    if held:
        return {"root": None, "envelope": None, "held": held,
                "why": f"the store already keeps agent {agent_id}'s records ("
                       + ", ".join(f"{n} {c} row(s)" for c, n in sorted(held.items()))
                       + f") that this root's files ({ctx['mode']}) do not keep there, "
                       "written from a checkout of the agent this run cannot find"}
    return None


def _migrate_checkout_differences(ctx: dict, main: dict) -> list[str]:
    """Where this second checkout's record and settings files differ from the
    main checkout's: named, never written."""
    out = []
    if main.get("envelope") is None:
        return out
    mine_env, theirs_env = Path(ctx["envelope"]), Path(main["envelope"])
    mine = {p.relative_to(mine_env) for p in _migrate_record_files(mine_env, ctx["manifests"])}
    theirs = {p.relative_to(theirs_env)
              for p in _migrate_record_files(theirs_env, ctx["manifests"])}
    for relative in sorted(mine | theirs):
        if relative not in theirs:
            out.append(f"{relative}: only here")
        elif relative not in mine:
            out.append(f"{relative}: only in the main checkout")
        elif (mine_env / relative).read_bytes() != (theirs_env / relative).read_bytes():
            out.append(f"{relative}: differs")
    return out


# --- one agent: the write -----------------------------------------------------------

def _migrate_archive(ctx: dict, journal: dict, files: list[str], git: dict) -> None:
    """Copy every file git does not hold as it stands - untracked, ignored, or
    changed since its commit - into the agent's archive in the state home, each
    0600, before anything changes it."""
    if journal.get("archive"):
        return
    stamp = _utc_now().replace(":", "")
    archive = _migrate_home(ctx["agent_id"]) / "archive" / stamp
    kept = []
    for path in files:
        if git.get(path) == "tracked":
            continue
        source = Path(path)
        if not source.is_file():
            continue
        try:
            relative = source.relative_to(ctx["root"])
        except ValueError:
            relative = Path(source.name)
        target = archive / relative
        target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        shutil.copyfile(source, target)
        target.chmod(0o600)
        kept.append(str(target))
    journal["archive"] = {"dir": str(archive), "files": kept}


def _migrate_launchd_plists(root: Path) -> list[tuple[str, Path]]:
    """The launchd agents of this user that run something of this root."""
    library = Path.home() / "Library" / "LaunchAgents"
    out = []
    if not library.is_dir():
        return out
    import plistlib
    marker = str(root.resolve())
    for path in sorted(library.glob("*.plist")):
        try:
            text = path.read_bytes()
            body = plistlib.loads(text)
        except Exception:
            continue
        if marker.encode() not in text or not isinstance(body, dict):
            continue
        label = body.get("Label")
        if isinstance(label, str) and label:
            out.append((label, path))
    return out


def _migrate_answer_paused(answer) -> bool:
    """Whether a service's status says it holds a pause already: `paused`
    true, or a `pause` naming when it was set, every lane, or some lanes."""
    if isinstance(answer, list):
        return any(_migrate_answer_paused(value) for value in answer)
    if not isinstance(answer, dict):
        return False
    if answer.get("paused") is True:
        return True
    pause = answer.get("pause")
    if isinstance(pause, dict) and (pause.get("at") or pause.get("all") or pause.get("lanes")):
        return True
    return any(_migrate_answer_paused(value) for value in answer.values()
               if isinstance(value, (dict, list)))


def _migrate_stop_services(ctx: dict, journal: dict) -> None:
    """Stop this agent's launchd agents on this machine and pause its services
    that take a pause, recording each in the journal so finalize undoes
    exactly what this did. A service already paused by someone is left as it
    is and stays paused."""
    if journal.get("services") is not None:
        return
    root = ctx["root"]
    done: dict = {"launchd": [], "paused": [], "left": []}
    launchctl = shutil.which("launchctl")
    if launchctl:
        domain = f"gui/{os.getuid()}"
        for label, plist in _migrate_launchd_plists(root):
            loaded = subprocess.run([launchctl, "print", f"{domain}/{label}"],
                                    capture_output=True, text=True, timeout=30)
            if loaded.returncode != 0:
                continue
            stopped = subprocess.run([launchctl, "bootout", f"{domain}/{label}"],
                                     capture_output=True, text=True, timeout=60)
            done["launchd"].append({"label": label, "plist": str(plist),
                                    "stopped": stopped.returncode == 0,
                                    **({} if stopped.returncode == 0 else
                                       {"error": (stopped.stderr or stopped.stdout).strip()})})
    for name, manifest in sorted(ctx["manifests"].items()):
        verbs = ((manifest.get("service") or {}).get("verbs") or [])
        if "pause" not in verbs or "resume" not in verbs:
            continue
        script = CAP_HOME / name / name
        env = _migrate_mover_env(root, ctx["agent_id"])
        rc, stdout, _err = _run_script(script, ["service", "status"], cwd=root, env=env,
                                       timeout=MIGRATE_SERVICE_TIMEOUT)
        try:
            status = json.loads(stdout) if rc == 0 else None
        except ValueError:
            status = None
        if status is None:
            done["left"].append({"capability": name, "reason": "no service status here"})
            continue
        if _migrate_answer_paused(status):
            done["left"].append({"capability": name, "reason": "already paused"})
            continue
        rc, _out, err = _run_script(script, ["service", "pause", "--reason",
                                             f"capabilities migrate of {ctx['agent_id']}"],
                                    cwd=root, env=env, timeout=MIGRATE_SERVICE_TIMEOUT)
        if rc == 0:
            done["paused"].append(name)
        else:
            done["left"].append({"capability": name, "reason": (err or "").strip()[-500:]})
    journal["services"] = done


def _migrate_resume_services(ctx: dict, journal: dict) -> dict:
    services = journal.get("services") or {}
    resumed: dict = {"launchd": [], "resumed": [], "failed": []}
    launchctl = shutil.which("launchctl")
    for entry in services.get("launchd") or []:
        if not entry.get("stopped") or not launchctl:
            continue
        rc = subprocess.run([launchctl, "bootstrap", f"gui/{os.getuid()}", entry["plist"]],
                            capture_output=True, text=True, timeout=60)
        (resumed["launchd"] if rc.returncode == 0 else resumed["failed"]).append(entry["label"])
    for name in services.get("paused") or []:
        rc, _out, err = _run_script(CAP_HOME / name / name, ["service", "resume"],
                                    cwd=ctx["root"],
                                    env=_migrate_mover_env(ctx["root"], ctx["agent_id"]),
                                    timeout=MIGRATE_SERVICE_TIMEOUT)
        (resumed["resumed"] if rc == 0 else resumed["failed"]).append(name)
    journal["services_resumed"] = resumed
    return resumed


def _migrate_writer(ctx: dict):
    """The records adapter the migration writes settings through: this agent
    on its master, as `migrate`."""
    store = _store_module()
    conn, _setting = _migrate_connect(ctx["root"])
    try:
        state = _migrate_agent_state(conn, ctx["agent_id"]) or {}
    finally:
        conn.close()
    return store.AgentRecords(ctx["envelope"], _CONFIG_HOME, ctx["agent_id"], ctx["slug"],
                              agent=state, node=ctx["node"], project_root=ctx["root"],
                              actor=MIGRATE_ACTOR)


def _migrate_kernel(ctx: dict, work):
    """`work(conn)` in one transaction on the agent's store, its tables
    brought to this code's version first."""
    store = _store_module()
    db = _db_module()
    conn, _setting = _migrate_connect(ctx["root"])
    import psycopg
    try:
        major, minor = store.STORE_TABLES_VERSION
        db.migrate(conn, store.STORE_OWNER, store.record_table_steps(),
                   major=major, minor=minor)
        with conn.transaction():
            return work(conn)
    except db.DbError as exc:
        raise _MigrateRefusal(exc.slug, exc.message, exc.hint,
                              exit_code=_store_error_exit(exc)) from None
    except psycopg.OperationalError as exc:
        raise _MigrateRefusal("store_unreachable", f"cannot reach the store: {exc}",
                              "check it with `capabilities store doctor`", exit_code=5) from None
    except psycopg.Error as exc:
        raise _MigrateRefusal("store_write_failed", f"the store refused the write: {exc}",
                              exit_code=5) from None
    finally:
        conn.close()


def _migrate_register(ctx: dict, plan: dict) -> dict:
    """The agent row and its master: registered on the first run, the row
    marked `migrating_since` from here until finalize; and each target node a
    person said to register."""
    agent_id, node = ctx["agent_id"], ctx["node"]
    name = None
    try:
        import tomllib
        config = tomllib.loads((ctx["root"] / CONTEXTKIT_CONFIG_REL).read_text())
        name = ((config.get("identity") or {}).get("name") or "").strip() or None
    except (OSError, ValueError, AttributeError):
        pass
    kind = "mac" if sys.platform == "darwin" else "server"

    def work(conn):
        created = _ensure_agent_row(conn, agent_id)
        if name:
            conn.execute("UPDATE capabilities_agents SET name = %s WHERE id = %s "
                         "AND name IS NULL", (name, agent_id))
        master = conn.execute("SELECT node FROM capabilities_agent_nodes "
                              "WHERE agent_id = %s AND is_master", (agent_id,)).fetchone()
        registered = []
        if master is None:
            conn.execute("INSERT INTO capabilities_agent_nodes (agent_id, node, kind, "
                         "is_master) VALUES (%s, %s, %s, true) ON CONFLICT (agent_id, node) "
                         "DO UPDATE SET is_master = true", (agent_id, node, kind))
            registered.append({"node": node, "kind": kind, "master": True})
        elif master[0] != node:
            raise _MigrateRefusal("not_master", f"node {node} is not the master of agent "
                                  f"{agent_id}; its master is {master[0]}",
                                  f"run `capabilities migrate` on {master[0]}")
        for row in plan["nodes"]:
            if row["outcome"] != "register":
                continue
            conn.execute("INSERT INTO capabilities_agent_nodes (agent_id, node, kind, address, "
                         "target) VALUES (%s, %s, %s, %s, %s) ON CONFLICT (agent_id, node) "
                         "DO NOTHING", (agent_id, row["node"], row.get("kind") or "server",
                                        row.get("address"), row.get("target")))
            registered.append({"node": row["node"], "kind": row.get("kind") or "server",
                               "target": row.get("target")})
        conn.execute("UPDATE capabilities_agents SET migrating_since = now(), "
                     "updated_at = now() WHERE id = %s AND migrating_since IS NULL",
                     (agent_id,))
        since = conn.execute("SELECT migrating_since FROM capabilities_agents WHERE id = %s",
                             (agent_id,)).fetchone()[0]
        return {"agent_created": created, "nodes_registered": registered,
                "migrating_since": _store_module()._stamp(since)}
    return _migrate_kernel(ctx, work)


def _migrate_write_records(ctx: dict, plan: dict) -> dict:
    """The agent's records rows, as planned, in one transaction: connection
    specs, its grants and default, its identifiers and its gate, and the
    placement rows naming registered nodes; rows of the agent the files do not
    hold are removed."""
    agent_id = ctx["agent_id"]
    records = plan["records"]
    written = {"connections": 0, "grants": 0, "identifiers": 0, "policy": 0,
               "placement": 0, "removed": 0}

    def work(conn):
        for row in records["connections"]:
            if row["outcome"] not in ("write", "replace"):
                continue
            conn.execute("INSERT INTO capabilities_connections (capability, name, spec) "
                         "VALUES (%s, %s, %s::jsonb) ON CONFLICT (capability, name) "
                         "DO UPDATE SET spec = EXCLUDED.spec",
                         (row["capability"], row["name"],
                          json.dumps(row["spec"], ensure_ascii=False)))
            written["connections"] += 1
        for entry in records["remove"]:
            kind, name, key = entry["kind"], entry["capability"], entry["name"]
            if kind == "grant":
                conn.execute("DELETE FROM capabilities_connection_grants WHERE agent_id = %s "
                             "AND capability = %s AND connection = %s AND node IS NULL",
                             (agent_id, name, key))
            elif kind == "identifier":
                conn.execute("DELETE FROM capabilities_identifiers WHERE agent_id = %s "
                             "AND capability = %s AND label = %s AND node IS NULL",
                             (agent_id, name, key))
            else:
                conn.execute("DELETE FROM capabilities_policy WHERE agent_id = %s "
                             "AND capability = %s AND node IS NULL", (agent_id, name))
            written["removed"] += 1
        for row in records["grants"]:
            if row["outcome"] != "write":
                continue
            if row["is_default"]:
                conn.execute("UPDATE capabilities_connection_grants SET is_default = false "
                             "WHERE agent_id = %s AND capability = %s AND node IS NULL "
                             "AND connection <> %s AND is_default",
                             (agent_id, row["capability"], row["connection"]))
            conn.execute(
                "INSERT INTO capabilities_connection_grants (agent_id, capability, "
                "connection, node, enabled, allow_write, is_default) "
                "VALUES (%s, %s, %s, NULL, %s, %s, %s) "
                "ON CONFLICT ((coalesce(agent_id, '')), capability, connection, "
                "(coalesce(node, ''))) DO UPDATE SET enabled = EXCLUDED.enabled, "
                "allow_write = EXCLUDED.allow_write, is_default = EXCLUDED.is_default",
                (agent_id, row["capability"], row["connection"], row["enabled"],
                 row["allow_write"], row["is_default"]))
            written["grants"] += 1
        for row in records["identifiers"]:
            if row["outcome"] != "write":
                continue
            conn.execute(
                "INSERT INTO capabilities_identifiers (agent_id, capability, node, label, "
                "value, note) VALUES (%s, %s, NULL, %s, %s::jsonb, %s) "
                "ON CONFLICT ((coalesce(agent_id, '')), capability, label, "
                "(coalesce(node, ''))) DO UPDATE SET value = EXCLUDED.value, "
                "note = EXCLUDED.note, updated_at = now()",
                (agent_id, row["capability"], row["label"],
                 json.dumps(row["value"], ensure_ascii=False), row["note"]))
            written["identifiers"] += 1
        for row in records["policy"] + [r for r in plan["placement"] if r["outcome"] == "write"]:
            if row.get("outcome") == "held":
                continue
            conn.execute(
                "INSERT INTO capabilities_policy (agent_id, capability, node, enabled) "
                "VALUES (%s, %s, %s, %s) ON CONFLICT ((coalesce(agent_id, '')), capability, "
                "(coalesce(node, ''))) DO UPDATE SET enabled = EXCLUDED.enabled, "
                "updated_at = now()", (agent_id, row["capability"], row["node"],
                                       row["enabled"]))
            written["placement" if row["node"] else "policy"] += 1
        return written
    return _migrate_kernel(ctx, work)


def _migrate_write_settings(ctx: dict, plan: dict) -> dict:
    """Each settings document as rows, through the adapter's one writer: the
    trail names `migrate@<node>`, and a document the rows already hold as
    the file says is left alone."""
    store = _store_module()
    writer = _migrate_writer(ctx)
    written = {}
    try:
        for entry in plan["settings"]:
            # The files are read again here: a mover may have rewritten them.
            wanted, problem, _questions, _warnings = _migrate_settings_document(
                entry, ctx.get("answers") or {})
            if problem:
                raise _MigrateRefusal("settings_unreadable", problem)
            if wanted is None:
                continue
            result = writer.settings_write(entry["document"], "project",
                                           lambda _current, wanted=wanted: wanted,
                                           actor=MIGRATE_ACTOR)
            written[entry["document"]] = {"changed": result["changed"],
                                          "generation": result["generation"]}
    except store.StoreError as exc:
        raise _MigrateRefusal(exc.slug, exc.message, exc.hint,
                              exit_code=_store_error_exit(exc)) from None
    finally:
        writer.close()
    return written


# --- one agent: verify --------------------------------------------------------------

def _migrate_verify(ctx: dict, plan: dict) -> list[str]:
    """Read everything back through the store as this agent's master will read
    it once it has moved, and compare it both ways with what its files
    resolve: connections and their grants and default, identifiers, the gate,
    each settings document, the placement rows. An agent whose records were
    already in the store compares only what moved now."""
    store = _store_module()
    differences: list[str] = []
    envelope, agent_id = ctx["envelope"], ctx["agent_id"]
    files = store.FileRecords(envelope, _migrate_global_home(ctx), agent_id, ctx["slug"])
    rows = _migrate_writer(ctx)
    rows.actor = None
    try:
        mode = ctx["mode"]
        if mode == "files":
            names = sorted(set(_import_names(envelope))
                           | {r["capability"] for r in plan["records"]["grants"]})
            # What the agent reads once it moved: a connection renamed for it
            # under its new name, and one whose store spec it kept as the
            # store holds it.
            renames = _migrate_renames(ctx.get("answers") or {})
            kept = {(r["capability"], r["name"]): r["store"]
                    for r in plan["records"]["connections"] if r["outcome"] == "kept"}
            for name in names:
                for write_default in (False, True):
                    before = files.connections(name, write_default=write_default,
                                               include_disabled=True)
                    after = rows.connections(name, write_default=write_default,
                                             include_disabled=True)
                    before = {renames.get((name, cid)) or cid: e for cid, e in before.items()}
                    before = {cid: ({**e, "value": kept[(name, cid)]}
                                    if (name, cid) in kept else e)
                              for cid, e in before.items()}
                    usable_before = {cid: (e["value"], e["allow_write"])
                                     for cid, e in before.items() if e["enabled"]}
                    usable_after = {cid: (e["value"], e["allow_write"])
                                    for cid, e in after.items() if e["enabled"]}
                    for cid in sorted(set(usable_before) | set(usable_after)):
                        if usable_before.get(cid) != usable_after.get(cid):
                            differences.append(
                                f"{name} connection {cid} (write default {write_default}): "
                                f"the files resolve {usable_before.get(cid)}, the store "
                                f"{usable_after.get(cid)}")
                left = files.get(name, "setting", "connection.default")
                left = renames.get((name, left)) or left
                right = rows.get(name, "setting", "connection.default")
                if left != right:
                    differences.append(f"{name} default: the files point to {left!r}, the "
                                       f"store to {right!r}")
        if mode in ("files", "connections"):
            names = sorted(set(_import_identifier_names(envelope))
                           | {r["capability"] for r in plan["records"]["identifiers"]})
            for name in names:
                left = {k: (r["value"], r["note"] or "")
                        for k, r in files.resolve(name, "identifier").items()}
                right = {k: (r["value"], r["note"] or "")
                         for k, r in rows.resolve(name, "identifier").items()}
                for key in sorted(set(left) | set(right)):
                    if left.get(key) != right.get(key):
                        differences.append(f"{name} identifier {key}: the files resolve "
                                           f"{left.get(key)}, the store {right.get(key)}")
            left = {k: r["value"] for k, r in files.resolve("capabilities", "policy").items()}
            right = {k: r["value"] for k, r in rows.resolve("capabilities", "policy").items()}
            for key in sorted(set(left) | set(right)):
                if left.get(key) != right.get(key):
                    differences.append(f"gate {key}: the files resolve {left.get(key)}, "
                                       f"the store {right.get(key)}")
        moved = set()
        for entry in plan["settings"]:
            wanted, _problem, _questions, _warnings = _migrate_settings_document(
                entry, ctx.get("answers") or {})
            wanted = wanted if wanted is not None else {}
            held = rows.setting_document(entry["document"], "project")
            moved.add(entry["document"])
            if held != wanted:
                differences.append(f"{entry['document']} settings: the file says "
                                   f"{json.dumps(wanted, sort_keys=True)[:400]}, the store "
                                   f"{json.dumps(held, sort_keys=True)[:400]}")
        conn, _setting = _migrate_connect(ctx["root"])
        try:
            extra = {doc for (doc,) in _migrate_rows(
                conn, "SELECT DISTINCT capability FROM capabilities_settings_documents "
                      "WHERE agent_id = %s AND node IS NULL", (agent_id,))}
            placed = _migrate_policy_rows(conn, agent_id)
        finally:
            conn.close()
        for doc in sorted(extra - moved):
            differences.append(f"{doc} settings: the store holds a document for this agent "
                               "that no file of it says")
        for row in plan["placement"]:
            if row["outcome"] == "write" and \
                    placed.get((row["capability"], row["node"])) is not row["enabled"]:
                differences.append(f"placement {row['capability']}@{row['node']}: the store "
                                   "does not hold it")
    except store.StoreError as exc:
        differences.append(f"reading back failed: {exc.message}")
    finally:
        rows.close()
    return differences


# --- one agent: finalize -------------------------------------------------------------

def _migrate_remove_files(ctx: dict, files: list[str]) -> list[str]:
    removed = []
    folders = set()
    for path in files:
        target = Path(path)
        if target.is_file():
            target.unlink()
            removed.append(path)
            folders.add(target.parent)
    envelope = Path(ctx["envelope"]).resolve()
    for folder in sorted(folders, key=lambda p: len(p.parts), reverse=True):
        here = folder
        while here.resolve() != envelope and envelope in here.resolve().parents:
            try:
                here.rmdir()
            except OSError:
                break
            here = here.parent
    return removed


def _migrate_finalize(ctx: dict, plan: dict | None, journal: dict) -> dict:
    """Switch the agent: every target's node registered, then `migrated_at`
    set and `migrating_since` cleared in one transaction, `"records":
    "store"` in project.json, the files removed, the services resumed."""
    agent_id = ctx["agent_id"]
    targets = journal.get("target_nodes") or []

    def work(conn):
        held = {row[0] for row in conn.execute(
            "SELECT node FROM capabilities_agent_nodes WHERE agent_id = %s",
            (agent_id,)).fetchall()}
        missing = [node for node in targets if node not in held]
        if missing:
            raise _MigrateRefusal(
                "target_node_unregistered",
                f"the deployment target node(s) {', '.join(missing)} of agent {agent_id} "
                "are not registered, and placement can name only a registered node",
                "register each with `capabilities node add <node> --kind server --target "
                "<target>` on this master, then run `capabilities migrate --apply` again",
                detail={"nodes": missing})
        moved = conn.execute("UPDATE capabilities_agents SET migrated_at = coalesce("
                             "migrated_at, now()), migrating_since = NULL, updated_at = now() "
                             "WHERE id = %s RETURNING migrated_at", (agent_id,)).fetchone()
        return _store_module()._stamp(moved[0])
    migrated_at = _migrate_kernel(ctx, work)
    journal["phase"] = "finalizing"
    journal["migrated_at"] = migrated_at
    _migrate_journal_save(agent_id, journal)
    identity = _read_json(ctx["identity_file"])
    identity = identity if isinstance(identity, dict) else {}
    store = _store_module()
    if identity.get(store.RECORDS_MODE_KEY) != "store" or store.CONNECTIONS_MODE_KEY in identity:
        identity[store.RECORDS_MODE_KEY] = "store"
        identity.pop(store.CONNECTIONS_MODE_KEY, None)
        _write_json(ctx["identity_file"], identity)
    removed = _migrate_remove_files(ctx, journal.get("files") or [])
    journal["removed"] = sorted(set(journal.get("removed") or []) | set(removed))
    resumed = _migrate_resume_services(ctx, journal)
    journal["phase"] = "finalized"
    journal["finished_at"] = _utc_now()
    _migrate_journal_save(agent_id, journal)
    return {"migrated_at": migrated_at, "removed": journal["removed"],
            "archive": journal.get("archive"), "services": resumed,
            "identity": str(ctx["identity_file"])}


# --- one agent: the run ---------------------------------------------------------------

def _migrate_summary(plan: dict) -> dict:
    """The plan as a person reads it, without the documents' whole values."""
    settings = [{k: v for k, v in entry.items() if k != "document_value"}
                for entry in plan.get("settings") or []]
    records = {key: value for key, value in (plan.get("records") or {}).items()}
    movers = {}
    for name, report in (plan.get("movers") or {}).items():
        movers[name] = {k: v for k, v in report.items()
                        if k not in ("capability", "action", "mover")}
    return {**{k: v for k, v in plan.items() if k not in ("settings", "records", "movers")},
            "settings": settings, "records": records, "movers": movers}


def cmd_migrate_agent(opts: dict) -> None:
    root = _require_project()
    answers = _migrate_answers(opts.get("answers"))
    apply = bool(opts.get("apply"))
    if apply:
        _read_only_gate("migrate --apply")
    else:
        _migrate_read_only()
    try:
        ctx = _migrate_context(root, opts, answers)
    except _MigrateRefusal as exc:
        _migrate_refuse(exc)
    state = ctx["state"] or {}
    journal = ctx["journal"]
    answer: dict = {"ok": True, "project": str(root), "agent_id": ctx["agent_id"],
                    "node": ctx["node"], "mode": ctx["mode"],
                    "applied": apply, "store": {"level": ctx["setting"].level,
                                                "schema": ctx["setting"].schema}}
    if ctx.get("tables_to_upgrade") and not apply:
        answer["tables_to_upgrade"] = {_store_module().STORE_OWNER: ctx["tables_to_upgrade"]}
    main = _migrate_main_checkout(ctx)
    if main is not None:
        # A second checkout of the agent only verifies: whatever its files
        # say, the agent's rows are written, removed and frozen from its main
        # checkout alone.
        answer["second_checkout"] = {
            "main": main["root"], "why": main["why"],
            "differences": _migrate_checkout_differences(ctx, main)}
    if state.get("migrated_at"):
        unfinished = (main is None and journal is not None
                      and journal.get("phase") == "finalizing"
                      and journal.get("node") == ctx["node"])
        if unfinished and apply:
            # Interrupted after the switch: finish what finalize had left.
            for blocker in ctx["blockers"]:
                if blocker.code in ("node_unnamed", "node_mismatch", "not_master"):
                    _migrate_refuse(blocker, answer)
            try:
                answer.update(state="migrated", resumed=True,
                              **_migrate_finalize(ctx, None, journal))
            except _MigrateRefusal as exc:
                _migrate_refuse(exc, answer)
            _emit(answer)
            return
        left = [str(p) for p in _migrate_record_files(ctx["envelope"], ctx["manifests"])]
        answer.update(state="migrated", migrated_at=state["migrated_at"], changed=False,
                      files_left=left)
        if unfinished:
            answer["finalize_pending"] = True
            answer["hint"] = "`capabilities migrate --apply` finishes the finalize"
        elif left:
            answer["hint"] = ("these files are no longer read; remove them, or run "
                              "`capabilities migrate --report`")
        _emit(answer)
        return
    answer["state"] = ("migrating" if state.get("migrating_since") else
                       "registered" if state else "unregistered")
    if state.get("migrating_since"):
        answer["migrating_since"] = state["migrating_since"]
    if main is not None and main["root"] is None:
        # No checkout of the agent is known here: a person says whether this
        # one is the agent's, before its files replace and remove any row.
        here = str(Path(root).resolve())
        answer["questions"] = [{
            "id": "checkout", "answer": "checkout", "choices": [here],
            "question": f"{main['why']}. Is {here} the agent's main checkout, whose "
                        "files are to replace the store's rows and remove those they do "
                        f"not hold? Answer `checkout` with {here} to move the agent from "
                        "here; otherwise run `capabilities migrate` in the checkout that "
                        "keeps its records in the store"}]
        ctx["blockers"].insert(0, _MigrateRefusal(
            "second_checkout", f"{root} may be a second checkout of agent "
            f"{ctx['agent_id']}: {main['why']}; nothing is written until a person "
            "answers `checkout`", "answer the question `checkout`, or run `capabilities "
            "migrate` in the agent's main checkout", detail={"held": main["held"]}))
    elif main is not None:
        ctx["blockers"].insert(0, _MigrateRefusal(
            "second_checkout", f"{root} is a second checkout of agent {ctx['agent_id']} "
            f"({main['why']}): it only verifies, and the agent's records move from its "
            f"main checkout {main['root']}, which has not moved yet",
            f"run `capabilities migrate` in {main['root']} first; this checkout then "
            "reads the agent's rows, and its leftover files are removed as a git change "
            "here", detail={"main": main["root"]}))
    answer["blockers"] = [{"code": b.code, "message": b.message, "hint": b.hint}
                          for b in ctx["blockers"]]
    if ctx["id_write"]:
        answer["identity_write"] = {"file": str(ctx["identity_file"]), "id": ctx["id_write"]}
    if apply and ctx["blockers"]:
        _migrate_refuse(ctx["blockers"][0], answer)
    if main is not None:
        answer["would_write"] = False
        _emit(answer)
        return
    if not ctx["node"]:
        # A dry run without a node cannot say what each node would hold.
        _emit(answer)
        return
    try:
        plan = _migrate_plan(ctx, answers)
    except _MigrateRefusal as exc:
        _migrate_refuse(exc, answer)
    answer["plan"] = _migrate_summary(plan)
    answer["questions"] = plan["questions"]
    if not apply:
        # The capabilities' own tables a write would make or bring forward,
        # as each mover read them without changing them.
        for report in plan["movers"].values():
            for owner, pending in (report.get("tables_to_upgrade") or {}).items():
                answer.setdefault("tables_to_upgrade", {})[owner] = pending
    if plan["mover_failures"]:
        failure = _MigrateRefusal(
            "mover_failed", f"{len(plan['mover_failures'])} capability mover(s) could not "
            f"say what they would move: {', '.join(sorted(plan['mover_failures']))}",
            "each one's error is under detail; repair it and run it again",
            detail=plan["mover_failures"])
        if apply:
            _migrate_refuse(failure, answer)
        answer["blockers"].append({"code": failure.code, "message": failure.message,
                                   "detail": failure.detail})
    if not apply:
        answer["would_write"] = not plan["questions"] and not answer["blockers"]
        _emit(answer)
        return
    if plan["questions"]:
        _migrate_refuse(_MigrateRefusal(
            "question_open", f"{len(plan['questions'])} question(s) are open and nothing was "
            "written: " + "; ".join(q["id"] for q in plan["questions"]),
            "answer each in a JSON file at the path its `answer` names and pass it with "
            "--answers"), answer)
    agent_id = ctx["agent_id"]
    waiting = [row["node"] for row in plan["nodes"]
               if row["outcome"] in ("later", "open") and not row["registered"]]
    if waiting and journal and journal.get("phase") in ("written", "verified"):
        # Everything is written and only finalize waits, for a node nobody
        # registered yet: nothing more to do until someone does.
        _migrate_refuse(_MigrateRefusal(
            "target_node_unregistered",
            f"the deployment target node(s) {', '.join(waiting)} of agent {agent_id} are "
            "not registered, and the migration finishes only once they are",
            "register each with `capabilities node add <node> --kind server --target "
            "<target>` on this master, then run `capabilities migrate --apply` again",
            detail={"nodes": waiting}), answer)
    journal = journal if journal and journal.get("phase") != "finalized" else None
    journal = journal or {"schema": MIGRATE_JOURNAL_SCHEMA, "agent_id": agent_id,
                          "root": str(root), "node": ctx["node"], "phase": "writing",
                          "started_at": _utc_now()}
    journal["files"] = sorted(set(journal.get("files") or []) | set(plan["files"]))
    journal["target_nodes"] = sorted(row["node"] for row in plan["nodes"])
    try:
        if ctx["id_write"]:
            identity = _read_json(ctx["identity_file"]) or {}
            identity["id"] = ctx["id_write"]
            identity.setdefault("schema", PROJECT_IDENTITY_SCHEMA)
            identity.setdefault("slug", ctx["slug"])
            _write_json(ctx["identity_file"], identity)
            answer["identity_written"] = ctx["id_write"]
        _migrate_archive(ctx, journal, plan["files"], plan["git"])
        _migrate_journal_save(agent_id, journal)
        answer["registered"] = _migrate_register(ctx, plan)
        ctx["nodes"] = {**ctx["nodes"], **{r["node"]: r for r in
                                           answer["registered"]["nodes_registered"]}}
        _migrate_stop_services(ctx, journal)
        _migrate_journal_save(agent_id, journal)
        answers_file = _migrate_mover_answers(ctx, answers)
        try:
            written = _migrate_run_movers(root, _migrate_movers(ctx["manifests"]), "write",
                                          answers_file, agent_id)
        finally:
            answers_file.unlink(missing_ok=True)
        failed = {name: r["error"] for name, r in written.items() if not r.get("ok")}
        answer["movers"] = {name: {k: v for k, v in r.items()
                                   if k not in ("capability", "action", "mover")}
                            for name, r in written.items()}
        if failed:
            raise _MigrateRefusal("mover_failed", f"{len(failed)} capability mover(s) did "
                                  f"not write: {', '.join(sorted(failed))}",
                                  "repair the cause and run `capabilities migrate --apply` "
                                  "again; the migration resumes", detail=failed)
        # A mover may have changed the files the manager moves - a binding
        # written as an identifier, old settings rewritten - so its own part
        # is planned again from the files as they stand now.
        excludes = {name: r["settings_exclude"] for name, r in plan["movers"].items()
                    if r.get("ok") and r.get("settings_exclude")}
        plan["records"] = _migrate_records_plan(ctx, answers)
        late = plan["records"].pop("questions")
        if late:
            raise _MigrateRefusal("question_open", f"{len(late)} question(s) arose once the "
                                  "capabilities had moved their own files: "
                                  + "; ".join(q["id"] for q in late),
                                  "answer them and run `capabilities migrate --apply` again; "
                                  "the migration resumes", detail={"questions": late})
        settings = _migrate_settings_plan(ctx, excludes, answers)
        if settings["questions"]:
            raise _MigrateRefusal("question_open", f"{len(settings['questions'])} question(s) "
                                  "arose once the capabilities had moved their own files: "
                                  + "; ".join(q["id"] for q in settings["questions"]),
                                  "answer them and run `capabilities migrate --apply` again; "
                                  "the migration resumes",
                                  detail={"questions": settings["questions"]})
        plan["settings"] = settings["settings"]
        now = [str(p) for p in _migrate_record_files(ctx["envelope"], ctx["manifests"])]
        journal["files"] = sorted(set(journal["files"]) | set(now))
        answer["records_written"] = _migrate_write_records(ctx, plan)
        answer["settings_written"] = _migrate_write_settings(ctx, plan)
        journal["phase"] = "written"
        _migrate_journal_save(agent_id, journal)
        answers_file = _migrate_mover_answers(ctx, answers)
        try:
            checked = _migrate_run_movers(root, _migrate_movers(ctx["manifests"]), "verify",
                                          answers_file, agent_id)
        finally:
            answers_file.unlink(missing_ok=True)
        differences = []
        for name, report in checked.items():
            if not report.get("ok"):
                differences.append(f"{name}: its mover could not verify: {report['error']}")
            elif not report.get("verified", True):
                differences.extend(f"{name}: {d}" for d in report.get("differences") or
                                   ["its mover found the store short of the files"])
        differences.extend(_migrate_verify(ctx, plan))
        answer["verify"] = {"differences": differences}
        if differences:
            raise _MigrateRefusal("verify_failed", f"{len(differences)} difference(s) between "
                                  "the files and the store; the agent stays frozen in its "
                                  "migration", "correct the cause and run `capabilities "
                                  "migrate --apply` again, which resumes",
                                  exit_code=7, detail={"differences": differences})
        journal["phase"] = "verified"
        _migrate_journal_save(agent_id, journal)
        answer.update(_migrate_finalize(ctx, plan, journal))
    except _MigrateRefusal as exc:
        _migrate_journal_save(agent_id, journal)
        _migrate_refuse(exc, answer)
    answer["state"] = "migrated"
    answer["commit"] = ("the removed envelope files are deletions for this project to "
                        "commit")
    _emit(answer)


# --- global ---------------------------------------------------------------------------

def _migrate_effective(project: dict, global_rows: dict, name: str, node: str | None):
    """A capability's gate as policy rows decide it: the agent's row for this
    node, its row for every node, then the global ones the same way."""
    for rows in (project, global_rows):
        for at in ((node, None) if node else (None,)):
            if (name, at) in rows:
                return rows[(name, at)]
    return None


def _migrate_global_plan(conn, manifests: dict, answers: dict) -> dict:
    """The config home's records and global settings as global rows, and what
    the store holds of them now: each row it would add, change or remove."""
    store = _store_module()
    files = store.FileRecords(_CONFIG_HOME / "no-project", _CONFIG_HOME)
    plan: dict = {"policy": [], "identifiers": [], "connections": [], "grants": [],
                  "settings": [], "remove": [], "questions": []}
    try:
        gate = files.resolve_scope("capabilities", "policy", "global")
    except store.StoreError as exc:
        raise _MigrateRefusal("files_unreadable", f"global gate: {exc.message}") from None
    held_policy = _migrate_policy_rows(conn, None)
    for name, row in sorted(gate.items()):
        value = row["value"]
        if (not isinstance(value, dict) or not isinstance(value.get("enabled"), bool)):
            raise _MigrateRefusal("files_unreadable", f"the global gate for {name!r} is not "
                                  '{"enabled": true|false}')
        held = held_policy.pop((name, None), None)
        plan["policy"].append({"capability": name, "enabled": value["enabled"],
                               "store": held,
                               "outcome": "held" if held == value["enabled"] else
                               "add" if held is None else "change"})
    for (name, node), enabled in sorted(held_policy.items(), key=lambda k: (k[0][0], k[0][1] or "")):
        if node is None:
            plan["remove"].append({"kind": "policy", "capability": name, "name": name,
                                   "store": enabled})
    held_ids = _migrate_identifier_rows(conn, None)
    names = sorted(p.parent.name for p in _CONFIG_HOME.glob("*/identifiers.json")
                   if store.CAPABILITY_RE.fullmatch(p.parent.name))
    for name in names:
        for label, row in sorted(files.resolve_scope(name, "identifier", "global").items()):
            wanted = (row["value"], row["note"] or "")
            held = held_ids.pop((name, label), None)
            plan["identifiers"].append({"capability": name, "label": label,
                                        "value": wanted[0], "note": wanted[1],
                                        "outcome": "held" if held == wanted else
                                        "add" if held is None else "change"})
    for (name, label), _held in sorted(held_ids.items()):
        plan["remove"].append({"kind": "identifier", "capability": name, "name": label})
    held_specs = _migrate_connection_rows(conn)
    held_grants = _migrate_grant_rows(conn, None)
    for path in sorted(_CONFIG_HOME.glob("*/connections.json")):
        name = path.parent.name
        if not store.CAPABILITY_RE.fullmatch(name):
            continue
        identities = files.resolve_scope(name, "connection", "global")
        grants = files.resolve_scope(name, "grant", "global")
        default = (files.resolve_scope(name, "setting", "global")
                   .get("connection.default") or {}).get("value")
        for cid, row in sorted(identities.items()):
            spec = row["value"]
            held = held_specs.get((name, cid))
            qid = f"connections.{name}/{cid}"
            outcome = "held" if held == spec else "add" if held is None else None
            if outcome is None:
                choice = _migrate_dig(answers, qid)
                outcome = {"files": "change", "store": "kept"}.get(choice, "differs")
                if outcome == "differs":
                    plan["questions"].append({
                        "id": qid, "answer": qid, "choices": ["files", "store"],
                        "question": f"{name} connection {cid!r} is in the store as "
                                    f"{json.dumps(held, sort_keys=True)} and in the config "
                                    f"home as {json.dumps(spec, sort_keys=True)}: keep the "
                                    "store's, or replace it with the config home's?"})
            plan["connections"].append({"capability": name, "name": cid, "spec": spec,
                                        "store": held, "outcome": outcome})
            allow_write = (grants.get(cid) or {}).get("value", {}).get("allow_write")
            is_default = cid == default
            if allow_write is None and not is_default:
                continue
            row_wanted = (None, allow_write, is_default)
            got = held_grants.pop((name, cid), None)
            plan["grants"].append({"capability": name, "connection": cid,
                                   "allow_write": allow_write, "is_default": is_default,
                                   "outcome": "held" if got == row_wanted else
                                   "add" if got is None else "change"})
    for (name, cid), _row in sorted(held_grants.items()):
        plan["remove"].append({"kind": "grant", "capability": name, "name": cid})
    for name, home in _migrate_settings_homes(manifests, "global"):
        path = _CONFIG_HOME / name / home["path"]
        document, problem = _migrate_read_document(path, home.get("format") or "json")
        if problem:
            raise _MigrateRefusal("settings_unreadable", problem)
        if document is None:
            continue
        held = _migrate_setting_rows(conn, None, name)
        plan["settings"].append({"document": name, "file": str(path),
                                 "document_value": document,
                                 "outcome": "held" if held == document else
                                 "add" if held is None else "change",
                                 "host_paths": _migrate_host_paths(document)})
    return plan


def _migrate_database(setting) -> tuple:
    """The database a setting reaches - host, port, database and schema - so
    two roots can be told to read the same rows or not."""
    if setting.url is not None:
        try:
            from psycopg.conninfo import conninfo_to_dict
            params = conninfo_to_dict(setting.url)
        except Exception:
            return ("url", setting.url, setting.schema)
        host, port, database = params.get("host"), params.get("port"), params.get("dbname")
    else:
        host, port, database = setting.host, setting.port, setting.database
    return (str(host or "").lower(), str(port or 5432), str(database or ""), setting.schema)


def _migrate_gate_flips(conn, plan: dict, given: list[str], setting=None) -> list[dict]:
    """Every agent whose effective gate would change once the global rows say
    what the config home says: an agent that reads its gate from the store
    already - its records are there, or it moved - for this node and every
    node. A root on this machine that reads another database is not one of
    them: these global rows never reach it."""
    store = _store_module()
    db = _db_module()
    here = _migrate_database(setting) if setting is not None else None
    before = _migrate_policy_rows(conn, None)
    after = {key: value for key, value in before.items() if key[1] is not None}
    for row in plan["policy"]:
        after[(row["capability"], None)] = row["enabled"]
    agents: dict[str, dict] = {}
    for agent_id, migrated in _migrate_rows(
            conn, "SELECT id, migrated_at FROM capabilities_agents"):
        agents[agent_id] = {"agent_id": agent_id, "reads": "store" if migrated else None}
    for entry in _migrate_discover(given):
        if not entry.get("id"):
            continue
        if here is not None:
            try:
                if _migrate_database(db.resolve_setting(Path(entry["root"]))) != here:
                    continue
            except db.DbError:
                continue
        try:
            mode = store.records_mode(Path(entry["envelope"]))
        except store.StoreError:
            continue
        found = agents.setdefault(entry["id"], {"agent_id": entry["id"], "reads": None})
        found["root"] = entry["root"]
        if mode == "store":
            found["reads"] = "store"
    node = os.environ.get(store.NODE_NAME_ENV, "").strip() or None
    names = sorted({key[0] for key in before} | {key[0] for key in after})
    flips = []
    for agent_id, entry in sorted(agents.items()):
        if entry["reads"] != "store":
            continue
        project = _migrate_policy_rows(conn, agent_id)
        changed = []
        for name in names:
            was = _migrate_effective(project, before, name, node)
            now = _migrate_effective(project, after, name, node)
            if bool(was) != bool(now):
                changed.append({"capability": name, "was": bool(was), "now": bool(now)})
        if changed:
            flips.append({**entry, "flips": changed})
    return flips


def cmd_migrate_global(opts: dict) -> None:
    """`migrate --global`: the config home's gate, identifiers, connections,
    grants, default and global settings become the global rows every agent
    inherits, and the store records `global_migrated_at`."""
    answers = _migrate_answers(opts.get("answers"))
    apply = bool(opts.get("apply"))
    if apply:
        _read_only_gate("migrate --global --apply")
    else:
        _migrate_read_only()
    root = _project_root() or Path.cwd()
    try:
        conn, setting = _migrate_connect(root)
    except _MigrateRefusal as exc:
        _migrate_refuse(exc)
    manifests = _migrate_manifests()
    answer: dict = {"ok": True, "scope": "global", "config_home": str(_CONFIG_HOME),
                    "applied": apply, "store": {"level": setting.level,
                                                "schema": setting.schema}}
    # The plan reads the global rows as this code keeps them. A dry run
    # changes nothing, the tables' schema included: it names the steps an
    # apply would run and reads the store as they would leave it. An apply
    # runs them first.
    try:
        if apply:
            upgraded = _migrate_upgrade_tables(conn)
            if upgraded:
                major, minor = _store_module().STORE_TABLES_VERSION
                answer["tables_upgraded"] = {"steps": upgraded,
                                             "version": f"{major}.{minor}"}
        else:
            pending = _migrate_tables_pending(conn)
            if pending:
                answer["tables_to_upgrade"] = {_store_module().STORE_OWNER: pending}
    except _MigrateRefusal as exc:
        conn.close()
        _migrate_refuse(exc, answer)
    refused = None
    try:
        answer["global_migrated_at"] = _migrate_global_at(conn)
        plan = _migrate_global_plan(conn, manifests, answers)
        flips = _migrate_gate_flips(conn, plan, opts.get("roots") or [], setting)
    except _MigrateRefusal as exc:
        refused = exc
    finally:
        conn.close()
    if refused is not None:
        _migrate_refuse(refused, answer)
    answer["plan"] = {**{k: v for k, v in plan.items() if k not in ("settings", "questions")},
                      "settings": [{k: v for k, v in e.items() if k != "document_value"}
                                   for e in plan["settings"]]}
    answer["gate_flips"] = flips
    answer["questions"] = plan["questions"]
    warnings = [f"{e['document']} global settings carry a host path: {p}"
                for e in plan["settings"] for p in e["host_paths"]]
    if warnings:
        answer["warnings"] = warnings
    if answer["global_migrated_at"]:
        answer["state"] = "migrated"
        answer["changed"] = False
        if apply:
            answer["hint"] = ("the global rows were written at "
                              f"{answer['global_migrated_at']}; change one with its own verb")
        _emit(answer)
        return
    if not apply:
        answer["would_write"] = not plan["questions"]
        _emit(answer)
        return
    if plan["questions"]:
        _migrate_refuse(_MigrateRefusal(
            "question_open", f"{len(plan['questions'])} question(s) are open and nothing was "
            "written: " + "; ".join(q["id"] for q in plan["questions"]),
            "answer each in a JSON file and pass it with --answers"), answer)
    store = _store_module()
    db = _db_module()
    import psycopg
    conn, _setting = _migrate_connect(root)
    try:
        major, minor = store.STORE_TABLES_VERSION
        db.migrate(conn, store.STORE_OWNER, store.record_table_steps(), major=major, minor=minor)
        with conn.transaction():
            conn.execute("LOCK TABLE capabilities_global IN EXCLUSIVE MODE")
            if conn.execute("SELECT global_migrated_at FROM capabilities_global"
                            ).fetchone()[0] is not None:
                raise _MigrateRefusal("global_migrated", "the global rows were written by "
                                      "another run meanwhile", exit_code=6)
            for row in plan["remove"]:
                if row["kind"] == "policy":
                    conn.execute("DELETE FROM capabilities_policy WHERE agent_id IS NULL "
                                 "AND capability = %s AND node IS NULL", (row["capability"],))
                elif row["kind"] == "identifier":
                    conn.execute("DELETE FROM capabilities_identifiers WHERE agent_id IS NULL "
                                 "AND capability = %s AND label = %s AND node IS NULL",
                                 (row["capability"], row["name"]))
                else:
                    conn.execute("DELETE FROM capabilities_connection_grants WHERE "
                                 "agent_id IS NULL AND capability = %s AND connection = %s "
                                 "AND node IS NULL", (row["capability"], row["name"]))
            for row in plan["policy"]:
                if row["outcome"] != "held":
                    conn.execute(
                        "INSERT INTO capabilities_policy (agent_id, capability, node, enabled) "
                        "VALUES (NULL, %s, NULL, %s) ON CONFLICT ((coalesce(agent_id, '')), "
                        "capability, (coalesce(node, ''))) DO UPDATE SET enabled = "
                        "EXCLUDED.enabled, updated_at = now()",
                        (row["capability"], row["enabled"]))
            for row in plan["identifiers"]:
                if row["outcome"] != "held":
                    conn.execute(
                        "INSERT INTO capabilities_identifiers (agent_id, capability, node, "
                        "label, value, note) VALUES (NULL, %s, NULL, %s, %s::jsonb, %s) "
                        "ON CONFLICT ((coalesce(agent_id, '')), capability, label, "
                        "(coalesce(node, ''))) DO UPDATE SET value = EXCLUDED.value, "
                        "note = EXCLUDED.note, updated_at = now()",
                        (row["capability"], row["label"],
                         json.dumps(row["value"], ensure_ascii=False), row["note"]))
            for row in plan["connections"]:
                if row["outcome"] in ("add", "change"):
                    conn.execute(
                        "INSERT INTO capabilities_connections (capability, name, spec) "
                        "VALUES (%s, %s, %s::jsonb) ON CONFLICT (capability, name) "
                        "DO UPDATE SET spec = EXCLUDED.spec",
                        (row["capability"], row["name"],
                         json.dumps(row["spec"], ensure_ascii=False)))
            for row in plan["grants"]:
                if row["outcome"] == "held":
                    continue
                if row["is_default"]:
                    conn.execute("UPDATE capabilities_connection_grants SET is_default = "
                                 "false WHERE agent_id IS NULL AND capability = %s AND "
                                 "node IS NULL AND is_default", (row["capability"],))
                conn.execute(
                    "INSERT INTO capabilities_connection_grants (agent_id, capability, "
                    "connection, node, enabled, allow_write, is_default) VALUES (NULL, %s, "
                    "%s, NULL, NULL, %s, %s) ON CONFLICT ((coalesce(agent_id, '')), "
                    "capability, connection, (coalesce(node, ''))) DO UPDATE SET "
                    "enabled = NULL, allow_write = EXCLUDED.allow_write, "
                    "is_default = EXCLUDED.is_default",
                    (row["capability"], row["connection"], row["allow_write"],
                     row["is_default"]))
    except _MigrateRefusal as exc:
        conn.close()
        _migrate_refuse(exc, answer)
    except db.DbError as exc:
        conn.close()
        _die(_store_error_exit(exc), exc.slug, exc.message, exc.hint)
    except psycopg.Error as exc:
        conn.close()
        _die(5, "store_write_failed", f"writing the global rows failed: {exc}")
    conn.close()
    # Settings go through the adapter's writer, one document at a time, each
    # with its trail.
    settings_written = {}
    if plan["settings"]:
        writer = store.AgentRecords(_CONFIG_HOME / "no-project", _CONFIG_HOME,
                                    "global-migration", None, agent={},
                                    node=os.environ.get(store.NODE_NAME_ENV, "").strip()
                                    or "global", project_root=root, actor=MIGRATE_ACTOR)
        writer._authority = lambda _conn, _scope, wanted, _actor: wanted
        try:
            for entry in plan["settings"]:
                if entry["outcome"] == "held":
                    continue
                result = writer.settings_write(entry["document"], "global",
                                               lambda _c, v=entry["document_value"]: v,
                                               actor=MIGRATE_ACTOR)
                settings_written[entry["document"]] = result["generation"]
        except store.StoreError as exc:
            _die(_store_error_exit(exc), exc.slug, exc.message, exc.hint)
        finally:
            writer.close()
    # Only once every global row and every global settings document is written
    # does the store say the global rows exist: a run that stopped before here
    # writes them again, and an agent's migration waits for them.
    conn, _setting = _migrate_connect(root)
    try:
        with conn.transaction():
            conn.execute("LOCK TABLE capabilities_global IN EXCLUSIVE MODE")
            if conn.execute("SELECT global_migrated_at FROM capabilities_global"
                            ).fetchone()[0] is not None:
                raise _MigrateRefusal("global_migrated", "the global rows were written by "
                                      "another run meanwhile", exit_code=6)
            conn.execute("UPDATE capabilities_global SET global_migrated_at = now()")
        answer["global_migrated_at"] = _migrate_global_at(conn)
    except _MigrateRefusal as exc:
        conn.close()
        _migrate_refuse(exc, answer)
    except psycopg.Error as exc:
        conn.close()
        _die(5, "store_write_failed", f"marking the global rows written failed: {exc}")
    finally:
        conn.close()
    answer.update(state="migrated", changed=True, settings_written=settings_written,
                  files_kept=("the config home's files stay until every agent on this "
                              "machine has moved; agents not yet moved still read them"))
    _emit(answer)


# --- discard and report -----------------------------------------------------------------

def _migrate_config_files(manifests: dict) -> list[Path]:
    files = [_CONFIG_HOME / "capabilities" / "settings.json"]
    files += sorted(_CONFIG_HOME.glob("*/connections.json"))
    files += sorted(_CONFIG_HOME.glob("*/identifiers.json"))
    files += [_CONFIG_HOME / name / home["path"]
              for name, home in _migrate_settings_homes(manifests, "global")]
    seen, out = set(), []
    for path in files:
        if path.is_file() and str(path) not in seen:
            seen.add(str(path))
            out.append(path)
    return out


def _migrate_agent_states(entries: list[dict]) -> list[dict]:
    """Each discovered agent with what its store says of it."""
    out = []
    for entry in entries:
        row = {**entry, "state": "unknown"}
        if not entry.get("id"):
            row["state"] = "no_id"
            out.append(row)
            continue
        try:
            conn, _setting = _migrate_connect(Path(entry["root"]))
        except _MigrateRefusal as exc:
            row["store"] = {"code": exc.code, "message": exc.message}
            out.append(row)
            continue
        try:
            state = _migrate_agent_state(conn, entry["id"]) or {}
            row["global_migrated_at"] = _migrate_global_at(conn)
        finally:
            conn.close()
        row["state"] = ("migrated" if state.get("migrated_at") else
                        "migrating" if state.get("migrating_since") else
                        "registered" if state else "unregistered")
        row["migrated_at"] = state.get("migrated_at")
        row["master"] = state.get("master")
        out.append(row)
    return out


def cmd_migrate_discard(opts: dict) -> None:
    """`migrate --discard`: a node that is not the global master deletes its
    config home's record and settings files without reading them, once the
    global rows exist and no agent here still reads them. Every root that may
    read them counts: the ones the machine lists, the ones given, and every
    one found below the folders those sit in; a node that is the master of
    any of them is a master the files were read on, and keeps them."""
    _read_only_gate("migrate --discard")
    store = _store_module()
    node = os.environ.get(store.NODE_NAME_ENV, "").strip()
    if not node:
        _migrate_refuse(_MigrateRefusal(
            "node_unnamed", f"{store.NODE_NAME_ENV} is not set: a discard names the node it "
            "runs on, so it can tell this node is no agent's master",
            f"set {store.NODE_NAME_ENV} for this machine, then run it again"))
    root = _project_root() or Path.cwd()
    try:
        conn, _setting = _migrate_connect(root)
    except _MigrateRefusal as exc:
        _migrate_refuse(exc)
    try:
        at = _migrate_global_at(conn)
    finally:
        conn.close()
    if not at:
        _migrate_refuse(_MigrateRefusal(
            "global_not_migrated", "the global records are not in the store, so these "
            "files are still their only copy", "run `capabilities migrate --global --apply` "
            "on the global master first"))
    agents = _migrate_agent_states(_migrate_discover(opts.get("roots") or [], scan=True))
    mastered = [a for a in agents if a.get("master") == node]
    if mastered:
        _migrate_refuse(_MigrateRefusal(
            "master_node", f"node {node} is the master of {len(mastered)} agent(s) on this "
            "machine, which read this config home: "
            + ", ".join(f"{a['root']} ({a['id']})" for a in mastered),
            "the config home's files stay on a master; discard them on a node that is "
            "no agent's master", detail={"agents": mastered}))
    waiting = [a for a in agents if a["state"] not in ("migrated",)]
    if waiting:
        _migrate_refuse(_MigrateRefusal(
            "agents_unmigrated", f"{len(waiting)} root(s) on this machine have not moved "
            "and still read the config home's files: "
            + ", ".join(f"{a['root']} ({a['state']}; {', '.join(a['sources'])})"
                        for a in waiting),
            "migrate each on its master first, give one without an id an id with "
            "`capabilities init` or archive it", detail={"agents": waiting}))
    removed = []
    for path in _migrate_config_files(_migrate_manifests()):
        path.unlink()
        removed.append(str(path))
    _emit({"ok": True, "scope": "global", "global_migrated_at": at,
           "config_home": str(_CONFIG_HOME), "removed": removed})


def _migrate_historical(relative: Path, body: tuple) -> bool:
    """Whether a file of the project is a historical note rather than a live
    reader: under its evidence, memory or snapshot folders (at the root or at
    its body root), or a change log."""
    parts = relative.parts
    if body and parts[:len(body)] == body:
        parts = parts[len(body):]
    if len(parts) > 1 and parts[0] in MIGRATE_HISTORICAL_DIRS:
        return True
    return relative.name.upper().startswith(MIGRATE_HISTORICAL_NAMES)


def _migrate_consumers(root: Path, limit: int = 200) -> tuple[list[str], int]:
    """Lines in the project's own text that read a record or settings file
    directly or name a retired import verb: (live readers, how many lines are
    historical notes - evidence, memory, snapshots, change logs - that only
    quote those names and are left as they are)."""
    hits: list[str] = []
    historical = 0
    try:
        body = _migrate_body_envelope(root).parent.relative_to(root).parts
    except ValueError:
        body = ()
    for current, dirs, names in os.walk(root):
        dirs[:] = [d for d in dirs if d not in MIGRATE_CONSUMER_SKIP and not d.startswith(".")
                   or d in (".claude", ".codex")]
        for name in names:
            if not name.endswith(MIGRATE_CONSUMER_SUFFIXES):
                continue
            path = Path(current) / name
            try:
                if path.stat().st_size > 512 * 1024:
                    continue
                lines = path.read_text(errors="replace").splitlines()
            except OSError:
                continue
            relative = path.relative_to(root)
            past = _migrate_historical(relative, body)
            for number, line in enumerate(lines, 1):
                if any(pattern in line for pattern in MIGRATE_CONSUMER_PATTERNS):
                    if past:
                        historical += 1
                        continue
                    hits.append(f"{relative}:{number}: {line.strip()[:200]}")
                    if len(hits) >= limit:
                        return hits, historical
    return hits, historical


def cmd_migrate_report(opts: dict) -> None:
    """`migrate --report`: what remains on this machine and why - each agent's
    record and settings files, the config home's, an open migration's
    journal, and the project text that still reads those files directly."""
    manifests = _migrate_manifests()
    agents = []
    for entry in _migrate_agent_states(_migrate_discover(opts.get("roots") or [])):
        envelope = Path(entry["envelope"])
        files = [str(p) for p in _migrate_record_files(envelope, manifests)]
        state = entry["state"]
        reason = {
            "migrated": "the agent's records are in the store; these files are no longer "
                        "read: remove them",
            "migrating": "a migration is open: finish it with `capabilities migrate "
                         "--apply` on the master",
        }.get(state, "the agent has not moved: run `capabilities migrate` on its master")
        journal = _migrate_journal(entry["id"]) if entry.get("id") else None
        consumers, historical = _migrate_consumers(Path(entry["root"]))
        agents.append({**entry, "files": files, "reason": reason if files else None,
                       "journal": ({k: journal.get(k) for k in
                                    ("phase", "node", "started_at", "updated_at", "archive")}
                                   if journal else None),
                       "consumers": consumers, "historical_notes": historical})
    config = [str(p) for p in _migrate_config_files(manifests)]
    at = None
    here = _project_root() or Path.cwd()
    try:
        conn, _setting = _migrate_connect(here)
        try:
            at = _migrate_global_at(conn)
        finally:
            conn.close()
    except _MigrateRefusal:
        pass
    _emit({"ok": True, "agents": agents,
           "config_home": {"dir": str(_CONFIG_HOME), "files": config,
                           "global_migrated_at": at,
                           "reason": (None if not config else
                                      "the global rows are in the store; agents not yet "
                                      "moved still read these, and a node that is not the "
                                      "global master discards them with `capabilities "
                                      "migrate --discard`" if at else
                                      "the global records are not in the store yet: run "
                                      "`capabilities migrate --global` on the global master")}})


def cmd_migrate(args: list[str]) -> None:
    opts = _migrate_options(args)
    if opts.get("global"):
        cmd_migrate_global(opts)
    elif opts.get("discard"):
        cmd_migrate_discard(opts)
    elif opts.get("report"):
        cmd_migrate_report(opts)
    else:
        cmd_migrate_agent(opts)


# A TOML table header; every key after the first one belongs to that table.
_TOML_TABLE_HEADER = re.compile(r"^[ \t]*\[{1,2}[^\[\]\n]+\]{1,2}[ \t]*(?:#.*)?$", re.M)


def _toml_root_end(text: str) -> int:
    m = _TOML_TABLE_HEADER.search(text)
    return m.start() if m else len(text)


def _wire_codex_config(root: Path) -> bool:
    """Name the root link as a Codex fallback, keeping names the person added."""
    path = root / CODEX_CONFIG_REL
    link_rel = CODEX_ROOT_LINK_REL.as_posix()
    budget_line = "project_doc_max_bytes = 131072"
    manager_lines = [f"project_doc_fallback_filenames = [{json.dumps(name)}]"
                     for name in (link_rel, *CODEX_RETIRED_FALLBACKS)] + [budget_line]
    original = path.read_text() if path.exists() else None
    text = original or ""
    # Codex reads both keys only at the root. Earlier wiring appended them after
    # the last table, which files them under it; lift those manager lines out.
    end = _toml_root_end(text)
    tail = text[end:]
    for line in manager_lines:
        tail = re.sub(rf"^{re.escape(line)}[ \t]*(?:\n|\Z)", "", tail, flags=re.M)
    head = text[:end]
    inserts: list[str] = []
    m = re.search(r"^project_doc_fallback_filenames\s*=\s*\[(.*?)\]\s*$",
                  head, flags=re.M | re.S)
    if m:
        items = re.findall(r'"([^"]+)"|\'([^\']+)\'', m.group(1))
        values = [a or b for a, b in items]
        filtered = [v for v in values if v not in CODEX_RETIRED_FALLBACKS]
        if link_rel not in filtered:
            filtered.append(link_rel)
        if filtered != values:
            replacement = "project_doc_fallback_filenames = [" + \
                ", ".join(json.dumps(v) for v in filtered) + "]"
            head = head[:m.start()] + replacement + head[m.end():]
    else:
        inserts.append(manager_lines[0])
    if not re.search(r"^project_doc_max_bytes\s*=", head, flags=re.M):
        inserts.append(budget_line)
    if inserts:
        body = head.rstrip("\n")
        head = (body + "\n" if body else "") + "\n".join(inserts) + "\n"
        if tail:
            head += "\n"
    text = head + tail
    if not text.endswith("\n"):
        text += "\n"
    if text == original:
        return False
    _atomic_write_text(path, text)
    return True


def _codex_link_ok(root: Path) -> bool:
    """True when the root link resolves to the generated capabilities file."""
    link = root / CODEX_ROOT_LINK_REL
    return (link.is_symlink()
            and link.resolve() == (root / CODEX_CAPABILITIES_REL).resolve())


def _link_codex_root(root: Path) -> str:
    """Point the root name Codex loads at the generated file.

    Returns `kept`, `linked`, or `blocked: ...`. Only a missing path, a dangling
    link, or manager-generated context is replaced; anything else stays with
    its owner.
    """
    link = root / CODEX_ROOT_LINK_REL
    if _codex_link_ok(root):
        return "kept"
    if link.is_symlink() or link.exists():
        target = link.resolve()
        try:
            owned = not target.exists() or CONTEXT_BEGIN in target.read_text()
        except (OSError, UnicodeDecodeError):
            owned = False
        if not owned:
            return (f"blocked: `{CODEX_ROOT_LINK_REL.as_posix()}` exists and is "
                    "not manager-generated context")
    temp = root / f".{link.name}.{os.getpid()}.tmp"
    temp.unlink(missing_ok=True)
    temp.symlink_to(CODEX_CAPABILITIES_REL)
    temp.replace(link)
    return "linked"


def _deliver_codex(root: Path) -> dict:
    """Bring the root link and the config naming it to their current form."""
    return {"config_changed": _wire_codex_config(root),
            "link": _link_codex_root(root)}


def _wire_codex_hooks(root: Path) -> bool:
    path = root / CODEX_HOOKS_REL
    hooks = _read_host_settings(path)
    root_hooks = hooks.setdefault("hooks", {})
    session = root_hooks.setdefault("SessionStart", [])
    # An existing entry is left as it is: Codex records trust against the whole
    # entry, matcher included, and a run on compaction only prints a notice.
    for entry in session:
        for h in (entry or {}).get("hooks", []):
            cmd = h.get("command", "")
            if CODEX_HOOK_COMMAND in cmd:
                return False
    session.append({
        "matcher": CODEX_SESSION_MATCHER,
        "hooks": [{
            "type": "command",
            "command": CODEX_HOOK_COMMAND,
            "timeout": 30,
            "statusMessage": "Regenerating Codex context",
        }],
    })
    _write_json(path, hooks)
    return True


def _wire_codex(root: Path) -> dict:
    context = _write_host_context(root, "codex")["path"]
    delivery = _deliver_codex(root)
    return {
        "config": str(root / CODEX_CONFIG_REL),
        "config_changed": delivery["config_changed"],
        "hooks": str(root / CODEX_HOOKS_REL),
        "hook_added": _wire_codex_hooks(root),
        "capabilities_context": str(context),
        "root_link": delivery["link"],
    }


def _codex_delivery_blockers(root: Path) -> list[str]:
    """Name what keeps Codex from loading the capabilities file it is wired to."""
    for name in CODEX_ROOT_DOCS:
        if (root / name).exists():
            return [f"Codex loads the root `{name}` and then ignores the fallback "
                    f"`{CODEX_ROOT_LINK_REL.as_posix()}`; move the content of "
                    f"`{name}` elsewhere or remove it (the manager never edits it)"]
    return []


def _codex_wired(root: Path) -> bool:
    """True when the project's Codex config names a manager-generated file."""
    try:
        text = (root / CODEX_CONFIG_REL).read_text()
    except OSError:
        return False
    return any(name in text for name in
               (CODEX_ROOT_LINK_REL.as_posix(), *CODEX_RETIRED_FALLBACKS))


def _session_start_payload() -> dict | None:
    """The host's SessionStart payload when a harness hook invoked this run.

    Claude Code and Codex both pipe a JSON object carrying
    `hook_event_name: "SessionStart"` to the hook's stdin. A terminal, an
    empty or foreign stdin, or a pipe that stays silent reads as no payload.
    """
    try:
        if sys.stdin is None or sys.stdin.isatty():
            return None
        fd = sys.stdin.fileno()
        deadline = time.monotonic() + HOOK_PAYLOAD_WAIT_SECONDS
        chunks: list[bytes] = []
        while True:
            ready, _, _ = select.select([fd], [], [],
                                        max(0.0, deadline - time.monotonic()))
            if not ready:
                return None
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            chunks.append(chunk)
        payload = json.loads(b"".join(chunks))
    except (OSError, ValueError):
        return None
    if isinstance(payload, dict) and payload.get("hook_event_name") == "SessionStart":
        return payload
    return None


def _session_notice(host: str) -> str | None:
    """Rebuild the host's capabilities file and say what this session must be told.

    The file reaches the agent through the host's own loading, so hook output
    carries only a short notice, and only when the loaded copy is missing,
    stale, or cannot load. A failure becomes the notice: session start never
    breaks. None means ContextKit owns this project's hooks.
    """
    errors = io.StringIO()
    try:
        with redirect_stderr(errors):
            root = _require_project()
            if _contextkit_managed(root):
                return None
            build = _write_host_context(root, host)
            blockers = []
            linked = False
            if host == "codex" and _codex_wired(root):
                link = _deliver_codex(root)["link"]
                linked = link == "linked"
                if link.startswith("blocked: "):
                    blockers.append(link.removeprefix("blocked: "))
            if host == "codex":
                blockers += _codex_delivery_blockers(root)
    except (SystemExit, Exception) as exc:
        reason = str(exc) if not isinstance(exc, SystemExit) else "unknown error"
        for line in reversed(errors.getvalue().splitlines()):
            try:
                reason = json.loads(line)["error"]["message"]
                break
            except (ValueError, KeyError, TypeError):
                continue
        notice = (f"The capabilities manager could not rebuild the capability "
                  f"context: {_md_escape(reason)}. This session may carry a stale "
                  f"or missing copy. Tell the user; `capabilities doctor` names "
                  f"the repair.")
    else:
        if blockers:
            notice = ("The capability context did not load in this session: "
                      + "; ".join(blockers)
                      + ". Tell the user; `capabilities doctor` names the repair.")
        elif build["created"] or linked:
            notice = ("The capabilities manager created the capability context "
                      "after this session started, so this session has none "
                      "loaded. Tell the user; a new or resumed session loads it.")
        elif build["changed"]:
            notice = ("The capability context changed after this session loaded "
                      "it, so the loaded copy is stale. Tell the user; a new or "
                      "resumed session loads the update.")
        else:
            return ""
    return "# Capabilities Session Notice\n\n" + notice + "\n"


def cmd_context(host: str) -> None:
    # The same command line serves as the host's SessionStart hook, so wired
    # projects need no migration; a terminal run keeps its JSON result.
    if host != "fragment" and _session_start_payload() is not None:
        notice = _session_notice(host)
        if notice is not None:
            sys.stdout.write(notice)
            return
    root = _require_project()
    if host == "fragment":
        _emit(_compose_context(root))
        return
    if _contextkit_managed(root):
        result = _contextkit_handoff(root, [host])
        result["skipped"] = True
        _emit(result)
        return
    target = _write_host_context(root, host)["path"]
    # A wired project converts in place: no one reruns init for a new layout.
    if host == "codex" and _codex_wired(root):
        _deliver_codex(root)
    project_caps, global_caps = _policy_views(root)
    enabled = [
        n for n in set(project_caps) | set(global_caps)
        if _effective_gate_state(n, project_caps.get(n), global_caps.get(n))[0]
        == "enabled"]
    result = {"written": str(target), "enabled": sorted(enabled)}
    _emit(result)

# ---------------------------------------------------------------- build: an agent's generated context

# `build` composes a ContextKit-bound agent's generated host context exactly as
# `contextkit build` does - its runtime and collaboration texts, guide menu,
# inline and stub context, routines and this manager's own capabilities block -
# and writes it with the host links ContextKit makes. The texts below are
# ContextKit's, carried byte for byte so the two compose the same file.
CK_GENERATED_MARKER = "<!-- Generated by ContextKit. Do not edit by hand. -->"
CK_DEFAULT_OUTPUT = Path(".contextkit") / "generated" / "context.md"
CK_HOST_LINKS = {
    "codex": Path(".contextkit.md"),
    "claude": Path(".claude") / "rules" / "CONTEXT.md",
}
CK_FOREIGN_INSTRUCTION_NAMES = ("AGENTS.md", "AGENTS.override.md", "CLAUDE.md", "CLAUDE.local.md")
CK_CLAUDE_HOOK_NEEDLES = ("contextkit session-start --host claude", "contextkit build --target claude")
CK_COLLABORATION_MODES = ("ask", "direct")
CK_ONBOARDING_STATES = ("pending", "complete")
CK_ROUTINE_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]*")
CK_RUNTIME_TEXT = """\
# Operating Runtime

You are operating inside a ContextKit-managed project.

ContextKit gives the project a visible source body, generated host runtime context, on-demand guides, routines, and capability awareness. Source truth lives in the project body and owning tools. Generated host files are delivery output.

## Operating Rules

- Identify the owner before editing a durable fact.
- Edit source files, not generated output.
- Keep one durable fact in one live home.
- Use always-on context for orientation, law, routing, and safety.
- Load stub context, guides, routines, assets, capabilities, and tools only when the task calls for them.
- State live doctrine in present tense.
- Write prose as one line per paragraph; leave wrapping to the reader's editor and never break a line by hand.
- Preserve evidence as evidence; promote durable conclusions deliberately.
- Prove tool readiness at use time with the owning tool.
- Stop for human approval before destructive, external, publishing, credential, access, or product-direction consequences.

## Source Body

`.contextkit/` is technical binding, config, and ContextKit-native artifacts. It is not project doctrine.

Layer names below are canonical. A project may hold them under a configured visible body root, so resolve a layer's actual location with `contextkit path <layer>` before assuming it sits at the project root.

`context/` is live project doctrine. Use `contextkit guide authoring`.

Configured global context is shared live doctrine outside the project that compiles through the same context-file contract. Use `contextkit guide global-context`.

`assets/` is historical evidence: sessions, plans, research, and raw records. Use `contextkit guide assets`.

`routines/` is repeatable procedure. Use `contextkit guide routines`.

`capabilities/` is the project envelope for enabled tools. ContextKit inserts the capabilities manager's context block unchanged; capability awareness and internals remain tool-owned. Use `contextkit guide capabilities` and the tool's own help or doctor surface.

## Discovery

Use `contextkit help` for exact command syntax.

Use the generated Guide Menu to choose on-demand rule-source guides.

Command outputs name their rule sources. Load the named guide before repairing the source.

## Work Loop

Before editing, search for the existing owner.

When changing project body, routines, hooks, or capability envelopes, load `contextkit guide validation` and follow its live sequence.

Repair the owning source or tool surface, then rerun the command that exposed the problem."""
CK_COLLABORATION_TEXT = """\
## Collaboration Mode

Before non-trivial work that changes behavior or durable project material, spans multiple files or surfaces, or requires substantive judgment, offer the user Direct or Agent Team mode once unless the user has already selected a mode. In Agent Team mode, remain the task setter and orchestrator, give execution to one subagent, give independent review to another subagent, and load `contextkit guide agent-team` before starting."""
# (topic, title, summary) of each guide, in ContextKit's menu order.
CK_GUIDE_MENU = (
    ('bootstrap', 'Bootstrap Guide', 'Use this guide when initializing or adopting a ContextKit project body.'),
    ('authoring', 'ContextKit Authoring Guide', 'Use this guide when creating, moving, or repairing project body material.'),
    ('agent-team', 'Agent Team Guide', 'Use this guide after the user selects Agent Team mode for non-trivial work, or when the user wants to change whether the mode is offered.'),
    ('workbench', 'Workbench Guide', "Use this guide when you need to inspect or repair a ContextKit-managed project from an isolated context-manager session instead of operating as the project's worker agent."),
    ('global-context', 'Global Context Guide', 'Use this guide when configuring, authoring, validating, or repairing live doctrine shared by multiple ContextKit projects.'),
    ('validation', 'Validation Guide', 'Use this guide after initialization, migration, hook changes, or meaningful edits to `context/`, `assets/`, `routines/`, or `capabilities/`.'),
    ('assets', 'Assets Guide', 'Use this guide when writing evidence records, research notes, session records, plans, and promotion notes.'),
    ('routines', 'Routines Guide', 'Use this guide when writing repeatable procedures under `routines/`.'),
    ('audit', 'Audit Guide', 'Use this guide when reviewing a ContextKit project body or applying audit findings.'),
    ('groom', 'Semantic Grooming Guide', 'Use this guide when reviewing a ContextKit-managed project for duplicated facts, misplaced meaning, ambiguous ownership, stale live doctrine, or material whose artifact type does not match its job.'),
    ('destructive', 'Destructive Operations Guide', 'Use this guide before running commands that erase, overwrite, or irreversibly mutate project data.'),
    ('migration', 'Migration Guide', 'Use this guide when converting an existing project into a ContextKit agent body.'),
    ('hooks', 'Hooks Guide', 'Use this guide when installing, reviewing, or repairing host bindings.'),
    ('capabilities', 'Capabilities Guide', 'Use this guide when a ContextKit project has enabled external tools under `capabilities/`.'),
)


def _ck_one_line(value: str) -> str:
    return re.sub(r"\s+", " ", value).strip()


def _ck_rel(root: Path, path: Path) -> str:
    try:
        return path.resolve().relative_to(root.resolve()).as_posix()
    except ValueError:
        return str(path)


def _ck_frontmatter(text: str) -> tuple[dict, str]:
    if not text.startswith("---\n"):
        return {}, text
    end = text.find("\n---", 4)
    if end == -1:
        return {}, text
    fm_text = text[4:end]
    body_start = end + len("\n---")
    if body_start < len(text) and text[body_start] == "\n":
        body_start += 1
    fm: dict = {}
    for raw_line in fm_text.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or ":" not in line:
            continue
        key, value = line.split(":", 1)
        key, value = key.strip(), value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
            decoded = None
            if value[0] == '"':
                try:
                    decoded = json.loads(value)
                except ValueError:
                    pass
            value = decoded if isinstance(decoded, str) else value[1:-1]
        fm[key] = value
    return fm, text[body_start:]


def _ck_binding(root: Path) -> dict:
    """What the binding config says beyond the body: global context, output,
    collaboration mode and onboarding, refused as ContextKit refuses them."""
    import tomllib
    config_file = root / CONTEXTKIT_CONFIG_REL
    try:
        raw = tomllib.loads(config_file.read_text())
    except (OSError, ValueError) as exc:
        _die(6, "contextkit_config_invalid", f"{config_file} cannot be read: {exc}",
             "repair the project context binding, then retry")
    body = _project_body(root)
    sources = raw.get("sources") if isinstance(raw.get("sources"), dict) else {}
    global_context = None
    value = sources.get("global_context")
    if value is not None:
        if not isinstance(value, str) or not value.strip():
            _die(6, "contextkit_config_invalid",
                 "invalid sources.global_context: expected a non-empty path string")
        expanded = os.path.expandvars(value)
        if re.search(r"\$(?:[A-Za-z_][A-Za-z0-9_]*|\{[^}]+\})", expanded):
            _die(6, "contextkit_config_invalid",
                 f"unresolved environment variable in sources.global_context: {value}",
                 "export the variable or configure a concrete path")
        candidate = Path(expanded).expanduser()
        if not candidate.is_absolute():
            candidate = root / candidate
        resolved, project_root = candidate.resolve(), root.resolve()
        if resolved == project_root or project_root in resolved.parents \
                or resolved in project_root.parents:
            _die(6, "contextkit_config_invalid",
                 f"invalid sources.global_context: {value}",
                 "global context and the project must be separate, non-overlapping directory trees")
        global_context = resolved
    layers = {name: path.relative_to(root) for name, path in body["layers"].items()}
    output = CK_DEFAULT_OUTPUT
    raw_output = raw.get("output")
    if raw_output is not None:
        value = raw_output.get("context") if isinstance(raw_output, dict) else None
        if not isinstance(value, str) or not value.strip():
            _die(6, "contextkit_config_invalid", "invalid output.context: expected a non-empty path string")
        output = Path(value.strip())
        inside = [layers[name] for name in ("context", "assets", "routines", "capabilities")]
        if body["body_root"] != Path("."):
            inside.append(body["body_root"])
        if output.is_absolute() or ".." in output.parts or output.suffix != ".md" \
                or output in CK_HOST_LINKS.values() \
                or any(output == layer or layer in output.parents for layer in inside):
            _die(6, "contextkit_config_invalid", f"invalid output.context: {value}",
                 "the generated context is a Markdown file inside the project, outside "
                 "the source body and the host links")
    mode = "ask"
    raw_collaboration = raw.get("collaboration")
    if raw_collaboration is not None:
        mode = raw_collaboration.get("mode") if isinstance(raw_collaboration, dict) else None
        if mode not in CK_COLLABORATION_MODES:
            _die(6, "contextkit_config_invalid", f"invalid collaboration.mode: {mode}",
                 f"expected one of: {', '.join(CK_COLLABORATION_MODES)}")
    onboarding = None
    section = raw.get("onboarding")
    if section is not None and section != {}:
        status = section.get("status") if isinstance(section, dict) else None
        routine = section.get("routine") if isinstance(section, dict) else None
        if status not in CK_ONBOARDING_STATES:
            _die(6, "contextkit_config_invalid", f"invalid onboarding.status: {status}")
        if not isinstance(routine, str) or not CK_ROUTINE_NAME.fullmatch(routine):
            _die(6, "contextkit_config_invalid", f"invalid onboarding.routine: {routine}")
        onboarding = {"status": status, "routine": routine}
    return {"body_root": body["body_root"], "layers": layers, "global_context": global_context,
            "output": output, "collaboration_mode": mode, "onboarding": onboarding}


def _ck_collect_context(root: Path, base: Path, source: str) -> list[dict]:
    if not base.is_dir():
        what = "global context" if source == "global" else "context"
        _die(6, "context_source_missing", f"{what} source directory not found: {base}",
             "repair the binding's sources, or create the layer")
    files, errors = [], []
    for path in sorted(base.rglob("*.md")):
        rel = Path(_ck_rel(root, path))
        try:
            fm, body = _ck_frontmatter(path.read_text())
        except OSError as exc:
            errors.append(f"cannot read {rel}: {exc}")
            continue
        title = fm.get("title", "").strip()
        description = fm.get("description", "").strip()
        load = fm.get("load", "").strip()
        order_raw = fm.get("order", "").strip()
        problems = []
        if not title:
            problems.append(f"Missing frontmatter title: {rel}")
        if not description:
            problems.append(f"Missing frontmatter description: {rel}")
        if load not in {"inline", "stub"}:
            problems.append(f"Missing frontmatter load: {rel}" if not load
                            else f"Invalid frontmatter load in {rel}: {load}")
        try:
            order = int(order_raw)
        except ValueError:
            order = 0
            problems.append(f"Invalid frontmatter order in {rel}: {order_raw or '<missing>'}")
        if problems:
            errors += problems
            continue
        files.append({"path": path, "rel": rel, "title": title, "description": description,
                      "load": load, "order": order, "body": body, "source": source})
    if errors:
        _die(6, "context_file_invalid", "; ".join(errors),
             "repair the context files' frontmatter, then build again")
    files.sort(key=lambda item: (item["order"], item["rel"].as_posix()))
    return files


def _ck_reference(item: dict) -> str:
    return str(item["path"].resolve()) if item["source"] == "global" else item["rel"].as_posix()


def _ck_routine_entries(root: Path, routines_dir: Path, warnings: list[str]) -> list | None:
    if not (root / routines_dir).is_dir():
        warnings.append(f"routine layer not present; add `{routines_dir.as_posix()}/` "
                        "or run `contextkit guide routines`")
        return None
    routines = []
    for path in sorted((root / routines_dir).rglob("*.md")):
        try:
            fm, _body = _ck_frontmatter(path.read_text())
        except OSError:
            fm = {}
        name, description = fm.get("name", "").strip(), fm.get("description", "").strip()
        rel = Path(_ck_rel(root, path))
        if not name:
            warnings.append(f"routine missing frontmatter name: {rel.as_posix()}")
            continue
        if not description:
            warnings.append(f"routine missing frontmatter description: {rel.as_posix()}")
            continue
        if name != path.stem:
            warnings.append(f"routine name `{name}` does not match filename stem "
                            f"`{path.stem}`: {rel.as_posix()}")
        routines.append((name, _ck_one_line(description), rel))
    return routines


def _ck_routine_index(root: Path, routines_dir: Path, warnings: list[str]) -> str:
    routines = _ck_routine_entries(root, routines_dir, warnings)
    if routines is None:
        return ""
    lines = ["# Routines (repeatable procedures)", "",
             "Each is a self-contained recipe. Load its file when you need to run that procedure.", ""]
    if not routines:
        lines += ["No routines are declared in this project.", ""]
    else:
        for name, description, rel in routines:
            lines.append(f"- **[{name}]({rel.as_posix()})** - {description}")
        lines.append("")
    return "\n".join(lines)


def _ck_in_process(work):
    """(exit code, value, stderr) of one manager composition run in this
    process: a refusal ends it as it would end the verb, and any other failure,
    a lost store among them, as an uncaught error would end it - caught here,
    so the rest of the context is still built."""
    err = io.StringIO()
    try:
        with redirect_stderr(err):
            return 0, work(), err.getvalue()
    except SystemExit as exc:
        code = exc.code if isinstance(exc.code, int) else 1
        return code, None, err.getvalue()
    except Exception as exc:
        return 1, None, err.getvalue() + f"{type(exc).__name__}: {exc}"


def _ck_capability_context(root: Path, capabilities_dir: Path, warnings: list[str]) -> str:
    if not (root / capabilities_dir).is_dir():
        warnings.append(f"capability layer not present; add `{capabilities_dir.as_posix()}/` "
                        "or run `contextkit guide capabilities`")
        return ""
    held = os.environ.get("CLAUDE_PROJECT_DIR")
    os.environ["CLAUDE_PROJECT_DIR"] = str(root)
    try:
        code, text, err = _ck_in_process(lambda: _compose_context(root))
    finally:
        if held is None:
            os.environ.pop("CLAUDE_PROJECT_DIR", None)
        else:
            os.environ["CLAUDE_PROJECT_DIR"] = held
    if code != 0:
        detail = _ck_one_line(err)[:300]
        suffix = f": {detail}" if detail else ""
        warnings.append("capability context omitted: `capabilities context --fragment` exited "
                        f"{code}{suffix}")
        return ""
    if not (text or "").strip():
        warnings.append("capability context omitted: `capabilities context --fragment` "
                        "returned an empty block")
        return ""
    return text


def _ck_registry_onboarding(root: Path) -> dict | None:
    """This agent's registry row's onboarding columns, read without writing;
    None where the project keeps no registry row ContextKit would read."""
    agent_id = _kernel_agent_id(root)
    db = _db_module()
    store = _store_module()
    try:
        setting = db.resolve_setting(root)
        conn = db.connect(application_name=store.STORE_OWNER, setting=setting,
                          transaction=True)
    except db.DbError as exc:
        _die(_store_error_exit(exc), exc.slug, exc.message, exc.hint)
    import psycopg
    try:
        row = conn.execute("SELECT onboarding_status, onboarding_routine "
                           "FROM capabilities_agents WHERE id = %s", (agent_id,)).fetchone()
    except psycopg.errors.UndefinedTable:
        row = None
    except psycopg.Error as exc:
        _die(5, "store_unreachable", f"cannot reach the store: {exc}",
             "check the database setting with `capabilities store doctor`")
    finally:
        conn.close()
    if row and row[0]:
        return {"status": row[0], "routine": row[1]}
    return None


def _ck_onboarding(root: Path, binding: dict, warnings: list[str]) -> dict | None:
    code, answer, err = _ck_in_process(lambda: _ck_registry_onboarding(root))
    if code == 0:
        return answer or binding["onboarding"]
    slug, message = "manager_failed", ""
    for line in reversed(err.splitlines()):
        try:
            error = json.loads(line)["error"]
            slug = str(error.get("code") or "manager_failed")
            message = _ck_one_line(str(error.get("message") or ""))
            break
        except (ValueError, KeyError, TypeError, AttributeError):
            continue
    if slug in ("store_not_configured", "no_project_identity"):
        return binding["onboarding"]
    warnings.append("the agent registry did not answer, so the onboarding is the config's: "
                    f"`capabilities agent show` exited {code}: {message}")
    return binding["onboarding"]


def _ck_onboarding_block(root: Path, binding: dict, onboarding: dict, warnings: list[str]) -> str:
    routine = onboarding["routine"]
    entries = _ck_routine_entries(root, binding["layers"]["routines"], []) or []
    path = next((rel for name, _description, rel in entries if name == routine), None) \
        if routine else None
    if path is None:
        warnings.append(f"onboarding routine `{routine}` is not declared in "
                        f"`{binding['layers']['routines'].as_posix()}/`")
        reference = f"`{routine}`"
    else:
        reference = f"[{routine}]({path.as_posix()})"
    return "\n".join([
        "# Onboarding",
        "",
        f"This agent's onboarding is pending. Finish it before other work: run the routine {reference} and carry it to its end. "
        "At the start of each session, tell the owner what onboarding still needs. "
        "When the owner asks for other work first, say that onboarding is unfinished, then follow the owner's choice.",
        "",
        "The routine checks what remains from the live state and ends with `contextkit onboarding complete`, which removes this block.",
    ])


def _ck_is_link(root: Path, link: Path, output: Path) -> bool:
    path = root / link
    return path.is_symlink() and path.resolve() == (root / output).resolve()


def _ck_generated(path: Path) -> bool:
    if path.is_symlink() or not path.is_file():
        return False
    try:
        with path.open("r", encoding="utf-8", errors="replace") as handle:
            head = handle.read(4096)
    except OSError:
        return False
    return CK_GENERATED_MARKER in head


def _ck_foreign_instruction_files(root: Path, output: Path) -> list[str]:
    found: set[str] = set()
    names = set(CK_FOREIGN_INSTRUCTION_NAMES)
    candidates = [Path(name) for name in names] + [Path(".claude") / "CLAUDE.md"]
    if (root / ".git").exists():
        proc = subprocess.run(["git", "ls-files", "-co", "--exclude-standard"], cwd=str(root),
                              text=True, capture_output=True, timeout=30)
        if proc.returncode == 0:
            candidates += [Path(line) for line in proc.stdout.splitlines() if line.strip()]
    rules = root / ".claude" / "rules"
    if rules.is_dir():
        candidates += [path.relative_to(root) for path in rules.rglob("*.md")]
    for rel in candidates:
        is_rule = rel.parts[:2] == (".claude", "rules") and rel.suffix == ".md"
        if rel.name not in names and not is_rule and rel != Path(".claude") / "CLAUDE.md":
            continue
        path = root / rel
        if not (path.is_file() or path.is_symlink()):
            continue
        if rel in CK_HOST_LINKS.values() and (_ck_is_link(root, rel, output) or _ck_generated(path)):
            continue
        found.add(rel.as_posix())
    return sorted(found)


def _ck_compose(root: Path) -> tuple[str, list[str], dict]:
    """The generated context ContextKit's build composes for this agent,
    without its update notice, with the warnings it carries."""
    binding = _ck_binding(root)
    layers = binding["layers"]
    context_dir, routines_dir = layers["context"], layers["routines"]
    project_files = _ck_collect_context(root, root / context_dir, "project")
    global_files = (_ck_collect_context(root, binding["global_context"], "global")
                    if binding["global_context"] is not None else [])
    files = sorted([*global_files, *project_files],
                   key=lambda item: (item["order"], 0 if item["source"] == "global" else 1,
                                     item["rel"].as_posix()))
    warnings: list[str] = []
    inline = [item for item in files if item["load"] == "inline"]
    stubs = [item for item in files if item["load"] == "stub"]
    routine_index = _ck_routine_index(root, routines_dir, warnings)
    capability_context = _ck_capability_context(root, layers["capabilities"], warnings)
    memory_rel = binding["body_root"] / "memory"
    if (root / memory_rel).is_dir() or (root / memory_rel).is_symlink():
        warnings.append(f"legacy memory folder `{memory_rel.as_posix()}/`: ContextKit does not "
                        "compile project memory; run `memory adopt` to carry it into the "
                        "`memory` capability")
    onboarding = _ck_onboarding(root, binding, warnings)
    onboarding_block = (_ck_onboarding_block(root, binding, onboarding, warnings)
                        if onboarding and onboarding["status"] == "pending" else "")

    out = ["# Project Context", "", CK_GENERATED_MARKER,
           f"Source config: `{CONTEXTKIT_CONFIG_REL.as_posix()}`", "Rebuild: `contextkit build`", ""]
    if warnings:
        out += ["Generation warnings:", ""]
        out += [f"- {warning}" for warning in warnings]
        out.append("")
    out += ["---", "", CK_RUNTIME_TEXT, ""]
    if binding["collaboration_mode"] == "ask":
        out += [CK_COLLABORATION_TEXT, ""]
    if binding["body_root"] != Path("."):
        out += [f"This project keeps its visible body under `{binding['body_root'].as_posix()}/`. "
                f"Read and write body layers there: `{context_dir.as_posix()}/`, "
                f"`{layers['assets'].as_posix()}/`, `{routines_dir.as_posix()}/`.", ""]
    out += ["---", "", "# Guide Menu", "",
            "Guides are on-demand. Load the guide only when the task needs that workflow or surface.", ""]
    out += [f"- `contextkit guide {topic}` - {title}: {summary}"
            for topic, title, summary in CK_GUIDE_MENU]
    out += ["", "---", ""]
    if onboarding_block:
        out += [onboarding_block, "", "---", ""]
    foreign = _ck_foreign_instruction_files(root, binding["output"])
    if foreign:
        out += ["# Foreign Instruction Files", "",
                "Your host loads these instruction files outside this generated context. "
                "They can repeat, contradict, or override it:", "",
                *[f"- `{rel}`" for rel in foreign], "",
                "At the start of the session, tell the user these files were found and may affect how you work. "
                "Keeping, migrating, or removing them is the user's decision; do not change them on your own.",
                "", "---", ""]
    out += ["# Inline Context", ""]
    if inline:
        for item in inline:
            label = "Global Source" if item["source"] == "global" else "Source"
            out += ["---", "", f"## {label}: `{_ck_reference(item)}`", "", item["body"].strip(), ""]
    else:
        out += ["No inline context files.", ""]
    out += ["---", "", "# Context Stubs", "",
            "These context files are visible by metadata only. Load the path when the task needs that doctrine.",
            ""]
    if stubs:
        for item in stubs:
            origin = ", global" if item["source"] == "global" else ""
            out.append(f"- **{item['title']}** (`{_ck_reference(item)}`{origin}) - {item['description']}")
        out.append("")
    else:
        out += ["No stub context files.", ""]
    if routine_index:
        out += ["---", "", f"<!-- Routine index - generated from {routines_dir.as_posix()} front matter. -->",
                "", routine_index.strip(), ""]
    if capability_context:
        out += ["---", "", capability_context.rstrip(), ""]
    return "\n".join(out).rstrip() + "\n", warnings, binding


def _ck_installed_hosts(root: Path) -> list[str]:
    """The hosts this project has a ContextKit binding for, as ContextKit reads them."""
    hosts = []
    codex = _read_json(root / ".codex" / "hooks.json")
    container = codex.get("hooks") if isinstance(codex, dict) else None
    session = container.get("SessionStart") if isinstance(container, dict) else None
    codex_hook = any(isinstance(hook, dict) and "build-context.sh" in str(hook.get("command", ""))
                     for entry in (session if isinstance(session, list) else [])
                     if isinstance(entry, dict) for hook in entry.get("hooks") or [])
    if (root / ".codex" / "hooks" / "build-context.sh").exists() or codex_hook:
        hosts.append("codex")
    claude = _read_json(root / ".claude" / "settings.json")
    container = claude.get("hooks") if isinstance(claude, dict) else None
    session = container.get("SessionStart") if isinstance(container, dict) else None
    if any(any(needle in (str(hook.get("command", "")) if isinstance(hook, dict) else "")
               for needle in CK_CLAUDE_HOOK_NEEDLES)
           for entry in (session if isinstance(session, list) else [])
           if isinstance(entry, dict) for hook in entry.get("hooks") or []):
        hosts.append("claude")
    return hosts


def _ck_link_host(root: Path, host: str, output: Path) -> str:
    """Point one host's instruction path at the generated context: `linked`,
    `kept`, or `blocked: ...` where the path holds something else."""
    link = CK_HOST_LINKS[host]
    path = root / link
    if _ck_is_link(root, link, output):
        return "kept"
    if path.is_symlink():
        target = path.resolve()
        if target.exists() and not _ck_generated(target):
            return f"blocked: {link.as_posix()} links to {target}, which ContextKit does not own"
    elif path.exists():
        if not _ck_generated(path):
            return f"blocked: {link.as_posix()} exists and is not ContextKit-generated context"
    path.parent.mkdir(parents=True, exist_ok=True)
    relative = os.path.relpath((root / output).resolve(strict=False), path.parent.resolve())
    temp = path.parent / f".{path.name}.{os.getpid()}.contextkit-link"
    temp.unlink(missing_ok=True)
    temp.symlink_to(relative)
    temp.replace(path)
    return "linked"


def cmd_build(print_only: bool, json_output: bool) -> None:
    root = _require_project().resolve()
    if not _contextkit_managed(root):
        _die(6, "not_contextkit_bound",
             f"{root} has no ContextKit binding ({CONTEXTKIT_CONFIG_REL.as_posix()}), "
             "so it has no generated agent context to build",
             "run `capabilities context --claude` or `--codex` for a project without one")
    text, warnings, binding = _ck_compose(root)
    output = root / binding["output"]
    if print_only:
        if json_output:
            _emit({"project": str(root), "output": str(output), "text": text,
                   "warnings": warnings})
        else:
            sys.stdout.write(text)
        return
    if output.is_symlink() or (output.exists() and not _ck_generated(output)):
        _die(6, "output_not_generated",
             f"{output} exists and is not ContextKit-generated context; it is left as it is",
             "move it, or point `[output] context` at a free path")
    try:
        previous = output.read_text(encoding="utf-8", errors="replace") if output.is_file() else None
    except OSError:
        previous = None
    output.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", delete=False, dir=str(output.parent)) as tmp:
        tmp.write(text)
        tmp_path = Path(tmp.name)
    tmp_path.replace(output)
    output.chmod(0o644)
    links = {host: _ck_link_host(root, host, binding["output"])
             for host in _ck_installed_hosts(root)}
    warnings += [f"{host} link {status}" for host, status in links.items()
                 if status.startswith("blocked")]
    _emit({"project": str(root), "output": str(output), "created": previous is None,
           "changed": previous is not None and previous != text, "links": links,
           "foreign_instructions": _ck_foreign_instruction_files(root, binding["output"]),
           "warnings": warnings})


# ---------------------------------------------------------------- init

HOOK_COMMAND = "capabilities context --claude"


def _wire_claude_hook(root: Path) -> bool:
    settings_file = root / ".claude" / "settings.json"
    settings = _read_host_settings(settings_file)
    hooks = settings.setdefault("hooks", {})
    session = hooks.setdefault("SessionStart", [])
    for entry in session:
        for h in (entry or {}).get("hooks", []):
            if "capabilities context" in h.get("command", ""):
                return False
    session.append({"hooks": [{"type": "command", "command": HOOK_COMMAND}]})
    _write_json(settings_file, settings)
    return True


def cmd_init(claude: bool, codex: bool) -> None:
    # init ESTABLISHES the project root: an existing root wins, else cwd.
    global _CONTEXT_WITHOUT_STORE
    _CONTEXT_WITHOUT_STORE = True
    root = _project_root() or Path.cwd().resolve()
    new_agent = _new_agent_project(root)
    if new_agent:
        _preflight_new_agent(root)
    migrated = _ensure_envelope(root, new_agent=new_agent)
    registration = _register_agent_on_init(root, new_agent=new_agent)
    if new_agent and not registration.get("migrated"):
        # Its identity was written by this init alone: removing it leaves the
        # project new, so the next init creates the agent again.
        (_envelope_home(root) / PROJECT_IDENTITY_REL).unlink(missing_ok=True)
        error = registration.get("error") or {}
        _die(5, error.get("code") or "store_write_failed",
             error.get("message") or "the new agent could not be registered in the store",
             "run `capabilities init` again once the store answers")
    # The gate is named where the project keeps it: its settings.json in files
    # mode, the store's policy rows where its records are in the store.
    # Init's offline part never needs the database: where the project keeps its
    # gate in a store this process cannot reach (an image built without one),
    # the gate is named as the store's table and read where the store is.
    # Only a store that is absent is passed over: any other refusal of the
    # project's records stops init, as it always has.
    store = _store_module()
    try:
        adapter = _open_project_records(root)
    except store.StoreError as exc:
        if not _store_absent(exc):
            _die(_store_error_exit(exc), exc.slug, exc.message, exc.hint)
        adapter = None
    try:
        gate = _gate_source(adapter, root, "project") if adapter is not None else None
    except store.StoreError as exc:
        if not _store_absent(exc):
            _die(_store_error_exit(exc), exc.slug, exc.message, exc.hint)
        gate = None
    finally:
        if adapter is not None:
            adapter.close()
    if gate is None:
        gate = "store:capabilities_policy (no database reachable here)"
    result: dict = {"project": str(root),
                    "gate": gate,
                    "agent": registration}
    if migrated:
        result["migrated_from"] = str(root / LEGACY_PROJECT_CAPABILITIES_REL)
        result["migrated_entries"] = migrated
    if not claude and not codex:
        claude = True
    if _contextkit_managed(root):
        targets = (["claude"] if claude else []) + (["codex"] if codex else [])
        result["context"] = _contextkit_handoff(root, targets)
        retired = _retire_capabilities_host_wiring(root)
        if retired:
            result["retired_capabilities_wiring"] = retired
        _sync_skill(force_claude=claude, force_codex=codex)
        _emit(result)
        return
    # Refuse an unreadable host settings file before either host is touched.
    if claude:
        _read_host_settings(root / ".claude" / "settings.json")
    if codex:
        _read_host_settings(root / CODEX_HOOKS_REL)
    if claude:
        result["hook_added"] = _wire_claude_hook(root)
        result["context"] = str(_write_host_context(root, "claude")["path"])
    if codex:
        migration = _migrate_codex_legacy(root)
        if migration["removed"]:
            result["migrated_codex_legacy"] = migration["removed"]
        if migration["findings"]:
            result["codex_migration_findings"] = migration["findings"]
        result["codex"] = _wire_codex(root)
    _sync_skill(force_claude=claude, force_codex=codex)
    _emit(result)

# ---------------------------------------------------------------- skill

# The one place an agent learns the system exists before any project is open.
# It is a carried asset, not a composed one: it names the manager and stops
# there, because what is installed, what is gated, and what each capability
# does are answered by the manager and by each project's own context.
CANONICAL_SKILL_DIR = CAP_HOME / ".manager" / "skill"
CANONICAL_SKILL = CANONICAL_SKILL_DIR / "SKILL.md"


def _skill_hosts(force_claude: bool = False, force_codex: bool = False) -> list[Path]:
    """Where each agent host present on this machine reads global skills."""
    codex_home = Path(os.environ.get("CODEX_HOME") or (Path.home() / ".codex"))
    hosts = []
    if force_claude or (Path.home() / ".claude").is_dir():
        hosts.append(Path.home() / ".claude" / "skills" / "capabilities")
    if force_codex or codex_home.is_dir():
        hosts.append(Path.home() / ".agents" / "skills" / "capabilities")
    return hosts


def _link_skill(host: Path) -> None:
    """Point one host at the canonical skill without clobbering foreign content."""
    if host.is_symlink():
        if host.resolve() == CANONICAL_SKILL_DIR.resolve():
            return
        host.unlink()
    elif host.is_dir():
        if {entry.name for entry in host.iterdir()} - {"SKILL.md"}:
            host.joinpath("SKILL.md").write_text(CANONICAL_SKILL.read_text())
            return
        shutil.rmtree(host)
    elif host.exists():
        host.unlink()
    host.parent.mkdir(parents=True, exist_ok=True)
    staged = host.with_name(f".{host.name}.link-{secrets.token_hex(8)}")
    staged.unlink(missing_ok=True)
    staged.symlink_to(CANONICAL_SKILL_DIR)
    os.replace(staged, host)


def _sync_skill(force_claude: bool = False, force_codex: bool = False) -> list[str]:
    """Place the carried skill once and point every present host at it."""
    CANONICAL_SKILL_DIR.mkdir(parents=True, exist_ok=True)
    carried = (_ASSET_ROOT / SKILL_ASSET).read_text()
    if not CANONICAL_SKILL.is_file() or CANONICAL_SKILL.read_text() != carried:
        CANONICAL_SKILL.write_text(carried)
    linked = []
    for host in _skill_hosts(force_claude, force_codex):
        _link_skill(host)
        linked.append(str(host))
    return linked


def cmd_skill() -> None:
    """Place the canonical skill and relink the hosts on this machine."""
    linked = _sync_skill()
    _emit({"skill": str(CANONICAL_SKILL), "hosts": linked})


# ---------------------------------------------------------------- doctor

def _check_registry(findings: list[str], owner: str, conn_file: Path) -> None:
    """Validate one connections envelope; append findings."""
    reg = _read_json(conn_file)
    if not isinstance(reg, dict) or not isinstance(reg.get("connections"), dict) \
            or not reg["connections"]:
        findings.append(f"{owner}: {conn_file} is not a connections envelope "
                        f"(needs a non-empty 'connections' object)")
        return
    entries = reg["connections"]
    default = reg.get("default")
    if default is not None and default not in entries:
        findings.append(f"{owner}: connections default {default!r} names no entry "
                        f"(known: {', '.join(sorted(entries))}) — {conn_file}")
    for cid, entry in entries.items():
        if not isinstance(entry, dict):
            findings.append(f"{owner}: connection {cid!r} is not an object — {conn_file}")
            continue
        aw = entry.get("allow_write")
        if aw is not None and not isinstance(aw, bool):
            findings.append(f"{owner}: connection {cid!r} allow_write is not a "
                            f"boolean — {conn_file}")


def _check_policy(findings: list[str], owner: str, gate_file: Path) -> dict:
    """Validate a project/global policy file without making doctor abort early."""
    if not gate_file.exists():
        return {}
    gate = _read_json(gate_file)
    if not isinstance(gate, dict):
        findings.append(f"{owner}: policy file is unreadable or not an object "
                        f"({gate_file})")
        return {}
    caps = gate.get("capabilities")
    if not isinstance(caps, dict):
        findings.append(f"{owner}: policy needs a 'capabilities' object "
                        f"({gate_file})")
        return {}
    for name, entry in caps.items():
        if not isinstance(entry, dict):
            findings.append(f"{owner}: policy entry {name!r} is not an object")
            continue
        extra = set(entry) - {"enabled"}
        if extra:
            findings.append(f"{owner}: policy entry {name} carries non-standard "
                            f"keys: {sorted(extra)}")
        if not isinstance(entry.get("enabled"), bool):
            findings.append(f"{owner}: policy entry {name} needs boolean 'enabled'")
        elif entry["enabled"] is True and name not in _installed():
            findings.append(f"{owner}: {name} enabled but not installed")
    return caps


def _check_record_connections(findings: list[str], adapter, names) -> None:
    """Validate project connection/grant records through their live reader. A
    store that cannot be used is one finding, not one per capability."""
    store = _store_module()
    for name in sorted(names):
        try:
            identities = adapter.resolve(name, "connection")
            grants = adapter.resolve(name, "grant")
            adapter.connections(name, include_disabled=True)
        except store.StoreError as exc:
            if exc is getattr(adapter, "_failure", None):
                findings.append(f"project: connections store unavailable "
                                f"({exc.slug}): {exc.message}")
                return
            findings.append(f"project: {name} records: {exc.message}")
            continue
        for cid, row in identities.items():
            if not isinstance(row.get("value"), dict):
                findings.append(
                    f"project: {name} connection {cid!r} is not an object")
        for cid, row in grants.items():
            value = row.get("value")
            if not isinstance(value, dict):
                findings.append(f"project: {name} grant {cid!r} is not an object")
                continue
            for field in ("enabled", "allow_write"):
                if field in value and not isinstance(value[field], bool):
                    findings.append(
                        f"project: {name} grant {cid!r} {field} is not boolean")


def _check_skill(findings: list[str]) -> None:
    """Reconcile the global awareness surface: one artifact, hosts pointing at it."""
    try:
        carried = (_ASSET_ROOT / SKILL_ASSET).read_text()
    except OSError as exc:
        findings.append(f"skill: carried skill unreadable ({exc}) — reinstall the manager")
        return
    if not CANONICAL_SKILL.is_file():
        findings.append(f"skill: {CANONICAL_SKILL} missing — run `capabilities skill`")
    elif CANONICAL_SKILL.read_text() != carried:
        findings.append(f"skill: {CANONICAL_SKILL} differs from the carried skill — "
                        f"run `capabilities skill`")
    for host in _skill_hosts():
        if not host.exists():
            findings.append(f"skill: {host} missing — run `capabilities skill`")
        elif host.resolve() != CANONICAL_SKILL_DIR.resolve():
            findings.append(f"skill: {host} does not resolve to "
                            f"{CANONICAL_SKILL_DIR} — run `capabilities skill`")


def _grant_agents_information(root: Path) -> list[dict]:
    """Grants in this project's store whose agent ContextKit's registry does
    not know, as information and never as a failure: an agent id is a soft
    reference to an identity that lives outside these tables, and the registry
    may not exist in this store at all."""
    db = _db_module()
    try:
        conn = db.connect(application_name="capabilities", project_root=root,
                          transaction=True)
    except db.DbError:
        return []
    import psycopg
    out: list[dict] = []
    try:
        grants = conn.execute(
            "SELECT agent_id, count(*) FROM capabilities_connection_grants "
            "GROUP BY agent_id ORDER BY agent_id").fetchall()
        if not grants:
            return out
        registry = conn.execute("SELECT to_regclass('contextkit_agents')").fetchone()[0]
        if registry is None:
            out.append({"code": "agents_registry_absent",
                        "message": "ContextKit's agent registry (contextkit_agents) is "
                                   "not in this store, so no grant's agent_id was "
                                   "checked against it"})
            return out
        known = {row[0] for row in conn.execute(
            "SELECT id::text FROM contextkit_agents WHERE id::text = ANY(%s)",
            ([agent for agent, _count in grants],)).fetchall()}
        for agent, count in grants:
            if agent not in known:
                out.append({"code": "grant_agent_unknown", "agent_id": agent,
                            "grants": count,
                            "message": f"{count} connection grant(s) name agent {agent}, "
                                       "which ContextKit's registry does not know"})
    except psycopg.Error as exc:
        out.append({"code": "agents_unchecked",
                    "message": f"the grants' agents could not be checked: {exc}"})
    finally:
        conn.close()
    return out


def cmd_doctor() -> None:
    findings: list[str] = []
    information: list[dict] = []
    bin_dir = _bin_dir()
    for name, meta in _installed().items():
        script = _script_path(name)
        # The registry copy is the canonical binary — a real file the manager
        # wrote, never a symlink into a working tree. A dev-time `ln -s` back to
        # a project checkout makes the machine run an uncommitted binary and
        # reintroduces a direct project reference; the closed-loop source
        # release lifecycle exists to prevent exactly that.
        if script.is_symlink():
            findings.append(
                f"{name}: registry script is a symlink to {script.resolve()}, "
                f"not a canonical file under {CAP_HOME} — reinstall from the "
                f"canonical source with `capabilities install {name}`")
        if not os.access(script, os.X_OK):
            findings.append(f"{name}: script is not executable ({script})")
        link = bin_dir / name
        if not link.is_symlink():
            findings.append(f"{name}: no symlink at {link}")
        elif link.resolve() != script.resolve():
            findings.append(f"{name}: symlink points to {link.resolve()}, not {script}")
        stub, manifest = _load_snapshots(name)
        if stub is None:
            findings.append(f"{name}: stub snapshot missing — run `capabilities update {name}`")
        if manifest is None:
            findings.append(f"{name}: manifest snapshot missing — run `capabilities update {name}`")
        recorded = meta.get("sha256")
        if recorded and script.exists() and _sha256(script) != recorded:
            findings.append(f"{name}: script hash differs from snapshot key — "
                            f"run `capabilities update {name}` to refresh snapshots")
        user_reg = _CONFIG_HOME / name / "connections.json"
        if user_reg.exists():
            _check_registry(findings, name, user_reg)
    _check_skill(findings)
    _check_policy(findings, "global", GLOBAL_GATE_FILE)
    root = _project_root()
    if root and (root / LEGACY_PROJECT_CAPABILITIES_REL).is_dir():
        findings.append(
            "project: legacy .capabilities/ envelope is still present — run "
            "`capabilities init` to migrate it into visible capabilities/")
    envelope = _project_capabilities_dir(root) if root else None
    identity = _project_id_state(root) if root else None
    if identity and identity["state"] == "mismatch":
        findings.append(
            f"project: project.json holds project id {identity['project_json_id']}, "
            f"but this process was handed down {identity['handed_id']} — writes "
            "that stamp the project id refuse until they agree")
    if root and envelope and ((envelope / "settings.json").is_file()
                              or (envelope / PROJECT_IDENTITY_REL).is_file()):
        store_finding = None
        try:
            caps, _global_caps = _policy_views_checked(root)
        except _store_module().StoreError as exc:
            # A store that holds the gate and cannot be used is drift like any
            # other; the rest of the project is still worth reconciling.
            caps = {}
            store_finding = (f"project: records store unavailable "
                             f"({exc.slug}): {exc.message}")
            findings.append(store_finding)
        gi = envelope / ".gitignore"
        if not gi.exists() or "*/state/" not in gi.read_text():
            findings.append(f"project: {gi} missing the */state/ "
                            f"guard — session state could be committed")
        records = None
        store = _store_module()
        try:
            records = _open_project_records(root)
            in_store = records.mode_of("grant") == "store"
            if in_store:
                try:
                    # Proves the store answers, and gives the connection back.
                    records._begin()
                    records._end()
                except store.StoreError as exc:
                    if store_finding is None:
                        findings.append(f"project: connections store unavailable "
                                        f"({exc.slug}): {exc.message}")
            if not in_store or records._failure is None:
                _check_record_connections(findings, records, _installed())
            if in_store and records._failure is None:
                information = _grant_agents_information(root)
        except store.StoreError as exc:
            findings.append(f"project: records unavailable: {exc.message}")
        finally:
            if records is not None:
                records.close()
        settings = _read_json(root / ".claude" / "settings.json") or {}
        deny = (settings.get("permissions") or {}).get("deny") or []
        for n, g in caps.items():
            if isinstance(g, dict) and g.get("enabled") is True \
                    and _deny_rule(n) in deny:
                findings.append(f"project: {n} is enabled but a deny rule blocks it "
                                f"— remove {_deny_rule(n)} or disable the capability")
        # ContextKit owns every host binding in a bound project. Its compiler
        # may intentionally use the same legacy-looking paths that standalone
        # capabilities wiring used, so only the owner may judge them there.
        if not _contextkit_managed(root):
            legacy_script = root / ".codex" / "hooks" / "build-context.sh"
            if legacy_script.exists():
                findings.append("project: legacy .codex/hooks/build-context.sh present "
                                "— run `capabilities init --codex` to migrate to direct invocation")
            codex_hooks_file = root / CODEX_HOOKS_REL
            if codex_hooks_file.exists():
                hooks = _read_json(codex_hooks_file) or {}
                for entry in (hooks.get("hooks", {}).get("SessionStart") or []):
                    for h in (entry or {}).get("hooks", []):
                        if ".codex/hooks/build-context.sh" in h.get("command", ""):
                            findings.append("project: .codex/hooks.json contains legacy hook to "
                                            "build-context.sh — run `capabilities init --codex` to migrate")
            codex_config = root / CODEX_CONFIG_REL
            if codex_config.exists():
                config_text = codex_config.read_text()
                if ".codex/generated/context.md" in config_text:
                    findings.append("project: .codex/config.toml points to legacy context.md "
                                    "— run `capabilities init --codex` to migrate to capabilities.md")
            if _codex_wired(root):
                link_rel = CODEX_ROOT_LINK_REL.as_posix()
                fallback = re.search(
                    r"^project_doc_fallback_filenames\s*=\s*\[(.*?)\]",
                    config_text[:_toml_root_end(config_text)], flags=re.M | re.S)
                if not fallback or json.dumps(link_rel) not in fallback.group(1) \
                        and repr(link_rel) not in fallback.group(1):
                    findings.append(
                        f"project: .codex/config.toml does not name `{link_rel}` in its "
                        "root project_doc_fallback_filenames — run `capabilities "
                        "context --codex` to repair")
                if not _codex_link_ok(root) or not (root / CODEX_CAPABILITIES_REL).is_file():
                    findings.append(
                        f"project: `{link_rel}` is missing or does not link to "
                        f"{CODEX_CAPABILITIES_REL.as_posix()} — run `capabilities "
                        "context --codex` to repair")
                for blocker in _codex_delivery_blockers(root):
                    findings.append(f"project: Codex capability context does not load — {blocker}")
    report = {"ok": not findings, "findings": findings}
    if information:
        report["information"] = information
    if identity is not None:
        report["project_identity"] = identity
    read_only = _read_only_report()
    if read_only is not None:
        report["read_only_switch"] = read_only
    if findings:
        _emit(report)
        sys.exit(7)
    _emit(report)

# ---------------------------------------------------------------- contract preamble

def _contract_lock(contract_dir: Path) -> dict:
    """The checksum of every file a region is canonical in. A second canonical
    source is a second thing that can drift, so the lock names them all rather
    than only the first one there was."""
    lock = {"preamble_sha256": _sha256(contract_dir / "preamble.py")}
    for rel in sorted(set(_REGION_SOURCE_REL.values())):
        name = Path(rel).stem
        if name != "preamble":
            lock[f"{name}_sha256"] = _sha256(contract_dir / Path(rel).name)
    return lock


def _fence_markers(region: str) -> tuple[str, str]:
    """The exact open/close marker lines bounding a vendored contract region."""
    source = _REGION_SOURCE_REL.get(region, "contract/preamble.py")
    return (
        f"# >>> contract: {region} (generated — edit {source}, "
        f"run `capabilities sync-contract`) >>>",
        f"# <<< contract: {region} <<<",
    )


def _split_region(text: str, region: str) -> tuple[str, str, str] | None:
    """Split `text` around one fenced region into (head, interior, tail): head
    ends with the open-marker line, tail starts with the close marker, interior
    is everything between. None when the region is absent; ValueError when a
    marker is unbalanced or misordered."""
    open_m, close_m = _fence_markers(region)
    oi, ci = text.find(open_m), text.find(close_m)
    if oi == -1 and ci == -1:
        return None
    if oi == -1 or ci == -1 or ci < oi:
        raise ValueError(f"region {region!r} fence is unbalanced or misordered")
    interior_start = text.find("\n", oi) + 1
    return text[:interior_start], text[interior_start:ci], text[ci:]


def _insert_contract_region(text: str, region: str, interior: str) -> str:
    """Insert a newly required region at its canonical tier boundary."""
    if region != "store":
        raise ValueError(f"no insertion rule for contract region {region!r}")
    anchor = _split_region(text, "capability core")
    if anchor is None:
        raise ValueError("cannot insert store without capability core")
    _, close_m = _fence_markers("capability core")
    close_at = text.find(close_m)
    line_end = text.find("\n", close_at)
    if line_end == -1:
        line_end = len(text)
    open_m, close_m = _fence_markers(region)
    block = f"\n{open_m}\n{interior}{close_m}\n"
    return text[:line_end + 1] + block + text[line_end + 1:]


def _canonical_regions() -> dict[str, str]:
    """The canonical interior text of each region, read from the file that owns it."""
    out: dict[str, str] = {}
    for region in _CONTRACT_REGIONS:
        rel = _REGION_SOURCE_REL[region]
        source = _ASSET_ROOT / rel
        if not source.is_file():
            _die(5, "no_preamble", f"canonical source not found at {source}",
                 "run sync-contract from a checkout of the capabilities repo")
        split = _split_region(source.read_text(), region)
        if split is None:
            _die(7, "bad_fence", f"{rel} is missing region {region!r}")
        out[region] = split[1]
    return out


def _contract_drift(text: str, canonical: dict[str, str]) -> list[str]:
    """Required, malformed, or byte-different canonical regions."""
    out: list[str] = []
    for region, canon in canonical.items():
        try:
            split = _split_region(text, region)
        except ValueError as e:
            out.append(f"{region} ({e})")
            continue
        if split is None and region in _REQUIRED_CONTRACT_REGIONS:
            out.append(f"{region} (missing)")
        elif split is not None and split[1] != canon:
            out.append(region)
    return out


def cmd_sync_contract(check_only: bool) -> None:
    """Stamp (or, with --check, audit) the canonical preamble into every
    capabilities/*/bin/* fenced region. The manager itself never participates."""
    if not _PREAMBLE.is_file():
        _die(5, "no_preamble", f"canonical preamble not found at {_PREAMBLE}",
             "run sync-contract from a checkout of the capabilities repo")
    src = _REPO_ROOT / "capabilities"
    if not src.is_dir():
        _die(5, "no_source", f"capability source tree not found at {src}")
    canonical = _canonical_regions()
    changed: list[dict] = []
    for capdir in sorted(p for p in src.iterdir() if p.is_dir()):
        script = capdir / "bin" / capdir.name
        if not script.is_file():
            continue
        text = script.read_text()
        new_text, stamped = text, []
        for region in _CONTRACT_REGIONS:
            try:
                split = _split_region(new_text, region)
            except ValueError as e:
                _die(7, "bad_fence", f"{capdir.name}: {e}")
            if split is None:
                if region in _REQUIRED_CONTRACT_REGIONS:
                    try:
                        new_text = _insert_contract_region(
                            new_text, region, canonical[region])
                    except ValueError as e:
                        _die(7, "bad_fence", f"{capdir.name}: {e}")
                    stamped.append(region)
                continue
            head, interior, tail = split
            if interior != canonical[region]:
                new_text = head + canonical[region] + tail
                stamped.append(region)
        if stamped:
            changed.append({"capability": capdir.name, "regions": stamped})
            if not check_only:
                script.write_text(new_text)
    if check_only:
        lock_path = _PREAMBLE.parent / "contract.json"
        lock_drift = _read_json(lock_path) != _contract_lock(_PREAMBLE.parent)
        _emit({"preamble": str(_PREAMBLE), "drift": changed,
               "lock_drift": lock_drift, "ok": not changed and not lock_drift})
        if lock_drift:
            changed.append({"contract_lock": str(lock_path)})
        if changed:
            sys.exit(7)
    else:
        lock_path = _PREAMBLE.parent / "contract.json"
        _write_json(lock_path, _contract_lock(_PREAMBLE.parent))
        _emit({"preamble": str(_PREAMBLE), "stamped": changed,
               "contract_lock": str(lock_path), "ok": True})

# ---------------------------------------------------------------- audit

def _tree_digest(root: Path) -> str:
    """A stable digest of every file under one tree, contents included.

    `inventory` claims to leave nothing behind it; this is what turns the claim
    into an observation rather than a promise."""
    digest = hashlib.sha256()
    for path in sorted(p for p in root.rglob("*") if p.is_file()):
        digest.update(str(path.relative_to(root)).encode())
        digest.update(b"\0")
        try:
            digest.update(path.read_bytes())
        except OSError as exc:
            digest.update(f"<unreadable: {exc}>".encode())
        digest.update(b"\0")
    return digest.hexdigest()


def _validate_inventory(name: str, out: str, manifest) -> list[str]:
    """The envelope shape a reader renders without knowing the capability."""
    problems: list[str] = []
    try:
        report = json.loads(out)
    except ValueError:
        return ["not JSON"]
    if not isinstance(report, dict):
        return ["output is not a JSON object"]
    for field in ("capability", "project", "network", "metrics", "items",
                  "service", "deferred"):
        if field not in report:
            problems.append(f"missing field: {field}")
    if report.get("capability") != name:
        problems.append(f"capability {report.get('capability')!r} != {name!r}")
    if report.get("network") is not False:
        problems.append("a bare report must state network: false")
    for field, shape in (("metrics", ("label", "value")), ("deferred", ("label",))):
        rows = report.get(field)
        if not isinstance(rows, list):
            problems.append(f"{field} is not a list")
            continue
        for row in rows:
            if not isinstance(row, dict) or any(k not in row for k in shape):
                problems.append(f"{field} entry malformed: {row!r}")
    items = report.get("items")
    if not isinstance(items, list):
        problems.append("items is not a list")
    else:
        for item in items:
            if not isinstance(item, dict) or not str(item.get("name") or "").strip():
                problems.append(f"items entry malformed: {item!r}")
    service = report.get("service")
    if service is not None and (not isinstance(service, dict)
                                or not str(service.get("state") or "").strip()):
        problems.append(f"service is neither null nor {{state, detail?}}: {service!r}")
    elif isinstance(service, dict) and "ok" in service:
        if not isinstance(service["ok"], bool):
            problems.append(f"service ok is neither true nor false: {service['ok']!r}")
        elif service["ok"] is False and not str(service.get("problem") or "").strip():
            problems.append("service ok is false and names no problem")
    if service is None and isinstance(manifest, dict) and manifest.get("service"):
        problems.append("the capability ships a service and reports no state for it")
    return problems


def _audit_script(
    name: str, script: Path, manifest_result: list[dict] | None = None
) -> list[str]:
    failures: list[str] = []
    env = _snapshot_env()
    # Source/isolated audit sandboxes may intentionally omit the manager from
    # PATH. Capability CLIs still exercise the public manager-owned path contract.
    env["CAPABILITIES_MANAGER_BIN"] = str(Path(__file__).resolve())
    script_text = script.read_text()
    # A capability with no `connections` fence is core-only: it carries the
    # capability-core declaration surface and stops (DOCTRINE — core-only is an
    # absence, not a deviation). Its `connections` verb reports no connections.
    core_only = _split_region(script_text, "connections") is None

    if _PREAMBLE.is_file():
        for region in _contract_drift(script_text, _canonical_regions()):
            source_region = region.split(" (", 1)[0]
            source = _REGION_SOURCE_REL.get(
                source_region, "contract/preamble.py")
            failures.append(
                f"contract-drift: {region} differs from {source} "
                f"— run `capabilities sync-contract`")

    # doctor gates on the shared resolution before any round-trip: a
    # connection-bearing capability's doctor consumes _doctor_gate — the cascade
    # verdict the `connections` report reads — so readiness is judged through one
    # resolver, never a parallel credential check. The call lives in the
    # capability's own code, outside the vendored fence that defines the helper.
    if not core_only:
        _conn = _split_region(script_text, "connections")
        _outside = script_text.replace(_conn[1], "") if _conn else script_text
        if "_doctor_gate(" not in _outside:
            failures.append(
                "doctor: no _doctor_gate(...) call in the capability's own code "
                "— readiness must be judged through the cascade resolution, not "
                "a parallel check")

    rc, out, err = _run_script(script, ["stub"], env=env)
    if rc != 0:
        failures.append(f"stub: exit {rc}")
    else:
        stub = out.strip()
        if not stub:
            failures.append("stub: empty")
        elif "\n" in stub:
            failures.append("stub: more than one line")
        elif f"`{name} help`" not in stub:
            failures.append(f"stub: does not end in the discovery pointer `{name} help`")

    manifest = None
    rc, out, err = _run_script(script, ["manifest", "--json"], env=env)
    if rc != 0:
        failures.append(f"manifest: exit {rc}")
    else:
        try:
            manifest = json.loads(out)
        except ValueError:
            failures.append("manifest: not JSON")
    if manifest is not None:
        failures += [f"manifest: {p}" for p in _validate_manifest(name, manifest)]
        if str(manifest.get("summary", "")).startswith("TODO:"):
            failures.append("manifest: scaffold summary placeholder remains")
        bundle = script.parent.parent if script.parent.name == "bin" else script.parent
        guide_dir = bundle / "guides"
        shipped_topics = ({p.stem for p in guide_dir.glob("*.md")}
                          if guide_dir.is_dir() else set())
        declared_docs = manifest.get("docs") or {}
        declared_topics = set(declared_docs.get("topics") or [])
        if shipped_topics != declared_topics:
            failures.append(
                "guide: shipped guide files do not match manifest topics "
                f"(files={sorted(shipped_topics)}, manifest={sorted(declared_topics)})")
        if shipped_topics and not str(declared_docs.get("base") or "").strip():
            failures.append("guide: bundled guides require a non-empty manifest docs.base")
        service_dir = bundle / "service"
        declared_service = manifest.get("service")
        if service_dir.is_dir() and declared_service is None:
            failures.append(
                "manifest: service/ ships in the bundle but manifest.service is absent")
        if declared_service is not None and not service_dir.is_dir():
            failures.append(
                "manifest: manifest.service is declared but service/ is absent from the bundle")
    if manifest is not None and manifest_result is not None:
        manifest_result.append(manifest)

    # The declaration and the builder are one fact in two places, and a
    # capability that declares an inventory it cannot build fails only when
    # someone asks for it. This is that question asked here instead.
    _fences = [r for r in (_split_region(script_text, region)
                           for region in _CONTRACT_REGIONS) if r]
    own_code = script_text
    for _head, interior, _tail in _fences:
        own_code = own_code.replace(interior, "")
    declares = re.search(r"^INVENTORY\s*=\s*(?!None\b)\S", own_code, re.M) is not None
    builds = "def _inventory(" in own_code
    if declares and not builds:
        failures.append(
            "inventory: INVENTORY is declared but the capability defines no "
            "_inventory(network) builder")
    if builds and not declares:
        failures.append(
            "inventory: an _inventory(network) builder is defined but "
            "INVENTORY is not declared, so nothing ever calls it")
    if manifest is not None and (manifest.get("inventory") is not None) != declares:
        failures.append(
            "inventory: the manifest declaration and the INVENTORY constant "
            "disagree")

    if "Replace this scaffold check with" in script_text:
        failures.append("doctor: scaffold readiness placeholder remains")

    rc, out, err = _run_script(script, ["help"], env=env)
    if rc != 0:
        failures.append(f"help: exit {rc}")
    else:
        for verb in ("doctor", "connections", "stub", "manifest", "guide", "ids",
                     "refs", "inventory"):
            if verb not in out:
                failures.append(f"help: contract verb {verb!r} undocumented")
    failures += [f"connections/machine-reads: {p}" for p in _machine_reads_problems(
        script, out if rc == 0 else None, env=env)]

    # The effective gate, exercised in a sandbox: project override, inherited
    # global enable, and default deny. Safe declaration verbs are intentionally
    # ungated, so refs is the project-scoped operational probe here.
    # A second throwaway dir isolates the XDG/HOME surface: the verdict must not
    # depend on the developer's real ~/.config or ~/.local/state. A live
    # connections.json there would otherwise leak into the registry check. The
    # home lives outside the sandbox to leave project-root walking
    # (which stops at $HOME) untouched.
    with tempfile.TemporaryDirectory() as td, tempfile.TemporaryDirectory() as home_td:
        sandbox = Path(td)
        home = Path(home_td)
        env = {**env, "HOME": str(home),
               "XDG_CONFIG_HOME": str(home / "config"),
               "XDG_STATE_HOME": str(home / "state"),
               "XDG_DATA_HOME": str(home / "data"),
               "XDG_CACHE_HOME": str(home / "cache")}
        for state, expect in (("disabled", 4), ("enabled", 0),
                              ("inherited", 0), ("absent", 4),
                              ("quarantined", 4)):
            capdir = sandbox / "capabilities"
            global_gate = home / "config" / "capabilities" / "settings.json"
            global_gate.unlink(missing_ok=True)
            machine_file = home / "config" / "capabilities" / "machine.json"
            machine_file.unlink(missing_ok=True)
            if state == "quarantined":
                # The ceiling sits above both scopes: enabled at each, still refused.
                capdir.mkdir(exist_ok=True)
                _write_json(capdir / "settings.json", {
                    "capabilities": {name: {"enabled": True}}})
                _write_json(global_gate, {"capabilities": {name: {"enabled": True}}})
                _write_json(machine_file, {
                    "schema": MACHINE_SCHEMA,
                    "capabilities": {name: {"state": "quarantined",
                                            "at": "audit", "by": "audit"}}})
            elif state in ("absent", "inherited"):
                shutil.rmtree(capdir, ignore_errors=True)
                (sandbox / ".git").mkdir(exist_ok=True)  # roots the walk
                if state == "inherited":
                    _write_json(global_gate, {
                        "capabilities": {name: {"enabled": True}}})
            else:
                capdir.mkdir(exist_ok=True)
                _write_json(capdir / "settings.json", {
                    "capabilities": {name: {"enabled": state == "enabled"}}})
            genv = dict(env)
            genv["CLAUDE_PROJECT_DIR"] = str(sandbox)
            rc, out, errs = _run_script(script, ["refs"], cwd=sandbox, env=genv)
            if rc != expect:
                failures.append(f"gate/{state}: `refs` exited {rc}, expected {expect}")
            if expect == 4:
                try:
                    envl = json.loads(errs.strip().splitlines()[-1])
                    expected_code = {"disabled": "disabled",
                                     "quarantined": "quarantined"}.get(state, "not_enabled")
                    if envl.get("error", {}).get("code") != expected_code:
                        failures.append(
                            f"gate/{state}: envelope code is not {expected_code!r}")
                except (ValueError, IndexError):
                    failures.append(f"gate/{state}: no JSON error envelope on stderr")
            if state == "quarantined":
                rc, _out, _errs = _run_script(script, ["stub"], cwd=sandbox, env=genv)
                if rc != 0:
                    failures.append(f"gate/{state}: safe discovery `stub` exited {rc}")
                machine_file.unlink(missing_ok=True)
                global_gate.unlink(missing_ok=True)

        # refs + ids in an enabled sandbox project
        capdir = sandbox / "capabilities"
        capdir.mkdir(exist_ok=True)
        _write_json(capdir / "settings.json",
                    {"capabilities": {name: {"enabled": True}}})
        genv = dict(env)
        genv["CLAUDE_PROJECT_DIR"] = str(sandbox)
        refdir = capdir / name / "reference"
        refdir.mkdir(parents=True, exist_ok=True)
        (refdir / "audit-probe.md").write_text(
            "---\nname: audit-probe\ndescription: audit probe reference\n---\n\nbody\n")
        rc, out, errs = _run_script(script, ["refs"], cwd=sandbox, env=genv)
        if rc != 0:
            failures.append(f"refs: exit {rc}")
        else:
            try:
                arr = json.loads(out)
                if not isinstance(arr, list):
                    failures.append("refs: output is not a JSON array")
                elif not any((r or {}).get("name") == "audit-probe" for r in arr):
                    failures.append(
                        "refs: a reference in capabilities/<name>/reference/ is not surfaced")
            except ValueError:
                failures.append("refs: not JSON")
        rc, out, errs = _run_script(script, ["ids", "list"], cwd=sandbox, env=genv)
        if rc != 0:
            failures.append(f"ids list: exit {rc}")
        else:
            try:
                if not isinstance(json.loads(out), dict):
                    failures.append("ids list: output is not a JSON object")
            except ValueError:
                failures.append("ids list: not JSON")
        rc, out, errs = _run_script(
            script, ["ids", "set", "audit-probe", '{"v": 1}', "--note", "audit probe"],
            cwd=sandbox, env=genv)
        if rc != 0:
            failures.append(f"ids set: exit {rc}")
        else:
            stored = _read_json(capdir / name / "identifiers.json") or {}
            probe = stored.get("audit-probe") or {}
            if probe.get("value") != {"v": 1} or probe.get("note") != "audit probe":
                failures.append("ids set: envelope shape wrong in identifiers.json")
            rc, out, errs = _run_script(script, ["ids", "get", "audit-probe"],
                                        cwd=sandbox, env=genv)
            if rc != 0:
                failures.append(f"ids get: exit {rc}")
            rc, out, errs = _run_script(script, ["ids", "rm", "audit-probe"],
                                        cwd=sandbox, env=genv)
            if rc != 0:
                failures.append(f"ids rm: exit {rc}")

        # inventory — the project self-report every reader renders the same way
        # (DOCTRINE rule 20). Bare, it costs nothing: the sandbox tree is
        # compared byte for byte across the call, so a report that writes into
        # the project or its state is a failure rather than a surprise later.
        before = _tree_digest(sandbox)
        rc, out, errs = _run_script(script, ["inventory"], cwd=sandbox, env=genv)
        if rc != 0:
            failures.append(f"inventory: exit {rc} "
                            f"(the report renders even unconfigured)")
        else:
            failures += [f"inventory: {p}" for p in _validate_inventory(
                name, out, manifest)]
        if _tree_digest(sandbox) != before:
            failures.append(
                "inventory: the bare report changed the project tree — it is a "
                "read and must leave nothing behind it")

        # connections — registry required for connection-bearing capabilities
        def _check_connections(expect_ids: set[str], label: str,
                               expect_default: str | None = None) -> None:
            rc, out, errs = _run_script(script, ["connections"], cwd=sandbox, env=genv)
            if rc != 0:
                failures.append(f"connections/{label}: exit {rc} "
                                f"(the report renders even unconfigured)")
                return
            try:
                report = json.loads(out)
            except ValueError:
                failures.append(f"connections/{label}: not JSON")
                return
            conns = report.get("connections")
            if not isinstance(conns, dict) or set(conns) != expect_ids:
                failures.append(f"connections/{label}: ids {sorted(conns or [])} != "
                                f"{sorted(expect_ids)}")
                return
            if expect_default is not None and report.get("default") != expect_default:
                failures.append(f"connections/{label}: default is "
                                f"{report.get('default')!r}, expected {expect_default!r}")
            for cid, entry in conns.items():
                keys = (entry or {}).get("keys")
                if not isinstance(keys, list):
                    failures.append(f"connections/{label}: {cid} carries no keys list")
                    continue
                for k in keys:
                    if k.get("secret") and k.get("set") and not str(
                            k.get("value", "")).startswith(("…", "****")):
                        failures.append(f"connections/{label}: secret "
                                        f"{k.get('key')!r} not masked")

        if core_only:
            # No connections fence: `connections` reports none, and no registry
            # is consulted. An empty/absent 'connections' map is the contract.
            rc, out, errs = _run_script(script, ["connections"], cwd=sandbox, env=genv)
            if rc != 0:
                failures.append(f"connections/core-only: exit {rc} "
                                f"(the report renders even unconfigured)")
            else:
                try:
                    report = json.loads(out)
                except ValueError:
                    failures.append("connections/core-only: not JSON")
                else:
                    if report.get("connections"):
                        failures.append(
                            "connections/core-only: a capability with no "
                            "connections fence must report no connections "
                            "(an empty 'connections' map)")
        else:
            rc, out, errs = _run_script(script, ["connections"], cwd=sandbox, env=genv)
            if rc != 6:
                failures.append(
                    f"connections/required: exit {rc}, expected 6 without registry")
            else:
                try:
                    code = json.loads(errs)["error"]["code"]
                except (ValueError, KeyError):
                    code = None
                if code != "connections_required":
                    failures.append(
                        "connections/required: missing connections_required envelope")
            conn_file = capdir / name / "connections.json"
            conn_file.parent.mkdir(exist_ok=True)
            _write_json(conn_file, {"default": "a",
                                    "connections": {"a": {}, "b": {"allow_write": False}}})
            _check_connections({"a", "b"}, "registry", expect_default="a")
            conn_file.unlink()

        # guide menu has one exact shape and agrees with the manifest
        if manifest is not None:
            topics = (manifest.get("docs") or {}).get("topics") or []
            rc, out, errs = _run_script(script, ["guide"], cwd=sandbox, env=genv)
            if rc != 0:
                failures.append(f"guide: exit {rc}")
            else:
                try:
                    menu = json.loads(out)
                except ValueError:
                    failures.append("guide: menu is not JSON")
                else:
                    if not isinstance(menu, list):
                        failures.append("guide: menu is not a JSON list")
                    else:
                        expected_keys = {"topic", "title", "preview", "command"}
                        for entry in menu:
                            if not isinstance(entry, dict) or set(entry) != expected_keys:
                                failures.append(f"guide: malformed menu entry {entry!r}")
                                continue
                            topic = entry.get("topic")
                            if (not isinstance(topic, str) or not topic
                                    or not isinstance(entry.get("title"), str)
                                    or not entry["title"].strip()
                                    or not isinstance(entry.get("preview"), str)
                                    or not entry["preview"].strip()
                                    or entry.get("command") != f"{name} guide {topic}"):
                                failures.append(f"guide: incomplete menu entry {entry!r}")
                        menu_topics = [entry.get("topic") for entry in menu
                                       if isinstance(entry, dict)]
                        if menu_topics != topics:
                            failures.append(
                                f"guide: menu topics {menu_topics!r} != manifest {topics!r}")
    return failures


def cmd_audit(name: str, from_ref: str | None) -> None:
    if from_ref:
        p = Path(from_ref).expanduser().resolve()
        if p.is_dir():
            for cand in (p / name, p / "bin" / name,
                         p / "capabilities" / name / "bin" / name):
                if cand.is_file():
                    p = cand
                    break
        if not p.is_file():
            _die(3, "not_found", f"--from script not found: {from_ref}")
        script = p
    else:
        script = _script_path(name)
        if not script.is_file():
            _die(3, "not_found", f"{name} is not installed",
                 f"`capabilities install {name}` or audit --from <path>")
    failures = _audit_script(name, script)
    report = {"name": name, "ok": not failures, "failures": failures}
    _emit(report)
    if failures:
        sys.exit(7)


# ---------------------------------------------------------------- sources / authoring

def _validate_source_id(source_id: str) -> None:
    if not re.fullmatch(r"[a-z0-9][a-z0-9._-]*", source_id):
        _die(6, "bad_source_id", f"invalid source id {source_id!r}",
             "use lowercase letters, digits, dots, underscores, or hyphens")


def _sources_config() -> dict:
    raw = _read_json(SOURCES_FILE)
    if raw is None:
        return {"sources": {}}
    if not isinstance(raw, dict) or not isinstance(raw.get("sources"), dict):
        _die(6, "bad_sources", f"{SOURCES_FILE} is not a sources registry",
             'expected {"sources": {"<id>": {"kind", ...}}}')
    return raw


def _git_checkout_identity(repo: Path) -> dict:
    """Return stable repository identity plus the exact current worktree root.

    The common directory groups linked worktrees.  The top-level path remains
    intentionally separate because authoring commands also require binary
    identity with the worktree under the caller's feet.
    """
    top = _dev_git_value(repo, "rev-parse", "--show-toplevel")
    common = _dev_git_value(repo, "rev-parse", "--git-common-dir")
    top_path = Path(top).resolve()
    common_path = Path(common)
    if not common_path.is_absolute():
        common_path = (top_path / common_path).resolve()
    else:
        common_path = common_path.resolve()
    branch_proc = _dev_git(repo, "symbolic-ref", "--quiet", "--short", "HEAD")
    commit_proc = _dev_git(repo, "rev-parse", "--verify", "HEAD^{commit}")
    return {
        "path": str(top_path),
        "git_common_dir": str(common_path),
        "branch": branch_proc.stdout.strip() if branch_proc.returncode == 0 else None,
        "commit": commit_proc.stdout.strip() if commit_proc.returncode == 0 else None,
    }


def _marked_checkout(path: Path) -> Path | None:
    """Resolve a cwd to a marked capability-source checkout, or return None."""
    probe = _dev_git(path, "rev-parse", "--show-toplevel")
    if probe.returncode != 0:
        return None
    root = Path(probe.stdout.strip()).resolve()
    marker = _read_json(root / "capabilities.repo.json")
    return root if isinstance(marker, dict) and marker.get("kind") == "capability-source" else None


def _official_checkout_binding(required: bool = True) -> dict | None:
    """Load and revalidate the single durable official integration checkout.

    No filesystem search is performed.  Missing, moved, linked-worktree or
    identity-drifted bindings fail before a dev session can be created.
    """
    raw = _sources_config().get("official_checkout")
    hint = (
        "from the clean primary checkout run "
        "`./bin/capabilities source register-checkout official`"
    )
    if not isinstance(raw, dict):
        if required:
            _die(6, "official_checkout_unregistered",
                 "the official integration checkout is not registered", hint)
        return None
    path_value = raw.get("path")
    common_value = raw.get("git_common_dir")
    branch_value = raw.get("branch")
    if not all(isinstance(value, str) and value for value in
               (path_value, common_value, branch_value)):
        if not required:
            return {**raw, "valid": False, "problem": "malformed binding"}
        _die(6, "official_checkout_invalid",
             "the official checkout binding is malformed", hint)
    path = Path(path_value).expanduser().resolve()
    if not path.is_dir() or _marked_checkout(path) != path:
        if not required:
            return {**raw, "valid": False, "problem": "checkout unavailable"}
        _die(6, "official_checkout_stale",
             f"the registered official checkout is unavailable: {path}", hint)
    identity = _git_checkout_identity(path)
    common = Path(identity["git_common_dir"])
    remote = _dev_git(path, "remote", "get-url", "origin")
    # For the primary worktree the common Git directory belongs directly to
    # that worktree. Linked worktrees share it but have a different top level.
    if (identity["git_common_dir"] != str(Path(common_value).expanduser().resolve())
            or common.parent.resolve() != path
            or identity.get("branch") != branch_value
            or remote.returncode != 0
            or _normal_git_url(remote.stdout) != _normal_git_url(OFFICIAL_GIT_URL)):
        if not required:
            return {**raw, "valid": False, "problem": "checkout identity drift"}
        _die(6, "official_checkout_stale",
             f"the official checkout binding no longer matches {path}", hint)
    return {**raw, **identity, "valid": True}


def cmd_source_register_checkout(source_id: str, *, emit_result: bool = True) -> dict:
    """Register this exact primary official checkout after fail-closed checks."""
    if source_id != OFFICIAL_SOURCE_ID:
        _die(6, "input", "register-checkout currently supports only official")
    cwd_root = _marked_checkout(Path.cwd())
    manager_root = _REPO_ROOT.resolve()
    if cwd_root is None:
        _die(6, "not_capability_source",
             "run register-checkout from the official capability-source checkout")
    if cwd_root != manager_root:
        _die(6, "manager_checkout_mismatch",
             f"the running manager belongs to {manager_root}, not {cwd_root}",
             "run `./bin/capabilities source register-checkout official`")
    identity = _git_checkout_identity(cwd_root)
    common = Path(identity["git_common_dir"])
    if common.parent.resolve() != cwd_root:
        _die(6, "primary_checkout_required",
             f"cannot register linked worktree {cwd_root}",
             "run the command from the primary integration checkout")
    remote = _dev_git(cwd_root, "remote", "get-url", "origin")
    if remote.returncode != 0 or _normal_git_url(remote.stdout) != _normal_git_url(OFFICIAL_GIT_URL):
        _die(6, "official_identity_mismatch",
             f"checkout origin is not the official source: {cwd_root}")
    branch = identity.get("branch")
    if branch != "main":
        _die(6, "publication_branch_required",
             f"the official integration checkout must be on publication branch 'main', got {branch!r}")
    cfg = _sources_config()
    previous = cfg.get("official_checkout")
    if isinstance(previous, dict):
        old_path = Path(str(previous.get("path") or "")).expanduser().resolve()
        old_common = Path(str(previous.get("git_common_dir") or "")).expanduser().resolve()
        if old_path != cwd_root and old_common != common and old_path.exists():
            _die(6, "official_checkout_conflict",
                 f"another official checkout is already registered: {old_path}",
                 "remove the conflicting binding deliberately before registering another checkout")
    binding = {
        "path": str(cwd_root),
        "git_common_dir": str(common),
        "branch": branch,
        "registered_at": int(time.time()),
    }
    cfg["official_checkout"] = binding
    _write_json(SOURCES_FILE, cfg)
    result = {"registered": OFFICIAL_SOURCE_ID, "checkout": binding}
    if emit_result:
        _emit(result)
    return result


def _guard_source_checkout(source_id: str, operation: str,
                           locator: bool = False) -> Path | None:
    """Fuse a guarded source operation to cwd and, for official, its manager.

    Custom workspace locators may run outside a source checkout. All other
    guarded calls require an exact registered/linked worktree identity. Official
    calls additionally require the running manager to live in that exact tree.
    """
    cwd_root = _marked_checkout(Path.cwd())
    if locator and source_id != OFFICIAL_SOURCE_ID and cwd_root is None:
        return None
    if cwd_root is None:
        _die(6, "authoring_checkout_required",
             f"{operation} must run from the requested source checkout")
    requested = _source_id_for_repo(cwd_root)
    if requested != source_id:
        _die(6, "source_checkout_mismatch",
             f"cwd checkout {cwd_root} identifies as {requested!r}, not {source_id!r}")
    if source_id == OFFICIAL_SOURCE_ID:
        manager_root = _REPO_ROOT.resolve()
        if manager_root != cwd_root:
            _die(6, "manager_checkout_mismatch",
                 f"cwd checkout is {cwd_root}, but the running manager belongs to {manager_root}",
                 "run the checkout's `./bin/capabilities`, use `capabilities dev exec`, "
                 "or publish with `capabilities dev finish`")
    else:
        entry = _source_entry(source_id)
        if entry.get("kind") != "workspace":
            _die(6, "not_editable", f"source {source_id!r} is not editable")
        expected = _git_checkout_identity(_source_root(source_id))["git_common_dir"]
        actual = _git_checkout_identity(cwd_root)["git_common_dir"]
        if actual != expected:
            _die(6, "source_checkout_mismatch",
                 f"cwd checkout {cwd_root} is not linked to source {source_id!r}")
    return cwd_root


def _source_entry(source_id: str) -> dict:
    if source_id == OFFICIAL_SOURCE_ID:
        return {"kind": "git", "url": OFFICIAL_GIT_URL, "ref": "main",
                "builtin": True}
    cfg = _sources_config()
    entry = (cfg.get("sources") or {}).get(source_id)
    if not isinstance(entry, dict):
        _die(3, "source_not_found", f"unknown capability source {source_id!r}",
             "`capabilities source list` shows registered sources")
    if entry.get("kind") == "workspace":
        configured = Path(entry.get("path") or "").expanduser()
        canonical = _source_workspace(source_id)
        legacy = LEGACY_SOURCE_WORKSPACE_ROOT / source_id
        if configured.resolve() == legacy.resolve():
            if legacy.exists() and canonical.exists():
                _die(6, "workspace_migration_conflict",
                     f"both legacy and canonical workspaces exist for {source_id!r}",
                     f"keep one deliberately, then place it at {canonical}")
            if legacy.exists():
                canonical.parent.mkdir(parents=True, exist_ok=True)
                try:
                    legacy.rename(canonical)
                except OSError as e:
                    _die(6, "workspace_migration_failed",
                         f"could not move legacy workspace to {canonical}: {e}",
                         f"move {legacy} to {canonical} manually, then retry")
                try:
                    LEGACY_SOURCE_WORKSPACE_ROOT.rmdir()
                except OSError:
                    pass
                entry["path"] = str(canonical)
                _write_json(SOURCES_FILE, cfg)
                configured = canonical
            elif canonical.exists():
                entry["path"] = str(canonical)
                _write_json(SOURCES_FILE, cfg)
                configured = canonical
        if configured.resolve() != canonical.resolve():
            _die(6, "noncanonical_workspace",
                 f"source {source_id!r} workspace is not canonical: {configured}",
                 f"managed source workspaces must live at {canonical}")
    elif entry.get("kind") != "git":
        _die(6, "bad_source", f"source {source_id!r} has unknown kind {entry.get('kind')!r}")
    return entry


def _source_workspace(source_id: str) -> Path:
    return SOURCE_WORKSPACE_ROOT / source_id


def _source_cache(source_id: str) -> Path:
    return SOURCE_CACHE_ROOT / source_id


def _source_root(source_id: str) -> Path:
    entry = _source_entry(source_id)
    if entry.get("kind") == "workspace":
        return Path(entry.get("path") or _source_workspace(source_id)).expanduser()
    return _source_cache(source_id)


def _source_designates(source_id: str, repo: Path) -> bool:
    """Answer whether a source's registration designates this exact checkout.

    A registration designates a checkout only where it names one: the official
    integration checkout binding, or a registered workspace — either as itself
    or as a worktree linked to it. A fetched source names no checkout, so its
    registration designates nothing on disk but its own cache clone.
    """
    if source_id == OFFICIAL_SOURCE_ID:
        binding = _sources_config().get("official_checkout")
        if not isinstance(binding, dict):
            return False
        designated = Path(str(binding.get("git_common_dir") or "")).expanduser()
    else:
        if _source_entry(source_id).get("kind") != "workspace":
            return False
        workspace = _source_root(source_id)
        if not workspace.is_dir():
            return False
        designated = Path(_git_checkout_identity(workspace)["git_common_dir"])
    if not designated.is_absolute():
        return False
    return _git_checkout_identity(repo)["git_common_dir"] == str(designated.resolve())


def _source_local_root(source_id: str) -> Path:
    """Resolve the tree a source's registration designates, for reading only.

    A cwd checkout answers only where the registration designates it, then the
    running manager's own official checkout, then the registered root — an
    editable workspace, or the manager-owned cache clone of a fetched source.
    A cwd merely claiming the same origin never stands in for that clone, so a
    read reports on the tree the registration names and not on the caller's.
    """
    cwd_root = _marked_checkout(Path.cwd())
    if cwd_root is not None and _source_designates(source_id, cwd_root):
        return cwd_root
    if source_id == OFFICIAL_SOURCE_ID and \
            (_REPO_ROOT / "capabilities.repo.json").is_file():
        return _REPO_ROOT
    return _source_root(source_id)


def _source_author_root(source_id: str) -> Path:
    """Return the editable root selected by an already-applied identity fuse."""
    cwd_root = _marked_checkout(Path.cwd())
    if cwd_root is not None and _source_id_for_repo(cwd_root) == source_id:
        return cwd_root
    if source_id == OFFICIAL_SOURCE_ID and \
            (_REPO_ROOT / "capabilities.repo.json").is_file():
        return _REPO_ROOT
    return _source_root(source_id)


def _git(args: list[str], cwd: Path | None = None) -> str:
    try:
        proc = subprocess.run(["git", *args], cwd=str(cwd) if cwd else None,
                              capture_output=True, text=True, timeout=120)
    except FileNotFoundError:
        _die(6, "missing_git", "git is required for capability sources")
    except subprocess.TimeoutExpired:
        _die(5, "git_timeout", "git command timed out", " ".join(args))
    if proc.returncode != 0:
        _die(5, "git_failed", proc.stderr.strip() or "git command failed",
             "git " + " ".join(args))
    return proc.stdout.strip()


def _require_authoring_assets() -> None:
    missing = [rel for rel in _AUTHORING_ASSETS if not (_ASSET_ROOT / rel).is_file()]
    if missing:
        _die(5, "authoring_assets_missing",
             f"manager authoring kit is incomplete: {', '.join(missing)}",
             "run `capabilities self-update`; bootstrap installs the manager and its authoring kit")


def _authoring_markdown(source_id: str) -> str:
    root = _source_workspace(source_id)
    return f"""\
# Authoring managed capabilities

This repository is the sole editable source for `{source_id}`. Its canonical
workspace is `{root}`. Never edit installed payloads under `~/.capabilities/`,
manager caches under `~/.cache/capabilities/`, or a consuming project's
`capabilities/` envelope as capability source code.

Create a capability only with:

```sh
capabilities new <name> --source {source_id}
```

The manager stamps generated contract regions from `contract/preamble.py`.
Never edit text between `# >>> contract:` and `# <<< contract:` markers.
Before every commit, stage the intended source files and derive the catalogue
from that exact index:

```sh
git add <intended-files>
capabilities source index {source_id} --staged
```

Install for a local smoke test with `capabilities install <name> --source
{source_id}`. After committing, run `capabilities source verify {source_id}
--ref HEAD`, then publish only with `capabilities source release {source_id}
--ref HEAD`. There is no conformance override: a managed capability must pass
the contract and audit. A free-form CLI remains usable directly, outside this
manager.
"""


def _repo_agent_markdown(source_id: str) -> str:
    return f"""\
# Managed capability source

Read `AUTHORING.md` before editing. Create packages with `capabilities new
<name> --source {source_id}`. Never hand-edit generated contract regions.
Stage intended files and run `capabilities source index {source_id} --staged`
before committing; verify the commit and publish through the manager's source
verbs described in `AUTHORING.md`. Source code lives only under
`capabilities/<name>/`; installed and project-envelope copies are not source.
"""


def _scaffold_source_repo(source_id: str, root: Path) -> None:
    _require_authoring_assets()
    (root / "capabilities").mkdir(parents=True, exist_ok=True)
    (root / ".capability-source").mkdir(parents=True, exist_ok=True)
    for rel in _AUTHORING_ASSETS:
        target = root / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        source_asset = _ASSET_ROOT / rel
        if source_asset.resolve() != target.resolve():
            shutil.copy2(source_asset, target)
    _write_json(root / "capabilities.repo.json", {"kind": "capability-source"})
    _write_json(root / "contract" / "contract.json",
                _contract_lock(root / "contract"))
    _write_json(root / ".capability-source" / "catalog.json", {"capabilities": {}})
    (root / "AUTHORING.md").write_text(_authoring_markdown(source_id))
    agent_text = _repo_agent_markdown(source_id)
    (root / "AGENTS.md").write_text(agent_text)
    (root / "CLAUDE.md").write_text(agent_text)
    (root / "README.md").write_text(
        f"# {source_id} capabilities\n\nSee [AUTHORING.md](AUTHORING.md).\n")
    (root / ".gitignore").write_text("**/__pycache__/\n*.pyc\n")


def cmd_source_init(source_id: str, remote: str | None) -> None:
    _validate_source_id(source_id)
    if source_id == OFFICIAL_SOURCE_ID:
        _die(6, "reserved_source", f"{OFFICIAL_SOURCE_ID!r} is reserved")
    cfg = _sources_config()
    if source_id in cfg["sources"]:
        _die(6, "source_exists", f"source {source_id!r} is already registered")
    root = _source_workspace(source_id)
    if root.exists():
        _die(6, "workspace_exists", f"canonical workspace already exists: {root}",
             "move or remove it deliberately before initializing this source")
    root.parent.mkdir(parents=True, exist_ok=True)
    try:
        root.mkdir()
        _scaffold_source_repo(source_id, root)
        _git(["init", "--initial-branch", "main"], cwd=root)
        if remote:
            _git(["remote", "add", "origin", remote], cwd=root)
    except BaseException:
        shutil.rmtree(root, ignore_errors=True)
        raise
    cfg["sources"][source_id] = {
        "kind": "workspace", "path": str(root), "ref": "main",
        **({"url": remote} if remote else {})}
    _write_json(SOURCES_FILE, cfg)
    _emit({"source": source_id, "kind": "workspace", "path": str(root),
           "remote": remote, "next": [
               f"cd {shlex.quote(str(root))}",
               f"capabilities new <name> --source {source_id}",
               f"capabilities source index {source_id} --staged",
               f"capabilities source verify {source_id} --ref HEAD"]})


def _refresh_source(source_id: str) -> dict:
    entry = _source_entry(source_id)
    root = _source_root(source_id)
    if entry.get("kind") == "workspace":
        if not (root / ".git").is_dir():
            _die(6, "bad_workspace", f"source workspace is not a git repository: {root}")
        commit = _git(["rev-parse", "HEAD"], cwd=root) if \
            _git(["rev-list", "--all", "--count"], cwd=root) != "0" else None
        dirty = bool(_git(["status", "--porcelain"], cwd=root))
        return {"source": source_id, "kind": "workspace", "path": str(root),
                "commit": commit, "dirty": dirty}
    url = entry.get("url")
    ref = entry.get("ref") or "main"
    if not isinstance(url, str) or not url:
        _die(6, "bad_source", f"source {source_id!r} has no git URL")
    SOURCE_CACHE_ROOT.mkdir(parents=True, exist_ok=True)
    if root.exists():
        if not (root / ".git").is_dir():
            shutil.rmtree(root)
        else:
            _git(["fetch", "--depth", "1", "origin", ref], cwd=root)
            _git(["reset", "--hard", "FETCH_HEAD"], cwd=root)
    if not root.exists():
        _git(["clone", "--depth", "1", "--branch", ref, url, str(root)])
    marker = _read_json(root / "capabilities.repo.json")
    catalog = _read_json(root / ".capability-source" / "catalog.json")
    if not isinstance(marker, dict) or marker.get("kind") != "capability-source":
        _die(7, "source_invalid", f"{source_id!r} is not a managed capability source",
             "missing capabilities.repo.json capability-source marker")
    if not isinstance(catalog, dict) or not isinstance(catalog.get("capabilities"), dict):
        _die(7, "source_invalid", f"{source_id!r} has no generated capability catalog",
             "the source owner must run `capabilities source index <id>` and publish it")
    return {"source": source_id, "kind": "git", "path": str(root),
            "ref": ref, "commit": _git(["rev-parse", "HEAD"], cwd=root)}


def _source_install_ref(name: str, source_id: str) -> tuple[str, dict]:
    entry = _source_entry(source_id)
    state = _refresh_source(source_id)
    root = _source_root(source_id)
    capdir = root / "capabilities" / name
    script = capdir / "bin" / name
    if not script.is_file():
        _die(3, "not_found", f"source {source_id!r} has no capability {name!r}",
             f"expected {script}")
    catalog = _read_json(root / ".capability-source" / "catalog.json") or {}
    listed = (catalog.get("capabilities") or {}).get(name)
    if not isinstance(listed, dict):
        _die(7, "catalog_missing", f"{name!r} is not present in source {source_id!r} catalog",
             f"the source owner must run `capabilities source index {source_id}` and publish it")
    expected_hash = listed.get("payload_sha256")
    actual_hash = _payload_sha256(capdir)
    if expected_hash != actual_hash:
        _die(7, "catalog_drift", f"{source_id}/{name} payload differs from its catalog",
             f"run `capabilities source index {source_id}` before installing")
    return str(capdir), {
        "source_id": source_id,
        "source_url": entry.get("url"),
        "source_ref": entry.get("ref") or "main",
        "source_commit": state.get("commit"),
        "source_dirty": state.get("dirty", False),
    }


def cmd_source_add(source_id: str, url: str, ref: str) -> None:
    _validate_source_id(source_id)
    if source_id == OFFICIAL_SOURCE_ID:
        _die(6, "reserved_source", f"{OFFICIAL_SOURCE_ID!r} is reserved")
    cfg = _sources_config()
    if source_id in cfg["sources"]:
        _die(6, "source_exists", f"source {source_id!r} is already registered")
    cfg["sources"][source_id] = {"kind": "git", "url": url, "ref": ref}
    _write_json(SOURCES_FILE, cfg)
    try:
        result = _refresh_source(source_id)
    except BaseException:
        cfg["sources"].pop(source_id, None)
        _write_json(SOURCES_FILE, cfg)
        shutil.rmtree(_source_cache(source_id), ignore_errors=True)
        raise
    _emit({"registered": source_id, **result})


def cmd_source_clone(source_id: str, url: str, ref: str) -> None:
    _validate_source_id(source_id)
    if source_id == OFFICIAL_SOURCE_ID:
        _die(6, "reserved_source", f"{OFFICIAL_SOURCE_ID!r} is reserved")
    cfg = _sources_config()
    if source_id in cfg["sources"]:
        _die(6, "source_exists", f"source {source_id!r} is already registered")
    root = _source_workspace(source_id)
    if root.exists():
        _die(6, "workspace_exists", f"canonical workspace already exists: {root}")
    root.parent.mkdir(parents=True, exist_ok=True)
    try:
        _git(["clone", "--branch", ref, url, str(root)])
        failures = _source_contract_failures(root)
        if failures:
            _die(7, "source_invalid", "; ".join(failures),
                 "the repository owner must publish a manager-created capability source")
    except BaseException:
        shutil.rmtree(root, ignore_errors=True)
        raise
    cfg["sources"][source_id] = {
        "kind": "workspace", "path": str(root), "url": url, "ref": ref}
    _write_json(SOURCES_FILE, cfg)
    _emit({"source": source_id, "kind": "workspace", "path": str(root),
           "url": url, "ref": ref,
           "next": [f"cd {shlex.quote(str(root))}",
                    f"capabilities source verify {source_id} --ref HEAD"]})


def cmd_source_list() -> None:
    binding = _official_checkout_binding(required=False)
    entries = [{"id": OFFICIAL_SOURCE_ID, "kind": "git",
                "url": OFFICIAL_GIT_URL, "ref": "main", "builtin": True,
                "cached": _source_cache(OFFICIAL_SOURCE_ID).is_dir(),
                "checkout": binding}]
    for source_id, entry in sorted((_sources_config().get("sources") or {}).items()):
        root = _source_root(source_id)
        entries.append({"id": source_id, **entry, "available": root.is_dir()})
    _emit({"sources": entries, "workspace_root": str(SOURCE_WORKSPACE_ROOT),
           "cache_root": str(SOURCE_CACHE_ROOT)})


def cmd_source_path(source_id: str) -> None:
    if source_id == OFFICIAL_SOURCE_ID and _marked_checkout(Path.cwd()) is None:
        binding = _official_checkout_binding(required=False)
        hint = (f"registered integration checkout: {binding['path']}; run its "
                "`./bin/capabilities source path official` or `capabilities dev list`"
                if binding else
                "register it with `./bin/capabilities source register-checkout official`")
        _die(6, "official_checkout_manager_required",
             "source path official is available only through its matching checkout manager",
             hint)
    _guard_source_checkout(source_id, "source path", locator=True)
    if source_id == OFFICIAL_SOURCE_ID:
        if (os.environ.get("CAPABILITIES_DEV_SOURCE_ID") == OFFICIAL_SOURCE_ID
                and _REPO_ROOT.resolve() == _marked_checkout(Path.cwd())):
            _emit({"source": source_id, "path": str(_REPO_ROOT.resolve()),
                   "dev_session": os.environ.get("CAPABILITIES_DEV_SESSION")})
            return
        binding = _official_checkout_binding(required=False)
        if binding is None:
            _die(6, "official_checkout_unregistered",
                 "the official integration checkout is not registered",
                 "run `./bin/capabilities source register-checkout official` from it")
        if binding.get("valid") is False:
            _die(6, "official_checkout_stale",
                 f"official checkout binding is stale: {binding.get('problem')}",
                 "rerun `./bin/capabilities source register-checkout official` from the primary checkout")
        if _REPO_ROOT.resolve() != Path(binding["path"]).resolve():
            _die(6, "manager_checkout_mismatch",
                 f"source path official requires the manager from {binding['path']}",
                 "run that checkout's `./bin/capabilities source path official` or `capabilities dev list`")
        _emit({"source": source_id, "path": binding["path"]})
        return
    entry = _source_entry(source_id)
    if entry.get("kind") != "workspace":
        _die(6, "not_editable", f"source {source_id!r} is a remote cache, not an editable workspace",
             f"authoring workspaces are created by `capabilities source init <id>` under {SOURCE_WORKSPACE_ROOT}")
    _emit({"source": source_id, "path": str(_source_root(source_id))})


def cmd_source_refresh(source_id: str | None) -> None:
    ids = [source_id] if source_id else [OFFICIAL_SOURCE_ID, *sorted(
        (_sources_config().get("sources") or {}).keys())]
    _emit({"refreshed": [_refresh_source(sid) for sid in ids]})


def cmd_source_remove(source_id: str) -> None:
    if source_id == OFFICIAL_SOURCE_ID:
        _die(6, "reserved_source", "the built-in official source cannot be removed")
    cfg = _sources_config()
    entry = cfg["sources"].get(source_id)
    if not isinstance(entry, dict):
        _die(3, "source_not_found", f"unknown capability source {source_id!r}")
    root = Path(entry.get("path") or _source_workspace(source_id)) if \
        entry.get("kind") == "workspace" else _source_cache(source_id)
    cfg["sources"].pop(source_id)
    _write_json(SOURCES_FILE, cfg)
    cache = _source_cache(source_id)
    if cache.is_dir() and entry.get("kind") != "workspace":
        shutil.rmtree(cache)
    result = {"removed": source_id}
    if entry.get("kind") == "workspace":
        result["workspace_kept"] = str(root)
    _emit(result)


def _catalog_payload(root: Path, audit: bool) -> tuple[dict, dict[str, list[str]]]:
    cap_root = root / "capabilities"
    entries: dict = {}
    failures: dict[str, list[str]] = {}
    if not cap_root.is_dir():
        return {"capabilities": {}}, {"repository": ["missing capabilities/ directory"]}
    for capdir in sorted(p for p in cap_root.iterdir() if p.is_dir()):
        name = capdir.name
        if name in RESERVED_CAPABILITY_NAMES:
            failures[name] = [
                f"capability name is reserved for manager-owned storage: {name}"]
            continue
        script = capdir / "bin" / name
        if not script.is_file():
            failures[name] = [f"missing canonical executable capabilities/{name}/bin/{name}"]
            continue
        manifests: list[dict] = []
        problems = _audit_script(name, script, manifests) if audit else []
        manifest = manifests[0] if manifests else None
        if not audit:
            rc, out, err = _run_script(script, ["manifest", "--json"])
            if rc == 0:
                try:
                    manifest = json.loads(out)
                except ValueError:
                    problems.append("manifest: not JSON")
            else:
                problems.append(f"manifest: exit {rc}: {err.strip()}")
            if manifest is not None:
                problems += [f"manifest: {p}" for p in _validate_manifest(name, manifest)]
            problems += [f"connections/machine-reads: {p}"
                         for p in _machine_reads_problems(script)]
        if problems:
            failures[name] = sorted(set(problems))
            continue
        entries[name] = {
            "path": f"capabilities/{name}",
            "summary": manifest.get("summary", ""),
            "payload_sha256": _payload_sha256(capdir),
        }
    return {"capabilities": entries}, failures


def _catalog_payload_scoped(
    root: Path, audit_names: set[str], current: object, *, audit: bool = True
) -> tuple[dict, dict[str, list[str]]]:
    """Rebuild all hashes while loading declarations only for changed packages.

    Unchanged summaries come from the previously verified catalogue. Their
    payload bytes are still re-hashed, so the candidate cannot conceal drift.
    Audit remains explicit: callers choose whether this is a verification or
    deterministic catalogue-generation pass.
    """
    cap_root = root / "capabilities"
    listed = current.get("capabilities") if isinstance(current, dict) else {}
    listed = listed if isinstance(listed, dict) else {}
    entries: dict = {}
    failures: dict[str, list[str]] = {}
    if not cap_root.is_dir():
        return {"capabilities": {}}, {"repository": ["missing capabilities/ directory"]}
    for capdir in sorted(p for p in cap_root.iterdir() if p.is_dir()):
        name = capdir.name
        script = capdir / "bin" / name
        if not script.is_file():
            failures[name] = [f"missing canonical executable capabilities/{name}/bin/{name}"]
            continue
        if name in audit_names:
            manifests: list[dict] = []
            problems = _audit_script(name, script, manifests) if audit else []
            manifest = manifests[0] if manifests else None
            if not audit:
                rc, out, err = _run_script(script, ["manifest", "--json"])
                if rc == 0:
                    try:
                        manifest = json.loads(out)
                    except ValueError:
                        problems.append("manifest: not JSON")
                else:
                    problems.append(f"manifest: exit {rc}: {err.strip()}")
                if manifest is not None:
                    problems += [f"manifest: {p}" for p in _validate_manifest(name, manifest)]
                problems += [f"connections/machine-reads: {p}"
                             for p in _machine_reads_problems(script)]
            if problems:
                failures[name] = sorted(set(problems))
                continue
            summary = manifest.get("summary", "")
        else:
            previous = listed.get(name)
            if not isinstance(previous, dict):
                failures[name] = ["unchanged capability has no verified catalogue entry"]
                continue
            summary = previous.get("summary", "")
        entries[name] = {
            "path": f"capabilities/{name}",
            "summary": summary,
            "payload_sha256": _payload_sha256(capdir),
        }
    return {"capabilities": entries}, failures


def _source_contract_failures(root: Path) -> list[str]:
    _require_authoring_assets()
    failures = []
    marker = _read_json(root / "capabilities.repo.json")
    if not isinstance(marker, dict) or marker.get("kind") != "capability-source":
        failures.append("capabilities.repo.json: missing capability-source marker")
    source_preamble = root / "contract" / "preamble.py"
    if not source_preamble.is_file():
        failures.append("contract: missing contract/preamble.py")
    elif source_preamble.read_bytes() != _PREAMBLE.read_bytes():
        failures.append("contract: preamble differs from the manager's canonical contract")
    lock = _read_json(root / "contract" / "contract.json")
    if not isinstance(lock, dict) or lock != _contract_lock(_PREAMBLE.parent):
        failures.append("contract: contract.json checksum is stale")
    return failures


def _core_declaration_failures(root: Path) -> list[str]:
    """Check the core set the tree's own manager declares against its catalogue.

    The declaration is read from the tree being verified, never from the
    running manager, so any manager verifies a tree against the set that tree
    declares. A tree that carries no manager, or a manager that predates the
    declaration, has nothing to check."""
    import ast as _ast
    manager = root / MANAGER_EXECUTABLE_REL
    if not manager.is_file():
        return []
    try:
        module = _ast.parse(manager.read_text())
    except (OSError, SyntaxError) as exc:
        return [f"cannot read the core declaration from {MANAGER_EXECUTABLE_REL}: {exc}"]
    values = [
        node.value for node in module.body
        if isinstance(node, _ast.Assign)
        and any(isinstance(t, _ast.Name) and t.id == "CORE_CAPABILITIES"
                for t in node.targets)
    ]
    if not values:
        return []
    try:
        declared = _ast.literal_eval(values[-1])
    except ValueError:
        declared = None
    if not isinstance(declared, (tuple, list)) or \
            not all(isinstance(n, str) for n in declared):
        return ["CORE_CAPABILITIES must be a literal tuple of capability names"]
    cap_root = root / "capabilities"
    catalogue = {
        p.name for p in cap_root.iterdir()
        if p.is_dir() and (p / "bin" / p.name).is_file()
    } if cap_root.is_dir() else set()
    return [
        f"CORE_CAPABILITIES names {name!r}, which is not in this catalogue"
        for name in sorted(set(declared) - catalogue)
    ]


def _source_snapshot_report(
    root: Path,
    git_ref: str,
    manager_selfcheck: bool = False,
    audit_names: set[str] | None = None,
    catalog_baseline: object | None = None,
    audit: bool = True,
) -> dict:
    """Evaluate one immutable Git tree without reading its working tree."""
    tree = _dev_git_value(root, "rev-parse", "--verify", f"{git_ref}^{{tree}}")
    try:
        archived = subprocess.run(
            ["git", "-C", str(root), "archive", "--format=tar", tree],
            capture_output=True, timeout=120, check=False,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        _die(6, "git_archive_failed", f"cannot archive Git tree {git_ref}", str(exc))
    if archived.returncode != 0:
        _die(
            6,
            "git_archive_failed",
            f"cannot archive Git tree {git_ref}",
            archived.stderr.decode(errors="replace").strip() or None,
        )
    with tempfile.TemporaryDirectory(prefix="capabilities-source-tree-") as tmp:
        snapshot = Path(tmp)
        with tarfile.open(fileobj=io.BytesIO(archived.stdout), mode="r:") as tar:
            members = tar.getmembers()
            for member in members:
                target = (snapshot / member.name).resolve()
                if target != snapshot and snapshot.resolve() not in target.parents:
                    _die(7, "unsafe_source_tree", f"unsafe path in Git tree: {member.name}")
            tar.extractall(snapshot, members=members, filter="data")
        current = _read_json(snapshot / ".capability-source" / "catalog.json")
        contract_failures = _source_contract_failures(snapshot)
        expected, failures = (
            _catalog_payload(snapshot, audit=audit)
            if audit_names is None
            else _catalog_payload_scoped(
                snapshot,
                audit_names,
                current if catalog_baseline is None else catalog_baseline,
                audit=audit,
            )
        )
        manager_release_expected, manager_release_problems = \
            _manager_release_payload(snapshot)
        manager_release_current = _read_json(
            snapshot / MANAGER_RELEASE_MANIFEST_REL)
        if manager_release_problems:
            failures.setdefault("manager-release", []).extend(
                manager_release_problems)
        elif manager_release_current != manager_release_expected:
            failures.setdefault("manager-release", []).append(
                "generated manager release manifest does not describe this Git tree")
        core_failures = _core_declaration_failures(snapshot)
        if core_failures:
            failures.setdefault("core", []).extend(core_failures)
        manager = snapshot / "bin" / "capabilities"
        if manager_selfcheck and manager.is_file():
            rc, _out, err = _run_script(
                manager, ["selfcheck"], cwd=snapshot, timeout=300
            )
            if rc != 0:
                failures.setdefault("manager", []).append(
                    f"selfcheck exited {rc}: {err.strip() or 'no diagnostic output'}"
                )
    if current != expected:
        failures.setdefault("catalog", []).append(
            "generated catalog does not describe this Git tree"
        )
    return {
        "tree": tree,
        "contract": contract_failures,
        "failures": failures,
        "expected": expected,
        "current": current,
        "manager_release_expected": manager_release_expected,
        "manager_release_current": manager_release_current,
        "manager_release_problems": manager_release_problems,
        "ok": not contract_failures and not failures,
    }


def _source_change_scope(changed_paths: list[str]) -> tuple[bool, set[str]]:
    manager_changed = any(
        path in ("bin/capabilities", MANAGER_RELEASE_MANIFEST_REL)
        or path in _MANAGER_RELEASE_ASSETS
        for path in changed_paths
    )
    changed_capabilities = {
        parts[1]
        for path in changed_paths
        if len(parts := Path(path).parts) >= 3 and parts[0] == "capabilities"
    }
    return manager_changed, changed_capabilities


def _source_validation_scope(root: Path, changed_paths: list[str]) -> tuple[bool, set[str]]:
    """Select direct validation targets without running any validator.

    Package-local changes stay local. A canonical contract or manager-code
    change gets the conservative fleet fallback because either can change the
    meaning of every capability contract. Manager documentation/assets do not.
    """
    manager_changed, packages = _source_change_scope(changed_paths)
    broad_change = any(path in {
        "bin/capabilities",
        "contract/preamble.py",
        "contract/contract.json",
    } for path in changed_paths)
    if broad_change:
        cap_root = root / "capabilities"
        packages = {
            path.name for path in cap_root.iterdir()
            if path.is_dir() and (path / "bin" / path.name).is_file()
        } if cap_root.is_dir() else set()
    return manager_changed, packages


def _catalog_at_ref(root: Path, git_ref: str) -> dict:
    raw = _dev_git(root, "show", f"{git_ref}:.capability-source/catalog.json")
    if raw.returncode != 0:
        return {"capabilities": {}}
    try:
        parsed = json.loads(raw.stdout)
    except ValueError:
        return {"capabilities": {}}
    return parsed if isinstance(parsed, dict) else {"capabilities": {}}


def cmd_source_index(source_id: str, staged: bool = False) -> None:
    _guard_source_checkout(source_id, "source index")
    root = _source_author_root(source_id)
    if not root.is_dir():
        _die(3, "source_unavailable", f"source {source_id!r} is not available locally",
             f"run `capabilities source refresh {source_id}`")
    if staged:
        tree = _dev_git_value(root, "write-tree")
        head = _dev_git(root, "rev-parse", "--verify", "HEAD^{commit}")
        if head.returncode == 0:
            head_commit = head.stdout.strip()
            changed_paths = _dev_git_value(
                root, "diff", "--name-only", head_commit, tree
            ).splitlines()
            baseline_raw = _dev_git(
                root,
                "show",
                f"{head_commit}:.capability-source/catalog.json",
            )
            try:
                catalog_baseline = json.loads(baseline_raw.stdout) \
                    if baseline_raw.returncode == 0 else {"capabilities": {}}
            except ValueError:
                catalog_baseline = {"capabilities": {}}
        else:
            changed_paths = _dev_git_value(
                root, "ls-tree", "-r", "--name-only", tree
            ).splitlines()
            catalog_baseline = {"capabilities": {}}
        manager_changed, changed_capabilities = _source_change_scope(changed_paths)
        report = _source_snapshot_report(
            root,
            tree,
            manager_selfcheck=False,
            audit_names=changed_capabilities,
            catalog_baseline=catalog_baseline,
            audit=False,
        )
        # A stale catalogue is the reason index exists, so it is not a blocker
        # while deriving the replacement. Contract or capability failures are.
        non_catalog_failures = {
            key: value for key, value in report["failures"].items()
            if key not in ("catalog", "manager-release")
        }
        if report["manager_release_problems"]:
            non_catalog_failures["manager-release"] = \
                report["manager_release_problems"]
        if report["contract"] or non_catalog_failures:
            _emit({
                "source": source_id,
                "basis": "staged",
                "tree": tree,
                "ok": False,
                "contract": report["contract"],
                "failures": non_catalog_failures,
            })
            sys.exit(7)
        path = root / ".capability-source" / "catalog.json"
        _write_json(path, report["expected"])
        generated = [path]
        manager_release_path = root / MANAGER_RELEASE_MANIFEST_REL
        if report["manager_release_expected"] is not None:
            _write_json(
                manager_release_path, report["manager_release_expected"])
            generated.append(manager_release_path)
        added = _dev_git(
            root, "add", "--", *(str(item.relative_to(root)) for item in generated))
        if added.returncode != 0:
            _die(
                6,
                "git_stage_failed",
                "could not stage generated capability catalog",
                added.stderr.strip() or added.stdout.strip() or None,
            )
        final_tree = _dev_git_value(root, "write-tree")
        staged_catalog = _dev_git(
            root, "show", ":.capability-source/catalog.json"
        )
        try:
            staged_value = json.loads(staged_catalog.stdout) \
                if staged_catalog.returncode == 0 else None
        except ValueError:
            staged_value = None
        if staged_value != report["expected"]:
            _emit({
                "source": source_id,
                "basis": "staged",
                "tree": final_tree,
                "ok": False,
                "contract": [],
                "failures": {
                    "catalog": ["staged catalogue differs from generated output"]
                },
            })
            sys.exit(7)
        staged_manager_release = _dev_git(
            root, "show", f":{MANAGER_RELEASE_MANIFEST_REL}")
        try:
            staged_manager_release_value = json.loads(
                staged_manager_release.stdout) \
                if staged_manager_release.returncode == 0 else None
        except ValueError:
            staged_manager_release_value = None
        if staged_manager_release_value != report["manager_release_expected"]:
            _emit({
                "source": source_id,
                "basis": "staged",
                "tree": final_tree,
                "ok": False,
                "contract": [],
                "failures": {
                    "manager-release": [
                        "staged manager release manifest differs from generated output"]
                },
            })
            sys.exit(7)
        _emit({
            "source": source_id,
            "basis": "staged",
            "tree": final_tree,
            "indexed": sorted(report["expected"]["capabilities"]),
            "catalog": str(path),
            "manager_release_manifest": (
                str(manager_release_path)
                if report["manager_release_expected"] is not None else None),
            "staged": True,
            "verification_profile": (
                "manager" if manager_changed
                else "capability" if changed_capabilities
                else "editorial"
            ),
            "ok": True,
        })
        return
    contract_failures = _source_contract_failures(root)
    catalog, failures = _catalog_payload(root, audit=False)
    if contract_failures or failures:
        _emit({"source": source_id, "ok": False,
               "contract": contract_failures, "failures": failures})
        sys.exit(7)
    path = root / ".capability-source" / "catalog.json"
    _write_json(path, catalog)
    manager_release, manager_release_problems = _manager_release_payload(root)
    if manager_release_problems:
        _emit({"source": source_id, "ok": False,
               "contract": contract_failures,
               "failures": {"manager-release": manager_release_problems}})
        sys.exit(7)
    manager_release_path = root / MANAGER_RELEASE_MANIFEST_REL
    if manager_release is not None:
        _write_json(manager_release_path, manager_release)
    _emit({"source": source_id, "indexed": sorted(catalog["capabilities"]),
           "catalog": str(path),
           "manager_release_manifest": (
               str(manager_release_path) if manager_release is not None else None),
           "ok": True})


def cmd_source_check(source_id: str) -> None:
    # Reading a source for drift writes nothing, so it does not borrow the
    # write-side checkout fuse: a cached remote source answers from any cwd.
    root = _source_local_root(source_id)
    if not root.is_dir():
        _die(3, "source_unavailable", f"source {source_id!r} is not available locally",
             f"run `capabilities source refresh {source_id}`")
    contract_failures = _source_contract_failures(root)
    expected, failures = _catalog_payload(root, audit=False)
    current = _read_json(root / ".capability-source" / "catalog.json")
    if current != expected:
        failures.setdefault("catalog", []).append(
            f"generated catalog is stale — run `capabilities source index {source_id}`")
    manager_release, manager_release_problems = _manager_release_payload(root)
    if manager_release_problems:
        failures.setdefault("manager-release", []).extend(
            manager_release_problems)
    elif _read_json(root / MANAGER_RELEASE_MANIFEST_REL) != manager_release:
        failures.setdefault("manager-release", []).append(
            "generated manager release manifest is stale — run "
            f"`capabilities source index {source_id}`")
    ok = not contract_failures and not failures
    _emit({"source": source_id, "root": str(root), "ok": ok,
           "contract": contract_failures, "failures": failures,
           "capabilities": sorted(expected["capabilities"])})
    if not ok:
        sys.exit(7)


def cmd_source_verify(source_id: str, git_ref: str, base_ref: str | None) -> None:
    _guard_source_checkout(source_id, "source verify")
    root = _source_author_root(source_id)
    if not root.is_dir():
        _die(3, "source_unavailable", f"source {source_id!r} is not available locally",
             f"run `capabilities source refresh {source_id}`")
    commit = _dev_git_value(root, "rev-parse", "--verify", f"{git_ref}^{{commit}}")
    if base_ref:
        base = _dev_git_value(root, "rev-parse", "--verify", f"{base_ref}^{{commit}}")
        changed_paths = _dev_git_value(
            root, "diff", "--name-only", base, commit
        ).splitlines()
        manager_changed, audit_names = _source_validation_scope(root, changed_paths)
        catalog_baseline = _catalog_at_ref(root, base)
    else:
        base = None
        changed_paths = _dev_git_value(
            root, "ls-tree", "-r", "--name-only", commit
        ).splitlines()
        manager_changed = True
        audit_names = None
        catalog_baseline = None
    report = _source_snapshot_report(
        root,
        commit,
        manager_selfcheck=manager_changed,
        audit_names=audit_names,
        catalog_baseline=catalog_baseline,
        audit=True,
    )
    _emit({
        "source": source_id,
        "root": str(root),
        "ref": git_ref,
        "commit": commit,
        "base": base,
        "tree": report["tree"],
        "manager_checked": manager_changed,
        "audited_capabilities": (
            sorted(report["expected"]["capabilities"])
            if audit_names is None else sorted(audit_names)
        ),
        "ok": report["ok"],
        "contract": report["contract"],
        "failures": report["failures"],
        "capabilities": sorted(report["expected"]["capabilities"]),
    })
    if not report["ok"]:
        sys.exit(7)


def _normal_git_url(value: str | None) -> str:
    raw = (value or "").strip().removesuffix(".git")
    if raw.startswith("git@") and ":" in raw:
        host, path = raw[4:].split(":", 1)
        return f"{host}/{path}".lower()
    raw = re.sub(r"^[a-z]+://", "", raw, flags=re.IGNORECASE)
    return raw.lower().rstrip("/")


def _source_id_for_repo(repo: Path) -> str | None:
    dev_source_id = os.environ.get("CAPABILITIES_DEV_SOURCE_ID")
    dev_source_path = os.environ.get("CAPABILITIES_DEV_SOURCE")
    if (dev_source_id and dev_source_path
            and Path(dev_source_path).expanduser().resolve() == repo.resolve()):
        return dev_source_id
    identity = _git_checkout_identity(repo)
    binding = _sources_config().get("official_checkout")
    if (isinstance(binding, dict)
            and identity["git_common_dir"] == str(
                Path(str(binding.get("git_common_dir") or "")).expanduser().resolve())):
        return OFFICIAL_SOURCE_ID
    remote = _dev_git(repo, "remote", "get-url", "origin")
    remote_url = remote.stdout.strip() if remote.returncode == 0 else None
    if _normal_git_url(remote_url) == _normal_git_url(OFFICIAL_GIT_URL):
        return OFFICIAL_SOURCE_ID
    for source_id, entry in sorted((_sources_config().get("sources") or {}).items()):
        if entry.get("kind") == "workspace":
            configured = Path(entry.get("path") or _source_workspace(source_id)).expanduser()
            if configured.is_dir() and _git_checkout_identity(configured)[
                    "git_common_dir"] == identity["git_common_dir"]:
                return source_id
        if _normal_git_url(entry.get("url")) == _normal_git_url(remote_url):
            return source_id
    return None


def _release_state_path(repo: Path, branch: str) -> Path:
    key = hashlib.sha256(f"{repo.resolve()}\0{branch}".encode()).hexdigest()[:20]
    return _STATE_HOME / "capabilities" / "releases" / f"{key}.json"


def _installed_matches_release(
    meta: dict, source_id: str | None, repo: Path, remote_url: str
) -> bool:
    if source_id and meta.get("source_id") == source_id:
        return True
    source = str(meta.get("source") or "")
    try:
        path = Path(source).expanduser().resolve()
        if path == repo.resolve() or repo.resolve() in path.parents:
            return True
    except (OSError, RuntimeError):
        pass
    if source_id == OFFICIAL_SOURCE_ID and not meta.get("source_id"):
        return (
            _normal_git_url(remote_url) in _normal_git_url(source)
            or source.startswith(SOURCE)
            or "raw.githubusercontent.com/ai-cluster-one/capabilities/" in source
        )
    return False


def _installed_release_identity(name: str) -> tuple[dict, dict] | None:
    """Return a process-independent identity for compare-and-swap reconciliation."""
    reg = _registry_dir(name)
    script = reg / name
    meta_file = reg / "meta.json"
    if not reg.is_dir() or not script.is_file() or not meta_file.is_file():
        return None
    meta = _read_json(meta_file)
    if not isinstance(meta, dict):
        return None
    stat_result = reg.stat()
    return meta, {
        "registry_device": stat_result.st_dev,
        "registry_inode": stat_result.st_ino,
        "meta_sha256": _sha256(meta_file),
        "payload_sha256": _payload_sha256(reg),
    }


def _activate_released_capability(
    name: str,
    repo: Path,
    source_id: str | None,
    remote_url: str,
    branch: str,
    commit: str,
) -> dict:
    capdir = repo / "capabilities" / name
    script = capdir / "bin" / name
    old = _read_json(_registry_dir(name) / "meta.json") or {}
    stage, manifest = _prepare_payload(
        name, script.read_bytes(), capdir, None, str(capdir)
    )
    payload_hash = _payload_sha256(stage)
    provenance = {
        key: old[key]
        for key in ("source_id", "source_url", "source_ref")
        if key in old
    }
    if source_id and source_id != OFFICIAL_SOURCE_ID:
        provenance.update({
            "source_id": source_id,
            "source_url": remote_url,
            "source_ref": branch,
        })
    _write_json(stage / "meta.json", {
        "name": name,
        "source": old.get("source") or str(capdir),
        "source_type": "directory",
        "sha256": _sha256(stage / name),
        "payload_sha256": payload_hash,
        "source_commit": commit,
        "source_dirty": False,
        **provenance,
    })
    _activate_payload(name, stage)
    _symlink(name, _script_path(name))
    result = {
        "name": name,
        "action": "update",
        "outcome": "applied",
        "changed": old.get("payload_sha256") != payload_hash,
        "payload_sha256": payload_hash,
        "source_commit": commit,
        "summary": manifest.get("summary"),
    }
    migrated = _migrate_tables(name, _script_path(name), manifest)
    if migrated is not None:
        result["migrate"] = migrated
    return result


def _remove_released_capability(name: str) -> dict:
    """Idempotently retire one installed payload; credentials remain local."""
    def remove() -> tuple[Path, Path, bool, bool]:
        _assert_payload_mutable(name)
        reg = _registry_dir(name)
        link = _bin_dir() / name
        removed_link = False
        for bin_dir in _link_dirs():
            if (bin_dir / name).is_symlink():
                (bin_dir / name).unlink()
                removed_link = True
        removed_registry = reg.is_dir()
        if removed_registry:
            shutil.rmtree(reg)
        return reg, link, removed_link, removed_registry
    if _MANAGER_MUTATION_DEPTH:
        reg, link, removed_link, removed_registry = remove()
    else:
        MANAGER_MUTATION_LOCK.parent.mkdir(parents=True, exist_ok=True)
        with MANAGER_MUTATION_LOCK.open("a+") as mutation:
            fcntl.flock(mutation, fcntl.LOCK_EX)
            reg, link, removed_link, removed_registry = remove()
    result = {
        "name": name,
        "action": "remove",
        "outcome": "applied",
        "removed": True,
        "registry_removed": removed_registry,
        "symlink_removed": removed_link,
    }
    cred_file = _CONFIG_HOME / name / "credentials.env"
    if cred_file.exists():
        result["credentials_kept"] = str(cred_file)
    return result


def _source_release(
    repo: Path,
    source_id: str | None,
    candidate_ref: str,
    branch: str,
    expected_base: str | None = None,
) -> dict:
    global _MANAGER_MUTATION_DEPTH
    repo = repo.resolve()
    if _dev_git_value(repo, "status", "--porcelain"):
        _die(
            6,
            "release_checkout_dirty",
            f"source integration checkout is dirty: {repo}",
            "move work into a dev worktree and restore the integration checkout first",
        )
    current_branch = _dev_git_value(repo, "branch", "--show-current")
    if current_branch != branch:
        _die(
            6,
            "release_wrong_branch",
            f"source checkout is on {current_branch!r}, expected {branch!r}",
        )
    remote = _dev_git(repo, "remote", "get-url", "origin")
    if remote.returncode != 0 or not remote.stdout.strip():
        _die(6, "release_remote_missing", f"source checkout has no origin remote: {repo}")
    remote_url = remote.stdout.strip()
    fetched = _dev_git(repo, "fetch", "origin", branch, timeout=120)
    if fetched.returncode != 0:
        _die(
            5,
            "release_fetch_failed",
            f"could not fetch origin/{branch}",
            fetched.stderr.strip() or fetched.stdout.strip() or None,
        )
    remote_commit = _dev_git_value(repo, "rev-parse", f"refs/remotes/origin/{branch}")
    local_commit = _dev_git_value(repo, "rev-parse", "HEAD")
    candidate = _dev_git_value(repo, "rev-parse", "--verify", f"{candidate_ref}^{{commit}}")
    state_path = _release_state_path(repo, branch)
    state = _read_json(state_path)
    if isinstance(state, dict):
        if state.get("target_commit") != candidate:
            _die(
                6,
                "release_in_progress",
                f"another release is incomplete for {repo}:{branch}",
                f"resume target {state.get('target_commit')} before releasing {candidate}",
            )
        base_commit = str(state.get("base_commit"))
    else:
        base_commit = expected_base or remote_commit
    if local_commit not in {base_commit, candidate}:
        _die(
            6,
            "release_local_diverged",
            f"local {branch} is neither the release base nor target",
            f"local={local_commit} base={base_commit} target={candidate}",
        )
    if remote_commit not in {base_commit, candidate}:
        _die(
            6,
            "release_remote_diverged",
            f"origin/{branch} advanced outside this release",
            f"remote={remote_commit} base={base_commit} target={candidate}",
        )
    ancestor = _dev_git(repo, "merge-base", "--is-ancestor", base_commit, candidate)
    if ancestor.returncode != 0:
        _die(
            6,
            "release_not_fast_forward",
            f"candidate {candidate} is not a descendant of {base_commit}",
        )
    changed_paths = _dev_git_value(
        repo, "diff", "--name-only", base_commit, candidate
    ).splitlines()
    manager_changed, changed_capability_names = _source_change_scope(changed_paths)
    changed_capabilities = sorted(changed_capability_names)
    for changed_name in changed_capabilities:
        _assert_payload_mutable(changed_name)
    manager_lock = None
    if manager_changed or "telegram" in changed_capabilities:
        MANAGER_MUTATION_LOCK.parent.mkdir(parents=True, exist_ok=True)
        manager_lock = MANAGER_MUTATION_LOCK.open("a+")
        MANAGER_MUTATION_LOCK.chmod(0o600)
        fcntl.flock(manager_lock, fcntl.LOCK_EX)
        leases = _active_takeover_leases()
        if manager_changed and leases:
            manager_lock.close()
            _die(6, "takeover_manager_frozen",
                 "manager-changing release is blocked by an active takeover",
                 json.dumps(leases, sort_keys=True))
        _MANAGER_MUTATION_DEPTH += 1
    report = _source_snapshot_report(
        repo,
        candidate,
        manager_selfcheck=False,
        audit_names=set(changed_capabilities),
        catalog_baseline=_catalog_at_ref(repo, base_commit),
        audit=False,
    )
    if not report["ok"]:
        _emit({
            "source": source_id or str(repo),
            "ref": candidate_ref,
            "commit": candidate,
            "ok": False,
            "contract": report["contract"],
            "failures": report["failures"],
        })
        sys.exit(7)
    if not isinstance(state, dict):
        state = {
            "schema": "capabilities.source.release.v1",
            "source": source_id,
            "repo": str(repo),
            "branch": branch,
            "base_commit": base_commit,
            "target_commit": candidate,
            "changed_paths": changed_paths,
        }
    if not isinstance(state.get("installed_actions"), list):
        candidate_capabilities = set(report["expected"]["capabilities"])
        installed = _installed()
        installed_actions = []
        for name in changed_capabilities:
            meta = installed.get(name)
            if meta is None or not _installed_matches_release(
                meta, source_id, repo, remote_url
            ):
                continue
            identity = _installed_release_identity(name)
            if identity is None:
                continue
            candidate_entry = report["expected"]["capabilities"].get(name) or {}
            installed_actions.append({
                "name": name,
                "action": "update" if name in candidate_capabilities else "remove",
                "before": identity[1],
                "desired_payload_sha256": candidate_entry.get("payload_sha256"),
            })
        state["installed_actions"] = installed_actions
        _write_json(state_path, state)
    release_branch = f"capabilities-release/{candidate[:12]}"
    release_ref = f"refs/heads/{release_branch}"
    if remote_commit != candidate:
        staged_remote = _dev_git(
            repo, "push", "origin", f"{candidate}:{release_ref}", timeout=120
        )
        if staged_remote.returncode != 0:
            state_path.unlink(missing_ok=True)
            _die(
                5,
                "release_candidate_push_failed",
                f"could not publish candidate ref {release_branch}",
                staged_remote.stderr.strip() or staged_remote.stdout.strip() or None,
            )
        pushed = _dev_git(
            repo, "push", "origin", f"{candidate}:refs/heads/{branch}", timeout=120
        )
        if pushed.returncode != 0:
            refreshed = _dev_git(repo, "fetch", "origin", branch, timeout=120)
            current_remote = remote_commit
            if refreshed.returncode == 0:
                current_remote = _dev_git_value(
                    repo, "rev-parse", f"refs/remotes/origin/{branch}"
                )
            if current_remote not in {base_commit, candidate}:
                _dev_git(repo, "push", "origin", "--delete", release_branch, timeout=120)
                state_path.unlink(missing_ok=True)
                _die(
                    6,
                    "release_remote_diverged",
                    f"origin/{branch} advanced while the candidate was verifying",
                    f"remote={current_remote} base={base_commit} target={candidate}",
                )
            _die(
                5,
                "release_pending",
                f"candidate {candidate} is published but origin/{branch} did not accept it yet",
                "wait for the required source-integrity status, then rerun the same release",
            )
    if local_commit != candidate:
        merged = _dev_git(repo, "merge", "--ff-only", candidate, timeout=120)
        if merged.returncode != 0:
            _die(
                6,
                "release_local_update_failed",
                f"origin was published but local {branch} could not fast-forward",
                merged.stderr.strip() or merged.stdout.strip() or str(state_path),
            )
    installed_updates = []
    installed_removals = []
    installed_skipped = []
    for action in state["installed_actions"]:
        if not isinstance(action, dict):
            _die(7, "release_state_invalid", "release action is not an object",
                 str(state_path))
        name = str(action.get("name") or "")
        if name not in changed_capabilities:
            _die(
                7,
                "release_state_invalid",
                f"release state names an unchanged capability: {name!r}",
                str(state_path),
            )
        kind = action.get("action")
        if kind not in {"update", "remove"} or not isinstance(
            action.get("before"), dict
        ):
            _die(
                7,
                "release_state_invalid",
                f"release state has an invalid installed action for {name!r}",
                str(state_path),
            )
        result = action.get("result") if action.get("status") == "complete" else None
        if not isinstance(result, dict):
            current = _installed_release_identity(name)
            current_meta = current[0] if current is not None else None
            current_identity = current[1] if current is not None else None
            if current_identity == action["before"]:
                if kind == "update":
                    result = _activate_released_capability(
                        name, repo, source_id, remote_url, branch, candidate
                    )
                else:
                    result = _remove_released_capability(name)
            elif kind == "remove" and not _registry_dir(name).exists():
                result = {
                    "name": name,
                    "action": "remove",
                    "outcome": "already_applied",
                    "removed": True,
                    "registry_removed": False,
                    "symlink_removed": False,
                }
            elif (
                kind == "update"
                and current_meta is not None
                and current_identity is not None
                and current_meta.get("source_commit") == candidate
                and current_identity.get("payload_sha256")
                    == action.get("desired_payload_sha256")
                and _installed_matches_release(
                    current_meta, source_id, repo, remote_url
                )
            ):
                result = {
                    "name": name,
                    "action": "update",
                    "outcome": "already_applied",
                    "changed": False,
                    "payload_sha256": action.get("desired_payload_sha256"),
                    "source_commit": candidate,
                }
            else:
                result = {
                    "name": name,
                    "action": kind,
                    "outcome": "superseded",
                    "reason": (
                        "capability_uninstalled"
                        if current is None and not _registry_dir(name).exists()
                        else "local_installation_changed"
                    ),
                }
            action["status"] = "complete"
            action["result"] = result
            _write_json(state_path, state)
        if result.get("outcome") == "superseded":
            installed_skipped.append(result)
        elif kind == "update":
            installed_updates.append(result)
        else:
            installed_removals.append(result)
    if state["installed_actions"]:
        _sync_skill()
    manager_update = None
    if manager_changed and source_id == OFFICIAL_SOURCE_ID:
        content, assets, manifest = _manager_release_from_root(
            repo, f"git:{remote_url}@{candidate}")
        manager_update = _activate_manager_release(
            content, assets,
            f"git:{remote_url}@{candidate}",
            manifest,
        )
    final_local = _dev_git_value(repo, "rev-parse", "HEAD")
    if final_local != candidate:
        _die(7, "release_incomplete", "local source checkout did not reach target")
    cleanup_ref = _dev_git(
        repo, "push", "origin", "--delete", release_branch, timeout=120
    )
    if cleanup_ref.returncode != 0 and "remote ref does not exist" not in (
        cleanup_ref.stderr + cleanup_ref.stdout
    ).lower():
        _die(
            5,
            "release_ref_cleanup_failed",
            f"release completed but candidate ref {release_branch} remains",
            cleanup_ref.stderr.strip() or cleanup_ref.stdout.strip() or str(state_path),
        )
    state_path.unlink(missing_ok=True)
    result = {
        "source": source_id or str(repo),
        "branch": branch,
        "base_commit": base_commit,
        "commit": candidate,
        "published": True,
        "checkout_synced": True,
        "verification_profile": (
            "manager" if manager_changed
            else "capability" if changed_capabilities
            else "editorial"
        ),
        "changed_capabilities": changed_capabilities,
        "installed_updates": installed_updates,
        "installed_removals": installed_removals,
        "installed_skipped": installed_skipped,
        "manager_update": manager_update,
        "ok": True,
    }
    if manager_lock is not None:
        _MANAGER_MUTATION_DEPTH -= 1
        manager_lock.close()
    return result


def cmd_source_release(source_id: str, git_ref: str) -> None:
    root = _guard_source_checkout(source_id, "source release")
    assert root is not None
    if source_id == OFFICIAL_SOURCE_ID:
        binding = _official_checkout_binding()
        if root != Path(binding["path"]).resolve():
            _die(6, "integration_checkout_required",
                 f"direct official release requires {binding['path']}",
                 "publish a dev worktree with `capabilities dev finish <session>`")
    entry = _source_entry(source_id)
    branch = str(entry.get("ref") or "main")
    _emit(_source_release(root, source_id, git_ref, branch))


def cmd_search(query: str | None, source_id: str | None) -> None:
    ids = [source_id] if source_id else [OFFICIAL_SOURCE_ID, *sorted(
        (_sources_config().get("sources") or {}).keys())]
    needle = (query or "").lower()
    matches = []
    unavailable = []
    for sid in ids:
        root = _source_author_root(sid)
        catalog = _read_json(root / ".capability-source" / "catalog.json") if root.is_dir() else None
        if not isinstance(catalog, dict) or not isinstance(catalog.get("capabilities"), dict):
            unavailable.append({"source": sid,
                                "hint": f"capabilities source refresh {sid}"})
            continue
        for name, entry in sorted(catalog["capabilities"].items()):
            summary = (entry or {}).get("summary", "")
            if needle and needle not in name.lower() and needle not in summary.lower():
                continue
            matches.append({"name": name, "source": sid, "summary": summary,
                            "installed": _registry_dir(name).is_dir()})
    _emit({"matches": matches, "unavailable_sources": unavailable})


def _capability_skeleton(name: str, core_only: bool) -> str:
    canonical = _canonical_regions()
    core_open, core_close = _fence_markers("capability core")
    store_open, store_close = _fence_markers("store")
    conn_open, conn_close = _fence_markers("connections")
    # PEP 723 parsers scan the raw manager file rather than Python tokens. Keep
    # the generated block marker out of the source text so the manager itself
    # has exactly one `script` block while every scaffold still receives one.
    script_metadata_open = "# " + "/// script"
    connections = ""
    report = """\
def _connections_report() -> dict:
    reg, _reg_file = _connections_registry()
    out: dict = {"default": None, "connections": {}}
    conns = reg["connections"]
    out["default"] = reg.get("default") or (next(iter(conns)) if len(conns) == 1 else None)
    for cid, raw in conns.items():
        entry = raw if isinstance(raw, dict) else {}
        rows = []
        for spec in CRED_KEYS:
            value, tier, source = _resolve_env_key(spec["key"])
            rows.append(_key_report(spec["key"], bool(spec.get("secret")),
                                    bool(spec.get("required")), value, tier, source))
        out["connections"][cid] = {
            "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT)),
            "keys": rows}
    return out


def _cmd_connections() -> None:
    _emit(_connections_report())
"""
    doctor = """\
def cmd_doctor(wanted: str | None) -> None:
    report = _connections_report()
    _doctor_gate(report, wanted)
    _emit({"ok": True, "connections": report["connections"],
           "note": "Replace this scaffold check with the cheapest real readiness round-trip."})
"""
    if not core_only:
        connections = (f"\n{conn_open}\n{canonical['connections']}{conn_close}\n\n" +
                       report + "\n" + doctor)
    else:
        report = """\
def _cmd_connections() -> None:
    _emit({"default": None, "connections": {}})
"""
        doctor = """\
def cmd_doctor(_wanted: str | None) -> None:
    _emit({"ok": True, "note": "Replace this scaffold check with a real readiness proof."})
"""
        connections = "\n" + report + "\n" + doctor
    return f'''#!/usr/bin/env -S uv run --script
{script_metadata_open}
# requires-python = ">=3.11"
# ///
"""{name} — managed capability scaffold.

Contract:
  {name} help
  {name} doctor [--connection ID]
  {name} connections
  {name} stub
  {name} manifest --json
  {name} guide [topic]
  {name} ids list|get|set|rm
  {name} refs
  {name} inventory [--network]

Add the smallest useful domain verb surface below the generated contract
regions. Never edit text inside those regions. Success is JSON on stdout;
errors are JSON on stderr. Exit 4 is policy refusal.
"""

import json
import os
import sys
from pathlib import Path
from typing import NoReturn

NAME = {name!r}
SUMMARY = "TODO: describe the capability's smallest useful surface."
SCOPE = "project"
CRED_KEYS = []  # Add credential declarations; never put secret values here.
WRITE_VERBS = set()
WRITE_DEFAULT = True
DOCS_BASE = ""
STATE = False
INVENTORY = None  # {{"network": "none"|"optional"|"required"}} + an _inventory(network) builder
POST_INSTALL: list[dict] = []
# What a person is asked for (SHEBANG.md): a connection entry's fields, and
# optionally SETUP_FIELDS, LINK_METHODS and SETTINGS beside them.
CONN_FIELDS: list[dict] = []

_CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
CREDENTIALS_ENV = _CONFIG_HOME / NAME / "credentials.env"
_STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state"))

{core_open}
{canonical['capability core']}{core_close}

{store_open}
{canonical['store']}{store_close}
{connections}

def main() -> None:
    _gate()
    argv = sys.argv[1:]
    _contract(argv)
    wanted = None
    cleaned = []
    i = 0
    while i < len(argv):
        if argv[i] == "--connection" and i + 1 < len(argv):
            wanted = argv[i + 1]
            i += 2
            continue
        if argv[i].startswith("--connection="):
            wanted = argv[i].split("=", 1)[1]
            i += 1
            continue
        cleaned.append(argv[i])
        i += 1
    if cleaned == ["doctor"]:
        cmd_doctor(wanted)
        return
    _die(6, "input", "unknown or incomplete command",
         f"run `{{NAME}} help`; add domain verbs to this scaffold")


if __name__ == "__main__":
    main()
'''


def cmd_new_capability(name: str, source_id: str, core_only: bool) -> None:
    if not re.fullmatch(r"[a-z][a-z0-9-]*", name):
        _die(6, "bad_name", f"invalid capability name {name!r}",
             "use lowercase letters, digits, and hyphens; start with a letter")
    _reject_reserved_capability_name(name)
    _guard_source_checkout(source_id, "new")
    entry = _source_entry(source_id)
    official_checkout = source_id == OFFICIAL_SOURCE_ID and \
        (_REPO_ROOT / "capabilities.repo.json").is_file()
    if entry.get("kind") != "workspace" and not official_checkout:
        _die(6, "not_editable", f"source {source_id!r} is not an editable workspace",
             "create one with `capabilities source init <id>`")
    root = _source_author_root(source_id)
    contract_failures = _source_contract_failures(root)
    if contract_failures:
        _die(7, "contract_drift", "; ".join(contract_failures),
             f"run `capabilities source sync {source_id}`")
    capdir = root / "capabilities" / name
    if capdir.exists():
        _die(6, "capability_exists", f"capability source already exists: {capdir}")
    script = capdir / "bin" / name
    script.parent.mkdir(parents=True)
    (capdir / "guides").mkdir()
    (capdir / CHANGELOG_NAME).write_text(f"# {name} — change log\n")
    script.write_text(_capability_skeleton(name, core_only))
    script.chmod(0o755)
    _emit({"created": name, "source": source_id, "path": str(capdir),
           "executable": str(script), "core_only": core_only,
           "next": [f"edit only outside generated contract regions in {script}",
                    f"git add {capdir}",
                    f"capabilities source index {source_id} --staged",
                    f"capabilities install {name} --source {source_id}"]})


def cmd_source_sync(source_id: str) -> None:
    _guard_source_checkout(source_id, "source sync")
    entry = _source_entry(source_id)
    official_checkout = source_id == OFFICIAL_SOURCE_ID and \
        (_REPO_ROOT / "capabilities.repo.json").is_file()
    if entry.get("kind") != "workspace" and not official_checkout:
        _die(6, "not_editable", "contract sync is only available for an editable workspace")
    root = _source_author_root(source_id)
    _require_authoring_assets()
    for rel in _AUTHORING_ASSETS:
        target = root / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        source_asset = _ASSET_ROOT / rel
        if source_asset.resolve() != target.resolve():
            shutil.copy2(source_asset, target)
    canonical = _canonical_regions()
    stamped = []
    for capdir in sorted(p for p in (root / "capabilities").iterdir() if p.is_dir()):
        script = capdir / "bin" / capdir.name
        if not script.is_file():
            continue
        source_text = script.read_text()
        updated = source_text
        regions = []
        for region, body in canonical.items():
            try:
                split = _split_region(updated, region)
            except ValueError as e:
                _die(7, "bad_fence", f"{capdir.name}: {e}")
            if split is None:
                if region in _REQUIRED_CONTRACT_REGIONS:
                    try:
                        updated = _insert_contract_region(updated, region, body)
                    except ValueError as e:
                        _die(7, "contract_missing", f"{capdir.name}: {e}")
                    regions.append(region)
                continue
            head, interior, tail = split
            if interior != body:
                updated = head + body + tail
                regions.append(region)
        if updated != source_text:
            script.write_text(updated)
            stamped.append({"capability": capdir.name, "regions": regions})
    _write_json(root / "contract" / "contract.json",
                _contract_lock(_PREAMBLE.parent))
    _emit({"source": source_id, "contract": str(root / "contract"),
           "stamped": stamped, "ok": True})

# ---------------------------------------------------------------- selfcheck

# The stable ids of the checks `audit` performs — the executable vocabulary a
# DOCTRINE.md rule names in its `Validate (audit: <id>)` tag. Each id is the
# leading token of the failures it raises, so a deliberate break can assert its
# check is live, not vacuous — the failure mode that let the core-only gap hide.
_AUDIT_CHECKS = {
    "contract-drift", "stub", "manifest", "help", "gate",
    "refs", "ids", "connections", "connections/core-only", "guide", "doctor",
    "inventory",
}


def _stamp_regions(text: str, canonical: dict[str, str]) -> str:
    """Set every present fenced region's interior to canonical — a fresh stamp."""
    for region, canon in canonical.items():
        split = _split_region(text, region)
        if split is not None:
            head, _old, tail = split
            text = head + canon + tail
    return text


def _check_id(failure: str) -> str:
    """The audit check-id a failure string belongs to (its leading token)."""
    head = failure.split(":", 1)[0].strip()
    if head.startswith("connections/core-only"):
        return "connections/core-only"
    return head.split("/", 1)[0].split()[0]


def _inject_before_main(text: str, snippet: str) -> str | None:
    """Insert `snippet` just above the `__main__` guard so it binds before main."""
    marker = '\nif __name__ == "__main__":'
    i = text.rfind(marker)
    return None if i == -1 else text[:i] + "\n\n" + snippet + "\n" + text[i:]


def _selfcheck_source_root() -> Path | None:
    """Locate a complete capability source tree in checkout and runtime layouts."""
    candidates = (_REPO_ROOT, _source_cache(OFFICIAL_SOURCE_ID))
    for root in candidates:
        if (root / "capabilities").is_dir():
            return root
    return None


def _selfcheck_negatives(canonical: dict[str, str], source_root: Path) -> list[str]:
    """Prove the high-value audit checks BITE. Stamp a real capability fresh,
    apply one targeted break, and require the expected check to fire; a check that
    stays silent on its own break is vacuous (how the core-only gap survived)."""
    findings: list[str] = []
    src = source_root / "capabilities"
    core = conn = None
    for capdir in sorted(p for p in src.iterdir() if p.is_dir()):
        script = capdir / "bin" / capdir.name
        if not script.is_file():
            continue
        if _split_region(script.read_text(), "connections") is None:
            core = core or (capdir.name, script)
        else:
            conn = conn or (capdir.name, script)
    if core is None:
        findings.append("coverage: no core-only capability — the core-only audit "
                        "branch has no living green example")
    if conn is None:
        findings.append("coverage: no connection-bearing capability — the "
                        "connections audit branch has no living green example")

    report_conn = ('def _cmd_connections() -> None:\n'
                   '    _emit({"connections": {"x": {"keys": []}}, "default": "x"})')
    report_unmasked = (
        'def _cmd_connections() -> None:\n'
        '    _emit({"default": "default", "connections": {"default": {'
        '"allow_write": True, "keys": [{"key": "SECRET", "secret": True, '
        '"required": True, "set": True, "value": "plaintext-unmasked"}]}}})')

    def break_fence(text: str):
        s = _split_region(text, "capability core")
        if s is None:
            return None
        head, interior, tail = s
        return head + interior + "# injected drift\n" + tail

    def break_doctor_gate(text: str):
        """Strip the doctor's _doctor_gate call from the capability's own code,
        leaving the vendored definition intact, so only the `doctor` check fires."""
        s = _split_region(text, "connections")
        if s is None:
            return None
        head, interior, tail = s
        broken = head.replace("_doctor_gate(", "_ungated(") + interior + \
            tail.replace("_doctor_gate(", "_ungated(")
        return None if broken == text else broken

    cases = []
    if core:
        cases.append(("connections/core-only", core,
                      lambda t: _inject_before_main(t, report_conn)))
        cases.append(("contract-drift", core, break_fence))
    if conn:
        cases.append(("connections", conn,
                      lambda t: _inject_before_main(t, report_unmasked)))
        cases.append(("doctor", conn, break_doctor_gate))

    with tempfile.TemporaryDirectory() as td:
        for expect, (name, script), mutate in cases:
            base = _stamp_regions(script.read_text(), canonical)
            broken = mutate(base)
            if not broken or broken == base:
                findings.append(f"negative/{expect}: could not build the break on {name}")
                continue
            p = Path(td) / name
            p.write_text(broken)
            p.chmod(0o755)
            if not any(_check_id(f) == expect for f in _audit_script(name, p)):
                findings.append(f"negative/{expect}: audit missed a deliberate break "
                                f"on {name} — the check is absent or vacuous")
    return findings


def _selfcheck_doctrine() -> list[str]:
    """Every standing rule names how it is enforced; every Validate(audit: id)
    names a check the audit performs; every audit check backs some rule."""
    import re
    doc = _ASSET_ROOT / "DOCTRINE.md"
    if not doc.is_file():
        return ["doctrine: DOCTRINE.md not found"]
    findings: list[str] = []
    claimed: set[str] = set()
    clause_re = re.compile(r"\*Validate \(([^)]*)\):\*")
    seg_re = re.compile(r"(audit|doctor|review)(?::\s*(.*))?$")
    for ln in doc.read_text().splitlines():
        if not ln.lstrip().startswith("*Validate"):
            continue
        m = clause_re.search(ln)
        if not m:
            findings.append("doctrine: a Validate clause carries no "
                            f"(audit:…|doctor|review:…) tag: {ln.strip()[:55]}…")
            continue
        for seg in m.group(1).split(";"):
            sm = seg_re.match(seg.strip())
            if not sm:
                findings.append(f"doctrine: malformed Validate tag {seg.strip()!r}")
                continue
            if sm.group(1) == "audit":
                ids = [v.strip() for v in (sm.group(2) or "").split(",") if v.strip()]
                if not ids:
                    findings.append("doctrine: an audit tag names no check id")
                for cid in ids:
                    claimed.add(cid)
                    if cid not in _AUDIT_CHECKS:
                        findings.append(f"doctrine: Validate(audit: {cid}) names a "
                                        "check the audit does not perform")
    for cid in sorted(_AUDIT_CHECKS - claimed):
        findings.append(f"doctrine: audit check {cid!r} backs no standing rule "
                        f"(tag one Validate(audit: {cid}))")
    return findings


def _selfcheck_doclinks() -> list[str]:
    """Every relative markdown link in the doctrine surface resolves to a file."""
    import re
    findings: list[str] = []
    link_re = re.compile(r"\[[^\]]+\]\(([^)]+)\)")
    docs = [_ASSET_ROOT / n for n in
            ("DOCTRINE.md", "SHEBANG.md", "TEMPLATE.md", "ROUTINES.md", "README.md")]
    docs += sorted((_ASSET_ROOT / "guides").glob("*.md"))
    for doc in docs:
        if not doc.is_file():
            continue
        for m in link_re.finditer(doc.read_text()):
            target = m.group(1).strip()
            if target.startswith(("http://", "https://", "mailto:", "#")):
                continue
            target = target.split("#", 1)[0]
            if target and not (doc.parent / target).resolve().exists():
                findings.append(f"doclink: {doc.name} → {target} does not resolve")
    return findings


def cmd_selfcheck() -> None:
    """Prove manager and audit-engine wholeness without auditing the fleet.

    Capability audit is a direct operation selected by dev/source verification.
    Selfcheck owns manager syntax, deliberate audit-engine probes, doctrine,
    guide assets, and documentation links only.
    """
    import ast as _ast
    findings: list[str] = []

    for f in (Path(__file__).resolve(), _PREAMBLE):
        try:
            _ast.parse(f.read_text())
        except (OSError, SyntaxError) as e:
            findings.append(f"parse: {f.name}: {e}")

    canonical = _canonical_regions()
    source_root = _selfcheck_source_root()
    if source_root is None:
        findings.append(
            "source: no complete capability source tree; run "
            "`capabilities source refresh official` and retry")
    else:
        findings += _selfcheck_negatives(canonical, source_root)
    findings += _selfcheck_doctrine()
    findings += _selfcheck_doclinks()
    manager_menu = _guide_menu(_ASSET_ROOT / "guides", "capabilities")
    manager_topics = [entry["topic"] for entry in manager_menu]
    if manager_topics != list(_MANAGER_GUIDE_TOPICS):
        findings.append(
            f"manager-guides: topics {manager_topics!r} != "
            f"{list(_MANAGER_GUIDE_TOPICS)!r}")
    for entry in manager_menu:
        if not entry["title"].strip() or not entry["preview"].strip():
            findings.append(
                f"manager-guides: {entry['topic']} needs an H1 and preview paragraph")

    _emit({"ok": not findings, "checks": sorted(_AUDIT_CHECKS), "findings": findings})
    if findings:
        sys.exit(7)

# ---------------------------------------------------------------- authoring

def _manager_guides_dir() -> Path:
    return _ASSET_ROOT / "guides"


def _manager_guide(topic: str | None) -> str | list[dict[str, str]]:
    menu = _guide_menu(_manager_guides_dir(), "capabilities")
    observed = [entry["topic"] for entry in menu]
    if observed != list(_MANAGER_GUIDE_TOPICS):
        _die(5, "manager_assets_missing",
             f"manager guide set is incomplete: found {observed!r}",
             "run `capabilities self-update` to restore manager assets")
    incomplete = [entry["topic"] for entry in menu
                  if not entry["title"].strip() or not entry["preview"].strip()]
    if incomplete:
        _die(5, "manager_assets_invalid",
             f"manager guides need an H1 and preview paragraph: {incomplete!r}",
             "run `capabilities self-update` to restore manager assets")
    if topic is None:
        return menu
    topics = {entry["topic"] for entry in menu}
    if topic not in topics:
        _die(3, "not_found", f"unknown manager guide {topic!r}",
             "run `capabilities guide` to list available guides")
    try:
        return (_manager_guides_dir() / f"{topic}.md").read_text()
    except OSError as exc:
        _die(5, "manager_assets_missing",
             f"cannot read manager guide {topic!r}: {exc}",
             "run `capabilities self-update` to restore manager assets")


# ---------------------------------------------------------------- main

def main() -> None:
    argv = sys.argv[1:]
    if not argv or argv[0] in ("help", "--help", "-h"):
        sys.stdout.write((__doc__ or "").lstrip("\n"))
        return
    cmd, rest = argv[0], argv[1:]
    if cmd in READ_ONLY_REFUSED_VERBS:
        _read_only_gate(cmd)

    def flag(name: str) -> bool:
        return name in rest

    def opt(name: str) -> str | None:
        if name in rest:
            i = rest.index(name)
            if i + 1 >= len(rest):
                _die(6, "input", f"{name} needs a value")
            return rest[i + 1]
        prefix = name + "="
        for value in rest:
            if value.startswith(prefix):
                return value.split("=", 1)[1]
        return None

    def positional() -> list[str]:
        out, skip = [], False
        for i, a in enumerate(rest):
            if skip:
                skip = False
                continue
            if a in ("--from", "--source", "--remote", "--ref", "--note", "--node"):
                skip = True
                continue
            if a.startswith("--"):
                continue
            out.append(a)
        return out

    pos = positional()

    if cmd == "dev":
        if not rest:
            _die(
                6, "input",
                "dev needs a subcommand: start, install, exec, run, check, live, doctor, list, finish, stop, or gc",
            )
        sub, dev_args = rest[0], rest[1:]

        def dev_opt(name: str, argv: list[str] | None = None) -> str | None:
            values = dev_opts(name, argv)
            return values[-1] if values else None

        def dev_opts(name: str, argv: list[str] | None = None) -> list[str]:
            args = dev_args if argv is None else argv
            values: list[str] = []
            i = 0
            while i < len(args):
                value = args[i]
                if value == name:
                    if i + 1 >= len(args):
                        _die(6, "input", f"{name} needs a value")
                    values.append(args[i + 1])
                    i += 2
                    continue
                if value.startswith(name + "="):
                    values.append(value.split("=", 1)[1])
                i += 1
            return values

        if sub == "start":
            if len(dev_args) < 1 or dev_args[0].startswith("--"):
                _die(6, "input", "dev start needs a primary capability name")
            obsolete = [flag_name for flag_name in
                        ("--consumer", "--consumer-live", "--consumer-ref", "--ref")
                        if flag_name in dev_args]
            if obsolete:
                _die(6, "obsolete_dev_option",
                     f"legacy dev start option is no longer supported: {obsolete[0]}",
                     "use --project PATH to attach the existing checkout")
            cmd_dev_start(
                dev_args[0], dev_opt("--source"), dev_opt("--project"),
                "--no-project" in dev_args, dev_opt("--session"),
                "--allow-parallel" in dev_args)
        elif sub == "install":
            values = [value for value in dev_args if not value.startswith("--")]
            if len(values) < 2:
                _die(6, "input", "dev install needs a session and capability name(s)")
            cmd_dev_install(values[0], values[1:])
        elif sub == "exec":
            if "--" not in dev_args:
                _die(6, "input", "dev exec needs -- before the child command")
            divider = dev_args.index("--")
            controls, command = dev_args[:divider], dev_args[divider + 1:]
            if not controls or controls[0].startswith("--"):
                _die(6, "input", "dev exec needs a session id")
            cmd_dev_exec(controls[0], command, dev_opt("--cwd", controls),
                         dev_opts("--inherit-env", controls))
        elif sub == "run":
            if "--" not in dev_args:
                _die(6, "input", "dev run needs -- before capability arguments")
            divider = dev_args.index("--")
            controls, child_args = dev_args[:divider], dev_args[divider + 1:]
            values = [value for value in controls if not value.startswith("--")]
            if len(values) != 2:
                _die(6, "input", "dev run needs a session and capability")
            cmd_dev_run(values[0], values[1], child_args,
                        "--project-only" in controls)
        elif sub == "check":
            if len(dev_args) != 1 or dev_args[0].startswith("--"):
                _die(6, "input", "dev check needs exactly one session id")
            cmd_dev_check(dev_args[0])
        elif sub == "live":
            if len(dev_args) < 3:
                _die(6, "input", "dev live needs an action, session, and adapter")
            action, live_session, adapter = dev_args[:3]
            if action == "start":
                cmd_dev_live_start(live_session, adapter)
            elif action == "status":
                cmd_dev_live_status(live_session, adapter)
            elif action == "stop":
                cmd_dev_live_recover(live_session, adapter, True)
            elif action == "recover":
                cmd_dev_live_recover(
                    live_session, adapter, "--restore-canonical" in dev_args[3:])
            else:
                _die(6, "input", f"unknown dev live action: {action}")
        elif sub == "doctor":
            if not dev_args:
                _die(6, "input", "dev doctor needs a session id")
            cmd_dev_doctor(dev_args[0])
        elif sub == "list":
            cmd_dev_list()
        elif sub == "stop":
            unknown = [value for value in dev_args
                       if value.startswith("--") and value != "--discard-work"]
            if unknown:
                _die(6, "input", f"unknown dev stop option: {unknown[0]}")
            stop_args = [value for value in dev_args if not value.startswith("--")]
            if not stop_args:
                _die(6, "input", "dev stop needs a session id")
            if len(stop_args) > 1:
                _die(6, "input", "dev stop takes exactly one session id")
            cmd_dev_stop(stop_args[0], "--discard-work" in dev_args)
        elif sub == "finish":
            if not dev_args:
                _die(6, "input", "dev finish needs a session id")
            cmd_dev_finish(dev_args[0])
        elif sub == "gc":
            cmd_dev_gc(dev_opt("--older-than") or "7d")
        else:
            _die(6, "input", f"unknown dev subcommand: {sub}")
    elif cmd == "install":
        if not pos:
            _die(6, "input", "install needs a capability name")
        cmd_install(pos[0], opt("--from"), opt("--source"), flag("--yes"),
                    flag("--allow"))
    elif cmd in ("allow", "quarantine"):
        if len(pos) != 1:
            _die(6, "input", f"{cmd} needs exactly one capability name")
        cmd_machine(pos[0], "allowed" if cmd == "allow" else "quarantined")
    elif cmd == "uninstall":
        if not pos:
            _die(6, "input", "uninstall needs a capability name")
        cmd_uninstall(pos[0], flag("--purge-credentials"))
    elif cmd == "update":
        if flag("--check"):
            cmd_update_check(pos[0] if pos else None)
        else:
            cmd_update(pos[0] if pos else None)
    elif cmd == "self-update":
        if flag("--check"):
            cmd_self_update_check(opt("--from"))
        else:
            cmd_self_update(opt("--from"))
    elif cmd == "list":
        cmd_list()
    elif cmd == "inventory":
        cmd_inventory(flag("--detail"), flag("--network"), pos)
    elif cmd == "store":
        sub = rest[0] if rest else None
        if sub == "set":
            cmd_store_set(rest[1:])
        elif sub == "unset":
            if rest[1:]:
                _die(6, "input", "store unset takes no arguments")
            cmd_store_unset()
        elif sub in ("show", "doctor"):
            project, extra, i = None, [], 1
            while i < len(rest):
                arg = rest[i]
                if arg == "--json":
                    i += 1
                elif arg == "--project" and i + 1 < len(rest) and project is None:
                    project, i = rest[i + 1], i + 2
                elif arg.startswith("--project=") and project is None:
                    project, i = arg.split("=", 1)[1], i + 1
                else:
                    extra.append(arg)
                    i += 1
            if extra:
                _die(6, "input", f"store {sub} takes only --project PATH and --json")
            cmd_store_doctor(project) if sub == "doctor" else cmd_store_show(project)
        else:
            _die(6, "input", "store needs a subcommand: set, show, doctor or unset",
                 "run `capabilities help`")
    elif cmd == "path":
        if pos:
            _die(6, "input", f"unknown path argument {pos[0]!r}",
                 "run `capabilities help` for the path verb")
        cmd_path(flag("--json"), flag("--identity"))
    elif cmd == "search":
        cmd_search(pos[0] if pos else None, opt("--source"))
    elif cmd == "changelog":
        selectors = [s for s in ("--manager", "--contract") if flag(s)]
        if len(pos) + len(selectors) != 1:
            _die(6, "input",
                 "changelog needs exactly one of <name>, --manager, or --contract")
        if selectors and opt("--source"):
            _die(6, "input",
                 "--source selects a capability source; the manager and the "
                 "contract are read from the manager's own source or --from")
        if opt("--from") and opt("--source"):
            _die(6, "input", "changelog accepts either --from or --source, not both")
        kind = selectors[0][2:] if selectors else "capability"
        cmd_changelog(pos[0] if pos else None, kind, flag("--all"),
                      opt("--from"), opt("--source"))
    elif cmd == "source":
        if not pos:
            _die(6, "input", "source needs a subcommand")
        sub = pos[0]
        if sub == "init":
            if len(pos) < 2:
                _die(6, "input", "source init needs an id")
            cmd_source_init(pos[1], opt("--remote"))
        elif sub == "add":
            if len(pos) < 3:
                _die(6, "input", "source add needs an id and git URL")
            cmd_source_add(pos[1], pos[2], opt("--ref") or "main")
        elif sub == "clone":
            if len(pos) < 3:
                _die(6, "input", "source clone needs an id and git URL")
            cmd_source_clone(pos[1], pos[2], opt("--ref") or "main")
        elif sub == "register-checkout":
            if len(pos) < 2:
                _die(6, "input", "source register-checkout needs an id")
            cmd_source_register_checkout(pos[1])
        elif sub == "list":
            cmd_source_list()
        elif sub == "path":
            if len(pos) < 2:
                _die(6, "input", "source path needs an id")
            cmd_source_path(pos[1])
        elif sub == "refresh":
            cmd_source_refresh(pos[1] if len(pos) > 1 else None)
        elif sub == "sync":
            if len(pos) < 2:
                _die(6, "input", "source sync needs an id")
            cmd_source_sync(pos[1])
        elif sub == "check":
            if len(pos) < 2:
                _die(6, "input", "source check needs an id")
            cmd_source_check(pos[1])
        elif sub == "verify":
            if len(pos) < 2:
                _die(6, "input", "source verify needs an id")
            git_ref = opt("--ref")
            if not git_ref:
                _die(6, "input", "source verify needs --ref REF")
            cmd_source_verify(pos[1], git_ref, opt("--base"))
        elif sub == "release":
            if len(pos) < 2:
                _die(6, "input", "source release needs an id")
            git_ref = opt("--ref")
            if not git_ref:
                _die(6, "input", "source release needs --ref REF")
            cmd_source_release(pos[1], git_ref)
        elif sub == "index":
            if len(pos) < 2:
                _die(6, "input", "source index needs an id")
            cmd_source_index(pos[1], staged=flag("--staged"))
        elif sub == "remove":
            if len(pos) < 2:
                _die(6, "input", "source remove needs an id")
            cmd_source_remove(pos[1])
        else:
            _die(6, "input", f"unknown source subcommand: {sub}")
    elif cmd == "enable":
        if not pos:
            _die(6, "input", "enable needs a capability name")
        scope = _gate_scope(flag("--project"), flag("--global"))
        _set_gate(pos[0], True, scope, node=opt("--node"))
    elif cmd == "disable":
        if not pos:
            _die(6, "input", "disable needs a capability name")
        scope = _gate_scope(flag("--project"), flag("--global"))
        _set_gate(pos[0], False, scope, deny=flag("--deny"), node=opt("--node"))
    elif cmd == "inherit":
        if not pos:
            _die(6, "input", "inherit needs a capability name")
        scope = _gate_scope(flag("--project"), flag("--global"))
        _inherit_gate(pos[0], scope, node=opt("--node"))
    elif cmd == "init":
        cmd_init(flag("--claude"), flag("--codex"))
    elif cmd == "agent":
        cmd_agent(rest)
    elif cmd == "node":
        cmd_node(rest)
    elif cmd == "relabel":
        if len(pos) != 1:
            _die(6, "input", "relabel needs exactly one new slug")
        cmd_relabel(pos[0])
    elif cmd == "skill":
        cmd_skill()
    elif cmd == "context":
        modes = [name for name in ("--claude", "--codex", "--fragment") if flag(name)]
        if len(modes) > 1:
            _die(6, "input", "context accepts exactly one of --claude, --codex, or --fragment")
        if flag("--fragment"):
            cmd_context("fragment")
        elif flag("--claude"):
            cmd_context("claude")
        elif flag("--codex"):
            cmd_context("codex")
        else:
            _die(6, "input", "context needs --claude, --codex, or --fragment")
    elif cmd == "build":
        if pos:
            _die(6, "input", f"unknown build argument {pos[0]!r}",
                 "run `capabilities help` for the build verb")
        cmd_build(flag("--print"), flag("--json"))
    elif cmd == "ids":
        if not pos:
            _die(6, "input", "ids needs a capability name")
        cmd_ids(pos[0])
    elif cmd == "migrate":
        cmd_migrate(rest)
    elif cmd == "connections":
        if rest != ["import"]:
            _die(6, "input", "connections needs the subcommand import, and nothing else",
                 "run `capabilities help`")
        cmd_connections_import()
    elif cmd == "get":
        if len(pos) != 3:
            _die(6, "input", "get needs <name> <collection> <key>")
        cmd_get(pos[0], pos[1], pos[2])
    elif cmd == "set":
        if len(pos) != 4:
            _die(6, "input", "set needs <name> <collection> <key> <json-or-string>")
        cmd_set(pos[0], pos[1], pos[2], pos[3], opt("--note"))
    elif cmd == "doctor":
        cmd_doctor()
    elif cmd == "audit":
        if not pos:
            _die(6, "input", "audit needs a capability name")
        cmd_audit(pos[0], opt("--from"))
    elif cmd == "sync-contract":
        cmd_sync_contract(check_only=flag("--check"))
    elif cmd == "selfcheck":
        cmd_selfcheck()
    elif cmd == "new":
        if not pos:
            _die(6, "input", "new needs a capability name",
                 "run `capabilities guide authoring` for the authoring workflow")
        source_id = opt("--source")
        if not source_id:
            _die(6, "input", "new <name> needs --source ID",
                 "create a canonical workspace with `capabilities source init <id>`")
        cmd_new_capability(pos[0], source_id, flag("--core-only"))
    elif cmd == "guide":
        _emit(_manager_guide(pos[0] if pos else None))
    else:
        _die(6, "input", f"unknown command: {cmd}", "run `capabilities help`")


if __name__ == "__main__":
    main()
