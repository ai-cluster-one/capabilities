DEFAULT_CONTEXT_PROMPT = (
    "Identifiers are durable, non-secret project lookups discovered while using "
    "a capability: ids, codes, labels, classifications, account handles, "
    "folders, variable paths, and similar structural handles. When a task needs "
    "one, check `capabilities ids <name>` or `<name> ids list` before "
    "rediscovering it. When you discover a reusable value that future sessions "
    "should not rediscover, persist it with `<name> ids set <label> <value> "
    "--note \"<what it is>\"`, then refresh this generated context through its "
    "project context owner: `contextkit build` in a ContextKit-bound project, "
    "otherwise `capabilities context --claude` or `capabilities context "
    "--codex`. Do not "
