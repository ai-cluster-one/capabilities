def _httpx():
    """Load the network client only for verbs that actually use the network.

    Local manager verbs remain runnable through an explicit Python interpreter,
    which is how the hermetic tests invoke them without activating the script's
    uv dependency environment.
    """
    import httpx
    return httpx
