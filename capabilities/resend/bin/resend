#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "httpx>=0.27",
#     "capabilities-contract>=0.12,<1",
# ]
# ///
"""resend — send-only email CLI over the Resend HTTP API (resend.com).

USAGE
  resend <command> [options]

One-way by construction: the surface can deliver mail from a verified sending
domain and inspect that domain's status — it has no read, receive, or mailbox
surface at all. Identity-free: it sends as whatever sender RESEND_API_KEY and
the selected connection authorize.

CONNECTIONS
  Configuration requires an explicit connections registry, even for one
  connection. Each entry names its key's env var ("secret_env"); the value
  resolves through the credential cascade (`Where a secret resolves`, at the
  end of this help). The secret has no flag — only its env-var NAME resolves
  it, never the command line. The write gate is off by default, so a project that sends
  declares a connection granting it as
  connections, kept where "Where connections live" below says:
    {
      "default": "sender",
      "connections": {
        "sender": { "secret_env": "RESEND_API_KEY",
                    "from": "Agent <agent@example.com>",
                    "allow_write": true,
                    "allow_to": ["owner@example.com", "*@example.com"] }
      }
    }
  Which registry is read, and in what order, depends on the project: see
  "Where connections live" below.

  Per-connection keys:
    secret_env    env var holding the API key (resolved through the cascade)
    from          default From for `send` (overridden by --from)
    allow_write   the write gate — `send` leaves the system, so it is off
                  unless the connection grants it; a refused send exits 4
    allow_to      optional recipient allow-list: exact addresses or
                  `*@domain` globs, matched case-insensitively against every
                  recipient (to + cc + bcc). Present ⇒ a non-matching
                  recipient is refused (exit 4). Absent ⇒ any recipient once
                  allow_write grants sending. Committed policy — nothing in
                  the cascade lifts it.

  Selection: --connection <id> (accepted anywhere on the command line).
  Unflagged, the registry's "default" pointer applies, else the sole entry;
  several entries without a pointer is refused as ambiguous.

  Outside any project, connections and doctor are machine reads: they use the
  machine's own connections read-only, unless a grant switched one off; every
  other verb that needs a connection is refused there.

COMMANDS
  connections
      Where every connection's values resolve from (tier, source, secrets
      masked). Local only — no network.

  doctor [--connection <id>]
      Validate key + API reachability (GET /domains) — every connection, or
      one. A refused read from a valid sending-only key (401
      restricted_api_key, historically 403) counts as healthy-restricted.
      Exit 0 all healthy / 2 missing-or-rejected key / 5 unreachable.

  send --to ADDR [--to ADDR ...] --subject SUBJ (--text BODY | --html BODY)
       [--cc ADDR ...] [--bcc ADDR ...] [--from FROM] [--reply-to ADDR]
       [--idempotency-key KEY]
      Deliver one email via POST /emails and print {"id", "from", "to"}.
      --text/--html accept a literal body or `-` to read it from stdin (one
      of the two may be `-`, not both). --from falls back to the
      connection's `from`; without either the send is refused (exit 6).
      --idempotency-key makes retries of the same logical send safe —
      Resend deduplicates on it for 24h.

  domains
      List the account's sending domains and their verification status
      (GET /domains). Read-only inspection; a sending-only key is refused
      this read (exit 2 restricted_api_key) — use doctor, which reads the
      refusal as healthy-restricted.

Contract commands (the same on every capability):
  resend stub                                 One-line awareness text.
  resend manifest --json                      Machine-readable declaration.
  resend guide [<topic>]                      Guide topics / one guide body,
                                               fetched live from the docs base.
  resend ids list|get <l>|set <l> <v>|rm <l>  The project identifiers envelope
              [--note <text>]                  (capabilities/resend/identifiers.json,
                                                or store rows once the agent moved).
  resend refs                                 Menu of the project's reference
                                               files for this capability.
  resend inventory [--network]                What this capability holds in
                                              this project (--network adds
                                              remote detail).

EXIT CODES
  0 success · 2 auth/credentials · 3 not found · 4 policy refusal — the
  project gate (capabilities/settings.json) on any verb, a send on a
  connection without allow_write, or a recipient outside allow_to; ask the
  user, never lift a gate yourself · 5 server/network · 6 input
"""

from __future__ import annotations

import argparse
import fnmatch
import json
import os
import sys
import time
from pathlib import Path
from typing import NoReturn

import httpx

RESEND_API = "https://api.resend.com"
TIMEOUT = httpx.Timeout(30.0)
MAX_RETRIES = 3

# --- Capability declaration — one home for every contract fact ---------------

NAME = "resend"
SUMMARY = ("Send-only email CLI over the Resend HTTP API — deliver mail from "
           "a verified sending domain (send, write-gated with an optional "
           "recipient allow-list), list sending domains and their "
           "verification status (domains), and prove key + reachability "
           "(doctor). One-way by construction: no read or receive surface.")
SCOPE = "project"   # credential scope: "project" | "user"
CRED_KEYS = [
    {"key": "RESEND_API_KEY", "secret": True, "required": True,
     "note": "API key from resend.com; a domain-restricted sending-only key is preferred"},
]

# What a person is asked for (SHEBANG.md, "What a person is asked for"):
# a connection entry's own fields, which `connection add` writes.
CONN_FIELDS = [{'key': 'secret_env',
  'label': 'API key',
  'help': 'A Resend API key.',
  'type': 'string',
  'secret': True,
  'required': True,
  'env': 'RESEND_{ID}_API_KEY'},
 {'key': 'from',
  'label': 'From',
  'help': 'The default From address for send.',
  'type': 'string',
  'required': False},
 {'key': 'allow_to',
  'label': 'Allowed recipients',
  'help': 'Addresses or *@domain patterns send is limited to.',
  'type': 'list',
  'required': False}]
WRITE_VERBS: set = {"send"}   # a send leaves the system
WRITE_DEFAULT = False   # off unless a connection grants allow_write
MACHINE_READS = ("connections", "doctor")   # outside any project, read-only on the machine's connections
DOCS_BASE = ""      # upstream guides base URL; "" while no guides ship
STATE = False       # True when the capability writes session/cache state
INVENTORY = None     # or {"network": "none"|"optional"|"required"} with an _inventory(network) builder
POST_INSTALL: list = []
_STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state"))

_CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
CREDENTIALS_ENV = _CONFIG_HOME / "resend" / "credentials.env"
KEY_NAME = "RESEND_API_KEY"


# The shared capability code is the capabilities-contract library's, bound here
# into this script's namespace (SHEBANG.md, "The contract verbs").
from capabilities_contract.capability import bind as _contract_bind

_contract_bind(globals(), "core")

_contract_bind(globals(), "store")


_contract_bind(globals(), "connections")


# ── credentials ─────────────────────────────────────────────────────────────

def _connections_report() -> dict:
    """The resolution report — every connection, every value, its winning tier
    and source, secrets masked. Local only: no network, no login attempt."""
    reg, _ = _connections_registry()
    report: dict = {"default": None, "connections": {}}
    if reg is None:
        value, tier, source = _resolve_env_key(KEY_NAME)
        report["default"] = "default"
        report["connections"]["default"] = {
            "allow_write": WRITE_DEFAULT,
            "keys": [_key_report(KEY_NAME, True, True, value, tier, source)]}
        return report
    conns = reg["connections"]
    report["default"] = reg.get("default") or \
        (next(iter(conns)) if len(conns) == 1 else None)
    for cid, entry in conns.items():
        entry = entry if isinstance(entry, dict) else {}
        secret_env = entry.get("secret_env")
        if secret_env:
            value, tier, source = _resolve_env_key(secret_env)
            keys = [_key_report(secret_env, True, True, value, tier, source)]
        else:
            keys = [_key_report("secret_env", False, True, None, None, None)]
        report["connections"][cid] = {
            "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT)),
            "keys": keys}
    return report


def _cmd_connections() -> None:
    _emit(_connections_report())


def _resolve_key(entry: dict | None, cid: str) -> str:
    """The selected connection's key: an entry resolves its named secret_env;
    the implicit default the flat key. The secret never travels on argv."""
    if entry is None:
        key = _resolve_env_key(KEY_NAME)[0]
        if not key:
            _die(2, "missing_credentials",
                 f"{KEY_NAME} is required",
                 f"set it in a project .env(.local), {CREDENTIALS_ENV}, "
                 f"or the environment")
        return key
    secret_env = entry.get("secret_env")
    if not secret_env:
        _die(6, "no_secret_env", f"connection {cid!r} is missing 'secret_env'")
    key = _resolve_env_key(secret_env)[0]
    if not key:
        _die(2, "missing_credentials",
             f"env var {secret_env} (for connection {cid!r}) is unset",
             f"set {secret_env} in the project's .env / .env.local, "
             f"{CREDENTIALS_ENV}, or the environment")
    return key


# ── HTTP with 429/5xx backoff ───────────────────────────────────────────────

def _client(key: str) -> httpx.Client:
    return httpx.Client(base_url=RESEND_API, timeout=TIMEOUT,
                        headers={"Authorization": f"Bearer {key}"})


def _request(client: httpx.Client, method: str, path: str,
             body: dict | None = None, extra_headers: dict | None = None):
    last_status: int | None = None
    for attempt in range(1, MAX_RETRIES + 1):
        try:
            resp = client.request(method, path, json=body, headers=extra_headers)
        except httpx.TimeoutException:
            if attempt < MAX_RETRIES:
                time.sleep(attempt * 1.5)
                continue
            _die(5, "timeout", f"request timed out: {method} {path}",
                 "Resend was unresponsive")
        except httpx.RequestError as e:
            _die(5, "network_error", f"network error: {e}",
                 "check connectivity to api.resend.com")

        last_status = resp.status_code
        if resp.status_code == 429:
            retry_after = float(resp.headers.get("Retry-After", str(attempt * 1.5)))
            if attempt < MAX_RETRIES:
                time.sleep(retry_after)
                continue
            _die(5, "rate_limited", "rate-limited by Resend", status=429)
        if resp.status_code >= 500:
            if attempt < MAX_RETRIES:
                time.sleep(attempt * 1.5)
                continue
            _die(5, "server_error", f"Resend returned {resp.status_code}",
                 (resp.text or "")[:300], status=resp.status_code)

        if resp.status_code >= 400:
            msg = (resp.text or "").strip()[:400] or "unknown error"
            try:
                j = resp.json()
                if isinstance(j, dict) and j.get("message"):
                    msg = j["message"]
            except ValueError:
                pass
            if resp.status_code in (401, 403):
                _die(2, "unauthorized", msg,
                     "RESEND_API_KEY invalid or lacks scope", status=resp.status_code)
            if resp.status_code == 404:
                _die(3, "not_found", msg, status=resp.status_code)
            _die(6, "invalid_request", msg, status=resp.status_code)

        try:
            return resp.json()
        except ValueError:
            return {}

    _die(5, "exhausted_retries",
         f"exhausted {MAX_RETRIES} attempts on {method} {path}", status=last_status)


# ── doctor ──────────────────────────────────────────────────────────────────

def _check_connection(key: str) -> dict:
    """One probe: GET /domains. 200 proves key + reachability and shows the
    sending domains; a valid but sending-only key is refused this read —
    observed as 401 name=restricted_api_key ("This API key is restricted to
    only send emails"), historically 403 — and both count healthy: the key
    can do everything this CLI is for."""
    try:
        with _client(key) as c:
            resp = c.get("/domains")
    except httpx.TimeoutException:
        return {"ok": False, "category": 5, "error": "request timed out"}
    except httpx.RequestError as e:
        return {"ok": False, "category": 5, "error": f"network error: {e}"}
    if resp.status_code == 200:
        try:
            data = resp.json().get("data") or []
        except ValueError:
            data = []
        return {"ok": True, "domains": [
            {"name": d.get("name"), "status": d.get("status")} for d in data]}
    try:
        body = resp.json() or {}
    except ValueError:
        body = {}
    msg = body.get("message")
    restricted = (body.get("name") == "restricted_api_key"
                  or "restricted" in (msg or "").lower())
    if resp.status_code == 403 or (resp.status_code == 401 and restricted):
        return {"ok": True, "restricted": True,
                "note": "key is valid but sending-only; domain list not visible"}
    if resp.status_code in (400, 401):
        # Resend answers 400 validation_error (not 401) to a malformed key here
        return {"ok": False, "category": 2,
                "error": msg or "Resend rejected the key",
                "status": resp.status_code}
    return {"ok": False, "category": 5,
            "error": msg or f"Resend returned {resp.status_code}",
            "status": resp.status_code}


def cmd_doctor(reg: dict | None, wanted: str | None) -> None:
    """Every connection bare; one with --connection. Exit 0 only when every
    examined connection is healthy, else the first failure's category."""
    _doctor_gate(_connections_report(), wanted)
    if wanted is not None or reg is None:
        targets = [_select_connection(reg, wanted)]
    else:
        targets = list(reg["connections"].items())
    connections: dict = {}
    fail_exit = 0
    for cid, entry in targets:
        secret_env = KEY_NAME if entry is None else entry.get("secret_env")
        if not secret_env:
            res = {"ok": False, "category": 6,
                   "error": f"connection {cid!r} is missing 'secret_env'"}
        else:
            key = _resolve_env_key(secret_env)[0]
            if not key:
                res = {"ok": False, "category": 2,
                       "error": f"{secret_env} not found in a project .env, "
                                f"{CREDENTIALS_ENV}, or the environment"}
            else:
                res = _check_connection(key)
        if not res.get("ok") and not fail_exit:
            fail_exit = res.get("category") or 5
        res.pop("category", None)
        connections[cid] = res
    _emit({"ok": fail_exit == 0, "connections": connections})
    if fail_exit:
        sys.exit(fail_exit)


# ── send ────────────────────────────────────────────────────────────────────

def _addr_only(value: str) -> str:
    """The bare address from `Name <addr>` or a bare addr, lowercased."""
    v = value.strip()
    if "<" in v and v.endswith(">"):
        v = v[v.rindex("<") + 1:-1]
    return v.strip().lower()


def _enforce_allow_to(entry: dict | None, recipients: list[str]) -> None:
    """Committed recipient policy: when the connection carries `allow_to`,
    every recipient (to + cc + bcc) must match an exact address or a
    `*@domain` glob, case-insensitively. Nothing in the cascade lifts it."""
    if entry is None:
        return
    allow = entry.get("allow_to")
    if allow is None:
        return
    if not isinstance(allow, list) or not all(isinstance(a, str) for a in allow):
        _die(6, "bad_config", "`allow_to` must be a list of address patterns")
    patterns = [a.strip().lower() for a in allow]
    for rcpt in recipients:
        addr = _addr_only(rcpt)
        if not any(fnmatch.fnmatchcase(addr, pat) for pat in patterns):
            _die(4, "recipient_not_allowed",
                 f"recipient {addr!r} is outside this connection's allow_to policy",
                 "Do not widen the policy yourself — ask the user; the "
                 "allow-list lives on the connection in connections.json.")


def _body_arg(value: str | None, other: str | None, flag: str) -> str | None:
    """A body flag's value; `-` reads stdin (only one of --text/--html may)."""
    if value is None:
        return None
    if value == "-":
        if other == "-":
            _die(6, "input", "only one of --text/--html may read stdin")
        data = sys.stdin.read()
        if not data.strip():
            _die(6, "input", f"{flag} - was given but stdin is empty")
        return data
    return value


def cmd_send(client: httpx.Client, args, entry: dict | None) -> dict:
    sender = args.from_ or (entry or {}).get("from")
    if not sender:
        _die(6, "no_sender",
             "no From address: pass --from or set `from` on the connection")
    text = _body_arg(args.text, args.html, "--text")
    html = _body_arg(args.html, args.text, "--html")
    if not text and not html:
        _die(6, "no_body", "one of --text or --html is required")
    payload: dict = {"from": sender, "to": args.to, "subject": args.subject}
    if text:
        payload["text"] = text
    if html:
        payload["html"] = html
    if args.cc:
        payload["cc"] = args.cc
    if args.bcc:
        payload["bcc"] = args.bcc
    if args.reply_to:
        payload["reply_to"] = args.reply_to
    headers = {"Idempotency-Key": args.idempotency_key} if args.idempotency_key else None
    resp = _request(client, "POST", "/emails", body=payload, extra_headers=headers)
    return {"id": (resp or {}).get("id"), "from": sender, "to": args.to}


# ── domains ─────────────────────────────────────────────────────────────────

def cmd_domains(client: httpx.Client) -> list:
    resp = _request(client, "GET", "/domains")
    return [{"name": d.get("name"), "status": d.get("status"),
             "region": d.get("region"), "created_at": d.get("created_at")}
            for d in (resp or {}).get("data") or []]


# ── main ────────────────────────────────────────────────────────────────────

def main() -> None:
    _gate()                      # every verb passes the project gate first
    _contract(sys.argv[1:])      # contract verbs; domain verbs fall through
    p = argparse.ArgumentParser(prog="resend", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("help")
    sub.add_parser("doctor")
    sub.add_parser("domains")

    sp = sub.add_parser("send")
    sp.add_argument("--to", action="append", required=True)
    sp.add_argument("--subject", required=True)
    sp.add_argument("--text", default=None, help="plain-text body, or - for stdin")
    sp.add_argument("--html", default=None, help="HTML body, or - for stdin")
    sp.add_argument("--cc", action="append", default=None)
    sp.add_argument("--bcc", action="append", default=None)
    sp.add_argument("--from", dest="from_", default=None,
                    help="From address; defaults to the connection's `from`")
    sp.add_argument("--reply-to", dest="reply_to", default=None)
    sp.add_argument("--idempotency-key", dest="idempotency_key", default=None)

    # `--connection <id>` is a global selector accepted anywhere on the line
    # (extracted before argparse so it works after the subcommand too).
    argv = sys.argv[1:]
    wanted_conn: str | None = None
    cleaned: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--connection" and i + 1 < len(argv):
            wanted_conn = argv[i + 1]; i += 2; continue
        if a.startswith("--connection="):
            wanted_conn = a.split("=", 1)[1]; i += 1; continue
        cleaned.append(a); i += 1

    args = p.parse_args(cleaned)
    if args.cmd == "help":
        sys.stdout.write((__doc__ or "").lstrip("\n"))
        return

    reg, _ = _connections_registry()
    if args.cmd == "doctor":
        cmd_doctor(reg, wanted_conn)
        return

    cid, entry = _select_connection(reg, wanted_conn)
    allow_write = WRITE_DEFAULT if entry is None else \
        bool(entry.get("allow_write", WRITE_DEFAULT))
    _write_gate(cid, allow_write, args.cmd)
    if args.cmd == "send":
        _enforce_allow_to(entry, list(args.to) + list(args.cc or []) + list(args.bcc or []))
    key = _resolve_key(entry, cid)
    try:
        with _client(key) as c:
            if args.cmd == "send":
                _emit(cmd_send(c, args, entry))
            elif args.cmd == "domains":
                _emit(cmd_domains(c))
            else:
                _die(6, "unknown_command", f"no handler for {args.cmd!r}")
    finally:
        del key


if __name__ == "__main__":
    main()
