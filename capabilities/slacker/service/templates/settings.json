{
  "connection": null,
  "environment": "production",
  "assistant_name": "Assistant",
  "direct_messages": {
    "mode": "allowlist",
    "default_role": "direct_user"
  },
  "allowed_users": {},
  "allowed_channels": {},
  "authority": {
    "roles": {
      "supervisor": {
        "allowed_capabilities": {
          "*": true
        }
      },
      "direct_user": {
        "allowed_capabilities": {}
      },
      "channel_member": {
        "allowed_capabilities": {}
      }
    }
  },
  "defaults": {
    "tail_size": 40,
    "debounce": 3,
    "max_age": 600,
    "worker_timeout": 120,
    "max_parallel_dialogue": 1,
    "profile": "slacker-claude",
    "max_parallel_jobs": 1,
    "job_profile": "slacker-job-claude",
    "job_recovery": "requeue",
    "voice_transcription": "addressed"
  }
}
