# --- Refusals that a caller may fold, and progress logging -------------------

class _Refusal(Exception):
    """A handled failure raised rather than exited, so a caller answering for
    several connections can fold one connection's refusal into its report
    instead of ending at the first. `main` turns an uncaught one into the error
    envelope and its exit code."""

    def __init__(self, exit_code: int, code: str, message: str,
                 hint: str | None = None):
        super().__init__(message)
        self.exit_code = exit_code
        self.code = code
        self.message = message
        self.hint = hint

    def as_result(self) -> dict:
        out = {"ok": False, "category": self.exit_code, "error": self.message}
        if self.hint:
            out["hint"] = self.hint
        return out


def _refuse(exit_code: int, code: str, message: str,
            hint: str | None = None, status: int | None = None) -> NoReturn:
    if status is not None:
        message = f"{message} (status {status})"
    raise _Refusal(exit_code, code, message, hint)


def _log(message: str) -> None:
    """Progress / diagnostics to stderr, keeping stdout clean for the result."""
    sys.stderr.write(message + "\n")
    sys.stderr.flush()


# --- Connections (capability-specific) ---------------------------------------

def _unquote(value: str | None) -> str | None:
    """A pasted secret without the quote marks a browser console prints around
    a string. The realtime gateway refuses a quoted value that REST accepts."""
    if value is None:
        return None
    value = str(value).strip()
    while len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        value = value[1:-1].strip()
    return value


def _resolve_cookie(raw: str | None) -> str | None:
    """The `d` cookie value, however the person pasted it: a bare value, or a
    `d=...` pair, or a whole Cookie header carrying `d=`, each possibly quoted.
    Returns the value alone; the client re-wraps it as a `d=` cookie."""
    raw = _unquote(raw)
    if not raw:
        return None
    for part in raw.split(";"):
        part = part.strip()
        if part.startswith("d="):
            return _unquote(part[2:])
    return raw


def _build_cfg(cid: str, entry: dict | None) -> tuple[dict | None, dict | None]:
    """Materialize one connection into the config the commands consume. Returns
    (cfg, problem) — problem is an error dict instead of a die, so doctor can
    report every connection rather than stopping at the first."""
    named = (entry or {}).get("label") or cid  # the word a person reads; the id keys it
    entry = entry if isinstance(entry, dict) else {}
    token_env = entry.get("token_env") or "SLACKER_TOKEN"
    cookie_env = entry.get("cookie_env") or "SLACKER_COOKIE"
    token = _unquote(_resolve_env_key(token_env)[0])
    cookie = _resolve_cookie(_resolve_env_key(cookie_env)[0])
    if not token:
        return None, {
            "exit": 2, "code": "missing_secret",
            "message": f"env var {token_env} (for connection {named!r}) is unset",
            "hint": f"set {token_env} in the project .env/.env.local, "
                    f"{CREDENTIALS_ENV}, or the environment — the xoxc- token "
                    f"from the signed-in browser's localConfig_v2"}
    if not cookie:
        return None, {
            "exit": 2, "code": "missing_secret",
            "message": f"env var {cookie_env} (for connection {named!r}) is unset",
            "hint": f"set {cookie_env} to the `d` cookie value from the "
                    f"signed-in browser"}
    if not str(token).startswith("xoxc-"):
        return None, {
            "exit": 6, "code": "not_a_session_token",
            "message": f"connection {named!r}: {token_env} is not an xoxc- "
                       f"web-session token",
            "hint": "this capability reads as the web client; a bot (xoxb-) or "
                    "user (xoxp-) OAuth token is a different route"}
    account = _digits_or_text(entry.get("team_id"))
    return {
        "id": cid,
        "token": str(token),
        "cookie": cookie,
        "team_id": entry.get("team_id") or None,
        "account_binding": account,
        "workspace": entry.get("workspace") or None,
        "expect_user": entry.get("expect_user") or None,
        "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT)),
    }, None


def _digits_or_text(value) -> str | None:
    value = (str(value).strip() if value is not None else "")
    return value or None


def get_config(args=None) -> dict:
    """Resolve the active connection into the config dict every command consumes."""
    reg, _ = _connections_registry()
    cid, entry = _select_connection(reg, getattr(args, "connection", None))
    cfg, problem = _build_cfg(cid, entry)
    if problem:
        _refuse(problem["exit"], problem["code"], problem["message"],
                problem.get("hint"))
    return cfg


def _connections_report() -> dict:
    """The resolution report — every connection, every value, its winning tier
    and source, secrets masked. Local only: no network, no session opened."""
    reg, _ = _connections_registry()
    report: dict = {"default": None, "connections": {}}
    conns = reg["connections"]
    report["default"] = reg.get("default") or \
        (next(iter(conns)) if len(conns) == 1 else None)
    for cid, entry in conns.items():
        entry = entry if isinstance(entry, dict) else {}
        origin = reg["sources"][cid]
        keys = []
        for field, template in (("token_env", "SLACKER_TOKEN"),
                                ("cookie_env", "SLACKER_COOKIE")):
            name = entry.get(field) or template
            value, tier, source = _resolve_env_key(name)
            keys.append(_key_report(name, True, True, value, tier, source))
        for field in ("team_id", "workspace", "expect_user"):
            value = entry.get(field)
            keys.append(_key_report(field, False, False,
                                    str(value) if value is not None else None,
                                    "connection" if value is not None else None,
                                    origin if value is not None else None))
        report["connections"][cid] = {
            "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT)),
            "keys": keys}
    return report


def _cmd_connections() -> None:
    _emit(_connections_report())


# --- Browser linking (Chrome DevTools) ---------------------------------------
#
# `link` reads the person's own workspace session out of a Chrome they signed
# in to, so nobody copies a token or a cookie. The tool opens the installed
# Chrome with a throwaway profile and Chrome's remote-debugging channel, opens
# the Slack app, and waits — typing and clicking nothing — while the person
# signs in normally. It then reads the workspace xoxc- token from the page's
# own localStorage (`localConfig_v2`) and the shared `d` cookie over the
# DevTools protocol, closes the window and deletes the profile. The protocol is
# spoken over the websocket library slacker already ships; no browser is
# bundled and no dependency is added. The person's everyday Chrome profile is
# never read: the window runs on a fresh profile they sign in to just for this.

SLACK_APP_URL = "https://app.slack.com/"
# How long `link` waits for the person to finish signing in before it gives up.
LINK_TIMEOUT = 300
# Where an installed Chrome is looked for; SLACKER_CHROME overrides.
_CHROME_NAMES = ("google-chrome", "google-chrome-stable", "google-chrome-beta",
                 "chromium", "chromium-browser", "chrome")
_CHROME_MAC = (
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "/Applications/Chromium.app/Contents/MacOS/Chromium")


class _BrowserGone(Exception):
    """The debugging endpoint stopped answering — the window was closed."""


def _find_chrome() -> str | None:
    """The installed Chrome to drive, or None. An explicit SLACKER_CHROME wins;
    otherwise the first known binary on PATH, then the macOS app bundle."""
    import shutil
    override = _unquote(os.environ.get("SLACKER_CHROME"))
    if override:
        return override if (Path(override).is_file() or shutil.which(override)) else None
    for name in _CHROME_NAMES:
        found = shutil.which(name)
        if found:
            return found
    for path in _CHROME_MAC:
        if Path(path).is_file():
            return path
    return None


def _cdp_http(port: int, path: str) -> Any:
    """Read one of Chrome's DevTools HTTP endpoints (/json/...). A refused
    connection means the window is gone."""
    import urllib.error
    import urllib.request
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}{path}", timeout=5) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except (urllib.error.URLError, OSError, ValueError) as exc:
        raise _BrowserGone(str(exc))


class _Cdp:
    """One DevTools websocket, talking to a page target. Each command is a JSON
    object with a rising id; the reply carrying that id (and only it) is
    returned, so events arriving on the connection are skipped."""

    def __init__(self, ws_url: str):
        import websocket
        # Chrome refuses a DevTools socket whose Origin it was not told to
        # allow; a socket with no Origin is a local client and is accepted.
        try:
            self._ws = websocket.create_connection(
                ws_url, timeout=10, max_size=64 * 1024 * 1024,
                suppress_origin=True)
        except websocket.WebSocketBadStatusException as exc:
            _refuse(5, "devtools_refused",
                    f"Chrome refused the DevTools connection "
                    f"(HTTP {getattr(exc, 'status_code', '?')})",
                    "link by paste (`slacker connection add <id> --stdin`)")
        self._id = 0

    def call(self, method: str, **params) -> dict:
        self._id += 1
        mid = self._id
        self._ws.send(json.dumps({"id": mid, "method": method, "params": params}))
        while True:
            try:
                msg = json.loads(self._ws.recv())
            except Exception as exc:
                raise _BrowserGone(str(exc))
            if msg.get("id") == mid:
                if "error" in msg:
                    _refuse(5, "cdp_error",
                            f"Chrome DevTools refused {method}: "
                            f"{(msg['error'] or {}).get('message')}")
                return msg.get("result") or {}

    def close(self) -> None:
        with contextlib.suppress(Exception):
            self._ws.close()


def _slack_page(port: int) -> dict | None:
    """A Slack page target to talk to, or None while none has loaded yet."""
    for target in _cdp_http(port, "/json/list"):
        if target.get("type") == "page" \
                and "slack.com" in (target.get("url") or "") \
                and target.get("webSocketDebuggerUrl"):
            return target
    return None


def _read_teams(cdp: "_Cdp") -> list[dict]:
    """Every workspace signed in on the page, read from its own localStorage
    `localConfig_v2`. Each is {id, name, domain, token}, token an xoxc-."""
    result = cdp.call("Runtime.evaluate",
                      expression="window.localStorage.getItem('localConfig_v2')",
                      returnByValue=True)
    raw = (result.get("result") or {}).get("value")
    if not raw:
        return []
    try:
        teams = json.loads(raw).get("teams") or {}
    except (ValueError, AttributeError):
        return []
    out = []
    for tid, team in (teams.items() if isinstance(teams, dict) else []):
        team = team or {}
        token = _unquote(team.get("token"))
        if not token or not str(token).startswith("xoxc-"):
            continue
        out.append({"id": team.get("id") or tid,
                    "name": team.get("name") or team.get("domain") or tid,
                    "domain": team.get("domain"),
                    "token": str(token)})
    return out


def _read_d_cookie(cdp: "_Cdp") -> str | None:
    """The shared `d` cookie, read over the protocol — it is httpOnly, so the
    page's own script cannot see it."""
    cdp.call("Network.enable")
    for cookie in cdp.call("Network.getAllCookies").get("cookies") or []:
        if cookie.get("name") == "d" \
                and (cookie.get("domain") or "").endswith("slack.com"):
            return cookie.get("value")
    return None


def _launch_chrome(chrome: str, profile: Path, url: str) -> tuple:
    """Start Chrome on a throwaway profile with its remote-debugging channel on
    a free port, and return (process, port). The port Chrome chose is read from
    the profile's DevToolsActivePort file."""
    import subprocess
    args = [chrome, f"--user-data-dir={profile}", "--remote-debugging-port=0",
            "--no-first-run", "--no-default-browser-check", "--no-service-autorun",
            "--disable-features=Translate", "--use-mock-keychain",
            "--new-window", url]
    proc = subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    port_file = profile / "DevToolsActivePort"
    deadline = time.monotonic() + 30
    while time.monotonic() < deadline:
        if proc.poll() is not None:
            _refuse(5, "chrome_exited",
                    "Chrome exited before its debugging port was ready",
                    "run `slacker link` again, or link by paste")
        if port_file.is_file():
            try:
                return proc, int(port_file.read_text().splitlines()[0].strip())
            except (ValueError, IndexError):
                pass
        time.sleep(0.25)
    _refuse(5, "chrome_no_port",
            "Chrome did not open its debugging port within 30s",
            "run `slacker link` again, or link by paste")


def _end_chrome(proc, profile: Path) -> None:
    """Close the window and delete the throwaway profile, whatever happened."""
    import shutil
    import subprocess
    if proc is not None and proc.poll() is None:
        proc.terminate()
        try:
            proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            proc.kill()
            with contextlib.suppress(Exception):
                proc.wait(timeout=5)
    shutil.rmtree(profile, ignore_errors=True)


def _await_session(port: int, timeout: int) -> tuple:
    """Wait while the person signs in, then read the workspaces and the `d`
    cookie out. Returns (teams, cookie). The window closing or the time running
    out is a refusal that leaves nothing behind."""
    deadline = time.monotonic() + timeout
    announced = False
    while time.monotonic() < deadline:
        try:
            target = _slack_page(port)
            if target is not None:
                cdp = _Cdp(target["webSocketDebuggerUrl"])
                try:
                    teams = _read_teams(cdp)
                    if teams:
                        cookie = _read_d_cookie(cdp)
                        if cookie:
                            return teams, cookie
                finally:
                    cdp.close()
        except _BrowserGone:
            _refuse(5, "window_closed",
                    "the Chrome window was closed before sign-in finished",
                    "run `slacker link` again, or link by paste "
                    "(`slacker connection add <id> --stdin`)")
        if not announced:
            _event("progress", stage="waiting_for_signin", url=SLACK_APP_URL)
            announced = True
        time.sleep(1.5)
    _refuse(6, "link_timeout",
            f"no signed-in Slack workspace appeared within {timeout}s; "
            f"at the end {_sign_in_seen(port)}",
            "sign in during the window `slacker link` opens, or link by paste "
            "(`slacker connection add <id> --stdin`)")


def _url_host(url: str) -> str:
    from urllib.parse import urlsplit
    return urlsplit(url or "").hostname or "?"


def _sign_in_seen(port: int) -> str:
    """What the window held when the wait for sign-in ended, told by host and
    count only: the Slack pages open, how many signed-in workspaces the page
    `link` reads held in its `localConfig_v2`, and the domains of the `d`
    cookies. A page's path, a token and a cookie value are never told — a
    sign-in link carries its secret in its path."""
    try:
        pages = [t for t in _cdp_http(port, "/json/list")
                 if t.get("type") == "page" and "slack.com" in (t.get("url") or "")]
        if not pages:
            return "no Slack page was open"
        said = ["Slack pages open: "
                + ", ".join(_url_host(t.get("url")) for t in pages)]
        target = _slack_page(port)
        if target is None:
            return said[0] + "; none could be read"
        cdp = _Cdp(target["webSocketDebuggerUrl"])
        try:
            teams = _read_teams(cdp)
            cdp.call("Network.enable")
            domains = [c.get("domain") or "?"
                       for c in cdp.call("Network.getAllCookies").get("cookies") or []
                       if c.get("name") == "d"
                       and (c.get("domain") or "").endswith("slack.com")]
        finally:
            cdp.close()
        said.append(f"the page read ({_url_host(target.get('url'))}) held "
                    + (f"{len(teams)} signed-in workspace(s)" if teams
                       else "no signed-in workspace")
                    + " in localConfig_v2")
        said.append("`d` cookies on " + ", ".join(domains) if domains
                    else "no `d` cookie on slack.com")
        return "; ".join(said)
    except (_BrowserGone, _Refusal):
        return "the window could not be read"


def _match_team(teams: list[dict], wanted: str) -> dict | None:
    """The one workspace whose id, domain or name matches `wanted`, or None."""
    low = wanted.lower()
    for team in teams:
        if low in (str(team["id"]).lower(), (team.get("domain") or "").lower(),
                   (team.get("name") or "").lower()):
            return team
    return None


def _link_connection_id(given: str | None, team: dict) -> str:
    """The connection id a link writes to: the one asked for, else one made
    from the workspace's own domain or name."""
    if given:
        return given
    base = team.get("domain") or team.get("name") or team["id"]
    cid = re.sub(r"[^a-z0-9._@+-]", "-", str(base).lower()).strip("-")
    return (cid or "slack")[:128]


def _persist_link(cid: str, scope: str, token: str, cookie: str, team: dict,
                  default: bool, replace: bool) -> dict:
    """Write the linked session through the connection surface: the two secrets
    into the scope's credentials file under this connection's own env keys,
    the non-secret workspace identity into the registry. Mirrors the write
    `connection add` makes, so link and paste leave the same shape."""
    declared = {f["key"]: f for f in (globals().get("CONN_FIELDS") or [])}
    adapter = _records()
    try:
        # `cid` is the connection's id or its label; a new one is added under
        # it as its label and given an id.
        held_id = adapter.connection_id(NAME, cid)
        held = adapter.resolve_scope(NAME, "connection", scope).get(held_id or cid)
    except StoreError as e:
        _die(5 if e.slug in STORE_ENVIRONMENT_SLUGS else 6, e.slug, e.message, e.hint)
    # The keys are filled from the label, never from an id.
    named = _connection_label(held_id) if held is not None and held_id else cid
    token_env = _connection_env_name(declared["token_env"], named)
    cookie_env = _connection_env_name(declared["cookie_env"], named)
    if held is not None and not replace:
        _die(6, "connection_exists",
             f"a {scope} connection {cid!r} already exists; link writes over it "
             "only when asked to",
             "pass --replace to re-link it, or give a different id")
    entry = dict((held or {}).get("value") or {})
    entry.update({"token_env": token_env, "cookie_env": cookie_env,
                  "team_id": team["id"]})
    if team.get("domain") or team.get("name"):
        entry["workspace"] = team.get("domain") or team.get("name")
    credentials = _scope_credentials(scope)
    _env_file_write(credentials, {token_env: token, cookie_env: cookie})
    try:
        written = adapter.set(NAME, "connection", held_id if held is not None and held_id
                              else cid, entry, scope=scope) or held_id or cid
        if default:
            adapter.set(NAME, "setting", "connection.default", written, scope=scope)
        source = adapter.scope_source(NAME, "connection", scope)
    except StoreError as e:
        _die(5 if e.slug in STORE_ENVIRONMENT_SLUGS else 6, e.slug, e.message, e.hint)
    return {"connection": written, "registry": source, "credentials": str(credentials),
            "token_env": token_env, "cookie_env": cookie_env}


def cmd_link(args) -> dict | None:
    """Open Chrome, wait while the person signs in, read the session out, and
    write it as a connection — proving it with the same check `doctor` runs.
    No secret value ever reaches stdout, the log or the registry."""
    if getattr(args, "events", False):
        _events_begin()
    wanted_scope = getattr(args, "scope", None)   # project | global | machine | None
    root = _project_root()
    has_envelope = root is not None and _project_capabilities_dir(root).is_dir()
    if wanted_scope == "project":
        if not has_envelope:
            _die(6, "no_envelope",
                 "--project needs a capabilities/ envelope in this project",
                 "run `capabilities init` first, or link with --global")
        scope = "project"
    elif wanted_scope in ("global", "machine"):
        scope = "global"
    else:
        scope = "project" if has_envelope else "global"
    _read_only_gate("`slacker link`")

    chrome = _find_chrome()
    if chrome is None:
        _refuse(6, "no_chrome",
                "no Google Chrome is installed to sign in through",
                "install Google Chrome, or link by paste: read the xoxc- token "
                "and the `d` cookie from a signed-in browser and run "
                "`slacker connection add <id> --stdin` (`slacker guide linking`)")

    import tempfile
    timeout = getattr(args, "timeout", None) or LINK_TIMEOUT
    profile = Path(tempfile.mkdtemp(prefix="slacker-link-"))
    proc = None
    _event("progress", stage="launching_chrome")
    _log(f"Opening Chrome to {SLACK_APP_URL} — sign in to your workspace; "
         "slacker reads the session and closes the window.")
    try:
        proc, port = _launch_chrome(chrome, profile, SLACK_APP_URL)
        teams, cookie = _await_session(port, timeout)
    finally:
        _end_chrome(proc, profile)

    wanted_conn = getattr(args, "connection", None)
    given_id = getattr(args, "id", None) or wanted_conn
    selector = getattr(args, "workspace", None) or given_id
    if len(teams) == 1:
        team = teams[0]
    else:
        team = _match_team(teams, selector) if selector else None
        if team is None:
            listed = [{"team_id": t["id"], "name": t["name"], "domain": t.get("domain")}
                      for t in teams]
            if _EVENTS_ON[0]:
                answer = _event_answer("workspace_needed", workspaces=listed).strip()
                team = _match_team(teams, answer)
                if team is None:
                    _refuse(6, "unknown_workspace",
                            f"no signed-in workspace matches {answer!r}",
                            "answer workspace_needed with a team id, domain or "
                            "name from the list")
            else:
                names = ", ".join(f"{t['name']} ({t.get('domain') or t['id']})"
                                  for t in teams)
                _refuse(6, "several_workspaces",
                        f"{len(teams)} workspaces are signed in: {names}",
                        "say which with `--workspace <team-id|domain|name>` (or "
                        "`-c <id>` matching one), or sign in to just one")

    cid = _link_connection_id(given_id, team)
    if not re.fullmatch(r"[a-z0-9][a-z0-9._@+-]{0,127}", cid, re.IGNORECASE):
        _refuse(6, "bad_connection_id",
                f"connection id {cid!r} is not a valid id",
                "pass one with a leading letter or digit: letters, digits and "
                ". _ @ + -")

    cfg = {"id": cid, "token": team["token"], "cookie": cookie,
           "team_id": team["id"], "account_binding": _digits_or_text(team["id"]),
           "workspace": team.get("domain") or team.get("name"),
           "expect_user": None, "allow_write": False}
    _event("progress", stage="verifying")
    proof = _check_connection(cfg)
    if not proof.get("ok"):
        _refuse(proof.get("category") or 2, "link_unverified",
                "the session read from Chrome did not authorise: "
                f"{proof.get('error')}",
                proof.get("hint") or "finish signing in before the window is "
                "read, then run `slacker link` again")

    default = getattr(args, "default", False)
    written = _persist_link(cid, scope, team["token"], cookie, team, default,
                            getattr(args, "replace", False))
    cid = written.get("connection") or cid
    _event("linked", connection=cid, workspace=cfg["workspace"],
           user=proof.get("user"))
    return {"ok": True, "action": "link", "connection": cid, "scope": scope,
            "registry": written["registry"], "credentials": written["credentials"],
            "default": default, "verified": True,
            "workspace": {"team_id": team["id"], "name": team["name"],
                          "domain": team.get("domain")},
            "user": proof.get("user"), "user_id": proof.get("user_id"),
            "team": proof.get("team"), "url": proof.get("url"),
            "secrets": {"token_env": written["token_env"],
                        "cookie_env": written["cookie_env"]},
            "next": f"`slacker doctor --connection {cid}` re-proves it"}


# --- Slack values ------------------------------------------------------------

_CONV_KINDS = ("im", "mpim", "private_channel", "public_channel")
_SYNC_TYPES = ("history", "live", "backfill")


def _ts_float(ts) -> float | None:
    """A Slack message ts ("1728999999.000100") as float seconds, or None."""
    try:
        return float(ts)
    except (TypeError, ValueError):
        return None


def _conv_kind(conv: dict) -> str:
    """The closed conversation kind a Slack conversation object resolves to."""
    if conv.get("is_im"):
        return "im"
    if conv.get("is_mpim"):
        return "mpim"
    if conv.get("is_private"):
        return "private_channel"
    return "public_channel"


def _conv_name(conv: dict) -> str | None:
    """A conversation's display name: its channel name, else the DM partner's
    user id prefixed, else None (resolved to a real name on read)."""
    if conv.get("name"):
        return conv["name"]
    if conv.get("is_im") and conv.get("user"):
        return f"@{conv['user']}"
    return None


def _normalize_channel_id(value: str) -> str:
    """A channel id is taken as given (C…/G…/D… or an mpmdm id). Empty is
    refused rather than silently matching the first conversation."""
    value = (value or "").strip()
    if not value:
        _refuse(6, "bad_channel", "a channel id is required",
                "pass a conversation id from `slacker conversations`")
    return value


# --- Store -------------------------------------------------------------------

STORE_VERSION = "1"
STORE_SCHEMA_MAJOR = 1
STORE_SCHEMA_MINOR = 2

# A store setting that cannot be used is a configuration fault (exit 6); a store
# that cannot be reached or refuses the migration is the environment's (exit 5).
_STORE_CONFIG_SLUGS = frozenset({
    "store_not_configured", "store_not_postgres", "store_setting_unreadable",
    "bad_store_setting", "sslmode_too_weak", "bad_schema_name"})

# Times the capability reasons about come back as the text or seconds the
# readers expect; a message's ts_at is the timestamptz of its Slack ts.
_EPOCH_COLUMNS = frozenset({"ts_at", "last_ts_at", "oldest_at", "newest_at"})
_TS_PARAM = "to_timestamp(%s::double precision)"

# Each step is applied once, in order, under the store's migration ledger. An
# applied step is never edited: a change to the tables is a new step. The tables
# are keyed by the workspace account (team id), not by project: the capture is
# the person's own Slack data, one history per account in a database, whichever
# project on the machine reads it — the whatsapp capability keeps its capture the
# same way and for the same reason. A per-table decision recorded here, per the
# Store Schema source's "Unsettled" clause, because project scoping would split
# one account's history across every project that read it.
STORE_STEPS = [
    Step("0001-meta", """
CREATE TABLE slacker_meta (
  account text NOT NULL CHECK (account <> ''),
  key text NOT NULL, value text,
  PRIMARY KEY (account, key))"""),
    Step("0002-conversations", """
CREATE TABLE slacker_conversations (
  account text NOT NULL CHECK (account <> ''),
  id text NOT NULL,
  kind text CHECK (kind IN ('im','mpim','private_channel','public_channel')),
  name text, user_id text,
  is_member boolean DEFAULT false, is_archived boolean DEFAULT false,
  last_ts text, last_ts_at timestamptz,
  synced_oldest text, synced_newest text, synced_at timestamptz,
  updated_at timestamptz,
  PRIMARY KEY (account, id))"""),
    Step("0003-messages", """
CREATE TABLE slacker_messages (
  account text NOT NULL CHECK (account <> ''),
  channel_id text NOT NULL, ts text NOT NULL, ts_at timestamptz,
  thread_ts text, user_id text, type text, subtype text, text text,
  edited_at timestamptz, deleted boolean DEFAULT false,
  reply_count integer DEFAULT 0,
  reactions jsonb NOT NULL DEFAULT '{}'::jsonb,
  raw jsonb,
  sync_type text CHECK (sync_type IN ('history','live','backfill')),
  captured_at timestamptz,
  PRIMARY KEY (account, channel_id, ts))"""),
    Step("0004-messages-by-time", """
CREATE INDEX slacker_messages_by_time
  ON slacker_messages (account, channel_id, ts_at)"""),
    Step("0005-messages-by-thread", """
CREATE INDEX slacker_messages_by_thread
  ON slacker_messages (account, channel_id, thread_ts)
  WHERE thread_ts IS NOT NULL"""),
    Step("0006-users", """
CREATE TABLE slacker_users (
  account text NOT NULL CHECK (account <> ''),
  id text NOT NULL, name text, real_name text, display_name text,
  is_bot boolean DEFAULT false, deleted boolean DEFAULT false,
  updated_at timestamptz,
  PRIMARY KEY (account, id))"""),
    Step("0007-comments", """
COMMENT ON TABLE slacker_meta IS
  'Per-account key/value: schema version, the linked user, workspace name.';
COMMENT ON TABLE slacker_conversations IS
  'Conversations the linked account can see, with the per-conversation incremental-sync cursor (synced_oldest/synced_newest).';
COMMENT ON COLUMN slacker_conversations.synced_newest IS
  'The newest ts the store covers for this conversation; the next incremental sync asks only for what is newer.';
COMMENT ON TABLE slacker_messages IS
  'Captured messages keyed by the Slack ts within a channel; a deletion is a soft flag and reactions are a {name: [user_id]} jsonb the table does not interpret.';
COMMENT ON COLUMN slacker_messages.ts IS
  'The Slack message timestamp string, unique within a channel: the natural message id and the dedup key.';
COMMENT ON COLUMN slacker_messages.raw IS
  'The whole Slack message object as received, opaque to the table, kept so a parser fix can rebuild the typed columns.';
COMMENT ON TABLE slacker_users IS
  'Users seen in the capture, resolved from users.info on demand.'"""),
    Step("0008-conversations-open-gap", """
ALTER TABLE slacker_conversations
  ADD COLUMN gap_newest text, ADD COLUMN gap_latest text;
COMMENT ON COLUMN slacker_conversations.gap_newest IS
  'While a sync from the cursor is unfinished: the newest ts it fetched, where the cursor moves once the gap below is closed.';
COMMENT ON COLUMN slacker_conversations.gap_latest IS
  'While a sync from the cursor is unfinished: the oldest ts it reached; everything from here to gap_newest is stored, and the next sync resumes below it.'"""),
    # 1.2: the assistant service. Additive, so a release of 1.1 reads a store
    # at 1.2 unchanged. What the service posted is marked on the message row,
    # which the capture's upsert never sets, so a post never wakes a turn and
    # reads as the assistant's in a later prompt; an audio clip's transcript
    # sits beside its message for every later reader.
    Step("0009-messages-service", """
ALTER TABLE slacker_messages
  ADD COLUMN sent_by_service boolean NOT NULL DEFAULT false,
  ADD COLUMN transcript text, ADD COLUMN transcript_error text;
COMMENT ON COLUMN slacker_messages.sent_by_service IS
  'True for a message the assistant service posted as the linked user; never set by the capture, so the mark survives the event that echoes the post.';
COMMENT ON COLUMN slacker_messages.transcript IS
  'The words of the message''s audio clips, from Slack''s own transcript or the service''s transcription.';
COMMENT ON COLUMN slacker_messages.transcript_error IS
  'Why the message''s audio could not be transcribed; it is not tried again.'"""),
    # What the assistant answered, per agent, environment, account and
    # conversation: the first message it admitted there, the watermark, the ts
    # it processed within a day of it, and its counters. A lookup row keyed by
    # what it joins, not an entity.
    Step("0010-register", """
CREATE TABLE slacker_register (
  agent_id text NOT NULL CHECK (agent_id <> ''),
  environment text NOT NULL CHECK (environment <> ''),
  account text NOT NULL CHECK (account <> ''),
  channel_id text NOT NULL CHECK (channel_id <> ''),
  first_ts timestamptz, watermark timestamptz,
  processed jsonb NOT NULL DEFAULT '{}'::jsonb,
  counters jsonb NOT NULL DEFAULT '{}'::jsonb,
  created_at timestamptz, updated_at timestamptz,
  PRIMARY KEY (agent_id, environment, account, channel_id));
COMMENT ON TABLE slacker_register IS
  'Per agent, environment, account and conversation: what the assistant service admitted, so a message is answered once and nothing before its first sight of a conversation is.';
COMMENT ON COLUMN slacker_register.processed IS
  'The ts of each message admitted within a day of the watermark, mapped to its epoch; older ones are settled by the watermark.';
COMMENT ON COLUMN slacker_register.counters IS
  'Turn outcomes counted for status; read by nothing that decides.'"""),
    # The work a dialogue turn hands over, as whatsapp keeps it: what was
    # asked, by whom, from which message, which thread its answer goes to, how
    # it ran (the engine's session is the checkpoint), who owns the current
    # attempt and until when, why it stopped, and its result until it is
    # delivered. `host` is the machine whose listener holds the attempt, since
    # a pid means something only there; an attempt is not pinned to a node, so
    # no node is named.
    Step("0011-jobs", """
CREATE TABLE slacker_jobs (
  agent_id text NOT NULL CHECK (agent_id <> ''),
  id text NOT NULL, environment text NOT NULL,
  account text NOT NULL, chat_id text NOT NULL, thread_ts text,
  requested_by text NOT NULL, origin_message_id text, description text NOT NULL,
  profile text, engine text, model text, session_id text,
  host text, pid integer, pgid integer,
  state text NOT NULL, outcome text,
  attempt integer NOT NULL DEFAULT 0, amendments integer NOT NULL DEFAULT 0,
  stop_requested boolean NOT NULL DEFAULT false,
  exit_code integer, error text,
  attempt_token text, lease_owner text, lease_expires_at timestamptz,
  resume_at timestamptz,
  result_text text, result_silent boolean NOT NULL DEFAULT false,
  delivery_state text, delivery_attempts integer NOT NULL DEFAULT 0,
  delivery_error text, delivered_at timestamptz, delivered_message_id text,
  created_at timestamptz NOT NULL, started_at timestamptz,
  finished_at timestamptz, execution_finished_at timestamptz,
  updated_at timestamptz NOT NULL,
  CONSTRAINT slacker_jobs_pkey PRIMARY KEY (id),
  CONSTRAINT slacker_jobs_state_check
    CHECK (state IN ('draft', 'waiting', 'running', 'stopped')),
  CONSTRAINT slacker_jobs_outcome_check
    CHECK (outcome IN ('succeeded', 'failed', 'cancelled', 'interrupted',
                       'quota', 'model_refused')),
  CONSTRAINT slacker_jobs_delivery_check
    CHECK (delivery_state IN ('pending', 'delivered')));
CREATE INDEX slacker_jobs_queue
  ON slacker_jobs (agent_id, environment, account, state, created_at);
CREATE INDEX slacker_jobs_by_chat
  ON slacker_jobs (agent_id, environment, account, chat_id, state);
CREATE UNIQUE INDEX slacker_jobs_live_session
  ON slacker_jobs (session_id) WHERE state = 'running';
CREATE UNIQUE INDEX slacker_jobs_by_origin
  ON slacker_jobs (agent_id, environment, account, chat_id, origin_message_id)
  WHERE origin_message_id IS NOT NULL;
COMMENT ON TABLE slacker_jobs IS
  'Work an assistant turn handed over, run by the listener''s job runner and answered into its conversation, in thread_ts, once.';
COMMENT ON COLUMN slacker_jobs.thread_ts IS
  'The thread the result is posted in; null posts it at the conversation''s top level.';
COMMENT ON COLUMN slacker_jobs.attempt_token IS
  'Names the one attempt every write about a running job must match, so an owner that lost its lease changes nothing.';
COMMENT ON COLUMN slacker_jobs.host IS
  'The machine whose listener holds the attempt; a pid means something only there.'"""),
    # Text added to a job while it runs, kept until the engine has taken it.
    Step("0012-job-amendments", """
CREATE TABLE slacker_job_amendments (
  agent_id text NOT NULL CHECK (agent_id <> ''),
  id text NOT NULL, environment text NOT NULL,
  account text NOT NULL, job_id text NOT NULL, text text NOT NULL,
  state text NOT NULL, claim_token text, created_at timestamptz NOT NULL,
  claimed_at timestamptz, acked_at timestamptz,
  CONSTRAINT slacker_job_amendments_pkey PRIMARY KEY (id),
  CONSTRAINT slacker_job_amendments_state_check
    CHECK (state IN ('pending', 'claimed', 'acked')));
CREATE INDEX slacker_job_amendments_pending
  ON slacker_job_amendments (agent_id, environment, account, job_id, state, created_at);
COMMENT ON TABLE slacker_job_amendments IS
  'Text added to a job while it runs, kept until the engine has taken it.'"""),
    # One row per attempt holding one of the `max_parallel_jobs` slots, so the
    # budget is a fact of the store rather than of one listener's memory.
    Step("0013-job-slots", """
CREATE TABLE slacker_job_slots (
  agent_id text NOT NULL CHECK (agent_id <> ''),
  environment text NOT NULL, account text NOT NULL,
  slot integer NOT NULL, job_id text NOT NULL, owner_id text NOT NULL,
  attempt_token text NOT NULL, lease_expires_at timestamptz NOT NULL,
  CONSTRAINT slacker_job_slots_pkey PRIMARY KEY (agent_id, environment, account, slot),
  CONSTRAINT slacker_job_slots_job_key UNIQUE (agent_id, environment, account, job_id));
COMMENT ON TABLE slacker_job_slots IS
  'One row per running job attempt holding one of max_parallel_jobs slots.'"""),
    # The service's prompts, the agent's own text over the bundle's standard:
    # every saved version by key, one active, history immutable.
    Step("0014-prompts", """
CREATE TABLE slacker_prompts (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  agent_id text NOT NULL CHECK (agent_id <> ''),
  key text NOT NULL CHECK (key IN ('context', 'delegation', 'job-worker')),
  body text NOT NULL,
  active boolean NOT NULL DEFAULT true,
  created_at timestamptz NOT NULL DEFAULT now(),
  created_by text NOT NULL CHECK (created_by <> ''),
  note text);
CREATE UNIQUE INDEX slacker_prompts_active ON slacker_prompts (agent_id, key)
  WHERE active;
CREATE INDEX slacker_prompts_by_key ON slacker_prompts (agent_id, key, created_at DESC);
COMMENT ON TABLE slacker_prompts IS
  'Every saved version of an agent''s slacker service prompts (context, delegation, job-worker); one active per key, a save clears it on the version it replaces.';
COMMENT ON COLUMN slacker_prompts.body IS
  'The prompt text byte for byte; it replaces the bundle''s standard text for its key.'"""),
    # Every agent reference a foreign key in its class, and every job row
    # keyed to its job; the prompts' guard keeps history immutable and admits
    # the cascade of a deliberate delete and nothing else.
    Step("0015-keys", r"""
CREATE FUNCTION slacker_prompts_guard() RETURNS trigger
    LANGUAGE plpgsql AS $guard$
DECLARE
    admitted boolean := false;
BEGIN
    IF tg_op IN ('DELETE', 'UPDATE')
       AND coalesce(current_setting('store.deleting_agent', true), '')
           || coalesce(current_setting('store.deleting_node', true), '')
           || coalesce(current_setting('store.deleting_connection', true), '') <> '' THEN
        EXECUTE format('SELECT %I.store_state_cascade($1, $2, $3, $4)', tg_table_schema)
            INTO admitted USING tg_table_name, tg_op, to_jsonb(old),
            CASE WHEN tg_op = 'UPDATE' THEN to_jsonb(new) END;
        IF admitted THEN
            RETURN CASE WHEN tg_op = 'DELETE' THEN old ELSE new END;
        END IF;
    END IF;
  IF TG_OP = 'DELETE' THEN
    RAISE EXCEPTION 'slacker_prompts keeps every version';
  END IF;
  IF new.id <> old.id OR new.agent_id <> old.agent_id OR new.key <> old.key
     OR new.body <> old.body OR new.created_at <> old.created_at
     OR new.created_by <> old.created_by OR new.note IS DISTINCT FROM old.note
     OR (new.active AND NOT old.active) THEN
    RAISE EXCEPTION 'a slacker_prompts version is immutable but for clearing active';
  END IF;
  RETURN new;
END;
$guard$;
CREATE TRIGGER slacker_prompts_guard BEFORE UPDATE OR DELETE ON slacker_prompts
  FOR EACH ROW EXECUTE FUNCTION slacker_prompts_guard();
SELECT store_state_keys('slacker', ARRAY[
    ARRAY['slacker_register', 'agent_id', 'agents', 'cascade'],
    ARRAY['slacker_jobs', 'agent_id', 'agents', 'cascade'],
    ARRAY['slacker_job_slots', 'agent_id', 'agents', 'cascade'],
    ARRAY['slacker_job_slots', 'job_id', 'slacker_jobs', 'cascade'],
    ARRAY['slacker_job_amendments', 'agent_id', 'agents', 'cascade'],
    ARRAY['slacker_job_amendments', 'job_id', 'slacker_jobs', 'cascade'],
    ARRAY['slacker_prompts', 'agent_id', 'agents', 'cascade']])""", core=(4, 0)),
    # Nothing starts for an archived agent: entering a job of one is refused
    # through the core's one guard, `agents_archived_refuse`; moving or ending
    # one stays allowed.
    Step("0016-jobs-unarchived", """
CREATE FUNCTION slacker_jobs_unarchived() RETURNS trigger
 LANGUAGE plpgsql SET search_path FROM CURRENT AS $guard$
BEGIN
 PERFORM agents_archived_refuse(NEW.agent_id);
 RETURN NEW;
END $guard$;
CREATE TRIGGER slacker_jobs_unarchived BEFORE INSERT ON slacker_jobs
 FOR EACH ROW EXECUTE FUNCTION slacker_jobs_unarchived();
COMMENT ON TRIGGER slacker_jobs_unarchived ON slacker_jobs IS
  'Refuses entering a job of an archived agent; moving or ending one stays allowed.'""",
         core=(4, 2)),
]


def _tables():
    """The steps and version of the slacker_* tables, for the contract's
    `migrate` (and the manager's install-time migration)."""
    return STORE_STEPS, STORE_SCHEMA_MAJOR, STORE_SCHEMA_MINOR


def _store_refusal(exc: "DbError") -> NoReturn:
    _refuse(6 if exc.slug in _STORE_CONFIG_SLUGS else 5, exc.slug, exc.message,
            exc.hint)


def _from_store(name: str, value):
    if isinstance(value, bool):
        return value
    if isinstance(value, datetime.datetime):
        if name in _EPOCH_COLUMNS:
            return value.astimezone(datetime.timezone.utc).isoformat()
        return value.astimezone(datetime.timezone.utc).isoformat()
    if isinstance(value, memoryview):
        return bytes(value)
    return value


class _Row:
    """One result row, addressable by position and by column name."""

    __slots__ = ("_index", "_values")

    def __init__(self, index: dict, values: list):
        self._index = index
        self._values = values

    def __getitem__(self, key):
        if isinstance(key, (int, slice)):
            return self._values[key]
        return self._values[self._index[key]]

    def __iter__(self):
        return iter(self._values)

    def __len__(self) -> int:
        return len(self._values)

    def keys(self) -> list:
        return list(self._index)


def _row_factory(cursor):
    names = [column.name for column in (cursor.description or [])]
    index = {name: i for i, name in enumerate(names)}

    def make(values):
        return _Row(index, [_from_store(n, v) for n, v in zip(names, values)])
    return make


class _Store:
    """One store connection for one account. Every statement runs under one
    lock, and every write goes through `_writing`, which holds that lock for the
    whole transaction, so a capture write from the listener's loop is whole."""

    def __init__(self, conn, account: str, setting):
        import psycopg
        self.conn = conn
        self.account = account
        self.setting = setting
        self.schema = getattr(setting, "schema", None)
        self.write_lock = threading.RLock()
        self.write_depth = 0
        self._error = psycopg.Error

    def execute(self, sql: str, params=None):
        with self.write_lock:
            cursor = self.conn.cursor(row_factory=_row_factory)
            try:
                cursor.execute(sql, params if params else None)
            except self._error as exc:
                detail = (str(exc).strip().splitlines() or [type(exc).__name__])[0]
                _refuse(5, "store_failed",
                        f"the store refused a statement: {detail}",
                        "prove the store with `capabilities store doctor`, then retry")
            return cursor

    def close(self) -> None:
        with contextlib.suppress(Exception):
            self.conn.close()


@contextlib.contextmanager
def _writing(db: _Store):
    """One store write, whole. Nested writes join the transaction their caller
    opened, so a message row and the conversation cursor it advances commit
    together or not at all."""
    with db.write_lock:
        if db.write_depth:
            db.write_depth += 1
            try:
                yield
            finally:
                db.write_depth -= 1
            return
        with db.conn.transaction():
            db.write_depth += 1
            try:
                yield
            finally:
                db.write_depth -= 1


def _store_setting(root: Path | None = None):
    try:
        return resolve_setting(root if root is not None else _project_root())
    except DbError as exc:
        _store_refusal(exc)


def _store_account(cfg: dict) -> str:
    """The account a connection's rows are keyed by: the team id it binds,
    else the name it was kept under before connections were given ids, else
    its id."""
    if cfg.get("account_binding"):
        return cfg["account_binding"]
    cid = cfg.get("id")
    return (_connection_former_name(cid) if cid else None) or cid or "default"


def _open_store(cfg: dict) -> _Store:
    """The store for one connection's account, its tables migrated. The account
    is the workspace team id the connection binds, else the connection id, so a
    capture is never split and never confused between two workspaces. A
    connection binding no team keeps the rows it kept under the name it had
    before connections were given ids."""
    account = _store_account(cfg)
    setting = _store_setting()
    try:
        conn = connect(application_name=NAME, setting=setting, transaction=True)
    except DbError as exc:
        _store_refusal(exc)
    try:
        result = migrate(conn, NAME, STORE_STEPS, major=STORE_SCHEMA_MAJOR,
                         minor=STORE_SCHEMA_MINOR)
        conn.autocommit = True
    except DbError as exc:
        conn.close()
        _store_refusal(exc)
    except Exception as exc:
        conn.close()
        _refuse(5, "store_failed",
                f"the store could not be prepared: {type(exc).__name__}: {exc}",
                "prove the store with `capabilities store doctor`, then retry")
    for warning in getattr(result, "warnings", []) or []:
        _log(warning)
    db = _Store(conn, account, setting)
    if _get_meta(db, "schema") is None:
        with _writing(db):
            _set_meta(db, "schema", STORE_VERSION)
    return db


def _get_meta(db: _Store, key: str) -> str | None:
    row = db.execute(
        "SELECT value FROM slacker_meta WHERE account = %s AND key = %s",
        (db.account, key)).fetchone()
    return row["value"] if row else None


def _set_meta(db: _Store, key: str, value: str) -> None:
    db.execute(
        """INSERT INTO slacker_meta (account, key, value) VALUES (%s, %s, %s)
           ON CONFLICT (account, key) DO UPDATE SET value = excluded.value""",
        (db.account, key, value))


# --- Store writes: conversations, messages, users ----------------------------

def _iso_now() -> str:
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


def _upsert_conversation(db: _Store, conv: dict) -> None:
    """Record a conversation and its latest activity, keeping the sync cursor
    and any name a later read resolved."""
    cid = conv.get("id")
    if not cid:
        return
    last_ts = conv.get("latest", {}).get("ts") if isinstance(conv.get("latest"), dict) \
        else conv.get("last_ts")
    last_f = _ts_float(last_ts)
    with _writing(db):
        db.execute(
            f"""INSERT INTO slacker_conversations
                  (account, id, kind, name, user_id, is_member, is_archived,
                   last_ts, last_ts_at, updated_at)
                VALUES (%s,%s,%s,%s,%s,%s,%s,%s,
                        {_TS_PARAM if last_f is not None else 'NULL'}, now())
                ON CONFLICT (account, id) DO UPDATE SET
                  kind = excluded.kind,
                  name = COALESCE(NULLIF(excluded.name,''), slacker_conversations.name),
                  user_id = COALESCE(excluded.user_id, slacker_conversations.user_id),
                  is_member = excluded.is_member,
                  is_archived = excluded.is_archived,
                  last_ts = CASE WHEN excluded.last_ts IS NOT NULL
                       AND (slacker_conversations.last_ts IS NULL
                            OR excluded.last_ts > slacker_conversations.last_ts)
                       THEN excluded.last_ts ELSE slacker_conversations.last_ts END,
                  last_ts_at = GREATEST(slacker_conversations.last_ts_at,
                                        excluded.last_ts_at),
                  updated_at = now()""",
            [db.account, cid, _conv_kind(conv), _conv_name(conv) or "",
             conv.get("user"), bool(conv.get("is_member", conv.get("is_im") or
                                              conv.get("is_mpim"))),
             bool(conv.get("is_archived")), last_ts]
            + ([last_f] if last_f is not None else []))


def _advance_cursor(db: _Store, channel_id: str, oldest: str | None,
                    newest: str | None) -> None:
    """Widen the per-conversation covered range. The store keeps the widest
    [oldest, newest] it has seen, so a later sync asks only for what is newer.
    The conversation row is created if a sync reaches a channel before it was
    listed, so the cursor is never lost."""
    with _writing(db):
        db.execute(
            """INSERT INTO slacker_conversations
                 (account, id, synced_oldest, synced_newest, synced_at, updated_at)
               VALUES (%s, %s, %s, %s, now(), now())
               ON CONFLICT (account, id) DO UPDATE SET
                 synced_oldest = CASE WHEN slacker_conversations.synced_oldest IS NULL
                      OR (excluded.synced_oldest IS NOT NULL
                          AND excluded.synced_oldest < slacker_conversations.synced_oldest)
                      THEN excluded.synced_oldest
                      ELSE slacker_conversations.synced_oldest END,
                 synced_newest = CASE WHEN slacker_conversations.synced_newest IS NULL
                      OR (excluded.synced_newest IS NOT NULL
                          AND excluded.synced_newest > slacker_conversations.synced_newest)
                      THEN excluded.synced_newest
                      ELSE slacker_conversations.synced_newest END,
                 synced_at = now()""",
            (db.account, channel_id, oldest, newest))


def _message_values(channel_id: str, msg: dict, sync_type: str) -> dict | None:
    """The row a Slack message object becomes, or None when it carries no ts."""
    ts = msg.get("ts")
    if not ts:
        return None
    edited = msg.get("edited") or {}
    edited_f = _ts_float(edited.get("ts")) if edited else None
    reactions = {}
    for r in msg.get("reactions") or []:
        if r.get("name"):
            reactions[r["name"]] = list(r.get("users") or [])
    return {
        "channel_id": channel_id, "ts": ts, "ts_f": _ts_float(ts),
        "thread_ts": msg.get("thread_ts"),
        "user_id": msg.get("user") or msg.get("bot_id"),
        "type": msg.get("type") or "message",
        "subtype": msg.get("subtype"),
        "text": msg.get("text"),
        "edited_f": edited_f,
        "reply_count": int(msg.get("reply_count") or 0),
        "reactions": reactions,
        "raw": msg,
        "sync_type": sync_type,
    }


def _upsert_message(db: _Store, channel_id: str, msg: dict, sync_type: str,
                    authoritative: bool = False) -> bool:
    """Write one message, deduplicated on its ts. Returns True when the row was
    new. A history/backfill write never clobbers a live row (DO NOTHING); a live
    or edit write is authoritative over what it replaces."""
    v = _message_values(channel_id, msg, sync_type)
    if v is None:
        return False
    ts_at = _TS_PARAM if v["ts_f"] is not None else "NULL"
    edited_at = _TS_PARAM if v["edited_f"] is not None else "NULL"
    params = [db.account, v["channel_id"], v["ts"]]
    params += [v["ts_f"]] if v["ts_f"] is not None else []
    params += [v["thread_ts"], v["user_id"], v["type"], v["subtype"], v["text"]]
    params += [v["edited_f"]] if v["edited_f"] is not None else []
    params += [v["reply_count"], json.dumps(v["reactions"]),
               json.dumps(v["raw"]), v["sync_type"]]
    conflict = ("""DO UPDATE SET
                  text = excluded.text, subtype = excluded.subtype,
                  thread_ts = COALESCE(excluded.thread_ts, slacker_messages.thread_ts),
                  edited_at = excluded.edited_at,
                  reply_count = GREATEST(slacker_messages.reply_count,
                                         excluded.reply_count),
                  reactions = excluded.reactions, raw = excluded.raw,
                  sync_type = excluded.sync_type, captured_at = now()"""
                if authoritative else "DO NOTHING")
    with _writing(db):
        cur = db.execute(
            f"""INSERT INTO slacker_messages
                  (account, channel_id, ts, ts_at, thread_ts, user_id, type,
                   subtype, text, edited_at, reply_count, reactions, raw,
                   sync_type, captured_at)
                VALUES (%s,%s,%s,{ts_at},%s,%s,%s,%s,%s,{edited_at},%s,%s,%s,%s,now())
                ON CONFLICT (account, channel_id, ts) {conflict}
                RETURNING (xmax = 0) AS inserted""",
            params)
        row = cur.fetchone()
    return bool(row and row["inserted"]) if row else False


def _apply_edit(db: _Store, channel_id: str, msg: dict) -> None:
    """A message_changed event: the new text and edited time, over whatever is
    stored. If the row is unknown it is inserted, so an edit is never lost."""
    _upsert_message(db, channel_id, msg, "live", authoritative=True)


def _apply_replied(db: _Store, channel_id: str, parent: dict) -> None:
    """A message_replied event: Slack re-sends the thread's parent to say it
    gained a reply. Only the parent's reply metadata moves; its text and kind
    stay as stored. An unknown parent is stored from the event as it stands."""
    v = _message_values(channel_id, parent, "live")
    if v is None:
        return
    with _writing(db):
        cur = db.execute(
            """UPDATE slacker_messages SET
                 thread_ts = COALESCE(thread_ts, %s),
                 reply_count = GREATEST(reply_count, %s), captured_at = now()
               WHERE account = %s AND channel_id = %s AND ts = %s""",
            (v["thread_ts"], v["reply_count"], db.account, channel_id, v["ts"]))
        updated = cur.rowcount
    if not updated:
        _upsert_message(db, channel_id, parent, "live", authoritative=False)


def _apply_delete(db: _Store, channel_id: str, deleted_ts: str) -> None:
    with _writing(db):
        db.execute(
            """UPDATE slacker_messages SET deleted = true, captured_at = now()
               WHERE account = %s AND channel_id = %s AND ts = %s""",
            (db.account, channel_id, deleted_ts))


def _apply_reaction(db: _Store, channel_id: str, ts: str, name: str,
                    user: str, added: bool) -> None:
    """Add or remove one user's reaction on a message, in the {name: [users]}
    jsonb. A reaction on a message the capture has not seen is dropped: there is
    nothing to attach it to, and it will arrive with the message on backfill."""
    with _writing(db):
        row = db.execute(
            "SELECT reactions FROM slacker_messages "
            "WHERE account = %s AND channel_id = %s AND ts = %s FOR UPDATE",
            (db.account, channel_id, ts)).fetchone()
        if not row:
            return
        reactions = row["reactions"] or {}
        if isinstance(reactions, str):
            reactions = json.loads(reactions)
        users = list(reactions.get(name) or [])
        if added and user not in users:
            users.append(user)
        if not added and user in users:
            users.remove(user)
        if users:
            reactions[name] = users
        else:
            reactions.pop(name, None)
        db.execute(
            "UPDATE slacker_messages SET reactions = %s, captured_at = now() "
            "WHERE account = %s AND channel_id = %s AND ts = %s",
            (json.dumps(reactions), db.account, channel_id, ts))


def _upsert_user(db: _Store, user: dict) -> None:
    uid = user.get("id")
    if not uid:
        return
    profile = user.get("profile") or {}
    with _writing(db):
        db.execute(
            """INSERT INTO slacker_users
                 (account, id, name, real_name, display_name, is_bot, deleted,
                  updated_at)
               VALUES (%s,%s,%s,%s,%s,%s,%s, now())
               ON CONFLICT (account, id) DO UPDATE SET
                 name = excluded.name, real_name = excluded.real_name,
                 display_name = excluded.display_name, is_bot = excluded.is_bot,
                 deleted = excluded.deleted, updated_at = now()""",
            (db.account, uid, user.get("name"),
             profile.get("real_name") or user.get("real_name"),
             profile.get("display_name"), bool(user.get("is_bot")),
             bool(user.get("deleted"))))


# --- Live events -------------------------------------------------------------

def _handle_event(db: _Store, event: dict) -> dict | None:
    """Apply one session event to the store and say what it changed. Pure of the
    socket: the capture loop reads an event off the wire and hands it here, and
    the tests hand it the same shapes with no socket at all.

    Dedup is the store's: a message is keyed by its ts, so a redelivery after a
    reconnect updates in place and never doubles."""
    etype = event.get("type")
    if etype == "message":
        channel = event.get("channel")
        subtype = event.get("subtype")
        if not channel:
            return None
        if subtype == "message_changed" and isinstance(event.get("message"), dict):
            _apply_edit(db, channel, event["message"])
            return {"change": "edit", "channel": channel,
                    "ts": event["message"].get("ts")}
        if subtype == "message_replied" and isinstance(event.get("message"), dict):
            _apply_replied(db, channel, event["message"])
            return {"change": "replied", "channel": channel,
                    "ts": event["message"].get("ts")}
        if subtype == "message_deleted" and event.get("deleted_ts"):
            _apply_delete(db, channel, event["deleted_ts"])
            return {"change": "delete", "channel": channel,
                    "ts": event["deleted_ts"]}
        # A plain new message, a thread reply (carries thread_ts), or a
        # thread_broadcast — all are rows keyed by their ts.
        inserted = _upsert_message(db, channel, event, "live", authoritative=True)
        return {"change": "message" if inserted else "message_update",
                "channel": channel, "ts": event.get("ts"),
                "thread": event.get("thread_ts")}
    if etype in ("reaction_added", "reaction_removed"):
        item = event.get("item") or {}
        if item.get("type") == "message" and item.get("channel") and item.get("ts"):
            _apply_reaction(db, item["channel"], item["ts"],
                            event.get("reaction") or "", event.get("user") or "",
                            added=etype == "reaction_added")
            return {"change": etype, "channel": item["channel"], "ts": item["ts"]}
    return None


# --- Slack client ------------------------------------------------------------

def _slack():
    """slack_sdk's WebClient class and its error type, imported lazily so every
    non-network path (and every test) runs with no dependency present."""
    try:
        from slack_sdk import WebClient
        from slack_sdk.errors import SlackApiError
    except ImportError:
        _refuse(6, "driver_missing",
                "the Slack client library slack_sdk is not installed",
                f"run {NAME} through its own script header, which pins it")
    return WebClient, SlackApiError


def _not_an_api_answer(resp, err: str) -> str:
    """What Slack sent back where its API answers JSON - the method, the HTTP
    status, where it redirected and the kind of body - so a session Slack's
    API does not take says what Slack did with it. The redirect is told
    without its query and the body not at all: either may echo what was sent."""
    from urllib.parse import urlsplit
    headers = {}
    for key, value in (getattr(resp, "headers", None) or {}).items():
        headers[str(key).lower()] = value[0] if isinstance(value, list) and value \
            else value
    path = urlsplit(getattr(resp, "api_url", None) or "").path
    method = path.rstrip("/").rsplit("/", 1)[-1] or "the API"
    status = getattr(resp, "status_code", None)
    said = [f"HTTP {status}" if status is not None else "no HTTP status"]
    location = headers.get("location")
    if location:
        where = urlsplit(str(location))
        said.append(f"redirect to {where.scheme}://{where.netloc}{where.path}"
                    if where.netloc else f"redirect to {where.path}")
    ctype = str(headers.get("content-type") or "").split(";")[0].strip()
    said.append(f"content type {ctype}" if ctype else "no content type")
    body = err.split(":", 1)[1].strip() if ":" in err else ""
    said.append("a body that is not JSON" if body else "an empty body")
    return f"Slack answered {method} with no API answer ({', '.join(said)})"


class SlackClient:
    """The linked user's web session, carried as the web client carries it: the
    xoxc- token as a bearer and the `d` cookie beside it."""

    def __init__(self, cfg: dict):
        WebClient, self._err = _slack()
        self.cfg = cfg
        self.client = WebClient(
            token=cfg["token"],
            headers={"Cookie": f"d={cfg['cookie']}"})

    def _call(self, method: str, **kwargs) -> dict:
        try:
            return self.client.api_call(method, params={
                k: v for k, v in kwargs.items() if v is not None}).data
        except self._err as exc:
            self._raise(exc)

    def _raise(self, exc) -> NoReturn:
        resp = getattr(exc, "response", None)
        err = (resp.get("error") if resp is not None else None) or str(exc)
        if str(err).startswith("Received a response in a non-JSON format"):
            _refuse(5, "slack_error", _not_an_api_answer(resp, str(err)))
        if err in ("invalid_auth", "not_authed", "token_revoked",
                   "token_expired", "account_inactive"):
            _refuse(2, "invalid_auth",
                    f"the Slack session is not valid: {err}",
                    "the session expired or was signed out; link the "
                    "connection again")
        if err == "ratelimited":
            retry = None
            with contextlib.suppress(Exception):
                retry = resp.headers.get("Retry-After")
            _refuse(5, "rate_limited",
                    "Slack rate-limited the session"
                    + (f"; retry after {retry}s" if retry else ""))
        if err in ("channel_not_found", "not_in_channel", "thread_not_found"):
            _refuse(6, err, f"Slack: {err}",
                    "the session cannot see that conversation")
        if err in _WRITE_REFUSALS:
            _refuse(6, err, f"Slack refused the write: {err}",
                    _WRITE_REFUSALS[err])
        if err == "missing_scope":
            _refuse(6, "missing_scope",
                    "the session lacks a scope this read needs",
                    "a web session normally carries the user's full view; "
                    "record this limitation")
        _refuse(5, "slack_error", f"Slack returned an error: {err}")

    def auth_test(self) -> dict:
        return self._call("auth.test")

    def team_info(self) -> dict:
        return self._call("team.info").get("team", {})

    def user_info(self, user: str) -> dict:
        return self._call("users.info", user=user).get("user", {})

    def conversation_info(self, channel: str) -> dict:
        return self._call("conversations.info", channel=channel).get("channel", {})

    def conversations(self, types: str, limit: int = 1000):
        """The linked user's own conversations. users.conversations answers
        only those the user is in and omits is_member on a channel, so each is
        marked a member here."""
        cursor = None
        while True:
            data = self._call("users.conversations", types=types,
                              limit=min(limit, 1000), cursor=cursor,
                              exclude_archived=False)
            for conv in data.get("channels", []):
                yield {**conv, "is_member": True}
            cursor = (data.get("response_metadata") or {}).get("next_cursor")
            if not cursor:
                return

    def history(self, channel: str, oldest: str | None = None,
                latest: str | None = None, limit: int | None = 200,
                pages: int | None = 10):
        """Messages strictly between oldest and latest, in Slack's order (newest
        first), until `limit` messages or `pages` pages, or every one when both
        are None. Once consumed, `history_complete` says whether Slack had no
        more: only a complete fetch covers the whole range it asked for."""
        self.history_complete = False
        cursor = None
        seen = page = 0
        while pages is None or page < max(1, pages):
            page += 1
            data = self._call("conversations.history", channel=channel,
                              oldest=oldest, latest=latest,
                              limit=200 if limit is None else min(limit, 200),
                              cursor=cursor, inclusive=False)
            cursor = (data.get("response_metadata") or {}).get("next_cursor")
            more = bool(data.get("has_more") and cursor)
            messages = data.get("messages", [])
            for i, msg in enumerate(messages):
                yield msg
                seen += 1
                if limit is not None and seen >= limit:
                    self.history_complete = i == len(messages) - 1 and not more
                    return
            if not more:
                self.history_complete = True
                return

    def replies(self, channel: str, thread_ts: str, limit: int = 200):
        cursor = None
        while True:
            data = self._call("conversations.replies", channel=channel,
                              ts=thread_ts, limit=min(limit, 200), cursor=cursor)
            for msg in data.get("messages", []):
                yield msg
            cursor = (data.get("response_metadata") or {}).get("next_cursor")
            if not (data.get("has_more") and cursor):
                return

    def search(self, query: str, limit: int = 20, sort: str = "score"):
        """Messages matching `query` across every conversation the user can see,
        as Slack's own search answers it, until `limit` matches. Once consumed,
        `search_total` is the number Slack counts. A network failure is Slack
        being unreachable, so an empty answer always means no match."""
        self.search_total = 0
        page = 1
        seen = 0
        while True:
            try:
                data = self._call("search.messages", query=query,
                                  count=min(limit, 100), page=page, sort=sort,
                                  sort_dir="desc")
            except OSError as exc:
                _refuse(5, "slack_unreachable",
                        f"Slack could not be reached: {exc}",
                        "check the network and run the search again")
            found = data.get("messages") or {}
            self.search_total = found.get("total") or 0
            for match in found.get("matches") or []:
                yield match
                seen += 1
                if seen >= limit:
                    return
            paging = found.get("paging") or {}
            if page >= (paging.get("pages") or 1):
                return
            page += 1

    # Writes. Each is the call the web client makes for the same act, posted as
    # a form body, as the person's own session; nothing here sets presence or
    # dresses the session as another client.

    def _post(self, method: str, **kwargs) -> dict:
        try:
            return self.client.api_call(method, data={
                k: v for k, v in kwargs.items() if v is not None}).data
        except self._err as exc:
            self._raise(exc)

    def post_message(self, channel: str, text: str, thread_ts: str | None = None,
                     broadcast: bool = False) -> dict:
        return self._post("chat.postMessage", channel=channel, text=text,
                          thread_ts=thread_ts,
                          reply_broadcast="true" if broadcast and thread_ts else None)

    def update_message(self, channel: str, ts: str, text: str) -> dict:
        return self._post("chat.update", channel=channel, ts=ts, text=text)

    def delete_message(self, channel: str, ts: str) -> dict:
        return self._post("chat.delete", channel=channel, ts=ts)

    def reaction(self, channel: str, ts: str, name: str, add: bool) -> dict:
        return self._post("reactions.add" if add else "reactions.remove",
                          channel=channel, timestamp=ts, name=name)

    def mark(self, channel: str, ts: str) -> dict:
        return self._post("conversations.mark", channel=channel, ts=ts)

    def open_conversation(self, users: list[str]) -> dict:
        return self._post("conversations.open", users=",".join(users),
                          return_im="true")

    def upload(self, channel: str, path: Path, comment: str | None,
               thread_ts: str | None, title: str | None) -> dict:
        """The web client's external upload: ask for an upload URL, send the
        bytes to it, then complete the upload into the conversation."""
        try:
            return self.client.files_upload_v2(
                channel=channel, file=str(path), filename=path.name,
                title=title or path.name, initial_comment=comment,
                thread_ts=thread_ts).data
        except self._err as exc:
            self._raise(exc)

    def file_share_ts(self, file_id: str, channel: str, tries: int = 6) -> str | None:
        """The ts of the message an upload was shared in. Slack shares the file
        a moment after the upload completes, so this asks a few times."""
        for attempt in range(tries):
            info = self._call("files.info", file=file_id).get("file") or {}
            shares = info.get("shares") or {}
            for scope in ("public", "private"):
                for share in (shares.get(scope) or {}).get(channel) or []:
                    if share.get("ts"):
                        return share["ts"]
            if attempt + 1 < tries:
                time.sleep(1)
        return None

    def message(self, channel: str, ts: str, thread_ts: str | None = None) -> dict | None:
        """One message as Slack now holds it, or None."""
        if thread_ts and thread_ts != ts:
            data = self._call("conversations.replies", channel=channel,
                              ts=thread_ts, oldest=ts, latest=ts, inclusive=True,
                              limit=2)
        else:
            data = self._call("conversations.history", channel=channel,
                              oldest=ts, latest=ts, inclusive=True, limit=1)
        return next((m for m in data.get("messages") or [] if m.get("ts") == ts),
                    None)

    def latest_ts(self, channel: str) -> str | None:
        data = self._call("conversations.history", channel=channel, limit=1)
        messages = data.get("messages") or []
        return messages[0].get("ts") if messages else None


# Slack's answers that refuse a write the session asked for, with what to do.
_WRITE_REFUSALS = {
    "cant_update_message": "only the linked account's own messages can be edited",
    "cant_delete_message": "only the linked account's own messages can be deleted",
    "edit_window_closed": "the workspace no longer allows editing that message",
    "message_not_found": "no message has that ts in that conversation",
    "msg_too_long": "the text is longer than Slack accepts in one message",
    "no_text": "the message needs text",
    "is_archived": "the conversation is archived",
    "restricted_action": "the workspace does not let this account post there",
    "invalid_name": "no emoji has that name; pass it without colons",
    "too_many_reactions": "the message holds as many reactions as Slack allows",
    "user_not_found": "no user has that id in this workspace",
    "invalid_timestamp": "that is not a message ts in the conversation",
}


# --- Reads -------------------------------------------------------------------

def _identity(cfg: dict, client: SlackClient, db: _Store | None = None) -> dict:
    """The linked user and workspace, proven by auth.test. Records them in meta
    when a store is open, and checks the connection's bindings."""
    auth = client.auth_test()
    out = {"ok": True, "connection": cfg["id"], "user_id": auth.get("user_id"),
           "user": auth.get("user"), "team_id": auth.get("team_id"),
           "team": auth.get("team"), "url": auth.get("url")}
    if cfg.get("team_id") and auth.get("team_id") \
            and cfg["team_id"] != auth["team_id"]:
        _refuse(6, "wrong_workspace",
                f"the session resolves to workspace {auth['team_id']!r}, not the "
                f"bound {cfg['team_id']!r}",
                "the connection's team_id and the session disagree")
    if cfg.get("expect_user"):
        want = cfg["expect_user"].lstrip("@")
        if want not in (auth.get("user_id"), auth.get("user")):
            _refuse(6, "wrong_user",
                    f"the session resolves to {auth.get('user')!r} "
                    f"({auth.get('user_id')}), not the expected {want!r}")
    if db is not None:
        with _writing(db):
            _set_meta(db, "user_id", auth.get("user_id") or "")
            _set_meta(db, "user", auth.get("user") or "")
            _set_meta(db, "team_id", auth.get("team_id") or "")
            _set_meta(db, "team", auth.get("team") or "")
    return out


def _row_to_message(row: _Row) -> dict:
    reactions = row["reactions"] or {}
    if isinstance(reactions, str):
        reactions = json.loads(reactions)
    return {"ts": row["ts"], "ts_at": row["ts_at"], "thread_ts": row["thread_ts"],
            "user": row["user_id"], "type": row["type"], "subtype": row["subtype"],
            "text": row["text"], "edited": bool(row["edited_at"]),
            "deleted": bool(row["deleted"]), "reply_count": row["reply_count"],
            "reactions": reactions}


def _store_messages(db: _Store, channel_id: str, limit: int,
                    oldest: str | None, latest: str | None,
                    thread_ts: str | None = None) -> list[dict]:
    where = ["account = %s", "channel_id = %s", "deleted = false"]
    params: list = [db.account, channel_id]
    if thread_ts is not None:
        where.append("thread_ts = %s")
        params.append(thread_ts)
    if oldest is not None:
        where.append("ts >= %s")
        params.append(oldest)
    if latest is not None:
        where.append("ts <= %s")
        params.append(latest)
    params.append(limit)
    rows = db.execute(
        f"SELECT * FROM slacker_messages WHERE {' AND '.join(where)} "
        f"ORDER BY ts DESC LIMIT %s", params).fetchall()
    return [_row_to_message(r) for r in reversed(rows)]


def _store_covers_newest(db: _Store, channel_id: str) -> str | None:
    row = db.execute(
        "SELECT synced_newest FROM slacker_conversations "
        "WHERE account = %s AND id = %s", (db.account, channel_id)).fetchone()
    return row["synced_newest"] if row else None


def _open_gap(db: _Store, channel_id: str) -> tuple[str | None, str | None]:
    """The unfinished part of a sync from the cursor, as (gap_newest,
    gap_latest), or (None, None) when no sync stopped short."""
    row = db.execute(
        "SELECT gap_newest, gap_latest FROM slacker_conversations "
        "WHERE account = %s AND id = %s", (db.account, channel_id)).fetchone()
    return (row["gap_newest"], row["gap_latest"]) if row else (None, None)


def _set_gap(db: _Store, channel_id: str, newest: str | None,
             latest: str | None) -> None:
    with _writing(db):
        db.execute(
            "UPDATE slacker_conversations SET gap_newest = %s, gap_latest = %s "
            "WHERE account = %s AND id = %s",
            (newest, latest, db.account, channel_id))


# --- Sync --------------------------------------------------------------------

def _fetch_into_store(db: _Store, client: SlackClient, channel_id: str,
                      sync_type: str, oldest: str | None, latest: str | None,
                      limit: int | None) -> dict:
    """Fetch one range of a conversation into the store, deduplicated on ts.
    The cursor moves only over coverage that joins what the store already
    covered: a fetch that stopped short of the stored cursor leaves it where it
    was, so the next sync still asks for the messages this one did not reach."""
    prior = _store_covers_newest(db, channel_id)
    fetched = new = 0
    oldest_seen = newest_seen = None
    for msg in client.history(channel_id, oldest=oldest, latest=latest,
                              limit=limit,
                              pages=None if limit is None
                              else max(1, (limit + 199) // 200)):
        fetched += 1
        if _upsert_message(db, channel_id, msg, sync_type, authoritative=False):
            new += 1
        ts = msg.get("ts")
        if ts:
            if newest_seen is None or ts > newest_seen:
                newest_seen = ts
            if oldest_seen is None or ts < oldest_seen:
                oldest_seen = ts
    joined = (prior is None
              or (oldest_seen is not None
                  and _ts_float(oldest_seen) <= _ts_float(prior))
              or (client.history_complete
                  and (oldest is None or _ts_float(oldest) <= _ts_float(prior))))
    if joined:
        _advance_cursor(db, channel_id, oldest_seen or oldest, newest_seen)
    return {"fetched": fetched, "new": new}


def _close_gap(db: _Store, client: SlackClient, channel_id: str,
               prior: str) -> dict:
    """Fetch every message newer than the cursor, resuming below what an
    unfinished earlier attempt already stored. The lower edge reached is kept
    as the fetch goes, so an attempt a refusal cuts short still moves the next
    one on, and the cursor moves to the gap's top only once the gap is closed."""
    newest, latest = _open_gap(db, channel_id)
    if latest is None:
        newest = None
    resumed = latest is not None
    fetched = new = 0
    try:
        for msg in client.history(channel_id, oldest=prior, latest=latest,
                                  limit=None, pages=None):
            fetched += 1
            if _upsert_message(db, channel_id, msg, "backfill",
                               authoritative=False):
                new += 1
            ts = msg.get("ts")
            if ts and (newest is None or ts > newest):
                newest = ts
            if ts and (latest is None or ts < latest):
                latest = ts
    finally:
        if not client.history_complete and latest is not None:
            _set_gap(db, channel_id, newest, latest)
    _advance_cursor(db, channel_id, None, newest)
    _set_gap(db, channel_id, None, None)
    return {"fetched": fetched, "new": new, "resumed": resumed}


def _sync_channel(db: _Store, client: SlackClient, channel_id: str,
                  full: bool, limit: int) -> dict:
    """Bring one conversation forward. With a stored cursor every message newer
    than it is fetched, however many, so a gap is closed whole or the cursor
    stays, and an attempt cut short resumes where it stopped; `limit` bounds
    only how far back a first sync or `--full` reaches."""
    prior = None if full else _store_covers_newest(db, channel_id)
    if prior is None:
        result = _fetch_into_store(db, client, channel_id, "backfill", None,
                                   None, limit)
    else:
        result = _close_gap(db, client, channel_id, prior)
        if result.pop("resumed"):
            # What arrived above the top of the attempt that was resumed.
            more = _close_gap(db, client, channel_id,
                              _store_covers_newest(db, channel_id))
            more.pop("resumed")
            result = {k: result[k] + more[k] for k in result}
    return {"channel": channel_id, **result}


def _member_channels(db: _Store) -> list[str]:
    rows = db.execute(
        "SELECT id FROM slacker_conversations "
        "WHERE account = %s AND is_member = true AND is_archived = false",
        (db.account,)).fetchall()
    return [r["id"] for r in rows]


# --- Verbs -------------------------------------------------------------------

def _check_connection(cfg: dict) -> dict:
    try:
        client = SlackClient(cfg)
        ident = _identity(cfg, client)
    except _Refusal as refusal:
        return refusal.as_result()
    return {"ok": True, "user": ident["user"], "user_id": ident["user_id"],
            "team": ident["team"], "team_id": ident["team_id"],
            "url": ident["url"]}


def cmd_doctor(reg: dict, wanted: str | None) -> None:
    """Every connection bare; one with --connection. Exit 0 only when every
    examined connection authorises and resolves."""
    _doctor_gate(_connections_report(), wanted)
    targets = [_select_connection(reg, wanted)] if wanted is not None \
        else list(reg["connections"].items())
    connections: dict = {}
    fail_exit = 0
    for cid, entry in targets:
        cfg, problem = _build_cfg(cid, entry)
        if problem:
            res = {"ok": False, "category": problem["exit"],
                   "error": problem["message"]}
            if problem.get("hint"):
                res["hint"] = problem["hint"]
        else:
            res = _check_connection(cfg)
        if not res.get("ok") and not fail_exit:
            fail_exit = res.get("category") or 5
        res.pop("category", None)
        connections[cid] = res
    _emit({"ok": fail_exit == 0, "connections": connections})
    if fail_exit:
        sys.exit(fail_exit)


def cmd_whoami(args) -> dict:
    cfg = get_config(args)
    client = SlackClient(cfg)
    db = _open_store(cfg) if not getattr(args, "no_store", False) else None
    ident = _identity(cfg, client, db)
    if db is not None:
        db.close()
    return ident


def cmd_conversations(args) -> dict:
    cfg = get_config(args)
    client = SlackClient(cfg)
    db = _open_store(cfg)
    types = args.types or "im,mpim,public_channel,private_channel"
    search = (args.search or "").lower()
    rows = []
    for conv in client.conversations(types=types, limit=1000):
        _upsert_conversation(db, conv)
        name = _conv_name(conv) or ""
        if search and search not in name.lower() and search not in (conv.get("id") or "").lower():
            continue
        rows.append({"id": conv.get("id"), "kind": _conv_kind(conv),
                     "name": name or None, "is_member": bool(conv.get("is_member",
                        conv.get("is_im") or conv.get("is_mpim"))),
                     "is_archived": bool(conv.get("is_archived")),
                     "user": conv.get("user")})
    rows.sort(key=lambda r: (not r["is_member"], r["kind"], r["name"] or r["id"]))
    if args.limit:
        rows = rows[:args.limit]
    db.close()
    return {"connection": cfg["id"], "count": len(rows), "conversations": rows}


def cmd_history(args) -> dict:
    cfg = get_config(args)
    channel = _normalize_channel_id(args.channel)
    db = _open_store(cfg)
    fetched = 0
    if args.fresh or _store_covers_newest(db, channel) is None:
        fetched = _fetch_into_store(db, SlackClient(cfg), channel, "history",
                                    args.oldest, args.latest,
                                    args.limit)["fetched"]
    messages = _store_messages(db, channel, args.limit, args.oldest, args.latest)
    db.close()
    return {"connection": cfg["id"], "channel": channel,
            "fetched_from_slack": fetched, "count": len(messages),
            "messages": messages}


def _thread_covered(stored: list[dict], thread_ts: str) -> bool:
    """Whether the stored thread already holds every reply its parent counts.
    A history sync stores the parent alone, so a parent with no stored replies
    is never taken as the whole thread."""
    parent = next((m for m in stored if m["ts"] == thread_ts), None)
    replies = len(stored) - (1 if parent else 0)
    return bool(parent and replies and replies >= (parent["reply_count"] or 0))


def cmd_thread(args) -> dict:
    cfg = get_config(args)
    channel = _normalize_channel_id(args.channel)
    db = _open_store(cfg)
    fetched = 0
    stored = _store_messages(db, channel, 1000, None, None, thread_ts=args.thread_ts)
    if args.fresh or not _thread_covered(stored, args.thread_ts):
        client = SlackClient(cfg)
        for msg in client.replies(channel, args.thread_ts, limit=1000):
            _upsert_message(db, channel, msg, "history", authoritative=False)
            fetched += 1
        stored = _store_messages(db, channel, 1000, None, None,
                                 thread_ts=args.thread_ts)
    db.close()
    return {"connection": cfg["id"], "channel": channel,
            "thread_ts": args.thread_ts, "fetched_from_slack": fetched,
            "count": len(stored), "messages": stored}


def _search_hit(match: dict) -> dict:
    """One search match as a row that names where it lives: the conversation,
    the ts, and the thread it sits in. Slack carries a reply's thread only in
    its permalink, so the thread is read from there when the match lacks it."""
    from urllib.parse import parse_qs, urlparse
    conv = match.get("channel") or {}
    thread_ts = match.get("thread_ts")
    if not thread_ts and match.get("permalink"):
        thread_ts = (parse_qs(urlparse(match["permalink"]).query)
                     .get("thread_ts") or [None])[0]
    ts_at = None
    if _ts_float(match.get("ts")) is not None:
        whole, _, frac = match["ts"].partition(".")
        ts_at = datetime.datetime.fromtimestamp(
            int(whole), datetime.timezone.utc).replace(
            microsecond=int((frac or "0")[:6].ljust(6, "0"))).isoformat()
    return {"channel": conv.get("id"), "channel_name": _conv_name(conv),
            "kind": _conv_kind(conv), "ts": match.get("ts"),
            "ts_at": ts_at, "thread_ts": thread_ts,
            "user": match.get("user"), "username": match.get("username"),
            "text": match.get("text"), "permalink": match.get("permalink")}


def cmd_search(args) -> dict:
    query = " ".join(args.query).strip()
    if not query:
        _refuse(6, "invalid_arguments", "a search query is required",
                f"run `{NAME} search <text>`")
    cfg = get_config(args)
    client = SlackClient(cfg)
    hits = [_search_hit(m) for m in client.search(query, args.limit, args.sort)]
    return {"connection": cfg["id"], "query": query,
            "total": client.search_total, "count": len(hits), "messages": hits}


def cmd_sync(args) -> dict:
    cfg = get_config(args)
    db = _open_store(cfg)
    client = SlackClient(cfg)
    if args.channel:
        channels = [_normalize_channel_id(args.channel)]
    else:
        for conv in client.conversations(
                types="im,mpim,public_channel,private_channel", limit=1000):
            _upsert_conversation(db, conv)
        channels = _member_channels(db)
    results = [_sync_channel(db, client, c, args.full, args.limit) for c in channels]
    db.close()
    return {"connection": cfg["id"], "channels": len(results),
            "new": sum(r["new"] for r in results), "detail": results}


# --- Writes ------------------------------------------------------------------
#
# Each write is a verb in WRITE_VERBS, refused with exit 4 by the contract's
# write gate unless the connection grants allow_write. Each is the act the
# person would do in their own client, over their own session, and lands in the
# store as the capture records the same act arriving as an event: a sent message
# or reply is a live row keyed by its ts, an edit moves the text and the edited
# time, a deletion is the soft flag, a reaction moves the {name: [users]} map,
# an opened conversation is a conversation row. Marking read is not captured.

def _text_arg(text: str | None) -> str:
    """The message text, from the argument, or from stdin when it is `-`."""
    if text == "-":
        text = sys.stdin.read()
    if not (text or "").strip():
        _refuse(6, "invalid_arguments", "the message text is empty",
                "pass the text, or `-` to read it from stdin")
    return text


def _self_user_id(db: _Store, client: SlackClient) -> str:
    return _get_meta(db, "user_id") or client.auth_test().get("user_id") or ""


def _record_edit(db: _Store, channel_id: str, ts: str, text: str,
                 message: dict) -> None:
    """An edit of a stored message moves its text and edited time, keeping its
    thread, reactions and reply count; an edit of one the store has not seen
    stores the message as Slack answered it, so an edit is never lost."""
    edited_f = _ts_float((message.get("edited") or {}).get("ts")) or time.time()
    with _writing(db):
        cur = db.execute(
            f"""UPDATE slacker_messages SET text = %s,
                  edited_at = {_TS_PARAM},
                  raw = COALESCE(raw, '{{}}'::jsonb) || %s::jsonb,
                  sync_type = 'live', captured_at = now()
                WHERE account = %s AND channel_id = %s AND ts = %s""",
            (text, edited_f, json.dumps({"text": text, "edited": message.get("edited")
                                         or {"ts": f"{edited_f:.6f}"}}),
             db.account, channel_id, ts))
        updated = cur.rowcount
    if not updated:
        _upsert_message(db, channel_id, {**message, "ts": ts, "text": text},
                        "live", authoritative=True)


def _record_reply(db: _Store, channel_id: str, thread_ts: str) -> None:
    """A new reply raises its stored parent's reply count by one, as the
    capture's message_replied event would; an unseen parent is left to sync."""
    with _writing(db):
        db.execute(
            """UPDATE slacker_messages SET thread_ts = COALESCE(thread_ts, ts),
                 reply_count = reply_count + 1, captured_at = now()
               WHERE account = %s AND channel_id = %s AND ts = %s""",
            (db.account, channel_id, thread_ts))


def _record_sent(db: _Store, channel_id: str, message: dict) -> bool:
    inserted = _upsert_message(db, channel_id, message, "live", authoritative=True)
    thread_ts = message.get("thread_ts")
    if inserted and thread_ts and thread_ts != message.get("ts"):
        _record_reply(db, channel_id, thread_ts)
    return inserted


def cmd_send(args) -> dict:
    cfg = get_config(args)
    channel = _normalize_channel_id(args.channel)
    text = _text_arg(args.text)
    if args.broadcast and not args.thread:
        _refuse(6, "invalid_arguments", "--broadcast needs --thread",
                "a reply is also posted to the channel only when it is a reply")
    client = SlackClient(cfg)
    db = _open_store(cfg)
    data = client.post_message(channel, text, args.thread, args.broadcast)
    channel = data.get("channel") or channel
    message = {**(data.get("message") or {}), "ts": data.get("ts")}
    stored = _record_sent(db, channel, message)
    db.close()
    return {"ok": True, "connection": cfg["id"], "channel": channel,
            "ts": data.get("ts"), "thread_ts": args.thread,
            "broadcast": bool(args.broadcast), "stored": stored}


def cmd_edit(args) -> dict:
    cfg = get_config(args)
    channel = _normalize_channel_id(args.channel)
    text = _text_arg(args.text)
    client = SlackClient(cfg)
    db = _open_store(cfg)
    data = client.update_message(channel, args.ts, text)
    _record_edit(db, data.get("channel") or channel, args.ts,
                 data.get("text") or text, data.get("message") or {})
    db.close()
    return {"ok": True, "connection": cfg["id"],
            "channel": data.get("channel") or channel, "ts": args.ts,
            "edited": True}


def cmd_delete(args) -> dict:
    cfg = get_config(args)
    channel = _normalize_channel_id(args.channel)
    client = SlackClient(cfg)
    db = _open_store(cfg)
    data = client.delete_message(channel, args.ts)
    _apply_delete(db, data.get("channel") or channel, args.ts)
    db.close()
    return {"ok": True, "connection": cfg["id"],
            "channel": data.get("channel") or channel, "ts": args.ts,
            "deleted": True}


def cmd_react(args) -> dict:
    """`react` adds one reaction and `unreact` removes it. Asking for what
    already holds is answered as unchanged, not refused."""
    add = args.command == "react"
    cfg = get_config(args)
    channel = _normalize_channel_id(args.channel)
    name = (args.emoji or "").strip().strip(":")
    if not name:
        _refuse(6, "invalid_arguments", "an emoji name is required",
                "pass it as Slack names it, e.g. thumbsup")
    client = SlackClient(cfg)
    db = _open_store(cfg)
    changed = True
    try:
        client.reaction(channel, args.ts, name, add)
    except _Refusal as refusal:
        if refusal.message.endswith("already_reacted" if add else "no_reaction"):
            changed = False
        else:
            raise
    _apply_reaction(db, channel, args.ts, name, _self_user_id(db, client), added=add)
    db.close()
    return {"ok": True, "connection": cfg["id"], "channel": channel,
            "ts": args.ts, "reaction": name,
            "action": "added" if add else "removed", "changed": changed}


def cmd_upload(args) -> dict:
    cfg = get_config(args)
    channel = _normalize_channel_id(args.channel)
    path = Path(args.path).expanduser()
    if not path.is_file():
        _refuse(6, "file_not_found", f"no file at {args.path!r}",
                "pass the path of a file to upload")
    client = SlackClient(cfg)
    db = _open_store(cfg)
    data = client.upload(channel, path, args.comment, args.thread, args.title)
    files = data.get("files") or ([data["file"]] if data.get("file") else [])
    file_id = (files[0] if files else {}).get("id")
    ts = client.file_share_ts(file_id, channel) if file_id else None
    stored = False
    if ts:
        message = client.message(channel, ts, args.thread)
        if message:
            stored = _record_sent(db, channel, message)
    db.close()
    return {"ok": True, "connection": cfg["id"], "channel": channel,
            "file": file_id, "name": path.name, "ts": ts,
            "thread_ts": args.thread, "stored": stored}


def cmd_mark(args) -> dict:
    cfg = get_config(args)
    channel = _normalize_channel_id(args.channel)
    client = SlackClient(cfg)
    ts = args.ts or client.latest_ts(channel)
    if not ts:
        return {"ok": True, "connection": cfg["id"], "channel": channel,
                "ts": None, "marked": False, "note": "the conversation is empty"}
    client.mark(channel, ts)
    return {"ok": True, "connection": cfg["id"], "channel": channel,
            "ts": ts, "marked": True}


def cmd_open(args) -> dict:
    cfg = get_config(args)
    users = [u.strip().lstrip("@") for u in args.users if u.strip().lstrip("@")]
    if not users:
        _refuse(6, "invalid_arguments", "at least one user id is required",
                "pass user ids (U...), as `history` and `search` name them")
    client = SlackClient(cfg)
    db = _open_store(cfg)
    conv = client.open_conversation(users).get("channel") or {}
    if conv.get("id"):
        _upsert_conversation(db, {**conv, "is_member": True})
    db.close()
    return {"ok": True, "connection": cfg["id"], "channel": conv.get("id"),
            "kind": _conv_kind(conv) if conv else None, "users": users,
            "already_open": bool(conv.get("is_open")) if "is_open" in conv else None}


# --- Live-capture service ----------------------------------------------------

def _service_home(cfg: dict) -> Path:
    """<state>/slacker/<team id>/service, else the connection's own folder,
    <state>/slacker/<id>/service, where the library first moves one made under
    the connection's former name."""
    account = cfg.get("account_binding")
    if account:
        home = _STATE_HOME / NAME / re.sub(r"[^A-Za-z0-9_.-]", "_", account) / "service"
    else:
        cid = re.sub(r"[^A-Za-z0-9_.-]", "_", cfg.get("id") or "default")
        home = _connection_state_dir(_STATE_HOME / NAME, cid) / "service"
    home.mkdir(parents=True, exist_ok=True)
    return home


def _service_write(home: Path, name: str, payload: dict) -> None:
    """Replace one control file whole, so a reader never sees half of it."""
    spare = home / f".{name}.{os.getpid()}.{threading.get_ident()}.tmp"
    spare.write_text(json.dumps(payload, ensure_ascii=False, indent=2))
    os.replace(spare, home / name)


def _service_read(home: Path, name: str) -> dict | None:
    try:
        return json.loads((home / name).read_text())
    except (OSError, ValueError):
        return None


# How long a realtime connection must hold before a reconnect starts again
# from the shortest backoff.
_CAPTURE_STEADY_SECONDS = 30.0

# The origin the web client's realtime socket carries.
_WEB_ORIGIN = "https://app.slack.com"


# --- The assistant: settings, prompts, profiles ------------------------------
#
# The listener answers the messages its settings admit with a dialogue turn on
# callva-harness-runner, from the bundle's `service/` modules. The CLI does not
# carry the runner in its dependency header: every read verb resolves that
# header, and the runner is large. The listener runs itself again under `uv
# run --with` the runner pinned in `service/profiles.py` when its settings admit
# anyone; settings that admit nobody never need it, and capture exactly as
# before.

SERVICE_RUNNER_EXEC_ENV = "SLACKER_SERVICE_RUNNER_EXEC"
SERVICE_DOCUMENTS = ("context", "delegation", "job-worker")
_SERVICE_MODULES: dict[str, object] = {}


def _service_bundle_dir() -> Path:
    here = Path(__file__).resolve()
    return here.parent.parent if here.parent.name == "bin" else here.parent


def _service_template(name: str = "settings.json") -> Path:
    return _service_bundle_dir() / "service" / "templates" / name


def _service_module(name: str):
    """One of the bundle's service modules, loaded from beside this file. They
    import nothing of the CLI, so loading one costs nothing a verb would notice."""
    if name not in _SERVICE_MODULES:
        import importlib.util
        path = _service_bundle_dir() / "service" / f"{name}.py"
        spec = importlib.util.spec_from_file_location(f"slacker_service_{name}", path)
        if spec is None or spec.loader is None or not path.is_file():
            _refuse(3, "service_bundle_missing",
                    f"the bundled service module is missing: {path}",
                    f"reinstall {NAME} from a bundled source")
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        _SERVICE_MODULES[name] = module
    return _SERVICE_MODULES[name]


def _service_schema():
    return _service_module("settings_schema")


class _CliFacade:
    """The CLI's own functions as the service modules reach them: read live
    from this module, so the store and the Slack client the dialogue uses are
    the ones every verb uses."""

    __file__ = __file__

    def __getattr__(self, name):
        try:
            return globals()[name]
        except KeyError:
            raise AttributeError(name) from None


def _error_line(exc: BaseException) -> str:
    if isinstance(exc, _Refusal):
        return f"{exc.code}: {exc.message}"
    return (f"{type(exc).__name__}: {exc}".strip().splitlines() or ["error"])[0][:300]


def _service_settings() -> dict:
    """The service's settings records, without the registry's own default; an
    empty document where none were written."""
    try:
        rows = _records().resolve(NAME, "setting")
    except StoreError as exc:
        _refuse(6, exc.slug, exc.message, exc.hint)
    return {key: row["value"] for key, row in rows.items()
            if key != "connection.default"}


def _validate_service_settings(data) -> dict:
    """The closed settings surface: an unknown key is refused, never ignored.
    The bundle's schema module owns the walk."""
    return _service_schema().validate_settings(data)


def _checked_service_settings() -> dict:
    data = _service_settings()
    try:
        return _validate_service_settings(data)
    except ValueError as exc:
        _refuse(6, "service_settings_invalid", str(exc),
                f"fix it with `{NAME} settings`; unsupported keys are never ignored")


def _settings_merged(scope: str, document: dict) -> dict | None:
    """The settings the service would load once `document` is written at
    `scope`: the project's over the global one, key by key. None outside a
    project, where there is nothing to merge it into."""
    if _project_root() is None:
        return None
    other = "global" if scope == "project" else "project"
    try:
        held = {key: row["value"] for key, row in
                _records().resolve_scope(NAME, "setting", other).items()
                if key != "connection.default"}
    except StoreError as exc:
        return {"__error__": exc.message}
    return {**held, **document} if scope == "project" else {**document, **held}


def _settings_check(scope: str, document: dict) -> list:
    """What the assistant service's schema finds wrong with this project's
    settings once the contract's `settings` verb writes `document` at `scope`."""
    if scope not in ("project", "global"):
        return []
    merged = _settings_merged(scope, document)
    if merged is None:
        merged = dict(document)
    if "__error__" in merged:
        return [merged["__error__"]]
    try:
        _validate_service_settings(merged)
    except ValueError as exc:
        return [str(exc)]
    return []


def _service_cfg(settings: dict, connection_flag: str | None) -> dict:
    """The connection the service runs: the flag, else the settings' own, else
    the registry's default."""
    wanted = connection_flag or (settings or {}).get("connection") or None
    reg, _ = _connections_registry()
    cid, entry = _select_connection(reg, wanted)
    cfg, problem = _build_cfg(cid, entry)
    if problem:
        _refuse(problem["exit"], problem["code"], problem["message"],
                problem.get("hint"))
    return cfg


def _service_write_refusal(cfg: dict) -> str | None:
    """Why the service may not post to Slack on this connection, or None. The
    same two closures every write verb meets: the process's read-only switch
    and the connection's own grant. Nothing here lifts either."""
    if read_only_switch():
        return "read_only_switch"
    if not cfg.get("allow_write"):
        return "read_only"
    return None


def _record_service_post(db: _Store, channel_id: str, message: dict) -> None:
    """A post the service made, recorded as the capture records a sent
    message, and marked as the service's own."""
    with _writing(db):
        _record_sent(db, channel_id, message)
        db.execute("UPDATE slacker_messages SET sent_by_service = true"
                   " WHERE account = %s AND channel_id = %s AND ts = %s",
                   (db.account, channel_id, message.get("ts")))


def _runner_importable() -> bool:
    try:
        import callva.harness_runner  # noqa: F401
    except ImportError:
        return False
    return True


def _service_module_pin() -> str:
    """The runner pin, read from the profiles script's own header, so the
    listener and the script cannot run different runners."""
    text = (_service_bundle_dir() / "service" / "profiles.py").read_text()
    found = re.search(r'"(callva-harness-runner==[^"]+)"', text)
    return found.group(1) if found else "callva-harness-runner"


def _rerun_with_runner(argv: list[str]) -> NoReturn:
    """Run this CLI again on `argv` with the harness runner beside its own
    dependencies."""
    import shutil
    if os.environ.get(SERVICE_RUNNER_EXEC_ENV):
        _refuse(5, "harness_library_missing",
                "this was started with the harness runner and still cannot "
                "import it", f"check that uv can resolve {_service_module_pin()}")
    uv = shutil.which("uv")
    if uv is None:
        _refuse(5, "harness_library_missing",
                "the assistant runs on callva-harness-runner, and uv is not on "
                "PATH to resolve it",
                "put uv on PATH, where the CLI's own shebang finds it")
    env = dict(os.environ)
    env[SERVICE_RUNNER_EXEC_ENV] = "1"
    command = [uv, "run", "--quiet", "--with", _service_module_pin(), "--script",
               str(Path(__file__).resolve()), *argv]
    sys.stdout.flush()
    sys.stderr.flush()
    os.execvpe(uv, command, env)


def _service_project_id(root: Path) -> str:
    """The id the register keys this agent's rows by."""
    state = _project_id_state_at(root)
    project_id = (state or {}).get("id")
    if not project_id:
        _refuse(6, "project_id_missing",
                "the assistant keys what it answered by the project's id, and this "
                "project declares none",
                "run `capabilities init` so the project's id is recorded")
    return str(project_id)


def _stored_prompt(db, agent_id: str, key: str):
    """The agent's active version of one prompt, read from the store now."""
    return db.execute(
        "SELECT id::text AS id, key, body, created_at, created_by, note"
        " FROM slacker_prompts WHERE agent_id = %s AND key = %s AND active",
        (agent_id, key)).fetchone()


def _prompt(db, agent_id: str | None, key: str) -> dict:
    """One prompt as the next turn reads it: {key, body, source, ...}, the
    source `store` (with its version) or `bundle`."""
    row = _stored_prompt(db, agent_id, key) if agent_id else None
    if row is not None:
        return {"key": key, "body": row["body"], "source": "store", "version": row["id"],
                "created_at": row["created_at"], "created_by": row["created_by"]}
    template = _service_template(f"{key}.md")
    if template.is_file():
        return {"key": key, "body": template.read_text(), "source": "bundle"}
    return {"key": key, "body": "", "source": "none"}


def _save_prompt(db, agent_id: str, key: str, body: str, by: str, *,
                 base: str | None = None, note: str | None = None) -> dict:
    """Add a version and make it active, clearing the one it replaces, in one
    transaction. `base`, where given, must name the active version (its id or
    six or more of its first characters), else exit 6 base_mismatch."""
    with _writing(db):
        found = db.execute(
            "SELECT id::text AS id FROM slacker_prompts WHERE agent_id = %s AND key = %s"
            " AND active FOR UPDATE", (agent_id, key)).fetchone()
        current = found["id"] if found else None
        if base is not None and not (current and len(base) >= 6
                                     and current.startswith(base.lower())):
            _refuse(6, "base_mismatch",
                    f"the active version of {key!r} is {current}, not {base!r}",
                    f"`{NAME} prompts show {key}` reads the active version")
        if current:
            db.execute("UPDATE slacker_prompts SET active = false WHERE id = %s",
                       (current,))
        row = db.execute(
            "INSERT INTO slacker_prompts (agent_id, key, body, created_by, note)"
            " VALUES (%s, %s, %s, %s, %s) RETURNING id::text AS id, created_at",
            (agent_id, key, body, by, note)).fetchone()
    return {"key": key, "version": row["id"], "replaced": current,
            "created_at": row["created_at"]}


def _project_store() -> tuple[Path, str, _Store]:
    """The project, its id, and its store with the slacker tables migrated,
    for the verbs whose rows are the agent's rather than an account's."""
    root = _project_root()
    if root is None:
        _refuse(6, "no_project", "not inside a project",
                f"run `{NAME}` from the project whose assistant it is")
    agent_id = _service_project_id(root)
    setting = _store_setting(root)
    try:
        conn = connect(application_name=NAME, setting=setting, transaction=True)
    except DbError as exc:
        _store_refusal(exc)
    try:
        migrate(conn, NAME, STORE_STEPS, major=STORE_SCHEMA_MAJOR,
                minor=STORE_SCHEMA_MINOR)
        conn.autocommit = True
    except DbError as exc:
        conn.close()
        _store_refusal(exc)
    return root, agent_id, _Store(conn, "", setting)


def cmd_prompts(args) -> dict:
    """The service's prompts: the agent's own text over the bundle's standard."""
    action = args.prompts_command
    if action in ("put", "retire"):
        _read_only_gate(f"`{NAME} prompts {action}`")
    if action != "list" and args.key not in SERVICE_DOCUMENTS:
        _refuse(6, "invalid_arguments", f"no prompt {args.key!r}",
                f"the prompts are {', '.join(SERVICE_DOCUMENTS)}")
    root, agent_id, db = _project_store()
    try:
        if action == "list":
            rows = []
            for key in SERVICE_DOCUMENTS:
                prompt = _prompt(db, agent_id, key)
                rows.append({k: v for k, v in prompt.items() if k != "body"}
                            | {"chars": len(prompt["body"])})
            return {"project": str(root), "agent_id": agent_id, "prompts": rows}
        key = args.key
        if action == "show":
            return _prompt(db, agent_id, key)
        if action == "history":
            rows = db.execute(
                "SELECT id::text AS id, active, length(body) AS chars, created_at,"
                " created_by, note FROM slacker_prompts WHERE agent_id = %s AND key = %s"
                " ORDER BY created_at DESC", (agent_id, key)).fetchall()
            return {"key": key, "versions": [dict(zip(row.keys(), row)) for row in rows]}
        if action == "retire":
            with _writing(db):
                row = db.execute(
                    "UPDATE slacker_prompts SET active = false WHERE agent_id = %s"
                    " AND key = %s AND active RETURNING id::text AS id",
                    (agent_id, key)).fetchone()
            return {"key": key, "retired": row["id"] if row else None,
                    "now": _prompt(db, agent_id, key)["source"]}
        body = sys.stdin.read()
        if not body.strip():
            _refuse(6, "empty_prompt", "the prompt on stdin is empty",
                    f"`{NAME} prompts retire {key}` leaves the key to the bundle's "
                    "standard text")
        user = os.environ.get("USER") or os.environ.get("LOGNAME") or "unknown"
        return _save_prompt(db, agent_id, key, body, f"{user}@{node_name()}",
                            base=args.base, note=args.note)
    finally:
        db.close()


# --- Audio --------------------------------------------------------------------
#
# An audio clip's words reach a turn from Slack's own transcript of the clip
# where Slack made one, else from Deepgram, with the key the credential cascade
# resolves for DEEPGRAM_API_KEY. The clip is read the way the web client reads
# it, over the session.

DEEPGRAM_MODEL = "nova-3"
AUDIO_LIMIT = 50 * 1024 * 1024     # the largest clip sent for transcription
AUDIO_TIMEOUT = 120                # one transcription, per attempt


def _slack_file_bytes(cfg: dict, url: str) -> bytes:
    import urllib.request
    request = urllib.request.Request(url, headers={
        "Authorization": f"Bearer {cfg['token']}", "Cookie": f"d={cfg['cookie']}"})
    with urllib.request.urlopen(request, timeout=AUDIO_TIMEOUT) as resp:
        ctype = str(resp.headers.get("Content-Type") or "")
        data = resp.read(AUDIO_LIMIT + 1)
    if len(data) > AUDIO_LIMIT:
        raise ValueError("the clip is larger than the service transcribes")
    if ctype.startswith("text/html"):
        raise ValueError("Slack answered the download with a page, not the clip")
    return data


def _deepgram_bytes(data: bytes, mimetype: str | None, key: str) -> str:
    import urllib.request
    url = ("https://api.deepgram.com/v1/listen?" f"model={DEEPGRAM_MODEL}"
           "&detect_language=true&smart_format=true&punctuate=true&paragraphs=true")
    request = urllib.request.Request(url, data=data, method="POST", headers={
        "Authorization": f"Token {key}",
        "Content-Type": mimetype or "application/octet-stream"})
    with urllib.request.urlopen(request, timeout=AUDIO_TIMEOUT) as resp:
        answer = json.loads(resp.read().decode("utf-8"))
    channels = (answer.get("results") or {}).get("channels") or []
    if not channels:
        return ""
    alt = (channels[0].get("alternatives") or [{}])[0]
    return ((alt.get("paragraphs") or {}).get("transcript")
            or alt.get("transcript") or "").strip()


def _transcribe_message(client: "SlackClient", cfg: dict, db: _Store, channel_id: str,
                        ts: str, files: list[dict]) -> dict:
    """The words of one message's audio clips, written beside the message.
    Answers {"ok": True, "text", "provider"} or {"ok": False, "error"}; a
    failure is recorded and not tried again, and a transcript already stored
    is answered without paying again."""
    row = db.execute(
        "SELECT transcript FROM slacker_messages WHERE account = %s AND channel_id = %s"
        " AND ts = %s", (db.account, channel_id, ts)).fetchone()
    if row and row["transcript"]:
        return {"ok": True, "text": row["transcript"], "provider": "store"}
    texts, errors, providers = [], [], []
    for item in files:
        transcription = item.get("transcription") or {}
        preview = transcription.get("preview") or {}
        if transcription.get("status") == "complete" and preview.get("content") \
                and not preview.get("has_more"):
            texts.append(str(preview["content"]).strip())
            providers.append("slack")
            continue
        key, _tier, _source = _resolve_env_key("DEEPGRAM_API_KEY")
        if not key:
            errors.append("no Deepgram key; DEEPGRAM_API_KEY is not set")
            continue
        url = item.get("url_private_download") or item.get("url_private")
        if not url:
            errors.append("the clip carries no download link")
            continue
        try:
            text = _deepgram_bytes(_slack_file_bytes(cfg, url), item.get("mimetype"), key)
        except Exception as exc:
            errors.append(f"{type(exc).__name__}: {exc}"[:300])
            continue
        if text:
            texts.append(text)
            providers.append("deepgram")
        else:
            errors.append("no speech was recognised")
    text = "\n".join(t for t in texts if t)
    error = None if text else ("; ".join(errors) or "no speech was recognised")
    with _writing(db):
        db.execute("UPDATE slacker_messages SET transcript = %s, transcript_error = %s"
                   " WHERE account = %s AND channel_id = %s AND ts = %s",
                   (text or None, error, db.account, channel_id, ts))
    if not text:
        return {"ok": False, "error": error}
    return {"ok": True, "text": text, "provider": ",".join(sorted(set(providers)))}


# --- Jobs ----------------------------------------------------------------------

JOBS_HELP = """slacker jobs — the register of work that outlives a conversation

  jobs list [--state S] [--outcome O] [--limit N]   jobs in this project, newest first
  jobs active [--limit N]                           only what is waiting or running
  jobs show <id>                                    one job, staged amendments included
  jobs register "<one-line outcome>"                write a draft; nothing runs it yet
  jobs submit <id> --confirm-active-jobs-checked    hand a draft to the runner
  jobs amend <id> "<what changed>"                  continue a job with added context
  jobs discard <id>                                 drop a draft nobody will submit
  jobs stop <id>                                    stop the work; it keeps its session
  jobs resume <id>                                  continue a stopped job

A job runs in arrival order within defaults.max_parallel_jobs, on the profile
named by defaults.job_profile, and answers into the conversation it was
registered from, in the thread its request was answered in. States: draft,
waiting, running, stopped; a stopped job's outcome is succeeded, failed,
cancelled, interrupted, quota or model_refused. Outside a worker, --chat narrows
to one conversation and register takes --chat, --thread and --requested-by."""


def _jobs_environment(settings: dict) -> str:
    """The environment a job is filed under: the one the listener runs, which
    it hands its workers, else the settings' own."""
    return (os.environ.get("SLACKER_ENVIRONMENT", "").strip()
            or settings.get("environment") or "production")


def _job_scope(args) -> None:
    """Hold a worker the service started to the conversation, requester and
    origin it was started for. A terminal call is a maintainer's and stays
    unscoped."""
    if not os.environ.get("SLACKER_DAEMON_CHILD", "").strip():
        return
    chat = os.environ.get("SLACKER_AUTHORIZED_CHAT_ID", "").strip()
    actor = os.environ.get("SLACKER_AUTHORIZED_REQUESTER", "").strip()
    if not chat or not actor:
        _refuse(4, "job_scope_missing",
                "a worker the Slack service started reached the job register "
                "without the conversation and requester it acts for",
                "the service hands its workers SLACKER_AUTHORIZED_CHAT_ID and "
                "SLACKER_AUTHORIZED_REQUESTER")
    for name, given, wanted in (("conversation", args.chat, chat),
                                ("actor", args.actor, actor)):
        if given and str(given) != wanted:
            _refuse(4, "job_scope_denied",
                    f"a worker's job {name} differs from the one its turn was started for")
    args.chat, args.actor = chat, actor
    if args.jobs_command == "register":
        thread = os.environ.get("SLACKER_AUTHORIZED_THREAD_TS", "").strip()
        origin = os.environ.get("SLACKER_AUTHORIZED_ORIGIN_MESSAGE_ID", "").strip()
        profile = os.environ.get("SLACKER_AUTHORIZED_JOB_PROFILE", "").strip()
        for name, given, wanted in (("requester", args.requested_by, actor),
                                    ("thread", args.thread, thread),
                                    ("origin message", args.origin_message_id, origin),
                                    ("profile", args.profile, profile)):
            if given and wanted and str(given) != wanted:
                _refuse(4, "job_scope_denied",
                        f"a worker's job {name} differs from the one its turn was "
                        "started for")
        args.requested_by = actor
        args.thread = thread or None
        args.origin_message_id = origin or None
        args.profile = profile or args.profile


def _open_jobs(args):
    """The project's job register on this account, and the module it lives in."""
    root = _project_root()
    if root is None:
        _refuse(6, "no_project", "not inside a project",
                f"run `{NAME} jobs` from the project whose assistant it is")
    settings = _service_settings()
    connection = (os.environ.get("SLACKER_AUTHORIZED_CONNECTION", "").strip()
                  if os.environ.get("SLACKER_DAEMON_CHILD") else None) or args.connection
    cfg = _service_cfg(settings, connection)
    project_id = _service_project_id(root)
    module = _service_module("jobs")
    db = _open_store(cfg)
    return module, module.JobRegister(_CliFacade(), db, project_id,
                                      _jobs_environment(settings)), settings


def _job_row(row: dict) -> dict:
    out = {k: v for k, v in row.items()
           if k not in ("attempt_token", "lease_owner", "agent_id")}
    out["stopping"] = bool(out.pop("stop_requested", False))
    return out


def _require_job(register, job_id: str, chat: str | None, actor: str | None) -> dict:
    row = register.get(job_id, actor_id=actor)
    if row is None:
        _refuse(2, "job_not_found", f"no job {job_id} in this project's register",
                f"run `{NAME} jobs list` to see the ids")
    if chat and row["chat_id"] != chat:
        _refuse(4, "job_scope_denied", f"job {job_id} belongs to conversation "
                f"{row['chat_id']}, not {chat}")
    return row


def cmd_jobs(args):
    action = args.jobs_command
    if action == "help":
        sys.stdout.write(JOBS_HELP + "\n")
        return None
    _job_scope(args)
    chat = args.chat
    actor = args.actor
    module, register, settings = _open_jobs(args)
    try:
        if action in ("list", "active"):
            if action == "active":
                rows = register.open_jobs(chat, actor_id=actor)[:args.limit]
            else:
                rows = register.list(limit=args.limit, state=args.state,
                                     outcome=args.outcome, chat_id=chat, actor_id=actor)
            return {"environment": register.environment, "account": register.account,
                    "chat_id": chat, "counts": register.counts(actor_id=actor),
                    "slots_in_use": register.slots_in_use(),
                    "jobs": [_job_row(r) for r in rows]}
        if action == "register":
            if not chat:
                _refuse(6, "no_chat", "a job needs the conversation it reports into",
                        "pass --chat <conversation id>")
            if not args.requested_by:
                _refuse(6, "no_requester", "a job needs the person whose authority "
                        "it carries", "pass --requested-by <Slack user id>")
            profile = (args.profile or (settings.get("defaults") or {}).get("job_profile")
                       or _service_module("profiles").DEFAULT_JOB_PROFILE)
            row = register.register(chat_id=chat, requested_by=args.requested_by,
                                    description=args.description,
                                    origin_message_id=args.origin_message_id,
                                    profile=profile, thread_ts=args.thread)
            out = _job_row(row)
            out["next"] = (f"submit it with `{NAME} jobs submit {row['id']} "
                           "--confirm-active-jobs-checked` once its outcome line says "
                           "what will be delivered")
            return out
        row = _require_job(register, args.id, chat, actor)
        if action == "show":
            out = _job_row(row)
            out["pending_amendment"] = register.pending_amendment(args.id)
            return out
        if action == "submit":
            if not args.confirm_active_jobs_checked:
                _refuse(6, "active_jobs_unconfirmed",
                        "submitting needs confirmation that the active jobs were read",
                        f"read `{NAME} jobs active`, and if this outcome is not already "
                        "among them pass --confirm-active-jobs-checked")
            return _job_row(register.submit(args.id, actor_id=actor))
        if action == "amend":
            register.stage_amendment(args.id, args.text, actor_id=actor)
            register.amend(args.id, actor_id=actor)
            return {"id": args.id, "amendment": "staged",
                    "pending_amendment": register.pending_amendment(args.id),
                    "instruction": "Say the correction is folded into the job that "
                                   "already exists. Do not register a new one."}
        if action == "discard":
            if row["state"] != module.DRAFT:
                _refuse(6, "job_not_a_draft", f"job {args.id} is {row['state']}, not a "
                        "draft", f"work that has started is stopped with `{NAME} jobs "
                        "stop` and stays continuable")
            register.discard(args.id, actor_id=actor)
            return {"id": args.id, "discarded": True, "description": row["description"]}
        if action == "stop":
            if register.request_stop(args.id, actor_id=actor) is None:
                _refuse(6, "job_not_running", f"job {args.id} is {row['state']}, so "
                        "there is nothing to stop", f"`{NAME} jobs resume` continues a "
                        "stopped job")
            return {"id": args.id, "stopping": True,
                    "instruction": "The listener ends the work on its next look at the "
                                   "register. The job keeps its session and its place."}
        if action == "resume":
            return _job_row(register.resume(args.id, actor_id=actor))
    except module.JobError as exc:
        _refuse(6, exc.slug, exc.message, exc.hint)
    finally:
        register.db.close()
    return None


# --- The listener ----------------------------------------------------------------


def _self_dm(db: _Store, client: "SlackClient", user_id: str | None) -> str | None:
    """The account's own direct message with itself, read from Slack's list
    of the account's direct messages."""
    if not user_id:
        return None
    with contextlib.suppress(_Refusal):
        for conv in client.conversations(types="im", limit=1000):
            _upsert_conversation(db, conv)
            if conv.get("user") == user_id:
                return conv.get("id")
    row = db.execute(
        "SELECT id FROM slacker_conversations WHERE account = %s AND kind = 'im'"
        " AND user_id = %s LIMIT 1", (db.account, user_id)).fetchone()
    return row["id"] if row else None


def _build_dialogue(cfg: dict, root: Path, settings: dict, home: Path,
                    identity: dict, *, log=None):
    """The listener's dialogue, its profiles resolved and fitted, and its job
    runner. Needs the runner in this process."""
    if not _runner_importable():
        raise ValueError("the assistant needs callva-harness-runner in the "
                         "listener; restart the service to enable it")
    project_id = _service_project_id(root)
    db = _open_store(cfg)
    dialogue = _service_module("dialogue").Dialogue(
        _CliFacade(), cfg=cfg, root=root, settings=settings, project_id=project_id,
        db=db, state_dir=home, profiles=_service_module("profiles"),
        client=SlackClient(cfg), identity=identity, log=log)
    try:
        dialogue.prepare()
    except ValueError:
        db.close()
        raise
    # The job runner has a store connection of its own: a job's claim waits
    # on rows another listener holds, and the capture must never wait with it.
    dialogue.jobs = _service_module("jobs").JobRunner(
        _CliFacade(), dialogue=dialogue, db=_open_store(cfg))
    return dialogue


class _Capture:
    """The listener's state for one account: the store, the Slack client, the
    control files, and the backoff that closes a reconnect's gap through the
    sync cursor, so a drop doubles nothing and loses no channel message; a
    thread reply posted during the drop is not in Slack's channel history and
    is read with `thread --fresh`. Where its settings admit anyone it also
    runs the assistant's dialogue and job runner, and offers the dialogue
    every message it captures live."""

    def __init__(self, cfg: dict, settings: dict | None = None,
                 root: Path | None = None):
        self.cfg = cfg
        self.settings = settings or {}
        self.root = root
        self.home = _service_home(cfg)
        self.db: _Store | None = None
        self.client: SlackClient | None = None
        self.ws = None
        self.stop = threading.Event()
        self.events = 0
        self.last_event_at: str | None = None
        self.state = "starting"
        self.dialogue = None
        self.identity: dict = {}
        self.health_lock = threading.Lock()
        self.reload_lock = threading.Lock()
        self.reloads = 0
        self.reload_error: str | None = None
        self.reloaded_at: str | None = None
        self.records_read_at = time.monotonic()

    def health(self, state: str, extra: dict | None = None) -> None:
        with self.health_lock:
            self.state = state
            payload = {"state": state, "pid": os.getpid(), "at": _iso_now(),
                       "events": self.events, "last_event_at": self.last_event_at,
                       "settings_reload_attempts": self.reloads,
                       "settings_reload_error": self.reload_error,
                       "settings_reloaded_at": self.reloaded_at,
                       "allow_write": bool(self.cfg.get("allow_write"))}
            if self.dialogue is not None:
                with contextlib.suppress(Exception):
                    payload["dialogue"] = self.dialogue.summary()
            payload.update(extra or {})
            _service_write(self.home, "health.json", payload)

    def _backfill(self) -> None:
        """Close any gap since the last covered ts on every member channel.
        Dedup is the store's, so a message already captured live is not doubled."""
        assert self.db and self.client
        for conv in self.client.conversations(
                types="im,mpim,public_channel,private_channel", limit=1000):
            _upsert_conversation(self.db, conv)
        for channel in _member_channels(self.db):
            try:
                _sync_channel(self.db, self.client, channel, full=False, limit=500)
            except _Refusal as refusal:
                _log(f"backfill of {channel} deferred: {refusal.message}")

    def _ws_url(self) -> str:
        """The session's realtime gateway. The web client dials
        wss-primary.slack.com with the session token, and the socket carries the
        `d` cookie (`_ws_header`) and the web client's origin; the live trial
        found the gateway refuses the session without them, and refuses a
        gateway_server naming the team id."""
        token = self.cfg["token"]
        return (f"wss://wss-primary.slack.com/?token={token}"
                f"&slack_client=desktop&batch_presence_aware=1")

    def _ws_header(self) -> list[str]:
        return [f"Cookie: d={self.cfg['cookie']}"]

    def _on_message(self, _ws, raw: str) -> None:
        try:
            event = json.loads(raw)
        except ValueError:
            return
        change = _handle_event(self.db, event)
        if change:
            self.events += 1
            self.last_event_at = _iso_now()
            if self.dialogue is not None and event.get("type") == "message" \
                    and change.get("change") in ("message", "message_update"):
                self.dialogue.offer(event)
            self.health(self.state)

    # -- the assistant --------------------------------------------------------

    def _start_dialogue(self) -> None:
        """Start the dialogue and its job runner for settings that admit
        anyone. Raises ValueError, naming why, when it cannot."""
        if self.root is None:
            raise ValueError("the assistant answers for a project, and the service "
                             "was started outside one")
        if self.dialogue is None:
            self.identity["self_dm"] = _self_dm(self.db, self.client,
                                                self.identity.get("user_id"))
            self.dialogue = _build_dialogue(self.cfg, self.root, self.settings,
                                            self.home, self.identity, log=_log)
            self.dialogue.start()
            self.dialogue.jobs.start()
            refusal = _service_write_refusal(self.cfg)
            _log("assistant: started for " + ", ".join(
                f"{k}={v}" for k, v in (("user", self.identity.get("user_id")),
                                        ("self_dm", self.identity.get("self_dm")))))
            if refusal:
                _log(f"assistant: connection {self.cfg.get('id')!r} does not grant "
                     f"writes ({refusal}); it answers nothing until a person grants "
                     "them")

    def _refresh_grant(self) -> None:
        """Read the connection's write grant again, so a grant a person gave
        or took back is the one the next post meets."""
        reg, _ = _connections_registry()
        entry = (reg.get("connections") or {}).get(self.cfg["id"])
        if entry is not None:
            self.cfg["allow_write"] = bool(entry.get("allow_write", WRITE_DEFAULT))

    def reload(self) -> None:
        """Re-read the settings and the write grant, validate them, fit their
        profiles, and take them; a refused reload leaves the previous ones in
        force. Answers through health, which `service reload` reads."""
        with self.reload_lock:
            # The records answer from a cache for STORE_READ_SECONDS after a
            # read; a reload waits that out since its last read, so it reads
            # what was written before it was asked for.
            wait = STORE_READ_SECONDS - (time.monotonic() - self.records_read_at)
            if wait > 0:
                time.sleep(wait)
            error = None
            try:
                settings = _validate_service_settings(_service_settings())
                self._refresh_grant()
                configured = _service_schema().dialogue_configured(settings)
                if self.dialogue is not None:
                    self.dialogue.update_settings(settings)
                    self.settings = settings
                elif configured:
                    previous, self.settings = self.settings, settings
                    try:
                        self._start_dialogue()
                    except BaseException:
                        self.settings = previous
                        raise
                else:
                    self.settings = settings
            except _Refusal as refusal:
                error = f"{refusal.code}: {refusal.message}"
            except SystemExit:
                error = "the settings or the connection could not be read"
            except Exception as exc:
                error = str(exc) or type(exc).__name__
            self.records_read_at = time.monotonic()
            self.reloads += 1
            self.reload_error = error
            self.reloaded_at = _iso_now()
            _log(f"settings reload refused, the previous settings remain: {error}"
                 if error else "settings reloaded")
            self.health(self.state)

    def _end(self, *_args) -> None:
        self.stop.set()
        with contextlib.suppress(Exception):
            if self.ws is not None:
                self.ws.close()

    def run(self) -> int:
        """Foreground capture with reconnect/backoff. Returns the process exit
        code. SIGTERM ends it cleanly; SIGHUP reloads the settings."""
        try:
            import websocket  # noqa: F401  (websocket-client)
        except ImportError:
            _refuse(6, "driver_missing",
                    "the websocket client library websocket-client is not installed",
                    f"run {NAME} through its own script header, which pins it")
        self.db = _open_store(self.cfg)
        self.client = SlackClient(self.cfg)
        ident = _identity(self.cfg, self.client, self.db)
        self.identity = {"user_id": ident.get("user_id"), "user": ident.get("user")}
        signal.signal(signal.SIGTERM, self._end)
        signal.signal(signal.SIGINT, self._end)
        signal.signal(signal.SIGHUP, lambda *_: threading.Thread(
            target=self.reload, name="reload", daemon=True).start())
        if _service_schema().dialogue_configured(self.settings):
            try:
                self._start_dialogue()
            except ValueError as exc:
                self.db.close()
                _refuse(6, "service_dialogue_invalid", str(exc),
                        f"`{NAME} service doctor` names what the settings reach")
        backoff = 2.0
        self.health("starting")
        try:
            while not self.stop.is_set():
                try:
                    self._backfill()
                    self.health("connecting")
                    # Only a connection that held resets the backoff: a refused
                    # handshake or a socket closed at once keeps doubling it.
                    if self._listen() >= _CAPTURE_STEADY_SECONDS:
                        backoff = 2.0
                except _Refusal as refusal:
                    if refusal.exit_code == 2:
                        self.health("unlinked", {"error": refusal.message})
                        _log(f"session no longer valid: {refusal.message}")
                        return 7
                    _log(f"capture error: {refusal.message}")
                except Exception as exc:   # a dropped socket, a transient fault
                    _log(f"capture connection lost: {type(exc).__name__}: {exc}")
                if self.stop.is_set():
                    break
                self.health("reconnecting", {"backoff": backoff})
                self.stop.wait(backoff)
                backoff = min(backoff * 2, 60.0)
            return 0
        finally:
            if self.dialogue is not None:
                with contextlib.suppress(Exception):
                    self.dialogue.shutdown(5.0)
                with contextlib.suppress(Exception):
                    self.dialogue.jobs.shutdown(10.0)
            if self.state != "unlinked":
                self.health("stopped")
            self.db.close()

    def _listen(self) -> float:
        """Hold the realtime socket until it closes or fails, and return the
        seconds it was connected, 0 when the handshake failed. The gateway can
        accept the socket and then refuse the session with an error frame, so
        the connection counts from its first other frame (normally `hello`),
        not from the socket opening. A failure is logged by its kind and HTTP
        status or the gateway's error code, never its text, which can carry the
        request."""
        import websocket
        opened: list[float] = []
        errors: list[str] = []

        def on_error(_ws, exc) -> None:
            status = getattr(exc, "status_code", None)
            errors.append(type(exc).__name__
                          + (f" (HTTP {status})" if status else ""))

        def on_message(ws, raw: str) -> None:
            with contextlib.suppress(ValueError, AttributeError):
                frame = json.loads(raw)
                if frame.get("type") == "error":
                    error = frame.get("error")
                    error = error if isinstance(error, dict) else {"msg": error}
                    code = re.sub(r"[^A-Za-z0-9_.-]", "", str(error.get("msg") or ""))
                    status = re.sub(r"[^0-9]", "", str(error.get("code") or ""))
                    errors.append(f"gateway error {code or 'unknown'}"
                                  + (f" ({status})" if status else ""))
                    ws.close()
                    return
            if not opened and not errors:
                opened.append(time.monotonic())
                self.health("connected")
            self._on_message(ws, raw)

        self.ws = websocket.WebSocketApp(
            self._ws_url(), header=self._ws_header(), on_message=on_message,
            on_error=on_error)
        if self.stop.is_set():
            return 0.0
        # run_forever returns on close or error; the outer loop reconnects.
        # The origin goes through websocket-client's own option: an Origin in
        # the header list would be sent beside the one the library adds.
        self.ws.run_forever(ping_interval=20, ping_timeout=10,
                            origin=_WEB_ORIGIN)
        reason = errors[-1] if errors else "no error reported"
        if not opened:
            _log(f"realtime handshake failed: {reason}")
            return 0.0
        held = time.monotonic() - opened[0]
        _log(f"realtime connection closed after {held:.0f}s: {reason}")
        return held


def _inventory(network: bool) -> dict:
    """What this capability holds on this machine, read from local state only:
    the linked accounts (one state home each) and the capture service's last
    health, each account named by its connection's label. Secret-free and no
    network; the per-account message counts the store holds are deferred,
    since they need a project's database and a connection the inventory does
    not resolve."""
    root = _STATE_HOME / NAME
    accounts = sorted(p.name for p in root.iterdir()) if root.is_dir() else []
    # A home is kept under the connection's id; a person reads its label. The
    # read never dies: with no store to answer, the folder's own name stands.
    labels = {cid: entry.get("label") or cid for cid, entry
              in (_inventory_connections().get("connections") or {}).items()}
    service_state = "stopped"
    for name in accounts:
        health = _service_read(root / name / "service", "health.json")
        if health and health.get("state"):
            service_state = health["state"]
            break
    return {
        "metrics": [{"label": "linked accounts", "value": len(accounts)}],
        "items": [{"name": labels.get(a) or a, "kind": "linked_account"} for a in accounts],
        "service": {"state": service_state},
        "deferred": [{"label": "captured message counts",
                      "reason": "needs a project database and a connection; "
                                "read with `slacker history` or `sync`"}],
    }


def _listener_pid(home: Path) -> int | None:
    """The pid of the listener that last wrote health here, when it is still a
    running `service run`."""
    health = _service_read(home, "health.json") or {}
    pid = health.get("pid")
    if not isinstance(pid, int) or health.get("state") in ("stopped", "unlinked"):
        return None
    try:
        os.kill(pid, 0)
    except (ProcessLookupError, PermissionError):
        return None
    with contextlib.suppress(OSError):
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ")
        if b"service" not in cmdline or b"run" not in cmdline:
            return None
    return pid


def _cmd_service_init(cfg: dict, home: Path, force: bool) -> dict:
    """Seed the service's settings from the bundle's template where none are
    written yet (or with --force), and its control files."""
    _service_write(home, "owner.json", {"connection": cfg["id"], "at": _iso_now()})
    existing = _service_settings()
    out = {"ok": True, "initialized": str(home)}
    if existing and not force:
        out["settings"] = "kept"
        return out
    settings = json.loads(_service_template().read_text())
    settings["connection"] = cfg["id"]
    _validate_service_settings(settings)
    adapter = _records()
    try:
        for key in set(existing) - set(settings):
            adapter.delete(NAME, "setting", key)
        for key, value in settings.items():
            adapter.set(NAME, "setting", key, value, actor=f"{NAME} service init")
    except StoreError as exc:
        _refuse(6, exc.slug, exc.message, exc.hint)
    out["settings"] = "seeded"
    out["next"] = [f"name who may wake the assistant with `{NAME} settings`, then "
                   f"`{NAME} service doctor`"]
    return out


def _cmd_service_doctor(cfg: dict, home: Path, settings: dict) -> dict:
    """Prove the store opens and the session authorises, and say what the
    assistant's settings reach: whether they admit anyone, whether the
    connection grants the writes an answer needs, the profiles they name, and
    where each prompt comes from."""
    db = _open_store(cfg)
    try:
        client = SlackClient(cfg)
        ident = _identity(cfg, client, db)
        out = {"ok": True, "connection": cfg["id"], "store_opened": True,
               "user": ident["user"], "team": ident["team"],
               "health": _service_read(home, "health.json")}
        configured = _service_schema().dialogue_configured(settings)
        assistant = {"configured": configured}
        if configured:
            refusal = _service_write_refusal(cfg)
            assistant["writes"] = "granted" if refusal is None else refusal
            if refusal:
                assistant["warning"] = (
                    f"connection {cfg['id']!r} does not grant writes, so the assistant "
                    "answers nothing; a person grants them with `capabilities set "
                    f"{NAME} grant {cfg['id']} '{{\"allow_write\": true}}'`")
            root = _project_root()
            if root is None:
                out["ok"] = False
                assistant["error"] = "the assistant answers for a project; run it in one"
            else:
                agent_id = _service_project_id(root)
                assistant["prompts"] = [{k: v for k, v in _prompt(db, agent_id, k2).items()
                                         if k != "body"}
                                        for k2 in SERVICE_DOCUMENTS]
                names = list(_service_schema().profile_names(
                    settings, "slacker-claude", "slacker-job-claude"))
                if _runner_importable():
                    profiles = _service_module("profiles")
                    rows = profiles.check(names, profiles.stored(
                        db.conn, agent_id, db.schema), agent_id)
                    assistant["profiles"] = rows
                    if not all(r.get("ok") for r in rows):
                        out["ok"] = False
                else:
                    assistant["profiles"] = [{"name": n, "checked": False} for n in names]
                    assistant["profiles_note"] = (
                        "the harness runner is not in this process; `service run` "
                        "resolves and fits every profile when it starts")
            voice = _service_schema().voice_scopes(settings)
            if voice and not _resolve_env_key("DEEPGRAM_API_KEY")[0]:
                assistant["voice_warning"] = (
                    "no Deepgram key: an audio clip Slack carries no transcript for "
                    "is answered as untranscribed in " + ", ".join(voice))
        out["assistant"] = assistant
        return out
    finally:
        db.close()


def _cmd_service_reload(cfg: dict, home: Path, timeout: float = 10.0) -> dict:
    """Validate first, then ask the running listener to re-read. The signal goes
    to the listener alone. A refused reload leaves its previous settings."""
    pid = _listener_pid(home)
    if pid is None:
        _refuse(5, "service_not_running",
                f"the {NAME} service is not running for connection {cfg['id']!r}",
                f"run `{NAME} service run`")
    before = _service_read(home, "health.json") or {}
    attempts = int(before.get("settings_reload_attempts") or 0)
    try:
        os.kill(pid, signal.SIGHUP)
    except ProcessLookupError:
        _refuse(5, "service_not_running", "the service exited before the reload")
    deadline = time.monotonic() + max(0.0, timeout)
    while time.monotonic() < deadline:
        health = _service_read(home, "health.json") or {}
        if int(health.get("settings_reload_attempts") or 0) > attempts:
            if health.get("settings_reload_error"):
                _refuse(6, "service_reload_refused",
                        str(health["settings_reload_error"]),
                        "the previous settings remain active")
            return {"reloaded": True, "pid": pid, "connection": cfg["id"],
                    "settings_reloaded_at": health.get("settings_reloaded_at")}
        time.sleep(0.1)
    _refuse(5, "service_reload_timeout",
            f"the service did not acknowledge the reload within {timeout:g}s",
            f"read `{NAME} service logs`")


def cmd_service(args) -> dict | None:
    sub = args.service_command
    if sub == "help":
        _emit(_SERVICE_HELP)
        return None
    if sub in ("init", "doctor", "run", "reload"):
        settings = _checked_service_settings()
    else:
        settings = _service_settings()
    cfg = _service_cfg(settings, getattr(args, "connection", None))
    home = _service_home(cfg)
    if sub == "init":
        return _cmd_service_init(cfg, home, getattr(args, "force", False))
    if sub == "doctor":
        return _cmd_service_doctor(cfg, home, settings)
    if sub == "run":
        _read_only_gate(f"`{NAME} service run`")
        if _service_schema().dialogue_configured(settings) and not _runner_importable():
            _rerun_with_runner(sys.argv[1:])
        code = _Capture(cfg, settings, _project_root()).run()
        if code:
            sys.exit(code)
        return None
    if sub == "reload":
        return _cmd_service_reload(cfg, home)
    health = _service_read(home, "health.json")
    if sub == "status":
        return {"connection": cfg["id"], "health": health,
                "state": (health or {}).get("state", "unknown"),
                "dialogue": (health or {}).get("dialogue")}
    if sub == "logs":
        log = home / "daemon.log"
        return {"connection": cfg["id"],
                "log": log.read_text()[-4000:] if log.exists() else ""}
    if sub in ("start", "stop"):
        # start/stop of a detached daemon is the deployment capability's job;
        # the foreground `run` is the deploy command.
        return {"ok": False, "connection": cfg["id"],
                "note": f"`service {sub}` of a detached daemon is deferred; "
                        f"`service run` is the foreground deploy command, "
                        f"supervised by the deployment capability"}
    _die(6, "unknown_command", f"no service subcommand {sub!r}")


_SERVICE_HELP = (
    "slacker service — the bundled listener: live capture, and the assistant\n\n"
    "  service init [--force] [--connection ID]\n"
    "                                     Seed the control files, and the\n"
    "                                     assistant's settings from the bundle's\n"
    "                                     template, which admits nobody\n"
    "  service run  [--connection ID]     Run the listener in the foreground\n"
    "                                     (the deploy command). Exit 7 when the\n"
    "                                     session is no longer linked.\n"
    "  service reload [--connection ID]   Make the running listener take the\n"
    "                                     settings; a refused reload leaves the\n"
    "                                     previous ones in force\n"
    "  service status [--connection ID]   The last health the listener wrote,\n"
    "                                     the assistant's counters with it\n"
    "  service logs   [--connection ID]   The tail of the listener's log\n"
    "  service doctor [--connection ID]   Store, session, and what the\n"
    "                                     assistant's settings reach\n"
    "  service start|stop                 Deferred to the deployment capability\n")


# The verb pages `slacker help <verb>` answers (SHEBANG.md, "Agent-first help
# is the surface"): each verb's whole contract, the module docstring being the
# menu. The contract library dispatches both and renders the contract verbs'
# own pages, which the entries here for doctor, connections, connection,
# settings, manifest, inventory and migrate follow. A text several verbs own is
# one constant, added to each of their pages.
_HELP_SELECT = """
  Connection: --connection <id> (-c), accepted anywhere on the command line,
  selects it; else the registry's default, else the sole entry (`slacker help
  connections`).
"""
_HELP_CONNECTIONS = """
  Connections
  A connection is one workspace session of one linked account. It carries the
  env vars that hold the session secrets (token_env, cookie_env), never the
  secret values, plus the non-secret workspace identity. A machine with several
  workspaces declares one connection each. Secrets resolve through the
  credential cascade (`Where a secret resolves`, on `slacker help connections`
  and `slacker help connection`); selection is `--connection <id>` (-c), else
  the registry's default, else the sole entry.

  Two ways to link. `slacker link` signs you in through a Chrome window it
  opens and reads the session out for you (needs an installed Chrome and a
  display). Or paste: read the xoxc- token and the `d` cookie from a browser
  you are already signed in to and run `connection add <id> --stdin` (see
  `slacker guide linking`). `link` writes the two secrets into the credentials
  file; `connection add` stores them as `Where a secret resolves` says. Either
  way they never land in the registry, a log, or output.
"""
_HELP_STORE = """
  Store
  Conversations, messages, thread replies, reactions, users and the sync cursor
  live in the project's Postgres database, in slacker_* tables keyed by the
  workspace account (the team id), created and migrated on first use. The
  capture belongs to the account, not to one project: an account has one history
  in a database, whichever project on the machine reads it, so the tables carry
  no project id. The database is resolved as every store capability resolves it
  (AGENTKIT_DB_* in the project .env.local/.env, then the environment, then the
  machine's `capabilities store set`). With none, every verb that reads or writes
  the capture exits 6; help, contract and connections still answer.
"""
_HELP_EXIT_READ = """
  Exit codes: 0 answered; 2 the session is invalid or expired (invalid_auth:
  link the connection again); 4 policy, the capability not enabled here; 5 the
  store or Slack unreachable, or Slack rate-limited the session (rate_limited);
  6 a configuration fault (no connection, no store), an invalid argument, or a
  conversation the session cannot see (channel_not_found, not_in_channel,
  thread_not_found).
"""
_HELP_WRITE = """
  A write: refused with exit 4 (read_only) unless the connection grants writes
  (`allow_write`, given per connection - a person grants one with
  `capabilities set slacker grant <connection> '{"allow_write": true}'`); ask
  the user, never lift a gate yourself. Each write answers the channel and ts
  it wrote, and records the write in the store as the live capture records the
  same act: a sent message or reply as its row (a reply raises its parent's
  reply count), an edit as the new text, a deletion as the soft flag, a
  reaction in the message's reactions, an opened conversation as its row. A
  read mark is not captured.

  Exit codes: 0 written; 2 the session is invalid or expired (invalid_auth);
  4 the write gate (read_only) or the project gate; 5 the store or Slack
  unreachable, or rate-limited; 6 a configuration fault (no connection, no
  store), an invalid argument, or a write Slack refused, named by Slack's
  reason (not your message, an archived conversation, an unknown emoji, ...).
"""
_HELP_MESSAGES = """
  Each message is {"ts", "ts_at", "thread_ts", "user", "type", "subtype",
  "text", "edited", "deleted", "reply_count", "reactions"}, oldest first;
  reactions is {<name>: [<user id>, ...]}. A deleted message is left out.
"""
_HELP_JOBS = """
  The jobs are the work an assistant turn handed over: the register of work
  that outlives a conversation. A job runs in arrival order within
  defaults.max_parallel_jobs, on the profile named by defaults.job_profile,
  and answers into the conversation it was registered from, in the thread its
  request was answered in. States: draft,
  waiting, running, stopped; a stopped job's outcome is succeeded, failed,
  cancelled, interrupted, quota or model_refused. Outside a worker, --chat
  narrows to one conversation and register takes --chat, --thread and
  --requested-by. A worker the service started is held to the conversation,
  requester and origin it was started for (exit 4 job_scope_denied otherwise).
  Every jobs verb but help takes --connection <id> (-c) and --chat
  <conversation id>.

  Exit codes: 0; 2 job_not_found for an id not in this project's register; 4
  job_scope_denied or job_scope_missing; 5 the store unreachable; 6 no_project
  outside a project, or the register's refusal named by its code.
"""
_HELP_PROMPTS = """
  The prompts are the assistant's: context, delegation and job-worker. Each is
  the agent's own active version in the store, else the bundle's standard
  text. Needs a project and its store; --connection <id> (-c) is accepted
  and not used, since the prompts are the agent's, not an account's.

  Exit codes: 0; 4 put and retire under the read-only switch; 5 the store
  unreachable; 6 no_project, a key that is not a prompt (invalid_arguments),
  an empty body on stdin (empty_prompt), a --base that is not the active
  version (base_mismatch).
"""
_HELP_SERVICE = """
  The bundled listener: live capture, and the assistant that answers the
  messages its settings admit (`slacker guide assistant-service`). It runs one
  account, the connection --connection <id> (-c) names, else the settings'
  `connection`. The assistant's settings are `slacker settings` (`slacker help
