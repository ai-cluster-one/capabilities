# --- dispatch ----------------------------------------------------------------

import re  # noqa: E402  (used by _service_home; imported here to stay local)


class _Parser(argparse.ArgumentParser):
    """Usage errors leave through the envelope at exit 6, not argparse's 2,
    which this taxonomy reserves for credentials."""

    def error(self, message: str) -> NoReturn:
        _die(6, "invalid_arguments", f"{self.prog}: {message}",
             f"run `{NAME} help` for the verb's arguments")


def _positive_int(value: str) -> int:
    try:
        n = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError(f"{value!r} is not a whole number")
    if n < 1:
        raise argparse.ArgumentTypeError(f"{value!r} is not positive")
    return n


def _build_parser() -> argparse.ArgumentParser:
    p = _Parser(prog=NAME, allow_abbrev=False, add_help=False)
    p.add_argument("--connection", "-c")
    groups = p.add_subparsers(dest="command", required=True, parser_class=_Parser)

    def _leaf(name: str) -> argparse.ArgumentParser:
        sp = groups.add_parser(name, allow_abbrev=False)
        sp.add_argument("--connection", "-c")
        return sp

    _leaf("doctor")
    w = _leaf("whoami")
    w.add_argument("--no-store", action="store_true",
                   help="do not open or write the store")

    cv = _leaf("conversations")
    cv.add_argument("--types",
                    help="comma list of im,mpim,public_channel,private_channel")
    cv.add_argument("--search", "-s")
    cv.add_argument("--limit", "-n", type=_positive_int)

    h = _leaf("history")
    h.add_argument("channel")
    h.add_argument("--limit", "-n", type=_positive_int, default=100)
    h.add_argument("--oldest")
    h.add_argument("--latest")
    h.add_argument("--fresh", action="store_true",
                   help="fetch from Slack even when the store covers the request")

    t = _leaf("thread")
    t.add_argument("channel")
    t.add_argument("thread_ts")
    t.add_argument("--fresh", action="store_true")

    se = _leaf("search")
    se.add_argument("query", nargs="+")
    se.add_argument("--limit", "-n", type=_positive_int, default=20)
    se.add_argument("--sort", choices=["score", "timestamp"], default="score")

    sy = _leaf("sync")
    sy.add_argument("--channel", help="one channel id (default: every member channel)")
    sy.add_argument("--full", action="store_true",
                    help="re-fetch from the beginning, not only what is newer")
    sy.add_argument("--limit", "-n", type=_positive_int, default=1000)

    sn = _leaf("send")
    sn.add_argument("channel")
    sn.add_argument("text", help="the message text, or - to read it from stdin")
    sn.add_argument("--thread", help="the parent ts: reply in its thread")
    sn.add_argument("--broadcast", action="store_true",
                    help="with --thread, also post the reply to the channel")

    ed = _leaf("edit")
    ed.add_argument("channel")
    ed.add_argument("ts")
    ed.add_argument("text", help="the new text, or - to read it from stdin")

    de = _leaf("delete")
    de.add_argument("channel")
    de.add_argument("ts")

    for verb in ("react", "unreact"):
        r = _leaf(verb)
        r.add_argument("channel")
        r.add_argument("ts")
        r.add_argument("emoji", help="the emoji name, e.g. thumbsup")

    up = _leaf("upload")
    up.add_argument("channel")
    up.add_argument("path")
    up.add_argument("--comment", help="the message the file is posted with")
    up.add_argument("--thread", help="the parent ts: post the file in its thread")
    up.add_argument("--title", help="the file's title (default: its name)")

    mk = _leaf("mark")
    mk.add_argument("channel")
    mk.add_argument("ts", nargs="?",
                    help="read up to this ts (default: the newest message)")

    op = _leaf("open")
    op.add_argument("users", nargs="+", help="one user id for a DM, several for a group DM")

    sv = _leaf("service")
    sv.add_argument("service_command",
                    choices=["init", "doctor", "run", "start", "stop", "reload",
                             "status", "logs", "help"])
    sv.add_argument("--force", action="store_true",
                    help="with init, reseed settings that already exist")

    pr = _leaf("prompts")
    pr.add_argument("prompts_command",
                    choices=["list", "show", "put", "history", "retire"])
    pr.add_argument("key", nargs="?", help="context, delegation or job-worker")
    pr.add_argument("--base", help="with put: the active version it replaces")
    pr.add_argument("--note", help="with put: why this version")

    pj = _leaf("jobs")
    jobs_sub = pj.add_subparsers(dest="jobs_command", required=True,
                                 parser_class=_Parser)

    def _job(name: str, *, needs_id: bool = True) -> argparse.ArgumentParser:
        created = jobs_sub.add_parser(name, allow_abbrev=False)
        created.add_argument("--connection", "-c")
        if needs_id:
            created.add_argument("id", help="the job id, from `jobs list`")
        created.add_argument("--chat", help="only this conversation's jobs")
        created.add_argument("--actor", help=argparse.SUPPRESS)
        return created

    jobs_sub.add_parser("help")
    jl = _job("list", needs_id=False)
    jl.add_argument("--state", choices=["draft", "waiting", "running", "stopped"])
    jl.add_argument("--outcome", choices=["succeeded", "failed", "cancelled",
                                          "interrupted", "quota", "model_refused"])
    jl.add_argument("--limit", type=_positive_int, default=50)
    ja = _job("active", needs_id=False)
    ja.add_argument("--limit", type=_positive_int, default=50)
    _job("show")
    jr = _job("register", needs_id=False)
    jr.add_argument("description", help="one line: the outcome, in the requester's terms")
    jr.add_argument("--requested-by", dest="requested_by",
                    help="the Slack user id whose authority the job carries")
    jr.add_argument("--thread", help="the thread its result is posted in")
    jr.add_argument("--origin-message-id", dest="origin_message_id",
                    help="the ts of the message the job answers")
    jr.add_argument("--profile", help="the job profile (default: defaults.job_profile)")
    js = _job("submit")
    js.add_argument("--confirm-active-jobs-checked", action="store_true",
                    dest="confirm_active_jobs_checked",
                    help="you read `jobs active` and this outcome is not there")
    jm = _job("amend")
    jm.add_argument("text", help="what changed, in the requester's terms")
    _job("discard")
    _job("stop")
    _job("resume")

    ln = _leaf("link")
    ln.add_argument("id", nargs="?",
                    help="the connection id to write (default: the workspace domain)")
    ln.add_argument("--workspace", "-w",
                    help="which signed-in workspace to link, by team id, domain or name")
    ln.add_argument("--events", action="store_true",
                    help="drive the ceremony as a JSON event stream on stdout/stdin")
    ln.add_argument("--global", dest="scope", action="store_const", const="global",
                    help="write the connection at global (machine-wide) scope")
    ln.add_argument("--project", dest="scope", action="store_const", const="project",
                    help="write it in this project's capabilities/ envelope")
    ln.add_argument("--machine", dest="scope", action="store_const", const="machine",
                    help="write the machine's connection (global scope)")
    ln.add_argument("--default", action="store_true",
                    help="make this the default connection")
    ln.add_argument("--replace", action="store_true",
                    help="re-link an existing connection id, writing over it")
    ln.add_argument("--timeout", type=_positive_int,
                    help=f"seconds to wait for sign-in (default {LINK_TIMEOUT})")
    return p


def main() -> None:
    _gate()
    argv = sys.argv[1:]

    # manifest carries the bundled service it declares, as whatsapp's does.
    if argv[:1] == ["manifest"]:
        _emit({**_manifest_core(), "service": SERVICE})
        return

    # `--connection <id>` is a global selector accepted anywhere on the line.
    wanted_conn: str | None = None
    cleaned: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--connection", "-c") and i + 1 < len(argv):
            wanted_conn = argv[i + 1]; i += 2; continue
        if a.startswith("--connection="):
            wanted_conn = a.split("=", 1)[1]; i += 1; continue
        cleaned.append(a); i += 1

    _contract(cleaned)   # contract verbs (help, connections, guide, ids, …)
    if not cleaned or cleaned[0] in ("help", "-h", "--help"):
        _cmd_help()
        return

    if cleaned[0] == "doctor":
        if len(cleaned) > 1:
            _die(6, "invalid_arguments",
                 f"doctor takes only --connection <id>, not {cleaned[1]!r}")
        reg, _ = _connections_registry()
        cmd_doctor(reg, wanted_conn)
        return

    args = _build_parser().parse_args(argv)
    handlers = {
        "whoami": cmd_whoami, "conversations": cmd_conversations,
        "history": cmd_history, "thread": cmd_thread, "search": cmd_search,
        "sync": cmd_sync,
        "send": cmd_send, "edit": cmd_edit, "delete": cmd_delete,
        "react": cmd_react, "unreact": cmd_react, "upload": cmd_upload,
        "mark": cmd_mark, "open": cmd_open,
        "service": cmd_service, "link": cmd_link,
        "prompts": cmd_prompts, "jobs": cmd_jobs,
    }
    handler = handlers.get(args.command)
    if handler is None:
        _die(6, "unknown_command", f"no handler for {args.command!r}")
    if args.command in WRITE_VERBS:
        cfg = get_config(args)
        _write_gate(cfg["id"], cfg["allow_write"], args.command)
    result = handler(args)
    if result is not None:
        _emit(result)


def _run() -> NoReturn:
    code = 0
    try:
        main()
    except _Refusal as refusal:
        try:
            _die(refusal.exit_code, refusal.code, refusal.message, refusal.hint)
        except SystemExit as exc:
            code = exc.code if isinstance(exc.code, int) else 1
    except SystemExit as exc:
        code = exc.code if isinstance(exc.code, int) else (0 if exc.code is None else 1)
    except BaseException as exc:
        traceback.print_exc()
        sys.stderr.write(json.dumps({"error": {
            "code": "unhandled", "message": f"{type(exc).__name__}: {exc}",
            "hint": "this is a defect in the capability; the traceback is above"}},
            ensure_ascii=False) + "\n")
        code = 1
    finally:
        for stream in (sys.stdout, sys.stderr):
            with contextlib.suppress(Exception):
                stream.flush()
        os._exit(code)


if __name__ == "__main__":
    import traceback  # noqa: E402
    _run()
