# --- Refusals that a caller may fold, and progress logging -------------------

class _Refusal(Exception):
    """A handled failure raised rather than exited, so a caller answering for
    several connections can fold one connection's refusal into its report
    instead of ending at the first. `main` turns an uncaught one into the error
    envelope and its exit code."""

    def __init__(self, exit_code: int, code: str, message: str,
                 hint: str | None = None):
        super().__init__(message)
        self.exit_code = exit_code
        self.code = code
        self.message = message
        self.hint = hint

    def as_result(self) -> dict:
        out = {"ok": False, "category": self.exit_code, "error": self.message}
        if self.hint:
            out["hint"] = self.hint
        return out


def _refuse(exit_code: int, code: str, message: str,
            hint: str | None = None, status: int | None = None) -> NoReturn:
    if status is not None:
        message = f"{message} (status {status})"
    raise _Refusal(exit_code, code, message, hint)


def _log(message: str) -> None:
    """Progress / diagnostics to stderr, keeping stdout clean for the result."""
    sys.stderr.write(message + "\n")
    sys.stderr.flush()


# --- Connections (capability-specific) ---------------------------------------

def _unquote(value: str | None) -> str | None:
    """A pasted secret without the quote marks a browser console prints around
    a string. The realtime gateway refuses a quoted value that REST accepts."""
    if value is None:
        return None
    value = str(value).strip()
    while len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        value = value[1:-1].strip()
    return value


def _resolve_cookie(raw: str | None) -> str | None:
    """The `d` cookie value, however the person pasted it: a bare value, or a
    `d=...` pair, or a whole Cookie header carrying `d=`, each possibly quoted.
    Returns the value alone; the client re-wraps it as a `d=` cookie."""
    raw = _unquote(raw)
    if not raw:
        return None
    for part in raw.split(";"):
        part = part.strip()
        if part.startswith("d="):
            return _unquote(part[2:])
    return raw


def _build_cfg(cid: str, entry: dict | None) -> tuple[dict | None, dict | None]:
    """Materialize one connection into the config the commands consume. Returns
    (cfg, problem) — problem is an error dict instead of a die, so doctor can
    report every connection rather than stopping at the first."""
    entry = entry if isinstance(entry, dict) else {}
    token_env = entry.get("token_env") or "SLACKER_TOKEN"
    cookie_env = entry.get("cookie_env") or "SLACKER_COOKIE"
    token = _unquote(_resolve_env_key(token_env)[0])
    cookie = _resolve_cookie(_resolve_env_key(cookie_env)[0])
    if not token:
        return None, {
            "exit": 2, "code": "missing_secret",
            "message": f"env var {token_env} (for connection {cid!r}) is unset",
            "hint": f"set {token_env} in the project .env/.env.local, "
                    f"{CREDENTIALS_ENV}, or the environment — the xoxc- token "
                    f"from the signed-in browser's localConfig_v2"}
    if not cookie:
        return None, {
            "exit": 2, "code": "missing_secret",
            "message": f"env var {cookie_env} (for connection {cid!r}) is unset",
            "hint": f"set {cookie_env} to the `d` cookie value from the "
                    f"signed-in browser"}
    if not str(token).startswith("xoxc-"):
        return None, {
            "exit": 6, "code": "not_a_session_token",
            "message": f"connection {cid!r}: {token_env} is not an xoxc- "
                       f"web-session token",
            "hint": "this capability reads as the web client; a bot (xoxb-) or "
                    "user (xoxp-) OAuth token is a different route"}
    account = _digits_or_text(entry.get("team_id"))
    return {
        "id": cid,
        "token": str(token),
        "cookie": cookie,
        "team_id": entry.get("team_id") or None,
        "account_binding": account,
        "workspace": entry.get("workspace") or None,
        "expect_user": entry.get("expect_user") or None,
        "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT)),
    }, None


def _digits_or_text(value) -> str | None:
    value = (str(value).strip() if value is not None else "")
    return value or None


def get_config(args=None) -> dict:
    """Resolve the active connection into the config dict every command consumes."""
    reg, _ = _connections_registry()
    cid, entry = _select_connection(reg, getattr(args, "connection", None))
    cfg, problem = _build_cfg(cid, entry)
    if problem:
        _refuse(problem["exit"], problem["code"], problem["message"],
                problem.get("hint"))
    return cfg


def _connections_report() -> dict:
    """The resolution report — every connection, every value, its winning tier
    and source, secrets masked. Local only: no network, no session opened."""
    reg, _ = _connections_registry()
    report: dict = {"default": None, "connections": {}}
    conns = reg["connections"]
    report["default"] = reg.get("default") or \
        (next(iter(conns)) if len(conns) == 1 else None)
    for cid, entry in conns.items():
        entry = entry if isinstance(entry, dict) else {}
        origin = reg["sources"][cid]
        keys = []
        for field, template in (("token_env", "SLACKER_TOKEN"),
                                ("cookie_env", "SLACKER_COOKIE")):
            name = entry.get(field) or template
            value, tier, source = _resolve_env_key(name)
            keys.append(_key_report(name, True, True, value, tier, source))
        for field in ("team_id", "workspace", "expect_user"):
            value = entry.get(field)
            keys.append(_key_report(field, False, False,
                                    str(value) if value is not None else None,
                                    "connection" if value is not None else None,
                                    origin if value is not None else None))
        report["connections"][cid] = {
            "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT)),
            "keys": keys}
    return report


def _cmd_connections() -> None:
    _emit(_connections_report())


# --- Browser linking (Chrome DevTools) ---------------------------------------
#
# `link` reads the person's own workspace session out of a Chrome they signed
# in to, so nobody copies a token or a cookie. The tool opens the installed
# Chrome with a throwaway profile and Chrome's remote-debugging channel, opens
# the Slack app, and waits — typing and clicking nothing — while the person
# signs in normally. It then reads the workspace xoxc- token from the page's
# own localStorage (`localConfig_v2`) and the shared `d` cookie over the
# DevTools protocol, closes the window and deletes the profile. The protocol is
# spoken over the websocket library slacker already ships; no browser is
# bundled and no dependency is added. The person's everyday Chrome profile is
# never read: the window runs on a fresh profile they sign in to just for this.

SLACK_APP_URL = "https://app.slack.com/"
# How long `link` waits for the person to finish signing in before it gives up.
LINK_TIMEOUT = 300
# Where an installed Chrome is looked for; SLACKER_CHROME overrides.
_CHROME_NAMES = ("google-chrome", "google-chrome-stable", "google-chrome-beta",
                 "chromium", "chromium-browser", "chrome")
_CHROME_MAC = (
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "/Applications/Chromium.app/Contents/MacOS/Chromium")


class _BrowserGone(Exception):
    """The debugging endpoint stopped answering — the window was closed."""


def _find_chrome() -> str | None:
    """The installed Chrome to drive, or None. An explicit SLACKER_CHROME wins;
    otherwise the first known binary on PATH, then the macOS app bundle."""
    import shutil
    override = _unquote(os.environ.get("SLACKER_CHROME"))
    if override:
        return override if (Path(override).is_file() or shutil.which(override)) else None
    for name in _CHROME_NAMES:
        found = shutil.which(name)
        if found:
            return found
    for path in _CHROME_MAC:
        if Path(path).is_file():
            return path
    return None


def _cdp_http(port: int, path: str) -> Any:
    """Read one of Chrome's DevTools HTTP endpoints (/json/...). A refused
    connection means the window is gone."""
    import urllib.error
    import urllib.request
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}{path}", timeout=5) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except (urllib.error.URLError, OSError, ValueError) as exc:
        raise _BrowserGone(str(exc))


class _Cdp:
    """One DevTools websocket, talking to a page target. Each command is a JSON
    object with a rising id; the reply carrying that id (and only it) is
    returned, so events arriving on the connection are skipped."""

    def __init__(self, ws_url: str):
        import websocket
        # Chrome refuses a DevTools socket whose Origin it was not told to
        # allow; a socket with no Origin is a local client and is accepted.
        try:
            self._ws = websocket.create_connection(
                ws_url, timeout=10, max_size=64 * 1024 * 1024,
                suppress_origin=True)
        except websocket.WebSocketBadStatusException as exc:
            _refuse(5, "devtools_refused",
                    f"Chrome refused the DevTools connection "
                    f"(HTTP {getattr(exc, 'status_code', '?')})",
                    "link by paste (`slacker connection add <id> --stdin`)")
        self._id = 0

    def call(self, method: str, **params) -> dict:
        self._id += 1
        mid = self._id
        self._ws.send(json.dumps({"id": mid, "method": method, "params": params}))
        while True:
            try:
                msg = json.loads(self._ws.recv())
            except Exception as exc:
                raise _BrowserGone(str(exc))
            if msg.get("id") == mid:
                if "error" in msg:
                    _refuse(5, "cdp_error",
                            f"Chrome DevTools refused {method}: "
                            f"{(msg['error'] or {}).get('message')}")
                return msg.get("result") or {}

    def close(self) -> None:
        with contextlib.suppress(Exception):
            self._ws.close()


def _slack_page(port: int) -> dict | None:
    """A Slack page target to talk to, or None while none has loaded yet."""
    for target in _cdp_http(port, "/json/list"):
        if target.get("type") == "page" \
                and "slack.com" in (target.get("url") or "") \
                and target.get("webSocketDebuggerUrl"):
            return target
    return None


def _read_teams(cdp: "_Cdp") -> list[dict]:
    """Every workspace signed in on the page, read from its own localStorage
    `localConfig_v2`. Each is {id, name, domain, token}, token an xoxc-."""
    result = cdp.call("Runtime.evaluate",
                      expression="window.localStorage.getItem('localConfig_v2')",
                      returnByValue=True)
    raw = (result.get("result") or {}).get("value")
    if not raw:
        return []
    try:
        teams = json.loads(raw).get("teams") or {}
    except (ValueError, AttributeError):
        return []
    out = []
    for tid, team in (teams.items() if isinstance(teams, dict) else []):
        team = team or {}
        token = _unquote(team.get("token"))
        if not token or not str(token).startswith("xoxc-"):
            continue
        out.append({"id": team.get("id") or tid,
                    "name": team.get("name") or team.get("domain") or tid,
                    "domain": team.get("domain"),
                    "token": str(token)})
    return out


def _read_d_cookie(cdp: "_Cdp") -> str | None:
    """The shared `d` cookie, read over the protocol — it is httpOnly, so the
    page's own script cannot see it."""
    cdp.call("Network.enable")
    for cookie in cdp.call("Network.getAllCookies").get("cookies") or []:
        if cookie.get("name") == "d" \
                and (cookie.get("domain") or "").endswith("slack.com"):
            return cookie.get("value")
    return None


def _launch_chrome(chrome: str, profile: Path, url: str) -> tuple:
    """Start Chrome on a throwaway profile with its remote-debugging channel on
    a free port, and return (process, port). The port Chrome chose is read from
    the profile's DevToolsActivePort file."""
    import subprocess
    args = [chrome, f"--user-data-dir={profile}", "--remote-debugging-port=0",
            "--no-first-run", "--no-default-browser-check", "--no-service-autorun",
            "--disable-features=Translate", "--use-mock-keychain",
            "--new-window", url]
    proc = subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    port_file = profile / "DevToolsActivePort"
    deadline = time.monotonic() + 30
    while time.monotonic() < deadline:
        if proc.poll() is not None:
            _refuse(5, "chrome_exited",
                    "Chrome exited before its debugging port was ready",
                    "run `slacker link` again, or link by paste")
        if port_file.is_file():
            try:
                return proc, int(port_file.read_text().splitlines()[0].strip())
            except (ValueError, IndexError):
                pass
        time.sleep(0.25)
    _refuse(5, "chrome_no_port",
            "Chrome did not open its debugging port within 30s",
            "run `slacker link` again, or link by paste")


def _end_chrome(proc, profile: Path) -> None:
    """Close the window and delete the throwaway profile, whatever happened."""
    import shutil
    import subprocess
    if proc is not None and proc.poll() is None:
        proc.terminate()
        try:
            proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            proc.kill()
            with contextlib.suppress(Exception):
                proc.wait(timeout=5)
    shutil.rmtree(profile, ignore_errors=True)


def _await_session(port: int, timeout: int) -> tuple:
    """Wait while the person signs in, then read the workspaces and the `d`
    cookie out. Returns (teams, cookie). The window closing or the time running
    out is a refusal that leaves nothing behind."""
    deadline = time.monotonic() + timeout
    announced = False
    while time.monotonic() < deadline:
        try:
            target = _slack_page(port)
            if target is not None:
                cdp = _Cdp(target["webSocketDebuggerUrl"])
                try:
                    teams = _read_teams(cdp)
                    if teams:
                        cookie = _read_d_cookie(cdp)
                        if cookie:
                            return teams, cookie
                finally:
                    cdp.close()
        except _BrowserGone:
            _refuse(5, "window_closed",
                    "the Chrome window was closed before sign-in finished",
                    "run `slacker link` again, or link by paste "
                    "(`slacker connection add <id> --stdin`)")
        if not announced:
            _event("progress", stage="waiting_for_signin", url=SLACK_APP_URL)
            announced = True
        time.sleep(1.5)
    _refuse(6, "link_timeout",
            f"no signed-in Slack workspace appeared within {timeout}s",
            "sign in during the window `slacker link` opens, or link by paste "
            "(`slacker connection add <id> --stdin`)")


def _match_team(teams: list[dict], wanted: str) -> dict | None:
    """The one workspace whose id, domain or name matches `wanted`, or None."""
    low = wanted.lower()
    for team in teams:
        if low in (str(team["id"]).lower(), (team.get("domain") or "").lower(),
                   (team.get("name") or "").lower()):
            return team
    return None


def _link_connection_id(given: str | None, team: dict) -> str:
    """The connection id a link writes to: the one asked for, else one made
    from the workspace's own domain or name."""
    if given:
        return given
    base = team.get("domain") or team.get("name") or team["id"]
    cid = re.sub(r"[^a-z0-9._@+-]", "-", str(base).lower()).strip("-")
    return (cid or "slack")[:128]


def _persist_link(cid: str, scope: str, token: str, cookie: str, team: dict,
                  default: bool, replace: bool) -> dict:
    """Write the linked session through the connection surface: the two secrets
    into the scope's credentials file under this connection's own env keys,
    the non-secret workspace identity into the registry. Mirrors the write
    `connection add` makes, so link and paste leave the same shape."""
    declared = {f["key"]: f for f in (globals().get("CONN_FIELDS") or [])}
    token_env = _connection_env_name(declared["token_env"], cid)
    cookie_env = _connection_env_name(declared["cookie_env"], cid)
    adapter = _records()
    try:
        held = adapter.resolve_scope(NAME, "connection", scope).get(cid)
    except StoreError as e:
        _die(5 if e.slug in STORE_ENVIRONMENT_SLUGS else 6, e.slug, e.message, e.hint)
    if held is not None and not replace:
        _die(6, "connection_exists",
             f"a {scope} connection {cid!r} already exists; link writes over it "
             "only when asked to",
             "pass --replace to re-link it, or give a different id")
    entry = dict((held or {}).get("value") or {})
    entry.update({"token_env": token_env, "cookie_env": cookie_env,
                  "team_id": team["id"]})
    if team.get("domain") or team.get("name"):
        entry["workspace"] = team.get("domain") or team.get("name")
    credentials = _scope_credentials(scope)
    _env_file_write(credentials, {token_env: token, cookie_env: cookie})
    try:
        adapter.set(NAME, "connection", cid, entry, scope=scope)
        if default:
            adapter.set(NAME, "setting", "connection.default", cid, scope=scope)
        source = adapter.scope_source(NAME, "connection", scope)
    except StoreError as e:
        _die(5 if e.slug in STORE_ENVIRONMENT_SLUGS else 6, e.slug, e.message, e.hint)
    return {"registry": source, "credentials": str(credentials),
            "token_env": token_env, "cookie_env": cookie_env}


def cmd_link(args) -> dict | None:
    """Open Chrome, wait while the person signs in, read the session out, and
    write it as a connection — proving it with the same check `doctor` runs.
    No secret value ever reaches stdout, the log or the registry."""
    if getattr(args, "events", False):
        _events_begin()
    wanted_scope = getattr(args, "scope", None)   # project | global | machine | None
    root = _project_root()
    has_envelope = root is not None and _project_capabilities_dir(root).is_dir()
    if wanted_scope == "project":
        if not has_envelope:
            _die(6, "no_envelope",
                 "--project needs a capabilities/ envelope in this project",
                 "run `capabilities init` first, or link with --global")
        scope = "project"
    elif wanted_scope in ("global", "machine"):
        scope = "global"
    else:
        scope = "project" if has_envelope else "global"
    _read_only_gate("`slacker link`")

    chrome = _find_chrome()
    if chrome is None:
        _refuse(6, "no_chrome",
                "no Google Chrome is installed to sign in through",
                "install Google Chrome, or link by paste: read the xoxc- token "
                "and the `d` cookie from a signed-in browser and run "
                "`slacker connection add <id> --stdin` (`slacker guide linking`)")

    import tempfile
    timeout = getattr(args, "timeout", None) or LINK_TIMEOUT
    profile = Path(tempfile.mkdtemp(prefix="slacker-link-"))
    proc = None
    _event("progress", stage="launching_chrome")
    _log(f"Opening Chrome to {SLACK_APP_URL} — sign in to your workspace; "
         "slacker reads the session and closes the window.")
    try:
        proc, port = _launch_chrome(chrome, profile, SLACK_APP_URL)
        teams, cookie = _await_session(port, timeout)
    finally:
        _end_chrome(proc, profile)

    wanted_conn = getattr(args, "connection", None)
    given_id = getattr(args, "id", None) or wanted_conn
    selector = getattr(args, "workspace", None) or given_id
    if len(teams) == 1:
        team = teams[0]
    else:
        team = _match_team(teams, selector) if selector else None
        if team is None:
            listed = [{"team_id": t["id"], "name": t["name"], "domain": t.get("domain")}
                      for t in teams]
            if _EVENTS_ON[0]:
                answer = _event_answer("workspace_needed", workspaces=listed).strip()
                team = _match_team(teams, answer)
                if team is None:
                    _refuse(6, "unknown_workspace",
                            f"no signed-in workspace matches {answer!r}",
                            "answer workspace_needed with a team id, domain or "
                            "name from the list")
            else:
                names = ", ".join(f"{t['name']} ({t.get('domain') or t['id']})"
                                  for t in teams)
                _refuse(6, "several_workspaces",
                        f"{len(teams)} workspaces are signed in: {names}",
                        "say which with `--workspace <team-id|domain|name>` (or "
                        "`-c <id>` matching one), or sign in to just one")

    cid = _link_connection_id(given_id, team)
    if not re.fullmatch(r"[a-z0-9][a-z0-9._@+-]{0,127}", cid, re.IGNORECASE):
        _refuse(6, "bad_connection_id",
                f"connection id {cid!r} is not a valid id",
                "pass one with a leading letter or digit: letters, digits and "
                ". _ @ + -")

    cfg = {"id": cid, "token": team["token"], "cookie": cookie,
           "team_id": team["id"], "account_binding": _digits_or_text(team["id"]),
           "workspace": team.get("domain") or team.get("name"),
           "expect_user": None, "allow_write": False}
    _event("progress", stage="verifying")
    proof = _check_connection(cfg)
    if not proof.get("ok"):
        _refuse(proof.get("category") or 2, "link_unverified",
                "the session read from Chrome did not authorise: "
                f"{proof.get('error')}",
                proof.get("hint") or "finish signing in before the window is "
                "read, then run `slacker link` again")

    default = getattr(args, "default", False)
    written = _persist_link(cid, scope, team["token"], cookie, team, default,
                            getattr(args, "replace", False))
    _event("linked", connection=cid, workspace=cfg["workspace"],
           user=proof.get("user"))
    return {"ok": True, "action": "link", "connection": cid, "scope": scope,
            "registry": written["registry"], "credentials": written["credentials"],
            "default": default, "verified": True,
            "workspace": {"team_id": team["id"], "name": team["name"],
                          "domain": team.get("domain")},
            "user": proof.get("user"), "user_id": proof.get("user_id"),
            "team": proof.get("team"), "url": proof.get("url"),
            "secrets": {"token_env": written["token_env"],
                        "cookie_env": written["cookie_env"]},
            "next": f"`slacker doctor --connection {cid}` re-proves it"}


# --- Slack values ------------------------------------------------------------

_CONV_KINDS = ("im", "mpim", "private_channel", "public_channel")
_SYNC_TYPES = ("history", "live", "backfill")


def _ts_float(ts) -> float | None:
    """A Slack message ts ("1728999999.000100") as float seconds, or None."""
    try:
        return float(ts)
    except (TypeError, ValueError):
        return None


def _conv_kind(conv: dict) -> str:
    """The closed conversation kind a Slack conversation object resolves to."""
    if conv.get("is_im"):
        return "im"
    if conv.get("is_mpim"):
        return "mpim"
    if conv.get("is_private"):
        return "private_channel"
    return "public_channel"


def _conv_name(conv: dict) -> str | None:
    """A conversation's display name: its channel name, else the DM partner's
    user id prefixed, else None (resolved to a real name on read)."""
    if conv.get("name"):
        return conv["name"]
    if conv.get("is_im") and conv.get("user"):
        return f"@{conv['user']}"
    return None


def _normalize_channel_id(value: str) -> str:
    """A channel id is taken as given (C…/G…/D… or an mpmdm id). Empty is
    refused rather than silently matching the first conversation."""
    value = (value or "").strip()
    if not value:
        _refuse(6, "bad_channel", "a channel id is required",
                "pass a conversation id from `slacker conversations`")
    return value


# --- Store -------------------------------------------------------------------

STORE_VERSION = "1"
STORE_SCHEMA_MAJOR = 1
STORE_SCHEMA_MINOR = 1

# A store setting that cannot be used is a configuration fault (exit 6); a store
# that cannot be reached or refuses the migration is the environment's (exit 5).
_STORE_CONFIG_SLUGS = frozenset({
    "store_not_configured", "store_not_postgres", "store_setting_unreadable",
    "bad_store_setting", "sslmode_too_weak", "bad_schema_name"})

# Times the capability reasons about come back as the text or seconds the
# readers expect; a message's ts_at is the timestamptz of its Slack ts.
_EPOCH_COLUMNS = frozenset({"ts_at", "last_ts_at", "oldest_at", "newest_at"})
_TS_PARAM = "to_timestamp(%s::double precision)"

# Each step is applied once, in order, under the store's migration ledger. An
# applied step is never edited: a change to the tables is a new step. The tables
# are keyed by the workspace account (team id), not by project: the capture is
# the person's own Slack data, one history per account in a database, whichever
# project on the machine reads it — the whatsapp capability keeps its capture the
# same way and for the same reason. A per-table decision recorded here, per the
# Store Schema source's "Unsettled" clause, because project scoping would split
# one account's history across every project that read it.
STORE_STEPS = [
    Step("0001-meta", """
CREATE TABLE slacker_meta (
  account text NOT NULL CHECK (account <> ''),
  key text NOT NULL, value text,
  PRIMARY KEY (account, key))"""),
    Step("0002-conversations", """
CREATE TABLE slacker_conversations (
  account text NOT NULL CHECK (account <> ''),
  id text NOT NULL,
  kind text CHECK (kind IN ('im','mpim','private_channel','public_channel')),
  name text, user_id text,
  is_member boolean DEFAULT false, is_archived boolean DEFAULT false,
  last_ts text, last_ts_at timestamptz,
  synced_oldest text, synced_newest text, synced_at timestamptz,
  updated_at timestamptz,
  PRIMARY KEY (account, id))"""),
    Step("0003-messages", """
CREATE TABLE slacker_messages (
  account text NOT NULL CHECK (account <> ''),
  channel_id text NOT NULL, ts text NOT NULL, ts_at timestamptz,
  thread_ts text, user_id text, type text, subtype text, text text,
  edited_at timestamptz, deleted boolean DEFAULT false,
  reply_count integer DEFAULT 0,
  reactions jsonb NOT NULL DEFAULT '{}'::jsonb,
  raw jsonb,
  sync_type text CHECK (sync_type IN ('history','live','backfill')),
  captured_at timestamptz,
  PRIMARY KEY (account, channel_id, ts))"""),
    Step("0004-messages-by-time", """
CREATE INDEX slacker_messages_by_time
  ON slacker_messages (account, channel_id, ts_at)"""),
    Step("0005-messages-by-thread", """
CREATE INDEX slacker_messages_by_thread
  ON slacker_messages (account, channel_id, thread_ts)
  WHERE thread_ts IS NOT NULL"""),
    Step("0006-users", """
CREATE TABLE slacker_users (
  account text NOT NULL CHECK (account <> ''),
  id text NOT NULL, name text, real_name text, display_name text,
  is_bot boolean DEFAULT false, deleted boolean DEFAULT false,
  updated_at timestamptz,
  PRIMARY KEY (account, id))"""),
    Step("0007-comments", """
COMMENT ON TABLE slacker_meta IS
  'Per-account key/value: schema version, the linked user, workspace name.';
COMMENT ON TABLE slacker_conversations IS
  'Conversations the linked account can see, with the per-conversation incremental-sync cursor (synced_oldest/synced_newest).';
COMMENT ON COLUMN slacker_conversations.synced_newest IS
  'The newest ts the store covers for this conversation; the next incremental sync asks only for what is newer.';
COMMENT ON TABLE slacker_messages IS
  'Captured messages keyed by the Slack ts within a channel; a deletion is a soft flag and reactions are a {name: [user_id]} jsonb the table does not interpret.';
COMMENT ON COLUMN slacker_messages.ts IS
  'The Slack message timestamp string, unique within a channel: the natural message id and the dedup key.';
COMMENT ON COLUMN slacker_messages.raw IS
  'The whole Slack message object as received, opaque to the table, kept so a parser fix can rebuild the typed columns.';
COMMENT ON TABLE slacker_users IS
  'Users seen in the capture, resolved from users.info on demand.'"""),
    Step("0008-conversations-open-gap", """
ALTER TABLE slacker_conversations
  ADD COLUMN gap_newest text, ADD COLUMN gap_latest text;
COMMENT ON COLUMN slacker_conversations.gap_newest IS
  'While a sync from the cursor is unfinished: the newest ts it fetched, where the cursor moves once the gap below is closed.';
COMMENT ON COLUMN slacker_conversations.gap_latest IS
  'While a sync from the cursor is unfinished: the oldest ts it reached; everything from here to gap_newest is stored, and the next sync resumes below it.'"""),
]


def _tables():
    """The steps and version of the slacker_* tables, for the contract's
    `migrate` (and the manager's install-time migration)."""
    return STORE_STEPS, STORE_SCHEMA_MAJOR, STORE_SCHEMA_MINOR


def _store_refusal(exc: "DbError") -> NoReturn:
    _refuse(6 if exc.slug in _STORE_CONFIG_SLUGS else 5, exc.slug, exc.message,
            exc.hint)


def _from_store(name: str, value):
    if isinstance(value, bool):
        return value
    if isinstance(value, datetime.datetime):
        if name in _EPOCH_COLUMNS:
            return value.astimezone(datetime.timezone.utc).isoformat()
        return value.astimezone(datetime.timezone.utc).isoformat()
    if isinstance(value, memoryview):
        return bytes(value)
    return value


class _Row:
    """One result row, addressable by position and by column name."""

    __slots__ = ("_index", "_values")

    def __init__(self, index: dict, values: list):
        self._index = index
        self._values = values

    def __getitem__(self, key):
        if isinstance(key, (int, slice)):
            return self._values[key]
        return self._values[self._index[key]]

    def __iter__(self):
        return iter(self._values)

    def __len__(self) -> int:
        return len(self._values)

    def keys(self) -> list:
        return list(self._index)


def _row_factory(cursor):
    names = [column.name for column in (cursor.description or [])]
    index = {name: i for i, name in enumerate(names)}

    def make(values):
        return _Row(index, [_from_store(n, v) for n, v in zip(names, values)])
    return make


class _Store:
    """One store connection for one account. Every statement runs under one
    lock, and every write goes through `_writing`, which holds that lock for the
    whole transaction, so a capture write from the listener's loop is whole."""

    def __init__(self, conn, account: str, setting):
        import psycopg
        self.conn = conn
        self.account = account
        self.setting = setting
        self.schema = getattr(setting, "schema", None)
        self.write_lock = threading.RLock()
        self.write_depth = 0
        self._error = psycopg.Error

    def execute(self, sql: str, params=None):
        with self.write_lock:
            cursor = self.conn.cursor(row_factory=_row_factory)
            try:
                cursor.execute(sql, params if params else None)
            except self._error as exc:
                detail = (str(exc).strip().splitlines() or [type(exc).__name__])[0]
                _refuse(5, "store_failed",
                        f"the store refused a statement: {detail}",
                        "prove the store with `capabilities store doctor`, then retry")
            return cursor

    def close(self) -> None:
        with contextlib.suppress(Exception):
            self.conn.close()


@contextlib.contextmanager
def _writing(db: _Store):
    """One store write, whole. Nested writes join the transaction their caller
    opened, so a message row and the conversation cursor it advances commit
    together or not at all."""
    with db.write_lock:
        if db.write_depth:
            db.write_depth += 1
            try:
                yield
            finally:
                db.write_depth -= 1
            return
        with db.conn.transaction():
            db.write_depth += 1
            try:
                yield
            finally:
                db.write_depth -= 1


def _store_setting(root: Path | None = None):
    try:
        return resolve_setting(root if root is not None else _project_root())
    except DbError as exc:
        _store_refusal(exc)


def _open_store(cfg: dict) -> _Store:
    """The store for one connection's account, its tables migrated. The account
    is the workspace team id the connection binds, else the connection id, so a
    capture is never split and never confused between two workspaces."""
    account = cfg.get("account_binding") or cfg.get("id") or "default"
    setting = _store_setting()
    try:
        conn = connect(application_name=NAME, setting=setting, transaction=True)
    except DbError as exc:
        _store_refusal(exc)
    try:
        result = migrate(conn, NAME, STORE_STEPS, major=STORE_SCHEMA_MAJOR,
                         minor=STORE_SCHEMA_MINOR)
        conn.autocommit = True
    except DbError as exc:
        conn.close()
        _store_refusal(exc)
    except Exception as exc:
        conn.close()
        _refuse(5, "store_failed",
                f"the store could not be prepared: {type(exc).__name__}: {exc}",
                "prove the store with `capabilities store doctor`, then retry")
    for warning in getattr(result, "warnings", []) or []:
        _log(warning)
    db = _Store(conn, account, setting)
    if _get_meta(db, "schema") is None:
        with _writing(db):
            _set_meta(db, "schema", STORE_VERSION)
    return db


def _get_meta(db: _Store, key: str) -> str | None:
    row = db.execute(
        "SELECT value FROM slacker_meta WHERE account = %s AND key = %s",
        (db.account, key)).fetchone()
    return row["value"] if row else None


def _set_meta(db: _Store, key: str, value: str) -> None:
    db.execute(
        """INSERT INTO slacker_meta (account, key, value) VALUES (%s, %s, %s)
           ON CONFLICT (account, key) DO UPDATE SET value = excluded.value""",
        (db.account, key, value))


# --- Store writes: conversations, messages, users ----------------------------

def _iso_now() -> str:
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


def _upsert_conversation(db: _Store, conv: dict) -> None:
    """Record a conversation and its latest activity, keeping the sync cursor
    and any name a later read resolved."""
    cid = conv.get("id")
    if not cid:
        return
    last_ts = conv.get("latest", {}).get("ts") if isinstance(conv.get("latest"), dict) \
        else conv.get("last_ts")
    last_f = _ts_float(last_ts)
    with _writing(db):
        db.execute(
            f"""INSERT INTO slacker_conversations
                  (account, id, kind, name, user_id, is_member, is_archived,
                   last_ts, last_ts_at, updated_at)
                VALUES (%s,%s,%s,%s,%s,%s,%s,%s,
                        {_TS_PARAM if last_f is not None else 'NULL'}, now())
                ON CONFLICT (account, id) DO UPDATE SET
                  kind = excluded.kind,
                  name = COALESCE(NULLIF(excluded.name,''), slacker_conversations.name),
                  user_id = COALESCE(excluded.user_id, slacker_conversations.user_id),
                  is_member = excluded.is_member,
                  is_archived = excluded.is_archived,
                  last_ts = CASE WHEN excluded.last_ts IS NOT NULL
                       AND (slacker_conversations.last_ts IS NULL
                            OR excluded.last_ts > slacker_conversations.last_ts)
                       THEN excluded.last_ts ELSE slacker_conversations.last_ts END,
                  last_ts_at = GREATEST(slacker_conversations.last_ts_at,
                                        excluded.last_ts_at),
                  updated_at = now()""",
            [db.account, cid, _conv_kind(conv), _conv_name(conv) or "",
             conv.get("user"), bool(conv.get("is_member", conv.get("is_im") or
                                              conv.get("is_mpim"))),
             bool(conv.get("is_archived")), last_ts]
            + ([last_f] if last_f is not None else []))


def _advance_cursor(db: _Store, channel_id: str, oldest: str | None,
                    newest: str | None) -> None:
    """Widen the per-conversation covered range. The store keeps the widest
    [oldest, newest] it has seen, so a later sync asks only for what is newer.
    The conversation row is created if a sync reaches a channel before it was
    listed, so the cursor is never lost."""
    with _writing(db):
        db.execute(
            """INSERT INTO slacker_conversations
                 (account, id, synced_oldest, synced_newest, synced_at, updated_at)
               VALUES (%s, %s, %s, %s, now(), now())
               ON CONFLICT (account, id) DO UPDATE SET
                 synced_oldest = CASE WHEN slacker_conversations.synced_oldest IS NULL
                      OR (excluded.synced_oldest IS NOT NULL
                          AND excluded.synced_oldest < slacker_conversations.synced_oldest)
                      THEN excluded.synced_oldest
                      ELSE slacker_conversations.synced_oldest END,
                 synced_newest = CASE WHEN slacker_conversations.synced_newest IS NULL
                      OR (excluded.synced_newest IS NOT NULL
                          AND excluded.synced_newest > slacker_conversations.synced_newest)
                      THEN excluded.synced_newest
                      ELSE slacker_conversations.synced_newest END,
                 synced_at = now()""",
            (db.account, channel_id, oldest, newest))


def _message_values(channel_id: str, msg: dict, sync_type: str) -> dict | None:
    """The row a Slack message object becomes, or None when it carries no ts."""
    ts = msg.get("ts")
    if not ts:
        return None
    edited = msg.get("edited") or {}
    edited_f = _ts_float(edited.get("ts")) if edited else None
    reactions = {}
    for r in msg.get("reactions") or []:
        if r.get("name"):
            reactions[r["name"]] = list(r.get("users") or [])
    return {
        "channel_id": channel_id, "ts": ts, "ts_f": _ts_float(ts),
        "thread_ts": msg.get("thread_ts"),
        "user_id": msg.get("user") or msg.get("bot_id"),
        "type": msg.get("type") or "message",
        "subtype": msg.get("subtype"),
        "text": msg.get("text"),
        "edited_f": edited_f,
        "reply_count": int(msg.get("reply_count") or 0),
        "reactions": reactions,
        "raw": msg,
        "sync_type": sync_type,
    }


def _upsert_message(db: _Store, channel_id: str, msg: dict, sync_type: str,
                    authoritative: bool = False) -> bool:
    """Write one message, deduplicated on its ts. Returns True when the row was
    new. A history/backfill write never clobbers a live row (DO NOTHING); a live
    or edit write is authoritative over what it replaces."""
    v = _message_values(channel_id, msg, sync_type)
    if v is None:
        return False
    ts_at = _TS_PARAM if v["ts_f"] is not None else "NULL"
    edited_at = _TS_PARAM if v["edited_f"] is not None else "NULL"
    params = [db.account, v["channel_id"], v["ts"]]
    params += [v["ts_f"]] if v["ts_f"] is not None else []
    params += [v["thread_ts"], v["user_id"], v["type"], v["subtype"], v["text"]]
    params += [v["edited_f"]] if v["edited_f"] is not None else []
    params += [v["reply_count"], json.dumps(v["reactions"]),
               json.dumps(v["raw"]), v["sync_type"]]
    conflict = ("""DO UPDATE SET
                  text = excluded.text, subtype = excluded.subtype,
                  thread_ts = COALESCE(excluded.thread_ts, slacker_messages.thread_ts),
                  edited_at = excluded.edited_at,
                  reply_count = GREATEST(slacker_messages.reply_count,
                                         excluded.reply_count),
                  reactions = excluded.reactions, raw = excluded.raw,
                  sync_type = excluded.sync_type, captured_at = now()"""
                if authoritative else "DO NOTHING")
    with _writing(db):
        cur = db.execute(
            f"""INSERT INTO slacker_messages
                  (account, channel_id, ts, ts_at, thread_ts, user_id, type,
                   subtype, text, edited_at, reply_count, reactions, raw,
                   sync_type, captured_at)
                VALUES (%s,%s,%s,{ts_at},%s,%s,%s,%s,%s,{edited_at},%s,%s,%s,%s,now())
                ON CONFLICT (account, channel_id, ts) {conflict}
                RETURNING (xmax = 0) AS inserted""",
            params)
        row = cur.fetchone()
    return bool(row and row["inserted"]) if row else False


def _apply_edit(db: _Store, channel_id: str, msg: dict) -> None:
    """A message_changed event: the new text and edited time, over whatever is
    stored. If the row is unknown it is inserted, so an edit is never lost."""
    _upsert_message(db, channel_id, msg, "live", authoritative=True)


def _apply_replied(db: _Store, channel_id: str, parent: dict) -> None:
    """A message_replied event: Slack re-sends the thread's parent to say it
    gained a reply. Only the parent's reply metadata moves; its text and kind
    stay as stored. An unknown parent is stored from the event as it stands."""
    v = _message_values(channel_id, parent, "live")
    if v is None:
        return
    with _writing(db):
        cur = db.execute(
            """UPDATE slacker_messages SET
                 thread_ts = COALESCE(thread_ts, %s),
                 reply_count = GREATEST(reply_count, %s), captured_at = now()
               WHERE account = %s AND channel_id = %s AND ts = %s""",
            (v["thread_ts"], v["reply_count"], db.account, channel_id, v["ts"]))
        updated = cur.rowcount
    if not updated:
        _upsert_message(db, channel_id, parent, "live", authoritative=False)


def _apply_delete(db: _Store, channel_id: str, deleted_ts: str) -> None:
    with _writing(db):
        db.execute(
            """UPDATE slacker_messages SET deleted = true, captured_at = now()
               WHERE account = %s AND channel_id = %s AND ts = %s""",
            (db.account, channel_id, deleted_ts))


def _apply_reaction(db: _Store, channel_id: str, ts: str, name: str,
                    user: str, added: bool) -> None:
    """Add or remove one user's reaction on a message, in the {name: [users]}
    jsonb. A reaction on a message the capture has not seen is dropped: there is
    nothing to attach it to, and it will arrive with the message on backfill."""
    with _writing(db):
        row = db.execute(
            "SELECT reactions FROM slacker_messages "
            "WHERE account = %s AND channel_id = %s AND ts = %s FOR UPDATE",
            (db.account, channel_id, ts)).fetchone()
        if not row:
            return
        reactions = row["reactions"] or {}
        if isinstance(reactions, str):
            reactions = json.loads(reactions)
        users = list(reactions.get(name) or [])
        if added and user not in users:
            users.append(user)
        if not added and user in users:
            users.remove(user)
        if users:
            reactions[name] = users
        else:
            reactions.pop(name, None)
        db.execute(
            "UPDATE slacker_messages SET reactions = %s, captured_at = now() "
            "WHERE account = %s AND channel_id = %s AND ts = %s",
            (json.dumps(reactions), db.account, channel_id, ts))


def _upsert_user(db: _Store, user: dict) -> None:
    uid = user.get("id")
    if not uid:
        return
    profile = user.get("profile") or {}
    with _writing(db):
        db.execute(
            """INSERT INTO slacker_users
                 (account, id, name, real_name, display_name, is_bot, deleted,
                  updated_at)
               VALUES (%s,%s,%s,%s,%s,%s,%s, now())
               ON CONFLICT (account, id) DO UPDATE SET
                 name = excluded.name, real_name = excluded.real_name,
                 display_name = excluded.display_name, is_bot = excluded.is_bot,
                 deleted = excluded.deleted, updated_at = now()""",
            (db.account, uid, user.get("name"),
             profile.get("real_name") or user.get("real_name"),
             profile.get("display_name"), bool(user.get("is_bot")),
             bool(user.get("deleted"))))


# --- Live events -------------------------------------------------------------

def _handle_event(db: _Store, event: dict) -> dict | None:
    """Apply one session event to the store and say what it changed. Pure of the
    socket: the capture loop reads an event off the wire and hands it here, and
    the tests hand it the same shapes with no socket at all.

    Dedup is the store's: a message is keyed by its ts, so a redelivery after a
    reconnect updates in place and never doubles."""
    etype = event.get("type")
    if etype == "message":
        channel = event.get("channel")
        subtype = event.get("subtype")
        if not channel:
            return None
        if subtype == "message_changed" and isinstance(event.get("message"), dict):
            _apply_edit(db, channel, event["message"])
            return {"change": "edit", "channel": channel,
                    "ts": event["message"].get("ts")}
        if subtype == "message_replied" and isinstance(event.get("message"), dict):
            _apply_replied(db, channel, event["message"])
            return {"change": "replied", "channel": channel,
                    "ts": event["message"].get("ts")}
        if subtype == "message_deleted" and event.get("deleted_ts"):
            _apply_delete(db, channel, event["deleted_ts"])
            return {"change": "delete", "channel": channel,
                    "ts": event["deleted_ts"]}
        # A plain new message, a thread reply (carries thread_ts), or a
        # thread_broadcast — all are rows keyed by their ts.
        inserted = _upsert_message(db, channel, event, "live", authoritative=True)
        return {"change": "message" if inserted else "message_update",
                "channel": channel, "ts": event.get("ts"),
                "thread": event.get("thread_ts")}
    if etype in ("reaction_added", "reaction_removed"):
        item = event.get("item") or {}
        if item.get("type") == "message" and item.get("channel") and item.get("ts"):
            _apply_reaction(db, item["channel"], item["ts"],
                            event.get("reaction") or "", event.get("user") or "",
                            added=etype == "reaction_added")
            return {"change": etype, "channel": item["channel"], "ts": item["ts"]}
    return None


# --- Slack client ------------------------------------------------------------

def _slack():
    """slack_sdk's WebClient class and its error type, imported lazily so every
    non-network path (and every test) runs with no dependency present."""
    try:
        from slack_sdk import WebClient
        from slack_sdk.errors import SlackApiError
    except ImportError:
        _refuse(6, "driver_missing",
                "the Slack client library slack_sdk is not installed",
                f"run {NAME} through its own script header, which pins it")
    return WebClient, SlackApiError


class SlackClient:
    """The linked user's web session, carried as the web client carries it: the
    xoxc- token as a bearer and the `d` cookie beside it. Read calls only."""

    def __init__(self, cfg: dict):
        WebClient, self._err = _slack()
        self.cfg = cfg
        self.client = WebClient(
            token=cfg["token"],
            headers={"Cookie": f"d={cfg['cookie']}"})

    def _call(self, method: str, **kwargs) -> dict:
        try:
            return self.client.api_call(method, params={
                k: v for k, v in kwargs.items() if v is not None}).data
        except self._err as exc:
            self._raise(exc)

    def _raise(self, exc) -> NoReturn:
        resp = getattr(exc, "response", None)
        err = (resp.get("error") if resp is not None else None) or str(exc)
        if err in ("invalid_auth", "not_authed", "token_revoked",
                   "token_expired", "account_inactive"):
            _refuse(2, "invalid_auth",
                    f"the Slack session is not valid: {err}",
                    "the session expired or was signed out; link the "
                    "connection again")
        if err == "ratelimited":
            retry = None
            with contextlib.suppress(Exception):
                retry = resp.headers.get("Retry-After")
            _refuse(5, "rate_limited",
                    "Slack rate-limited the session"
                    + (f"; retry after {retry}s" if retry else ""))
        if err in ("channel_not_found", "not_in_channel", "thread_not_found"):
            _refuse(6, err, f"Slack: {err}",
                    "the session cannot see that conversation")
        if err == "missing_scope":
            _refuse(6, "missing_scope",
                    "the session lacks a scope this read needs",
                    "a web session normally carries the user's full view; "
                    "record this limitation")
        _refuse(5, "slack_error", f"Slack returned an error: {err}")

    def auth_test(self) -> dict:
        return self._call("auth.test")

    def team_info(self) -> dict:
        return self._call("team.info").get("team", {})

    def user_info(self, user: str) -> dict:
        return self._call("users.info", user=user).get("user", {})

    def conversations(self, types: str, limit: int = 1000):
        """The linked user's own conversations. users.conversations answers
        only those the user is in and omits is_member on a channel, so each is
        marked a member here."""
        cursor = None
        while True:
            data = self._call("users.conversations", types=types,
                              limit=min(limit, 1000), cursor=cursor,
                              exclude_archived=False)
            for conv in data.get("channels", []):
                yield {**conv, "is_member": True}
            cursor = (data.get("response_metadata") or {}).get("next_cursor")
            if not cursor:
                return

    def history(self, channel: str, oldest: str | None = None,
                latest: str | None = None, limit: int | None = 200,
                pages: int | None = 10):
        """Messages strictly between oldest and latest, in Slack's order (newest
        first), until `limit` messages or `pages` pages, or every one when both
        are None. Once consumed, `history_complete` says whether Slack had no
        more: only a complete fetch covers the whole range it asked for."""
        self.history_complete = False
        cursor = None
        seen = page = 0
        while pages is None or page < max(1, pages):
            page += 1
            data = self._call("conversations.history", channel=channel,
                              oldest=oldest, latest=latest,
                              limit=200 if limit is None else min(limit, 200),
                              cursor=cursor, inclusive=False)
            cursor = (data.get("response_metadata") or {}).get("next_cursor")
            more = bool(data.get("has_more") and cursor)
            messages = data.get("messages", [])
            for i, msg in enumerate(messages):
                yield msg
                seen += 1
                if limit is not None and seen >= limit:
                    self.history_complete = i == len(messages) - 1 and not more
                    return
            if not more:
                self.history_complete = True
                return

    def replies(self, channel: str, thread_ts: str, limit: int = 200):
        cursor = None
        while True:
            data = self._call("conversations.replies", channel=channel,
                              ts=thread_ts, limit=min(limit, 200), cursor=cursor)
            for msg in data.get("messages", []):
                yield msg
            cursor = (data.get("response_metadata") or {}).get("next_cursor")
            if not (data.get("has_more") and cursor):
                return

    def search(self, query: str, limit: int = 20, sort: str = "score"):
        """Messages matching `query` across every conversation the user can see,
        as Slack's own search answers it, until `limit` matches. Once consumed,
        `search_total` is the number Slack counts. A network failure is Slack
        being unreachable, so an empty answer always means no match."""
        self.search_total = 0
        page = 1
        seen = 0
        while True:
            try:
                data = self._call("search.messages", query=query,
                                  count=min(limit, 100), page=page, sort=sort,
                                  sort_dir="desc")
            except OSError as exc:
                _refuse(5, "slack_unreachable",
                        f"Slack could not be reached: {exc}",
                        "check the network and run the search again")
            found = data.get("messages") or {}
            self.search_total = found.get("total") or 0
            for match in found.get("matches") or []:
                yield match
                seen += 1
                if seen >= limit:
                    return
            paging = found.get("paging") or {}
            if page >= (paging.get("pages") or 1):
                return
            page += 1


# --- Reads -------------------------------------------------------------------

def _identity(cfg: dict, client: SlackClient, db: _Store | None = None) -> dict:
    """The linked user and workspace, proven by auth.test. Records them in meta
    when a store is open, and checks the connection's bindings."""
    auth = client.auth_test()
    out = {"ok": True, "connection": cfg["id"], "user_id": auth.get("user_id"),
           "user": auth.get("user"), "team_id": auth.get("team_id"),
           "team": auth.get("team"), "url": auth.get("url")}
    if cfg.get("team_id") and auth.get("team_id") \
            and cfg["team_id"] != auth["team_id"]:
        _refuse(6, "wrong_workspace",
                f"the session resolves to workspace {auth['team_id']!r}, not the "
                f"bound {cfg['team_id']!r}",
                "the connection's team_id and the session disagree")
    if cfg.get("expect_user"):
        want = cfg["expect_user"].lstrip("@")
        if want not in (auth.get("user_id"), auth.get("user")):
            _refuse(6, "wrong_user",
                    f"the session resolves to {auth.get('user')!r} "
                    f"({auth.get('user_id')}), not the expected {want!r}")
    if db is not None:
        with _writing(db):
            _set_meta(db, "user_id", auth.get("user_id") or "")
            _set_meta(db, "user", auth.get("user") or "")
            _set_meta(db, "team_id", auth.get("team_id") or "")
            _set_meta(db, "team", auth.get("team") or "")
    return out


def _row_to_message(row: _Row) -> dict:
    reactions = row["reactions"] or {}
    if isinstance(reactions, str):
        reactions = json.loads(reactions)
    return {"ts": row["ts"], "ts_at": row["ts_at"], "thread_ts": row["thread_ts"],
            "user": row["user_id"], "type": row["type"], "subtype": row["subtype"],
            "text": row["text"], "edited": bool(row["edited_at"]),
            "deleted": bool(row["deleted"]), "reply_count": row["reply_count"],
            "reactions": reactions}


def _store_messages(db: _Store, channel_id: str, limit: int,
                    oldest: str | None, latest: str | None,
                    thread_ts: str | None = None) -> list[dict]:
    where = ["account = %s", "channel_id = %s", "deleted = false"]
    params: list = [db.account, channel_id]
    if thread_ts is not None:
        where.append("thread_ts = %s")
        params.append(thread_ts)
    if oldest is not None:
        where.append("ts >= %s")
        params.append(oldest)
    if latest is not None:
        where.append("ts <= %s")
        params.append(latest)
    params.append(limit)
    rows = db.execute(
        f"SELECT * FROM slacker_messages WHERE {' AND '.join(where)} "
        f"ORDER BY ts DESC LIMIT %s", params).fetchall()
    return [_row_to_message(r) for r in reversed(rows)]


def _store_covers_newest(db: _Store, channel_id: str) -> str | None:
    row = db.execute(
        "SELECT synced_newest FROM slacker_conversations "
        "WHERE account = %s AND id = %s", (db.account, channel_id)).fetchone()
    return row["synced_newest"] if row else None


def _open_gap(db: _Store, channel_id: str) -> tuple[str | None, str | None]:
    """The unfinished part of a sync from the cursor, as (gap_newest,
    gap_latest), or (None, None) when no sync stopped short."""
    row = db.execute(
        "SELECT gap_newest, gap_latest FROM slacker_conversations "
        "WHERE account = %s AND id = %s", (db.account, channel_id)).fetchone()
    return (row["gap_newest"], row["gap_latest"]) if row else (None, None)


def _set_gap(db: _Store, channel_id: str, newest: str | None,
             latest: str | None) -> None:
    with _writing(db):
        db.execute(
            "UPDATE slacker_conversations SET gap_newest = %s, gap_latest = %s "
            "WHERE account = %s AND id = %s",
            (newest, latest, db.account, channel_id))


# --- Sync --------------------------------------------------------------------

def _fetch_into_store(db: _Store, client: SlackClient, channel_id: str,
                      sync_type: str, oldest: str | None, latest: str | None,
                      limit: int | None) -> dict:
    """Fetch one range of a conversation into the store, deduplicated on ts.
    The cursor moves only over coverage that joins what the store already
    covered: a fetch that stopped short of the stored cursor leaves it where it
    was, so the next sync still asks for the messages this one did not reach."""
    prior = _store_covers_newest(db, channel_id)
    fetched = new = 0
    oldest_seen = newest_seen = None
    for msg in client.history(channel_id, oldest=oldest, latest=latest,
                              limit=limit,
                              pages=None if limit is None
                              else max(1, (limit + 199) // 200)):
        fetched += 1
        if _upsert_message(db, channel_id, msg, sync_type, authoritative=False):
            new += 1
        ts = msg.get("ts")
        if ts:
            if newest_seen is None or ts > newest_seen:
                newest_seen = ts
            if oldest_seen is None or ts < oldest_seen:
                oldest_seen = ts
    joined = (prior is None
              or (oldest_seen is not None
                  and _ts_float(oldest_seen) <= _ts_float(prior))
              or (client.history_complete
                  and (oldest is None or _ts_float(oldest) <= _ts_float(prior))))
    if joined:
        _advance_cursor(db, channel_id, oldest_seen or oldest, newest_seen)
    return {"fetched": fetched, "new": new}


def _close_gap(db: _Store, client: SlackClient, channel_id: str,
               prior: str) -> dict:
    """Fetch every message newer than the cursor, resuming below what an
    unfinished earlier attempt already stored. The lower edge reached is kept
    as the fetch goes, so an attempt a refusal cuts short still moves the next
    one on, and the cursor moves to the gap's top only once the gap is closed."""
    newest, latest = _open_gap(db, channel_id)
    if latest is None:
        newest = None
    resumed = latest is not None
    fetched = new = 0
    try:
        for msg in client.history(channel_id, oldest=prior, latest=latest,
                                  limit=None, pages=None):
            fetched += 1
            if _upsert_message(db, channel_id, msg, "backfill",
                               authoritative=False):
                new += 1
            ts = msg.get("ts")
            if ts and (newest is None or ts > newest):
                newest = ts
            if ts and (latest is None or ts < latest):
                latest = ts
    finally:
        if not client.history_complete and latest is not None:
            _set_gap(db, channel_id, newest, latest)
    _advance_cursor(db, channel_id, None, newest)
    _set_gap(db, channel_id, None, None)
    return {"fetched": fetched, "new": new, "resumed": resumed}


def _sync_channel(db: _Store, client: SlackClient, channel_id: str,
                  full: bool, limit: int) -> dict:
    """Bring one conversation forward. With a stored cursor every message newer
    than it is fetched, however many, so a gap is closed whole or the cursor
    stays, and an attempt cut short resumes where it stopped; `limit` bounds
    only how far back a first sync or `--full` reaches."""
    prior = None if full else _store_covers_newest(db, channel_id)
    if prior is None:
        result = _fetch_into_store(db, client, channel_id, "backfill", None,
                                   None, limit)
    else:
        result = _close_gap(db, client, channel_id, prior)
        if result.pop("resumed"):
            # What arrived above the top of the attempt that was resumed.
            more = _close_gap(db, client, channel_id,
                              _store_covers_newest(db, channel_id))
            more.pop("resumed")
            result = {k: result[k] + more[k] for k in result}
    return {"channel": channel_id, **result}


def _member_channels(db: _Store) -> list[str]:
    rows = db.execute(
        "SELECT id FROM slacker_conversations "
        "WHERE account = %s AND is_member = true AND is_archived = false",
        (db.account,)).fetchall()
    return [r["id"] for r in rows]


# --- Verbs -------------------------------------------------------------------

def _check_connection(cfg: dict) -> dict:
    try:
        client = SlackClient(cfg)
        ident = _identity(cfg, client)
    except _Refusal as refusal:
        return refusal.as_result()
    return {"ok": True, "user": ident["user"], "user_id": ident["user_id"],
            "team": ident["team"], "team_id": ident["team_id"],
            "url": ident["url"]}


def cmd_doctor(reg: dict, wanted: str | None) -> None:
    """Every connection bare; one with --connection. Exit 0 only when every
    examined connection authorises and resolves."""
    _doctor_gate(_connections_report(), wanted)
    targets = [_select_connection(reg, wanted)] if wanted is not None \
        else list(reg["connections"].items())
    connections: dict = {}
    fail_exit = 0
    for cid, entry in targets:
        cfg, problem = _build_cfg(cid, entry)
        if problem:
            res = {"ok": False, "category": problem["exit"],
                   "error": problem["message"]}
            if problem.get("hint"):
                res["hint"] = problem["hint"]
        else:
            res = _check_connection(cfg)
        if not res.get("ok") and not fail_exit:
            fail_exit = res.get("category") or 5
        res.pop("category", None)
        connections[cid] = res
    _emit({"ok": fail_exit == 0, "connections": connections})
    if fail_exit:
        sys.exit(fail_exit)


def cmd_whoami(args) -> dict:
    cfg = get_config(args)
    client = SlackClient(cfg)
    db = _open_store(cfg) if not getattr(args, "no_store", False) else None
    ident = _identity(cfg, client, db)
    if db is not None:
        db.close()
    return ident


def cmd_conversations(args) -> dict:
    cfg = get_config(args)
    client = SlackClient(cfg)
    db = _open_store(cfg)
    types = args.types or "im,mpim,public_channel,private_channel"
    search = (args.search or "").lower()
    rows = []
    for conv in client.conversations(types=types, limit=1000):
        _upsert_conversation(db, conv)
        name = _conv_name(conv) or ""
        if search and search not in name.lower() and search not in (conv.get("id") or "").lower():
            continue
        rows.append({"id": conv.get("id"), "kind": _conv_kind(conv),
                     "name": name or None, "is_member": bool(conv.get("is_member",
                        conv.get("is_im") or conv.get("is_mpim"))),
                     "is_archived": bool(conv.get("is_archived")),
                     "user": conv.get("user")})
    rows.sort(key=lambda r: (not r["is_member"], r["kind"], r["name"] or r["id"]))
    if args.limit:
        rows = rows[:args.limit]
    db.close()
    return {"connection": cfg["id"], "count": len(rows), "conversations": rows}


def cmd_history(args) -> dict:
    cfg = get_config(args)
    channel = _normalize_channel_id(args.channel)
    db = _open_store(cfg)
    fetched = 0
    if args.fresh or _store_covers_newest(db, channel) is None:
        fetched = _fetch_into_store(db, SlackClient(cfg), channel, "history",
                                    args.oldest, args.latest,
                                    args.limit)["fetched"]
    messages = _store_messages(db, channel, args.limit, args.oldest, args.latest)
    db.close()
    return {"connection": cfg["id"], "channel": channel,
            "fetched_from_slack": fetched, "count": len(messages),
            "messages": messages}


def _thread_covered(stored: list[dict], thread_ts: str) -> bool:
    """Whether the stored thread already holds every reply its parent counts.
    A history sync stores the parent alone, so a parent with no stored replies
    is never taken as the whole thread."""
    parent = next((m for m in stored if m["ts"] == thread_ts), None)
    replies = len(stored) - (1 if parent else 0)
    return bool(parent and replies and replies >= (parent["reply_count"] or 0))


def cmd_thread(args) -> dict:
    cfg = get_config(args)
    channel = _normalize_channel_id(args.channel)
    db = _open_store(cfg)
    fetched = 0
    stored = _store_messages(db, channel, 1000, None, None, thread_ts=args.thread_ts)
    if args.fresh or not _thread_covered(stored, args.thread_ts):
        client = SlackClient(cfg)
        for msg in client.replies(channel, args.thread_ts, limit=1000):
            _upsert_message(db, channel, msg, "history", authoritative=False)
            fetched += 1
        stored = _store_messages(db, channel, 1000, None, None,
                                 thread_ts=args.thread_ts)
    db.close()
    return {"connection": cfg["id"], "channel": channel,
            "thread_ts": args.thread_ts, "fetched_from_slack": fetched,
            "count": len(stored), "messages": stored}


def _search_hit(match: dict) -> dict:
    """One search match as a row that names where it lives: the conversation,
    the ts, and the thread it sits in. Slack carries a reply's thread only in
    its permalink, so the thread is read from there when the match lacks it."""
    from urllib.parse import parse_qs, urlparse
    conv = match.get("channel") or {}
    thread_ts = match.get("thread_ts")
    if not thread_ts and match.get("permalink"):
        thread_ts = (parse_qs(urlparse(match["permalink"]).query)
                     .get("thread_ts") or [None])[0]
    ts_at = None
    if _ts_float(match.get("ts")) is not None:
        whole, _, frac = match["ts"].partition(".")
        ts_at = datetime.datetime.fromtimestamp(
            int(whole), datetime.timezone.utc).replace(
            microsecond=int((frac or "0")[:6].ljust(6, "0"))).isoformat()
    return {"channel": conv.get("id"), "channel_name": _conv_name(conv),
            "kind": _conv_kind(conv), "ts": match.get("ts"),
            "ts_at": ts_at, "thread_ts": thread_ts,
            "user": match.get("user"), "username": match.get("username"),
            "text": match.get("text"), "permalink": match.get("permalink")}


def cmd_search(args) -> dict:
    query = " ".join(args.query).strip()
    if not query:
        _refuse(6, "invalid_arguments", "a search query is required",
                f"run `{NAME} search <text>`")
    cfg = get_config(args)
    client = SlackClient(cfg)
    hits = [_search_hit(m) for m in client.search(query, args.limit, args.sort)]
    return {"connection": cfg["id"], "query": query,
            "total": client.search_total, "count": len(hits), "messages": hits}


def cmd_sync(args) -> dict:
    cfg = get_config(args)
    db = _open_store(cfg)
    client = SlackClient(cfg)
    if args.channel:
        channels = [_normalize_channel_id(args.channel)]
    else:
        for conv in client.conversations(
                types="im,mpim,public_channel,private_channel", limit=1000):
            _upsert_conversation(db, conv)
        channels = _member_channels(db)
    results = [_sync_channel(db, client, c, args.full, args.limit) for c in channels]
    db.close()
    return {"connection": cfg["id"], "channels": len(results),
            "new": sum(r["new"] for r in results), "detail": results}


# --- Live-capture service ----------------------------------------------------

def _service_home(cfg: dict) -> Path:
    account = cfg.get("account_binding") or cfg.get("id") or "default"
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", account)
    home = _STATE_HOME / NAME / safe / "service"
    home.mkdir(parents=True, exist_ok=True)
    return home


def _service_write(home: Path, name: str, payload: dict) -> None:
    (home / name).write_text(json.dumps(payload, ensure_ascii=False, indent=2))


def _service_read(home: Path, name: str) -> dict | None:
    try:
        return json.loads((home / name).read_text())
    except (OSError, ValueError):
        return None


# How long a realtime connection must hold before a reconnect starts again
# from the shortest backoff.
_CAPTURE_STEADY_SECONDS = 30.0

# The origin the web client's realtime socket carries.
_WEB_ORIGIN = "https://app.slack.com"


class _Capture:
    """The listener's state for one account: the store, the Slack client, the
    control files, and the backoff that closes a reconnect's gap through the
    sync cursor, so a drop doubles nothing and loses no channel message; a
    thread reply posted during the drop is not in Slack's channel history and
    is read with `thread --fresh`."""

    def __init__(self, cfg: dict):
        self.cfg = cfg
        self.home = _service_home(cfg)
        self.db: _Store | None = None
        self.client: SlackClient | None = None
        self.ws = None
        self.stop = threading.Event()
        self.events = 0
        self.last_event_at: str | None = None
        self.state = "starting"

    def health(self, state: str, extra: dict | None = None) -> None:
        self.state = state
        _service_write(self.home, "health.json", {
            "state": state, "pid": os.getpid(), "at": _iso_now(),
            "events": self.events, "last_event_at": self.last_event_at,
            **(extra or {})})

    def _backfill(self) -> None:
        """Close any gap since the last covered ts on every member channel.
        Dedup is the store's, so a message already captured live is not doubled."""
        assert self.db and self.client
        for conv in self.client.conversations(
                types="im,mpim,public_channel,private_channel", limit=1000):
            _upsert_conversation(self.db, conv)
        for channel in _member_channels(self.db):
            try:
                _sync_channel(self.db, self.client, channel, full=False, limit=500)
            except _Refusal as refusal:
                _log(f"backfill of {channel} deferred: {refusal.message}")

    def _ws_url(self) -> str:
        """The session's realtime gateway. The web client dials
        wss-primary.slack.com with the session token, and the socket carries the
        `d` cookie (`_ws_header`) and the web client's origin; the live trial
        found the gateway refuses the session without them, and refuses a
        gateway_server naming the team id."""
        token = self.cfg["token"]
        return (f"wss://wss-primary.slack.com/?token={token}"
                f"&slack_client=desktop&batch_presence_aware=1")

    def _ws_header(self) -> list[str]:
        return [f"Cookie: d={self.cfg['cookie']}"]

    def _on_message(self, _ws, raw: str) -> None:
        try:
            event = json.loads(raw)
        except ValueError:
            return
        change = _handle_event(self.db, event)
        if change:
            self.events += 1
            self.last_event_at = _iso_now()
            self.health(self.state)

    def run(self) -> int:
        """Foreground capture with reconnect/backoff. Returns the process exit
        code. SIGTERM ends it cleanly."""
        try:
            import websocket  # noqa: F401  (websocket-client)
        except ImportError:
            _refuse(6, "driver_missing",
                    "the websocket client library websocket-client is not installed",
                    f"run {NAME} through its own script header, which pins it")
        self.db = _open_store(self.cfg)
        self.client = SlackClient(self.cfg)
        _identity(self.cfg, self.client, self.db)
        signal.signal(signal.SIGTERM, lambda *_: self.stop.set())
        signal.signal(signal.SIGINT, lambda *_: self.stop.set())
        backoff = 2.0
        self.health("starting")
        while not self.stop.is_set():
            try:
                self._backfill()
                self.health("connecting")
                # Only a connection that held resets the backoff: a refused
                # handshake or a socket closed at once keeps doubling it.
                if self._listen() >= _CAPTURE_STEADY_SECONDS:
                    backoff = 2.0
            except _Refusal as refusal:
                if refusal.exit_code == 2:
                    self.health("unlinked", {"error": refusal.message})
                    _log(f"session no longer valid: {refusal.message}")
                    self.db.close()
                    return 7
                _log(f"capture error: {refusal.message}")
            except Exception as exc:   # a dropped socket, a transient fault
                _log(f"capture connection lost: {type(exc).__name__}: {exc}")
            if self.stop.is_set():
                break
            self.health("reconnecting", {"backoff": backoff})
            self.stop.wait(backoff)
            backoff = min(backoff * 2, 60.0)
        self.health("stopped")
        self.db.close()
        return 0

    def _listen(self) -> float:
        """Hold the realtime socket until it closes or fails, and return the
        seconds it was connected, 0 when the handshake failed. The gateway can
        accept the socket and then refuse the session with an error frame, so
        the connection counts from its first other frame (normally `hello`),
        not from the socket opening. A failure is logged by its kind and HTTP
        status or the gateway's error code, never its text, which can carry the
        request."""
        import websocket
        opened: list[float] = []
        errors: list[str] = []

        def on_error(_ws, exc) -> None:
            status = getattr(exc, "status_code", None)
            errors.append(type(exc).__name__
                          + (f" (HTTP {status})" if status else ""))

        def on_message(ws, raw: str) -> None:
            with contextlib.suppress(ValueError, AttributeError):
                frame = json.loads(raw)
                if frame.get("type") == "error":
                    error = frame.get("error")
                    error = error if isinstance(error, dict) else {"msg": error}
                    code = re.sub(r"[^A-Za-z0-9_.-]", "", str(error.get("msg") or ""))
                    status = re.sub(r"[^0-9]", "", str(error.get("code") or ""))
                    errors.append(f"gateway error {code or 'unknown'}"
                                  + (f" ({status})" if status else ""))
                    ws.close()
                    return
            if not opened and not errors:
                opened.append(time.monotonic())
                self.health("connected")
            self._on_message(ws, raw)

        self.ws = websocket.WebSocketApp(
            self._ws_url(), header=self._ws_header(), on_message=on_message,
            on_error=on_error)
        # run_forever returns on close or error; the outer loop reconnects.
        # The origin goes through websocket-client's own option: an Origin in
        # the header list would be sent beside the one the library adds.
        self.ws.run_forever(ping_interval=20, ping_timeout=10,
                            origin=_WEB_ORIGIN)
        reason = errors[-1] if errors else "no error reported"
        if not opened:
            _log(f"realtime handshake failed: {reason}")
            return 0.0
        held = time.monotonic() - opened[0]
        _log(f"realtime connection closed after {held:.0f}s: {reason}")
        return held


def _inventory(network: bool) -> dict:
    """What this capability holds on this machine, read from local state only:
    the linked accounts (one state home each) and the capture service's last
    health. Secret-free, no network, no store — the per-account message counts
    the store holds are deferred, since they need a project's database and a
    connection the inventory does not resolve."""
    root = _STATE_HOME / NAME
    accounts = sorted(p.name for p in root.iterdir()) if root.is_dir() else []
    service_state = "stopped"
    for name in accounts:
        health = _service_read(root / name / "service", "health.json")
        if health and health.get("state"):
            service_state = health["state"]
            break
    return {
        "metrics": [{"label": "linked accounts", "value": len(accounts)}],
        "items": [{"name": a, "kind": "linked_account"} for a in accounts],
        "service": {"state": service_state},
        "deferred": [{"label": "captured message counts",
                      "reason": "needs a project database and a connection; "
                                "read with `slacker history` or `sync`"}],
    }


def cmd_service(args) -> dict | None:
    sub = args.service_command
    if sub == "help":
        _emit(_SERVICE_HELP)
        return None
    cfg = get_config(args)
    home = _service_home(cfg)
    if sub == "init":
        _service_write(home, "owner.json",
                       {"connection": cfg["id"], "at": _iso_now()})
        return {"ok": True, "initialized": str(home)}
    if sub == "doctor":
        # Prove the store opens and the session authorises; report the last
        # health the listener wrote. The deploy doctor fails on neither here
        # because the pilot's `run` is foreground and self-checks at start.
        db = _open_store(cfg)
        client = SlackClient(cfg)
        ident = _identity(cfg, client, db)
        db.close()
        return {"ok": True, "connection": cfg["id"],
                "store_opened": True, "user": ident["user"],
                "team": ident["team"],
                "health": _service_read(home, "health.json")}
    if sub == "run":
        _read_only_gate(f"`{NAME} service run`")  # defensive; capture never writes
        code = _Capture(cfg).run()
        if code:
            sys.exit(code)
        return None
    if sub in ("start", "stop", "reload", "status", "logs"):
        health = _service_read(home, "health.json")
        if sub == "status":
            return {"connection": cfg["id"], "health": health,
                    "state": (health or {}).get("state", "unknown")}
        if sub == "logs":
            log = home / "daemon.log"
            return {"connection": cfg["id"],
                    "log": log.read_text()[-4000:] if log.exists() else ""}
        # start/stop/reload of a detached daemon is the deployment capability's
        # job in this pilot; the foreground `run` is the deploy command.
        return {"ok": False, "connection": cfg["id"],
                "note": f"`service {sub}` of a detached daemon is deferred; "
                        f"`service run` is the foreground deploy command, "
                        f"supervised by the deployment capability"}
    _die(6, "unknown_command", f"no service subcommand {sub!r}")


_SERVICE_HELP = (
    "slacker service — the bundled live-capture listener\n\n"
    "  service init [--connection ID]     Seed the service's control files\n"
    "  service run  [--connection ID]     Run the listener in the foreground\n"
    "                                     (the deploy command). Exit 7 when the\n"
    "                                     session is no longer linked.\n"
    "  service status [--connection ID]   The last health the listener wrote\n"
    "  service logs   [--connection ID]   The tail of the listener's log\n"
    "  service doctor [--connection ID]   Store and control-file readiness\n"
    "  service start|stop|reload          Deferred to the deployment capability\n")


# --- dispatch ----------------------------------------------------------------

import re  # noqa: E402  (used by _service_home; imported here to stay local)


class _Parser(argparse.ArgumentParser):
    """Usage errors leave through the envelope at exit 6, not argparse's 2,
    which this taxonomy reserves for credentials."""

    def error(self, message: str) -> NoReturn:
        _die(6, "invalid_arguments", f"{self.prog}: {message}",
             f"run `{NAME} help` for the verb's arguments")


def _positive_int(value: str) -> int:
    try:
        n = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError(f"{value!r} is not a whole number")
    if n < 1:
        raise argparse.ArgumentTypeError(f"{value!r} is not positive")
    return n


def _build_parser() -> argparse.ArgumentParser:
    p = _Parser(prog=NAME, allow_abbrev=False, add_help=False)
    p.add_argument("--connection", "-c")
    groups = p.add_subparsers(dest="command", required=True, parser_class=_Parser)

    def _leaf(name: str) -> argparse.ArgumentParser:
        sp = groups.add_parser(name, allow_abbrev=False)
        sp.add_argument("--connection", "-c")
        return sp

    _leaf("doctor")
    w = _leaf("whoami")
    w.add_argument("--no-store", action="store_true",
                   help="do not open or write the store")

    cv = _leaf("conversations")
    cv.add_argument("--types",
                    help="comma list of im,mpim,public_channel,private_channel")
    cv.add_argument("--search", "-s")
    cv.add_argument("--limit", "-n", type=_positive_int)

    h = _leaf("history")
    h.add_argument("channel")
    h.add_argument("--limit", "-n", type=_positive_int, default=100)
    h.add_argument("--oldest")
    h.add_argument("--latest")
    h.add_argument("--fresh", action="store_true",
                   help="fetch from Slack even when the store covers the request")

    t = _leaf("thread")
    t.add_argument("channel")
    t.add_argument("thread_ts")
    t.add_argument("--fresh", action="store_true")

    se = _leaf("search")
    se.add_argument("query", nargs="+")
    se.add_argument("--limit", "-n", type=_positive_int, default=20)
    se.add_argument("--sort", choices=["score", "timestamp"], default="score")

    sy = _leaf("sync")
    sy.add_argument("--channel", help="one channel id (default: every member channel)")
    sy.add_argument("--full", action="store_true",
                    help="re-fetch from the beginning, not only what is newer")
    sy.add_argument("--limit", "-n", type=_positive_int, default=1000)

    sv = _leaf("service")
    sv.add_argument("service_command",
                    choices=["init", "doctor", "run", "start", "stop", "reload",
                             "status", "logs", "help"])

    ln = _leaf("link")
    ln.add_argument("id", nargs="?",
                    help="the connection id to write (default: the workspace domain)")
    ln.add_argument("--workspace", "-w",
                    help="which signed-in workspace to link, by team id, domain or name")
    ln.add_argument("--events", action="store_true",
                    help="drive the ceremony as a JSON event stream on stdout/stdin")
    ln.add_argument("--global", dest="scope", action="store_const", const="global",
                    help="write the connection at global (machine-wide) scope")
    ln.add_argument("--project", dest="scope", action="store_const", const="project",
                    help="write it in this project's capabilities/ envelope")
    ln.add_argument("--machine", dest="scope", action="store_const", const="machine",
                    help="write the machine's connection (global scope)")
    ln.add_argument("--default", action="store_true",
                    help="make this the default connection")
    ln.add_argument("--replace", action="store_true",
                    help="re-link an existing connection id, writing over it")
    ln.add_argument("--timeout", type=_positive_int,
                    help=f"seconds to wait for sign-in (default {LINK_TIMEOUT})")
    return p


def main() -> None:
    _gate()
    argv = sys.argv[1:]

    # manifest carries the bundled service it declares, as whatsapp's does.
    if argv[:1] == ["manifest"]:
        _emit({**_manifest_core(), "service": SERVICE})
        return

    # `--connection <id>` is a global selector accepted anywhere on the line.
    wanted_conn: str | None = None
    cleaned: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--connection", "-c") and i + 1 < len(argv):
            wanted_conn = argv[i + 1]; i += 2; continue
        if a.startswith("--connection="):
            wanted_conn = a.split("=", 1)[1]; i += 1; continue
        cleaned.append(a); i += 1

    _contract(cleaned)   # contract verbs (help, connections, guide, ids, …)
    if not cleaned or cleaned[0] in ("help", "-h", "--help"):
        _cmd_help()
        return

    if cleaned[0] == "doctor":
        if len(cleaned) > 1:
            _die(6, "invalid_arguments",
                 f"doctor takes only --connection <id>, not {cleaned[1]!r}")
        reg, _ = _connections_registry()
        cmd_doctor(reg, wanted_conn)
        return

    args = _build_parser().parse_args(argv)
    handlers = {
        "whoami": cmd_whoami, "conversations": cmd_conversations,
        "history": cmd_history, "thread": cmd_thread, "search": cmd_search,
        "sync": cmd_sync,
        "service": cmd_service, "link": cmd_link,
    }
    handler = handlers.get(args.command)
    if handler is None:
        _die(6, "unknown_command", f"no handler for {args.command!r}")
    result = handler(args)
    if result is not None:
        _emit(result)


def _run() -> NoReturn:
    code = 0
    try:
        main()
    except _Refusal as refusal:
        try:
            _die(refusal.exit_code, refusal.code, refusal.message, refusal.hint)
        except SystemExit as exc:
            code = exc.code if isinstance(exc.code, int) else 1
    except SystemExit as exc:
        code = exc.code if isinstance(exc.code, int) else (0 if exc.code is None else 1)
    except BaseException as exc:
        traceback.print_exc()
        sys.stderr.write(json.dumps({"error": {
            "code": "unhandled", "message": f"{type(exc).__name__}: {exc}",
            "hint": "this is a defect in the capability; the traceback is above"}},
            ensure_ascii=False) + "\n")
        code = 1
    finally:
        for stream in (sys.stdout, sys.stderr):
            with contextlib.suppress(Exception):
                stream.flush()
        os._exit(code)


if __name__ == "__main__":
    import traceback  # noqa: E402
    _run()
