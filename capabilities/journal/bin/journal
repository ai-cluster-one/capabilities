#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "psycopg2-binary>=2.9",
# ]
# ///
"""journal — agent-first CLI for a PostgreSQL voice-journal store.

This tool is designed to be invoked by agents. Run `journal help` to load the
full usage contract on demand — do not rely on memorised knowledge of its
surface. It is a read + enrichment adapter over one PostgreSQL database holding
voice-journal entries and their embedding chunks. Entries arrive from the
consumer's own capture pipeline; this CLI never creates them.

It lists and filters entries, reads one in full, writes enrichment (summary,
type, language, tags, metadata) back, chunks a transcript for embedding, and
searches the store at three levels. It does NOT interpret journal content:
summaries and tags are generated by the host agent — the procedure is
`journal guide enrichment` — and written back through `update`.

CONNECTIONS
  Configuration requires an explicit connections registry. Each connection is
  one PostgreSQL database, optionally scoped to one author. Values resolve by
  the cascade (first non-empty wins):
    1. flags          --connection only (a secret never has a flag)
    2. project env    .env.local then .env, walking up from $CLAUDE_PROJECT_DIR (else cwd)
    3. user config    $XDG_CONFIG_HOME/journal/credentials.env (default ~/.config/journal/)
    4. process env    the keys below
  The project you're in wins; process env is the fallback (so a deployed host's
  injected env governs when no config file is present).

  Credential scope is `user` — install scaffolds the keys into
  ~/.config/journal/credentials.env:
    JOURNAL_DB_PASSWORD   secret — Postgres password (never on argv)
    JOURNAL_DB_HOST       Postgres host, e.g. db.<ref>.example.com
    JOURNAL_DB_PORT       optional; default 5432
    JOURNAL_DB_USER       optional; default postgres
    JOURNAL_DB_NAME       optional; default postgres
    JOURNAL_DB_SSLMODE    optional; default require (disable for local Postgres)

  The registry is ~/.config/journal/connections.json, or a project's
  capabilities/journal/connections.json (project first, first found
  authoritative, never merged):
    {
      "default": "<id>",
      "connections": {
        "<id>": {
          "db_host": "db.<ref>.example.com",
          "db_port": "5432",
          "db_user": "postgres",
          "db_name": "postgres",
          "db_sslmode": "require",
          "db_password_env": "JOURNAL_DB_PASSWORD",
          "user_id": "<author id>",
          "allow_write": true
        }
      }
    }
  Non-secret wiring sits literally in the entry; the password is named by
  env-key indirection (db_password_env) and resolves through the cascade. A
  field left out of the entry falls back to its JOURNAL_DB_* key, then to the
  default above. "user_id" is optional: when set, every listing and search
  scopes to that author unless --user or --all-users says otherwise.
  "allow_write": false makes the connection a read-only source — update, chunk
  and schema exit 4, and no flag or env var lifts the gate.

  Selection: --connection <id>, placed before the command. Unflagged, the
  registry's "default" pointer applies, else the sole entry; several entries
  without a pointer is refused as ambiguous.

DATABASE
  The store is the consumer's own PostgreSQL. Two tables back this CLI:
    journal         id (uuid PK), created_at, message (the transcript),
                    user_id, summary, char_count, type, language,
                    tags (text[]), metadata (jsonb), enriched_at
    journal_chunks  id (bigserial PK), journal_id (uuid FK → journal,
                    ON DELETE CASCADE), chunk_index, content, token_count,
                    metadata (jsonb), created_at; UNIQUE (journal_id, chunk_index)
  `journal schema` creates both tables and their indexes if absent (idempotent
  DDL, additive only). `journal doctor` proves the credentials, the tables, and
  reports how much of the store is enriched. Standing the store up from
  scratch — provisioning Postgres, wiring the connection, the failure ladder —
  is the runbook `journal guide setup`.

COMMANDS
  list [--language LANG] [--has-summary true|false] [--has-tags true|false]
       [--tag TAG] [--since ISO] [--until ISO] [--limit N]
       [--user ID | --all-users]
        Entries newest first, metadata only, summaries truncated to 200 chars.
        --limit defaults to 50; --limit 0 lifts it. The reply carries the
        matched and total counts, so a truncated page is visible as such.
        `--has-summary false` is the enrichment worklist.
  read <id>
        One entry in full: every column, the untruncated summary, and the
        transcript.
  update <id> [--summary TEXT] [--type TEXT] [--language CODE]
              [--tags "a,b,c"] [--metadata JSON]
        Write enrichment back. --tags replaces the whole array (empty string
        clears it); --metadata merges a JSON object into the metadata column.
        Setting summary, type, language or tags stamps enriched_at.
  chunk <id> [--max-chars N] [--overlap N]
        Split the transcript into chunks and store them, replacing any chunks
        the entry already has. Chunks split on paragraphs, then size
        (default 1500 chars, 200 overlap), and inherit the entry's language and
        tags as metadata — so chunk after enrichment, not before.
  search <query> [--user ID | --all-users]
        Level 1 — match across summary, tags and type. Fast, metadata only.
  scan <query> [--user ID | --all-users]
        Level 2 — match summaries only; returns a snippet around each match.
  grep <query> [--max-matches N] [--user ID | --all-users]
        Level 3 — match transcript bodies; returns matched lines (default 5
        per entry).
  schema
        Create the journal and journal_chunks tables and their indexes if
        absent (idempotent DDL; existing tables and data are untouched).

CONTRACT VERBS
  help                  This usage contract, verbatim.
  doctor [--connection ID]
                        Cheapest authenticated round-trip per connection:
                        proves the credentials, the tables, and the counts.
  connections           Resolution report — every connection, every value, its
                        winning tier and source, secrets masked. Local only.
  stub                  The one-line awareness text.
  manifest [--json]     The machine-readable declaration.
  guide [<topic>]       Upstream guide menu / one guide's body, fetched live.
  ids list|get|set|rm   The project identifiers envelope, managed.
  refs                  The project's reference files, from front-matter.

I/O CONTRACT
  Success is JSON on stdout. Failure is {"error": {"code","message","hint"?,
  "status"?}} on stderr; the exit code carries the category.

EXIT CODES
  0 success   2 auth (missing/rejected database credentials)
  3 not found (unknown entry id, missing table)
  4 policy refusal (capability policy, or a write verb on a read-only connection)
  5 server/network (database unreachable, timeout)
  6 input/validation (bad argument, malformed JSON, ambiguous connection)
"""

import argparse
import json
import os
import sys
import uuid
from datetime import datetime
from pathlib import Path
from typing import NoReturn

import psycopg2
from psycopg2.extras import Json

# ── Declaration ────────────────────────────────────────────────────────────────

NAME = "journal"
SUMMARY = ("Journal CLI over a PostgreSQL store — list and read voice-journal "
           "entries, write enrichment back, chunk transcripts for embedding, "
           "and search the store at three levels.")
SCOPE = "user"      # personal-account tool: one human, one journal store
CRED_KEYS = [       # a registry entry supplies these per connection
    {"key": "JOURNAL_DB_PASSWORD", "secret": True, "required": True,
     "note": "Postgres password; a connection names its own key via db_password_env"},
    {"key": "JOURNAL_DB_HOST", "secret": False, "required": True,
     "note": "Postgres host, e.g. db.<ref>.example.com"},
    {"key": "JOURNAL_DB_PORT", "secret": False, "required": False,
     "note": "Postgres port (default 5432)"},
    {"key": "JOURNAL_DB_USER", "secret": False, "required": False,
     "note": "Postgres user (default postgres)"},
    {"key": "JOURNAL_DB_NAME", "secret": False, "required": False,
     "note": "Postgres database (default postgres)"},
    {"key": "JOURNAL_DB_SSLMODE", "secret": False, "required": False,
     "note": "SSL mode (default require; disable for a local non-TLS Postgres)"},
]
WRITE_VERBS = {"update", "chunk", "schema"}     # verbs that mutate the store
WRITE_DEFAULT = True    # writes stay inside a database the consumer owns
