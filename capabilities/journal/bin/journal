# ── Connections ─────────────────────────────────────────────────────────────────

DB_FIELDS = (   # (entry field, env key fallback, default, required)
    ("db_host", "JOURNAL_DB_HOST", None, True),
    ("db_port", "JOURNAL_DB_PORT", "5432", False),
    ("db_user", "JOURNAL_DB_USER", "postgres", False),
    ("db_name", "JOURNAL_DB_NAME", "postgres", False),
    ("db_sslmode", "JOURNAL_DB_SSLMODE", "require", False),
)


def _field_value(entry: dict, field: str, env_key: str, default: str | None,
                 reg_path) -> tuple[str | None, str | None, object]:
    """One home for a non-secret field's resolution — the entry's literal value,
    else the cascade under its env key, else the declared default. Both the
    connection builder and the report read through here, so the value doctor
    uses and the value `connections` prints can never disagree."""
    literal = entry.get(field)
    if literal not in (None, ""):
        return str(literal), "connection", reg_path
    value, tier, source = _resolve_env_key(env_key)
    if value:
        return value, tier, source
    if default is not None:
        return default, "default", None
    return None, None, None


def _build_conn(cid: str, entry: dict | None,
                reg_path) -> tuple[dict | None, dict | None]:
    """Materialize one connection. Returns (conn, problem) — problem is an error
    dict ({"exit","code","message","hint"?}) instead of a die, so doctor can
    report every connection rather than stopping at the first."""
    entry = entry if isinstance(entry, dict) else {}
    db = {}
    for field, env_key, default, required in DB_FIELDS:
        value, _tier, _source = _field_value(entry, field, env_key, default, reg_path)
        if required and not value:
            return None, {
                "exit": 6, "code": "incomplete_connection",
                "message": f"connection {cid!r} resolves no {field}",
                "hint": f"set {field!r} on the entry in the registry, or {env_key} "
                        f"through the cascade — `{NAME} guide setup`"}
        db[field] = value
    pw_env = entry.get("db_password_env")
    if not pw_env:
        return None, {
            "exit": 6, "code": "no_secret_env",
            "message": f"connection {cid!r} is missing: db_password_env",
            "hint": 'name the env key holding the password, e.g. '
                    '"db_password_env": "JOURNAL_DB_PASSWORD"'}
    db_password, _, _ = _resolve_env_key(pw_env)
    if not db_password:
        return None, {
            "exit": 2, "code": "missing_secret",
            "message": f"env var {pw_env} (for connection {cid!r}) unset",
            "hint": f"set it in the project's .env / .env.local, "
                    f"{CREDENTIALS_ENV}, or the environment"}
    user_id = entry.get("user_id")
    return {"id": cid,
            "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT)),
            "db_password": db_password,
            "user_id": str(user_id) if user_id not in (None, "") else None,
            **db}, None


def _resolve_conn(args) -> dict:
    reg, reg_path = _connections_registry()
    cid, entry = _select_connection(reg, getattr(args, "connection", None))
    conn, problem = _build_conn(cid, entry, reg_path)
    if problem:
        _die(problem["exit"], problem["code"], problem["message"], problem.get("hint"))
    return conn


def _connections_report() -> dict:
    """The resolution report — every connection, every value, its winning tier
    and source, secrets masked. Local only: no network, no login attempt."""
    reg, _ = _connections_registry()
    conns = reg["connections"]
    report: dict = {
        "default": reg.get("default") or (next(iter(conns)) if len(conns) == 1 else None),
        "connections": {}}
    for cid, entry in conns.items():
        entry = entry if isinstance(entry, dict) else {}
        origin = reg["sources"][cid]
        keys = []
        for field, env_key, default, required in DB_FIELDS:
            value, tier, source = _field_value(entry, field, env_key, default, origin)
            keys.append(_key_report(field, False, required, value, tier, source))
        pw_env = entry.get("db_password_env")
        if pw_env:
            value, tier, source = _resolve_env_key(pw_env)
            keys.append(_key_report(pw_env, True, True, value, tier, source))
        else:
            keys.append(_key_report("db_password_env", False, True, None, None, None))
        user_id = entry.get("user_id")
        keys.append(_key_report(
            "user_id", False, False,
            str(user_id) if user_id not in (None, "") else None,
            "connection" if user_id not in (None, "") else None,
            origin if user_id not in (None, "") else None))
        report["connections"][cid] = {
            "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT)),
            "keys": keys}
    return report


def _cmd_connections() -> None:
    _emit(_connections_report())


# ── Database ────────────────────────────────────────────────────────────────────


def _db_connect(conn: dict):
    try:
        return psycopg2.connect(
            host=conn["db_host"], port=conn["db_port"], dbname=conn["db_name"],
            user=conn["db_user"], password=conn["db_password"],
            sslmode=conn["db_sslmode"], connect_timeout=15,
        )
    except psycopg2.OperationalError as e:
        msg = str(e).lower()
        if "password" in msg or "authentication" in msg or "role" in msg:
            _die(2, "db_auth", f"database authentication failed: {e}".strip(),
                 f"check db_user and the db_password_env key for connection "
                 f"{conn['id']!r} — `{NAME} guide setup`")
        _die(5, "db_unreachable", f"cannot reach database: {e}".strip(),
             f"check db_host / db_port / db_sslmode for connection "
             f"{conn['id']!r} — `{NAME} guide setup`")


# ── Helpers ─────────────────────────────────────────────────────────────────────


def _iso(dt) -> str | None:
    return dt.isoformat() if dt else None


def _entry_id(value: str) -> str:
    try:
        return str(uuid.UUID(str(value)))
    except (ValueError, AttributeError, TypeError):
        _die(6, "bad_id", f"entry id must be a UUID, got {value!r}",
             f"`{NAME} list` prints the ids")


def _parse_ts(value: str | None, flag: str):
    if value is None:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except (ValueError, AttributeError):
        _die(6, "bad_timestamp", f"{flag} is not an ISO timestamp: {value!r}",
             "e.g. 2026-01-31 or 2026-01-31T14:00:00Z")


def _truncate(text: str | None, max_chars: int = SUMMARY_PREVIEW) -> str | None:
    """Trim to a sentence boundary where one is near the cut, else hard-trim."""
    if not text or len(text) <= max_chars:
        return text or None
    cut = text[:max_chars]
    stop = cut.rfind(". ")
    if stop > max_chars // 2:
        return cut[:stop + 1]
    return cut.rstrip() + "…"


def _estimate_tokens(text: str) -> int:
    """Rough estimate: ~4 chars per token for mixed-script content."""
    return max(1, len(text) // 4)


def _scope(args, conn: dict) -> str | None:
    """The author a listing is scoped to: --all-users lifts the scope, --user
    overrides it, else the connection's declared user_id (None when absent)."""
    if getattr(args, "all_users", False):
        return None
    return getattr(args, "user", None) or conn.get("user_id")


def _scoped(where: list, params: list, args, conn: dict) -> str | None:
    scope = _scope(args, conn)
    if scope:
        where.append("user_id = %s")
        params.append(scope)
    return scope


def _where(conditions: list) -> str:
    return ("WHERE " + " AND ".join(conditions)) if conditions else ""


def _row_preview(row) -> dict:
    eid, created, chars, etype, lang, summary, tags, enriched = row
    return {"id": str(eid), "created_at": _iso(created), "chars": chars,
            "type": etype, "language": lang, "tags": list(tags or []),
            "enriched_at": _iso(enriched), "summary": _truncate(summary)}


PREVIEW_COLUMNS = ("id, created_at, char_count, type, language, summary, tags, "
                   "enriched_at")


def _totals(cur, scope: str | None) -> dict:
    if scope:
        cur.execute("""SELECT count(*), count(summary), count(enriched_at)
                       FROM journal WHERE user_id = %s""", (scope,))
    else:
        cur.execute("SELECT count(*), count(summary), count(enriched_at) FROM journal")
    total, with_summary, enriched = cur.fetchone()
    return {"entries": total, "with_summary": with_summary, "enriched": enriched}


# ── Domain verbs ────────────────────────────────────────────────────────────────


def cmd_list(args, conn) -> None:
    where: list = []
    params: list = []
    scope = _scoped(where, params, args, conn)
    if args.language:
        where.append("language = %s")
        params.append(args.language)
    if args.has_summary is not None:
        where.append("summary IS NOT NULL" if args.has_summary else "summary IS NULL")
    if args.has_tags is not None:
        where.append("array_length(tags, 1) > 0" if args.has_tags
                     else "array_length(tags, 1) IS NULL")
    if args.tag:
        where.append("%s = ANY(tags)")
        params.append(args.tag)
    since = _parse_ts(args.since, "--since")
    if since:
        where.append("created_at >= %s")
        params.append(since)
    until = _parse_ts(args.until, "--until")
    if until:
        where.append("created_at <= %s")
        params.append(until)
    if args.limit < 0:
        _die(6, "bad_limit", "--limit must be 0 (no limit) or a positive integer")

    db = _db_connect(conn)
    cur = db.cursor()
    cur.execute(f"SELECT count(*) FROM journal {_where(where)}", params)
    matched = cur.fetchone()[0]
    cur.execute(
        f"""SELECT {PREVIEW_COLUMNS} FROM journal {_where(where)}
            ORDER BY created_at DESC {'LIMIT %s' if args.limit else ''}""",
        params + ([args.limit] if args.limit else []))
    entries = [_row_preview(r) for r in cur.fetchall()]
    totals = _totals(cur, scope)
    cur.close(); db.close()
    _emit({"connection": conn["id"], "user_id": scope, "matched": matched,
           "shown": len(entries), "store": totals, "entries": entries})


def cmd_read(args, conn) -> None:
    entry_id = _entry_id(args.id)
    db = _db_connect(conn)
    cur = db.cursor()
    cur.execute(
        """SELECT id, created_at, user_id, message, char_count, type, language,
                  summary, tags, metadata, enriched_at
           FROM journal WHERE id = %s""", (entry_id,))
    row = cur.fetchone()
    if not row:
        cur.close(); db.close()
        _die(3, "not_found", f"no journal entry {entry_id}")
    cur.execute("SELECT count(*) FROM journal_chunks WHERE journal_id = %s", (entry_id,))
    chunks = cur.fetchone()[0]
    cur.close(); db.close()
    eid, created, user_id, message, chars, etype, lang, summary, tags, metadata, enriched = row
    _emit({"id": str(eid), "created_at": _iso(created), "user_id": user_id,
           "chars": chars if chars is not None else (len(message) if message else 0),
           "type": etype, "language": lang, "tags": list(tags or []),
           "metadata": metadata or {}, "enriched_at": _iso(enriched),
           "chunks": chunks, "summary": summary, "message": message})


def cmd_update(args, conn) -> None:
    entry_id = _entry_id(args.id)
    updates: list = []
    params: list = []
    written: list = []
    if args.summary is not None:
        updates.append("summary = %s")
        params.append(args.summary)
        written.append("summary")
    if args.entry_type is not None:
        updates.append("type = %s")
        params.append(args.entry_type)
        written.append("type")
    if args.language is not None:
        updates.append("language = %s")
        params.append(args.language)
        written.append("language")
    if args.tags is not None:
        tags = [t.strip() for t in args.tags.split(",") if t.strip()]
        updates.append("tags = %s")
        params.append(tags)
        written.append("tags")
    if args.metadata_json is not None:
        try:
            extra = json.loads(args.metadata_json)
        except ValueError as e:
            _die(6, "bad_json", f"--metadata is not valid JSON: {e}")
        if not isinstance(extra, dict):
            _die(6, "bad_json", "--metadata must be a JSON object")
        updates.append("metadata = COALESCE(metadata, '{}'::jsonb) || %s")
        params.append(Json(extra))
        written.append("metadata")
    if not updates:
        _die(6, "input", "nothing to update",
             "pass --summary, --type, --language, --tags, or --metadata")
    if written != ["metadata"]:
        updates.append("enriched_at = now()")

    db = _db_connect(conn)
    cur = db.cursor()
    cur.execute(f"UPDATE journal SET {', '.join(updates)} WHERE id = %s "
                "RETURNING enriched_at", params + [entry_id])
    row = cur.fetchone()
    if not row:
        db.rollback()
        cur.close(); db.close()
        _die(3, "not_found", f"no journal entry {entry_id}")
    db.commit()
    cur.close(); db.close()
    _emit({"id": entry_id, "updated": written, "enriched_at": _iso(row[0])})


def _hard_split(text: str, budget: int) -> list:
    """One block that overruns the budget, split down to size — on line breaks
    where it has them, then on a hard boundary. A transcript written as one
    unbroken wall of text still chunks."""
    if len(text) <= budget:
        return [text]
    pieces: list = []
    current = ""
    for line in text.splitlines():
        while len(line) > budget:
            if current:
                pieces.append(current)
                current = ""
            pieces.append(line[:budget])
            line = line[budget:]
        if current and len(current) + len(line) + 1 > budget:
            pieces.append(current)
            current = line
        else:
            current = (current + "\n" + line) if current else line
    if current:
        pieces.append(current)
    return pieces


def _split_chunks(message: str, max_chars: int, overlap: int) -> list:
    """Paragraphs first, then size — so a chunk breaks where the speaker did.
    The budget leaves room for the overlap a chunk carries forward."""
    budget = max(1, max_chars - overlap)
    blocks: list = []
    for para in (p.strip() for p in message.split("\n\n")):
        if para:
            blocks.extend(_hard_split(para, budget))
    chunks: list = []
    current = ""
    for block in blocks:
        if current and len(current) + len(block) + 2 > max_chars:
            chunks.append(current.strip())
            tail = current[-overlap:] if overlap > 0 else ""
            current = (tail + "\n\n" + block) if tail else block
        else:
            current = (current + "\n\n" + block) if current else block
    if current.strip():
        chunks.append(current.strip())
    return chunks or [message.strip()]


def cmd_chunk(args, conn) -> None:
    entry_id = _entry_id(args.id)
    if args.max_chars < 1:
        _die(6, "bad_input", "--max-chars must be a positive integer")
    if args.overlap < 0 or args.overlap >= args.max_chars:
        _die(6, "bad_input", "--overlap must be 0 or more and below --max-chars")

    db = _db_connect(conn)
    cur = db.cursor()
    cur.execute("SELECT message, language, tags FROM journal WHERE id = %s", (entry_id,))
    row = cur.fetchone()
    if not row:
        cur.close(); db.close()
        _die(3, "not_found", f"no journal entry {entry_id}")
    message, lang, tags = row
    if not message or not message.strip():
        cur.close(); db.close()
        _die(6, "empty_transcript", f"entry {entry_id} carries no transcript")

    chunks = _split_chunks(message, args.max_chars, args.overlap)
    meta: dict = {}
    if lang:
        meta["language"] = lang
    if tags:
        meta["tags"] = list(tags)
    cur.execute("DELETE FROM journal_chunks WHERE journal_id = %s", (entry_id,))
    replaced = cur.rowcount
    for index, text in enumerate(chunks):
        cur.execute(
            """INSERT INTO journal_chunks (journal_id, chunk_index, content,
                                           token_count, metadata)
               VALUES (%s, %s, %s, %s, %s)""",
            (entry_id, index, text, _estimate_tokens(text), Json(meta)))
    db.commit()
    cur.close(); db.close()
    _emit({"id": entry_id, "count": len(chunks), "replaced": replaced,
           "metadata": meta,
           "chunks": [{"index": i, "chars": len(c), "tokens": _estimate_tokens(c)}
                      for i, c in enumerate(chunks)]})


def cmd_search(args, conn) -> None:
    where: list = ["(summary ILIKE %s OR array_to_string(tags, ' ') ILIKE %s "
                   "OR type ILIKE %s)"]
    like = f"%{args.query}%"
    params: list = [like, like, like]
    scope = _scoped(where, params, args, conn)
    db = _db_connect(conn)
    cur = db.cursor()
    cur.execute(f"SELECT {PREVIEW_COLUMNS} FROM journal {_where(where)} "
                "ORDER BY created_at DESC", params)
    entries = [_row_preview(r) for r in cur.fetchall()]
    cur.close(); db.close()
    _emit({"connection": conn["id"], "user_id": scope, "query": args.query,
           "level": "metadata", "matched": len(entries), "entries": entries})


def _snippet(text: str, query: str, radius: int = 40) -> str:
    pos = text.lower().find(query.lower())
    if pos < 0:
        return _truncate(text, radius * 2) or ""
    start, end = max(0, pos - radius), min(len(text), pos + len(query) + radius)
    out = text[start:end].replace("\n", " ")
    return ("…" if start else "") + out + ("…" if end < len(text) else "")


def cmd_scan(args, conn) -> None:
    where: list = ["summary ILIKE %s"]
    params: list = [f"%{args.query}%"]
    scope = _scoped(where, params, args, conn)
    db = _db_connect(conn)
    cur = db.cursor()
    cur.execute(f"SELECT id, created_at, summary FROM journal {_where(where)} "
                "ORDER BY created_at DESC", params)
    rows = cur.fetchall()
    cur.close(); db.close()
    _emit({"connection": conn["id"], "user_id": scope, "query": args.query,
           "level": "summary", "matched": len(rows),
           "entries": [{"id": str(eid), "created_at": _iso(created),
                        "snippet": _snippet(summary or "", args.query)}
                       for eid, created, summary in rows]})


def cmd_grep(args, conn) -> None:
    if args.max_matches < 1:
        _die(6, "bad_input", "--max-matches must be a positive integer")
    where: list = ["message ILIKE %s"]
    params: list = [f"%{args.query}%"]
    scope = _scoped(where, params, args, conn)
    db = _db_connect(conn)
    cur = db.cursor()
    cur.execute(f"SELECT id, created_at, message FROM journal {_where(where)} "
                "ORDER BY created_at DESC", params)
    rows = cur.fetchall()
    cur.close(); db.close()
    needle = args.query.lower()
    entries = []
    for eid, created, message in rows:
        lines = [ln.strip() for ln in (message or "").splitlines()
                 if needle in ln.lower()]
        entries.append({
            "id": str(eid), "created_at": _iso(created), "matches": len(lines),
            "lines": [_truncate(ln, 200) for ln in lines[:args.max_matches]]})
    _emit({"connection": conn["id"], "user_id": scope, "query": args.query,
           "level": "transcript", "matched": len(entries), "entries": entries})


SCHEMA_DDL = """
CREATE TABLE IF NOT EXISTS journal (
    id          uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    created_at  timestamptz NOT NULL DEFAULT now(),
    message     text NOT NULL,
    user_id     text NOT NULL,
    summary     text,
    char_count  integer,
    type        text,
    language    text,
    tags        text[],
    metadata    jsonb NOT NULL DEFAULT '{}'::jsonb,
    enriched_at timestamptz
);
CREATE TABLE IF NOT EXISTS journal_chunks (
    id          bigserial PRIMARY KEY,
    journal_id  uuid NOT NULL REFERENCES journal(id) ON DELETE CASCADE,
    chunk_index smallint NOT NULL,
    content     text NOT NULL,
    token_count integer,
    metadata    jsonb NOT NULL DEFAULT '{}'::jsonb,
    created_at  timestamptz NOT NULL DEFAULT now(),
    UNIQUE (journal_id, chunk_index)
);
CREATE INDEX IF NOT EXISTS idx_journal_created_at ON journal (created_at DESC);
CREATE INDEX IF NOT EXISTS idx_journal_user_id ON journal (user_id);
CREATE INDEX IF NOT EXISTS idx_journal_tags ON journal USING gin (tags);
CREATE INDEX IF NOT EXISTS idx_journal_chunks_journal_id
    ON journal_chunks (journal_id);
"""


def cmd_schema(args, conn) -> None:
    db = _db_connect(conn)
    cur = db.cursor()
    cur.execute(SCHEMA_DDL)
    db.commit()
    cur.close(); db.close()
    _emit({"ok": True, "tables": ["journal", "journal_chunks"],
           "indexes": ["idx_journal_created_at", "idx_journal_user_id",
                       "idx_journal_tags", "idx_journal_chunks_journal_id"]})


# ── doctor ──────────────────────────────────────────────────────────────────────


def _check_connection(conn: dict) -> dict:
    out: dict = {"db_host": conn["db_host"], "db_name": conn["db_name"],
                 "user_id": conn["user_id"]}
    try:
        db = psycopg2.connect(
            host=conn["db_host"], port=conn["db_port"], dbname=conn["db_name"],
            user=conn["db_user"], password=conn["db_password"],
            sslmode=conn["db_sslmode"], connect_timeout=15)
    except psycopg2.OperationalError as e:
        msg = str(e).lower()
        cat = 2 if ("password" in msg or "authentication" in msg or "role" in msg) else 5
        return out | {"ok": False, "category": cat, "error": f"database: {str(e).strip()}"}
    try:
        cur = db.cursor()
        try:
            out["store"] = _totals(cur, conn["user_id"])
            cur.execute("SELECT count(*) FROM journal_chunks")
            out["store"]["chunks"] = cur.fetchone()[0]
            out["schema"] = "present"
        except psycopg2.errors.UndefinedTable as e:
            return out | {"ok": False, "category": 3, "schema": "missing",
                          "error": f"a required table is missing: {str(e).strip()}",
                          "hint": f"run `{NAME} schema` to create them "
                                  f"(`{NAME} guide setup` for the full runbook)"}
        finally:
            cur.close()
            db.close()
    except psycopg2.Error as e:
        return out | {"ok": False, "category": 5, "error": f"database error: {str(e).strip()}"}
    return out | {"ok": True}


def cmd_doctor(args) -> None:
    _doctor_gate(_connections_report(), getattr(args, "connection", None))
    reg, reg_path = _connections_registry()
    wanted = getattr(args, "connection", None)
    targets = [_select_connection(reg, wanted)] if wanted \
        else list(reg["connections"].items())
    connections: dict = {}
    fail_exit = 0
    for cid, entry in targets:
        conn, problem = _build_conn(cid, entry, reg_path)
        if problem:
            res = {"ok": False, "category": problem["exit"], "error": problem["message"]}
            if problem.get("hint"):
                res["hint"] = problem["hint"]
        else:
            res = _check_connection(conn)
        if not res.get("ok") and not fail_exit:
            fail_exit = res.get("category") or 5
        res.pop("category", None)
        connections[cid] = res
    _emit({"ok": fail_exit == 0, "connections": connections})
    if fail_exit:
        sys.exit(fail_exit)


# ── main ────────────────────────────────────────────────────────────────────────


def _add_scope(parser) -> None:
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--user", default=None,
                       help="scope to one author id (overrides the connection's user_id)")
    group.add_argument("--all-users", dest="all_users", action="store_true",
                       help="lift the connection's author scope")


def _bool_flag(value: str) -> bool:
    return str(value).lower() in ("true", "1", "yes")


def main() -> None:
    _gate()                      # every verb passes the effective policy gate first
    _contract(sys.argv[1:])      # contract verbs; help/doctor/domain fall through

    p = argparse.ArgumentParser(
        prog=NAME, description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--connection", default=None,
                   help="connection id (optional with a default pointer or a sole connection)")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("help")
    d = sub.add_parser("doctor")
    d.add_argument("--connection", default=None)

    ls = sub.add_parser("list")
    ls.add_argument("--language")
    ls.add_argument("--has-summary", dest="has_summary", type=_bool_flag, default=None)
    ls.add_argument("--has-tags", dest="has_tags", type=_bool_flag, default=None)
    ls.add_argument("--tag")
    ls.add_argument("--since")
    ls.add_argument("--until")
    ls.add_argument("--limit", type=int, default=DEFAULT_LIMIT)
    _add_scope(ls)

    rd = sub.add_parser("read"); rd.add_argument("id")

    up = sub.add_parser("update")
    up.add_argument("id")
    up.add_argument("--summary")
    up.add_argument("--type", dest="entry_type")
    up.add_argument("--language")
    up.add_argument("--tags")
    up.add_argument("--metadata", dest="metadata_json")

    ch = sub.add_parser("chunk")
    ch.add_argument("id")
    ch.add_argument("--max-chars", dest="max_chars", type=int, default=1500)
    ch.add_argument("--overlap", type=int, default=200)

    sr = sub.add_parser("search"); sr.add_argument("query"); _add_scope(sr)
    sc = sub.add_parser("scan"); sc.add_argument("query"); _add_scope(sc)
    gr = sub.add_parser("grep")
    gr.add_argument("query")
    gr.add_argument("--max-matches", dest="max_matches", type=int, default=5)
    _add_scope(gr)

    sub.add_parser("schema")

    args = p.parse_args()

    if args.cmd == "help":
        sys.stdout.write((__doc__ or "").lstrip("\n")); return
    if args.cmd == "doctor":
        cmd_doctor(args); return

    conn = _resolve_conn(args)
    _write_gate(conn["id"], conn["allow_write"], args.cmd)

    dispatch = {
        "list": cmd_list, "read": cmd_read, "update": cmd_update,
        "chunk": cmd_chunk, "search": cmd_search, "scan": cmd_scan,
        "grep": cmd_grep, "schema": cmd_schema,
    }
    try:
        dispatch[args.cmd](args, conn)
    except psycopg2.errors.UndefinedTable as e:
        _die(3, "schema_missing", f"a required table is missing: {str(e).strip()}",
             f"run `{NAME} schema` to create journal and journal_chunks")
    except psycopg2.OperationalError as e:
        _die(5, "db_error", f"database connection error: {str(e).strip()}")
    except psycopg2.Error as e:
        _die(5, "db_error", f"database error: {str(e).strip()}")


if __name__ == "__main__":
    main()
