#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "capabilities-contract>=0.12,<1",
# ]
# ///
"""rclonec — a credential harness around the official `rclone` binary. It resolves one
named connection into an rclone remote, injects it as configuration, and forwards your
command verbatim to `rclone`. rclonec owns auth and readiness; the command surface
stays rclone's own.

USAGE
  rclonec <command> [args...]   Forward to `rclone <command> [args...]` with the selected
                                connection defined as a remote. Address the remote by the
                                connection id: `rclonec lsjson gdrive:Reports`.
  rclonec connections           Where every connection's values resolve from (tier,
                                source, secrets masked). Local only.
  rclonec doctor [--connection <id>]
                                Prove rclone is present and the connection reaches its
                                backend — every connection, or one.
  rclonec help                  Print this contract.

Contract commands (the same on every capability; rclonec's own, never forwarded):
  rclonec stub                                  One-line awareness text.
  rclonec manifest --json                       Machine-readable declaration.
  rclonec guide [<topic>]                       Guide topics / one guide body.
  rclonec ids list|get <l>|set <l> <v>|rm <l>   The project identifiers envelope.
           [--note <text>]
  rclonec refs                                  Menu of the project's reference files.
  rclonec inventory [--network]                 What this capability holds in
                                                this project (--network adds
                                                remote detail).

Agent-invoked. Run `rclonec help` to reload this contract; run `rclone help` (the real
binary) for the full command surface — rclonec does NOT re-document or re-map it.

MODEL
  rclonec never maps, renames, or enumerates rclone commands. It is a thin configuration
  and auth shim: it materializes ONE remote from the selected connection, points
  RCLONE_CONFIG at the null device so no config file is read or written, and execs
  `rclone`. stdout, stderr and the exit code are rclone's, passed through untouched, so
  streaming, --json, progress and colors behave exactly as in rclone itself.

  The child process knows exactly one remote — the selected connection. A connection
  declared for Google Drive therefore cannot reach S3: that name is not defined in the
  environment the child is given. The containment is a property of that environment,
  not a check rclonec performs.

  Because the config lives only in the child's environment, rclone refreshes an expiring
  OAuth token in memory and persists nothing; the next run refreshes again from the
  credential it was given. Nothing is written to disk, so the same connection runs
  identically on a laptop and on a server.

  rclone is not vendored. rclonec runs the `rclone` on PATH when there is one. Otherwise
  the first verb that needs rclone fetches rclone's own standalone build for this
  platform, checked against the release's SHA256SUMS, into
  $XDG_STATE_HOME/rclonec/programs/rclone, as the user and without root, and every later
  run uses it. `rclonec doctor` reports the path it resolved and the version it found, so
  a missing or shadowed binary is diagnosed in one run rather than inferred.

CONNECTIONS
  Configuration requires an explicit connections registry, even for one connection. An
  entry names its rclone backend `type`, its non-secret `options`, and the env keys
  holding its secrets. The id becomes the remote name, so it must be usable as one:
  letters, digits and underscore only.

    {
      "default": "<id>",
      "connections": {
        "<id>": {
          "type": "drive",
          "options": {"scope": "drive", "impersonate": "<user@domain>",
                      "export_formats": "md,csv"},
          "secret_env": {"service_account_credentials": "<ENV_KEY>"},
          "allow_write": true
        }
      }
    }

  Every key under `options` and `secret_env` is an rclone backend option for that `type`,
  spelled as rclone spells it (`rclone help backend <type>` prints the set). rclonec
  passes them through and keeps no list of its own, so a backend option added upstream
  works here the day it ships.

  Secrets are named by env key and resolve through the standard cascade — project
  .env(.local), then user config, then process env. A secret must not touch argv, so
  there is deliberately no flag for one.

  `allow_write: false` makes the connection read-only. Verbs that mutate the remote exit
  4, and so does a forwarded transfer whose DESTINATION is this remote; reading from it
  stays available. Nothing in the cascade lifts the gate.

  `check_path` names the path under the remote that `doctor` lists to prove the
  connection, in place of the remote's top level - a bucket, or `bucket/prefix`, for a
  key scoped to one bucket that may not list them all. It is rclonec's own field, sits
  beside `options` rather than in it, and never reaches rclone's configuration; without
  it doctor lists `<id>:`.

  Outside any project, connections and doctor are machine reads: they use the
  machine's own connections read-only, unless a grant switched one off; every
  other verb that needs a connection is refused there.
"""

import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path
from typing import NoReturn

NAME = "rclonec"
SUMMARY = ("Credential harness around the official `rclone` binary — resolves one "
           "named connection into a single rclone remote (Google Drive, Amazon S3, "
           "Cloudflare R2, Backblaze B2, Dropbox, OneDrive, Box, SFTP, WebDAV and "
           "rclone's other backends), injects it as configuration, and forwards your "
           "command straight to `rclone` (everything but rclonec's own verbs passes "
           "through untouched); the command surface is `rclone help`.")
SCOPE = "project"   # credential scope: "project" | "user"
# A connection names its own secret env keys, because which secrets exist depends on the
# backend it declares; there is no fixed set to declare here (see deviations.md).
CRED_KEYS: list = []

# What a person is asked for (SHEBANG.md, "What a person is asked for"):
# a connection entry's own fields, which `connection add` writes.
CONN_FIELDS = [{'key': 'type',
  'label': 'Backend',
  'help': 'The rclone backend type, e.g. drive or s3.',
  'type': 'string',
  'required': True},
 {'key': 'options',
  'label': 'Options',
  'help': "The backend's literal rclone options.",
  'type': 'object',
  'required': False},
 {'key': 'secret_env',
  'label': 'Secret options',
  'help': 'Maps each secret rclone option to the env key that holds its value, e.g. '
          'token.',
  'type': 'object',
  'required': False},
 {'key': 'check_path',
  'label': 'Doctor check path',
  'help': 'The path under the remote doctor lists instead of its top level, e.g. the '
          'one bucket a scoped key may reach.',
  'type': 'string',
  'required': False}]
WRITE_DEFAULT = True    # a connection points at a store the consumer owns
MACHINE_READS = ("connections", "doctor")   # outside any project, read-only on the machine's connections
DOCS_BASE = ("https://raw.githubusercontent.com/ai-cluster-one/capabilities/"
             "main/capabilities/rclonec/guides/")
STATE = False       # the child writes no config and rclonec mints nothing
INVENTORY = None     # or {"network": "none"|"optional"|"required"} with an _inventory(network) builder
POST_INSTALL: list = []

_CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
CREDENTIALS_ENV = _CONFIG_HOME / NAME / "credentials.env"
_STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state"))

RCLONE = "rclone"
DOCTOR_TIMEOUT = 60.0
# The programs rclonec needs that the operating system does not carry (SHEBANG.md,
# `programs`): one on PATH is used, otherwise rclonec fetches its own into PROGRAMS_DIR.
PROGRAMS = [{"name": RCLONE,
             "feature": "every command rclonec forwards to rclone, and doctor's proof "
                        "of each connection"}]
PROGRAMS_DIR = _STATE_HOME / NAME / "programs"
RCLONE_DOWNLOADS = "https://downloads.rclone.org/"
FETCH_TIMEOUT = 300.0
# The id becomes an rclone remote name and an environment variable fragment, so it is
# held to the intersection of what both accept.
REMOTE_ID = re.compile(r"^[A-Za-z0-9_]+$")

# Verbs that mutate whatever path they are pointed at. Membership is enough to refuse.
WRITE_VERBS = {
    "delete", "deletefile", "purge", "rmdir", "rmdirs", "mkdir", "touch",
    "settier", "cleanup", "dedupe", "link", "rcat", "mount", "nfsmount",
}
# Verbs that read and never mutate. A verb in neither set is treated as a write.
READ_VERBS = {
    "about", "cat", "check", "checksum", "cryptcheck", "hashsum", "listremotes",
    "ls", "lsd", "lsf", "lsjson", "lsl", "md5sum", "sha1sum", "size", "tree",
    "version", "backend",
}
# Verbs taking SOURCE then DESTINATION: gated on which side this remote is on.
DIRECTIONAL_VERBS = {"copy", "copyto", "move", "moveto", "sync", "copyurl"}
# Of those, the ones that also empty the source.
SRC_MUTATING_VERBS = {"move", "moveto"}
# `backend` is read or write by its subcommand, never wholesale.
BACKEND_READ_SUBCOMMANDS = {"query", "get", "exportformats", "importformats", "drives"}
# Flags whose VALUE is a destination rclone writes to, whatever the positional args say.
DEST_VALUE_FLAGS = {"--backup-dir", "--suffix-keep-extension"}
assert not (READ_VERBS & WRITE_VERBS), "a verb is a read or a write, never both"

# The shared capability code is the capabilities-contract library's, bound here
# into this script's namespace (SHEBANG.md, "The contract verbs").
from capabilities_contract.capability import bind as _contract_bind

_contract_bind(globals(), "core")

_contract_bind(globals(), "store")

_contract_bind(globals(), "connections")

# --- Connections (capability-specific) --------------------------------------

def _entry_of(raw) -> dict:
    return raw if isinstance(raw, dict) else {}


def _secret_map(entry: dict) -> dict:
    """`secret_env` is a map of rclone option name -> env key holding its value."""
    raw = entry.get("secret_env")
    return raw if isinstance(raw, dict) else {}


def _options_of(entry: dict) -> dict:
    raw = entry.get("options")
    return raw if isinstance(raw, dict) else {}


def _connections_report() -> dict:
    """The resolution report — every connection, every value, its winning tier and
    source, secrets masked. Local only: no network, no backend reached."""
    reg, _ = _connections_registry()
    report: dict = {"default": None, "connections": {}}
    if reg is None:
        return report
    conns = reg["connections"]
    report["default"] = reg.get("default") or \
        (next(iter(conns)) if len(conns) == 1 else None)
    for cid, raw in conns.items():
        entry = _entry_of(raw)
        origin = reg["sources"][cid]
        rows = [_key_report("type", False, True, entry.get("type"), "connection", origin)]
        for opt, value in sorted(_options_of(entry).items()):
            rows.append(_key_report(opt, False, False, str(value), "connection", origin))
        secrets = _secret_map(entry)
        if not secrets:
            rows.append(_key_report("secret_env", False, True, None, None, None))
        for opt, env_key in sorted(secrets.items()):
            value, tier, source = _resolve_env_key(env_key)
            rows.append(_key_report(env_key, True, True, value, tier, source))
        report["connections"][cid] = {
            "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT)),
            "remote": f"{cid}:",
            "keys": rows}
    return report


def _cmd_connections() -> None:
    _emit(_connections_report())


def _build_cfg(cid: str, entry: dict | None) -> tuple[dict | None, dict | None]:
    """Materialize one connection into an rclone remote definition. Returns
    (cfg, problem) — problem is an error dict rather than a die, so doctor reports
    every connection instead of stopping at the first broken one."""
    if entry is None:
        return None, {
            "exit": 6, "code": "connection_required",
            "message": f"connection {cid!r} carries no definition",
            "hint": "an rclone remote needs a declared backend; add the entry to "
                    "connections.json with at least a 'type'"}
    if not REMOTE_ID.match(cid):
        return None, {
            "exit": 6, "code": "bad_connection_id",
            "message": f"connection id {cid!r} cannot be an rclone remote name",
            "hint": "use letters, digits and underscore only — the id becomes the "
                    "remote you address on the command line"}
    backend = entry.get("type")
    if not backend:
        return None, {
            "exit": 6, "code": "no_type",
            "message": f"connection {cid!r} is missing 'type'",
            "hint": "name the rclone backend, e.g. \"drive\" or \"s3\"; "
                    "`rclone help backends` lists them"}
    check_path = entry.get("check_path")
    if check_path is not None and not isinstance(check_path, str):
        return None, {
            "exit": 6, "code": "bad_check_path",
            "message": f"connection {cid!r} has a 'check_path' that is not a string",
            "hint": "name the path doctor lists under the remote, e.g. \"bucket\" or "
                    "\"bucket/prefix\""}
    secrets: dict = {}
    for opt, env_key in _secret_map(entry).items():
        value = _resolve_env_key(env_key)[0]
        if not value:
            return None, {
                "exit": 2, "code": "missing_secret",
                "message": f"env var {env_key} (for {opt!r} on connection {cid!r}) is unset",
                "hint": f"set {env_key} in the project's .env / .env.local or the "
                        f"environment"}
        secrets[opt] = value
    return {"id": cid, "type": backend, "options": _options_of(entry),
            "secrets": secrets, "check_path": check_path or "",
            "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT))}, None


# ── rclone invocation ───────────────────────────────────────────────────────

def _child_env(cfg: dict) -> dict:
    """The child's whole rclone configuration, and nothing else. RCLONE_CONFIG points at
    the null device so no file is read or written, and inherited RCLONE_* variables are
    dropped so ambient environment can neither redirect the remote nor lift a gate."""
    env = {k: v for k, v in os.environ.items() if not k.startswith("RCLONE_")}
    env["RCLONE_CONFIG"] = os.devnull
    prefix = f"RCLONE_CONFIG_{cfg['id'].upper()}_"
    env[prefix + "TYPE"] = str(cfg["type"])
    for opt, value in cfg["options"].items():
        env[prefix + str(opt).upper()] = str(value)
    for opt, value in cfg["secrets"].items():
        env[prefix + str(opt).upper()] = str(value)
    return env


def _rclone_path() -> str | None:
    """The rclone on PATH, else the one rclonec fetched, else None."""
    own = PROGRAMS_DIR / RCLONE
    return shutil.which(RCLONE) or (str(own) if os.access(own, os.X_OK) else None)


def _fetch_rclone() -> str:
    """Fetch rclone's own standalone build for this platform into PROGRAMS_DIR and
    return its path. The archive is checked against the release's SHA256SUMS before
    the binary is unpacked; nothing runs as root and no package manager is asked.
    Raises RuntimeError naming what failed."""
    import hashlib
    import io
    import platform
    import urllib.request
    import zipfile
    system = {"linux": "linux", "darwin": "osx"}.get(sys.platform)
    arch = {"x86_64": "amd64", "amd64": "amd64", "aarch64": "arm64",
            "arm64": "arm64"}.get(platform.machine().lower())
    if not system or not arch:
        raise RuntimeError(f"rclone publishes no build rclonec fetches for "
                           f"{sys.platform}/{platform.machine()}")

    def get(url: str) -> bytes:
        # downloads.rclone.org refuses urllib's own User-Agent with 403.
        request = urllib.request.Request(url, headers={"User-Agent": NAME})
        try:
            with urllib.request.urlopen(request, timeout=FETCH_TIMEOUT) as response:
                return response.read()
        except OSError as e:
            raise RuntimeError(f"could not fetch {url}: {e}") from None

    version = get(RCLONE_DOWNLOADS + "version.txt").decode().split()[-1]
    if not re.fullmatch(r"v\d+\.\d+\.\d+", version):
        raise RuntimeError(f"{RCLONE_DOWNLOADS}version.txt names no version: {version!r}")
    stem = f"rclone-{version}-{system}-{arch}"
    sums = get(f"{RCLONE_DOWNLOADS}{version}/SHA256SUMS").decode(errors="replace")
    wanted = next((line.split()[0] for line in sums.splitlines()
                   if line.strip().endswith(f"  {stem}.zip")), None)
    if not wanted:
        raise RuntimeError(f"{version}/SHA256SUMS lists no {stem}.zip")
    archive = get(f"{RCLONE_DOWNLOADS}{version}/{stem}.zip")
    if hashlib.sha256(archive).hexdigest() != wanted:
        raise RuntimeError(f"{stem}.zip does not match its SHA256SUMS line")
    try:
        binary = zipfile.ZipFile(io.BytesIO(archive)).read(f"{stem}/{RCLONE}")
    except (KeyError, zipfile.BadZipFile) as e:
        raise RuntimeError(f"{stem}.zip holds no {stem}/{RCLONE}: {e}") from None
    target = PROGRAMS_DIR / RCLONE
    partial = PROGRAMS_DIR / f".{RCLONE}.{os.getpid()}.partial"
    try:
        PROGRAMS_DIR.mkdir(parents=True, exist_ok=True)
        partial.write_bytes(binary)
        partial.chmod(0o755)
        os.replace(partial, target)
    except OSError as e:
        try:
            partial.unlink(missing_ok=True)
        except OSError:
            pass
        raise RuntimeError(f"could not write {target}: {e}") from None
    return str(target)


def _ensure_rclone() -> tuple[str | None, str | None]:
    """The rclone to run, fetched on first use: (path, None), or (None, why not)."""
    found = _rclone_path()
    if found:
        return found, None
    try:
        return _fetch_rclone(), None
    except RuntimeError as e:
        return None, str(e)


def _require_rclone() -> str:
    found, problem = _ensure_rclone()
    if not found:
        _die(5, "rclone_not_found",
             f"the `{RCLONE}` binary is not on PATH and could not be fetched: {problem}",
             f"put rclone on PATH (https://rclone.org/install/), or let rclonec fetch it "
             f"into {PROGRAMS_DIR} once the network reaches {RCLONE_DOWNLOADS}; "
             f"`{NAME} doctor` reports the path once it resolves")
    return found


def _rclone_version(rclone: str = RCLONE) -> str | None:
    try:
        proc = subprocess.run([rclone, "version"], capture_output=True, text=True,
                              timeout=DOCTOR_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired):
        return None
    first = (proc.stdout or "").strip().splitlines()
    return first[0].strip() if first else None


# ── the write gate over a forwarded surface ─────────────────────────────────

_VALUE_FLAGS_CACHE: set | None = None


def _value_taking_flags() -> set:
    """Which rclone flags consume the next argument. Asked of the binary rather than
    transcribed here, so the classification cannot drift from the rclone installed."""
    global _VALUE_FLAGS_CACHE
    if _VALUE_FLAGS_CACHE is not None:
        return _VALUE_FLAGS_CACHE
    rclone, _ = _ensure_rclone()
    if not rclone:
        _VALUE_FLAGS_CACHE = set()
        return _VALUE_FLAGS_CACHE
    try:
        proc = subprocess.run([rclone, "help", "flags"], capture_output=True, text=True,
                              timeout=DOCTOR_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired):
        _VALUE_FLAGS_CACHE = set()
        return _VALUE_FLAGS_CACHE
    found: set = set()
    for line in (proc.stdout or "").splitlines():
        spec = re.split(r"\s{2,}", line.strip(), maxsplit=1)[0]
        if not spec.startswith("-"):
            continue
        toks = spec.replace(",", " ").split()
        if not toks or toks[-1].startswith("-"):
            continue        # no type word trails the names: the flag is a boolean
        found.update(t for t in toks[:-1] if t.startswith("-"))
    _VALUE_FLAGS_CACHE = found
    return found


def _positionals(args: list[str], value_flags: set) -> list[str]:
    """The positional arguments, with flags and the values they consume removed."""
    out: list[str] = []
    i = 0
    passthrough = False
    while i < len(args):
        a = args[i]
        if passthrough:
            out.append(a); i += 1; continue
        if a == "--":
            passthrough = True; i += 1; continue
        if a.startswith("-"):
            if "=" in a:
                i += 1; continue
            if a in value_flags and i + 1 < len(args):
                i += 2; continue
            i += 1; continue
        out.append(a); i += 1
    return out


def _refuse_read_only(cid: str, what: str, hint: str) -> NoReturn:
    _read_only_gate(f"a write through connection {cid!r} ({what})")
    _die(4, "read_only",
         f"connection {cid!r} does not allow writes; {what}",
         hint + " Do not lift the gate yourself — ask the user; granting is "
                "`allow_write: true` on this connection in connections.json.")


def _addresses_remote(token: str, cid: str) -> bool:
    """rclone remote names set through the environment are case-insensitive."""
    return token.lower().startswith(f"{cid.lower()}:")


def _forward_gate(cid: str, allow_write: bool, argv: list[str]) -> None:
    """Policy from the committed registry; nothing in the cascade lifts it.

    rclone's transfer verbs are directional — the same word reads or writes depending
    on which side this remote is on — so the gate is decided on argument position, not
    on the verb alone. This is the one place rclonec reasons about a surface it
    otherwise treats as opaque (see deviations.md)."""
    verb = argv[0]
    if allow_write:
        return
    _write_gate(cid, allow_write, verb)          # verbs that mutate whatever they touch

    if verb == "backend":
        sub = next((a for a in argv[1:] if not a.startswith("-")), None)
        if sub not in BACKEND_READ_SUBCOMMANDS:
            _refuse_read_only(
                cid, f"`backend {sub or ''}`".rstrip() + " may mutate the remote",
                "`backend " + "`, `".join(sorted(BACKEND_READ_SUBCOMMANDS)) + "` read.")
        return

    if verb in DIRECTIONAL_VERBS:
        value_flags = _value_taking_flags()
        if not value_flags:
            _refuse_read_only(
                cid, f"`{verb}` could not be classified because rclone did not answer "
                     "`rclone help flags`",
                "a transfer is refused rather than guessed at when its destination "
                "cannot be determined.")
        for i, a in enumerate(argv):
            if a in DEST_VALUE_FLAGS and i + 1 < len(argv) \
                    and _addresses_remote(argv[i + 1], cid):
                _refuse_read_only(cid, f"`{a}` writes to this remote",
                                  "point it at another destination.")
            if "=" in a and a.split("=", 1)[0] in DEST_VALUE_FLAGS \
                    and _addresses_remote(a.split("=", 1)[1], cid):
                _refuse_read_only(cid, f"`{a.split('=', 1)[0]}` writes to this remote",
                                  "point it at another destination.")
        positional = _positionals(argv[1:], value_flags)
        if positional and _addresses_remote(positional[-1], cid):
            _refuse_read_only(cid, f"`{verb}` would write to this remote "
                                   f"({positional[-1]} is the destination)",
                              "reading from it is available; transfer the other way.")
        if verb in SRC_MUTATING_VERBS and \
                any(_addresses_remote(t, cid) for t in positional):
            _refuse_read_only(cid, f"`{verb}` removes what it transfers from the source",
                              "use `copy` to read without emptying the source.")
        return

    if verb not in READ_VERBS:
        _refuse_read_only(cid, f"`{verb}` is not a verb rclonec classifies as a read",
                          "an unrecognised verb is refused rather than waved through.")


# ── doctor ──────────────────────────────────────────────────────────────────


def _summarize_failure(text: str) -> str | None:
    """One line a reader can act on. rclone reports a failure as a log line and then,
    for an OAuth refusal, a JSON body whose description is the part that says what to
    change — so the two are joined rather than the output's last line taken, which is
    usually the closing brace of that body."""
    lines = [line.strip() for line in (text or "").splitlines() if line.strip()]
    if not lines:
        return None
    head = next((line for line in lines
                 if any(tag in line for tag in ("CRITICAL", "ERROR", "Failed"))), lines[0])
    for field in ("error_description", "error"):
        match = re.search(rf'"{field}"\s*:\s*"([^"]+)"', text or "")
        if match:
            return f"{head} — {match.group(1)}"
    return head


def _check_connection(cfg: dict, rclone: str = RCLONE) -> dict:
    """One connection's round-trip: list the path the connection declares for the check,
    or the remote's top level, under its own configuration. Reported rather than died,
    so doctor covers every connection."""
    target = f"{cfg['id']}:{cfg.get('check_path') or ''}"
    try:
        proc = subprocess.run([rclone, "lsd", target, "--retries", "1"],
                              env=_child_env(cfg), capture_output=True, text=True,
                              timeout=DOCTOR_TIMEOUT)
    except subprocess.TimeoutExpired:
        return {"ok": False, "category": 5,
                "error": f"rclone was unresponsive (lsd {target} timed out)"}
    except OSError as e:
        return {"ok": False, "category": 5, "error": f"could not run {RCLONE}: {e}"}
    if proc.returncode == 0:
        return {"ok": True}
    text = (proc.stderr or proc.stdout or "").strip()
    low = text.lower()
    # A credential problem and an unreachable backend are different remedies, so the
    # two are told apart here rather than reported as one failure.
    category = 2 if any(s in low for s in (
        "auth", "credential", "token", "unauthor", "permission", "401", "403",
        "invalid_grant", "login", "private key", "pem", "pkcs", "accesskeyid",
        "signature", "forbidden", "denied", "expired")) else 5
    return {"ok": False, "category": category,
            "error": _summarize_failure(text) or f"rclone exited {proc.returncode}"}


def cmd_doctor(reg: dict | None, wanted: str | None) -> None:
    report = _connections_report()
    _doctor_gate(report, wanted)
    found, unfetched = _ensure_rclone()
    tool = {"found": bool(found), "path": found, "version": _rclone_version(found)
            if found else None}
    if not found:
        tool["error"] = unfetched
        tool["hint"] = (f"put rclone on PATH (https://rclone.org/install/), or let "
                        f"rclonec fetch it into {PROGRAMS_DIR} once the network reaches "
                        f"{RCLONE_DOWNLOADS}")
    results: dict = {}
    worst = 0
    for cid, row in report["connections"].items():
        if wanted and cid != wanted:
            continue
        entry = _entry_of((reg or {}).get("connections", {}).get(cid))
        cfg, problem = _build_cfg(cid, entry)
        if problem:
            results[cid] = {"ok": False, "error": problem["message"],
                            "hint": problem.get("hint")}
            worst = max(worst, problem["exit"])
            continue
        if not found:
            results[cid] = {"ok": False, "error": f"the `{RCLONE}` binary is not on PATH "
                                                  f"and could not be fetched: {unfetched}"}
            worst = max(worst, 5)
            continue
        outcome = _check_connection(cfg, found)
        results[cid] = {"ok": outcome["ok"], "remote": f"{cid}:",
                        "type": cfg["type"], "allow_write": cfg["allow_write"]}
        if not outcome["ok"]:
            results[cid]["error"] = outcome["error"]
            worst = max(worst, outcome["category"])
    payload = {"ok": worst == 0, "rclone": tool, "connections": results}
    if worst == 0:
        _emit(payload)
        return
    sys.stderr.write(json.dumps({"error": {
        "code": "not_ready", "message": "one or more connections are not usable",
        "report": payload}}, ensure_ascii=False) + "\n")
    sys.exit(worst)


# ── forwarding ──────────────────────────────────────────────────────────────

def _forward(argv: list[str], cfg: dict, rclone: str = RCLONE) -> NoReturn:
    # Inherit stdio so streaming, progress, --json and colors pass straight through;
    # rclone's own exit code is the result.
    try:
        proc = subprocess.run([rclone, *argv], env=_child_env(cfg))
    except OSError as e:
        _die(5, "rclone_exec_failed", f"could not run {RCLONE}: {e}")
    sys.exit(proc.returncode)


# ── dispatch ────────────────────────────────────────────────────────────────

def main() -> None:
    _gate()                      # every verb passes the effective policy gate first

    # `--connection <id>` is rclonec's own selector, accepted anywhere on the line,
    # consumed here and never forwarded to `rclone`.
    argv = sys.argv[1:]
    wanted: str | None = None
    cleaned: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--connection" and i + 1 < len(argv):
            wanted = argv[i + 1]; i += 2; continue
        if a.startswith("--connection="):
            wanted = a.split("=", 1)[1]; i += 1; continue
        cleaned.append(a); i += 1

    if cleaned[:1] == ["manifest"]:
        _emit({**_manifest_core(), "programs": PROGRAMS})
        return
    _contract(cleaned)           # contract verbs; everything else forwards
    if not cleaned or (len(cleaned) == 1 and cleaned[0] in ("help", "-h", "--help")):
        sys.stdout.write((__doc__ or "").lstrip("\n"))
        return

    reg, _ = _connections_registry()
    if reg is None:
        _die(6, "no_connections",
             "rclonec requires an explicit connections registry",
             "declare the remote in capabilities/rclonec/connections.json — an entry "
             "names its rclone `type`, its `options`, and the env keys holding its "
             f"secrets; run `{NAME} help` for the shape")
    if cleaned[0] == "doctor":
        cmd_doctor(reg, wanted)
        return

    # Select and gate BEFORE resolving any secret or touching rclone, so a write on a
    # read-only connection refuses (exit 4) and an unknown id refuses (exit 6)
    # regardless of whether the secrets resolve or rclone is installed.
    cid, entry = _select_connection(reg, wanted)
    _grant_gate(reg, cid)
    entry = _entry_of(entry)
    allow_write = bool(entry.get("allow_write", WRITE_DEFAULT))
    _forward_gate(cid, allow_write, cleaned)

    cfg, problem = _build_cfg(cid, entry)
    if problem:
        _die(problem["exit"], problem["code"], problem["message"], problem.get("hint"))

    _forward(cleaned, cfg, _require_rclone())


if __name__ == "__main__":
    main()
