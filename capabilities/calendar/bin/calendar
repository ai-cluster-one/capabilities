# --- Connections (capability-specific) --------------------------------------

def _conn_scope(entry: dict | None) -> list[str]:
    """The calendars in scope for one connection. Empty ⇒ every calendar."""
    if not isinstance(entry, dict):
        return []
    raw = entry.get("calendars") or []
    return [str(x).strip() for x in raw if str(x).strip()]


def _zone(name: str | None):
    """An IANA zone, or None when the name is absent or unknown to the host."""
    if not name:
        return None
    try:
        return ZoneInfo(str(name))
    except (ZoneInfoNotFoundError, ValueError):
        return None


def _build_cfg(cid: str, entry: dict | None) -> tuple[dict | None, dict | None]:
    """Materialize one connection's config. Returns (cfg, problem) — problem is
    an error dict ({"exit", "code", "message", "hint"?}) instead of a die, so
    doctor can report every connection rather than stopping at the first."""
    entry = entry if isinstance(entry, dict) else {}
    backend = str(entry.get("backend") or BACKENDS[0]).strip().lower()
    if backend not in BACKENDS:
        return None, {"exit": 6, "code": "unsupported_backend",
                      "message": f"connection {cid!r} declares backend {backend!r}",
                      "hint": f"this executable speaks: {', '.join(BACKENDS)}"}
    address = str(entry.get("address") or "").strip()
    if not address:
        return None, {"exit": 6, "code": "incomplete_connection",
                      "message": f"connection {cid!r} is missing 'address'"}
    principal = str(entry.get("principal_url") or "").strip()
    base_url = str(entry.get("base_url") or "").strip()
    if not principal and not base_url:
        return None, {"exit": 6, "code": "incomplete_connection",
                      "message": f"connection {cid!r} is missing 'base_url'",
                      "hint": "the CalDAV entry point is per connection and never "
                              "hardcoded; `calendar guide endpoints` names the "
                              "value each provider serves"}
    username = str(entry.get("username") or "").strip() or address
    secret_env = str(entry.get("secret_env") or DEFAULT_SECRET_ENV).strip()
    password, _, _ = _resolve_env_key(secret_env)
    if not password:
        return None, {
            "exit": 2, "code": "missing_secret",
            "message": f"env var {secret_env} (for connection {cid!r}) is unset",
            "hint": f"set {secret_env} in the project's .env / .env.local, "
                    f"{CREDENTIALS_ENV}, or the environment"}
    tz_name = str(entry.get("timezone") or "").strip() or None
    if tz_name and _zone(tz_name) is None:
        return None, {"exit": 6, "code": "unknown_timezone",
                      "message": f"connection {cid!r} declares timezone {tz_name!r}, "
                                 f"which this host does not know",
                      "hint": "use an IANA name such as Europe/Berlin"}
    if not principal:
        base = base_url if base_url.endswith("/") else base_url + "/"
        principal = base + quote(address, safe="@") + "/"
    return {
        "id": cid, "backend": backend, "address": address, "username": username,
        "base_url": base_url or principal, "principal_url": principal,
        "password": password, "secret_env": secret_env,
        "timezone": tz_name, "zone": _zone(tz_name),
        "meeting_url": str(entry.get("meeting_url") or "").strip() or None,
        "scope": _conn_scope(entry),
        "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT)),
    }, None


def _load_config(cid: str, entry: dict | None) -> dict:
    cfg, problem = _build_cfg(cid, entry)
    if problem:
        _die(problem["exit"], problem["code"], problem["message"],
             problem.get("hint"))
    return cfg


def _connections_report() -> dict:
    """The resolution report — every connection, every value, its winning tier
    and source, secrets masked. Local only: no network, no CalDAV request. The
    one resolver doctor's gate and the `connections` verb both read."""
    reg, _ = _connections_registry()
    report: dict = {"default": None, "connections": {}}
    conns = (reg or {}).get("connections") or {}
    report["default"] = (reg or {}).get("default") or \
        (next(iter(conns)) if len(conns) == 1 else None)
    for cid, raw in conns.items():
        entry = raw if isinstance(raw, dict) else {}
        origin = reg["sources"][cid]
        has_principal = bool(str(entry.get("principal_url") or "").strip())
        rows = []
        for field, required in (("backend", False), ("address", True),
                                ("username", False),
                                ("base_url", not has_principal),
                                ("principal_url", False), ("timezone", False),
                                ("meeting_url", False)):
            value = entry.get(field)
            rows.append(_key_report(field, False, required,
                                    str(value) if value else None,
                                    "connection", origin))
        secret_env = str(entry.get("secret_env") or DEFAULT_SECRET_ENV).strip()
        rows.append(_key_report(secret_env, True, True,
                                *_resolve_env_key(secret_env)))
        report["connections"][cid] = {
            "calendars": _conn_scope(entry),
            "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT)),
            "keys": rows}
    return report


def _cmd_connections() -> None:
    _emit(_connections_report())


def _scope_permits(scope: list[str], token: str) -> bool:
    """Scope empty ⇒ every calendar. Otherwise a name or href match."""
    if not scope:
        return True
    return any(_same_calendar(s, token) for s in scope)


def _enforce_write(cid: str, scope: list[str], allow_write: bool,
                   verb: str, calendar_token: str | None) -> None:
    """The standard exit-4 write gate, extended: also refuse when the target
    calendar sits outside the connection's `calendars` scope."""
    _write_gate(cid, allow_write, verb)   # exits 4 on allow_write: false
    if calendar_token is not None and not _scope_permits(scope, calendar_token):
        _die(4, "out_of_scope",
             f"connection {cid!r} does not include calendar {calendar_token!r}",
             "Do not lift the gate yourself — ask the user; scope lives in the "
             "`calendars` list on this connection in connections.json.")


def _gate_from_registry(cid: str, entry: dict | None, verb: str,
                        calendar_token: str | None) -> None:
    """The write gate read from the registry alone, before any credential
    resolves. A read-only connection must meet the exit-4 refusal that routes
    the grant decision to a human, not an exit-2 about an unset secret it was
    never going to be allowed to use."""
    _enforce_write(cid, _conn_scope(entry),
                   bool((entry or {}).get("allow_write", WRITE_DEFAULT)),
                   verb, calendar_token)


def _extract_connection(argv: list[str]) -> tuple[list[str], str | None]:
    """Pull --connection <id> (or --connection=<id>) out of argv so it works in
    any position. Returns (cleaned_argv, connection_id_or_None)."""
    wanted = None
    cleaned: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--connection" and i + 1 < len(argv):
            wanted = argv[i + 1]; i += 2; continue
        if a.startswith("--connection="):
            wanted = a.split("=", 1)[1]; i += 1; continue
        cleaned.append(a); i += 1
    return cleaned, wanted


# --- Time --------------------------------------------------------------------

UTC = timezone.utc


def _utc_iso(value: datetime) -> str:
    return value.astimezone(UTC).isoformat(timespec="seconds")


def _parse_input_dt(raw: str, cfg: dict, field: str) -> datetime:
    """One ISO 8601 input. An offset (or trailing Z) is taken as given; a naive
    input resolves in the connection's declared zone, and is refused when it
    declares none — a zone is never inferred from the host."""
    try:
        parsed = datetime.fromisoformat(raw.strip())
    except ValueError:
        _die(6, "bad_datetime", f"{field}={raw!r} is not an ISO 8601 datetime",
             "use 2026-09-01T10:00:00+03:00, 2026-09-01T07:00:00Z, or 2026-09-01")
    if parsed.tzinfo is None:
        if cfg.get("zone") is None:
            _die(6, "naive_datetime",
                 f"{field}={raw!r} carries no time zone and connection "
                 f"{cfg['id']!r} declares none",
                 "pass an ISO offset (2026-09-01T10:00:00+03:00), or set "
                 "`timezone` on this connection in connections.json")
        parsed = parsed.replace(tzinfo=cfg["zone"])
    return parsed


def _parse_input_date(raw: str, cfg: dict, field: str) -> date:
    """One all-day boundary. A whole day is zone-free by definition, so a bare
    date needs no zone here; a full timestamp keeps the date it falls on."""
    try:
        return date.fromisoformat(raw.strip())
    except ValueError:
        return _parse_input_dt(raw, cfg, field).date()


def _window(cfg: dict, frm: str | None, to: str | None,
            days: int) -> tuple[datetime, datetime]:
    """The read window. Defaults anchor at midnight in the connection's zone
    (UTC when it declares none), so `today` is a stated thing, not a guess."""
    zone = cfg.get("zone") or UTC
    midnight = datetime.now(zone).replace(hour=0, minute=0, second=0, microsecond=0)
    start = _parse_input_dt(frm, cfg, "--from") if frm else midnight
    end = (_parse_input_dt(to, cfg, "--to") if to
           else start + timedelta(days=days))
    if end <= start:
        _die(6, "bad_window", "--to must be after --from",
             f"got {_utc_iso(start)} .. {_utc_iso(end)}")
    return start, end


def _ics_stamp(value: datetime) -> str:
    return value.astimezone(UTC).strftime("%Y%m%dT%H%M%SZ")


def _ics_date(value: date) -> str:
    return value.strftime("%Y%m%d")


_DURATION = re.compile(
    r"^(?P<sign>[+-])?P(?:(?P<w>\d+)W)?(?:(?P<d>\d+)D)?"
    r"(?:T(?:(?P<h>\d+)H)?(?:(?P<m>\d+)M)?(?:(?P<s>\d+)S)?)?$")


def _parse_ics_duration(raw: str) -> timedelta | None:
    match = _DURATION.match((raw or "").strip().upper())
    if not match:
        return None
    part = {k: int(v) for k, v in match.groupdict().items()
            if k != "sign" and v is not None}
    span = timedelta(weeks=part.get("w", 0), days=part.get("d", 0),
                     hours=part.get("h", 0), minutes=part.get("m", 0),
                     seconds=part.get("s", 0))
    return -span if match.group("sign") == "-" else span


_ALARM_UNIT_SECONDS = {"s": 1, "m": 60, "h": 3600, "d": 86400}


def _parse_alarm(spec: str, cfg: dict) -> dict:
    """One --alarm SPEC:
      relative — '-15m', '-1h30m' — becomes {"kind": "duration", "value": "-PT…"}
      absolute — an ISO datetime  — becomes {"kind": "datetime", "value": "…Z"}"""
    raw = (spec or "").strip()
    if not raw:
        _die(6, "bad_alarm", "empty --alarm spec")
    if raw[0] in "+-":
        sign = "-" if raw[0] == "-" else ""
        total, digits = 0, ""
        for ch in raw[1:]:
            if ch.isdigit():
                digits += ch
                continue
            unit = ch.lower()
            if unit not in _ALARM_UNIT_SECONDS or not digits:
                _die(6, "bad_alarm", f"bad alarm interval spec: {spec!r}",
                     "use forms like -15m / -1h / -1h30m / -1d")
            total += int(digits) * _ALARM_UNIT_SECONDS[unit]
            digits = ""
        if digits:
            total += int(digits) * 60      # a trailing bare number is minutes
        hours, rest = divmod(total, 3600)
        minutes, seconds = divmod(rest, 60)
        body = "".join(part for part in
                       (f"{hours}H" if hours else "", f"{minutes}M" if minutes else "",
                        f"{seconds}S" if seconds else "") if part) or "0S"
        return {"kind": "duration", "value": f"{sign}PT{body}"}
    return {"kind": "datetime",
            "value": _ics_stamp(_parse_input_dt(raw, cfg, "--alarm"))}


# --- iCalendar ---------------------------------------------------------------

def _ics_unfold(text: str) -> list[str]:
    lines: list[str] = []
    for raw in text.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
        if raw[:1] in (" ", "\t") and lines:
            lines[-1] += raw[1:]
        else:
            lines.append(raw)
    return lines


def _ics_fold(line: str) -> str:
    chunks: list[str] = []
    current, width = "", 0
    for ch in line:
        size = len(ch.encode("utf-8"))
        if width + size > 73 and current:
            chunks.append(current)
            current, width = "", 0
        current += ch
        width += size
    chunks.append(current)
    return "\r\n ".join(chunks)


def _ics_unescape(value: str) -> str:
    out, i = [], 0
    replacements = {"n": "\n", "N": "\n", "\\": "\\", ",": ",", ";": ";"}
    while i < len(value):
        ch = value[i]
        if ch == "\\" and i + 1 < len(value):
            out.append(replacements.get(value[i + 1], value[i + 1]))
            i += 2
            continue
        out.append(ch)
        i += 1
    return "".join(out)


def _ics_escape(value: str) -> str:
    return (value.replace("\\", "\\\\").replace(";", "\\;").replace(",", "\\,")
            .replace("\r\n", "\\n").replace("\r", "\\n").replace("\n", "\\n"))


def _ics_split(line: str) -> tuple[str, dict, str] | None:
    """One unfolded content line -> (NAME, params, raw value). Quoted parameter
    values may carry ':' and ';', so the split respects quoting."""
    quoted, cut = False, -1
    for index, ch in enumerate(line):
        if ch == '"':
            quoted = not quoted
        elif ch == ":" and not quoted:
            cut = index
            break
    if cut < 0:
        return None
    head, value = line[:cut], line[cut + 1:]
    parts, current, quoted = [], "", False
    for ch in head:
        if ch == '"':
            quoted = not quoted
            current += ch
        elif ch == ";" and not quoted:
            parts.append(current)
            current = ""
        else:
            current += ch
    parts.append(current)
    params: dict = {}
    for part in parts[1:]:
        if "=" in part:
            key, val = part.split("=", 1)
            params[key.strip().upper()] = val.strip().strip('"')
    return parts[0].strip().upper(), params, value


def _ics_components(text: str, name: str) -> list[dict]:
    """Every component of `name` in an iCalendar body, as
    {"props": [(NAME, params, value)], "subs": [component]}."""
    found: list[dict] = []
    stack: list[dict] = []
    for line in _ics_unfold(text):
        parsed = _ics_split(line)
        if parsed is None:
            continue
        prop, _params, value = parsed
        if prop == "BEGIN":
            stack.append({"name": value.strip().upper(), "props": [], "subs": []})
            continue
        if prop == "END":
            if not stack:
                continue
            done = stack.pop()
            if stack:
                stack[-1]["subs"].append(done)
            if done["name"] == name.upper():
                found.append(done)
            continue
        if stack:
            stack[-1]["props"].append(parsed)
    return found


def _prop(component: dict, name: str) -> tuple[dict, str] | None:
    for prop, params, value in component["props"]:
        if prop == name:
            return params, value
    return None


def _text(component: dict, name: str) -> str | None:
    hit = _prop(component, name)
    if hit is None:
        return None
    return _ics_unescape(hit[1]).strip() or None


def _tzid_zone(tzid: str | None):
    """The zone a TZID names, or None when this host cannot resolve it. The
    RFC-legal prefixed form (/authority/Europe/Berlin) carries an IANA name
    inside it; a proprietary name (a Windows zone, say) carries nothing this
    host knows, and is reported rather than reinterpreted."""
    if not tzid:
        return None
    resolved = _zone(tzid)
    if resolved is not None:
        return resolved
    if tzid.startswith("/"):
        # The prefixed form is /<authority>/<name>, and the authority may itself
        # carry slashes, so each remaining tail is tried in turn.
        parts = [part for part in tzid.split("/") if part]
        for index in range(1, len(parts)):
            resolved = _zone("/".join(parts[index:]))
            if resolved is not None:
                return resolved
    return None


def _ics_when(params: dict, value: str,
              cfg: dict) -> tuple[object, bool, str | None]:
    """One DTSTART/DTEND/RECURRENCE-ID value -> (date|aware datetime, all_day,
    unresolved TZID). The third element is the honest half: a floating value,
    or one naming a zone this host cannot resolve, is placed in the connection's
    zone to keep the payload usable and named so the caller can see that the
    instant is an assumption rather than a reading."""
    raw = (value or "").strip()
    if params.get("VALUE") == "DATE" or (len(raw) == 8 and "T" not in raw):
        try:
            return datetime.strptime(raw, "%Y%m%d").date(), True, None
        except ValueError:
            return None, True, None
    naked = raw[:-1] if raw.endswith("Z") else raw
    try:
        parsed = datetime.strptime(naked, "%Y%m%dT%H%M%S")
    except ValueError:
        return None, False, None
    if raw.endswith("Z"):
        return parsed.replace(tzinfo=UTC), False, None
    tzid = params.get("TZID")
    zone = _tzid_zone(tzid)
    if zone is not None:
        return parsed.replace(tzinfo=zone), False, None
    return (parsed.replace(tzinfo=cfg.get("zone") or UTC), False,
            tzid or "floating")


def _when_out(value) -> str | None:
    """A start/end as this CLI emits it: a bare date for an all-day boundary,
    else UTC with an explicit offset."""
    if value is None:
        return None
    if isinstance(value, datetime):
        return _utc_iso(value)
    if isinstance(value, date):
        return value.isoformat()
    return None


def _mailto(value: str) -> str | None:
    raw = (value or "").strip()
    return raw[7:] if raw.lower().startswith("mailto:") else (raw or None)


def _person(params: dict, value: str) -> dict:
    return {"name": params.get("CN") or None, "email": _mailto(value)}


def _event_payload(cfg: dict, cal: dict, href: str, etag: str | None,
                   component: dict, full: bool) -> dict:
    uid = _text(component, "UID")
    summary = _text(component, "SUMMARY")
    start_prop = _prop(component, "DTSTART")
    end_prop = _prop(component, "DTEND")
    start, all_day, drifted = (_ics_when(*start_prop, cfg) if start_prop
                               else (None, False, None))
    if end_prop:
        end = _ics_when(*end_prop, cfg)[0]
    else:
        duration = _prop(component, "DURATION")
        span = _parse_ics_duration(duration[1]) if duration else None
        if span is None:
            span = timedelta(days=1) if all_day else timedelta(0)
        end = (start + span) if start is not None else None
    recurrence = _prop(component, "RECURRENCE-ID")
    recurrence_at = _ics_when(*recurrence, cfg)[0] if recurrence else None
    zone_note = drifted
    payload = {
        "id": uid, "uid": uid, "title": summary,
        "startDate": _when_out(start),
        "endDate": _when_out(end),
        "allDay": all_day,
        "calendar": cal.get("name"),
        "calendarHref": cal.get("href"),
        "href": href,
        "etag": etag,
        "location": _text(component, "LOCATION"),
        "status": _text(component, "STATUS"),
        "transparent": (_text(component, "TRANSP") or "").upper() == "TRANSPARENT",
        "recurring": bool(_prop(component, "RRULE") or recurrence),
        "recurrenceId": _when_out(recurrence_at),
        "zoneFallback": zone_note,
    }
    if not full:
        return payload
    organizer = _prop(component, "ORGANIZER")
    attendees = []
    for prop, params, value in component["props"]:
        if prop != "ATTENDEE":
            continue
        person = _person(params, value)
        person["partstat"] = params.get("PARTSTAT")
        person["role"] = params.get("ROLE")
        attendees.append(person)
    rrule = _prop(component, "RRULE")
    payload.update({
        "notes": _text(component, "DESCRIPTION"),
        "url": _text(component, "URL"),
        "organizer": _person(*organizer) if organizer else None,
        "attendees": attendees,
        "sequence": _int(_text(component, "SEQUENCE")),
        "created": _stamp_out(cfg, component, "CREATED"),
        "lastModified": _stamp_out(cfg, component, "LAST-MODIFIED"),
        "rrule": rrule[1] if rrule else None,
        "alarms": len([sub for sub in component["subs"] if sub["name"] == "VALARM"]),
    })
    return payload


def _int(value: str | None) -> int:
    """A counter as the server stated it. Anything unreadable reads as 0: one
    malformed property must not fail a caller's read of a whole window."""
    try:
        return int((value or "0").strip())
    except ValueError:
        return 0


def _stamp_out(cfg: dict, component: dict, name: str) -> str | None:
    """A bookkeeping timestamp in the one representation this CLI emits."""
    hit = _prop(component, name)
    if hit is None:
        return None
    return _when_out(_ics_when(*hit, cfg)[0])


def _rule_lines(component: dict) -> list[str]:
    """The recurrence properties of one component, as the lines they were."""
    out = []
    for name, params, value in component["props"]:
        if name in ("RRULE", "RDATE", "EXDATE"):
            head = name + "".join(f";{k}={v}" for k, v in params.items())
            out.append(f"{head}:{value}")
    return out


def _occurrence_key(value) -> str:
    """One occurrence identified the way RECURRENCE-ID identifies it."""
    if isinstance(value, datetime):
        return value.astimezone(UTC).strftime("%Y%m%dT%H%M%SZ")
    if isinstance(value, date):
        return value.strftime("%Y%m%d")
    return ""


def _occurrence_starts(master_start, rules: list[str], cfg: dict, all_day: bool,
                       span: timedelta, window: tuple) -> list:
    """Every start a recurrence rule produces inside the window.

    Evaluated here rather than asked of the server: a server may accept a
    request carrying CalDAV's expand and answer it unexpanded, which is
    indistinguishable from a calendar with no recurrence until the occurrences
    are missing from someone's free time. Doing it here makes the answer the
    same on every server."""
    zone = cfg.get("zone") or UTC
    if all_day:
        base = datetime.combine(master_start, time())
        low = window[0].astimezone(zone).replace(tzinfo=None)
        high = window[1].astimezone(zone).replace(tzinfo=None)
    else:
        base, low, high = master_start, window[0], window[1]
    blob = "\n".join(rules)
    try:
        rule_set = rrulestr(blob, dtstart=base, forceset=True, tzids=_tzid_zone)
        return list(rule_set.between(low - span, high, inc=True))
    except (ValueError, TypeError):
        # A producer mixing zoned and floating values in one rule; the whole
        # rule is then read as wall time and the master's own zone re-applied.
        keep = base.tzinfo if isinstance(base, datetime) else None
        naked = re.sub(r"(UNTIL=\d{8}T\d{6})Z", r"\1", blob)
        try:
            rule_set = rrulestr(naked, dtstart=base.replace(tzinfo=None),
                                forceset=True, tzids=_tzid_zone)
        except (ValueError, TypeError):
            return []
        low_n = low.replace(tzinfo=None) if low.tzinfo else low
        high_n = high.replace(tzinfo=None) if high.tzinfo else high
        return [moment.replace(tzinfo=keep)
                for moment in rule_set.between(low_n - span, high_n, inc=True)]


def _shifted(payload: dict, start, span: timedelta, all_day: bool) -> dict:
    """One occurrence of a series, carrying the series' own detail."""
    finish = start + span
    occurrence = dict(payload)
    if all_day:
        occurrence["startDate"] = start.date().isoformat()
        occurrence["endDate"] = finish.date().isoformat()
    else:
        occurrence["startDate"] = _utc_iso(start)
        occurrence["endDate"] = _utc_iso(finish)
    occurrence["recurrenceId"] = occurrence["startDate"]
    return occurrence


def _bounds_utc(payload: dict, cfg: dict) -> tuple[datetime, datetime] | None:
    """One event's occupied span in UTC. An all-day event occupies whole days in
    the connection's zone (UTC when it declares none)."""
    start, end = payload.get("startDate"), payload.get("endDate")
    if not start or not end:
        return None
    zone = cfg.get("zone") or UTC
    try:
        first, last = datetime.fromisoformat(start), datetime.fromisoformat(end)
    except ValueError:
        return None
    # A server may mix value types on one event, so either boundary can come
    # back bare; the connection's zone is what a bare boundary means, never the
    # host's.
    first = first.replace(tzinfo=zone) if first.tzinfo is None else first
    last = last.replace(tzinfo=zone) if last.tzinfo is None else last
    return first.astimezone(UTC), last.astimezone(UTC)


def _merge_intervals(spans: list[tuple[datetime, datetime]]) -> list[dict]:
    """Merge overlapping/touching spans, compared as aware datetimes so the
    result is correct across DST boundaries."""
    if not spans:
        return []
    spans = sorted(spans, key=lambda s: s[0])
    merged: list[list[datetime]] = [list(spans[0])]
    for start, end in spans[1:]:
        if start <= merged[-1][1]:
            merged[-1][1] = max(merged[-1][1], end)
        else:
            merged.append([start, end])
    return [{"start": _utc_iso(s), "end": _utc_iso(e)} for s, e in merged]


def _build_vevent(cfg: dict, uid: str, fields: dict, alarms: list[dict]) -> str:
    lines = ["BEGIN:VCALENDAR", "VERSION:2.0",
             "PRODID:-//capabilities//calendar//EN", "CALSCALE:GREGORIAN",
             "BEGIN:VEVENT"]
    lines.append(f"UID:{uid}")
    lines.append(f"DTSTAMP:{_ics_stamp(datetime.now(UTC))}")
    lines.extend(_when_props("DTSTART", fields["start"], fields["all_day"]))
    lines.extend(_when_props("DTEND", fields["end"], fields["all_day"]))
    lines.append("SEQUENCE:0")
    lines.append("STATUS:CONFIRMED")
    lines.append("TRANSP:OPAQUE")
    lines.append(f"SUMMARY:{_ics_escape(fields['title'])}")
    if fields.get("location"):
        lines.append(f"LOCATION:{_ics_escape(fields['location'])}")
    if fields.get("notes"):
        lines.append(f"DESCRIPTION:{_ics_escape(fields['notes'])}")
    if fields.get("url"):
        lines.append(f"URL:{_clean(fields['url'], '--url', drop='')}")
    invitees = fields.get("invitees") or []
    if invitees:
        lines.append(f"ORGANIZER:mailto:{cfg['address']}")
    for invitee in invitees:
        lines.append(_attendee_line(invitee))
    for alarm in alarms:
        lines.extend(_alarm_lines(alarm, fields["title"]))
    lines.append("END:VEVENT")
    lines.append("END:VCALENDAR")
    return "\r\n".join(_ics_fold(line) for line in lines) + "\r\n"


def _when_props(name: str, value, all_day: bool) -> list[str]:
    if all_day:
        return [f"{name};VALUE=DATE:{_ics_date(value)}"]
    return [f"{name}:{_ics_stamp(value)}"]


def _clean(value: str, field: str, *, drop: str = '"') -> str:
    """A value going into a non-TEXT position — a URI, an address, a quoted
    parameter — where escaping does not apply. A newline there would not be
    escaped: it would end the property and start another, so a control
    character is refused rather than quietly turned into something the caller
    did not write."""
    raw = (value or "").strip()
    if any(ord(ch) < 32 or ord(ch) == 127 for ch in raw):
        _die(6, "bad_value", f"{field} carries a control character",
             "an iCalendar property ends at a line break; pass a single line")
    return "".join(ch for ch in raw if ch not in drop)


def _attendee_line(invitee: str) -> str:
    """`--invitee` accepts an address or `Name <address>`."""
    raw = _clean(invitee, "--invitee", drop="")
    name = None
    if "<" in raw and raw.endswith(">"):
        name, raw = raw[:raw.index("<")].strip(), raw[raw.index("<") + 1:-1].strip()
    params = ";ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;RSVP=TRUE"
    if name:
        params = f';CN="{_clean(name, "--invitee")}"' + params
    return f"ATTENDEE{params}:mailto:{_clean(raw, "--invitee")}"


def _alarm_lines(alarm: dict, title: str) -> list[str]:
    trigger = (f"TRIGGER:{alarm['value']}" if alarm["kind"] == "duration"
               else f"TRIGGER;VALUE=DATE-TIME:{alarm['value']}")
    return ["BEGIN:VALARM", "ACTION:DISPLAY",
            f"DESCRIPTION:{_ics_escape(title or 'Reminder')}",
            trigger, "END:VALARM"]


# --- CalDAV transport --------------------------------------------------------

DAV_NS = "DAV:"
CALDAV_NS = "urn:ietf:params:xml:ns:caldav"
APPLE_NS = "http://apple.com/ns/ical/"
TIMEOUT = httpx.Timeout(60.0, connect=20.0)
MAX_RETRIES = 3
XML_CONTENT = 'application/xml; charset="utf-8"'


def _qn(namespace: str, tag: str) -> str:
    return f"{{{namespace}}}{tag}"


def _client(cfg: dict) -> httpx.Client:
    return httpx.Client(auth=(cfg["username"], cfg["password"]), timeout=TIMEOUT,
                        follow_redirects=True,
                        headers={"User-Agent": f"capabilities-{NAME}/1"})


def _http_die(method: str, url: str, resp: httpx.Response) -> NoReturn:
    status = resp.status_code
    if status in (401, 407):
        _die(2, "auth_rejected", f"{status} from {url}",
             "the CalDAV endpoint rejected the credential — where the provider "
             "issues app passwords, a normal account password will not do; "
             "`calendar guide endpoints` names the endpoint each provider serves",
             status=status)
    if status == 403:
        _die(2, "forbidden", f"403 from {url}",
             "the credential authenticated but may not reach this collection",
             status=status)
    if status == 404:
        _die(3, "not_found", f"404 from {url}",
             "check the connection's base_url and address", status=status)
    if status == 405:
        _die(6, "not_caldav", f"{url} answered 405 to {method}",
             "that URL serves no CalDAV — not every mail host carries a "
             "calendar; check the connection's base_url", status=status)
    if status == 412:
        _die(6, "etag_conflict", f"412 from {url}",
             "the event changed on the server since it was read — re-read it "
             "and re-apply the change", status=status)
    if status == 409:
        _die(6, "conflict", f"409 from {url}",
             "the target collection rejected the write", status=status)
    _die(6, "request_rejected", f"{status} from {method} {url}",
         (resp.text or "").strip()[:400] or None, status=status)


# Only a request that can be repeated without changing the outcome is retried.
# A PUT or a DELETE whose response is lost may well have landed, and a replay
# would come back 412 or 404 and report the mutation that happened as one that
# did not.
_REPLAYABLE = {"GET", "HEAD", "OPTIONS", "PROPFIND", "REPORT"}

_WRITE_LOST = ("the response was lost, so the write may or may not have "
               "landed — read the event back before sending it again")


def _request(client: httpx.Client, method: str, url: str, *,
             body: str | None = None, headers: dict | None = None,
             expect: tuple = ()) -> httpx.Response:
    payload = body.encode("utf-8") if body is not None else None
    replayable = method.upper() in _REPLAYABLE
    resp = None
    for attempt in range(1, MAX_RETRIES + 1):
        last = attempt == MAX_RETRIES or not replayable
        try:
            resp = client.request(method, url, content=payload,
                                  headers=headers or {})
        except httpx.TimeoutException:
            if not last:
                time.sleep(attempt * 1.5); continue
            _die(5, "timeout", f"request timed out: {method} {url}",
                 "the CalDAV host was unresponsive" if replayable else _WRITE_LOST)
        except httpx.RequestError as e:
            _die(5, "network_error", f"network error: {e}",
                 "check connectivity and the connection's base_url")
        if resp.status_code == 429:
            if not last:
                time.sleep(_retry_after(resp, attempt)); continue
            _die(5, "rate_limited", "rate-limited by the CalDAV host", status=429)
        if resp.status_code >= 500:
            if not last:
                time.sleep(attempt * 1.5); continue
            _die(5, "server_error", f"the CalDAV host returned {resp.status_code}",
                 status=resp.status_code)
        break
    if expect:
        if resp.status_code in expect:
            return resp
    elif resp.status_code < 400:
        return resp
    _http_die(method, url, resp)


def _retry_after(resp: httpx.Response, attempt: int) -> float:
    try:
        return float(resp.headers.get("Retry-After", attempt * 1.5))
    except ValueError:
        return attempt * 1.5


def _multistatus(resp: httpx.Response) -> list:
    try:
        root = ET.fromstring(resp.content)
    except ET.ParseError as e:
        _die(5, "bad_response",
             f"the CalDAV host returned XML this CLI cannot parse: {e}")
    if root.tag != _qn(DAV_NS, "multistatus"):
        _die(5, "bad_response",
             f"expected a DAV multistatus, got {root.tag!r}")
    return root.findall(_qn(DAV_NS, "response"))


def _children(props: dict, qname: str) -> list:
    """The children of one property element. An XML element with no children is
    falsy while being perfectly present, so presence is tested, never truth."""
    element = props.get(qname)
    return list(element) if element is not None else []


def _ok_props(response_el) -> dict:
    """qname -> element, for the propstats the server answered 2xx for."""
    out: dict = {}
    for propstat in response_el.findall(_qn(DAV_NS, "propstat")):
        status = (propstat.findtext(_qn(DAV_NS, "status")) or "").split()
        if len(status) < 2 or not status[1].startswith("2"):
            continue
        prop = propstat.find(_qn(DAV_NS, "prop"))
        for child in (list(prop) if prop is not None else []):
            out[child.tag] = child
    return out


PROPFIND_PRINCIPAL = (
    '<?xml version="1.0" encoding="utf-8"?>'
    '<d:propfind xmlns:d="DAV:" xmlns:c="urn:ietf:params:xml:ns:caldav">'
    "<d:prop><d:displayname/><d:current-user-principal/>"
    "<c:calendar-home-set/></d:prop></d:propfind>")

PROPFIND_CALENDARS = (
    '<?xml version="1.0" encoding="utf-8"?>'
    '<d:propfind xmlns:d="DAV:" xmlns:c="urn:ietf:params:xml:ns:caldav" '
    'xmlns:a="http://apple.com/ns/ical/">'
    "<d:prop><d:resourcetype/><d:displayname/><d:current-user-privilege-set/>"
    "<c:supported-calendar-component-set/><a:calendar-color/>"
    "</d:prop></d:propfind>")


def _propfind(client: httpx.Client, url: str, body: str, depth: str) -> httpx.Response:
    return _request(client, "PROPFIND", url, body=body, expect=(207,),
                    headers={"Depth": depth, "Content-Type": XML_CONTENT})


def _principal(client: httpx.Client, cfg: dict) -> dict:
    """The principal: its display name and its calendar home. A server that
    answers only `current-user-principal` here is followed one hop."""
    url = cfg["principal_url"]
    resp = _propfind(client, url, PROPFIND_PRINCIPAL, "0")
    name, home, elsewhere = None, None, None
    for response_el in _multistatus(resp):
        props = _ok_props(response_el)
        display = props.get(_qn(DAV_NS, "displayname"))
        if display is not None and (display.text or "").strip():
            name = display.text.strip()
        home_set = props.get(_qn(CALDAV_NS, "calendar-home-set"))
        if home_set is not None:
            href = home_set.findtext(_qn(DAV_NS, "href"))
            if href:
                home = urljoin(str(resp.url), href.strip())
        current = props.get(_qn(DAV_NS, "current-user-principal"))
        if current is not None:
            href = current.findtext(_qn(DAV_NS, "href"))
            if href:
                elsewhere = urljoin(str(resp.url), href.strip())
    if home is None and elsewhere and elsewhere.rstrip("/") != url.rstrip("/"):
        hop = _propfind(client, elsewhere, PROPFIND_PRINCIPAL, "0")
        for response_el in _multistatus(hop):
            props = _ok_props(response_el)
            home_set = props.get(_qn(CALDAV_NS, "calendar-home-set"))
            if home_set is not None:
                href = home_set.findtext(_qn(DAV_NS, "href"))
                if href:
                    home = urljoin(str(hop.url), href.strip())
        url = elsewhere
    if home is None:
        # A server may hold the principal properties on a collection other than
        # the one that holds the calendars, and answer 404 for both
        # calendar-home-set and current-user-principal on the second. The
        # configured URL is then the home itself, which enumerating it settles.
        return {"principal": url, "displayname": name, "home": url,
                "home_assumed": True}
    return {"principal": url, "displayname": name, "home": home,
            "home_assumed": False}


_PRINCIPAL_CACHE: dict = {}
_CALENDARS_CACHE: dict = {}


def _principal_once(client: httpx.Client, cfg: dict) -> dict:
    """The principal, resolved once per process — every verb needs its home."""
    if cfg["id"] not in _PRINCIPAL_CACHE:
        _PRINCIPAL_CACHE[cfg["id"]] = _principal(client, cfg)
    return _PRINCIPAL_CACHE[cfg["id"]]


def _calendars(client: httpx.Client, cfg: dict) -> list[dict]:
    """Every VEVENT calendar collection in the principal's home."""
    if cfg["id"] in _CALENDARS_CACHE:
        return _CALENDARS_CACHE[cfg["id"]]
    principal = _principal_once(client, cfg)
    home = principal["home"]
    resp = _propfind(client, home, PROPFIND_CALENDARS, "1")
    found: list[dict] = []
    for response_el in _multistatus(resp):
        href = response_el.findtext(_qn(DAV_NS, "href"))
        if not href:
            continue
        props = _ok_props(response_el)
        kinds = {child.tag for child in _children(props, _qn(DAV_NS, "resourcetype"))}
        if _qn(CALDAV_NS, "calendar") not in kinds:
            continue
        if kinds & {_qn(CALDAV_NS, "schedule-inbox"),
                    _qn(CALDAV_NS, "schedule-outbox")}:
            continue
        components = [child.get("name") for child in _children(
            props, _qn(CALDAV_NS, "supported-calendar-component-set"))]
        if components and "VEVENT" not in components:
            continue
        privileges = set()
        for privilege in _children(props, _qn(DAV_NS, "current-user-privilege-set")):
            privileges.update(child.tag for child in privilege)
        writable = None
        if privileges:
            writable = bool(privileges & {_qn(DAV_NS, "write"),
                                          _qn(DAV_NS, "write-content"),
                                          _qn(DAV_NS, "all")})
        display = props.get(_qn(DAV_NS, "displayname"))
        color = props.get(_qn(APPLE_NS, "calendar-color"))
        url = urljoin(str(resp.url), href.strip())
        found.append({
            "href": url if url.endswith("/") else url + "/",
            "name": (display.text or "").strip() if display is not None else "",
            "color": (color.text or "").strip() if color is not None else None,
            "writable": writable,
            "components": components or ["VEVENT"],
        })
    if not found and principal["home_assumed"]:
        _die(3, "no_calendar_home",
             f"{home} exposes neither calendar-home-set nor any calendar "
             f"collection",
             "the principal URL is base_url + the address; set `principal_url` "
             "on the connection when the server addresses its principals "
             "otherwise — `calendar guide endpoints` covers finding it")
    _CALENDARS_CACHE[cfg["id"]] = found
    return found


def _path_of(value: str) -> str:
    path = urlparse(value.strip()).path if value else ""
    return path.rstrip("/")


def _origin_of(value: str) -> tuple[str, str]:
    parsed = urlparse((value or "").strip())
    return parsed.scheme.casefold(), parsed.netloc.casefold()


def _within(url: str, collection: str) -> bool:
    """Is `url` a resource inside `collection`? The origin must match — a
    credential is presented to whatever host this returns True for — and the
    path must stop on a segment boundary, so /cal/work never swallows
    /cal/workshop."""
    if not url or not collection:
        return False
    target, home = _origin_of(url), _origin_of(collection)
    if home[1] and target != home:
        return False
    base = _path_of(collection) + "/"
    return urlparse(url.strip()).path.startswith(base)


def _same_calendar(token: str, calendar) -> bool:
    """A token names a calendar by display name (case-insensitive) or href. An
    href carrying an origin must match the collection's, not merely its path."""
    raw = (token or "").strip()
    if not raw:
        return False
    name = calendar.get("name") if isinstance(calendar, dict) else calendar
    href = calendar.get("href") if isinstance(calendar, dict) else calendar
    if raw.casefold() == (name or "").strip().casefold():
        return True
    if not _path_of(raw) or _path_of(raw) != _path_of(href or ""):
        return False
    origin = _origin_of(raw)
    return not origin[1] or origin == _origin_of(href or "")


def _in_scope(cfg: dict, calendars: list[dict]) -> list[dict]:
    if not cfg["scope"]:
        return calendars
    return [cal for cal in calendars
            if any(_same_calendar(token, cal) for token in cfg["scope"])]


def _pick_calendars(client: httpx.Client, cfg: dict,
                    wanted: list[str]) -> list[dict]:
    """The calendars a read verb touches: the caller's choice intersected with
    the connection scope. A choice outside the scope exits 4, the same wall the
    write gate raises; a choice the server does not serve exits 3."""
    everything = _calendars(client, cfg)
    scoped = _in_scope(cfg, everything)
    if not wanted:
        if not scoped:
            _die(3, "no_calendars_in_scope",
                 f"connection {cfg['id']!r} reaches no VEVENT calendar",
                 "widen the connection's `calendars` scope, or check the account")
        return scoped
    picked: list[dict] = []
    for token in wanted:
        hits = [cal for cal in scoped if _same_calendar(token, cal)]
        if not hits:
            if any(_same_calendar(token, cal) for cal in everything):
                _die(4, "out_of_scope",
                     f"connection {cfg['id']!r} does not include calendar {token!r}",
                     "Do not lift the gate yourself — ask the user to widen the "
                     "connection's `calendars` scope in connections.json.")
            _die(3, "unknown_calendar",
                 f"no calendar matches {token!r}",
                 f"known: {', '.join(cal['name'] for cal in scoped) or '(none)'}")
        for hit in hits:
            if hit not in picked:
                picked.append(hit)
    return picked


def _query_body(start: datetime, end: datetime, expand: bool) -> str:
    window = (f'<c:time-range start="{_ics_stamp(start)}" '
              f'end="{_ics_stamp(end)}"/>')
    data = (f"<c:calendar-data><c:expand start=\"{_ics_stamp(start)}\" "
            f"end=\"{_ics_stamp(end)}\"/></c:calendar-data>" if expand
            else "<c:calendar-data/>")
    return ('<?xml version="1.0" encoding="utf-8"?>'
            '<c:calendar-query xmlns:d="DAV:" '
            'xmlns:c="urn:ietf:params:xml:ns:caldav">'
            f"<d:prop><d:getetag/>{data}</d:prop>"
            '<c:filter><c:comp-filter name="VCALENDAR">'
            f'<c:comp-filter name="VEVENT">{window}</c:comp-filter>'
            "</c:comp-filter></c:filter></c:calendar-query>")


def _uid_body(uid: str) -> str:
    return ('<?xml version="1.0" encoding="utf-8"?>'
            '<c:calendar-query xmlns:d="DAV:" '
            'xmlns:c="urn:ietf:params:xml:ns:caldav">'
            "<d:prop><d:getetag/><c:calendar-data/></d:prop>"
            '<c:filter><c:comp-filter name="VCALENDAR">'
            '<c:comp-filter name="VEVENT">'
            '<c:prop-filter name="UID">'
            f'<c:text-match collation="i;octet">{_xml_text(uid)}</c:text-match>'
            "</c:prop-filter></c:comp-filter>"
            "</c:comp-filter></c:filter></c:calendar-query>")


def _xml_text(value: str) -> str:
    return (value.replace("&", "&amp;").replace("<", "&lt;")
            .replace(">", "&gt;"))


# A server that will not expand answers the REPORT rather than failing the
# request; those statuses select the unexpanded retry instead of an error.
_SOFT_REPORT = (400, 403, 409, 501, 507)


def _report(client: httpx.Client, cal: dict, body: str,
            soft: tuple = ()) -> httpx.Response:
    return _request(client, "REPORT", cal["href"], body=body,
                    expect=(207,) + tuple(soft),
                    headers={"Depth": "1", "Content-Type": XML_CONTENT})


def _object_events(cfg: dict, cal: dict, url: str, etag: str | None,
                   components: list[dict], full: bool,
                   window: tuple) -> list[dict]:
    """One stored object as the occurrences it puts inside the window.

    A series is stored as a master plus an override per changed occurrence, so
    the object is read as a whole: the rule produces the starts, an override
    replaces the one it names, and an override moved into the window is carried
    even when its original occurrence sits outside it."""
    masters, overrides = [], {}
    for component in components:
        recurrence = _prop(component, "RECURRENCE-ID")
        if recurrence is None:
            masters.append(component)
        else:
            key = _occurrence_key(_ics_when(*recurrence, cfg)[0])
            overrides[key] = component
    out: list[dict] = []
    claimed: set = set()
    for master in masters:
        payload = _event_payload(cfg, cal, url, etag, master, full)
        rules = _rule_lines(master)
        if not any(line.startswith(("RRULE", "RDATE")) for line in rules):
            if _overlaps(payload, cfg, window):
                out.append(payload)
            continue
        start_prop = _prop(master, "DTSTART")
        if start_prop is None:
            continue
        master_start, all_day, _ = _ics_when(*start_prop, cfg)
        if master_start is None:
            continue
        span = _span_of(payload, cfg, all_day)
        for moment in _occurrence_starts(master_start, rules, cfg, all_day,
                                         span, window):
            key = _occurrence_key(moment)
            override = overrides.get(key)
            if override is not None:
                claimed.add(key)
                instance = _event_payload(cfg, cal, url, etag, override, full)
            else:
                instance = _shifted(payload, moment, span, all_day)
            if _overlaps(instance, cfg, window):
                out.append(instance)
    for key, override in overrides.items():
        if key in claimed:
            continue
        instance = _event_payload(cfg, cal, url, etag, override, full)
        if _overlaps(instance, cfg, window):
            out.append(instance)
    return out


def _span_of(payload: dict, cfg: dict, all_day: bool) -> timedelta:
    bounds = _bounds_utc(payload, cfg)
    if bounds is None:
        return timedelta(days=1) if all_day else timedelta(hours=1)
    return bounds[1] - bounds[0]


def _overlaps(payload: dict, cfg: dict, window: tuple) -> bool:
    bounds = _bounds_utc(payload, cfg)
    if bounds is None:
        return False
    return bounds[0] < window[1] and bounds[1] > window[0]


def _collect(cfg: dict, cal: dict, resp: httpx.Response, full: bool,
             window: tuple) -> list[dict]:
    events: list[dict] = []
    for response_el in _multistatus(resp):
        href = response_el.findtext(_qn(DAV_NS, "href"))
        props = _ok_props(response_el)
        etag_el = props.get(_qn(DAV_NS, "getetag"))
        data_el = props.get(_qn(CALDAV_NS, "calendar-data"))
        if data_el is None or not (data_el.text or "").strip():
            continue
        url = urljoin(str(resp.url), (href or "").strip())
        etag = (etag_el.text or "").strip() if etag_el is not None else None
        events.extend(_object_events(
            cfg, cal, url, etag, _ics_components(data_el.text, "VEVENT"),
            full, window))
    return events


def _read_window(client: httpx.Client, cfg: dict, calendars: list[dict],
                 start: datetime, end: datetime,
                 full: bool = False) -> list[dict]:
    """Every occurrence inside the window, one entry each.

    The request still asks the server to expand, because a server that does it
    sends less; what comes back is expanded here regardless, so the answer does
    not depend on whether this particular server honoured the request."""
    events: list[dict] = []
    window = (start, end)
    for cal in calendars:
        resp = _report(client, cal, _query_body(start, end, True),
                       soft=_SOFT_REPORT)
        if resp.status_code != 207:
            resp = _report(client, cal, _query_body(start, end, False))
        events.extend(_collect(cfg, cal, resp, full, window))
    events.sort(key=lambda e: (e.get("startDate") or "", e.get("title") or ""))
    return events


def _locate(client: httpx.Client, cfg: dict, calendars: list[dict],
            token: str, frm: str | None, to: str | None) -> dict:
    """One stored event object, by href or by uid. Returns
    {"calendar", "href", "etag", "text", "components"}."""
    raw = token.strip()
    if raw.startswith("http://") or raw.startswith("https://") or raw.startswith("/"):
        url = urljoin(cfg["principal_url"], raw)
        owner = next((cal for cal in calendars if _within(url, cal["href"])), None)
        if owner is None:
            _die(4, "out_of_scope",
                 f"{raw} sits outside connection {cfg['id']!r}'s calendars",
                 "Do not lift the gate yourself — ask the user to widen the "
                 "connection's `calendars` scope in connections.json.")
        resp = _request(client, "GET", url)
        components = _ics_components(resp.text, "VEVENT")
        if not components:
            _die(3, "event_not_found", f"{url} carries no VEVENT")
        return {"calendar": owner, "href": url,
                "etag": resp.headers.get("ETag"), "text": resp.text,
                "components": components}
    for cal in calendars:
        resp = _report(client, cal, _uid_body(raw), soft=_SOFT_REPORT)
        if resp.status_code != 207:
            break                # this server refuses UID filters — scan instead
        hit = _first_object(cfg, cal, resp, uid=raw)
        if hit:
            return hit
    now = datetime.now(UTC)
    start = (_parse_input_dt(frm, cfg, "--scan-from") if frm
             else now - timedelta(days=180))
    end = (_parse_input_dt(to, cfg, "--scan-to") if to
           else now + timedelta(days=365))
    for cal in calendars:
        resp = _report(client, cal, _query_body(start, end, False))
        hit = _first_object(cfg, cal, resp, uid=raw)
        if hit:
            return hit
    _die(3, "event_not_found", f"no event with uid {raw!r} in scope",
         f"pass the href `events` reports, or widen the scan window "
         f"({_utc_iso(start)} .. {_utc_iso(end)})")


def _first_object(cfg: dict, cal: dict, resp: httpx.Response,
                  uid: str | None = None) -> dict | None:
    for response_el in _multistatus(resp):
        href = response_el.findtext(_qn(DAV_NS, "href"))
        props = _ok_props(response_el)
        data_el = props.get(_qn(CALDAV_NS, "calendar-data"))
        etag_el = props.get(_qn(DAV_NS, "getetag"))
        if data_el is None or not (data_el.text or "").strip():
            continue
        components = _ics_components(data_el.text, "VEVENT")
        if uid and not any(_text(c, "UID") == uid for c in components):
            continue
        return {"calendar": cal,
                "href": urljoin(str(resp.url), (href or "").strip()),
                "etag": (etag_el.text or "").strip() if etag_el is not None else None,
                "text": data_el.text, "components": components}
    return None


# --- Domain commands ---------------------------------------------------------

def _check_connection(cfg: dict) -> dict:
    """One connection's round-trip, reported rather than died — doctor covers
    every connection, so a broken one becomes a finding, not a stop. The probe
    shares the work verbs' code, so its refusals arrive as `_die` envelopes;
    they are captured here and folded into this connection's row instead of
    reaching stderr, where they would compete with doctor's own report."""
    out: dict = {"address": cfg["address"], "backend": cfg["backend"],
                 "principal": cfg["principal_url"]}
    captured = io.StringIO()
    try:
        with redirect_stderr(captured):
            with _client(cfg) as client:
                principal = _principal_once(client, cfg)
                calendars = _calendars(client, cfg)
    except SystemExit as e:
        category = e.code if isinstance(e.code, int) and e.code else 5
        try:
            envelope = json.loads(captured.getvalue().strip().splitlines()[-1])
            failure = envelope["error"]
        except (ValueError, KeyError, IndexError):
            failure = {"message": "the CalDAV round-trip failed"}
        row = {"ok": False, "category": category,
               "error": failure.get("message")}
        if failure.get("hint"):
            row["hint"] = failure["hint"]
        return out | row
    out["displayname"] = principal["displayname"]
    out["calendar_home"] = principal["home"]
    out["home_discovered"] = not principal["home_assumed"]
    out["calendars"] = len(_in_scope(cfg, calendars))
    out["scope"] = cfg["scope"]
    out["allow_write"] = cfg["allow_write"]
    out["timezone"] = cfg["timezone"]
    return out | {"ok": True}


def cmd_doctor(wanted: str | None) -> None:
    """Every connection bare; one with --connection. Exit 0 only when every
    examined connection is healthy, else the first failure's category."""
    reg, _ = _connections_registry()
    if wanted is not None:
        # Resolve before gating: a connection is selectable by its address, and
        # the readiness gate must narrow to the same entry the probe will use.
        targets = [_select_connection(reg, wanted)]
        _doctor_gate(_connections_report(), targets[0][0])
    else:
        targets = list(reg["connections"].items())
        _doctor_gate(_connections_report(), None)
    connections: dict = {}
    fail_exit = 0
    for cid, entry in targets:
        cfg, problem = _build_cfg(cid, entry)
        if problem:
            result = {"ok": False, "category": problem["exit"],
                      "error": problem["message"]}
            if problem.get("hint"):
                result["hint"] = problem["hint"]
        else:
            result = _check_connection(cfg)
        if not result.get("ok") and not fail_exit:
            fail_exit = result.get("category") or 5
        result.pop("category", None)
        connections[cid] = result
    _emit({"ok": fail_exit == 0, "connections": connections})
    if fail_exit:
        sys.exit(fail_exit)


def cmd_calendars(cfg: dict, args) -> dict:
    with _client(cfg) as client:
        calendars = _in_scope(cfg, _calendars(client, cfg))
    return {"connection": cfg["id"], "scope": cfg["scope"],
            "calendars": calendars}


def cmd_events(cfg: dict, args) -> dict:
    start, end = _window(cfg, args.frm, args.to, 7)
    with _client(cfg) as client:
        calendars = _pick_calendars(client, cfg,
                                    [args.calendar] if args.calendar else [])
        events = _read_window(client, cfg, calendars, start, end)
    if args.limit and args.limit > 0:
        events = events[:args.limit]
    return {"from": _utc_iso(start), "to": _utc_iso(end),
            "timezone": cfg["timezone"],
            "calendars": [cal["name"] for cal in calendars],
            "count": len(events), "events": events}


def cmd_show(cfg: dict, args) -> dict:
    with _client(cfg) as client:
        calendars = _pick_calendars(client, cfg, [])
        found = _locate(client, cfg, calendars, args.event,
                        args.frm_scan, args.to_scan)
    components = found["components"]
    master = next((c for c in components if not _prop(c, "RECURRENCE-ID")),
                  components[0] if components else None)
    if master is None:
        _die(3, "event_not_found", f"{found['href']} carries no VEVENT")
    payload = _event_payload(cfg, found["calendar"], found["href"],
                             found["etag"], master, full=True)
    payload["overrides"] = len(components) - 1
    payload["timezone"] = cfg["timezone"]
    return payload


def cmd_search(cfg: dict, args) -> dict:
    start, end = _window(cfg, args.frm, args.to, 30)
    with _client(cfg) as client:
        calendars = _pick_calendars(client, cfg,
                                    [args.calendar] if args.calendar else [])
        events = _read_window(client, cfg, calendars, start, end, full=True)
    needle = args.query.casefold()
    hits = []
    for event in events:
        title = (event.get("title") or "").casefold()
        notes = (event.get("notes") or "").casefold()
        location = (event.get("location") or "").casefold()
        if args.field == "title":
            matched = needle in title
        elif args.field == "notes":
            matched = needle in notes
        else:
            matched = needle in title or needle in notes or needle in location
        if matched:
            hits.append(event)
            if args.limit and len(hits) >= args.limit:
                break
    return {"query": args.query, "field": args.field,
            "from": _utc_iso(start), "to": _utc_iso(end),
            "timezone": cfg["timezone"],
            "calendars": [cal["name"] for cal in calendars],
            "count": len(hits), "events": hits}


def _declined(cfg: dict, event: dict) -> bool:
    """This principal has declined the invitation, so the slot is free."""
    for attendee in event.get("attendees") or []:
        if (attendee.get("email") or "").casefold() == cfg["address"].casefold():
            return (attendee.get("partstat") or "").upper() == "DECLINED"
    return False


def cmd_freebusy(cfg: dict, args) -> dict:
    start, end = _window(cfg, args.frm, args.to, 0)   # both bounds are required
    wanted = [token.strip() for token in (args.calendars or "").split(",")
              if token.strip()]
    with _client(cfg) as client:
        calendars = _pick_calendars(client, cfg, wanted)
        events = _read_window(client, cfg, calendars, start, end, full=True)
    spans: list[tuple[datetime, datetime]] = []
    drifted: list[dict] = []
    for event in events:
        if (event.get("status") or "").upper() == "CANCELLED":
            continue
        if event.get("transparent") or _declined(cfg, event):
            continue
        if event.get("zoneFallback"):
            drifted.append({"uid": event.get("uid"),
                            "tzid": event["zoneFallback"]})
        bounds = _bounds_utc(event, cfg)
        if bounds is None:
            continue
        first, last = max(bounds[0], start), min(bounds[1], end)
        if last <= first:
            continue
        spans.append((first, last))
    return {"from": _utc_iso(start), "to": _utc_iso(end),
            "timezone": cfg["timezone"],
            "calendars": [cal["name"] for cal in calendars],
            "considered": len(events), "unresolved_zones": drifted,
            "busy": _merge_intervals(spans)}


def cmd_create(cfg: dict, args) -> dict:
    if args.all_day:
        start = _parse_input_date(args.frm, cfg, "--from")
        end = _parse_input_date(args.to, cfg, "--to")
        if end <= start:
            end = start + timedelta(days=1)
    else:
        start = _parse_input_dt(args.frm, cfg, "--from")
        end = _parse_input_dt(args.to, cfg, "--to")
        if end <= start:
            _die(6, "bad_window", "--to must be after --from")
    alarms = [_parse_alarm(spec, cfg) for spec in (args.alarm or [])]
    with _client(cfg) as client:
        calendar = _pick_calendars(client, cfg, [args.calendar])[0]
        if calendar.get("writable") is False:
            _die(2, "forbidden",
                 f"the server grants this account no write privilege on "
                 f"{calendar['name']!r}",
                 "the connection may write and the calendar is in scope; the "
                 "refusal is the server's — ask the user for a calendar this "
                 "account may write")
        uid = f"{uuid.uuid4()}@{NAME}.capability"
        body = _build_vevent(cfg, uid, {
            "title": args.title, "start": start, "end": end,
            "all_day": bool(args.all_day), "location": args.location,
            "notes": args.notes, "url": args.url or cfg["meeting_url"],
            "invitees": args.invitee or [],
        }, alarms)
        href = calendar["href"] + quote(uid, safe="@") + ".ics"
        resp = _request(client, "PUT", href, body=body, expect=(200, 201, 204),
                        headers={"Content-Type": "text/calendar; charset=utf-8",
                                 "If-None-Match": "*"})
    return {"created": True, "uid": uid, "href": href,
            "etag": resp.headers.get("ETag"),
            "calendar": calendar["name"], "calendarHref": calendar["href"],
            "startDate": start.isoformat() if args.all_day else _utc_iso(start),
            "endDate": end.isoformat() if args.all_day else _utc_iso(end),
            "allDay": bool(args.all_day),
            "url": args.url or cfg["meeting_url"],
            "invitees": args.invitee or [],
            "conferencing": None}


def _split_body(body: list[str]) -> tuple[list[str], list[list[str]]]:
    """A VEVENT's own property lines, and its sub-components kept whole."""
    props: list[str] = []
    subs: list[list[str]] = []
    depth, current = 0, []
    for line in body:
        parsed = _ics_split(line)
        name = parsed[0] if parsed else ""
        if name == "BEGIN":
            depth += 1
            current.append(line)
            continue
        if name == "END":
            depth -= 1
            current.append(line)
            if depth == 0:
                subs.append(current)
                current = []
            continue
        (current if depth else props).append(line)
    return props, subs


def _local_date(value: datetime, cfg: dict) -> date:
    """The day a moment falls on where the calendar lives. Payload timestamps
    are UTC, so an 8 pm event west of Greenwich is already tomorrow there;
    deriving an all-day boundary from the UTC date would move it a day."""
    return value.astimezone(cfg.get("zone") or UTC).date()


def _existing_dt(raw: str | None, cfg: dict) -> datetime | None:
    """One boundary as it is stored, as an aware datetime. An all-day boundary
    is a bare date, so it takes the connection's zone (UTC when none)."""
    if not raw:
        return None
    value = datetime.fromisoformat(raw)
    if value.tzinfo is None:
        value = value.replace(tzinfo=cfg.get("zone") or UTC)
    return value


def _sub_name(sub: list[str]) -> str:
    parsed = _ics_split(sub[0]) if sub else None
    return (parsed[2].strip().upper() if parsed else "")


def _rebuild_event(cfg: dict, source: str, existing: dict, *,
                   text_changes: dict, new_start: datetime | None,
                   new_end: datetime | None, all_day: bool,
                   alarms: list[dict], add_invitees: list[str]) -> tuple[str, int]:
    """The stored object with the requested changes applied, as text to PUT
    back. Everything the caller did not name survives verbatim — other
    components, unknown properties, sub-components — because a calendar server
    round-trips more than this CLI models, and dropping it would be silent."""
    lines = _ics_unfold(source)
    begin = next(i for i, line in enumerate(lines)
                 if line.strip().upper() == "BEGIN:VEVENT")
    finish = next(i for i in range(len(lines) - 1, -1, -1)
                  if lines[i].strip().upper() == "END:VEVENT")
    props, subs = _split_body(lines[begin + 1:finish])

    # Time is rewritten whole whenever either boundary moves or the all-day
    # flag flips: DTSTART and DTEND must agree on their value type.
    retimed: list[str] = []
    if new_start or new_end or all_day != bool(existing["allDay"]):
        start = new_start or _existing_dt(existing["startDate"], cfg)
        end = new_end or _existing_dt(existing["endDate"], cfg)
        if start is None or end is None:
            _die(6, "incomplete_event",
                 "the stored event carries no readable start or end",
                 "pass both --from and --to to restate them")
        if all_day:
            start, end = _local_date(start, cfg), _local_date(end, cfg)
            if end <= start:
                end = start + timedelta(days=1)
        elif end <= start:
            _die(6, "bad_window", "--to must be after --from",
                 f"got {_utc_iso(start)} .. {_utc_iso(end)} — moving one "
                 f"boundary keeps the other, so pass both to reschedule")
        retimed = (_when_props("DTSTART", start, all_day)
                   + _when_props("DTEND", end, all_day))

    drop = set(text_changes) | {"DTSTAMP", "LAST-MODIFIED", "SEQUENCE"}
    if retimed:
        drop |= {"DTSTART", "DTEND", "DURATION"}
    sequence = _int(str(existing.get("sequence") or 0)) + 1
    stamp = _ics_stamp(datetime.now(UTC))
    rebuilt = [line for line in props
               if (_ics_split(line) or ("", {}, ""))[0] not in drop]
    rebuilt.append(f"DTSTAMP:{stamp}")
    rebuilt.append(f"LAST-MODIFIED:{stamp}")
    rebuilt.append(f"SEQUENCE:{sequence}")
    rebuilt.extend(retimed)
    for name, value in text_changes.items():
        rebuilt.append(f"{name}:{value}")
    for invitee in add_invitees:
        rebuilt.append(_attendee_line(invitee))
    if alarms:
        subs = [sub for sub in subs if _sub_name(sub) != "VALARM"]
        title = existing.get("title") or ""
        subs.extend(_alarm_lines(alarm, title) for alarm in alarms)

    body = list(lines[:begin + 1]) + rebuilt
    for sub in subs:
        body.extend(sub)
    body.extend(line for line in lines[finish:] if line.strip())
    return "\r\n".join(_ics_fold(line) for line in body) + "\r\n", sequence


def cmd_update(cfg: dict, args) -> dict:
    text_changes: dict = {}
    if args.title is not None:
        text_changes["SUMMARY"] = _ics_escape(args.title)
    if args.location is not None:
        text_changes["LOCATION"] = _ics_escape(args.location)
    if args.notes is not None:
        text_changes["DESCRIPTION"] = _ics_escape(args.notes)
    if args.url is not None:
        text_changes["URL"] = _clean(args.url, "--url", drop="")
    new_start = _parse_input_dt(args.frm, cfg, "--from") if args.frm else None
    new_end = _parse_input_dt(args.to, cfg, "--to") if args.to else None
    all_day = True if args.all_day else (False if args.no_all_day else None)
    alarms = [_parse_alarm(spec, cfg) for spec in (args.alarm or [])]
    if not (text_changes or new_start or new_end or alarms
            or args.add_invitee or all_day is not None):
        _die(6, "nothing_to_update", "update needs at least one field flag",
             "pass --title/--from/--to/--location/--notes/--url/--all-day/"
             "--no-all-day/--add-invitee/--alarm")

    with _client(cfg) as client:
        calendars = _pick_calendars(client, cfg, [])
        found = _locate(client, cfg, calendars, args.event,
                        args.frm_scan, args.to_scan)
        _enforce_write(cfg["id"], cfg["scope"], cfg["allow_write"], "update",
                       found["calendar"]["name"] or found["calendar"]["href"])
        components = found["components"]
        if len(components) != 1:
            _die(6, "recurring_event",
                 f"{found['href']} carries {len(components)} VEVENT components",
                 "this object is a series with per-occurrence overrides; "
                 "per-occurrence edits are outside this capability's surface")
        existing = _event_payload(cfg, found["calendar"], found["href"],
                                  found["etag"], components[0], full=True)
        if all_day is None:
            all_day = bool(existing["allDay"])
        if args.title is not None:
            existing["title"] = args.title
        payload, sequence = _rebuild_event(
            cfg, found["text"], existing, text_changes=text_changes,
            new_start=new_start, new_end=new_end, all_day=all_day,
            alarms=alarms, add_invitees=args.add_invitee or [])
        headers = {"Content-Type": "text/calendar; charset=utf-8"}
        if found["etag"]:
            headers["If-Match"] = found["etag"]
        resp = _request(client, "PUT", found["href"], body=payload,
                        expect=(200, 201, 204), headers=headers)
    return {"updated": True, "uid": existing["uid"], "href": found["href"],
            "etag": resp.headers.get("ETag"),
            "calendar": found["calendar"]["name"],
            "allDay": all_day, "sequence": sequence}


def cmd_delete(cfg: dict, args) -> dict:
    with _client(cfg) as client:
        calendars = _pick_calendars(client, cfg, [])
        found = _locate(client, cfg, calendars, args.event, args.frm_scan,
                        args.to_scan)
        _enforce_write(cfg["id"], cfg["scope"], cfg["allow_write"], "delete",
                       found["calendar"]["name"] or found["calendar"]["href"])
        components = _ics_components(found["text"], "VEVENT")
        uid = _text(components[0], "UID") if components else None
        headers = {}
        if found["etag"]:
            headers["If-Match"] = found["etag"]
        _request(client, "DELETE", found["href"], expect=(200, 202, 204),
                 headers=headers)
    return {"deleted": True, "uid": uid, "href": found["href"],
            "calendar": found["calendar"]["name"]}


# --- CLI ---------------------------------------------------------------------

class _Parser(argparse.ArgumentParser):
    """argparse refuses a bad invocation with its own text and exit 2, which is
    this taxonomy's auth code. A usage error is input, so it leaves through the
    same envelope every other refusal does."""

    def error(self, message):     # noqa: A003 - argparse's own hook name
        _die(6, "bad_usage", message, f"run `{NAME} help` for the full surface")


def main() -> None:
    _gate()                      # every verb passes the effective policy gate first
    cleaned, wanted_conn = _extract_connection(sys.argv[1:])
    _contract(cleaned)           # contract verbs; domain verbs fall through

    p = _Parser(
        prog=NAME, description="CalDAV CLI for remote calendars "
                               "(read + write, connection-gated).")
    p.set_defaults(_parser_class=_Parser)
    sub = p.add_subparsers(dest="cmd", required=True, parser_class=_Parser)

    sub.add_parser("help", help="Print the full usage contract.")
    sub.add_parser("doctor", help="Prove the credential, endpoint and principal.")
    sub.add_parser("calendars", help="List the calendars in scope.")

    pe = sub.add_parser("events", help="List events in a window.")
    pe.add_argument("--calendar", help="Restrict to one calendar (name or href)")
    pe.add_argument("--from", dest="frm", help="ISO datetime; default today")
    pe.add_argument("--to", help="ISO datetime; default today+7d")
    pe.add_argument("--limit", type=int, default=0, help="Cap results (0 = no cap)")

    psh = sub.add_parser("show", help="Show one event by uid or href.")
    psh.add_argument("event")
    psh.add_argument("--scan-from", dest="frm_scan",
                     help="ISO datetime; start of the uid scan fallback")
    psh.add_argument("--scan-to", dest="to_scan",
                     help="ISO datetime; end of the uid scan fallback")

    ps = sub.add_parser("search", help="Search events in a window.")
    ps.add_argument("query")
    ps.add_argument("--calendar", help="Restrict to one calendar (name or href)")
    ps.add_argument("--from", dest="frm", help="ISO datetime; default today")
    ps.add_argument("--to", help="ISO datetime; default today+30d")
    ps.add_argument("--field", choices=["title", "notes", "any"], default="any")
    ps.add_argument("--limit", type=int, default=0)

    pf = sub.add_parser("freebusy", help="Merged busy blocks across a window.")
    pf.add_argument("--from", dest="frm", required=True, help="ISO datetime")
    pf.add_argument("--to", required=True, help="ISO datetime")
    pf.add_argument("--calendars",
                    help="Comma-separated calendar names or hrefs; "
                         "default: every calendar in the connection scope")

    pcr = sub.add_parser("create", help="Book an event (write-gated).")
    pcr.add_argument("--calendar", required=True,
                     help="Target calendar (name or href; must be in scope)")
    pcr.add_argument("--title", required=True)
    pcr.add_argument("--from", dest="frm", required=True, help="ISO datetime")
    pcr.add_argument("--to", required=True, help="ISO datetime")
    pcr.add_argument("--all-day", action="store_true", dest="all_day")
    pcr.add_argument("--location")
    pcr.add_argument("--notes", help="Description / notes")
    pcr.add_argument("--url", help="Meeting or reference URL; defaults to the "
                                   "connection's meeting_url. Carried, not minted")
    pcr.add_argument("--invitee", action="append", metavar="EMAIL",
                     help="Attendee address or `Name <address>` (repeatable)")
    pcr.add_argument("--alarm", action="append", metavar="SPEC",
                     help="Alarm: --alarm=-15m / -1h / -1d, or an absolute ISO "
                          "datetime (repeatable; use the =VALUE form)")

    pup = sub.add_parser("update", help="Change an event (write-gated).")
    pup.add_argument("event")
    pup.add_argument("--title")
    pup.add_argument("--from", dest="frm", help="ISO datetime; new start")
    pup.add_argument("--to", help="ISO datetime; new end")
    pup.add_argument("--all-day", action="store_true", dest="all_day")
    pup.add_argument("--no-all-day", action="store_true", dest="no_all_day")
    pup.add_argument("--location")
    pup.add_argument("--notes")
    pup.add_argument("--url")
    pup.add_argument("--add-invitee", action="append", metavar="EMAIL",
                     dest="add_invitee",
                     help="Add an attendee (repeatable); existing ones stay")
    pup.add_argument("--alarm", action="append", metavar="SPEC",
                     help="Replace the alarm set (--alarm=-15m; repeatable)")
    pup.add_argument("--scan-from", dest="frm_scan",
                     help="ISO datetime; start of the uid scan fallback")
    pup.add_argument("--scan-to", dest="to_scan",
                     help="ISO datetime; end of the uid scan fallback")

    pdel = sub.add_parser("delete", help="Remove an event (write-gated).")
    pdel.add_argument("event")
    pdel.add_argument("--scan-from", dest="frm_scan",
                      help="ISO datetime; start of the uid scan fallback")
    pdel.add_argument("--scan-to", dest="to_scan",
                      help="ISO datetime; end of the uid scan fallback")

    args = p.parse_args(cleaned)

    if args.cmd == "help":
        sys.stdout.write((__doc__ or "").lstrip("\n"))
        return
    if args.cmd == "doctor":
        cmd_doctor(wanted_conn)
        return

    reg, _ = _connections_registry()
    cid, entry = _select_connection(reg, wanted_conn)
    _gate_from_registry(cid, entry, args.cmd, getattr(args, "calendar", None))
    cfg = _load_config(cid, entry)

    dispatch = {
        "calendars": cmd_calendars, "events": cmd_events, "show": cmd_show,
        "search": cmd_search, "freebusy": cmd_freebusy, "create": cmd_create,
        "update": cmd_update, "delete": cmd_delete,
    }
    _emit(dispatch[args.cmd](cfg, args))


if __name__ == "__main__":
    main()
