    "supervisor": "supervisord.conf",
}
# What a runtime that names its artifact paths wrote at the root by default. A
# bundled runtime reports any of these that still carry the generated marker,
# because they no longer reach a build and only mislead a reader.
ROOT_LAYOUT_FILES = ("Dockerfile", "docker-compose.yaml", ".dockerignore",
                     ".env.example", "entrypoint.sh", "supervisord.conf",
                     SYNC_PROGRAM)
# Coolify creates this environment with every project; a deploy places its
# application there unless the target names another existing one, and never
# creates an environment of its own.
COOLIFY_ENVIRONMENT = "production"


