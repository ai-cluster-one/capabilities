# supervised processes on the machine itself.
CONTAINER_PROFILES = ("agent-box", "agent-box-checkout")
HOST_PROFILES = ("host-agents",)
# launchd's ProcessType for the agents a host compiles. A supervised service
# runs real work and its children inherit the class, so it gets Standard, the
# full machine; Background would confine it to the efficiency cores at the
# lowest priority with throttled I/O. A watchdog is a short scheduled probe and
# stays out of the way.
SERVICE_PROCESS_TYPE = "Standard"
WATCHDOG_PROCESS_TYPE = "Background"
# What `launchctl print` names as the spawn type of each ProcessType.
LAUNCHD_SPAWN_TYPES = {"Standard": "daemon", "Background": "background",
                       "Interactive": "interactive", "Adaptive": "adaptive"}
# A checkout profile builds the same container and fills it differently. The
# image carries tools and the boot path and no project at all; the checkout
# arrives at run time on a volume, which the entrypoint clones into while it is
# still empty. Everything else follows from that: what needs a checkout to exist
# cannot run at build time, so it runs at boot, the boot inputs are copied
# somewhere the volume cannot mask them, and keeping the body level with the
# branch it tracks becomes the profile's own work rather than the project's.
CHECKOUT_PROFILES = ("agent-box-checkout",)
BOOT_DIR = "/opt/agent"
BODY_VOLUME = "agent_body"
LOCK_REL = "deployment/capabilities.lock"
REPO_URL_ENV = "AGENT_REPO_URL"
REPO_BRANCH_ENV = "AGENT_REPO_BRANCH"
# The one program the compiler owns on this substrate. Every other Supervisor
# program comes from an installed capability's deploy descriptor; this one comes
# from the profile, because keeping the body current is a property of the runtime
# shape rather than of any project running on it. It is on unless an operator
# says otherwise: a checkout that neither takes in what was pushed nor sends what
# it wrote is a half-configured box, not a choice.
SYNC_PROGRAM = "body-sync.sh"
SYNC_SERVICE = "body-sync"
SYNC_ENABLED_ENV = "AGENT_BODY_SYNC"
SYNC_INTERVAL_ENV = "AGENT_BODY_SYNC_INTERVAL"
SYNC_QUIET_ENV = "AGENT_BODY_SYNC_QUIET"
SYNC_TRAILER = "Body-Sync: agent-box-checkout"
# What Supervisor counts as a successful start, and the only bound there is on a
# program that dies the moment it is spawned. Below this window an exit is a
# start failure Supervisor backs off from and reports; above it an exit is a
# restart it repeats at once and forever, while `status` still reads RUNNING. A
# window of zero therefore buys an unbounded respawn that announces itself as
# healthy, which is worse than either honest answer.
SYNC_START_SECONDS = 3
SYNC_DEFAULTS = {
    SYNC_ENABLED_ENV: "1",
    # Long enough that a burst of writing is one snapshot rather than five, short
    # enough that what the box wrote and what was pushed to it are never more
    # than a working pause apart.
    SYNC_INTERVAL_ENV: "300",
    SYNC_QUIET_ENV: "600",
}
HOST_SUPERVISORS = ("launchd",)
# A supervisor restarts a process that died. It cannot see one that is alive
# and doing nothing — the shape a deadlock leaves behind, where the process
# sits in the list at 0% CPU and answers nobody. Each service already declares
# the command that proves it works, so the watchdog asks that, and asks twice
# before acting: one bad answer is a service that is still starting or a probe
# that timed out, and restarting on it would be worse than the silence.
WATCHDOG_DEFAULTS = {
    "enabled": True,
    "interval_seconds": 60,
    "failures_before_restart": 2,
    "probe_timeout_seconds": 30,
    "restart_cooldown_seconds": 300,
}
PROVIDERS = ("coolify", "dockerhost", "manual")
PROVIDER_CAPABILITIES = {"coolify": "coolify", "dockerhost": "dockerhost"}
# A container runtime compiles one bundle per target: everything a build of that
# target reads sits in deployment/targets/<target>/ beside its declaration, and
# the project root gains nothing but the files a tool can only read there. The
# build context stays the project root, because the image copies the agent body
# from it, so the Compose file reaches it as ../../.. from its own folder, and
# the ignore file is named for the Dockerfile it serves, since Docker reads a
# plain .dockerignore only at the root of the context.
TARGET_FILE = "target.json"
BUNDLE_FILES = {
    "compose": "docker-compose.yaml",
    "dockerfile": "Dockerfile",
    "dockerignore": "Dockerfile.dockerignore",
