#!/usr/bin/env python3
"""Worker-side `slack` shim (on PATH ahead of the real CLI inside a service worker).

The daemon removes Slack credentials from the direct worker environment.
`slack post|send` appends text to the daemon's per-job outbox; the daemon posts
it to the current conversation. Every other verb through this shim fails closed.
An unrestricted worker is not OS-isolated from alternate credential or
executable paths; context.md supplies that behavioral boundary."""

import json
import os
import sys

OUTBOX = os.environ.get("SLACK_WORKER_OUTBOX", "")
CONV = os.environ.get("SLACK_WORKER_CONVERSATION", "")


def _fail(code, msg):
    sys.stderr.write(json.dumps({"ok": False, "error": msg}) + "\n")
    sys.exit(code)


def _positional(args):
    out, i = [], 0
    while i < len(args):
        if args[i] in ("--connection", "--thread"):
            i += 2
            continue
        out.append(args[i])
        i += 1
    return out


def main():
    args = sys.argv[1:]
    verb = args[0] if args else ""
    if verb not in ("post", "send"):
        _fail(4, "scope: Slack workers may only post through the current-chat outbox")
    pos = _positional(args[1:])
    if len(pos) < 2:
        _fail(6, "usage: slack post current <text>")
    target, text = pos[0], " ".join(pos[1:])
    current_channel = CONV.split(":", 1)[0]
    if target not in {"current", ".", current_channel}:
        _fail(4, "scope: worker may only post to target `current`")
    if not OUTBOX:
        _fail(3, "slack shim: no outbox configured (SLACK_WORKER_OUTBOX unset)")
    payload = (json.dumps({"text": text}, ensure_ascii=False) + "\n").encode()
    fd = os.open(OUTBOX, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    try:
        view = memoryview(payload)
        while view:
            written = os.write(fd, view)
            if written <= 0:
                _fail(5, "slack shim: could not append to the worker outbox")
            view = view[written:]
        os.fsync(fd)
    finally:
        os.close(fd)
    print(json.dumps({"ok": True, "queued": True}))


if __name__ == "__main__":
    main()
