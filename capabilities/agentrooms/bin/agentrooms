POST_INSTALL: list[dict] = []
SERVICE = {
    "name": "rooms",
    "summary": ("Wakes opted-in agents on a mention, a direct message, an invite or a "
                "marked room, one /sync long-poll per agent, and answers through one "
                "resumed harness session per agent per room; once per machine for the "
                "projects that join it."),
    "verbs": ["init", "doctor", "run", "reload", "stop", "status", "logs", "pause",
