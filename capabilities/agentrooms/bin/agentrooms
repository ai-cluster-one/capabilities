# >>> contract: capability core (generated — edit contract/preamble.py, run `capabilities sync-contract`) >>>

# --- Error reporting ---------------------------------------------------------

def _die(exit_code: int, code: str, message: str,
         hint: str | None = None, status: int | None = None) -> NoReturn:
    err: dict = {"code": code, "message": message}
    if hint:
        err["hint"] = hint
    if status is not None:
        err["status"] = status
    sys.stderr.write(json.dumps({"error": err}, ensure_ascii=False) + "\n")
    sys.exit(exit_code)


def _emit(value) -> None:
    if isinstance(value, str):
        sys.stdout.write(value)
        if value and not value.endswith("\n"):
            sys.stdout.write("\n")
    else:
        sys.stdout.write(json.dumps(value, ensure_ascii=False, indent=2) + "\n")


# --- Project / file plumbing -------------------------------------------------

def _parse_env_file(path: Path) -> dict:
    """Parse a KEY=VALUE env/dotenv file. Missing/unreadable file -> {}."""
    out: dict = {}
    try:
        text = path.read_text()
    except OSError:
        return out
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        k = k.strip()
        if k.startswith("export "):
            k = k[len("export "):].strip()
        out[k] = v.strip().strip('"').strip("'")
    return out


def _home_dirs() -> set[Path]:
    """Every directory that is a home directory of the account running this.

    $HOME answers for the process and moves wherever a caller points it; the
    password database answers for the account and cannot be pointed anywhere.
    A caller that redirects $HOME - a dev lane, a service under a supervisor, a
    sandbox - would otherwise carry the guard onto the home it invented and stop
    excluding the account's own, which is the one the machine registry sits in.
    """
    import pwd

    homes: set[Path] = set()
    candidates = [Path.home()]
    try:
        account = pwd.getpwuid(os.getuid()).pw_dir
    except (KeyError, OSError):
        account = ""
    # The account's field counts only when it is absolute. An empty or relative
    # one names no directory of its own: it resolves against the cwd, an empty
    # one to the cwd itself, so taken as a home it would stop the walk wherever
    # the process stands. Some service accounts carry an empty field.
    if os.path.isabs(account):
        candidates.append(Path(account))
    for candidate in candidates:
        try:
            homes.add(candidate.resolve())
        except OSError:
            continue
    return homes


def _is_machine_registry(path: Path) -> bool:
    """Whether this `.capabilities/` is a machine registry, not a legacy envelope.

    The two share the name, and only the registry carries `.manager/`. The
    registry $CAPABILITIES_HOME points at names itself even without it.
    """
    registry = Path(os.environ.get("CAPABILITIES_HOME") or (Path.home() / ".capabilities"))
    try:
        if path.resolve() == registry.resolve():
            return True
    except OSError:
        return False
    return (path / ".manager").is_dir()


def _project_root() -> Path | None:
    """Nearest project root, walking up from $CLAUDE_PROJECT_DIR (else cwd):
    the first directory holding capabilities/, legacy .capabilities/,
    .contextkit/config.toml, .env(.local), or .git.
    Markers are read from the filesystem alone: the root is what the envelope
    location is resolved against, so resolving one cannot depend on the other.
    A home directory is never a project root (the machine registry lives in
    one), and a `.capabilities/` that is a machine registry names that registry
    rather than a legacy envelope."""
    start = os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
    here = Path(start).resolve()
    homes = _home_dirs()
    for d in (here, *here.parents):
        if d in homes:
            return None
        legacy = d / ".capabilities"
        # Either marker names a project. `settings.json` is the gate and
        # `project.json` the identity; either one alone is enough.
        if ((d / "capabilities" / "settings.json").is_file()
                or (d / "capabilities" / "project.json").is_file()
                or (d / ".contextkit" / "config.toml").is_file()
                or (legacy.is_dir() and not _is_machine_registry(legacy))
                or (d / ".env").exists()
                or (d / ".env.local").exists() or (d / ".git").is_dir()):
            return d
    return None


_ENVELOPE_HOME: dict = {}


def _validated_project_envelope(root: Path, raw, provider: str) -> Path:
    """Validate the manager/context-owner answer without selecting a fallback."""
    value = str(raw or "").strip()
    if not value:
        _die(6, "project_envelope_empty",
             f"{provider} returned an empty capabilities envelope path")
    candidate = Path(value).expanduser()
    if not candidate.is_absolute():
        _die(6, "project_envelope_relative",
             f"{provider} returned a relative capabilities envelope path: {value!r}")
    try:
        resolved = candidate.resolve()
        resolved.relative_to(root.resolve())
    except (OSError, ValueError):
        _die(6, "project_envelope_outside_project",
             f"{provider} returned a capabilities envelope outside the project: {candidate}")
    return resolved


def _handed_off_envelope(root: Path) -> str:
    """The handoff meant for THIS project root, or "" when there is none.

    `CAPABILITIES_PROJECT_ENVELOPE` is inherited by every descendant process, and
    a descendant does not always stand in the project its parent stood in: a peer
    spawned in another project, or a worker whose cwd sits under a different root,
    must resolve its own envelope. `CAPABILITIES_PROJECT_ENVELOPE_ROOT` names the
    root the handed value answers for, so a handoff that crossed a project
    boundary is passed over instead of being applied to the wrong project. A
    handoff supplied without that companion belongs to whoever launched the
    process and is honored as given, which is how a context owner hands its answer
    over in advance.
    """
    override = os.environ.get("CAPABILITIES_PROJECT_ENVELOPE", "").strip()
    if not override:
        return ""
    scope = os.environ.get("CAPABILITIES_PROJECT_ENVELOPE_ROOT", "").strip()
    if not scope:
        return override
    try:
        if Path(scope).expanduser().resolve() != root.resolve():
            return ""
    except OSError:
        return ""
    return override


ENVELOPE_CACHE_VERSION = 1
IDENTITY_CACHE_VERSION = 1


def _record_file(kind: str, key: str) -> Path:
    """Where the manager records one kind of answer for one absolute project root.

    The file name only buckets roots apart; the entry's own `root` field is what
    proves identity, so two roots landing in one bucket cost a miss rather than
    a wrong answer.
    """
    import zlib

    base = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache"))
    return (base / "capabilities" / kind
            / f"{format(zlib.crc32(key.encode()), '08x')}.json")


def _envelope_witness(path) -> dict:
    """One input a recorded answer rests on, as that input stands right now."""
    try:
        seen = os.stat(path)
    except OSError:
        return {"path": str(path), "present": False}
    return {"path": str(path), "present": True,
            "size": seen.st_size, "mtime_ns": seen.st_mtime_ns}


def _cached_record(kind: str, version: int, root: Path):
    """The recorded entry for this root while every input it rests on holds.

    The manager writes the record and names the inputs its answer consulted; a
    reader re-observes each of them and compares it whole. Anything at all in
    doubt — an unreadable file, an unexpected shape, an input that moved, an
    expiry already behind the clock or a write ahead of it — returns None and
    costs a full resolution, so the failure mode is slow and never wrong.
    """
    import time

    key = str(root.resolve())
    try:
        entry = json.loads(_record_file(kind, key).read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(entry, dict):
        return None
    if entry.get("version") != version or entry.get("root") != key:
        return None
    written, expires = entry.get("written_at"), entry.get("expires_at")
    if not isinstance(written, (int, float)) or not isinstance(expires, (int, float)):
        return None
    now = time.time()
    if now < written or now >= expires:
        return None
    witness = entry.get("witness")
    if not isinstance(witness, list):
        return None
    for observed in witness:
        if (not isinstance(observed, dict)
                or _envelope_witness(observed.get("path")) != observed):
            return None
    return entry


def _cached_envelope(root: Path):
    """The recorded envelope for this root, while its record stands."""
    entry = _cached_record("envelope", ENVELOPE_CACHE_VERSION, root)
    if entry is None:
        return None
    envelope = Path(str(entry.get("envelope") or ""))
    if not envelope.is_absolute():
        return None
    try:
        envelope.resolve().relative_to(entry["root"])
    except (OSError, ValueError):
        return None
    return envelope


def _ask_manager(root: Path, *flags: str) -> tuple:
    """`capabilities path --json` for this root: (answer, None) or (None, error).

    The error carries the exit code the caller should use and the manager's own
    code, message and hint where it gave them."""
    import subprocess

    env = dict(os.environ)
    env["CLAUDE_PROJECT_DIR"] = str(root)
    # Asked at all, the manager answers from ContextKit: a live id hand-down for
    # this root is used before asking, so any in the environment is this
    # process's own and must not come back as the answer.
    env.pop("CAPABILITIES_PROJECT_ID", None)
    env.pop("CAPABILITIES_PROJECT_ID_ROOT", None)
    manager = os.environ.get("CAPABILITIES_MANAGER_BIN", "").strip()
    if not manager:
        source_manager = Path(__file__).resolve().parents[3] / "bin" / "capabilities"
        manager = str(source_manager) if source_manager.is_file() else "capabilities"
    try:
        proc = subprocess.run(
            [manager, "path", "--json", *flags], cwd=root, env=env,
            capture_output=True, text=True, timeout=10)
    except FileNotFoundError:
        return None, {"exit": 6, "code": "capabilities_manager_unavailable",
                      "message": "the capabilities manager is required to resolve the project",
                      "hint": "install or repair the `capabilities` command"}
    except subprocess.TimeoutExpired:
        return None, {"exit": 6, "code": "capabilities_path_timeout",
                      "message": "the capabilities manager did not resolve the project within 10 seconds"}
    except OSError as exc:
        return None, {"exit": 6, "code": "capabilities_manager_unavailable",
                      "message": f"could not run the capabilities manager: {exc}"}
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip()
        try:
            error = json.loads(detail).get("error", {})
        except (AttributeError, ValueError):
            error = {}
        return None, {"exit": proc.returncode if proc.returncode in (3, 4, 5, 6) else 6,
                      "code": str(error.get("code") or "capabilities_path_failed"),
                      "message": str(error.get("message") or "the capabilities manager could not resolve the project"),
                      "hint": str(error.get("hint") or detail or "run `capabilities path --json` for details")}
    try:
        answer = json.loads(proc.stdout)
    except ValueError as exc:
        return None, {"exit": 6, "code": "capabilities_path_malformed",
                      "message": f"the capabilities manager returned invalid JSON: {exc}"}
    if not isinstance(answer, dict):
        return None, {"exit": 6, "code": "capabilities_path_malformed",
                      "message": "the capabilities manager path answer must be a JSON object"}
    manager_root = Path(str(answer.get("project_root") or ""))
    if not manager_root.is_absolute() or manager_root.resolve() != root.resolve():
        return None, {"exit": 6, "code": "capabilities_project_mismatch",
                      "message": "the capabilities manager resolved a different project root"}
    return answer, None


def _manager_project_envelope(root: Path) -> Path:
    """Consume the capabilities manager's one authoritative project answer."""
    override = _handed_off_envelope(root)
    if override:
        return _validated_project_envelope(root, override, "environment handoff")
    answer, error = _ask_manager(root)
    if error:
        _die(error["exit"], error["code"], error["message"], error.get("hint"))
    provider = str(answer.get("provider") or "capabilities manager")
    return _validated_project_envelope(
        root, answer.get("project_envelope"), provider)


def _envelope_home(root: Path) -> Path:
    """The project's envelope root, resolved once per invocation.

    The capabilities manager owns project-envelope discovery, including any
    delegation to ContextKit. Capability CLIs consume that answer and never
    duplicate context-owner detection.

    The answer is then handed to this process's descendants, scoped to the root
    it answers for. Asking for it costs two interpreter starts — the manager and
    the context owner it delegates to — so a worker, a peer, or a nested
    capability call that would otherwise repeat the whole chain under whatever
    load the machine is under by then reads it instead.

    A fresh top-level call has no such handoff, and reads the manager's recorded
    answer for this root instead, which stands only while every input that answer
    rests on is unchanged. A live handoff outranks the record, and any doubt about
    the record asks the manager again.
    """
    cached = _ENVELOPE_HOME.get(root)
    if cached is not None:
        return cached
    home = None if _handed_off_envelope(root) else _cached_envelope(root)
    if home is None:
        home = _manager_project_envelope(root)
    _ENVELOPE_HOME[root] = home
    os.environ["CAPABILITIES_PROJECT_ENVELOPE"] = str(home)
    os.environ["CAPABILITIES_PROJECT_ENVELOPE_ROOT"] = str(root)
    # The id travels with the envelope: resolved at read level, handed down
    # only where a write may stamp it, and never a reason to refuse here.
    try:
        _project_id_state_at(root)
    except Exception:
        pass
    return home


def _project_capabilities_dir(root: Path) -> Path:
    """The active project envelope root.

    The resolved envelope is canonical. A legacy `.capabilities/` remains
    readable until `capabilities init` migrates it. If both exist, the canonical
    tree wins once it carries either the legacy file gate or the project identity;
    otherwise the legacy configured tree remains active so merely creating an
    empty visible directory loses no gate.
    """
    current = _envelope_home(root)
    legacy = root / ".capabilities"
    if ((current / "settings.json").is_file()
            or (current / "project.json").is_file()
            or not legacy.is_dir()):
        return current
    return legacy


_CONTEXT_IDENTITY: dict = {}


def _context_identity(root: Path) -> dict:
    """Whether a context owner binds this project, and the id it holds for it.

    The capabilities manager owns the answer, as it owns the envelope's: this
    reads the manager's record while every input it rests on stands, and asks
    the manager otherwise. `{"bound", "id"}`, or `{"error"}` when the manager
    cannot answer, which leaves reads on project.json and refuses writes."""
    root = root.resolve()
    known = _CONTEXT_IDENTITY.get(root)
    if known is not None:
        return known
    if not (root / ".contextkit" / "config.toml").is_file():
        # The binding the manager asks ContextKit about is absent, so the
        # manager's answer is already known: unbound, with no id of its own.
        _CONTEXT_IDENTITY[root] = {"bound": False, "id": None}
        return _CONTEXT_IDENTITY[root]
    entry = _cached_record("identity", IDENTITY_CACHE_VERSION, root)
    if (entry is not None and isinstance(entry.get("bound"), bool)
            and (entry.get("id") is None or isinstance(entry.get("id"), str))):
        answer = {"bound": entry["bound"], "id": entry.get("id")}
    else:
        reply, error = _ask_manager(root, "--identity")
        state = (reply or {}).get("project_identity")
        if error or not isinstance(state, dict) or not isinstance(state.get("bound"), bool):
            answer = {"error": error or {
                "code": "capabilities_path_malformed",
                "message": "the capabilities manager returned no project identity"}}
        else:
            answer = {"bound": state["bound"], "id": state.get("contextkit_id") or None}
    _CONTEXT_IDENTITY[root] = answer
    return answer


def _identity_verdict(bound: bool, contextkit_id, cached_id) -> dict:
    """Which id a project answers to, from the three facts that decide it.

    Unbound, the project's own project.json is the source. Bound, ContextKit's
    id is authoritative and project.json holds at most its copy; until
    ContextKit has an id, the copy is the id it will adopt."""
    if not bound:
        return {"state": "unbound", "id": cached_id}
    if contextkit_id is None:
        return {"state": "pending", "id": cached_id}
    if cached_id is not None and cached_id != contextkit_id:
        return {"state": "mismatch", "id": contextkit_id}
    return {"state": "adopted", "id": contextkit_id}


def _identity_refusal(state: dict):
    """Why a write may not stamp this project's id, or None when it may.

    An unbound project without an id is left to the caller, whose refusal
    already names `capabilities init`."""
    if state["state"] == "unresolved":
        return state["error"]
    if state["state"] == "mismatch":
        return {"code": "project_id_mismatch",
                "message": f"project.json holds project id {state['project_json_id']}, "
                           f"but ContextKit answers {state['contextkit_id']}",
                "hint": "reconcile the two by hand: ContextKit's id is the "
                        "project's, and project.json keeps only its copy"}
    if state["state"] == "pending" and not state["id"]:
        return {"code": "project_id_unassigned",
                "message": "this project's ContextKit identity has no id yet",
                "hint": "run `contextkit identity adopt` in the project"}
    return None


def _handed_off_project_id(root: Path) -> str:
    """The project id handed down for THIS root, or "" when there is none.

    A process that resolved an id a write may stamp hands it to its descendants
    beside the envelope, as `CAPABILITIES_PROJECT_ID`, scoped by
    `CAPABILITIES_PROJECT_ID_ROOT` the way the envelope handoff is scoped: one
    that crossed a project boundary is passed over, and one supplied without the
    companion belongs to whoever launched the process and is honored as given.
    """
    handed = os.environ.get("CAPABILITIES_PROJECT_ID", "").strip()
    if not handed:
        return ""
    scope = os.environ.get("CAPABILITIES_PROJECT_ID_ROOT", "").strip()
    if not scope:
        return handed
    try:
        if Path(scope).expanduser().resolve() != root.resolve():
            return ""
    except OSError:
        return ""
    return handed


_PROJECT_ID_HANDED: dict = {}


def _project_id_state():
    """The id of the project this command stands in, where it came from, and
    whether a write may stamp it; None outside a project.

    A live handoff for this root outranks ContextKit, as the envelope handoff
    outranks the record: the process that handed it verified it. Otherwise the
    manager's answer decides. An id a write may stamp is handed on to this
    process's descendants. Reading it asks no records backend: the id is what
    selects a project's records, so it is read before any of them."""
    root = _project_root()
    if root is None:
        return None
    return _project_id_state_at(root)


def _project_id_state_at(root: Path) -> dict:
    """`_project_id_state` for a known project root."""
    try:
        declared = json.loads((_project_capabilities_dir(root) / "project.json").read_text())
    except (OSError, ValueError):
        declared = None
    cached = (str(declared.get("id") or "").strip() or None
              if isinstance(declared, dict) else None)
    handed = _handed_off_project_id(root)
    if handed and _PROJECT_ID_HANDED.get(str(root)) == handed:
        handed = ""  # this process's own hand-down, not its launcher's
    if handed:
        state = _identity_verdict(True, handed, cached)
        if state["state"] != "mismatch":
            state["state"] = "handed"
        state.update(bound=None, contextkit_id=handed)
    else:
        context = _context_identity(root)
        if "error" in context:
            state = {"state": "unresolved", "id": cached, "bound": True,
                     "contextkit_id": None, "error": context["error"]}
        else:
            state = _identity_verdict(context["bound"], context["id"], cached)
            state.update(bound=context["bound"], contextkit_id=context["id"])
    state["project_json_id"] = cached
    if not handed and state["id"] and _identity_refusal(state) is None:
        os.environ["CAPABILITIES_PROJECT_ID"] = state["id"]
        os.environ["CAPABILITIES_PROJECT_ID_ROOT"] = str(root)
        _PROJECT_ID_HANDED[str(root)] = state["id"]
    return state


def _project_id(write: bool = False, refuse: bool = True):
    """The project id this command stands in, or None where there is none.

    A read takes the id in every state. A write that stamps it takes it only
    once it is verified for this invocation, and otherwise exits 6 naming what
    to settle, or, with `refuse=False`, answers None so a read path that would
    stamp the id can leave that step out instead of refusing. An unbound project
    that declares no id is still None, left to the caller's own refusal."""
    state = _project_id_state()
    if state is None:
        return None
    if write:
        refusal = _identity_refusal(state)
        if refusal:
            if not refuse:
                return None
            _die(6, refusal["code"], refusal["message"], refusal.get("hint"))
    return state["id"]


def _project_env() -> dict:
    """Project .env(.local) at the project root. .env.local overrides .env."""
    root = _project_root()
    if root is None:
        return {}
    merged = _parse_env_file(root / ".env")
    merged.update(_parse_env_file(root / ".env.local"))  # .local wins
    return merged


def _auth_context() -> dict | None:
    """Optional runtime authority envelope passed by an ingress/service.

    Absence means the ordinary project gate is the whole policy. Presence means
    a request-scoped authority layer exists and must fail closed before any
    credential or network work happens.
    """
    raw = os.environ.get("CAPABILITIES_AUTH_CONTEXT")
    if not raw:
        return None
    try:
        if raw.lstrip().startswith("{"):
            data = json.loads(raw)
        else:
            data = json.loads(Path(raw).read_text())
    except (OSError, ValueError) as e:
        _die(4, "auth_context_unreadable",
             "runtime authority context could not be read",
             f"{raw}: {e}")
    if not isinstance(data, dict):
        _die(4, "auth_context_invalid",
             "runtime authority context is not an object")
    return data


def _auth_capability_allowed(rule) -> bool:
    if rule is True or rule == "*":
        return True
    if rule in (False, None):
        return False
    if isinstance(rule, list):
        return True
    if isinstance(rule, dict):
        if rule.get("deny") is True:
            return False
        if rule.get("enabled") is False or rule.get("allow") is False:
            return False
        return True
    return False


# Verbs a rule's verb list never withholds: they say what the capability is and
# how it is configured, which is what an agent should reach for before acting.
_AUTH_CONTRACT_VERBS = frozenset(
    {"help", "guide", "ids", "connections", "refs", "stub", "manifest"})


def _auth_rule_verbs(rule) -> list | None:
    """The verbs a capability rule limits its grant to, or None when it grants
    the whole capability. A bare list is shorthand for {"verbs": [...]}."""
    if isinstance(rule, list):
        verbs = rule
    elif isinstance(rule, dict) and "verbs" in rule:
        verbs = rule["verbs"]
    else:
        return None
    if not isinstance(verbs, list) or not all(isinstance(v, str) for v in verbs):
        _die(4, "auth_context_invalid",
             f"runtime authority context has invalid verbs for {NAME}",
             "verbs must be a list of verb names")
    return verbs


def _auth_gate() -> None:
    ctx = _auth_context()
    if ctx is None:
        return
    allowed = ctx.get("allowed_capabilities")
    if allowed is None:
        return
    if allowed is True or allowed == "*":
        return
    source = ctx.get("source") or "runtime"
    role = ctx.get("sender_role") or ctx.get("role") or "unknown"
    chat = ctx.get("chat_id") or "unknown"
    if isinstance(allowed, list):
        if NAME in allowed or "*" in allowed:
            return
    elif isinstance(allowed, dict):
        rule = allowed.get(NAME, allowed.get("*"))
        if _auth_capability_allowed(rule):
            verbs = _auth_rule_verbs(rule)
            verb = sys.argv[1] if len(sys.argv) > 1 else "help"
            if verbs is None or verb in verbs or verb in _AUTH_CONTRACT_VERBS:
                return
            _die(4, "verb_not_authorized",
                 f"verb refused: `{NAME} {verb}` is not among the verbs this "
                 f"{source} request may run ({', '.join(verbs) or 'none'})",
                 f"role={role}; chat_id={chat}; adjust runtime authority policy instead of bypassing the gate")
    else:
        _die(4, "auth_context_invalid",
             "runtime authority context has invalid allowed_capabilities")
    _die(4, "capability_not_authorized",
         f"{NAME} is not authorized for this {source} request",
         f"role={role}; chat_id={chat}; adjust runtime authority policy instead of bypassing the gate")


def _policy_row():
    """The effective policy row from the same records adapter as everything else."""
    try:
        row = _records().resolve("capabilities", "policy").get(NAME)
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)
    if row is None:
        return None
    entry = row.get("value")
    if (not isinstance(entry, dict) or set(entry) != {"enabled"}
            or not isinstance(entry.get("enabled"), bool)):
        _die(6, "bad_policy",
             f"invalid {NAME} policy entry in {_records().source}",
             'expected {"enabled": true|false}')
    return row


def _project_enabled_explicitly() -> bool:
    """True only for an explicit project enabled entry; global inheritance is
    deliberately insufficient for project-owned service activation."""
    row = _policy_row()
    return bool(row and row.get("scope") == "project"
                and row["value"].get("enabled") is True)


def _require_project_enabled_for_service() -> Path:
    root = _project_root()
    if root is None or not _project_enabled_explicitly():
        _die(4, "project_enable_required",
             f"{NAME} service activation requires an explicit project enable",
             f"ask the user, then run `capabilities enable {NAME} --project` "
             "before service init/start/run")
    return root


def _read_only_gate(action: str) -> None:
    """Refuse `action` when this process runs under the read-only switch.

    The switch is decided by the store tier's `read_only_switch`; this is the
    one refusal every writer that consults it gives, so a caller branches on one
    code, and that code is distinct from a connection's own read-only grant."""
    if read_only_switch():
        _die(4, "read_only_switch",
             f"{action} is refused: {READ_ONLY_ENV} is set, so {NAME} may read "
             "but change nothing in this process",
             "Do not lift the switch yourself — ask the user; the change has to "
             f"run in a process without {READ_ONLY_ENV}.")


_MACHINE_SCHEMA = "capabilities.machine.v1"


def _machine_state() -> str:
    """This machine's ceiling for this capability: `allowed` or `quarantined`.

    The manager alone writes `$XDG_CONFIG_HOME/capabilities/machine.json`. A
    capability with no entry, and every capability while the file is absent,
    is allowed, so the ceiling only ever closes what the two scopes open."""
    path = _CONFIG_HOME / "capabilities" / "machine.json"
    try:
        data = json.loads(path.read_text())
    except FileNotFoundError:
        return "allowed"
    except (OSError, ValueError) as e:
        _die(6, "bad_machine_state", f"cannot read the machine ceiling {path}: {e}",
             "the manager alone writes it; `capabilities list` reports each "
             "capability's machine state")
    entries = data.get("capabilities") if isinstance(data, dict) else None
    if (not isinstance(data, dict) or data.get("schema") != _MACHINE_SCHEMA
            or not isinstance(entries, dict)):
        _die(6, "bad_machine_state", f"{path} is not a machine ceiling",
             f'expected {{"schema": "{_MACHINE_SCHEMA}", "capabilities": {{...}}}}')
    entry = entries.get(NAME)
    if entry is None:
        return "allowed"
    state = entry.get("state") if isinstance(entry, dict) else None
    if state not in ("allowed", "quarantined"):
        _die(6, "bad_machine_state", f"invalid {NAME} entry in {path}",
             'expected {"state": "allowed"|"quarantined", "at": ..., "by": ...}')
    return state


def _machine_gate() -> None:
    """The ceiling above both scopes: quarantined is disabled everywhere."""
    if _machine_state() == "quarantined":
        _die(4, "quarantined",
             f"{NAME} is quarantined on this machine, so no project and no "
             "machine service may use it, whatever project or global policy says",
             f"ask the user whether to allow {NAME} on this machine; if yes, they "
             f"run `capabilities allow {NAME}` - an agent never lifts a "
             "quarantine itself")


def _gate() -> None:
    """Project policy overrides global policy; absence inherits, and absence at
    both scopes is default deny. Safe local discovery verbs remain available so
    a disabled capability can be understood and configured before use.

    If an ingress supplied CAPABILITIES_AUTH_CONTEXT, that request-scoped gate
    is stricter and runs first, before credentials or network calls. The
    machine ceiling runs next: a capability quarantined on this machine is
    refused before any project or policy row is resolved.

    Under the read-only switch a bundled service is neither set up nor started
    nor handed a new declaration.

    A service that declares `machine` takes `--machine` on its service verbs;
    such a call resolves no project and reads no policy row, because the
    machine service checks each opted-in project's own policy before every
    action it takes for that project. `join` is a project act and always takes
    the ordinary path.

    `migrate` of a capability that declares `TABLES` acts on the machine's
    store rather than for a project, so it too reads no policy row: it answers
    to the machine ceiling, and `migrate` (not `migrate status`) to the
    read-only switch.
    """
    _auth_gate()
    verb = sys.argv[1] if len(sys.argv) > 1 else "help"
    safe = verb in {"help", "stub", "manifest", "connections"}
    if not safe:
        _machine_gate()
    service_action = sys.argv[2] if len(sys.argv) > 2 else None
    if verb == "migrate" and _tables_declared():
        if service_action != "status":
            _read_only_gate(f"`{NAME} migrate`")
        return
    service_contract = globals().get("SERVICE")
    service_call = isinstance(service_contract, dict) and verb == "service"
    machine_service = service_call and isinstance(service_contract.get("machine"), dict)
    if service_call and (service_action in {"init", "start", "run", "reload"}
                         or (machine_service and service_action in {"join", "leave"})):
        _read_only_gate(f"`{NAME} service {service_action}`")
    if machine_service and service_action != "join" and "--machine" in sys.argv[3:]:
        return
    if service_call and (service_action in {"init", "start", "run"}
                         or (machine_service and service_action == "join")):
        _require_project_enabled_for_service()
    if safe:
        return
    row = _policy_row()
    entry = row.get("value") if row else None
    scope = row.get("scope") if row else None
    if isinstance(entry, dict) and entry.get("enabled") is True:
        return
    if isinstance(entry, dict) and entry.get("enabled") is False and scope == "project":
        _die(4, "disabled",
             f"{NAME} is disabled in this project ({_records().source})",
             f"ask the user whether to enable {NAME} for this project; if yes, "
             f"run `capabilities enable {NAME} --project`")
    if isinstance(entry, dict) and entry.get("enabled") is False:
        message = f"{NAME} is disabled globally ({_records().source})"
    else:
        message = f"{NAME} is not enabled by project or global policy"
    _die(4, "not_enabled", message,
         f"ask the user whether to enable {NAME} only for this project or "
         f"globally for every project; then run `capabilities enable {NAME} "
         "--project` or `--global` exactly as requested")


def _invoked_verb() -> str | None:
    """The verb this process was invoked with: its first argument once the
    contract's own `--connection <id>` selection is lifted out of the way."""
    argv = sys.argv[1:]
    i = 0
    while i < len(argv):
        if argv[i] == "--connection":
            i += 2
        elif argv[i].startswith("--connection="):
            i += 1
        else:
            return argv[i]
    return None


def _machine_read(verb: str | None = None) -> bool:
    """Whether `verb`, else the invoked one, is a machine read here.

    Outside any project there is no scope a grant could have been written in,
    so a verb the capability declares in `MACHINE_READS` uses the machine's own
    connections instead, read-only. Inside a project the grant model alone
    decides, and a capability that declares nothing has no machine reads."""
    declared = globals().get("MACHINE_READS")
    if not declared or not isinstance(declared, tuple):
        return False
    if _project_root() is not None:
        return False
    return (verb if verb is not None else _invoked_verb()) in declared


def _policy_state() -> dict:
    """This capability's effective policy, in the words `capabilities list`
    uses: `effective` enabled or disabled, the `source` that decided it -
    `machine` (the ceiling), `project`, `global` or `default` - and the
    `machine` ceiling itself. A record that cannot be read is reported as the
    refusal the gate would give, so the report around it still answers."""
    import contextlib
    import io
    errors = io.StringIO()
    try:
        with contextlib.redirect_stderr(errors):
            machine = _machine_state()
            row = None if machine == "quarantined" else _policy_row()
    except SystemExit:
        lines = errors.getvalue().strip().splitlines()
        try:
            return {"error": json.loads(lines[-1])["error"]}
        except (IndexError, ValueError, KeyError, TypeError):
            return {"error": {"code": "policy_unreadable",
                              "message": errors.getvalue().strip()}}
    if machine == "quarantined":
        return {"effective": "disabled", "source": "machine", "machine": machine}
    if row is None:
        return {"effective": "disabled", "source": "default", "machine": machine}
    return {"effective": "enabled" if row["value"]["enabled"] else "disabled",
            "source": row.get("scope"), "machine": machine}


def _env_dir() -> Path | None:
    """The capability's envelope dir in the project's active capabilities/."""
    root = _project_root()
    return (_project_capabilities_dir(root) / NAME) if root is not None else None


_RECORDS = None


def _records():
    """The adapter this project's records are read and written through: the
    project's envelope, then the user's config home; in a project whose
    connections are in store mode, its store for connections and grants, read
    for the project's id. Everything below asks it for a collection, never for
    a path."""
    global _RECORDS
    if _RECORDS is None:
        root = _project_root()
        envelope = (_project_capabilities_dir(root) if root is not None
                    else _CONFIG_HOME / "no-project")
        try:
            project_only = os.environ.get("CAPABILITIES_RECORDS_PROJECT_ONLY", "") \
                .strip().lower() in ("1", "true", "yes", "on")
            in_store = root is not None and connections_mode(envelope) == "store"
            _RECORDS = open_records(
                envelope, _CONFIG_HOME, project_only=project_only,
                project_root=root, project_id=_project_id() if in_store else None,
                application_name=NAME)
        except StoreError as e:
            _die(6, e.slug, e.message, e.hint)
    return _RECORDS


def _project_identity() -> dict:
    root = _project_root()
    if root is None:
        _die(6, "no_project", "no project here to resolve records for")
    identity_file = _project_capabilities_dir(root) / "project.json"
    try:
        identity = json.loads(identity_file.read_text())
    except (OSError, ValueError) as e:
        _die(6, "no_project_identity", f"cannot read {identity_file}: {e}",
             "run `capabilities init` in the project")
    if not identity.get("slug"):
        _die(6, "no_project_identity", f"{identity_file} declares no slug")
    return identity


def _state_dir() -> Path:
    """State follows the scope of the credentials that minted it; project state
    lands inside the envelope only where capabilities/ already exists."""
    if SCOPE == "project":
        root = _project_root()
        if root is not None:
            envelope = _project_capabilities_dir(root)
            if ((envelope / "project.json").is_file()
                    or (envelope / "settings.json").is_file()):
                return envelope / NAME / "state"
    return _STATE_HOME / NAME


# --- Capability contract — the declaration surface --------------------------

def _docs_base() -> str:
    key = f"{NAME.upper()}_DOCS_BASE"
    return (_project_env().get(key)
            or _parse_env_file(CREDENTIALS_ENV).get(key)
            or os.environ.get(key)
            or DOCS_BASE)


def _guide_dir() -> Path:
    executable = Path(__file__).resolve()
    bundle = (executable.parent.parent
              if executable.parent.name == "bin" else executable.parent)
    return bundle / "guides"


def _guide_menu() -> list[dict[str, str]]:
    menu = []
    guide_dir = _guide_dir()
    files = sorted(guide_dir.glob("*.md")) if guide_dir.is_dir() else []
    for path in files:
        lines = path.read_text().splitlines()
        title = ""
        title_index = -1
        for index, line in enumerate(lines):
            if line.startswith("# "):
                title = line[2:].strip()
                title_index = index
                break
        paragraph = []
        for line in lines[title_index + 1:]:
            stripped = line.strip()
            if not stripped:
                if paragraph:
                    break
                continue
            if stripped.startswith("#"):
                break
            paragraph.append(stripped)
        topic = path.stem
        menu.append({
            "topic": topic,
            "title": title,
            "preview": " ".join(paragraph),
            "command": f"{NAME} guide {topic}",
        })
    return menu


def _cmd_guide(argv: list[str]) -> None:
    menu = _guide_menu()
    if not argv:
        _emit(menu); return
    topic = argv[0]
    topics = {entry["topic"] for entry in menu}
    if topic not in topics:
        _die(3, "not_found", f"no guide topic {topic!r}",
             f"run `{NAME} guide` to list available guides")
    import urllib.error as _ue
    import urllib.request as _ur
    url = _docs_base().rstrip("/") + "/" + topic + ".md"
    cache_dir = _STATE_HOME / NAME / "guides"
    cache, etag_f = cache_dir / f"{topic}.md", cache_dir / f"{topic}.etag"
    headers = {}
    if cache.exists() and etag_f.exists():
        headers["If-None-Match"] = etag_f.read_text().strip()
    try:
        req = _ur.Request(url, headers=headers)
        with _ur.urlopen(req, timeout=10.0) as resp:
            text = resp.read().decode(resp.headers.get_content_charset() or "utf-8")
            cache_dir.mkdir(parents=True, exist_ok=True)
            cache.write_text(text)
            if resp.headers.get("etag"):
                etag_f.write_text(resp.headers["etag"])
            _emit(text); return
    except _ue.HTTPError as e:
        if e.code == 304 and cache.exists():
            _emit(cache.read_text()); return
        if e.code == 404:
            _die(3, "not_found", f"guide {topic!r} missing upstream", url)
        err = f"upstream returned {e.code}"
    except _ue.URLError as e:
        err = str(e.reason)
    except OSError as e:
        err = str(e)
    if cache.exists():
        sys.stderr.write(json.dumps(
            {"warning": f"upstream unreachable; serving cached copy ({err})"},
            ensure_ascii=False) + "\n")
        _emit(cache.read_text()); return
    _die(5, "network_error", f"could not fetch guide {topic!r}; no cache exists", url)


def _render_ids_markdown(data: dict) -> str:
    """Render the {label: {value, note}} envelope as the labelled markdown
    list the manager's `capabilities ids <NAME>` also produces — one shared
    format across the ids surface and the identifiers section of `help`."""
    lines: list[str] = []
    for label, entry in sorted(data.items()):
        entry = entry if isinstance(entry, dict) else {"value": entry}
        v = entry.get("value")
        vs = f"`{v}`" if isinstance(v, str) else "`" + json.dumps(v, ensure_ascii=False) + "`"
        line = f"- **{label}**: {vs}"
        note = entry.get("note")
        if note:
            line += f" — {note}"
        lines.append(line)
    return "\n".join(lines)


def _identifiers_load() -> dict:
    """The identifiers envelope, resolved through the records adapter, in one
    shape — `{label: {value, note}}` — for the help section, the report and
    `ids get`."""
    try:
        resolved = _records().resolve(NAME, "identifier")
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)
    return {label: {"note": row["note"] or "", "value": row["value"]}
            for label, row in sorted(resolved.items())}


def _identifiers_write(label: str, value, note: str) -> None:
    """Rule 15: a capability is the sole writer of its own identifiers,
    addressed by (capability, collection) rather than by path."""
    kept = note or (_identifiers_load().get(label) or {}).get("note", "")
    try:
        _records().set(NAME, "identifier", label, value,
                       actor=f"{NAME} ids set", note=kept or None)
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)


def _identifiers_remove(label: str) -> None:
    try:
        _records().delete(NAME, "identifier", label)
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)


def _identifiers_section() -> str:
    """The Identifiers block appended to the bare top-level help — deterministic
    first-touch surfacing of `capabilities/<NAME>/identifiers.json` so an
    agent following the `<NAME> help` startup protocol loads the discovered
    labels/values/notes into context at once. Empty when no project envelope
    or nothing recorded (do not bloat help with an empty section)."""
    data = _identifiers_load()
    if not data:
        return ""
    header = (
        "\n═══ Identifiers ═════════════════════════════════════════════════════════════\n\n"
        f"Structural lookups discovered for `{NAME}` in this project. Fetch a single\n"
        f"raw value with `{NAME} ids get <label>`; the full envelope is also at\n"
        f"`capabilities ids {NAME}`.\n\n"
    )
    return header + _render_ids_markdown(data) + "\n"


def _cmd_help() -> None:
    """Bare top-level help: the CLI's HELP body (module-level `HELP` if
    defined, else the module docstring), then the project's Identifiers
    section. Only fires when no extra args follow — per-verb help stays
    untouched so `<NAME> help <subcommand>` is not intercepted."""
    g = globals()
    text = g.get("HELP") or g.get("__doc__") or ""
    if text.startswith("\n"):
        text = text.lstrip("\n")
    sys.stdout.write(text)
    if text and not text.endswith("\n"):
        sys.stdout.write("\n")
    section = _identifiers_section()
    if section:
        sys.stdout.write(section)


def _cmd_ids(argv: list[str]) -> None:
    sub = argv[0] if argv else "list"
    data = _identifiers_load()
    if sub == "list":
        _emit(data); return
    if sub == "get":
        if len(argv) < 2 or argv[1] not in data:
            _die(3, "not_found", "unknown identifier label",
                 f"`{NAME} ids list` shows the labels")
        _emit((data[argv[1]] or {}).get("value")); return
    if sub in ("set", "rm"):
        _read_only_gate(f"`{NAME} ids {sub}`")
    if sub == "set":
        if len(argv) < 3:
            _die(6, "input", f"usage: {NAME} ids set <label> <value> [--note <text>]")
        label, raw = argv[1], argv[2]
        try:
            value = json.loads(raw)
        except ValueError:
            value = raw
        note = ""
        if "--note" in argv:
            ni = argv.index("--note")
            if ni + 1 >= len(argv):
                _die(6, "input", "--note needs a value")
            note = argv[ni + 1]
        _identifiers_write(label, value, note)
        _emit({"set": label}); return
    if sub == "rm":
        if len(argv) < 2 or argv[1] not in data:
            _die(3, "not_found", "unknown identifier label",
                 f"`{NAME} ids list` shows the labels")
        _identifiers_remove(argv[1])
        _emit({"removed": argv[1]}); return
    _die(6, "input", f"unknown ids subcommand {sub!r}", f"{NAME} ids list|get|set|rm")


REFERENCE_PREFIX = "reference."


def _front_matter(body: str) -> tuple[str | None, str | None]:
    """`name` and `description` out of a reference's leading front matter."""
    lines = body.splitlines()
    if not lines or lines[0].strip() != "---":
        return None, None
    name = desc = None
    for line in lines[1:30]:
        if line.strip() == "---":
            break
        if line.startswith("name:"):
            name = line.split(":", 1)[1].strip()
        elif line.startswith("description:"):
            desc = line.split(":", 1)[1].strip()
    return name, desc


def _reference_bodies() -> dict[str, str]:
    """Every reference this project can see, keyed by its document key."""
    out: dict[str, str] = {}
    try:
        adapter = _records()
        for key in adapter.document_keys(NAME):
            if not key.startswith(REFERENCE_PREFIX):
                continue
            doc = adapter.document_read(NAME, key)
            if doc:
                out[key] = doc["body"]
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)
    return out


def _cmd_refs(argv: list[str] | None = None) -> None:
    """`refs` lists what this project can load; `refs show <name>` prints one.

    The listing carries each reference's path; `refs show` prints a body."""
    argv = argv or []
    bodies = _reference_bodies()
    adapter = _records()
    entries = []
    for key, body in sorted(bodies.items()):
        name, desc = _front_matter(body)
        if not name:
            continue
        entry = {"name": name, "description": desc or "", "key": key}
        # A path when there is one to open, a source when there is not. The
        # adapter answers that; the listing does not ask where it lives.
        path = adapter.document_path(NAME, key)
        if path is None:
            entry["source"] = adapter.source
        else:
            entry["path"] = str(path)
        entries.append((name, entry, body))

    if argv and argv[0] == "show":
        if len(argv) < 2:
            _die(6, "input", f"usage: {NAME} refs show <name>")
        wanted = argv[1]
        for name, entry, body in entries:
            if wanted in (name, entry["key"], entry["key"][len(REFERENCE_PREFIX):]):
                sys.stdout.write(body if body.endswith("\n") else body + "\n")
                return
        _die(3, "not_found", f"no reference named {wanted!r}",
             f"`{NAME} refs` lists them")
    if argv:
        _die(6, "input", f"unknown refs subcommand {argv[0]!r}", f"{NAME} refs [show <name>]")
    _emit([entry for _name, entry, _body in entries])


def _context_edit_files(key: str) -> tuple[Path, Path]:
    token = hashlib.sha256(f"{NAME}\0{key}".encode()).hexdigest()[:16]
    root = _state_dir() / "record-edits"
    return root / f"{token}.md", root / f"{token}.json"


def _cmd_context(argv: list[str]) -> None:
    """Read or edit project long text without exposing its backend."""
    sub = argv[0] if argv else "list"
    adapter = _records()
    if sub == "list":
        _emit({"documents": adapter.document_keys(NAME),
               "records": {"mode": adapter.mode, "source": adapter.source}})
        return
    if len(argv) < 2:
        _die(6, "input", f"usage: {NAME} context show|edit|put <key>")
    key = argv[1]
    if sub in ("edit", "put"):
        _read_only_gate(f"`{NAME} context {sub}`")
    if sub == "show":
        doc = adapter.document_read(NAME, key)
        if doc is None:
            _die(3, "not_found", f"no context document {key!r}",
                 f"`{NAME} context list` shows the keys")
        sys.stdout.write(doc["body"] if doc["body"].endswith("\n")
                         else doc["body"] + "\n")
        return
    work, meta = _context_edit_files(key)
    if sub == "edit":
        doc = adapter.document_read(NAME, key)
        direct = adapter.document_path(NAME, key)
        base = doc["hash"] if doc else None
        path = direct or work
        if direct is None:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(doc["body"] if doc else "")
        meta.parent.mkdir(parents=True, exist_ok=True)
        meta.write_text(json.dumps({"key": key, "path": str(path),
                                    "base": base, "direct": direct is not None},
                                   ensure_ascii=False, indent=2) + "\n")
        _emit({"key": key, "path": str(path), "base": base,
               "records": {"mode": adapter.mode, "source": adapter.source},
               "next": f"edit the path, then run `{NAME} context put {key}`"})
        return
    if sub == "put":
        try:
            checkout = json.loads(meta.read_text())
        except (OSError, ValueError) as exc:
            _die(6, "edit_not_started",
                 f"no valid edit checkout for {key!r}: {exc}",
                 f"run `{NAME} context edit {key}` first")
        if checkout.get("key") != key:
            _die(6, "edit_mismatch", f"edit checkout does not belong to {key!r}")
        path = Path(str(checkout.get("path") or ""))
        try:
            body = path.read_text()
            version = adapter.document_put(
                NAME, key, body, author=f"{NAME} context put",
                media_type="text/markdown", base=checkout.get("base"))
        except OSError as exc:
            _die(6, "edit_unreadable", f"cannot read edit path {path}: {exc}")
        except StoreError as exc:
            _die(6, exc.slug, exc.message, exc.hint)
        meta.unlink(missing_ok=True)
        if not checkout.get("direct"):
            path.unlink(missing_ok=True)
        _emit({"put": key, "version": version,
               "records": {"mode": adapter.mode, "source": adapter.source}})
        return
    _die(6, "input", f"unknown context subcommand {sub!r}",
         f"{NAME} context list|show|edit|put")


INVENTORY_NETWORK_MODES = ("none", "optional", "required")


def _inventory_declaration() -> dict | None:
    """The manifest's `inventory` block, derived from the INVENTORY constant.

    `None` says the capability has nothing of its own to report here, so a
    reader assembling a whole project knows before it asks; the verb still
    answers, with the empty envelope, so nothing branches on absence."""
    if not INVENTORY:
        return None
    network = INVENTORY.get("network", "none")
    return {"network": network if network in INVENTORY_NETWORK_MODES else "none"}


def _cmd_inventory(argv: list[str]) -> None:
    """What this capability holds in this project, in one shape for all of them.

    The read is local, secret-free, and leaves nothing changed behind it.
    `--network` is the caller's explicit consent to reach the remote system for
    detail a local read cannot supply; without it that detail is named in
    `deferred` rather than fetched, so assembling a whole project never waits
    on a network the caller did not choose. `--json` is accepted for
    explicitness; the output is always this JSON."""
    network = False
    for arg in argv:
        if arg == "--network":
            network = True
        elif arg != "--json":
            _die(6, "input", f"unknown inventory option {arg!r}",
                 f"{NAME} inventory [--network]")
    root = _project_root()
    report: dict = {"capability": NAME,
                    "project": str(root) if root is not None else None,
                    "network": network,
                    "metrics": [], "items": [], "service": None, "deferred": []}
    if INVENTORY:
        built = _inventory(network) or {}
        for field in ("metrics", "items", "deferred"):
            report[field] = list(built.get(field) or [])
        report["service"] = built.get("service")
    _emit(report)


# A store setting that cannot be used is a configuration fault; a store that
# cannot be reached, is busy, or refuses the migration is the environment's.
_STORE_SETTING_SLUGS = frozenset({
    "store_not_configured", "store_not_postgres", "store_setting_unreadable",
    "store_setting_too_new", "bad_store_setting", "sslmode_too_weak",
    "bad_schema_name", "driver_missing"})


def _tables_declared() -> bool:
    """Whether the capability keeps tables in the machine's store (`TABLES`)."""
    return bool(globals().get("TABLES"))


def _cmd_migrate(argv: list[str]) -> None:
    """`migrate` applies the capability's pending steps to its tables in the
    machine's store, through the shared database library and under its lock;
    `migrate status` reports where they stand, without a lock, changing nothing.
    The manager runs `migrate` when it installs or updates the payload, and a
    service runs it when it starts."""
    if argv not in ([], ["status"]):
        _die(6, "input", f"unknown migrate arguments {' '.join(argv)!r}",
             f"{NAME} migrate [status]")
    steps, major, minor = _tables()
    try:
        from capabilities_contract import db
    except ImportError:
        _die(6, "driver_missing",
             "the shared database library capabilities-contract is not installed",
             f"run {NAME} through its own script header, which pins it")
    conn = None
    try:
        conn = db.connect(application_name=NAME)
        if argv:
            found = db.status(conn, NAME, steps, major=major, minor=minor)
            stored = (None if found.stored_major is None
                      else {"major": found.stored_major, "minor": found.stored_minor})
            report = {"owner": found.owner, "schema": found.schema, "state": found.state,
                      "code": {"major": found.major, "minor": found.minor},
                      "store": stored, "applied": found.applied,
                      "pending": found.pending, "changed": found.changed,
                      "warnings": found.warnings}
        else:
            done = db.migrate(conn, NAME, steps, major=major, minor=minor)
            report = {"owner": done.owner, "schema": done.schema,
                      "applied": done.applied, "skipped": done.skipped,
                      "version": {"major": done.major, "minor": done.minor},
                      "warnings": done.warnings}
    except db.DbError as exc:
        _die(6 if exc.slug in _STORE_SETTING_SLUGS else 5, exc.slug, exc.message, exc.hint)
    finally:
        if conn is not None:
            conn.close()
    _emit(report)


MACHINE_READ_EFFECT = ("outside any project these verbs use the machine's own "
                       "connections, read-only; inside a project its grants "
                       "alone decide")


def _cmd_connections_reported() -> None:
    """The capability's own connections report, with what the contract knows
    beside it. The report stays the capability's: it is taken whole, and the
    capability's effective policy state is added to it. Under the read-only
    switch every connection in it is marked read-only and the switch is named
    beside it, so a reader sees why no connection may write; in a machine read
    each connection the machine lent is named as the machine's, read-only."""
    import contextlib
    import io
    captured = io.StringIO()
    try:
        with contextlib.redirect_stdout(captured):
            _cmd_connections()
    except SystemExit:
        sys.stdout.write(captured.getvalue())
        raise
    try:
        report = json.loads(captured.getvalue())
    except ValueError:
        report = None
    if not isinstance(report, dict):
        sys.stdout.write(captured.getvalue())
        return
    conns = report.get("connections")
    conns = conns if isinstance(conns, dict) else {}
    if read_only_switch():
        for entry in conns.values():
            if isinstance(entry, dict):
                entry["allow_write"] = False
        report["read_only_switch"] = {
            "variable": READ_ONLY_ENV, "on": True,
            "effect": READ_ONLY_EFFECT}
    lent = globals().get("_MACHINE_LENT") or {}
    if lent:
        for cid in lent:
            if isinstance(conns.get(cid), dict):
                conns[cid]["allow_write"] = False
        report["machine_reads"] = {
            "verbs": list(MACHINE_READS),
            "connections": {cid: {"scope": "machine", "source": source}
                            for cid, source in sorted(lent.items())},
            "effect": MACHINE_READ_EFFECT}
    report["policy"] = _policy_state()
    _emit(report)


def _contract(argv: list[str]) -> None:
    """Dispatch the contract verbs; domain verbs fall through to the CLI's own
    parser. Runs after _gate(), before any credential is resolved.

    `help` is a contract verb only when bare (no extra args) — the top-level
    dump plus the Identifiers section. `<NAME> help <subcommand>` falls
    through to the CLI so per-verb help stays clean."""
    cmd = argv[0] if argv else ""
    if cmd == "stub":
        _emit(f"{SUMMARY} Run `{NAME} help`.")
    elif cmd == "manifest":
        _emit({"name": NAME, "summary": SUMMARY,
               "credentials": {"scope": SCOPE, "keys": CRED_KEYS},
               "docs": {"base": DOCS_BASE,
                        "topics": [entry["topic"] for entry in _guide_menu()]},
               "state": STATE, "inventory": _inventory_declaration(),
               "post_install": POST_INSTALL, "tables": _tables_declared()})
    elif cmd == "migrate" and _tables_declared():
        _cmd_migrate(argv[1:])
    elif cmd == "guide":
        _cmd_guide(argv[1:])
    elif cmd == "ids":
        _cmd_ids(argv[1:])
    elif cmd == "refs":
        _cmd_refs(argv[1:])
    elif cmd == "context":
        _cmd_context(argv[1:])
    elif cmd == "connections":
        _cmd_connections_reported()
    elif cmd == "inventory":
        _cmd_inventory(argv[1:])
    elif cmd == "help" and len(argv) == 1:
        _cmd_help()
    else:
        return
    sys.exit(0)

# <<< contract: capability core <<<

# >>> contract: store (generated — edit contract/store.py, run `capabilities sync-contract`) >>>
# A region carries what it needs. Relying on the host file to have imported
# the right names is a coupling nothing checks and nothing reports: it works in
# whichever capability happened to import them and fails at import time in the
# rest. Re-importing a name the host already has costs nothing.
import json
import os
import hashlib
import re
import socket
# The capability core region reads the clock through `time` and imports nothing
# of its own, so this region keeps carrying it.
import time
from collections.abc import Sequence
from pathlib import Path
from typing import Any


# Two scopes and no more: a record either belongs to one project (the
# project's envelope) or to every project (the user's config home).
SCOPE_KINDS = ("global", "project")

FIRST = "first"
MERGE = "merge"
EXACT = "exact"

# The collection registry: how each resolves, and who is allowed to write it.
# Adding a collection here is the only place a new record class is declared.
#
# `connection` and `grant` are the same fact split along the seam that matters:
# an entry's identity — where the thing is and how to reach it — is a fact about
# the world, the same in every project forever. What a project may DO with that
# identity is a decision, different per project by definition. Glued together,
# the second cannot be overridden without restating the first; apart, a project
# that needs write access writes one grant and repeats no address, no host,
# no secret.
#
# An identity is atomic: it merges by entry, never by field, so no connection is
# ever assembled from two scopes. That is what rule 18's "never merged" was
# protecting, and it survives; what it gives up is refusing to let a project add
# to the global set at all.
COLLECTIONS: dict[str, dict[str, str]] = {
    "connection": {"resolve": MERGE, "writer": "human"},
    "grant": {"resolve": MERGE, "writer": "human"},
    "identifier": {"resolve": MERGE, "writer": "capability"},
    "setting": {"resolve": MERGE, "writer": "human"},
    "policy": {"resolve": MERGE, "writer": "manager"},
    "document": {"resolve": MERGE, "writer": "human"},
}

# Grant fields and what they mean when nothing declares them. `allow_write`
# falls back to the capability's own WRITE_DEFAULT rather than to a value here,
# because "does a write leave the system" is the capability's fact.
GRANT_FIELDS = ("enabled", "allow_write")

# A document version is named by the first twelve hex characters of its sha256.
# Forty-eight bits is far more than a project's worth of prose needs, and a name
# a person can read at a glance is worth more than headroom nobody will reach.
HASH_LENGTH = 12

# A key is a label a human chose, and for a mailbox that label is naturally an
# email address — so `@` and `+` belong here. What stays out is whitespace,
# separators and anything that would make a key ambiguous to address.
KEY_RE = re.compile(r"[a-z0-9][a-z0-9._@+-]{0,127}", re.IGNORECASE)
CAPABILITY_RE = re.compile(r"[a-z][a-z0-9-]{0,63}")


class StoreError(Exception):
    """Every failure this tier reports. Carries a slug the caller maps to an
    exit code, so the CLI's error envelope stays the capability's own."""

    def __init__(self, slug: str, message: str, hint: str | None = None):
        super().__init__(message)
        self.slug = slug
        self.message = message
        self.hint = hint


# The process-wide read-only switch. A caller hands a whole process tree to
# something that may read through the capabilities but change nothing through
# them by setting this one variable, which every descendant inherits. It is
# decided here and nowhere else, because this tier is the one every capability
# carries and the one the manager and the bundled services import. It only ever
# closes: nothing it says makes a connection writable, and unset, `0` or
# `false` leave every record and every gate exactly as declared.
READ_ONLY_ENV = "CAPABILITIES_READ_ONLY"
READ_ONLY_EFFECT = ("every connection resolves read-only whatever its grant or "
                    "WRITE_DEFAULT; write verbs, project-record writes and "
                    "service activation exit 4")


def read_only_switch() -> bool:
    """True when this process runs under the read-only switch: the variable
    holds `1` or `true`, in any case."""
    return os.environ.get(READ_ONLY_ENV, "").strip().lower() in ("1", "true")


# The name a machine declares for itself as a node. A container's host name is
# its container id and changes on every redeploy, so a node that declares one
# keeps the same name in the store across them.
NODE_NAME_ENV = "AGENT_NODE_NAME"


def node_name() -> str:
    """The node this process runs on, by the one name the package gives it: a
    store-mode grant naming a node is matched against it, and a service that
    records which node holds its work records it. It is the name the machine
    declares in AGENT_NODE_NAME, and the host name where it declares none."""
    return os.environ.get(NODE_NAME_ENV, "").strip() or socket.gethostname()


# Where a project keeps its connections and grants: files (the default) or the
# store. The manager alone writes this key into `project.json`, when it imports
# a project's files into the store; nothing infers it from a configured store.
CONNECTIONS_MODE_KEY = "connections"
CONNECTIONS_MODES = ("files", "store")

# The contract's own tables in the store, migrated under the contract's own
# ledger owner, and the schema version this code writes them at.
STORE_OWNER = "capabilities"
STORE_CONNECTIONS_TABLE = "capabilities_connections"
STORE_GRANTS_TABLE = "capabilities_connection_grants"
STORE_TABLES_VERSION = (1, 0)

# A store that cannot be reached or is busy is the environment's fault, not
# the configuration's: a capability maps these to its network exit code.
STORE_ENVIRONMENT_SLUGS = frozenset({"store_unreachable", "store_busy"})

# How long one process reuses what it read from the store, and a refusal to
# connect: long enough that one command asks once, short enough that a
# long-running service sees a changed grant, or a store that came back, at once.
STORE_READ_SECONDS = 2.0


def connection_table_steps() -> list[tuple[str, str]]:
    """The migration steps of the two connection tables. `enabled` and
    `allow_write` left null decide nothing, as a field absent from a file's
    grant does; `node` null is the grant for every node."""
    return [
        ("0001-connections",
         "CREATE TABLE capabilities_connections ("
         " capability text NOT NULL,"
         " name text NOT NULL,"
         " spec jsonb NOT NULL,"
         " PRIMARY KEY (capability, name),"
         " CHECK (jsonb_typeof(spec) = 'object'))"),
        ("0002-connection-grants",
         "CREATE TABLE capabilities_connection_grants ("
         " agent_id text NOT NULL,"
         " capability text NOT NULL,"
         " connection text NOT NULL,"
         " node text CHECK (node <> ''),"
         " enabled boolean,"
         " allow_write boolean,"
         " is_default boolean NOT NULL DEFAULT false,"
         " FOREIGN KEY (capability, connection)"
         "  REFERENCES capabilities_connections (capability, name)"
         "  ON DELETE CASCADE ON UPDATE CASCADE)"),
        ("0003-connection-grants-key",
         "CREATE UNIQUE INDEX capabilities_connection_grants_key"
         " ON capabilities_connection_grants"
         " (agent_id, capability, connection, (coalesce(node, '')))"),
        ("0004-connection-grants-default",
         "CREATE UNIQUE INDEX capabilities_connection_grants_default"
         " ON capabilities_connection_grants"
         " (agent_id, capability, (coalesce(node, ''))) WHERE is_default"),
    ]


def _refuse_record_write(capability: str, collection: str) -> None:
    """A project record is the human's or the manager's, so under the switch
    nothing writes one. Operational state (a capability's state directory and
    its tables in the database) is not a record and keeps working."""
    if read_only_switch():
        raise StoreError(
            "read_only_switch",
            f"writing {capability} {collection} records is refused: "
            f"{READ_ONLY_ENV} is set, so this process changes no project record",
            "Do not lift the switch yourself — ask the user; the change has to "
            f"run in a process without {READ_ONLY_ENV}.")


def _store_check(name: str, value: str, pattern: re.Pattern) -> str:
    if not isinstance(value, str) or not pattern.fullmatch(value):
        raise StoreError("bad_name", f"{name} {value!r} must match {pattern.pattern}")
    return value


def _semantics(collection: str) -> str:
    spec = COLLECTIONS.get(collection)
    if not spec:
        raise StoreError("bad_collection", f"unknown collection {collection!r}",
                         f"known: {', '.join(sorted(COLLECTIONS))}")
    return spec["resolve"]


def _grant_decisions(cid: str, rows: Sequence[dict[str, Any]]) -> tuple[dict, dict]:
    """One grant assembled field by field, highest scope first.

    This is the line COLLECTIONS already draws between the two records. An
    identity is a fact about the world, so it is atomic: taken whole from
    one scope, never assembled out of two. A grant is a decision, and a
    decision a lower scope made about one field stands until some higher
    scope decides that same field — so a machine-wide `allow_write: false`
    survives a project that only says `enabled: true`, and write permission
    is never acquired by saying something else.

    Returns the decided fields and, per field, the scope that decided it."""
    decided: dict[str, Any] = {}
    decided_at: dict[str, str] = {}
    for row in rows:
        value = row["value"]
        if not isinstance(value, dict):
            raise StoreError("bad_grant",
                             f"grant {cid!r} must be a table, got {type(value).__name__}")
        unknown = set(value) - set(GRANT_FIELDS)
        if unknown:
            raise StoreError("bad_grant",
                             f"grant {cid!r} has unknown field(s): {', '.join(sorted(unknown))}",
                             f"known: {', '.join(GRANT_FIELDS)}")
        for field, decision in value.items():
            if field not in decided:
                decided[field] = decision
                decided_at[field] = row["scope"]
    return decided, decided_at


# --- records: the files a project keeps its configuration in ------------------
#
# Runtime state is not on this axis: runs, queues and cursors a capability's
# processes share live in its tables in the database. What this answers is
# where CONFIGURATION is read and written. A capability calls the verbs below
# and never a path, so the layout is described in one place.

DOCUMENT_LOCATIONS: tuple[tuple[str | None, str, str], ...] = (
    ("reference", "{cap}/reference", ".md"),
    ("context", "{cap}/service/context", ".md"),
    ("script", "automations/scripts", ".py"),
    (None, "{cap}/service", ".md"),
)


def _document_key(prefix: str | None, stem: str) -> str:
    """The key a file answers to. Underscores fold to hyphens and case is lost,
    so the map from file to key is one-way — which is why finding a document
    searches rather than computes."""
    slug = stem.replace("_", "-").lower()
    return f"{prefix}.{slug}" if prefix else slug


class Records:
    """The surface a capability reads and writes its configuration through."""

    mode = "?"
    source = "?"

    def mode_of(self, collection: str, key: str | None = None) -> str:
        """Where one collection is kept: `files`, or `store` for a project's
        connections, grants and default pointer in store mode."""
        return self.mode

    def __enter__(self) -> "Records":
        return self

    def __exit__(self, *exc: object) -> None:
        self.close()

    def close(self) -> None:
        pass

    def resolve_scope(self, capability: str, collection: str,
                      scope: str) -> dict[str, dict[str, Any]]:
        """Resolve exactly one scope, without inheritance."""
        raise NotImplementedError


class FileRecords(Records):
    """Configuration kept as the files the envelope has always held.

    The layout is not invented here — it is the one the capabilities already
    read, described in one place instead of re-derived at each call site. Two
    directories with that layout make the scope chain: the project's envelope,
    then the user's config home."""

    mode = "files"

    def __init__(self, envelope: Path, global_dir: Path,
                 project_id: str | None = None, project: str | None = None,
                 include_global: bool = True):
        self.envelope, self.global_dir = Path(envelope), Path(global_dir)
        self.project_id, self.project = project_id, project
        self.include_global = bool(include_global)
        self.source = str(self.envelope)

    # -- where a record lives --------------------------------------------------

    def _chain(self) -> list[tuple[str, str | None, Path]]:
        chain = [("project", self.project_id, self.envelope)]
        if self.include_global:
            chain.append(("global", None, self.global_dir))
        return chain

    @staticmethod
    def _load(path: Path) -> Any:
        try:
            return json.loads(path.read_text())
        except FileNotFoundError:
            return None
        except (OSError, ValueError) as exc:
            raise StoreError("bad_config", f"cannot read {path}: {exc}") from None

    @staticmethod
    def _save(path: Path, body: Any, sort: bool = False) -> None:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(body, indent=2, ensure_ascii=False,
                                   sort_keys=sort) + "\n")

    def _policy_file(self, root: Path) -> Path:
        """The gate. A project keeps it at the envelope root; the config home
        keeps it under the manager's own name, which is the same rule seen from
        outside -- there, `capabilities` is a capability like any other."""
        return (root / "settings.json" if root == self.envelope
                else root / "capabilities" / "settings.json")

    def _file(self, root: Path, capability: str, collection: str,
              key: str | None = None) -> Path:
        if collection == "policy":
            return self._policy_file(root)
        if collection == "identifier":
            return root / capability / "identifiers.json"
        if collection in ("connection", "grant"):
            return root / capability / "connections.json"
        if collection == "setting":
            if key == "connection.default":
                return root / capability / "connections.json"
            return root / capability / "service" / "settings.json"
        raise StoreError("bad_collection",
                         f"collection {collection!r} is not kept in files")

    # -- reading ---------------------------------------------------------------

    def _entries(self, root: Path, capability: str, collection: str) -> dict[str, Any]:
        """Every entry of one collection held at one scope, keyed by the name a
        record answers to."""
        if collection == "policy":
            body = self._load(self._policy_file(root)) or {}
            return dict((body.get("capabilities") or {}))
        if collection == "identifier":
            body = self._load(root / capability / "identifiers.json") or {}
            raw = body.get("identifiers") if isinstance(body.get("identifiers"), dict) else body
            out = {}
            for label, entry in raw.items():
                out[label] = entry["value"] if isinstance(entry, dict) and "value" in entry else entry
            return out
        registry = self._load(root / capability / "connections.json") or {}
        if collection in ("connection", "grant"):
            declared = registry.get("connections")
            if not isinstance(declared, dict):
                return {}
            out = {}
            for cid, entry in declared.items():
                if not isinstance(entry, dict):
                    continue
                if collection == "connection":
                    out[cid] = {k: v for k, v in entry.items() if k not in GRANT_FIELDS}
                else:
                    grant = {k: entry[k] for k in GRANT_FIELDS if k in entry}
                    if grant:
                        out[cid] = grant
            return out
        if collection == "setting":
            out = {}
            if registry.get("default"):
                out["connection.default"] = registry["default"]
            service = self._load(root / capability / "service" / "settings.json")
            if isinstance(service, dict):
                out.update(service)
            return out
        raise StoreError("bad_collection", f"unknown collection {collection!r}",
                         f"known: {', '.join(sorted(COLLECTIONS))}")

    def _note(self, root: Path, capability: str, collection: str, key: str) -> str | None:
        if collection != "identifier":
            return None
        body = self._load(root / capability / "identifiers.json") or {}
        raw = body.get("identifiers") if isinstance(body.get("identifiers"), dict) else body
        entry = raw.get(key)
        return entry.get("note") if isinstance(entry, dict) else None

    def config_layers(self, capability: str, collection: str,
                      _scopes: Any = None) -> list[dict[str, dict[str, Any]]]:
        """Each scope's own entries, highest scope first, uncollapsed."""
        _store_check("capability", capability, CAPABILITY_RE)
        _semantics(collection)
        layers: list[dict[str, dict[str, Any]]] = []
        for scope, pid, root in self._chain():
            entries = self._entries(root, capability, collection)
            if not entries:
                continue
            layers.append({
                key: {"id": f"{scope}:{capability}/{collection}/{key}", "scope": scope,
                      "project_id": pid, "capability": capability,
                      "collection": collection, "key": key, "value": value,
                      "note": self._note(root, capability, collection, key),
                      "updated_at": None, "updated_by": None}
                for key, value in entries.items()
            })
        return layers

    def resolve(self, capability: str, collection: str) -> dict[str, dict[str, Any]]:
        semantics = _semantics(collection)
        out: dict[str, dict[str, Any]] = {}
        for rows in self.config_layers(capability, collection):
            if semantics == FIRST:
                return rows
            for key, row in rows.items():
                prior = out.get(key)
                if prior is None:
                    out[key] = row
                elif (collection == "connection" and not prior["value"]
                        and row["value"]):
                    # One file holds both records here, so an entry carrying
                    # only grant fields yields an identity with no fields. That
                    # is a decision about an inherited connection, never a
                    # replacement for it: it must not blank the identity the
                    # lower scope declared. Where nothing is inherited the
                    # fieldless identity stands, which is the only reading a
                    # glued file leaves for it.
                    out[key] = row
        return out

    def _scope_root(self, scope: str) -> tuple[Path, str | None]:
        """The directory one named scope keeps its records in, and the project
        it answers for. Named once so asking a scope for its rows and asking it
        for its file can never land in different trees."""
        if scope == "project":
            return self.envelope, self.project_id
        if scope == "global":
            return self.global_dir, None
        raise StoreError("bad_scope",
                         f"scope {scope!r} must be one of {', '.join(SCOPE_KINDS)}")

    def resolve_scope(self, capability: str, collection: str,
                      scope: str) -> dict[str, dict[str, Any]]:
        _store_check("capability", capability, CAPABILITY_RE)
        root, pid = self._scope_root(scope)
        return {
            key: {"id": f"{scope}:{capability}/{collection}/{key}",
                  "scope": scope, "project_id": pid,
                  "capability": capability, "collection": collection,
                  "key": key, "value": value,
                  "note": self._note(root, capability, collection, key),
                  "updated_at": None, "updated_by": None}
            for key, value in self._entries(root, capability, collection).items()
        }

    def get(self, capability: str, collection: str, key: str) -> Any:
        entry = self.resolve(capability, collection).get(key)
        return entry["value"] if entry else None

    def collection_source(self, capability: str, collection: str) -> str:
        """The file that answered, named exactly. A report that says only
        "files" makes the reader go and find out which one, and the scope a
        record resolved at is half of what they came to learn."""
        for _scope, _pid, root in self._chain():
            if self._entries(root, capability, collection):
                return str(self._file(root, capability, collection))
        return str(self._file(self.envelope, capability, collection))

    def scope_source(self, capability: str, collection: str, scope: str) -> str:
        """The file one named scope keeps this collection in. What a record
        resolved *to* is a question about that record, so the caller that knows
        which scope answered asks here rather than for the collection's own
        file: one file per scope, and the chain is not walked again."""
        _store_check("capability", capability, CAPABILITY_RE)
        root, _pid = self._scope_root(scope)
        return str(self._file(root, capability, collection))

    def connections(self, capability: str, write_default: bool = False,
                    include_disabled: bool = False,
                    machine_read: bool = False) -> dict[str, dict[str, Any]]:
        """Every connection this project may use, already carrying the decision
        made about it — the one read a capability needs before it acts.

        `machine_read` is the caller's word that this is one of the
        capability's declared machine reads outside any project: an identity
        the machine itself declares is then usable, read-only, unless its grant
        resolves to `enabled: false`."""
        identities = self.resolve(capability, "connection")
        layers = self.config_layers(capability, "grant")
        # Under the read-only switch every connection is a source, whatever its
        # grant or the capability's WRITE_DEFAULT says.
        writable = not read_only_switch()
        out: dict[str, dict[str, Any]] = {}
        for cid, entry in identities.items():
            rows = [layer[cid] for layer in layers if cid in layer]
            decided, decided_at = _grant_decisions(cid, rows)
            # Where the identity resolves decides whether it is this project's
            # to use at all. A project that declares an identity locally has
            # already said yes by declaring it; an identity inherited from the
            # global scope is withheld until a grant *resolving at project
            # scope* says `enabled: true`. A global `enabled: true` can never be
            # the blessing — one global line would otherwise hand every project
            # on the machine the same connection back.
            declared = decided.get("enabled")
            identity_is_project = entry["scope"] == "project"
            blessed_here = decided_at.get("enabled") == "project"
            if declared is None:
                enabled = identity_is_project
            else:
                enabled = bool(declared) and (identity_is_project or blessed_here)
            # A machine read lends the machine's own connection and nothing
            # more: never a write, and never one a grant switched off.
            lent = (machine_read and not enabled and entry["scope"] == "global"
                    and (declared is None or bool(declared)))
            if lent:
                enabled = True
            if not enabled and not include_disabled:
                continue
            grant = rows[0] if rows else None
            out[cid] = {
                "id": cid,
                "value": entry["value"],
                "scope": (entry["scope"], entry["project_id"]),
                "enabled": enabled,
                "allow_write": (writable and not lent
                                and bool(decided.get("allow_write", write_default))),
                "grant_scope": (grant["scope"], grant["project_id"]) if grant else None,
            }
            if lent:
                out[cid]["machine_read"] = True
        return out

    # -- writing ---------------------------------------------------------------

    def set(self, capability: str, collection: str, key: str, value: Any,
            actor: str | None = None, note: str | None = None,
            scope: str | None = None) -> None:
        _store_check("capability", capability, CAPABILITY_RE)
        _store_check("key", key, KEY_RE)
        _semantics(collection)
        _refuse_record_write(capability, collection)
        target_scope = scope or "project"
        if target_scope not in SCOPE_KINDS:
            raise StoreError("bad_scope",
                             f"scope {target_scope!r} must be one of {', '.join(SCOPE_KINDS)}")
        root = self.envelope if target_scope == "project" else self.global_dir
        if target_scope == "project" and not self.envelope.is_dir():
            raise StoreError("no_envelope", "no capabilities/ envelope in this project",
                             "run `capabilities init` first")
        path = self._file(root, capability, collection, key)
        body = self._load(path)
        body = body if isinstance(body, dict) else {}
        if collection == "policy":
            body.setdefault("capabilities", {})[key] = value
        elif collection == "identifier":
            # Flat at the top level, which is the shape the envelope has always
            # had and the shape `audit` holds this to. A file already carrying
            # the wrapper keeps it: reshaping someone's file on an unrelated
            # write is not this writer's business.
            holder = (body["identifiers"] if isinstance(body.get("identifiers"), dict)
                      else body)
            holder[key] = {"value": value, "note": note or ""}
        elif collection in ("connection", "grant"):
            entry = body.setdefault("connections", {}).setdefault(key, {})
            if collection == "connection":
                for field in list(entry):
                    if field not in GRANT_FIELDS:
                        entry.pop(field)
                entry.update(value if isinstance(value, dict) else {})
            else:
                entry.update({k: v for k, v in (value or {}).items() if k in GRANT_FIELDS})
        elif key == "connection.default":
            body["default"] = value
        else:
            body[key] = value
        self._save(path, body, sort=collection == "identifier")

    def delete(self, capability: str, collection: str, key: str,
               scope: str | None = None) -> bool:
        _refuse_record_write(capability, collection)
        target_scope = scope or "project"
        if target_scope not in SCOPE_KINDS:
            raise StoreError("bad_scope",
                             f"scope {target_scope!r} must be one of {', '.join(SCOPE_KINDS)}")
        root = self.envelope if target_scope == "project" else self.global_dir
        path = self._file(root, capability, collection, key)
        body = self._load(path)
        if not isinstance(body, dict):
            return False
        if collection == "policy":
            gone = (body.get("capabilities") or {}).pop(key, None) is not None
        elif collection == "identifier":
            holder = body.get("identifiers") if isinstance(body.get("identifiers"), dict) else body
            gone = holder.pop(key, None) is not None
        elif collection in ("connection", "grant"):
            entry = (body.get("connections") or {}).get(key)
            if not isinstance(entry, dict):
                return False
            if collection == "connection":
                gone = body["connections"].pop(key, None) is not None
            else:
                gone = any(entry.pop(field, None) is not None for field in GRANT_FIELDS)
        elif key == "connection.default":
            gone = body.pop("default", None) is not None
        else:
            gone = body.pop(key, None) is not None
        if gone:
            self._save(path, body, sort=collection == "identifier")
        return gone

    # -- documents -------------------------------------------------------------

    def _documents(self, root: Path, capability: str) -> dict[str, Path]:
        """Every long-text file this scope holds, by the key it answers to. The
        map is built by walking rather than by computing a path from a key,
        because the key loses case and underscores on the way in."""
        found: dict[str, Path] = {}
        for prefix, shape, suffix in DOCUMENT_LOCATIONS:
            if prefix == "script" and capability != "automations":
                continue
            folder = root / shape.format(cap=capability)
            if not folder.is_dir():
                continue
            for path in sorted(folder.glob(f"*{suffix}")):
                if path.is_file():
                    found.setdefault(_document_key(prefix, path.stem), path)
        return found

    def document_path(self, capability: str, key: str) -> Path | None:
        """The file this key names. It is the truth here, not a copy of it, so
        an edit to what this returns is the edit — which is why `put` validates
        rather than transports."""
        for _scope, _pid, root in self._chain():
            path = self._documents(root, capability).get(key)
            if path:
                return path
        return None

    def document_read(self, capability: str, key: str) -> dict[str, Any] | None:
        for scope, pid, root in self._chain():
            path = self._documents(root, capability).get(key)
            if not path:
                continue
            body = path.read_text()
            return {"id": str(path), "key": key,
                    "hash": hashlib.sha256(body.encode()).hexdigest()[:HASH_LENGTH],
                    "body": body, "media_type": None, "author": None,
                    "created_at": None, "scope": (scope, pid), "path": str(path)}
        return None

    def document_keys(self, capability: str) -> list[str]:
        keys: set[str] = set()
        for _scope, _pid, root in self._chain():
            keys.update(self._documents(root, capability))
        return sorted(keys)

    def document_put(self, capability: str, key: str, body: str,
                     author: str | None = None, media_type: str | None = None,
                     base: str | None = None) -> str:
        _refuse_record_write(capability, "document")
        path = self._documents(self.envelope, capability).get(key)
        if path is None:
            path = self._new_document_path(capability, key)
        if base is not None and path.is_file():
            current = path.read_text()
            live = hashlib.sha256(current.encode()).hexdigest()[:HASH_LENGTH]
            # In files mode `context edit` deliberately hands out the truth,
            # not a copy. By put-time the live hash is therefore expected to
            # differ from the checkout hash; equality of the submitted body and
            # the file proves the edit landed at the path the adapter named.
            if live != base and current != body:
                raise StoreError(
                    "stale_edit",
                    f"{path} is {live} now, not {base} as it was when the edit began",
                    "re-read it and apply the change again")
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(body)
        return hashlib.sha256(body.encode()).hexdigest()[:HASH_LENGTH]

    def _new_document_path(self, capability: str, key: str) -> Path:
        """Where a document this project does not have yet would go. The prefix
        chooses the folder; what follows it is the file."""
        for prefix, shape, suffix in DOCUMENT_LOCATIONS:
            if prefix and key.startswith(prefix + "."):
                return self.envelope / shape.format(cap=capability) / (key[len(prefix) + 1:] + suffix)
        prefix, shape, suffix = DOCUMENT_LOCATIONS[-1]
        return self.envelope / shape.format(cap=capability) / (key + suffix)

    # -- what a directory cannot answer ---------------------------------------

    def _refuse(self, what: str) -> None:
        raise StoreError("files_mode", f"{what} is not kept: records are files",
                         "their history is the repository's; read it with git")

    def revisions(self, *_a: Any, **_k: Any) -> list:
        self._refuse("a record's history")
        return []

    def document_versions(self, *_a: Any, **_k: Any) -> list:
        self._refuse("a document's earlier versions")
        return []


class StoreRecords(FileRecords):
    """A project in store mode: its connections, its grants and its default
    pointer are read from and written to the contract's two tables in the
    project's store, and every other record stays in the files `FileRecords`
    reads. The two homes never compose: the files' connections and grants are
    not read here at all.

    A connection row belongs to no project, so it resolves as an identity the
    project did not declare itself would: withheld until this project's grant
    enables it. This project's grants are the rows whose `agent_id` is its id,
    the row naming this node read before the row for every node, field by
    field. A row never holds a secret value: `spec` names each secret by its
    `*_env` key, which resolves on each node through that node's own cascade.

    The store is reached through the shared database library, on first use
    only, so a call that reads no connection never connects."""

    def __init__(self, envelope: Path, global_dir: Path,
                 project_id: str | None = None, project: str | None = None,
                 include_global: bool = True, project_root: Path | None = None,
                 application_name: str = STORE_OWNER, connection: Any = None,
                 schema: str | None = None):
        super().__init__(envelope, global_dir, project_id, project, include_global)
        self.project_root = (Path(project_root) if project_root is not None
                             else self.envelope.parent)
        self.application_name = application_name
        self.node = node_name()
        self._conn = connection
        self._owns_conn = connection is None
        self._schema = schema
        self._failure: StoreError | None = None
        self._failed_at = 0.0
        self._cache: dict[tuple[str, str], tuple[float, Any]] = {}

    @staticmethod
    def _held(collection: str, key: str | None = None) -> bool:
        return (collection in ("connection", "grant")
                or (collection == "setting" and key == "connection.default"))

    def mode_of(self, collection: str, key: str | None = None) -> str:
        return "store" if self._held(collection, key) else "files"

    def close(self) -> None:
        if self._owns_conn and self._conn is not None:
            try:
                self._conn.close()
            except Exception:
                pass
            self._conn = None

    # -- reaching the store ----------------------------------------------------

    def _fail(self, error: StoreError) -> StoreError:
        self._failure, self._failed_at = error, time.monotonic()
        return error

    def _unreachable(self, exc: Exception) -> StoreError:
        """A connection that broke is dropped, so the next use opens a new one."""
        if self._owns_conn and self._conn is not None:
            try:
                self._conn.close()
            except Exception:
                pass
            self._conn = None
        return self._fail(StoreError(
            "store_unreachable", f"cannot reach the store: {exc}",
            "check the database setting with `capabilities store doctor`"))

    def _fresh(self, key: tuple[str, str]) -> Any:
        held = self._cache.get(key)
        if held is not None and time.monotonic() - held[0] < STORE_READ_SECONDS:
            return held[1]
        return None

    def _db(self) -> Any:
        """The connection, opened on first use. A refusal to connect stands for
        STORE_READ_SECONDS, so one command does not wait on it twice."""
        if self._failure is not None:
            if time.monotonic() - self._failed_at < STORE_READ_SECONDS:
                raise self._failure
            self._failure = None
        if self._conn is not None:
            return self._conn
        try:
            from capabilities_contract import db
        except ImportError:
            raise self._fail(StoreError(
                "driver_missing",
                "the shared database library capabilities-contract is not installed",
                "run the capability through its own script header, which pins it")) from None
        try:
            setting = db.resolve_setting(self.project_root)
            self._conn = db.connect(application_name=self.application_name,
                                    setting=setting)
        except db.DbError as exc:
            raise self._fail(StoreError(exc.slug, exc.message, exc.hint)) from None
        self._schema = setting.schema
        return self._conn

    def _read(self, query: str, params: Sequence[Any]) -> list[tuple]:
        conn = self._db()
        import psycopg
        try:
            rows = conn.execute(query, params).fetchall()
        except psycopg.errors.UndefinedTable:
            # A store nothing was ever imported into holds no connection.
            if self._owns_conn:
                conn.rollback()
            return []
        except psycopg.OperationalError as exc:
            raise self._unreachable(exc) from None
        except psycopg.Error as exc:
            if self._owns_conn:
                conn.rollback()
            raise StoreError("store_read_failed",
                             f"reading connections from the store failed: {exc}") from None
        if self._owns_conn:
            conn.rollback()
        return rows

    def _write(self, work: Any) -> Any:
        """Run `work(conn)` in one transaction, the tables migrated first. A
        connection handed in belongs to a caller holding its own transaction,
        which this neither migrates nor commits."""
        conn = self._db()
        import psycopg
        from capabilities_contract import db
        try:
            try:
                if not self._owns_conn:
                    return work(conn)
                major, minor = STORE_TABLES_VERSION
                db.migrate(conn, STORE_OWNER, connection_table_steps(),
                           major=major, minor=minor)
                with conn.transaction():
                    return work(conn)
            except db.DbError as exc:
                raise StoreError(exc.slug, exc.message, exc.hint) from None
            except psycopg.OperationalError as exc:
                raise self._unreachable(exc) from None
            except psycopg.Error as exc:
                raise StoreError("store_write_failed",
                                 f"writing connections to the store failed: {exc}") from None
        finally:
            self._cache.clear()

    def _table_source(self, collection: str) -> str:
        self._db()
        table = STORE_GRANTS_TABLE if collection == "grant" else STORE_CONNECTIONS_TABLE
        return f"store:{self._schema}.{table}"

    # -- reading ---------------------------------------------------------------

    def _connection_rows(self, capability: str) -> dict[str, dict[str, Any]]:
        key = ("connection", capability)
        held = self._fresh(key)
        if held is None:
            rows = self._read(
                "SELECT name, spec FROM capabilities_connections "
                "WHERE capability = %s ORDER BY name", (capability,))
            held = {name: spec if isinstance(spec, dict) else {} for name, spec in rows}
            self._cache[key] = (time.monotonic(), held)
        return held

    def _grant_rows(self, capability: str) -> dict[str, list[dict[str, Any]]]:
        """This project's grants on this node, per connection: the row naming
        this node first, then the row for every node."""
        key = ("grant", capability)
        held = self._fresh(key)
        if held is None:
            out: dict[str, list[dict[str, Any]]] = {}
            if self.project_id:
                rows = self._read(
                    "SELECT connection, node, enabled, allow_write, is_default "
                    "FROM capabilities_connection_grants "
                    "WHERE agent_id = %s AND capability = %s "
                    "AND (node IS NULL OR node = %s) "
                    "ORDER BY connection, node NULLS LAST",
                    (self.project_id, capability, self.node))
                for cid, node, enabled, allow_write, is_default in rows:
                    out.setdefault(cid, []).append({
                        "node": node, "enabled": enabled,
                        "allow_write": allow_write, "is_default": bool(is_default)})
            self._cache[key] = (time.monotonic(), out)
            held = out
        return held

    def _store_default(self, capability: str) -> str | None:
        """The default pointer: this node's, else the one for every node."""
        grants = self._grant_rows(capability)
        for node in (self.node, None):
            for cid in sorted(grants):
                if any(r["is_default"] and r["node"] == node for r in grants[cid]):
                    return cid
        return None

    def _record(self, scope: str, capability: str, collection: str, key: str,
                value: Any, ref: str) -> dict[str, Any]:
        return {"id": f"store:{capability}/{collection}/{ref}", "scope": scope,
                "project_id": self.project_id if scope == "project" else None,
                "capability": capability, "collection": collection, "key": key,
                "value": value, "note": None, "updated_at": None, "updated_by": None}

    def _entries(self, root: Path, capability: str, collection: str) -> dict[str, Any]:
        if collection in ("connection", "grant"):
            return {}
        entries = super()._entries(root, capability, collection)
        if collection == "setting":
            entries.pop("connection.default", None)
        return entries

    def config_layers(self, capability: str, collection: str,
                      _scopes: Any = None) -> list[dict[str, dict[str, Any]]]:
        _store_check("capability", capability, CAPABILITY_RE)
        if collection == "connection":
            rows = self._connection_rows(capability)
            return [{name: self._record("store", capability, collection, name, spec, name)
                     for name, spec in rows.items()}] if rows else []
        if collection == "grant":
            layers: list[dict[str, dict[str, Any]]] = []
            for node in (self.node, None):
                layer = {}
                for cid, rows in self._grant_rows(capability).items():
                    for row in rows:
                        if row["node"] == node:
                            value = {f: row[f] for f in GRANT_FIELDS if row[f] is not None}
                            layer[cid] = self._record("project", capability, collection,
                                                      cid, value, f"{cid}@{node or '*'}")
                if layer:
                    layers.append(layer)
            return layers
        layers = super().config_layers(capability, collection)
        if collection == "setting":
            default = self._store_default(capability)
            if default is not None:
                layers.insert(0, {"connection.default": self._record(
                    "project", capability, collection, "connection.default", default,
                    "connection.default")})
        return layers

    def resolve_scope(self, capability: str, collection: str,
                      scope: str) -> dict[str, dict[str, Any]]:
        if collection in ("connection", "grant") and scope in ("project", "store"):
            return self.resolve(capability, collection)
        return super().resolve_scope(capability, collection, scope)

    def get(self, capability: str, collection: str, key: str) -> Any:
        """A grant answers with the row that applies on this node, and says
        which node it names (null for every node) and whether it is the
        default pointer."""
        if collection == "grant":
            _store_check("capability", capability, CAPABILITY_RE)
            rows = self._grant_rows(capability).get(key)
            if not rows:
                return None
            row = rows[0]
            out = {f: row[f] for f in GRANT_FIELDS if row[f] is not None}
            out.update(node=row["node"], is_default=row["is_default"])
            return out
        return super().get(capability, collection, key)

    def collection_source(self, capability: str, collection: str) -> str:
        if collection in ("connection", "grant"):
            return self._table_source(collection)
        return super().collection_source(capability, collection)

    def scope_source(self, capability: str, collection: str, scope: str) -> str:
        if collection in ("connection", "grant"):
            return self._table_source(collection)
        return super().scope_source(capability, collection, scope)

    # -- writing ---------------------------------------------------------------

    def _grant_value(self, cid: str, value: Any) -> tuple[dict[str, Any], str | None]:
        if not isinstance(value, dict):
            raise StoreError("bad_grant",
                             f"grant {cid!r} must be a table, got {type(value).__name__}")
        known = (*GRANT_FIELDS, "node", "is_default")
        unknown = set(value) - set(known)
        if unknown:
            raise StoreError("bad_grant",
                             f"grant {cid!r} has unknown field(s): {', '.join(sorted(unknown))}",
                             f"known: {', '.join(known)}")
        for field in (*GRANT_FIELDS, "is_default"):
            if field in value and not isinstance(value[field], bool) \
                    and not (field in GRANT_FIELDS and value[field] is None):
                raise StoreError("bad_grant", f"grant {cid!r} {field} must be true or false")
        node = value.get("node")
        if node is not None and (not isinstance(node, str) or not node.strip()):
            raise StoreError("bad_grant",
                             f"grant {cid!r} node must name a node, or be null for every node")
        return {f: value[f] for f in (*GRANT_FIELDS, "is_default") if f in value}, node

    def _put_grant(self, conn: Any, capability: str, cid: str,
                   fields: dict[str, Any], node: str | None) -> None:
        if not self.project_id:
            raise StoreError("no_project_id",
                             "this project has no id a grant could name",
                             "run `capabilities init` in the project")
        known = conn.execute(
            "SELECT 1 FROM capabilities_connections WHERE capability = %s AND name = %s",
            (capability, cid)).fetchone()
        if known is None:
            raise StoreError("unknown_connection",
                             f"the store holds no {capability} connection {cid!r}",
                             f"declare it first: `capabilities set {capability} "
                             f"connection {cid} '{{...}}'`")
        if fields.get("is_default"):
            conn.execute(
                "UPDATE capabilities_connection_grants SET is_default = false "
                "WHERE agent_id = %s AND capability = %s AND connection <> %s "
                "AND coalesce(node, '') = coalesce(%s, '') AND is_default",
                (self.project_id, capability, cid, node))
        columns = ["agent_id", "capability", "connection", "node", *fields]
        values = [self.project_id, capability, cid, node, *fields.values()]
        updates = ", ".join(f"{field} = EXCLUDED.{field}" for field in fields)
        conn.execute(
            f"INSERT INTO capabilities_connection_grants ({', '.join(columns)}) "
            f"VALUES ({', '.join(['%s'] * len(values))}) "
            "ON CONFLICT (agent_id, capability, connection, (coalesce(node, ''))) "
            + (f"DO UPDATE SET {updates}" if updates else "DO NOTHING"),
            values)

    def _put_default(self, conn: Any, capability: str, cid: str | None,
                     node: str | None) -> None:
        if not self.project_id:
            raise StoreError("no_project_id",
                             "this project has no id a grant could name",
                             "run `capabilities init` in the project")
        conn.execute(
            "UPDATE capabilities_connection_grants SET is_default = false "
            "WHERE agent_id = %s AND capability = %s "
            "AND coalesce(node, '') = coalesce(%s, '') AND is_default",
            (self.project_id, capability, node))
        if cid is not None:
            self._put_grant(conn, capability, cid, {"is_default": True}, node)

    def set(self, capability: str, collection: str, key: str, value: Any,
            actor: str | None = None, note: str | None = None,
            scope: str | None = None) -> None:
        if not self._held(collection, key) or scope == "global":
            return super().set(capability, collection, key, value,
                               actor=actor, note=note, scope=scope)
        _store_check("capability", capability, CAPABILITY_RE)
        _store_check("key", key, KEY_RE)
        _refuse_record_write(capability, collection)
        if scope not in (None, "project"):
            raise StoreError("bad_scope",
                             f"scope {scope!r} must be one of {', '.join(SCOPE_KINDS)}")
        if collection == "connection":
            if not isinstance(value, dict):
                raise StoreError("bad_connection",
                                 f"connection {key!r} must be a table, got "
                                 f"{type(value).__name__}")
            spec = {k: v for k, v in value.items() if k not in GRANT_FIELDS}
            grant = {k: value[k] for k in GRANT_FIELDS if k in value}

            def work(conn: Any) -> None:
                conn.execute(
                    "INSERT INTO capabilities_connections (capability, name, spec) "
                    "VALUES (%s, %s, %s::jsonb) ON CONFLICT (capability, name) "
                    "DO UPDATE SET spec = EXCLUDED.spec",
                    (capability, key, json.dumps(spec, ensure_ascii=False)))
                if grant:
                    fields, node = self._grant_value(key, grant)
                    self._put_grant(conn, capability, key, fields, node)
            self._write(work)
        elif collection == "grant":
            fields, node = self._grant_value(key, value)
            self._write(lambda conn: self._put_grant(conn, capability, key, fields, node))
        else:
            cid = value if isinstance(value, str) and value else None
            if value not in (None, "") and cid is None:
                raise StoreError("bad_default", "the default pointer names a connection id")
            self._write(lambda conn: self._put_default(conn, capability, cid, None))

    def delete(self, capability: str, collection: str, key: str,
               scope: str | None = None) -> bool:
        if not self._held(collection, key) or scope == "global":
            return super().delete(capability, collection, key, scope=scope)
        _refuse_record_write(capability, collection)
        if collection == "connection":
            def work(conn: Any) -> bool:
                return conn.execute(
                    "DELETE FROM capabilities_connections "
                    "WHERE capability = %s AND name = %s", (capability, key)).rowcount > 0
        elif collection == "grant":
            def work(conn: Any) -> bool:
                return conn.execute(
                    "DELETE FROM capabilities_connection_grants WHERE agent_id = %s "
                    "AND capability = %s AND connection = %s AND node IS NULL",
                    (self.project_id, capability, key)).rowcount > 0
        else:
            def work(conn: Any) -> bool:
                return conn.execute(
                    "UPDATE capabilities_connection_grants SET is_default = false "
                    "WHERE agent_id = %s AND capability = %s AND node IS NULL "
                    "AND is_default", (self.project_id, capability)).rowcount > 0
        return bool(self._write(work))


def _identity_record(envelope: Path) -> dict[str, Any]:
    try:
        identity = json.loads((Path(envelope) / "project.json").read_text())
    except (OSError, ValueError):
        return {}
    return identity if isinstance(identity, dict) else {}


def connections_mode(envelope: Path | str) -> str:
    """Where this project keeps its connections and grants: `files`, unless
    its `project.json` says `store`. Only that record decides it."""
    identity_file = Path(envelope) / "project.json"
    declared = _identity_record(Path(envelope)).get(CONNECTIONS_MODE_KEY, "files")
    if declared not in CONNECTIONS_MODES:
        raise StoreError("bad_connections_mode",
                         f"{identity_file} declares connections {declared!r}",
                         f"one of: {', '.join(CONNECTIONS_MODES)}; the manager writes it")
    return declared


def open_records(envelope: Path | str, global_dir: Path | str,
                 project_only: bool = False, project_root: Path | str | None = None,
                 project_id: str | None = None,
                 application_name: str = STORE_OWNER) -> Records:
    """The adapter this project's configuration is read and written through:
    the project's envelope, then `global_dir` unless `project_only`; in store
    mode a project's connections and grants come from its store instead, for
    the project id given (else project.json's), its database resolved for
    `project_root` (else the envelope's parent).

    A `project.json` that declares a `store` other than `files` is refused
    rather than read as files, since the records it points at are not where it
    says."""
    envelope, global_dir = Path(envelope), Path(global_dir)
    identity_file = envelope / "project.json"
    identity = _identity_record(envelope)
    declared = identity.get("store", "files")
    if declared != "files":
        raise StoreError("bad_store_mode",
                         f"{identity_file} declares store {declared!r}; records are "
                         "kept only in files",
                         'remove "store" from project.json, or set it to "files"')
    if connections_mode(envelope) == "store":
        return StoreRecords(envelope, global_dir, project_id or identity.get("id"),
                            identity.get("slug"), include_global=not project_only,
                            project_root=Path(project_root) if project_root else None,
                            application_name=application_name)
    return FileRecords(envelope, global_dir, identity.get("id"), identity.get("slug"),
                       include_global=not project_only)

# <<< contract: store <<<

# >>> contract: connections (generated — edit contract/preamble.py, run `capabilities sync-contract`) >>>

def _resolve_env_key(key: str) -> tuple[str | None, str | None, Path | None]:
    """Resolve one env key through cascade tiers 2-4: project .env(.local) →
    user credentials.env → process env. Returns (value, tier, source)."""
    root = _project_root()
    if root is not None:
        for fname in (".env.local", ".env"):
            val = _parse_env_file(root / fname).get(key)
            if val:
                return val, "project", root / fname
    val = _parse_env_file(CREDENTIALS_ENV).get(key)
    if val:
        return val, "user", CREDENTIALS_ENV
    val = os.environ.get(key)
    if val:
        return val, "env", None
    return None, None, None


def _mask(value: str) -> str:
    return ("…" + value[-4:]) if len(value) >= 8 else "****"


def _grant_hint(cid: str) -> str:
    """One wording for the one way a project grants an inherited connection.

    Same shape as `_write_gate`'s: the gate is the human's to lift, never the
    agent's, and the hint carries the exact command rather than a description
    of one. Where no project resolves there is no scope to grant in, so the
    hint names the command that makes one and then the grant, in the order they
    have to happen."""
    grant = f"`capabilities set {NAME} grant {cid} '{{\"enabled\": true}}'`"
    if _project_root() is None:
        return ("Do not lift the gate yourself — ask the user; run "
                f"`capabilities init` in the project that should use {NAME}, "
                f"then {grant} there.")
    return ("Do not lift the gate yourself — ask the user; granting is "
            f"{grant} run inside this project.")


# The connections the machine lent this process for a machine read, by id, each
# with the file it was declared in; empty in every other process.
_MACHINE_LENT: dict = {}


def _grant_gate(reg: dict, cid: str) -> None:
    """Refuse a connection this project may not use, for read as for write.

    A connection declared outside the project is not the project's to use until
    the project itself says so, and one the project switched off is off;
    nothing in the cascade lifts either. Outside a project there is no scope in
    which anything could have said so, which is a different situation and says
    so rather than asserting a project that is not there."""
    entry = (reg.get("withheld") or {}).get(cid)
    if entry is None:
        return
    if entry.get("scope") == "project":
        message = f"connection {cid!r} is disabled in this project"
    elif _machine_read():
        message = (f"connection {cid!r} is switched off on this machine by "
                   f"its grant")
    elif _project_root() is None:
        message = (f"connection {cid!r} is declared globally and there is no "
                   f"project here to grant it in")
    else:
        message = (f"connection {cid!r} is declared outside this project and "
                   f"this project has not granted it")
    _die(4, "connection_not_granted", message, _grant_hint(cid))


def _connections_composed() -> dict:
    """The connections envelope shape, composed out of resolved records.

    Deliberately reconstituted rather than returned in some store-shaped form:
    selection, the write gate and the `connections` report all read the envelope
    shape, and they should not learn where the rows came from. What changes here
    is the source, never the shape.

    The permission a project was granted is folded back onto the entry as
    `allow_write`, which is where the rest of the contract looks for it.

    A connection this project may not use is kept apart under `withheld`, not
    dropped: `connections` holds exactly what may be acted on — which is what
    every capability's own report iterates — while selection still has the name
    it needs to explain a refusal instead of pretending the connection was
    never declared.

    `sources` names, per connection, the file its identity was read out of. An
    identity is taken whole from one scope, so each connection has exactly one
    origin, and a project that merely granted an inherited connection is not
    where that connection's values are written. It is kept beside the entries
    rather than folded into them because it describes a record rather than
    configuring one: nothing resolves through it, and its one reader is each
    capability's own report, naming the origin of its `connection`-tier keys."""
    adapter = _records()
    machine = _machine_read()
    _MACHINE_LENT.clear()
    try:
        effective = adapter.connections(NAME, write_default=WRITE_DEFAULT,
                                        include_disabled=True,
                                        machine_read=machine)
        default = adapter.get(NAME, "setting", "connection.default")
        source = adapter.collection_source(NAME, "connection")
    except StoreError as e:
        _die(5 if e.slug in STORE_ENVIRONMENT_SLUGS else 6, e.slug, e.message, e.hint)
    if not effective:
        _die(6, "connections_required",
             f"{NAME} requires an explicit connections registry and "
             f"{source} holds none",
             'expected {"default": "<id>", "connections": {"<id>": { ... }}}')
    usable = {cid: e for cid, e in effective.items() if e["enabled"]}
    withheld = {cid: e for cid, e in effective.items() if not e["enabled"]}
    if not usable:
        named = ", ".join(sorted(withheld))
        if machine:
            refusal = (f"every {NAME} connection this machine declares is "
                       f"switched off by its grant: {named}")
        elif _project_root() is None:
            refusal = (f"there is no project here to use a {NAME} connection in, "
                       f"so every connection declared globally stays "
                       f"withheld: {named}")
        else:
            refusal = (f"no {NAME} connection is usable in this project; every "
                       f"one it can see is withheld: {named}")
        _die(4, "connection_not_granted", refusal, _grant_hint("<id>"))
    sources = {cid: adapter.scope_source(NAME, "connection", entry["scope"][0])
               for cid, entry in usable.items()}
    _MACHINE_LENT.update({cid: sources[cid] for cid, entry in usable.items()
                          if entry.get("machine_read")})
    return {
        "default": default,
        "connections": {cid: {**entry["value"], "allow_write": entry["allow_write"]}
                        for cid, entry in usable.items()},
        "sources": sources,
        "withheld": {cid: {"scope": entry["scope"][0]}
                     for cid, entry in withheld.items()},
    }


def _inventory_connections(machine_read: bool | None = None) -> dict:
    """Every connection this project declares, granted or not.

    An inventory reports where selection refuses, so this is deliberately the
    one connection read that never dies: no registry is zero connections, and
    a connection the project may not act on is still a connection worth
    showing. `granted` carries which is which. `machine_read` asks as one of
    the capability's machine reads would, else as the invoked verb does."""
    machine = _machine_read() if machine_read is None else bool(machine_read)
    try:
        adapter = _records()
        effective = adapter.connections(NAME, write_default=WRITE_DEFAULT,
                                        include_disabled=True,
                                        machine_read=machine) or {}
        default = adapter.get(NAME, "setting", "connection.default")
    except StoreError:
        return {"default": None, "connections": {}}
    return {"default": default,
            "connections": {
                cid: {**entry["value"], "allow_write": entry["allow_write"],
                      "granted": bool(entry["enabled"])}
                for cid, entry in effective.items()}}


def _connections_registry() -> tuple[dict | None, Path | str | None]:
    """The connections envelope and where it came from.

    Composed from the two records a connection is kept as -- who it is, and
    what this project may do with it -- and handed on in the shape the rest of
    the contract already reads, so selection, the write gate and the report
    never learn which source answered.

    The path returned beside it answers for the collection -- where this project
    reads connections from. Where one connection's own values came from is a
    question about that connection, and `reg["sources"][cid]` is what answers
    it."""
    return _connections_composed(), _records().collection_source(NAME, "connection")


def _select_connection(reg: dict | None, wanted: str | None) -> tuple[str, dict | None]:
    """flag → default pointer → sole entry → die 6. A connection's own
    `address` field selects it too (used where a
    connection carries a human-recognizable address; absent fields never match).

    A connection the project was never granted is refused here rather than
    reported missing, so the one enforcement point every capability already
    routes through is also the one that answers "why not"."""
    if reg is None:
        _die(6, "connections_required",
             f"{NAME} requires an explicit connections registry")
    conns = reg["connections"]
    if wanted:
        if wanted in conns:
            return wanted, conns[wanted]
        for cid, entry in conns.items():
            if (entry or {}).get("address", "").lower() == wanted.lower():
                return cid, entry
        _grant_gate(reg, wanted)
        _die(6, "unknown_connection", f"no connection matches {wanted!r}",
             f"known: {', '.join(conns)}")
    default = reg.get("default")
    if default:
        if default not in conns:
            _grant_gate(reg, default)
            _die(6, "bad_default", f"default points to unknown connection {default!r}",
                 f"known: {', '.join(conns)}")
        return default, conns[default]
    if len(conns) == 1:
        cid = next(iter(conns))
        return cid, conns[cid]
    _die(6, "ambiguous_connection",
         f"registry defines {len(conns)} connections and no default; "
         f"pass --connection <id>",
         f"known: {', '.join(conns)}")


def _write_gate(conn_id: str, allow_write: bool, verb: str) -> None:
    """Policy from the committed registry; nothing in the cascade lifts it.
    The read-only switch closes it for every connection and names itself."""
    if verb in WRITE_VERBS:
        _read_only_gate(f"write verb {verb!r} on connection {conn_id!r}")
    if verb in WRITE_VERBS and not allow_write and conn_id in _MACHINE_LENT:
        _die(4, "read_only",
             f"connection {conn_id!r} is the machine's, lent read-only to a "
             f"machine read outside any project",
             "Do not lift the gate yourself — ask the user; a write runs "
             "inside a project that grants this connection.")
    if verb in WRITE_VERBS and not allow_write:
        _die(4, "read_only",
             f"connection {conn_id!r} does not allow writes",
             "Do not lift the gate yourself — ask the user; granting is "
             f"`capabilities set {NAME} grant {conn_id} '{{\"allow_write\": true}}'` "
             "run inside this project.")


def _key_report(key: str, secret: bool, required: bool,
                value: str | None, tier: str | None, source) -> dict:
    return {"key": key, "secret": secret, "required": required,
            "set": bool(value), "tier": tier if value else None,
            "source": str(source) if (value and source) else None,
            "value": (_mask(value) if secret else value) if value else None}


def _missing_required(keys: list) -> list:
    """Required report rows (from _key_report) that did not resolve through the
    cascade — empty ⇒ credentials present. The primitive behind doctor's
    network-free readiness gate, read from the same per-key resolution
    `connections` reports, so the gate and the report can never disagree."""
    return [k["key"] for k in keys if k["required"] and not k["set"]]


def _doctor_gate(report: dict, wanted: str | None) -> None:
    """doctor's network-free readiness gate. Refuse with exit 2 — naming the
    unresolved required keys, before any round-trip — when a connection under
    test cannot resolve its required config through the cascade, so readiness is
    judged by the same resolution `connections` reports, never a parallel check.
    Checks the selected connection, else every connection in the report."""
    conns = report.get("connections") or {}
    targets = [wanted] if (wanted and wanted in conns) else list(conns)
    problems: dict = {}
    for cid in targets:
        miss = _missing_required((conns.get(cid) or {}).get("keys") or [])
        if miss:
            problems[cid] = miss
    if problems:
        detail = "; ".join(f"{c}: {', '.join(ks)}" for c, ks in sorted(problems.items()))
        _die(2, "credentials_missing",
             f"unresolved required config — {detail}",
             f"set each in the project .env/.env.local, the user credentials.env, "
             f"or process env; `{NAME} connections` shows where every value resolves")

# <<< contract: connections <<<


# ── the Matrix client-server API ─────────────────────────────────────────────


class MatrixError(Exception):
    """One refusal or failure from the homeserver, already in this CLI's
    taxonomy: `exit_code` and `code` are what `_die` would print."""

    def __init__(self, exit_code: int, code: str, message: str, hint: str | None = None,
                 status: int | None = None, errcode: str | None = None):
        super().__init__(message)
        self.exit_code, self.code, self.message = exit_code, code, message
        self.hint, self.status, self.errcode = hint, status, errcode


def _matrix_refusal(resp) -> MatrixError:
    """A 4xx in this CLI's taxonomy: the homeserver's own errcode and words."""
    try:
        body = resp.json()
    except ValueError:
        body = {}
    errcode = body.get("errcode") if isinstance(body, dict) else None
    error = (body.get("error") if isinstance(body, dict) else None) or resp.text[:300]
    message = (f"{errcode}: {error}" if errcode and not str(error).startswith(errcode)
               else str(error or resp.status_code))
    status = resp.status_code
    if status == 401 or errcode in ("M_UNKNOWN_TOKEN", "M_MISSING_TOKEN", "M_USER_DEACTIVATED"):
        return MatrixError(2, "unauthorized", message,
                           "the access token is missing, revoked or belongs to another "
                           "homeserver; `agentrooms connections` shows where it resolves from",
                           status, errcode)
    if status == 404 or errcode == "M_NOT_FOUND":
        return MatrixError(3, "not_found", message, None, status, errcode)
    if errcode == "M_USER_IN_USE":
        return MatrixError(6, "user_in_use", message, "register another NAME", status, errcode)
    if status == 403:
        return MatrixError(6, "forbidden", message,
                           "the homeserver refused this agent the action: not a member, "
                           "not invited, or not allowed by the room's rights", status, errcode)
    if status == 413 or errcode == "M_TOO_LARGE":
        return MatrixError(6, "too_large", message, None, status, errcode)
    return MatrixError(6, "invalid_request", message, None, status, errcode)


class Matrix:
    """The client-server API for one identity. Every call is one HTTP request
    under the retry loop: a 429 waits as the homeserver asks; a timeout or a 5xx
    is retried only when repeating the request cannot act twice."""

    def __init__(self, homeserver: str, token: str | None = None, timeout: float = TIMEOUT):
        import httpx
        self.httpx = httpx
        self.homeserver = homeserver.rstrip("/")
        headers = {"Accept": "application/json", "User-Agent": f"{NAME}"}
        if token:
            headers["Authorization"] = f"Bearer {token}"
        self.http = httpx.Client(base_url=self.homeserver, headers=headers,
                                 timeout=httpx.Timeout(timeout, connect=15.0))

    def close(self) -> None:
        self.http.close()

    def __enter__(self) -> "Matrix":
        return self

    def __exit__(self, *exc) -> None:
        self.close()

    def call(self, method: str, path: str, *, params=None, body=None, content: bytes | None = None,
             content_type: str | None = None, idempotent: bool | None = None, raw: bool = False):
        httpx = self.httpx
        if idempotent is None:
            idempotent = method in ("GET", "PUT", "DELETE")
        kwargs: dict = {"params": params}
        if content is not None:
            kwargs["content"] = content
            kwargs["headers"] = {"Content-Type": content_type or "application/octet-stream"}
        elif body is not None:
            kwargs["json"] = body
        unknown = ("do not retry automatically; check the outcome with a read "
                   "(`agentrooms rooms`, `agentrooms read`) before repeating it")
        for attempt in range(1, MAX_RETRIES + 1):
            try:
                resp = self.http.request(method, path, **kwargs)
            except httpx.TimeoutException:
                if not idempotent:
                    raise MatrixError(5, "outcome_unknown",
                                      f"{method} {path} timed out after it was sent; whether "
                                      "the homeserver applied it is unknown", unknown)
                if attempt < MAX_RETRIES:
                    time.sleep(attempt * 1.5)
                    continue
                raise MatrixError(5, "timeout", f"request timed out: {method} {path}",
                                  "the homeserver was unresponsive")
            except httpx.ConnectError as exc:
                raise MatrixError(5, "network_error", f"cannot reach {self.homeserver}: {exc}",
                                  "check the connection's homeserver URL and connectivity")
            except httpx.RequestError as exc:
                if not idempotent:
                    raise MatrixError(5, "outcome_unknown",
                                      f"{method} {path} failed in transit ({exc}); whether the "
                                      "homeserver applied it is unknown", unknown)
                raise MatrixError(5, "network_error", f"network error: {exc}",
                                  "check connectivity to the homeserver")
            if resp.status_code == 429:
                wait = attempt * 1.5
                with contextlib.suppress(ValueError, TypeError, AttributeError):
                    wait = float(resp.json().get("retry_after_ms")) / 1000
                with contextlib.suppress(ValueError, TypeError):
                    wait = float(resp.headers.get("Retry-After", wait))
                if attempt < MAX_RETRIES:
                    time.sleep(min(max(wait, 0.5), 30.0))
                    continue
                raise MatrixError(5, "rate_limited", "rate-limited by the homeserver",
                                  status=429)
            if resp.status_code >= 500:
                if not idempotent:
                    raise MatrixError(5, "outcome_unknown",
                                      f"the homeserver answered {resp.status_code} to {method} "
                                      f"{path}; whether it applied it is unknown", unknown,
                                      status=resp.status_code)
                if attempt < MAX_RETRIES:
                    time.sleep(attempt * 1.5)
                    continue
                raise MatrixError(5, "server_error",
                                  f"the homeserver returned {resp.status_code}",
                                  resp.text[:300], status=resp.status_code)
            if resp.status_code >= 400:
                raise _matrix_refusal(resp)
            if raw:
                return resp
            if not resp.content:
                return {}
            try:
                return resp.json()
            except ValueError:
                return {}
        raise MatrixError(5, "exhausted_retries", f"exhausted {MAX_RETRIES} attempts on "
                          f"{method} {path}")


def _q(value: str) -> str:
    return quote(value, safe="")


def _fail(exc: MatrixError) -> NoReturn:
    _die(exc.exit_code, exc.code, exc.message, exc.hint, exc.status)


def _server_of(user_id: str) -> str:
    return user_id.split(":", 1)[1] if ":" in user_id else ""


USER_RE = re.compile(r"@[a-z0-9._=\-/+]+:[A-Za-z0-9.\-]+(?::[0-9]+)?")
LOCALPART_RE = re.compile(r"[a-z0-9][a-z0-9._=-]{0,63}")


# ── connections ──────────────────────────────────────────────────────────────

CONNECTION_FIELDS = ("homeserver", "user_id")


def _connections_report() -> dict:
    """Where every value of every connection resolves from, secrets masked.
    Local only: no network, no token use."""
    reg, _ = _connections_registry()
    report: dict = {"default": None, "connections": {}}
    conns = reg["connections"]
    report["default"] = reg.get("default") or (next(iter(conns)) if len(conns) == 1 else None)
    for cid, entry in conns.items():
        entry = entry if isinstance(entry, dict) else {}
        origin = reg["sources"][cid]
        keys = []
        for field in CONNECTION_FIELDS:
            value = entry.get(field)
            keys.append(_key_report(field, False, True,
                                    str(value) if value else None, "connection", origin))
        secret_env = entry.get("secret_env")
        if secret_env:
            value, tier, source = _resolve_env_key(secret_env)
            keys.append(_key_report(secret_env, True, True, value, tier, source))
        else:
            keys.append(_key_report("secret_env", False, True, None, None, None))
        report["connections"][cid] = {
            "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT)), "keys": keys}
    return report


def _cmd_connections() -> None:
    _emit(_connections_report())


def _build_cfg(cid: str, entry: dict | None) -> tuple[dict | None, dict | None]:
    """One connection, materialized; or the problem with it as an error dict, so
    doctor can report every connection rather than stopping at the first."""
    entry = entry if isinstance(entry, dict) else {}
    missing = [f for f in (*CONNECTION_FIELDS, "secret_env") if not entry.get(f)]
    if missing:
        return None, {"exit": 6, "code": "bad_connection",
                      "message": f"connection {cid!r} lacks {', '.join(missing)}",
                      "hint": "`agentrooms register NAME` writes a whole connection"}
    homeserver = str(entry["homeserver"]).rstrip("/")
    if not re.match(r"https?://[^/\s]+", homeserver):
        return None, {"exit": 6, "code": "bad_connection",
                      "message": f"connection {cid!r}: homeserver must be http(s)://host"}
    user_id = str(entry["user_id"])
    if not USER_RE.fullmatch(user_id):
        return None, {"exit": 6, "code": "bad_connection",
                      "message": f"connection {cid!r}: user_id {user_id!r} is not @name:server"}
    token = _resolve_env_key(entry["secret_env"])[0]
    if not token:
        return None, {"exit": 2, "code": "missing_secret",
                      "message": f"env var {entry['secret_env']} (connection {cid!r}) is unset",
                      "hint": f"`register` writes it into the project's .env.local; on a "
                              f"server inject {entry['secret_env']} into the environment"}
    return {"id": cid, "homeserver": homeserver, "user_id": user_id,
            "server": _server_of(user_id), "token": token,
            "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT))}, None


def _cfg(wanted: str | None, verb: str) -> dict:
    """Select, gate, then resolve: the write gate refuses before the token is
    read or any request is made."""
    reg, _ = _connections_registry()
    cid, entry = _select_connection(reg, wanted)
    _write_gate(cid, bool((entry or {}).get("allow_write", WRITE_DEFAULT)), verb)
    cfg, problem = _build_cfg(cid, entry)
    if problem:
        _die(problem["exit"], problem["code"], problem["message"], problem.get("hint"))
    return cfg


def _matrix(cfg: dict, timeout: float = TIMEOUT) -> Matrix:
    return Matrix(cfg["homeserver"], cfg["token"], timeout)


# ── doctor ───────────────────────────────────────────────────────────────────


def _check_connection(cfg: dict) -> dict:
    try:
        with _matrix(cfg, 20.0) as m:
            who = m.call("GET", "/_matrix/client/v3/account/whoami")
    except MatrixError as exc:
        return {"ok": False, "category": exc.exit_code, "error": exc.message,
                **({"hint": exc.hint} if exc.hint else {})}
    found = (who or {}).get("user_id")
    if found != cfg["user_id"]:
        return {"ok": False, "category": 7,
                "error": f"the token belongs to {found!r}, the connection declares "
                         f"{cfg['user_id']!r}",
                "hint": "the connection's secret_env holds another agent's token"}
    return {"ok": True, "user_id": found, "device_id": (who or {}).get("device_id"),
            "homeserver": cfg["homeserver"], "allow_write": cfg["allow_write"]}


def cmd_doctor(wanted: str | None) -> None:
    _doctor_gate(_connections_report(), wanted)
    reg, _ = _connections_registry()
    targets = [_select_connection(reg, wanted)] if wanted else list(reg["connections"].items())
    out: dict = {}
    fail = 0
    for cid, entry in targets:
        cfg, problem = _build_cfg(cid, entry)
        if problem:
            row = {"ok": False, "category": problem["exit"], "error": problem["message"]}
            if problem.get("hint"):
                row["hint"] = problem["hint"]
        else:
            row = _check_connection(cfg)
        if not row.get("ok") and not fail:
            fail = row.get("category") or 5
        row.pop("category", None)
        out[cid] = row
    _emit({"ok": fail == 0, "connections": out})
    if fail:
        sys.exit(fail)


# ── rooms ────────────────────────────────────────────────────────────────────


def _resolve_room(m: Matrix, cfg: dict, room: str) -> str:
    """A room id as given, or an alias on this homeserver resolved to one."""
    if room.startswith("!"):
        return room
    if room.startswith("#"):
        server = room.split(":", 1)[1] if ":" in room else ""
        if server != cfg["server"]:
            _die(6, "federation_refused",
                 f"alias {room!r} is on {server or 'no server'}, not {cfg['server']}",
                 "agentrooms reaches rooms on this homeserver only")
        try:
            found = m.call("GET", f"/_matrix/client/v3/directory/room/{_q(room)}")
        except MatrixError as exc:
            _fail(exc)
        return found["room_id"]
    _die(6, "bad_room", f"{room!r} is neither a room id (!...) nor an alias (#name:server)")


def _local_user(cfg: dict, who: str) -> str:
    if not USER_RE.fullmatch(who):
        _die(6, "bad_user", f"{who!r} is not a user id (@name:server)",
             "e.g. @agent:example.org")
    if _server_of(who) != cfg["server"]:
        _die(6, "federation_refused",
             f"{who} is on {_server_of(who)}, not {cfg['server']}",
             "agentrooms reaches users on this homeserver only")
    return who


def _encrypted(m: Matrix, room_id: str) -> bool:
    try:
        m.call("GET", f"/_matrix/client/v3/rooms/{_q(room_id)}/state/m.room.encryption/")
    except MatrixError as exc:
        if exc.exit_code == 3:
            return False
        _fail(exc)
    return True


def _refuse_encrypted(m: Matrix, room_id: str) -> None:
    if _encrypted(m, room_id):
        _die(6, "encrypted_room", f"{room_id} is encrypted",
             "agentrooms reads and posts in unencrypted rooms only")


# The state a room's row is read from.
ROOM_STATE_TYPES = ["m.room.name", "m.room.topic", "m.room.encryption",
                    "m.room.canonical_alias", "m.room.create", "m.room.power_levels"]
ROOMS_FILTER = {
    "presence": {"not_types": ["*"]},
    "account_data": {"not_types": ["*"]},
    "room": {
        "timeline": {"limit": 1},
        "ephemeral": {"not_types": ["*"]},
        "state": {"types": ROOM_STATE_TYPES},
        "account_data": {"types": [MARK_TYPE]},
    },
}
# The first room version whose creators hold every right and cannot lose it.
PRIVILEGED_CREATORS_FROM = 12


def _room_owners(create: dict | None, levels: dict | None) -> tuple[list[str], str | None]:
    """Who owns a room, and what that rests on.

    From room version 12 the creator, and any additional creator the create
    event names, holds every right for good, so ownership is the creators'.
    Before it ownership is a power level: the users holding the highest one in
    the room's power levels, which can move - or, where none were ever set, the
    creator, whom the defaults put above everyone."""
    if create is None:
        return [], None
    content = create.get("content") or {}
    creators = [create.get("sender"), *(content.get("additional_creators") or [])]
    creators = list(dict.fromkeys(u for u in creators if isinstance(u, str) and u))
    try:
        privileged = int(str(content.get("room_version") or "1")) >= PRIVILEGED_CREATORS_FROM
    except ValueError:
        privileged = False
    if privileged or levels is None:
        return creators, "creator"
    users = (levels.get("content") or {}).get("users") or {}
    ranked = {u: n for u, n in users.items() if isinstance(n, int) and not isinstance(n, bool)}
    if not ranked:
        return [], "power_level"
    top = max(ranked.values())
    return sorted(u for u, n in ranked.items() if n == top), "power_level"


def _room_row(room_id: str, events: list[dict]) -> dict:
    """A joined room's row, as far as its state events say: everything but its
    member count and this connection's mark, which the caller reads."""
    row = {"room_id": room_id, "name": None, "topic": None, "members": None,
           "encrypted": False, "marked": False, "owners": [], "owner_basis": None}
    create = levels = None
    for event in events:
        if event.get("state_key") != "":
            continue
        kind, content = event.get("type"), event.get("content") or {}
        if kind == "m.room.name":
            row["name"] = content.get("name")
        elif kind == "m.room.topic":
            row["topic"] = content.get("topic")
        elif kind == "m.room.encryption":
            row["encrypted"] = True
        elif kind == "m.room.create":
            create = event
        elif kind == "m.room.power_levels":
            levels = event
    row["owners"], row["owner_basis"] = _room_owners(create, levels)
    return row


def cmd_rooms(cfg: dict) -> dict:
    params = {"filter": json.dumps(ROOMS_FILTER, separators=(",", ":")), "timeout": "0",
              "full_state": "true"}
    with _matrix(cfg) as m:
        try:
            sync = m.call("GET", "/_matrix/client/v3/sync", params=params)
        except MatrixError as exc:
            _fail(exc)
        groups = (sync or {}).get("rooms") or {}
        joined = []
        for room_id, room in sorted((groups.get("join") or {}).items()):
            row = _room_row(room_id, [*((room.get("state") or {}).get("events") or []),
                                      *((room.get("timeline") or {}).get("events") or [])])
            members = (room.get("summary") or {}).get("m.joined_member_count")
            if not isinstance(members, int):
                with contextlib.suppress(MatrixError):
                    members = len((m.call("GET", f"/_matrix/client/v3/rooms/{_q(room_id)}"
                                          "/joined_members") or {}).get("joined") or {})
            row["members"] = members if isinstance(members, int) else None
            for event in (room.get("account_data") or {}).get("events") or []:
                if event.get("type") == MARK_TYPE:
                    row["marked"] = (event.get("content") or {}).get("marked") is True
            joined.append(row)
    invites = [_invite_row(cfg, room_id, room)
               for room_id, room in sorted((groups.get("invite") or {}).items())]
    return {"user_id": cfg["user_id"], "joined": joined, "invites": invites}


def _invite_row(cfg: dict, room_id: str, room: dict) -> dict:
    row = {"room_id": room_id, "name": None, "inviter": None, "encrypted": False}
    for event in (room.get("invite_state") or {}).get("events") or []:
        kind = event.get("type")
        if kind == "m.room.name":
            row["name"] = (event.get("content") or {}).get("name")
        elif kind == "m.room.member" and event.get("state_key") == cfg["user_id"]:
            row["inviter"] = event.get("sender")
        elif kind == "m.room.encryption":
            row["encrypted"] = True
    return row


def _message_row(event: dict) -> dict:
    content = event.get("content") or {}
    rel = content.get("m.relates_to") if isinstance(content.get("m.relates_to"), dict) else {}
    thread = rel.get("event_id") if rel.get("rel_type") == "m.thread" else None
    reply = None
    if isinstance(rel.get("m.in_reply_to"), dict) and not rel.get("is_falling_back"):
        reply = rel["m.in_reply_to"].get("event_id")
    file = None
    if content.get("url"):
        info = content.get("info") or {}
        file = {"url": content.get("url"), "name": content.get("filename") or content.get("body"),
                "mimetype": info.get("mimetype"), "size": info.get("size")}
    ts = event.get("origin_server_ts")
    when = (time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(ts / 1000))
            if isinstance(ts, (int, float)) else None)
    return {"event_id": event.get("event_id"), "sender": event.get("sender"), "ts": when,
            "msgtype": content.get("msgtype"), "body": content.get("body"),
            "thread": thread, "reply_to": reply, "data": content.get(DATA_KEY), "file": file}


def cmd_read(cfg: dict, room: str, limit: int) -> dict:
    with _matrix(cfg) as m:
        room_id = _resolve_room(m, cfg, room)
        _refuse_encrypted(m, room_id)
        try:
            found = m.call("GET", f"/_matrix/client/v3/rooms/{_q(room_id)}/messages",
                           params={"dir": "b", "limit": str(limit),
                                   "filter": json.dumps({"types": ["m.room.message"]})})
        except MatrixError as exc:
            _fail(exc)
    chunk = [e for e in (found or {}).get("chunk") or [] if e.get("type") == "m.room.message"]
    messages = [_message_row(e) for e in reversed(chunk)]
    more = bool((found or {}).get("end")) and len(chunk) >= limit
    return {"room_id": room_id, "limit": limit, "count": len(messages), "more": more,
            "messages": messages}


# ── watch ────────────────────────────────────────────────────────────────────

# What `watch` follows: every room event, read receipts, and this connection's
# mark. The first sync only takes the position, so nothing from before it prints.
WATCH_FILTER = {
    "presence": {"not_types": ["*"]},
    "account_data": {"not_types": ["*"]},
    "room": {
        "timeline": {"limit": 50},
        "state": {"types": ROOM_STATE_TYPES},
        "ephemeral": {"types": ["m.receipt"]},
        "account_data": {"types": [MARK_TYPE]},
    },
}
WATCH_START_FILTER = {
    "presence": {"not_types": ["*"]},
    "account_data": {"not_types": ["*"]},
    "room": {"timeline": {"limit": 1}, "state": {"not_types": ["*"]},
             "ephemeral": {"not_types": ["*"]}, "account_data": {"not_types": ["*"]}},
}
WATCH_POLL_MS = 30000
# A change to one of these in a joined room reprints the room's row.
WATCH_ROOM_TYPES = {"m.room.name", "m.room.topic", "m.room.encryption", "m.room.power_levels"}


class _WatchStopped(Exception):
    """The watch was told to end: a signal, or its reader went away."""


def _watch_stop(signum, frame) -> NoReturn:
    raise _WatchStopped()


def _watch_line(value: dict) -> None:
    try:
        sys.stdout.write(json.dumps(value, ensure_ascii=False) + "\n")
        sys.stdout.flush()
    except (BrokenPipeError, ValueError):
        raise _WatchStopped() from None


def _ms_iso(ts) -> str | None:
    return (time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(ts / 1000))
            if isinstance(ts, (int, float)) else None)


def _live_room_row(m: Matrix, cfg: dict, room_id: str) -> dict:
    """A joined room's whole row, read from the room as it is now."""
    try:
        state = m.call("GET", f"/_matrix/client/v3/rooms/{_q(room_id)}/state") or []
    except MatrixError as exc:
        if exc.exit_code == 3 or exc.code == "forbidden":
            state = []
        else:
            raise
    row = _room_row(room_id, state if isinstance(state, list) else [])
    row["members"] = sum(1 for e in state if isinstance(e, dict)
                         and e.get("type") == "m.room.member"
                         and (e.get("content") or {}).get("membership") == "join") or None
    try:
        mark = m.call("GET", f"/_matrix/client/v3/user/{_q(cfg['user_id'])}/rooms/{_q(room_id)}"
                      f"/account_data/{MARK_TYPE}")
        row["marked"] = (mark or {}).get("marked") is True
    except MatrixError as exc:
        if exc.exit_code != 3:
            raise
    return row


def _watch_lines(m: Matrix, cfg: dict, sync: dict, rooms: set | None,
                 joined: set) -> list[dict]:
    """What one sync says, as watch lines, in the order it says it. `joined`
    is the set of rooms this connection is in, kept current."""
    out: list[dict] = []
    groups = (sync or {}).get("rooms") or {}
    for room_id, room in (groups.get("invite") or {}).items():
        if rooms is None or room_id in rooms:
            out.append({"event": "invite", "room_id": room_id,
                        "invite": _invite_row(cfg, room_id, room)})
    for section in ("join", "leave"):
        for room_id, room in (groups.get(section) or {}).items():
            if rooms is not None and room_id not in rooms:
                continue
            timeline = room.get("timeline") or {}
            events = timeline.get("events") or []
            fresh = section == "join" and room_id not in joined
            if fresh:
                # A room just joined arrives with its recent history; only what
                # follows this connection's own join is new.
                mine = [i for i, e in enumerate(events) if e.get("type") == "m.room.member"
                        and e.get("state_key") == cfg["user_id"]
                        and (e.get("content") or {}).get("membership") == "join"]
                events = events[mine[-1]:] if mine else []
            elif timeline.get("limited"):
                out.append({"event": "gap", "room_id": room_id})
            reprint = fresh
            for event in events:
                kind = event.get("type")
                if kind == "m.room.message" and "state_key" not in event:
                    out.append({"event": "message", "room_id": room_id,
                                "message": _message_row(event)})
                elif kind == "m.room.member" and "state_key" in event:
                    out.append({"event": "membership", "room_id": room_id,
                                "user_id": event.get("state_key"),
                                "membership": (event.get("content") or {}).get("membership"),
                                "sender": event.get("sender"), "event_id": event.get("event_id"),
                                "ts": _ms_iso(event.get("origin_server_ts"))})
                elif kind in WATCH_ROOM_TYPES and event.get("state_key") == "":
                    reprint = True
            if section == "leave":
                joined.discard(room_id)
                continue
            joined.add(room_id)
            if reprint:
                out.append({"event": "room", "room": _live_room_row(m, cfg, room_id)})
            for event in (room.get("ephemeral") or {}).get("events") or []:
                if event.get("type") != "m.receipt":
                    continue
                for event_id, kinds in (event.get("content") or {}).items():
                    for kind in ("m.read", "m.read.private"):
                        for user_id, info in ((kinds or {}).get(kind) or {}).items():
                            out.append({"event": "receipt", "room_id": room_id,
                                        "user_id": user_id, "event_id": event_id,
                                        "ts": _ms_iso((info or {}).get("ts"))})
            for event in (room.get("account_data") or {}).get("events") or []:
                if event.get("type") == MARK_TYPE:
                    out.append({"event": "marked", "room_id": room_id,
                                "marked": (event.get("content") or {}).get("marked") is True})
    return out


def cmd_watch(cfg: dict, rooms_named: list[str] | None) -> None:
    previous = {sig: signal.signal(sig, _watch_stop) for sig in (signal.SIGTERM, signal.SIGINT)}
    try:
        with _matrix(cfg) as m:
            rooms = None
            if rooms_named:
                rooms = set()
                for room in rooms_named:
                    room_id = _resolve_room(m, cfg, room)
                    _refuse_encrypted(m, room_id)
                    rooms.add(room_id)
            try:
                first = m.call("GET", "/_matrix/client/v3/sync", params={
                    "filter": json.dumps(WATCH_START_FILTER, separators=(",", ":")),
                    "timeout": "0"})
            except MatrixError as exc:
                _fail(exc)
            since = (first or {}).get("next_batch")
            joined = set(((first or {}).get("rooms") or {}).get("join") or {})
            _watch_line({"event": "ready", "connection": cfg["id"], "user_id": cfg["user_id"],
                         "rooms": sorted(rooms) if rooms is not None else None})
            params = {"filter": json.dumps(WATCH_FILTER, separators=(",", ":")),
                      "timeout": str(WATCH_POLL_MS)}
            wait, lost = 1.0, False
            while True:
                try:
                    sync = m.call("GET", "/_matrix/client/v3/sync",
                                  params={**params, **({"since": since} if since else {})})
                    lines = _watch_lines(m, cfg, sync, rooms, joined)
                except MatrixError as exc:
                    if exc.exit_code != 5:
                        _fail(exc)
                    if not lost:
                        _watch_line({"event": "lost", "error": exc.message})
                        lost = True
                    time.sleep(wait)
                    wait = min(wait * 2, 30.0)
                    continue
                if lost:
                    _watch_line({"event": "resumed"})
                    wait, lost = 1.0, False
                for line in lines:
                    _watch_line(line)
                since = (sync or {}).get("next_batch") or since
    except _WatchStopped:
        sys.exit(0)
    finally:
        for sig, handler in previous.items():
            signal.signal(sig, handler)


def cmd_open(cfg: dict, name: str, invites: list[str], topic: str | None) -> dict:
    invited = [_local_user(cfg, who) for who in invites]
    if cfg["user_id"] in invited:
        _die(6, "bad_user", "an agent does not invite itself")
    body: dict = {
        "name": name, "room_version": ROOM_VERSION, "preset": "private_chat",
        "visibility": "private", "invite": invited,
        "creation_content": {"m.federate": False},
        # The room's rights, fixed here and never changed afterwards: inviting and
        # every state change - a member raising its own power included - need
        # level 50, which no member holds, so only the creator, whom room version
        # 12 privileges by creating the room, may do either. The creator stays
        # out of `users`: room version 12 refuses it there.
        "power_level_content_override": {"invite": 50, "state_default": 50},
    }
    if topic:
        body["topic"] = topic
    with _matrix(cfg) as m:
        try:
            found = m.call("POST", "/_matrix/client/v3/createRoom", body=body, idempotent=False)
        except MatrixError as exc:
            _fail(exc)
    return {"room_id": (found or {}).get("room_id"), "name": name, "room_version": ROOM_VERSION,
            "federate": False, "encrypted": False, "invited": invited}


def cmd_invite(cfg: dict, room: str, who: str) -> dict:
    who = _local_user(cfg, who)
    with _matrix(cfg) as m:
        room_id = _resolve_room(m, cfg, room)
        try:
            m.call("POST", f"/_matrix/client/v3/rooms/{_q(room_id)}/invite",
                   body={"user_id": who}, idempotent=True)
        except MatrixError as exc:
            _fail(exc)
    return {"room_id": room_id, "invited": who}


def cmd_join(cfg: dict, room: str) -> dict:
    with _matrix(cfg) as m:
        target = room
        if room.startswith("#"):
            target = _resolve_room(m, cfg, room)
        elif not room.startswith("!"):
            _die(6, "bad_room", f"{room!r} is neither a room id (!...) nor an alias (#name:server)")
        try:
            found = m.call("POST", f"/_matrix/client/v3/join/{_q(target)}", body={},
                           idempotent=True)
        except MatrixError as exc:
            _fail(exc)
        room_id = (found or {}).get("room_id") or target
        if _encrypted(m, room_id):
            with contextlib.suppress(MatrixError):
                m.call("POST", f"/_matrix/client/v3/rooms/{_q(room_id)}/leave", body={})
            _die(6, "encrypted_room", f"{room_id} is encrypted; joined and left it again",
                 "agentrooms takes part in unencrypted rooms only")
    return {"room_id": room_id, "joined": True}


def cmd_leave(cfg: dict, room: str) -> dict:
    with _matrix(cfg) as m:
        room_id = _resolve_room(m, cfg, room)
        try:
            m.call("POST", f"/_matrix/client/v3/rooms/{_q(room_id)}/leave", body={},
                   idempotent=True)
        except MatrixError as exc:
            _fail(exc)
    return {"room_id": room_id, "left": True}


def _upload(m: Matrix, path: Path) -> dict:
    try:
        data = path.read_bytes()
    except OSError as exc:
        _die(6, "bad_file", f"cannot read {path}: {exc}")
    mimetype = mimetypes.guess_type(path.name)[0] or "application/octet-stream"
    try:
        found = m.call("POST", "/_matrix/media/v3/upload", params={"filename": path.name},
                       content=data, content_type=mimetype, idempotent=True)
    except MatrixError as exc:
        _fail(exc)
    uri = (found or {}).get("content_uri")
    if not uri:
        _die(5, "upload_failed", "the homeserver answered the upload without a content_uri")
    return {"url": uri, "mimetype": mimetype, "size": len(data), "name": path.name}


def _message_content(cfg: dict, text: str, thread: str | None, reply: str | None,
                     data: dict | None, upload: dict | None) -> dict:
    if upload:
        family = upload["mimetype"].split("/", 1)[0]
        msgtype = {"image": "m.image", "video": "m.video", "audio": "m.audio"}.get(family, "m.file")
        content: dict = {"msgtype": msgtype, "body": text or upload["name"],
                         "filename": upload["name"], "url": upload["url"],
                         "info": {"mimetype": upload["mimetype"], "size": upload["size"]}}
    else:
        content = {"msgtype": "m.text", "body": text}
    mentioned = sorted({u for u in USER_RE.findall(text) if u != cfg["user_id"]})
    content["m.mentions"] = {"user_ids": mentioned} if mentioned else {}
    if thread:
        content["m.relates_to"] = {"rel_type": "m.thread", "event_id": thread,
                                   "is_falling_back": reply is None,
                                   "m.in_reply_to": {"event_id": reply or thread}}
    elif reply:
        content["m.relates_to"] = {"m.in_reply_to": {"event_id": reply}}
    if data is not None:
        content[DATA_KEY] = data
    return content


def cmd_post(cfg: dict, room: str, text: str, thread: str | None, reply: str | None,
             data_raw: str | None, file: str | None, txn: str | None) -> dict:
    if text == "-":
        text = sys.stdin.read()
    text = text.rstrip("\n")
    data = None
    if data_raw is not None:
        try:
            data = json.loads(data_raw)
        except ValueError as exc:
            _die(6, "bad_data", f"--data is not JSON: {exc}", 'e.g. --data \'{"kind": "status"}\'')
        if not isinstance(data, dict):
            _die(6, "bad_data", "--data must be a JSON object")
    if not text and not file:
        _die(6, "empty_message", "TEXT is empty and no --file is given")
    for flag, value in (("--thread", thread), ("--reply-to", reply)):
        if value is not None and not value.startswith("$"):
            _die(6, "bad_event", f"{flag} {value!r} is not an event id ($...)")
    if txn is not None and not re.fullmatch(r"[A-Za-z0-9._~-]{1,64}", txn):
        _die(6, "bad_txn_id", "--txn-id is 1-64 characters of A-Z a-z 0-9 . _ ~ -")
    txn = txn or uuid.uuid4().hex
    with _matrix(cfg) as m:
        room_id = _resolve_room(m, cfg, room)
        _refuse_encrypted(m, room_id)
        upload = _upload(m, Path(file).expanduser()) if file else None
        content = _message_content(cfg, text, thread, reply, data, upload)
        try:
            found = m.call("PUT", f"/_matrix/client/v3/rooms/{_q(room_id)}/send/m.room.message/"
                           f"{_q(txn)}", body=content, idempotent=True)
        except MatrixError as exc:
            _fail(exc)
    return {"room_id": room_id, "event_id": (found or {}).get("event_id"), "txn_id": txn}


def cmd_mark(cfg: dict, room: str, marked: bool) -> dict:
    with _matrix(cfg) as m:
        room_id = _resolve_room(m, cfg, room)
        try:
            m.call("PUT", f"/_matrix/client/v3/user/{_q(cfg['user_id'])}/rooms/{_q(room_id)}"
                   f"/account_data/{MARK_TYPE}", body={"marked": marked})
        except MatrixError as exc:
            _fail(exc)
    return {"room_id": room_id, "marked": marked}


# ── register ─────────────────────────────────────────────────────────────────


def _connection_env_key(cid: str) -> str:
    return "AGENTROOMS_" + re.sub(r"[^A-Z0-9]", "_", cid.upper()) + "_TOKEN"


def _env_line_key(line: str) -> str | None:
    text = line.strip()
    if not text or text.startswith("#") or "=" not in text:
        return None
    key = text.split("=", 1)[0].strip()
    return key[len("export "):].strip() if key.startswith("export ") else key


def _write_env_key(path: Path, key: str, value: str) -> None:
    """Set one key in an env file, keeping every other line, atomically, at mode
    0600; proven by reading it back through the cascade's own parser."""
    lines = path.read_text().splitlines() if path.exists() else []
    written = f"{key}='{value}'"
    out, done = [], False
    for line in lines:
        if _env_line_key(line) == key:
            if not done:
                out.append(written)
                done = True
            continue
        out.append(line)
    if not done:
        out.append(written)
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write("\n".join(out) + "\n")
        os.replace(temporary, path)
    finally:
        if temporary.exists():
            temporary.unlink()
    os.chmod(path, 0o600)
    if _parse_env_file(path).get(key) != value:
        _die(5, "credentials_write_failed", f"{path} does not read back the value written for {key}")


def cmd_register(name: str, homeserver_flag: str | None, as_id: str | None,
                 make_default: bool) -> dict:
    _read_only_gate(f"`{NAME} register`")
    if not LOCALPART_RE.fullmatch(name):
        _die(6, "bad_name", f"NAME {name!r} is not a Matrix localpart",
             "lowercase letters, digits and . _ = -, starting with a letter or digit")
    cid = as_id or name
    if not KEY_RE.fullmatch(cid):
        _die(6, "bad_connection_id", f"connection id {cid!r} must match {KEY_RE.pattern}")
    root = _project_root()
    adapter = _records()
    envelope = getattr(adapter, "envelope", None)
    if root is None or envelope is None or not Path(envelope).is_dir():
        _die(6, "no_envelope", "register writes the agent's connection into this project's "
             "capabilities/ envelope, and there is none here", "run `capabilities init` first")
    if cid in (_inventory_connections()["connections"] or {}):
        _die(6, "connection_exists", f"connection {cid!r} is already declared",
             "pass --as <another-id>, or register another NAME")
    homeserver = homeserver_flag or _resolve_env_key(HOMESERVER_KEY)[0]
    if not homeserver:
        _die(6, "homeserver_missing", "no homeserver to register on",
             f"a person sets {HOMESERVER_KEY} once per machine in {CREDENTIALS_ENV}, or pass "
             "--homeserver https://matrix.example.org")
    homeserver = homeserver.rstrip("/")
    if not re.match(r"https?://[^/\s]+$", homeserver):
        _die(6, "bad_homeserver", f"{homeserver!r} is not http(s)://host[:port]")
    token = _resolve_env_key(REGISTRATION_KEY)[0]
    if not token:
        _die(2, "registration_token_missing", f"{REGISTRATION_KEY} is unset",
             f"a person sets it once per machine in {CREDENTIALS_ENV}; ask the user")
    with Matrix(homeserver) as m:
        # The interactive-auth handshake: the first request answers 401 with the
        # session and the flows on offer; an open homeserver registers at once.
        try:
            probe = m.http.post("/_matrix/client/v3/register", json={"username": name})
        except m.httpx.TimeoutException:
            _die(5, "outcome_unknown", "the registration request timed out after it was sent; "
                 "whether the account exists is unknown", "register another NAME")
        except m.httpx.RequestError as exc:
            _die(5, "network_error", f"cannot reach {homeserver}: {exc}",
                 "check the homeserver URL and connectivity")
        if probe.status_code == 200:
            done = probe.json()
        elif probe.status_code != 401:
            if probe.status_code >= 500:
                _die(5, "server_error", f"the homeserver returned {probe.status_code}",
                     probe.text[:300], probe.status_code)
            _fail(_matrix_refusal(probe))
        else:
            info = probe.json()
            flows = [f.get("stages") for f in info.get("flows") or []]
            if ["m.login.registration_token"] not in flows:
                _die(6, "registration_unsupported",
                     f"{homeserver} offers no m.login.registration_token flow (offers {flows})")
            try:
                done = m.call("POST", "/_matrix/client/v3/register", idempotent=False, body={
                    "username": name, "initial_device_display_name": f"{NAME} {cid}",
                    "auth": {"type": "m.login.registration_token", "token": token,
                             "session": info.get("session")}})
            except MatrixError as exc:
                if exc.status == 401:
                    _die(2, "registration_token_rejected",
                         "the homeserver rejected the registration token",
                         f"check {REGISTRATION_KEY} with the person who configured it")
                _fail(exc)
    user_id, access, device = done.get("user_id"), done.get("access_token"), done.get("device_id")
    if not user_id or not access:
        _die(5, "registration_incomplete", "the homeserver registered without returning a token")
    secret_env = _connection_env_key(cid)
    credentials = root / ".env.local"
    _write_env_key(credentials, secret_env, access)
    entry = {"homeserver": homeserver, "user_id": user_id, "secret_env": secret_env,
             "device_id": device}
    try:
        adapter.set(NAME, "connection", cid, entry, scope="project")
        if make_default:
            adapter.set(NAME, "setting", "connection.default", cid, scope="project")
        registry = adapter.scope_source(NAME, "connection", "project")
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)
    return {"registered": True, "connection": cid, "user_id": user_id, "homeserver": homeserver,
            "device_id": device, "secret_env": secret_env, "credentials": str(credentials),
            "registry": str(registry), "default": make_default, "allow_write": WRITE_DEFAULT,
            "next": f"writes need a grant: ask the user to run `capabilities set {NAME} grant "
                    f"{cid} '{{\"allow_write\": true}}'` in this project"}


def _read_password() -> str:
    """Standard input whole, less one trailing newline; without echo when it is
    a terminal."""
    if sys.stdin.isatty():
        import getpass
        return getpass.getpass("")
    value = sys.stdin.read()
    return value[:-1] if value.endswith("\n") else value


def cmd_login(user_id: str, homeserver_flag: str | None, as_id: str | None, scope: str,
              make_default: bool) -> dict:
    _read_only_gate(f"`{NAME} login`")
    if not USER_RE.fullmatch(user_id):
        _die(6, "bad_user", f"{user_id!r} is not a user id (@name:server)",
             "e.g. @person:example.org")
    cid = as_id or user_id[1:].split(":", 1)[0]
    if not KEY_RE.fullmatch(cid):
        _die(6, "bad_connection_id", f"connection id {cid!r} must match {KEY_RE.pattern}",
             "pass --as <id>")
    root = _project_root()
    adapter = _records()
    if scope == "project":
        envelope = getattr(adapter, "envelope", None)
        if root is None:
            _die(6, "no_project", "--project signs in for this project and there is no "
                 "project here", "run it inside the project, or pass --global")
        if envelope is None or not Path(envelope).is_dir():
            _die(6, "no_envelope", "no capabilities/ envelope in this project",
                 "run `capabilities init` first")
    declared = (_inventory_connections()["connections"] or {}).get(cid)
    if declared is not None and declared.get("user_id") != user_id:
        _die(6, "connection_exists",
             f"connection {cid!r} is already declared for {declared.get('user_id')!r}",
             "pass --as <another-id>")
    homeserver = homeserver_flag or _resolve_env_key(HOMESERVER_KEY)[0]
    if not homeserver:
        _die(6, "homeserver_missing", "no homeserver to sign in to",
             f"pass --homeserver https://matrix.example.org, or a person sets {HOMESERVER_KEY} "
             f"once per machine in {CREDENTIALS_ENV}")
    homeserver = homeserver.rstrip("/")
    if not re.match(r"https?://[^/\s]+$", homeserver):
        _die(6, "bad_homeserver", f"{homeserver!r} is not http(s)://host[:port]")
    password = _read_password()
    if not password:
        _die(6, "password_missing", "no password on standard input",
             "pipe the account's password to standard input; it is never stored or printed")
    with Matrix(homeserver) as m:
        try:
            done = m.call("POST", "/_matrix/client/v3/login", idempotent=False, body={
                "type": "m.login.password",
                "identifier": {"type": "m.id.user", "user": user_id},
                "password": password, "initial_device_display_name": f"{NAME} {cid}"})
        except MatrixError as exc:
            if exc.status in (401, 403):
                _die(2, "login_rejected", f"the homeserver refused the sign-in: {exc.message}",
                     "check the user id and the password with the person who owns the account")
            _fail(exc)
        finally:
            password = None
    found, access, device = done.get("user_id"), done.get("access_token"), done.get("device_id")
    if not found or not access:
        _die(5, "login_incomplete", "the homeserver signed in without returning a token")
    if found != user_id:
        _die(6, "login_mismatch", f"the homeserver signed in {found!r}, not {user_id!r}",
             "name the account by its full user id")
    secret_env = _connection_env_key(cid)
    credentials = CREDENTIALS_ENV if scope == "global" else root / ".env.local"
    _write_env_key(credentials, secret_env, access)
    entry = {"homeserver": homeserver, "user_id": found, "secret_env": secret_env,
             "device_id": device}
    try:
        adapter.set(NAME, "connection", cid, entry, scope=scope)
        if make_default:
            adapter.set(NAME, "setting", "connection.default", cid, scope=scope)
        registry = adapter.scope_source(NAME, "connection", scope)
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)
    out = {"logged_in": True, "connection": cid, "scope": scope, "user_id": found,
           "homeserver": homeserver, "device_id": device, "secret_env": secret_env,
           "credentials": str(credentials), "registry": str(registry), "default": make_default}
    machine_read = _machine_read("rooms")
    usable = (_inventory_connections(machine_read)["connections"].get(cid) or {})
    out["allow_write"] = bool(usable.get("allow_write")) and not machine_read
    out["usable_here"] = bool(usable.get("granted"))
    if not out["usable_here"]:
        out["hint"] = _grant_hint(cid)
    elif machine_read:
        out["machine_reads"] = list(MACHINE_READS)
    if out["usable_here"] and not out["allow_write"]:
        out["next"] = ("writes need a grant: ask the user to run `capabilities set "
                       f"{NAME} grant {cid} '{{\"enabled\": true, \"allow_write\": true}}'` "
                       "in the project that should post as this account")
    return out


# ── sessions: what the service recorded ──────────────────────────────────────


def _agent_store(wanted: str | None, verb: str):
    """The selected agent's connection and the project's store its service
    writes to, or the refusal that says why there is none here."""
    root = _project_root()
    if root is None:
        _die(6, "input", f"`{verb}` reads the service's record in an agent's project, and "
             "this is not one", "run it where the project whose agent it is")
    reg, _ = _connections_registry()
    cid, entry = _select_connection(reg, wanted)
    try:
        project, _slug = _identity_here()
        store = _open_store(root)
    except _Refusal as exc:
        _refused(exc)
    return cid, (entry or {}), project, store


def cmd_sessions(wanted: str | None, room: str | None) -> dict:
    cid, entry, project, store = _agent_store(wanted, "sessions")
    try:
        room_id = None
        if room:
            if room.startswith("#"):
                cfg = _cfg(wanted, "sessions")
                with _matrix(cfg) as m:
                    room_id = _resolve_room(m, cfg, room)
            elif room.startswith("!"):
                room_id = room
            else:
                _die(6, "bad_room",
                     f"{room!r} is neither a room id (!...) nor an alias (#name:server)")
        rows = store.sessions(project, cid, room_id)
    finally:
        store.close()
    return {"connection": cid, "user_id": entry.get("user_id"), "sessions": rows}


def cmd_turn(wanted: str | None, event_id: str):
    if not event_id.startswith("$"):
        _die(6, "bad_event", f"{event_id!r} is not an event id ($...)")
    cid, _entry, project, store = _agent_store(wanted, "turn")
    try:
        found = store.answered_by(project, cid, event_id)
    finally:
        store.close()
    return None if found is None else {"event_id": event_id, "connection": cid, **found}


# ── the service: files, settings, the opt-in list ────────────────────────────

MACHINE_KEYS = ("version", "max_turns")
DEFAULT_MAX_TURNS = 2
# What a connection carries beyond its identity: the worker bound to the agent,
# the workers bound to it per room, and its supervisor's address.
BINDING_KEYS = ("worker", "rooms", "supervisor")
_PROJECT_POINTERS = ("CLAUDE_PROJECT_DIR", "CAPABILITIES_PROJECT_ID",
                     "CAPABILITIES_PROJECT_ID_ROOT", "CAPABILITIES_PROJECT_ENVELOPE",
                     "CAPABILITIES_PROJECT_ENVELOPE_ROOT")
_PROJECT_ENTRY_KEYS = ("root", "slug", "joined_at", "joined_by")


class _Refusal(Exception):
    def __init__(self, exit_code: int, code: str, message: str, hint: str | None = None):
        super().__init__(message)
        self.exit_code, self.code, self.message, self.hint = exit_code, code, message, hint


def _refused(exc: _Refusal) -> NoReturn:
    _die(exc.exit_code, exc.code, exc.message, exc.hint)


def _bundle_dir() -> Path:
    here = Path(__file__).resolve()
    return here.parent.parent if here.parent.name == "bin" else here.parent


_ENGINE = None


def _engine():
    """The bundled service engine, loaded once from the installed bundle."""
    global _ENGINE
    if _ENGINE is None:
        path = _bundle_dir() / "service" / "engine.py"
        spec = importlib.util.spec_from_file_location("agentrooms_engine", path)
        module = importlib.util.module_from_spec(spec)
        sys.modules["agentrooms_engine"] = module
        spec.loader.exec_module(module)
        _ENGINE = module
    return _ENGINE


def _tables():
    engine = _engine()
    return engine.LEDGER_STEPS, engine.LEDGER_MAJOR, engine.LEDGER_MINOR


def _machine_service_dir() -> Path:
    return _CONFIG_HOME / NAME / "service"


def _machine_projects_path() -> Path:
    return _machine_service_dir() / "projects.json"


def _machine_config_path() -> Path:
    return _machine_service_dir() / "config.json"


def _machine_state_dir() -> Path:
    return _STATE_HOME / "capabilities" / "machine" / NAME


def _project_state_dir(slug: str) -> Path:
    return _STATE_HOME / "capabilities" / "projects" / slug / NAME


def _service_dir(root: Path) -> Path:
    return _project_capabilities_dir(root) / NAME / "service"


def _settings_path(root: Path) -> Path:
    """Where an earlier release kept the project's agents map, which `workers
    import` and the service move into workers."""
    return _service_dir(root) / "settings.json"


def _template_path() -> Path:
    return _bundle_dir() / "service" / "templates" / "room.md"


def _shipped_profiles_dir() -> Path:
    return _bundle_dir() / "service" / "profiles"


def _read_bytes(path: Path) -> bytes:
    try:
        return path.read_bytes()
    except OSError:
        return b"absent"


def _legacy_agents(root: Path) -> dict | None:
    """The agents map an earlier release's service/settings.json declared, each
    agent's profile, turn_timeout and history; None when there is none."""
    path = _settings_path(root)
    if not path.is_file():
        return None
    try:
        raw = json.loads(path.read_text())
    except (OSError, ValueError) as exc:
        raise _Refusal(6, "settings_invalid", f"{path}: it does not read as JSON: {exc}",
                       f"its agents map is moved into workers; repair it, or remove it and "
                       f"bind workers with `{NAME} workers bind`") from None
    agents = raw.get("agents") if isinstance(raw, dict) else None
    if not isinstance(agents, dict):
        return None
    out: dict = {}
    for cid, conf in agents.items():
        conf = conf if isinstance(conf, dict) else {}
        out[str(cid)] = {"profile": conf.get("profile", _engine().DEFAULT_PROFILE),
                         "turn_timeout": conf.get("turn_timeout", 900),
                         "history": conf.get("history", 30)}
    return out


def _load_machine_settings() -> dict:
    path = _machine_config_path()

    def refuse(sentence: str) -> NoReturn:
        raise _Refusal(6, "machine_settings_invalid", f"{path}: {sentence}",
                       f"`{NAME} service init --machine --force` writes the template")

    settings = {"version": 1, "max_turns": DEFAULT_MAX_TURNS}
    if not path.is_file():
        return settings
    try:
        raw = json.loads(path.read_text())
    except (OSError, ValueError) as exc:
        refuse(f"it does not read as JSON: {exc}")
    if not isinstance(raw, dict):
        refuse("it is one JSON object")
    unknown = sorted(set(raw) - set(MACHINE_KEYS))
    if unknown:
        refuse(f"it names {', '.join(map(repr, unknown))}, which nothing reads")
    if raw.get("version") != 1 or isinstance(raw.get("version"), bool):
        refuse("its `version` is 1")
    if "max_turns" in raw:
        value = raw["max_turns"]
        if isinstance(value, bool) or not isinstance(value, int) or value < 1:
            refuse("its `max_turns` is a whole number of at least 1")
        settings["max_turns"] = value
    return settings


def _machine_fingerprint() -> str:
    return _engine().fingerprint_of(b"machine", _read_bytes(_machine_config_path()))


def _project_fingerprint(root: Path) -> str:
    """Which declaration the project holds: the connections it serves, each by
    its identity and grant. Workers, profiles and bindings are read at every
    turn, so they are no part of it."""
    conns = _inventory_connections().get("connections") or {}
    served = sorted((cid, str(e.get("homeserver")), str(e.get("user_id")),
                     str(e.get("secret_env")), bool(e.get("allow_write")))
                    for cid, e in conns.items() if e.get("granted"))
    return _engine().fingerprint_of(json.dumps(served).encode())


def _actor() -> str:
    user = os.environ.get("USER") or os.environ.get("LOGNAME") or "unknown"
    return f"{user}@{socket.gethostname()}"


def _utc_now() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def _read_projects() -> dict:
    """The opt-in list, every project on it by its id. No file is an empty list."""
    path = _machine_projects_path()

    def refuse(sentence: str) -> NoReturn:
        raise _Refusal(6, "projects_invalid", f"{path}: {sentence}",
                       f"`{NAME} service join` and `{NAME} service leave` write it; repair it, "
                       "or remove it and join the projects again")

    if not path.exists():
        return {}
    try:
        raw = json.loads(path.read_text())
    except (OSError, ValueError) as exc:
        refuse(f"it does not read as JSON: {exc}")
    if not isinstance(raw, dict) or raw.get("version") != 1:
        refuse("it is {\"version\": 1, \"projects\": {...}}")
    projects = raw.get("projects") or {}
    if not isinstance(projects, dict):
        refuse("its `projects` maps project ids to entries")
    listed = {}
    for project, entry in projects.items():
        if not isinstance(entry, dict) or not isinstance(entry.get("root"), str) \
                or not Path(entry["root"]).is_absolute() or not entry.get("slug"):
            refuse(f"its entry {project!r} is {{root, slug, joined_at, joined_by}}")
        listed[str(project)] = {k: entry.get(k) for k in _PROJECT_ENTRY_KEYS}
    return listed


def _write_projects(listed: dict) -> None:
    path = _machine_projects_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    spare = path.with_name(f".{path.name}.{os.getpid()}")
    spare.write_text(json.dumps({"version": 1, "projects": dict(sorted(listed.items()))},
                                indent=2) + "\n")
    os.replace(spare, path)


@contextlib.contextmanager
def _list_lock():
    import fcntl
    state = _machine_state_dir()
    state.mkdir(parents=True, exist_ok=True)
    with (state / "projects.lock").open("a+") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        yield


def _listed() -> dict:
    try:
        return _read_projects()
    except _Refusal as exc:
        _refused(exc)


@contextlib.contextmanager
def _project_scope(root: Path):
    """Stand in one project for the length of a block: the environment points at
    that project alone and its records adapter is opened afresh; both are put
    back on the way out."""
    global _RECORDS
    saved_env, saved_records = dict(os.environ), _RECORDS
    for key in _PROJECT_POINTERS:
        os.environ.pop(key, None)
    os.environ["CLAUDE_PROJECT_DIR"] = str(root)
    _RECORDS = None
    try:
        yield
    finally:
        if _RECORDS is not None and _RECORDS is not saved_records:
            with contextlib.suppress(Exception):
                _RECORDS.close()
        os.environ.clear()
        os.environ.update(saved_env)
        _RECORDS = saved_records


def _ask_in_project(root: Path, question):
    """Answer `question` inside the project's scope; a refusal it would have
    exited with is raised as a _Refusal, so one project never ends the process."""
    import io
    said = io.StringIO()
    try:
        with contextlib.redirect_stderr(said), _project_scope(root):
            return question()
    except SystemExit as stop:
        error: dict = {}
        for line in reversed(said.getvalue().strip().splitlines()):
            with contextlib.suppress(ValueError, AttributeError):
                error = json.loads(line).get("error") or {}
                break
        raise _Refusal(stop.code if isinstance(stop.code, int) else 6,
                       error.get("code") or "refused",
                       error.get("message") or "the check exited without saying why",
                       error.get("hint")) from None


def _identity_here() -> tuple[str, str]:
    """This project's id and slug, or the refusal that says why it has none."""
    root = _project_root()
    project = _project_id(write=True, refuse=False)
    identity_file = _project_capabilities_dir(root) / "project.json"
    try:
        slug = json.loads(identity_file.read_text()).get("slug")
    except (OSError, ValueError):
        slug = None
    if not project or not slug:
        raise _Refusal(6, "no_project_identity",
                       f"this project has no durable id and slug in {identity_file}",
                       "run `capabilities init` in the project")
    return str(project), str(slug)


def _joined_here() -> dict | None:
    root = _project_root()
    if root is None:
        return None
    try:
        project, _slug = _identity_here()
        entry = _read_projects().get(project)
    except _Refusal:
        return None
    return {**entry, "id": project} if entry else None


# ── the plan: what the process serves of one project ─────────────────────────

FIT_PERMISSION = "bypassPermissions"


def _profile_fit(knobs: dict) -> list[str]:
    """What a turn needs of a profile: free text, and nobody to ask for consent."""
    problems = []
    if knobs.get("output_schema") is not None:
        problems.append("output_schema is set; the service posts the turn's free-text answer")
    harness = knobs.get("harness")
    if harness == "claude":
        if knobs.get("permission_mode") != FIT_PERMISSION:
            problems.append("permission_mode must be bypassPermissions; a turn has nobody to "
                            "answer a permission prompt")
    elif harness == "codex":
        if knobs.get("approval_policy") != "never":
            problems.append("approval_policy must be never; a turn has nobody to approve")
    else:
        problems.append(f"harness {harness!r} is not one the runner drives")
    return problems


def _harness_library():
    try:
        from callva import harness_runner as lib
    except ImportError:
        raise _Refusal(5, "harness_library_missing",
                       "callva-harness-runner is not importable",
                       f"run {NAME} through its own script header, which pins it") from None
    return lib


def _resolve_profile(store, project_id: str, name: str):
    """(Profile, harness, origin) for a name, or raise _Refusal naming why not.

    A name resolves as tasks resolves it, among the harness profiles the store
    keeps: the project's active version, then the global one, then the
    library's shipped profiles; then the two this capability ships."""
    lib = _harness_library()
    try:
        found = lib.resolve_among(name, store.stored_profiles(lib, project_id),
                                  project=project_id)
        knobs, where = dict(found.spec), found.where
        origin = {"name": name, "layer": found.layer, "version": found.id}
    except lib.ProfileNotFound as exc:
        shipped = _shipped_profiles_dir() / f"{name}.toml"
        if not shipped.is_file():
            raise _Refusal(6, "profile_not_found", f"profile {name!r} is not found: {exc}; nor "
                           f"does {NAME} ship one") from None
        try:
            knobs = lib.ProfileFile(name, "shipped", str(shipped), shipped.read_text()).knobs()
        except Exception as exc:
            raise _Refusal(6, "profile_invalid", f"profile {name!r} at {shipped} is refused by "
                           f"the harness runner: {exc}") from None
        where = str(shipped)
        origin = {"name": name, "layer": "capability", "version": None, "path": where}
    except Exception as exc:
        raise _Refusal(6, "profile_invalid",
                       f"profile {name!r} is refused by the harness runner: {exc}") from None
    try:
        profile = lib.Profile.from_dict(knobs)
    except Exception as exc:
        raise _Refusal(6, "profile_invalid", f"{where}: {exc}") from None
    problems = _profile_fit(knobs)
    if problems:
        raise _Refusal(6, "profile_unfit", f"profile {name!r} ({where}) does not fit a room "
                       "turn: " + "; ".join(problems))
    origin.update(harness=knobs.get("harness"), model=knobs.get("model"))
    return profile, knobs.get("harness"), origin


def _agent_refusal(cid: str, reg: dict) -> tuple | None:
    """Why the service may not act for this agent in the project now, or None:
    the connection is declared, granted, and allows writes."""
    if cid in (reg.get("withheld") or {}):
        return ("refused", f"connection {cid!r} is not granted in this project")
    entry = (reg.get("connections") or {}).get(cid)
    if entry is None:
        return ("refused", f"connection {cid!r} is not declared in this project")
    if read_only_switch():
        return ("refused", f"{READ_ONLY_ENV} is set, so no answer may be posted")
    if not entry.get("allow_write", WRITE_DEFAULT):
        return ("refused", f"connection {cid!r} has no write grant, and the service answers by "
                           "posting; ask the user to grant allow_write")
    return None


def _plan_here(root: Path, expected_id: str | None) -> dict:
    """Everything the process needs to serve this project, asked inside it."""
    if _project_root() is None or _project_root().resolve() != root.resolve():
        raise _Refusal(6, "not_a_project_root", f"{root} does not resolve as a project root")
    project, slug = _identity_here()
    if expected_id is not None and project != expected_id:
        raise _Refusal(6, "project_id_changed",
                       f"the project now declares id {project} and joined as {expected_id}",
                       f"`{NAME} service leave` and `{NAME} service join` there take the new one")
    if _machine_state() == "quarantined":
        raise _Refusal(4, "quarantined", f"{NAME} is quarantined on this machine")
    if not _project_enabled_explicitly():
        raise _Refusal(4, "project_enable_required",
                       f"{NAME} is not enabled explicitly for this project",
                       f"`capabilities enable {NAME} --project`")
    engine = _engine()
    try:
        setting = engine.resolve_store(root)
    except engine.StoreUnavailable as exc:
        raise _Refusal(6, exc.slug, exc.message, exc.hint) from None
    declared = (_inventory_connections().get("connections") or {})
    if not declared:
        raise _Refusal(6, "no_agent_served", "no agent can be served: this project declares no "
                       f"{NAME} connection", f"`{NAME} register NAME` declares one")
    reg = _connections_composed()
    agents: dict = {}
    skipped: dict = {}
    for cid in sorted(declared):
        refusal = _agent_refusal(cid, reg)
        if refusal:
            skipped[cid] = refusal[1]
            continue
        cfg, problem = _build_cfg(cid, reg["connections"][cid])
        if problem:
            skipped[cid] = problem["message"]
            continue
        token_print = engine.fingerprint_of(cfg["token"].encode())
        agents[cid] = {"connection": cid, "homeserver": cfg["homeserver"],
                       "user_id": cfg["user_id"], "token": cfg["token"],
                       "token_fingerprint": token_print,
                       "identity": (cfg["homeserver"], cfg["user_id"], token_print)}
    if not agents:
        detail = "; ".join(f"{c}: {r}" for c, r in sorted(skipped.items()))
        raise _Refusal(4, "no_agent_served", f"no agent can be served: {detail}")
    if setting.url is None:
        name = f"{setting.host}:{setting.port}/{setting.database}"
    else:
        from urllib.parse import urlparse
        found = urlparse(setting.url)
        name = f"{found.hostname}:{found.port or 5432}/{found.path.lstrip('/')}"

    return {"project_id": project, "slug": slug, "setting": setting, "store_name": name,
            "fingerprint": _project_fingerprint(root), "agents": agents, "skipped": skipped}


class _Host:
    """What the engine asks of this executable, every project question answered
    inside that project's own resolution, one at a time."""

    def __init__(self, mode: str, entry: dict | None = None):
        self.mode = mode
        self.entry = entry
        self.lock = threading.RLock()

    def node(self) -> str:
        # The contract names the node, so a grant naming a node and the node
        # this service records its sessions and leases under are one name.
        return node_name()

    def tag(self) -> str:
        return (self.entry or {}).get("slug") or "machine"

    def entries(self) -> dict:
        if self.mode == "project":
            return {self.entry["id"]: self.entry}
        with self.lock:
            listed = _read_projects()
        return {pid: {**entry, "id": pid} for pid, entry in listed.items()}

    def list_witness(self):
        if self.mode == "project":
            return "project"
        try:
            seen = os.stat(_machine_projects_path())
        except OSError:
            return None
        return (seen.st_mtime_ns, seen.st_size, seen.st_ino)

    def machine_settings(self) -> dict:
        return _load_machine_settings()

    def fingerprint(self) -> str:
        return _machine_fingerprint()

    def admit(self, project_id: str, entry: dict):
        root = Path(entry["root"])
        if not root.is_dir():
            return None, ("error", f"the project folder {root} is gone")
        with self.lock:
            try:
                moved = _ask_in_project(root, lambda: _import_agents_map(root, apply=True))
                plan = _ask_in_project(root, lambda: _plan_here(root, project_id))
            except _Refusal as exc:
                return None, ("refused", f"{exc.code}: {exc.message}")
            except Exception as exc:
                return None, ("error", f"{type(exc).__name__}: {exc}")
        if moved and moved.get("moved"):
            self.log(entry, "moved service/settings.json into workers: " + "; ".join(
                f"{cid} bound to worker {w}" for cid, w in sorted(moved["moved"].items()))
                + (f"; dropped {', '.join(moved['dropped'])}" if moved.get("dropped") else ""))
        for cid, why in plan["skipped"].items():
            self.log(entry, f"{cid}: not served: {why}")
        return plan, None

    def log(self, entry: dict, message: str) -> None:
        state = _machine_state_dir() if self.mode == "machine" else _project_state_dir(entry["slug"])
        with contextlib.suppress(OSError):
            with (state / "daemon.log").open("a") as handle:
                handle.write(f"{_utc_now()} {NAME} service [{entry.get('slug')}]: {message}\n")

    def check(self, entry: dict, cid: str):
        root = Path(entry["root"])
        if not root.is_dir():
            return ("error", f"the project folder {root} is gone")

        def question():
            if _machine_state() == "quarantined":
                return ("refused", f"{NAME} is quarantined on this machine")
            if not _project_enabled_explicitly():
                return ("refused", f"{NAME} is not enabled explicitly for this project")
            if self.mode == "machine":
                project, _slug = _identity_here()
                if project not in _read_projects():
                    return ("refused", "the project left the machine service")
            return _agent_refusal(cid, _connections_composed())

        with self.lock:
            try:
                return _ask_in_project(root, question)
            except _Refusal as exc:
                return ("refused", f"{exc.code}: {exc.message}")
            except Exception as exc:
                return ("error", f"{type(exc).__name__}: {exc}")

    def binding(self, entry: dict, cid: str) -> dict:
        """What the agent's connection binds, read inside the project now: its
        worker, its rooms' workers and its supervisor."""
        root = Path(entry["root"])

        def question():
            found = (_connections_composed().get("connections") or {}).get(cid) or {}
            return {key: found.get(key) for key in BINDING_KEYS}

        with self.lock:
            return _ask_in_project(root, question)

    def profile(self, entry: dict, store, name: str):
        return _resolve_profile(store, entry["id"], name)

    def matrix(self, homeserver: str, token: str, timeout: float = TIMEOUT) -> Matrix:
        return Matrix(homeserver, token, timeout)

    def runner(self):
        from callva import harness_runner
        return harness_runner

    def template(self, entry: dict) -> str:
        return _template_path().read_text()

    def turn_env(self, entry: dict) -> dict:
        with self.lock:
            return {k: v for k, v in os.environ.items() if k not in _PROJECT_POINTERS}


# ── workers ──────────────────────────────────────────────────────────────────


def _turn_gate(action: str) -> None:
    """A turn is fenced by the worker that admitted it, so nothing working
    inside a turn the service started changes a worker or what is bound."""
    if os.environ.get(_engine().TURN_ENV):
        _die(4, "policy", f"`workers {action}` is refused inside a turn the {NAME} service "
             "started: a turn is fenced by its worker, and a fence the fenced can rewrite is "
             "none", "a person changes workers and bindings, outside any turn")


def _open_store(root: Path):
    engine = _engine()
    try:
        return engine.Store(engine.resolve_store(root)).open()
    except engine.StoreUnavailable as exc:
        raise _Refusal(5 if exc.slug in ("store_unreachable", "store_busy") else 6,
                       exc.slug, exc.message, exc.hint) from None


def _worker_name_for(cid: str) -> str:
    """The worker an agents-map entry is moved into: named after its connection."""
    name = re.sub(r"[^a-z0-9_-]+", "-", cid.lower()).strip("-_")[:64] or "agent"
    return f"{name}-agent" if name == _engine().DEFAULT_WORKER else name


def _write_binding(cid: str, changes: dict) -> tuple[dict, str]:
    """Write binding keys onto a connection this project declares: a value of
    None takes the key off. Raises _Refusal."""
    adapter = _records()
    try:
        ident = adapter.resolve(NAME, "connection").get(cid)
        if ident is None or not ident.get("value"):
            raise _Refusal(3, "unknown_connection", f"no connection {cid!r} is declared here")
        if ident.get("scope") != "project":
            raise _Refusal(6, "connection_not_in_project",
                           f"connection {cid!r} is declared at the {ident.get('scope')} scope, "
                           "and a binding is this project's",
                           "declare the agent's connection in this project to bind its workers")
        value = dict(ident["value"])
        for key, wanted in changes.items():
            if wanted is None or wanted == {}:
                value.pop(key, None)
            else:
                value[key] = wanted
        adapter.set(NAME, "connection", cid, value, scope="project")
        return value, adapter.scope_source(NAME, "connection", "project")
    except StoreError as e:
        raise _Refusal(4 if e.slug == "read_only_switch" else 6, e.slug, e.message,
                       e.hint) from None


def _import_agents_map(root: Path, apply: bool) -> dict | None:
    """Move an earlier release's service/settings.json agents map into workers:
    one worker per listed connection, named after it, with the profile,
    turn_timeout and history the map gave it, admitting every sender as the
    service did, bound on the connection; then the map is taken out of the
    file, and the file removed when nothing else is left in it. A connection
    the project no longer declares is dropped. A connection that already binds
    a worker keeps it. None when there is no map."""
    agents = _legacy_agents(root)
    if agents is None:
        return None
    engine = _engine()
    path = _settings_path(root)
    try:
        identities = _records().resolve(NAME, "connection")
    except StoreError as e:
        raise _Refusal(6, e.slug, e.message, e.hint) from None
    moves: dict = {}
    dropped: list = []
    for cid, conf in sorted(agents.items()):
        ident = identities.get(cid)
        if ident is None or not ident.get("value"):
            dropped.append(cid)
            continue
        if ident["value"].get("worker"):
            moves[cid] = (ident["value"]["worker"], None)
            continue
        name = _worker_name_for(cid)
        spec = {"description": "Moved from service/settings.json: admits every sender, as the "
                               "service did before workers.",
                "profile": conf["profile"], "history": conf["history"],
                "accepts_from": ["*"], "limits": {"turn_timeout": conf["turn_timeout"]}}
        try:
            engine.read_worker(name, spec, "", f"{path}: agents.{cid}")
        except engine.WorkerInvalid as exc:
            raise _Refusal(6, "settings_invalid", str(exc),
                           f"repair agents.{cid} in {path}, or remove the file and bind a "
                           f"worker with `{NAME} workers bind`") from None
        moves[cid] = (name, spec)
    answer = {"settings": str(path), "moved": {cid: name for cid, (name, _s) in moves.items()},
              "dropped": dropped, "applied": bool(apply)}
    if not apply:
        return answer
    if read_only_switch():
        raise _Refusal(4, "read_only_switch", f"moving {path} into workers is refused: "
                       f"{READ_ONLY_ENV} is set")
    project, _slug = _identity_here()
    store = _open_store(root)
    try:
        for cid, (name, spec) in moves.items():
            if spec is None:
                continue
            if store.worker(project, name) is None:
                store.save_worker(project, name, spec, "", base=None, by=_actor())
            _write_binding(cid, {"worker": name})
    finally:
        store.close()
    raw = json.loads(path.read_text())
    raw.pop("agents", None)
    if set(raw) <= {"version"}:
        path.unlink()
        answer["removed"] = str(path)
    else:
        path.write_text(json.dumps(raw, indent=2) + "\n")
    return answer


def _version_answer(row: dict, whole: bool = True) -> dict:
    answer = {"worker": row["name"], "source": "store", "version": row["id"],
              "active": row["active"], "created_at": row["created_at"],
              "created_by": row["created_by"]}
    if whole:
        answer.update(spec=row["spec"], body=row["body"],
                      text=_engine().worker_text(row["spec"], row["body"]))
    return answer


def _shipped_default() -> dict:
    engine = _engine()
    path = engine.DEFAULT_WORKER_PATH
    text = path.read_text()
    spec, body = engine.split_document(text, str(path))
    return {"worker": engine.DEFAULT_WORKER, "source": "shipped", "path": str(path),
            "spec": spec, "body": body, "text": text}


def _read_input(source: str) -> str:
    if source == "-":
        return sys.stdin.read()
    try:
        return Path(source).read_text()
    except OSError as exc:
        _die(6, "input", f"{source} could not be read: {exc}")


def _bindings() -> dict:
    conns = _inventory_connections().get("connections") or {}
    return {cid: {"user_id": e.get("user_id"), "worker": e.get("worker"),
                  "rooms": e.get("rooms") or {}, "supervisor": e.get("supervisor"),
                  "granted": bool(e.get("granted")), "allow_write": bool(e.get("allow_write"))}
            for cid, e in sorted(conns.items())}


def cmd_workers(args, wanted: str | None) -> None:
    engine = _engine()
    action = args.action
    root = _project_root()
    if root is None:
        _die(6, "input", "workers belong to a project, and this is not one",
             "run this where the project whose agents they answer is")
    if action in ("save", "remove", "bind", "unbind", "import") or \
            (action == "supervisor" and (args.user_id or args.clear)):
        if action != "import" or args.apply:
            _turn_gate(action)
            _read_only_gate(f"`{NAME} workers {action}`")
    name = getattr(args, "name", None)
    if name is not None and not engine.WORKER_NAME.fullmatch(name):
        _die(6, "input", f"{name!r} is not a worker name: lowercase letters, digits, - and _, "
             "starting with a letter or digit")
    try:
        if action == "import":
            found = _import_agents_map(root, bool(args.apply))
            _emit(found or {"settings": str(_settings_path(root)), "moved": {},
                            "reason": "there is no agents map to move"})
            return
        if action in ("bind", "unbind", "supervisor"):
            _emit(_cmd_binding(args, wanted))
            return
        project, _slug = _identity_here()
        if action == "show" and name == engine.DEFAULT_WORKER and not args.version:
            _emit(_shipped_default())
            return
        if action in ("save", "remove") and name == engine.DEFAULT_WORKER:
            _die(6, "input", f"`{engine.DEFAULT_WORKER}` is the shipped worker that answers "
                 "senders no worker admits; it is not saved or removed",
                 "save the worker under another name and bind it")
        store = _open_store(root)
    except _Refusal as exc:
        _refused(exc)
    try:
        if action == "list":
            rows = [{"worker": r["name"], "source": "store", "version": r["id"],
                     "enabled": r["spec"].get("enabled", True),
                     "description": str(r["spec"].get("description") or "").strip(),
                     "updated_at": r["created_at"], "updated_by": r["created_by"]}
                    for r in store.workers(project)]
            shipped = _shipped_default()
            rows.append({"worker": shipped["worker"], "source": "shipped",
                         "path": shipped["path"], "enabled": True,
                         "description": str(shipped["spec"].get("description") or "").strip()})
            _emit({"workers": rows, "bindings": _bindings()})
        elif action == "show":
            row = store.worker(project, name, args.version)
            if row is None:
                _die(3, "not_found", f"no worker named {name!r}"
                     + (f" at version {args.version}" if args.version else "") + " here",
                     f"`{NAME} workers list` shows this project's workers")
            _emit(_version_answer(row))
        elif action == "history":
            rows = store.worker_history(project, name)
            if not rows:
                _die(3, "not_found", f"no worker named {name!r} was ever saved here",
                     f"`{NAME} workers list` shows this project's workers")
            _emit({"worker": name, "versions": [_version_answer(r, whole=False) for r in rows]})
        elif action == "save":
            text = _read_input(args.file)
            try:
                spec, body = engine.split_document(text, args.file)
                worker = engine.read_worker(name, spec, body, f"worker {name!r}")
            except engine.WorkerInvalid as exc:
                _die(6, "worker_invalid", str(exc), f"`{NAME} help` WORKERS states the shape")
            try:
                row, created = store.save_worker(project, name, spec, body, base=args.base,
                                                 by=_actor())
            except engine.WorkerConflict as exc:
                _die(6, "conflict", str(exc),
                     f"read it again with `{NAME} workers show {name}` and save over that")
            answer = {**_version_answer(row, whole=False), "created": created}
            if worker["enabled"]:
                try:
                    _resolve_profile(store, project, worker["profile"])
                except _Refusal as exc:
                    answer["warning"] = exc.message
            _emit(answer)
        elif action == "remove":
            try:
                gone = store.remove_worker(project, name, base=args.base)
            except engine.WorkerConflict as exc:
                _die(6, "conflict", str(exc), f"`{NAME} workers show {name}` reads it again")
            if gone is None:
                _die(3, "not_found", f"worker {name!r} has no active version",
                     f"`{NAME} workers list` shows this project's workers")
            _emit({"worker": name, "removed": gone})
    finally:
        store.close()


def _cmd_binding(args, wanted: str | None) -> dict:
    """bind, unbind and supervisor: the keys the selected agent's connection
    carries. Raises _Refusal."""
    engine = _engine()
    reg, _ = _connections_registry()
    cid, entry = _select_connection(reg, wanted)
    entry = entry or {}
    room_id = None
    if getattr(args, "room", None):
        room_id = args.room
        if not room_id.startswith("!"):
            cfg = _cfg(cid, "workers")
            with _matrix(cfg) as m:
                room_id = _resolve_room(m, cfg, args.room)
    if args.action == "supervisor":
        if not args.user_id and not args.clear:
            return {"connection": cid, "user_id": entry.get("user_id"),
                    "supervisor": entry.get("supervisor")}
        if args.user_id and args.clear:
            raise _Refusal(6, "input", "supervisor takes a user id or --clear, not both")
        if args.user_id and not USER_RE.fullmatch(args.user_id):
            raise _Refusal(6, "input", f"{args.user_id!r} is not a Matrix user id (@name:server)")
        value, where = _write_binding(cid, {"supervisor": None if args.clear else args.user_id})
        return {"connection": cid, "supervisor": value.get("supervisor"), "registry": where}
    rooms = dict(entry.get("rooms") or {}) if isinstance(entry.get("rooms"), dict) else {}
    if args.action == "bind":
        if args.name == engine.DEFAULT_WORKER:
            raise _Refusal(6, "input", f"`{engine.DEFAULT_WORKER}` answers every agent no worker "
                           "admits a sender for, and is never bound")
        project, _slug = _identity_here()
        store = _open_store(_project_root())
        try:
            if store.worker(project, args.name) is None:
                raise _Refusal(3, "not_found", f"worker {args.name!r} has no active version",
                               f"save it first with `{NAME} workers save {args.name} <file>`")
        finally:
            store.close()
        if room_id:
            rooms[room_id] = args.name
            changes = {"rooms": rooms}
        else:
            changes = {"worker": args.name}
    else:
        if room_id:
            if rooms.pop(room_id, None) is None:
                return {"connection": cid, "room_id": room_id, "unbound": False,
                        "reason": "no worker is bound to this agent in that room"}
            changes = {"rooms": rooms}
        else:
            if not entry.get("worker"):
                return {"connection": cid, "unbound": False,
                        "reason": "no worker is bound to this agent"}
            changes = {"worker": None}
    value, where = _write_binding(cid, changes)
    return {"connection": cid, "user_id": entry.get("user_id"), "worker": value.get("worker"),
            "rooms": value.get("rooms") or {}, "registry": where,
            "next": "the service reads it at the agent's next turn"}



# ── the service verbs ────────────────────────────────────────────────────────


def _store_refusal(exc) -> NoReturn:
    if exc.slug == "store_not_configured":
        _die(6, "store_not_configured",
             f"the {NAME} service keeps its sync positions, wakes, sessions and leases in a "
             "store, and no store is configured",
             "set AGENTKIT_DB_URL (or AGENTKIT_DB_HOST, AGENTKIT_DB_NAME, AGENTKIT_DB_USER, "
             "AGENTKIT_DB_PASSWORD) in the project's .env.local or the environment, or run "
             "`capabilities store set`")
    _die(5 if exc.slug in ("store_unreachable", "store_busy") else 6, exc.slug, exc.message,
         exc.hint)


def _project_entry_here() -> dict:
    root = _project_root()
    try:
        project, slug = _identity_here()
    except _Refusal as exc:
        _refused(exc)
    return {"id": project, "root": str(root), "slug": slug}


def _pid_alive(pid: int | None) -> bool:
    if not pid or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def _read_pid(state: Path) -> int | None:
    try:
        return int((state / "daemon.pid").read_text().strip())
    except (OSError, ValueError):
        return None


def _read_status(state: Path) -> dict:
    try:
        found = json.loads((state / "daemon.json").read_text())
    except (OSError, ValueError):
        return {}
    return found if isinstance(found, dict) else {}


def _serving_state(entry: dict) -> tuple[Path, bool]:
    """The state root of the process that serves this project: the machine
    service's when the project joined it, else the project's own."""
    joined = _joined_here()
    return (_machine_state_dir(), True) if joined else (_project_state_dir(entry["slug"]), False)


def cmd_service_init() -> dict:
    _die(6, "input", "a project's service takes no settings file: it serves every connection "
         "the project declares and grants writes, each answered by the worker bound to it",
         f"`{NAME} workers save` and `{NAME} workers bind` give an agent its worker; "
         f"`{NAME} service init --machine` writes the machine settings")


def cmd_service_init_machine(force: bool) -> dict:
    path = _machine_config_path()
    if path.exists() and not force:
        _die(6, "settings_exist", f"{path} exists", f"`{NAME} service init --machine --force`")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps({"version": 1, "max_turns": DEFAULT_MAX_TURNS}, indent=2) + "\n")
    return {"written": str(path)}


def cmd_service_join() -> dict:
    root = _require_project_enabled_for_service()
    try:
        project, slug = _identity_here()
    except _Refusal as exc:
        _refused(exc)
    with _list_lock():
        listed = _listed()
        if project in listed:
            return {"joined": False, "reason": "already on the machine service's list",
                    "project": {"id": project, "slug": slug}, "list": str(_machine_projects_path())}
        taken = [p for p, e in listed.items() if e.get("slug") == slug]
        if taken:
            _die(6, "slug_taken", f"project {taken[0]} at {listed[taken[0]]['root']} is joined "
                 f"with slug {slug!r}", "give one of them another slug, or leave the other with "
                 f"`{NAME} service leave --machine --project {taken[0]}`")
        listed[project] = {"root": str(root), "slug": slug, "joined_at": _utc_now(),
                           "joined_by": _actor()}
        _write_projects(listed)
    out = {"joined": True, "project": {"id": project, "slug": slug, "root": str(root)},
           "list": str(_machine_projects_path())}
    pid = _read_pid(_project_state_dir(slug))
    if _pid_alive(pid):
        out["next"] = (f"a project-mode process, pid {pid}, still serves this project; "
                       f"`{NAME} service stop` here hands its agents to the machine service")
    return out


def cmd_service_leave(machine: bool, named: str | None) -> dict:
    if machine:
        if not named:
            _die(6, "input", "leave --machine names the project it takes off the list",
                 f"`{NAME} service leave --machine --project <id-or-slug>`")
        here = None
    else:
        if named:
            _die(6, "input", "--project goes with --machine")
        try:
            here, _slug = _identity_here()
        except _Refusal as exc:
            _refused(exc)
        named = here
    with _list_lock():
        listed = _listed()
        found = [p for p, e in listed.items()
                 if p == named or (here is None and e.get("slug") == named)]
        if not found:
            return {"left": False, "reason": "not on the machine service's list",
                    "project": named, "list": str(_machine_projects_path())}
        entry = listed.pop(found[0])
        _write_projects(listed)
    return {"left": True, "project": {"id": found[0], "slug": entry.get("slug"),
                                      "root": entry.get("root")},
            "list": str(_machine_projects_path())}


def cmd_service_run(machine: bool) -> None:
    engine = _engine()
    if machine:
        try:
            _load_machine_settings()
        except _Refusal as exc:
            _refused(exc)
        try:
            engine.resolve_store(None)
        except engine.StoreUnavailable as exc:
            _store_refusal(exc)
        host = _Host("machine")
        state = _machine_state_dir()
    else:
        root = _project_root()
        if _joined_here():
            _die(4, "joined_to_machine_service",
                 f"this project is joined to the machine {NAME} service, which serves it",
                 f"`{NAME} service leave` takes it back to project mode first")
        entry = _project_entry_here()
        try:
            _load_machine_settings()
        except _Refusal as exc:
            _refused(exc)
        try:
            engine.resolve_store(root)
        except engine.StoreUnavailable as exc:
            _store_refusal(exc)
        host = _Host("project", entry)
        state = _project_state_dir(entry["slug"])
    runner = engine.Engine(host, mode="machine" if machine else "project", state_dir=state)
    try:
        runner.run()
    except RuntimeError as exc:
        if str(exc) == "busy":
            _die(8, "service_running", f"another {NAME} service process holds {state}",
                 f"`{NAME} service status{' --machine' if machine else ''}` names it")
        raise


def _service_target(machine: bool) -> tuple[Path, dict | None, bool]:
    """(state root, this project's entry or None, whether the machine serves it)."""
    if machine:
        return _machine_state_dir(), None, True
    entry = _project_entry_here()
    state, by_machine = _serving_state(entry)
    return state, entry, by_machine


def cmd_service_stop(machine: bool, timeout: float) -> dict:
    state, entry, by_machine = _service_target(machine)
    if by_machine and not machine:
        _die(4, "joined_to_machine_service", "the machine service serves this project",
             f"`{NAME} service leave` stops it serving this project; `{NAME} service stop "
             "--machine` stops the machine process")
    pid = _read_pid(state)
    if not _pid_alive(pid):
        return {"stopped": False, "reason": "not running", "state_dir": str(state)}
    os.kill(pid, signal.SIGTERM)
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline and _pid_alive(pid):
        time.sleep(0.2)
    if _pid_alive(pid):
        _die(5, "stop_timeout", f"pid {pid} did not stop within {timeout:g}s",
             "a turn may still be ending; ask again, or wait")
    return {"stopped": True, "pid": pid}


def cmd_service_reload(machine: bool, timeout: float) -> dict:
    state, entry, by_machine = _service_target(machine)
    if machine:
        try:
            _load_machine_settings()
        except _Refusal as exc:
            _refused(exc)
        expected = _machine_fingerprint()
        read = lambda status: status.get("fingerprint")  # noqa: E731
        error = lambda status: status.get("reload_error")  # noqa: E731
    else:
        root = Path(entry["root"])
        try:
            _plan_here(root, None)
        except _Refusal as exc:
            _refused(exc)
        expected = _project_fingerprint(root)

        def row(status):
            return next((p for p in status.get("projects") or []
                         if p.get("project_id") == entry["id"]), {})
        read = lambda status: row(status).get("fingerprint")  # noqa: E731
        error = lambda status: row(status).get("reload_error")  # noqa: E731
    pid = _read_pid(state)
    if not _pid_alive(pid):
        _die(3, "not_running", f"no {NAME} service process serves this here",
             f"start it with `{NAME} service run{' --machine' if by_machine else ''}`")
    if read(_read_status(state)) == expected:
        return {"reloaded": False, "reason": "the running process already holds this declaration",
                "fingerprint": expected, "pid": pid}
    os.kill(pid, signal.SIGHUP)
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        status = _read_status(state)
        if read(status) == expected:
            return {"reloaded": True, "fingerprint": expected, "pid": pid}
        if error(status):
            _die(6, "reload_rejected", f"the running process kept its declaration: {error(status)}")
        time.sleep(0.3)
    _die(5, "reload_timeout", f"pid {pid} did not publish fingerprint {expected} within "
         f"{timeout:g}s", f"`{NAME} service logs` shows what it did")


def _status_view(machine: bool) -> dict:
    state, entry, by_machine = _service_target(machine)
    pid = _read_pid(state)
    running = _pid_alive(pid)
    status = _read_status(state) if running else {}
    if machine:
        try:
            listed, list_error = _read_projects(), None
        except _Refusal as exc:
            listed, list_error = {}, exc.message
        rows = {p.get("project_id"): p for p in status.get("projects") or []}
        projects = []
        for project, joined in sorted(listed.items(), key=lambda kv: kv[1].get("slug") or ""):
            row = {"project": joined.get("slug"), "project_id": project, "root": joined.get("root"),
                   "joined_at": joined.get("joined_at"), "joined_by": joined.get("joined_by"),
                   "present": Path(joined["root"]).is_dir()}
            seen = rows.get(project)
            row.update(seen or {"state": None, "reason": "the machine service is not running"
                                if not running else "not yet taken up"})
            projects.append(row)
        return {"mode": "machine", "running": running, "pid": pid if running else None,
                "state_dir": str(state), "fingerprint": status.get("fingerprint"),
                "current": (status.get("fingerprint") == _machine_fingerprint()) if running else None,
                "reload_error": status.get("reload_error"), "cap": status.get("cap"),
                "list": {"path": str(_machine_projects_path()), "joined": len(listed),
                         **({"error": list_error} if list_error else {})},
                "projects": projects}
    root = Path(entry["root"])
    row = next((p for p in status.get("projects") or []
                if p.get("project_id") == entry["id"]), None)
    return {"mode": "machine" if by_machine else "project", "joined": by_machine,
            "running": running, "pid": pid if running else None, "state_dir": str(state),
            "current": (row or {}).get("fingerprint") == _project_fingerprint(root)
            if running and row else None,
            "project": row or {"state": None, "reason": "no process serves this project"
                               if not running else "not yet taken up"}}


def cmd_service_logs(machine: bool, tail: int) -> dict:
    state, entry, by_machine = _service_target(machine)
    path = state / "daemon.log"
    try:
        lines = path.read_text().splitlines()
    except OSError:
        lines = []
    if entry is not None and by_machine:
        lines = [line for line in lines if f"[{entry['slug']}]" in line]
    return {"log": str(path), "lines": lines[-tail:] if tail > 0 else lines}


def cmd_service_pause(reason: str | None, resume: bool) -> dict:
    engine = _engine()
    root = _project_root()
    entry = _project_entry_here()
    try:
        store = engine.Store(engine.resolve_store(root)).open()
    except engine.StoreUnavailable as exc:
        _store_refusal(exc)
    try:
        if resume:
            was = store.resume(entry["id"])
            return {"resumed": was, "project": entry["slug"]}
        store.pause(entry["id"], _actor(), (reason or "").strip() or None)
        return {"paused": True, "project": entry["slug"], "pause": store.pause_of(entry["id"])}
    finally:
        store.close()


def _doctor_store(root: Path | None) -> dict:
    engine = _engine()
    try:
        setting = engine.resolve_store(root)
    except engine.StoreUnavailable as exc:
        return {"ok": False, "category": 6 if exc.slug != "store_unreachable" else 5,
                "code": exc.slug, "error": exc.message, "hint": exc.hint}
    from capabilities_contract import db
    conn = None
    try:
        conn = db.connect(application_name=NAME, setting=setting)
        found = db.status(conn, NAME, engine.LEDGER_STEPS, major=engine.LEDGER_MAJOR,
                          minor=engine.LEDGER_MINOR)
    except db.DbError as exc:
        return {"ok": False, "category": 5, "code": exc.slug, "error": exc.message,
                "setting": setting.report()}
    finally:
        if conn is not None:
            conn.close()
    return {"ok": True, "setting": setting.report(), "tables": found.state,
            "pending": found.pending}


def _doctor_workers(store, project: str, binding: dict) -> dict:
    """What one agent's bindings answer: each bound worker, whether it is there
    and on, and the profile it names. An agent with none is answered by the
    default worker alone, which is no fault."""
    engine = _engine()
    named = {"agent": binding.get("worker")}
    named.update({f"room {room}": worker for room, worker in (binding.get("rooms") or {}).items()})
    out: dict = {"ok": True, "supervisor": binding.get("supervisor")}
    if not any(named.values()):
        out["bound"] = None
        out["note"] = "no worker is bound: only the default worker answers this agent"
        return out
    rows = {}
    for where, name in named.items():
        if not name:
            continue
        row: dict = {"worker": name}
        if store is None:
            row["state"] = "unknown: the store is not reachable"
        else:
            found = store.worker(project, name)
            if found is None:
                row.update(state="missing", error=f"worker {name!r} has no active version")
                out["ok"] = False
            else:
                try:
                    worker = engine.read_worker(name, found["spec"], found["body"],
                                                f"worker {name!r}")
                    row.update(state="enabled" if worker["enabled"] else "off",
                               version=found["id"], profile=worker["profile"])
                    if worker["enabled"]:
                        try:
                            row["profile"] = _resolve_profile(store, project,
                                                              worker["profile"])[2]
                        except _Refusal as exc:
                            row["error"] = exc.message
                            out["ok"] = False
                except engine.WorkerInvalid as exc:
                    row.update(state="invalid", error=str(exc))
                    out["ok"] = False
        rows[where] = row
    out["bound"] = rows
    return out


def cmd_service_doctor(machine: bool) -> None:
    findings: dict = {}
    fail = 0

    def note(key: str, row: dict) -> None:
        nonlocal fail
        findings[key] = row
        if not row.get("ok") and not fail:
            fail = row.get("category") or 6
        row.pop("category", None)

    if machine:
        try:
            settings = _load_machine_settings()
            note("settings", {"ok": True, "path": str(_machine_config_path()), **settings})
        except _Refusal as exc:
            note("settings", {"ok": False, "category": 6, "code": exc.code, "error": exc.message})
        note("store", _doctor_store(None))
        view = _status_view(True)
        if not view["running"]:
            note("process", {"ok": False, "category": 7, "error": "the machine service is not running",
                             "hint": f"its supervisor runs `{NAME} service run --machine`"})
        elif not view["current"]:
            note("process", {"ok": False, "category": 7, "error": "the running process holds an "
                             "older declaration", "hint": f"`{NAME} service reload --machine`"})
        else:
            note("process", {"ok": True, "pid": view["pid"]})
        findings["projects"] = view["projects"]
    else:
        root = _project_root()
        try:
            plan = _plan_here(root, None)
            note("agents", {"ok": True, "served": sorted(plan["agents"]),
                            "skipped": plan["skipped"]})
        except _Refusal as exc:
            plan = None
            note("agents", {"ok": False, "category": exc.exit_code, "code": exc.code,
                            "error": exc.message, **({"hint": exc.hint} if exc.hint else {})})
        try:
            legacy = _legacy_agents(root)
        except _Refusal as exc:
            legacy = None
            note("settings", {"ok": False, "category": exc.exit_code, "code": exc.code,
                              "error": exc.message})
        if legacy is not None:
            findings["settings"] = {
                "ok": True, "path": str(_settings_path(root)), "agents_map": sorted(legacy),
                "warning": "an earlier release's agents map; the service moves it into workers "
                           f"when it takes the project up, or `{NAME} workers import --apply` "
                           "moves it now"}
        store_row = _doctor_store(root)
        note("store", store_row)
        if plan:
            store = None
            if store_row.get("ok"):
                with contextlib.suppress(_Refusal):
                    store = _open_store(root)
            try:
                bindings = _bindings()
                for cid, agent in plan["agents"].items():
                    row = _check_connection({"homeserver": agent["homeserver"],
                                             "token": agent["token"],
                                             "user_id": agent["user_id"], "allow_write": True})
                    row["workers"] = _doctor_workers(store, plan["project_id"],
                                                     bindings.get(cid) or {})
                    if not row["workers"].get("ok", True) and row.get("ok"):
                        row.update(ok=False, category=6)
                    note(f"agent:{cid}", row)
            finally:
                if store is not None:
                    store.close()
        view = _status_view(False)
        if not view["running"]:
            note("process", {"ok": False, "category": 7, "error": "no process serves this project",
                             "hint": f"`{NAME} service run`, or `{NAME} service join` with the "
                                     "machine service running"})
        elif view["current"] is False:
            note("process", {"ok": False, "category": 7, "error": "the running process holds an "
                             "older declaration of this project",
                             "hint": f"`{NAME} service reload`"})
        else:
            note("process", {"ok": True, "pid": view["pid"], "mode": view["mode"],
                             "state": (view["project"] or {}).get("state")})
    _emit({"ok": fail == 0, **findings})
    if fail:
        sys.exit(fail)


# ── inventory ────────────────────────────────────────────────────────────────


def _inventory(_network: bool) -> dict:
    """Local only: the agents this project declares, which the service serves,
    and the service as its files on this machine say."""
    conns = (_inventory_connections().get("connections") or {})
    root = _project_root()
    served = sorted(cid for cid, e in conns.items() if e.get("granted") and e.get("allow_write"))
    items = []
    for cid, entry in sorted(conns.items()):
        items.append({"group": "agents", "name": cid, "state": "granted" if entry.get("granted")
                      else "withheld", "detail": entry.get("user_id"),
                      "attributes": [{"label": "homeserver", "value": entry.get("homeserver")},
                                     {"label": "writes", "value": bool(entry.get("allow_write"))},
                                     {"label": "served", "value": cid in served},
                                     {"label": "worker", "value": entry.get("worker")}]})
    service: dict = {"state": "stopped"}
    try:
        identity = json.loads((_project_capabilities_dir(root) / "project.json").read_text()) \
            if root is not None else {}
    except (OSError, ValueError):
        identity = {}
    slug = identity.get("slug")
    if slug:
        joined = None
        with contextlib.suppress(_Refusal):
            joined = _read_projects().get(str(identity.get("id")))
        state = _machine_state_dir() if joined else _project_state_dir(slug)
        pid = _read_pid(state)
        if _pid_alive(pid):
            service = {"state": "running", "detail": f"pid {pid}"
                       + (" (machine service)" if joined else "")}
    if root is not None:
        service["ok"] = True
    return {"metrics": [{"label": "agents", "value": len(conns)},
                        {"label": "served", "value": len(served)}],
            "items": items, "service": service}


# ── the command line ─────────────────────────────────────────────────────────


class _Parser(argparse.ArgumentParser):
    """Usage errors leave through the envelope at exit 6."""

    def __init__(self, *args, **kwargs):
        kwargs.setdefault("allow_abbrev", False)
        kwargs.setdefault("add_help", False)
        super().__init__(*args, **kwargs)

    def error(self, message: str) -> NoReturn:
        _die(6, "invalid_arguments", f"{self.prog}: {message}", f"run `{NAME} help`")


def _limit(value: str) -> int:
    try:
        n = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError(f"{value!r} is not a whole number")
    if not 1 <= n <= 100:
        raise argparse.ArgumentTypeError(f"{value!r} is not between 1 and 100")
    return n


def _parser() -> _Parser:
    parser = _Parser(prog=NAME)
    sub = parser.add_subparsers(dest="cmd", required=True, parser_class=_Parser)
    sub.add_parser("help").add_argument("topic", nargs="*")
    sub.add_parser("doctor")
    register = sub.add_parser("register")
    register.add_argument("name")
    register.add_argument("--homeserver")
    register.add_argument("--as", dest="as_id")
    register.add_argument("--default", action="store_true")
    login = sub.add_parser("login")
    login.add_argument("user_id")
    login.add_argument("--homeserver")
    login.add_argument("--as", dest="as_id")
    login_scope = login.add_mutually_exclusive_group()
    login_scope.add_argument("--global", dest="scope", action="store_const", const="global")
    login_scope.add_argument("--project", dest="scope", action="store_const", const="project")
    login.add_argument("--default", action="store_true")
    sub.add_parser("rooms")
    sub.add_parser("watch").add_argument("--room", action="append")
    sub.add_parser("sessions").add_argument("--room")
    sub.add_parser("turn").add_argument("event")
    read = sub.add_parser("read")
    read.add_argument("room")
    read.add_argument("--limit", type=_limit, default=20)
    opened = sub.add_parser("open")
    opened.add_argument("name")
    opened.add_argument("--invite", action="append", required=True)
    opened.add_argument("--topic")
    invite = sub.add_parser("invite")
    invite.add_argument("room")
    invite.add_argument("who")
    for verb in ("join", "leave", "mark", "unmark"):
        sub.add_parser(verb).add_argument("room")
    post = sub.add_parser("post")
    post.add_argument("room")
    post.add_argument("text")
    post.add_argument("--thread")
    post.add_argument("--reply-to", dest="reply_to")
    post.add_argument("--data")
    post.add_argument("--file")
    post.add_argument("--txn-id", dest="txn_id")
    workers = sub.add_parser("workers")
    wsub = workers.add_subparsers(dest="action", required=True, parser_class=_Parser)
    wsub.add_parser("list")
    shown = wsub.add_parser("show")
    shown.add_argument("name")
    shown.add_argument("--version")
    wsub.add_parser("history").add_argument("name")
    saved = wsub.add_parser("save")
    saved.add_argument("name")
    saved.add_argument("file")
    saved.add_argument("--base")
    removed = wsub.add_parser("remove")
    removed.add_argument("name")
    removed.add_argument("--base")
    bind = wsub.add_parser("bind")
    bind.add_argument("name")
    bind.add_argument("--room")
    wsub.add_parser("unbind").add_argument("--room")
    supervisor = wsub.add_parser("supervisor")
    supervisor.add_argument("user_id", nargs="?")
    supervisor.add_argument("--clear", action="store_true")
    wsub.add_parser("import").add_argument("--apply", action="store_true")
    service = sub.add_parser("service")
    ssub = service.add_subparsers(dest="action", required=True, parser_class=_Parser)
    init = ssub.add_parser("init")
    init.add_argument("--force", action="store_true")
    init.add_argument("--machine", action="store_true")
    for verb in ("run", "status", "doctor"):
        ssub.add_parser(verb).add_argument("--machine", action="store_true")
    for verb in ("stop", "reload"):
        one = ssub.add_parser(verb)
        one.add_argument("--machine", action="store_true")
        one.add_argument("--timeout", type=float, default=30.0)
    logs = ssub.add_parser("logs")
    logs.add_argument("--machine", action="store_true")
    logs.add_argument("--tail", type=int, default=100)
    ssub.add_parser("join")
    leave = ssub.add_parser("leave")
    leave.add_argument("--machine", action="store_true")
    leave.add_argument("--project")
    pause = ssub.add_parser("pause")
    pause.add_argument("--reason")
    ssub.add_parser("resume")
    return parser


def _manifest() -> dict:
    return {"name": NAME, "summary": SUMMARY,
            "credentials": {"scope": SCOPE, "keys": CRED_KEYS},
            "docs": {"base": DOCS_BASE, "topics": [entry["topic"] for entry in _guide_menu()]},
            "state": STATE, "inventory": _inventory_declaration(), "post_install": POST_INSTALL,
            "tables": _tables_declared(), "service": SERVICE}


def _service(args) -> None:
    action = args.action
    machine = bool(getattr(args, "machine", False))
    if action == "init":
        _emit(cmd_service_init_machine(args.force) if machine else cmd_service_init())
    elif action == "join":
        _emit(cmd_service_join())
    elif action == "leave":
        _emit(cmd_service_leave(machine, args.project))
    elif action == "run":
        cmd_service_run(machine)
    elif action == "stop":
        _emit(cmd_service_stop(machine, args.timeout))
    elif action == "reload":
        _emit(cmd_service_reload(machine, args.timeout))
    elif action == "status":
        _emit(_status_view(machine))
    elif action == "logs":
        _emit(cmd_service_logs(machine, args.tail))
    elif action == "doctor":
        cmd_service_doctor(machine)
    elif action in ("pause", "resume"):
        _emit(cmd_service_pause(getattr(args, "reason", None), action == "resume"))


def main() -> None:
    _gate()
    argv = sys.argv[1:]
    if argv[:1] == ["manifest"]:
        _emit(_manifest())
        return
    _contract(argv)
    wanted = None
    cleaned: list[str] = []
    i = 0
    while i < len(argv):
        if argv[i] == "--connection" and i + 1 < len(argv):
            wanted = argv[i + 1]
            i += 2
            continue
        if argv[i].startswith("--connection="):
            wanted = argv[i].split("=", 1)[1]
            i += 1
            continue
        cleaned.append(argv[i])
        i += 1
    args = _parser().parse_args(cleaned)
    cmd = args.cmd
    if cmd == "help":
        _cmd_help()
        return
    if cmd == "doctor":
        cmd_doctor(wanted)
        return
    if cmd == "register":
        _emit(cmd_register(args.name, args.homeserver, args.as_id, args.default))
        return
    if cmd == "login":
        _emit(cmd_login(args.user_id, args.homeserver, args.as_id, args.scope or "project",
                        args.default))
        return
    if cmd == "sessions":
        _emit(cmd_sessions(wanted, args.room))
        return
    if cmd == "turn":
        found = cmd_turn(wanted, args.event)
        _emit("null" if found is None else found)
        return
    if cmd == "service":
        _service(args)
        return
    if cmd == "workers":
        cmd_workers(args, wanted)
        return
    cfg = _cfg(wanted, cmd)
    if cmd == "rooms":
        _emit(cmd_rooms(cfg))
    elif cmd == "read":
        _emit(cmd_read(cfg, args.room, args.limit))
    elif cmd == "watch":
        cmd_watch(cfg, args.room)
    elif cmd == "open":
        _emit(cmd_open(cfg, args.name, args.invite, args.topic))
    elif cmd == "invite":
        _emit(cmd_invite(cfg, args.room, args.who))
    elif cmd == "join":
        _emit(cmd_join(cfg, args.room))
    elif cmd == "leave":
        _emit(cmd_leave(cfg, args.room))
    elif cmd == "post":
        _emit(cmd_post(cfg, args.room, args.text, args.thread, args.reply_to, args.data,
                       args.file, args.txn_id))
    elif cmd in ("mark", "unmark"):
        _emit(cmd_mark(cfg, args.room, cmd == "mark"))


if __name__ == "__main__":
    main()
