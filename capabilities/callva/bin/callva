# ===================================================================
# DOCTOR
# ===================================================================


def _check_connection(conn: dict) -> dict:
    """One connection's round-trip, reported rather than died — doctor covers
    every connection, so a broken one becomes a finding, not a stop."""
    out: dict = {"base_url": conn["base"], "key_env": conn["key_env"]}
    try:
        resp = httpx.get(conn["base"] + "/external/projects",
                         params={"per_page": "1"},
                         headers={"Authorization": f"Bearer {conn['api_key']}"},
                         timeout=TIMEOUT)
        if resp.status_code >= 400:
            cat = 2 if resp.status_code in (401, 403) else 5
            return out | {"ok": False, "category": cat,
                          "error": f"/external/projects returned {resp.status_code}"}
        projects = resp.json().get("data") or []
        return out | {"ok": True, "projects_visible": len(projects),
                      "sample_project": (projects[0].get("name") if projects else None)}
    except httpx.RequestError as e:
        return out | {"ok": False, "category": 5, "error": f"network error: {e}"}
    except ValueError as e:
        return out | {"ok": False, "category": 5, "error": f"bad response: {e}"}


def cmd_doctor(reg: dict | None, wanted: str | None,
               key_env_override: str | None, api_url_flag: str | None) -> None:
    """Every connection bare; one with --connection. Exit 0 only when every
    examined connection is healthy, else the first failure's category.
    key_env_override (--key-env) feeds _build_conn, overriding each examined
    entry's secret_env."""
    _doctor_gate(_connections_report(), wanted)
    if wanted is not None or reg is None:
        targets = [_select_connection(reg, wanted)]
    else:
        targets = list(reg["connections"].items())
    connections: dict = {}
    fail_exit = 0
    for cid, entry in targets:
        conn, problem = _build_conn(cid, entry, key_env_override, api_url_flag)
        if problem:
            res = {"ok": False, "category": problem["exit"],
                   "error": problem["message"]}
            if problem.get("hint"):
                res["hint"] = problem["hint"]
        else:
            res = _check_connection(conn)
        if not res.get("ok") and not fail_exit:
            fail_exit = res.get("category") or 5
        res.pop("category", None)
        connections[cid] = res
    _emit({"ok": fail_exit == 0, "connections": connections})
    if fail_exit:
        sys.exit(fail_exit)


# ===================================================================
# CLI Parser
# ===================================================================


def build_parser():
    parser = argparse.ArgumentParser(
        prog="callva",
        description="CallVA External API client — agent-first CRUD over the voice-AI platform.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subs = parser.add_subparsers(dest="resource", required=True)

    subs.add_parser("help", help="Print the full usage contract")
    subs.add_parser("doctor", help="Authenticated round-trip — prove readiness")

    # --- agents ---
    ag = subs.add_parser("agents", help="Manage voice agents")
    ag_sub = ag.add_subparsers(dest="action", required=True)
    ag_ls = ag_sub.add_parser("list", help="List all agents")
    ag_ls.add_argument("--is-active", type=parse_bool, default=None, help="Filter by active status")
    ag_sub.add_parser("default", help="Get or create the default agent")
    ag_get = ag_sub.add_parser("get", help="Get agent by ID")
    ag_get.add_argument("id", help="Agent UUID")
    ag_upd = ag_sub.add_parser("update", help="Update agent")
    ag_upd.add_argument("id", help="Agent UUID")
    ag_upd.add_argument("--name", help="Agent name")
    ag_upd.add_argument("--voice", help="Voice identifier")
    ag_upd.add_argument("--prompt", help="Prompt text (inline)")
    ag_upd.add_argument("--prompt-file", help="Read prompt from file")
    ag_upd.add_argument("--greeting-type", choices=["prompt", "exact", "instruction"])
    ag_upd.add_argument("--greeting-exact", help="Exact greeting text")
