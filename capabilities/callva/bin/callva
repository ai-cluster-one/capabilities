_contract_bind(globals(), "core")

_contract_bind(globals(), "store")


_contract_bind(globals(), "connections")


# ---------------------------------------------------------------------------
# Connections  (named, complete resolutions of the credential keys)
# ---------------------------------------------------------------------------


def _build_conn(cid: str, entry: dict | None, key_env_override: str | None,
                api_url_flag: str | None) -> tuple[dict | None, dict | None]:
    """Materialize one connection. Returns (conn, problem) — problem is an
    error dict ({"exit", "code", "message", "hint"?}) instead of a die, so
    doctor can report every connection rather than stopping at the first."""
    if entry is None:   # declared entry without overrides — use the flat-key cascade
        key_env = key_env_override or "CALLVA_API_KEY"
        api_key = _resolve_env_key(key_env)[0]
        if not api_key:
            return None, {
                "exit": 2, "code": "missing_api_key",
                "message": f"{key_env} not found in a project .env, "
                           f"{CREDENTIALS_ENV}, or the environment",
                "hint": f"set {key_env} in a project .env(.local), "
                        f"{CREDENTIALS_ENV}, or the environment — or declare a "
                        f"connections registry (capabilities/{NAME}/connections.json)"}
        base = (api_url_flag or _resolve_env_key("CALLVA_API_URL")[0]
                or DEFAULT_API_URL)
        return {"id": cid, "allow_write": WRITE_DEFAULT, "key_env": key_env,
                "api_key": api_key, "base": base.rstrip("/")}, None
    key_env = key_env_override or entry.get("secret_env")
    if not key_env:
        return None, {"exit": 6, "code": "no_secret_env",
                      "message": f"connection {cid!r} is missing 'secret_env'"}
    api_key = _resolve_env_key(key_env)[0]
    if not api_key:
        return None, {
            "exit": 2, "code": "missing_secret",
            "message": f"env var {key_env} (for connection {cid!r}) is unset",
            "hint": f"set {key_env} in the project's .env / .env.local, "
                    f"{CREDENTIALS_ENV}, or the environment"}
    base = api_url_flag or entry.get("api_url") or DEFAULT_API_URL
    return {"id": cid, "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT)),
            "key_env": key_env, "api_key": api_key, "base": base.rstrip("/")}, None


def _connections_report() -> dict:
    """The resolution report — every connection, every value, its winning tier
    and source, secrets masked. Local only: no network, no login attempt."""
    reg, _ = _connections_registry()
    report: dict = {"default": None, "connections": {}}
    if reg is None:
        keys = []
        for k in CRED_KEYS:
            value, tier, source = _resolve_env_key(k["key"])
            keys.append(_key_report(k["key"], k["secret"], k["required"],
                                    value, tier, source))
        report["default"] = "default"
        report["connections"]["default"] = {"allow_write": WRITE_DEFAULT, "keys": keys}
        return report
    conns = reg["connections"]
    report["default"] = reg.get("default") or \
        (next(iter(conns)) if len(conns) == 1 else None)
    for cid, entry in conns.items():
        entry = entry if isinstance(entry, dict) else {}
        origin = reg["sources"][cid]
        keys = []
        value = entry.get("api_url")
        keys.append(_key_report("api_url", False, False,
                                str(value) if value is not None else None,
                                "connection", origin))
        secret_env = entry.get("secret_env")
        if secret_env:
            value, tier, source = _resolve_env_key(secret_env)
            keys.append(_key_report(secret_env, True, True, value, tier, source))
        else:
            keys.append(_key_report("secret_env", False, True, None, None, None))
        report["connections"][cid] = {
            "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT)),
            "keys": keys}
    return report


def _cmd_connections() -> None:
    _emit(_connections_report())


# ---------------------------------------------------------------------------
# HTTP client
# ---------------------------------------------------------------------------


def _client(api_key: str, base_url: str) -> httpx.Client:
    return httpx.Client(
        base_url=base_url,
        headers={"Authorization": f"Bearer {api_key}"},
        timeout=TIMEOUT,
    )


def _api_message(data) -> str | None:
    """Best-effort human message from a CallVA error body."""
    if isinstance(data, dict):
        if data.get("message"):
            return data["message"]
        errs = data.get("errors")
        if isinstance(errs, dict):
            for v in errs.values():
                if isinstance(v, list) and v:
                    return str(v[0])
                return str(v)
        if isinstance(errs, list) and errs:
            first = errs[0]
            return first.get("message") if isinstance(first, dict) else str(first)
    if isinstance(data, str) and data:
        return data
    return None


def _api_details(data) -> str | None:
    """What a validation failure actually refused, field by field.

    A CallVA 422 carries a summary in `message` and the specifics in `errors`,
    keyed by field. `_api_message` returns the summary, which on its own says
    only that something was wrong - useless to a caller that has to decide what
    to send instead. This is the part that names the field and the bound.
    """
    if not isinstance(data, dict):
        return None
    errs = data.get("errors")
    if not isinstance(errs, dict) or not errs:
        return None
    lines = []
    for field, messages in errs.items():
        if isinstance(messages, list):
            lines.extend(f"{field}: {m}" for m in messages)
        else:
            lines.append(f"{field}: {messages}")
    if not lines:
        return None
    shown, rest = lines[:10], len(lines) - 10
    joined = "; ".join(shown)
    return joined + (f"; (+{rest} more)" if rest > 0 else "")


def _map_4xx(status: int, data, path: str, allow_404: bool):
    if allow_404 and status == 404:
        return None
    msg = _api_message(data) or f"HTTP {status}"
    if status in (401, 403):
        _die(2, "unauthorized", msg,
             "CALLVA_API_KEY may be invalid or lack access to this resource", status=status)
    if status == 404:
        _die(3, "not_found", msg,
             "verify the id exists and the key can see it", status=status)
    if status in (400, 422):
        _die(6, "invalid_request", msg, _api_details(data), status=status)
    _die(5, "api_error", msg, None, status=status)


def _request(client: httpx.Client, method: str, path: str,
             params: dict | None = None, json_body: dict | None = None,
             allow_404: bool = False):
    """Authenticated request with bounded, backed-off retries. Returns parsed JSON."""
    clean = {k: v for k, v in (params or {}).items() if v is not None}
    last_status: int | None = None
    for attempt in range(1, MAX_RETRIES + 1):
        try:
            resp = client.request(method, path, params=clean or None, json=json_body)
        except httpx.TimeoutException:
            if attempt < MAX_RETRIES:
                time.sleep(attempt * 1.5)
                continue
            _die(5, "timeout", f"request timed out: {method} {path}",
                 "the CallVA API was unresponsive")
        except httpx.RequestError as e:
            _die(5, "network_error", f"network error: {e}", "check connectivity")

        last_status = resp.status_code
        if resp.status_code == 429:
            retry_after = float(resp.headers.get("Retry-After", str(attempt * 1.5)))
            if attempt < MAX_RETRIES:
                time.sleep(retry_after)
                continue
            _die(5, "rate_limited", f"rate-limited after {MAX_RETRIES} attempts",
                 "back off and retry later", status=429)
        if resp.status_code >= 500:
            if attempt < MAX_RETRIES:
                time.sleep(attempt * 1.5)
                continue
            _die(5, "server_error", f"CallVA returned {resp.status_code}",
                 None, status=resp.status_code)

        raw = resp.text
        if not raw:
            if resp.status_code >= 400:
                return _map_4xx(resp.status_code, {}, path, allow_404)
            return {"success": True}
        try:
            data = resp.json()
        except ValueError:
            if resp.status_code >= 400:
                _map_4xx(resp.status_code, raw, path, allow_404)
            _die(5, "invalid_response", f"non-JSON response from {method} {path}",
                 status=resp.status_code)

        if resp.status_code >= 400:
            return _map_4xx(resp.status_code, data, path, allow_404)
        return data

    _die(5, "exhausted_retries", f"exhausted {MAX_RETRIES} attempts on {method} {path}",
         status=last_status)


def _download(client: httpx.Client, path: str, params: dict | None, output: str | None):
    """Stream binary content (recordings) to a file or stdout."""
    clean = {k: v for k, v in (params or {}).items() if v is not None}
    try:
        with client.stream("GET", path, params=clean or None) as resp:
            if resp.status_code >= 400:
                body = resp.read()
                try:
                    parsed = json.loads(body.decode("utf-8"))
                except (ValueError, UnicodeDecodeError):
                    parsed = body.decode("utf-8", "replace")
                return _map_4xx(resp.status_code, parsed, path, False)
            ctype = resp.headers.get("Content-Type", "audio/mpeg")
            length = resp.headers.get("Content-Length", "unknown")
            if output:
                with open(output, "wb") as f:
                    for chunk in resp.iter_bytes(8192):
                        f.write(chunk)
                return {"file": output, "content_type": ctype, "size": length}
            for chunk in resp.iter_bytes(8192):
                sys.stdout.buffer.write(chunk)
            return None
    except httpx.TimeoutException:
        _die(5, "timeout", f"recording download timed out: {path}",
             "the CallVA API was unresponsive")
    except httpx.RequestError as e:
        _die(5, "network_error", f"network error: {e}", "check connectivity")


def api(method, path, data=None, query=None, allow_404=False):
    return _request(_STATE["client"], method, path,
                    params=query, json_body=data, allow_404=allow_404)


def api_download(path, output, query=None):
    return _download(_STATE["client"], path, query, output)


# ---------------------------------------------------------------------------
# Result shaping — slim list responses to agent-useful fields unless --full
# ---------------------------------------------------------------------------


def _result(result, slim=None):
    """Apply a slim projection unless --full was given."""
    return slim(result) if (slim and not FULL) else result


def _pick(obj, keys):
    """Extract only the specified keys from a dict."""
    return {k: obj[k] for k in keys if k in obj}


def _slim_options(options):
    """Slim each option to its {value, label} pair, always keeping both.
    [{"value":"a","label":"A","x":1}] -> [{"value":"a","label":"A"}]
    Non-dict options pass through unchanged: "a" -> "a"."""
    if not options or not isinstance(options, list):
        return options
    return [{"value": o.get("value"), "label": o.get("label")}
            if isinstance(o, dict) else o
            for o in options]


def _apply_slim(result, item_fn):
    """Apply a per-item slim function to the `data` array of a list response.
    Preserves pagination, meta, success, and message keys."""
    data = result.get("data")
    if isinstance(data, list):
        filtered = dict(result)
        filtered["data"] = [item_fn(item) for item in data]
        return filtered
    return result


# ---------------------------------------------------------------------------
# Argument helpers
# ---------------------------------------------------------------------------


def resolve_content(args):
    """Resolve content from --content or --content-file flags."""
    cf = getattr(args, "content_file", None)
    c = getattr(args, "content", None)
    if cf:
        return sys.stdin.read() if cf == "-" else open(cf).read()
    return c


def parse_bool(value):
    if value.lower() in ("true", "1", "yes"):
        return True
    if value.lower() in ("false", "0", "no"):
        return False
    raise argparse.ArgumentTypeError(f"Invalid boolean: {value}")


def parse_json_arg(value):
    try:
        return json.loads(value)
    except json.JSONDecodeError as e:
        raise argparse.ArgumentTypeError(f"Invalid JSON: {e}")


def parse_json_file(value):
    if value == "-":
        return json.loads(sys.stdin.read())
    with open(value) as f:
        return json.load(f)


def _data(value):
    """A non-empty --data/--payload object, or die with a validation error."""
    if not value:
        _die(6, "missing_payload", "provide the payload as --data '{...}'")
    return value


def _merge_update(payload, fields):
    """One update body from --data and the typed flags, by one rule everywhere.

    --data is the base object. Every flag the caller actually passed is written
    over it under that flag's own key and wins there, including --config over a
    `config` key already in --data. Keys --data carries that no flag names are
    kept. Taking a record whole and correcting one field is the common case, so
    the flags read as a correction rather than as a mode that turns --data off.
    """
    data = dict(payload) if payload else {}
    data.update(fields)
    return data


# ===================================================================
# AGENTS
# ===================================================================


def agents_list(args):
    query = {}
    if getattr(args, "is_active", None) is not None:
        query["is_active"] = str(args.is_active).lower()
    result = api("GET", "/external/agents", query=query)
    slim = lambda r: _apply_slim(r, lambda a: _pick(a, [
        "id", "name", "project_name", "is_active", "is_default"]))
    return _result(result, slim=slim)


def agents_default(_args):
    return api("GET", "/external/agents/default").get("data")


def agents_get(args):
    r = api("GET", f"/external/agents/{args.id}")
    return r.get("data", r)


def agents_update(args):
    # Voice is a property of the speech stack, not of the agent, and where it
    # sits inside that stack differs per preset. Translating it here would mean
    # guessing which preset the agent is on and writing a field the caller did
    # not name - so the flag says where the value moved and writes nothing. The
    # API refuses it too; this refuses it before the request, with the command
    # that replaces it.
    if getattr(args, "voice", None) is not None:
        _die(6, "moved_to_preset",
             "voice belongs to the preset the agent runs, not to the agent",
             hint=(f"callva presets list {args.id} names the active preset; "
                   f"write the voice with `callva presets patch {args.id} <preset> "
                   "--config '{\"voice\": \"...\"}'`, and "
                   "`callva presets describe <preset>` says which voices it takes"))

    fields = {}
    if args.name is not None:
        fields["name"] = args.name
    if args.prompt is not None:
        fields["prompt"] = args.prompt
    if args.prompt_file is not None:
        fields["prompt"] = open(args.prompt_file).read()
    if args.greeting_type is not None:
        fields["greeting_type"] = args.greeting_type
    if args.greeting_exact is not None:
        fields["greeting_exact"] = args.greeting_exact
    if args.greeting_instruction is not None:
        fields["greeting_instruction"] = args.greeting_instruction
    if args.agent_speaks_first is not None:
        fields["agent_speaks_first"] = args.agent_speaks_first
    if args.config_json is not None:
        fields["config"] = args.config_json
    data = _merge_update(args.payload, fields)
    if not data:
        _die(6, "nothing_to_update", "no fields to update; use flags or --data '{...}'")
    # Tools left the config blob because a map has no address: removing one
    # meant sending all of them, so a stale copy silently deleted the tools it
    # had never heard of. The API refuses the key; this refuses it on the
    # merged body, which is the one place both --config and --data arrive at.
    config = data.get("config")
    if isinstance(config, dict) and "tools" in config:
        _die(6, "moved_to_tools",
             "tools are records of their own, not a key in the agent's config",
             hint=(f"callva tools list {args.id} names them; write one with "
                   f"`callva tools set {args.id} <key> --config '{{...}}'` and "
                   f"remove one with `callva tools delete {args.id} <key>`"))
    r = api("PATCH", f"/external/agents/{args.id}", data)
    return r.get("data", r)


def agents_clone(args):
    """Copy an agent, with every preset row it holds.

    An agent holds at most one configuration per preset, so two configurations
    of one stack is two agents. This is what makes that answer cheap.
    """
    data = {}
    if args.name is not None:
        data["name"] = args.name
    r = api("POST", f"/external/agents/{args.id}/clone", data)
    return r.get("data", r)


def agents_delete(args):
    api("DELETE", f"/external/agents/{args.id}")
    return {"deleted": args.id}


def agents_config(args):
    """The configuration a call starts from, as the voice worker receives it.

    This is the one endpoint callva calls outside /external/: the platform
    composes the agent, its active preset and resolved prompt assets, then runs
    the agent's custom_config_url automation over the result. Returned as sent,
    since the composition is the thing being inspected.
    """
    return api("POST", "/config/livekit",
               {"agent_id": args.id, "direction": args.direction},
               query={"agent_id": args.id})


# ---------------------------------------------------------------------------
# Presets — the speech stack an agent runs on
# ---------------------------------------------------------------------------
#
# A preset's configuration is its own record, one per preset per agent, and the
# platform declares what each one takes. `describe` serves that declaration
# whole, which is the only way a caller with no dashboard can configure a stack
# it has never seen: the fields, their bounds, and which lists are closed are
# all in it, and the platform validates a write against the same declaration.


def _descriptors():
    r = api("GET", "/external/presets")
    return r.get("data", r)


def _slim_field(field):
    """One control, as much of it as a caller needs to write a value.

    `enum` closes a value and `suggestions` only offers one, so both are kept
    and the difference between them is not flattened away. `requires` stays
    because a field whose condition is unmet is one the worker does not read.
    """
    kept = _pick(field, [
        "label", "type", "nullable", "default", "unit", "help",
        "requires", "max_items", "max_selections", "advanced",
    ])
    for key in ("enum", "suggestions"):
        if key in field:
            kept[key] = _slim_options(field[key])
    if "range" in field:
        kept["range"] = field["range"]
    if "discriminator" in field:
        kept["discriminator"] = field.get("discriminator")
        kept["default_variant"] = field.get("default_variant")
        kept["variants"] = {
            name: {"label": body.get("label"),
                   "fields": {k: _slim_field(v) for k, v in (body.get("fields") or {}).items()}}
            for name, body in (field.get("variants") or {}).items()
        }
    if "fields" in field:
        kept["fields"] = {k: _slim_field(v) for k, v in field["fields"].items()}
    if "language_set" in field:
        kept["language_set"] = field["language_set"]
    if "language_set_by" in field:
        kept["language_set_by"] = field["language_set_by"]
    return kept


def presets_catalog(_args):
    descriptors = _descriptors()
    if FULL:
        return descriptors
    return [_pick(d, ["id", "label", "description", "strict", "schema_version"])
            for d in descriptors]


def presets_describe(args):
    for descriptor in _descriptors():
        if descriptor.get("id") != args.preset:
            continue
        if FULL:
            return descriptor
        fields = descriptor.get("fields") or {}
        if args.group:
            fields = {k: v for k, v in fields.items() if v.get("group") == args.group}
            if not fields:
                _die(3, "group_not_found",
                     f"preset '{args.preset}' declares no group '{args.group}'",
                     hint="groups are listed by `callva presets describe " + args.preset + "`")
        slim = _pick(descriptor, ["id", "label", "description", "strict", "schema_version", "groups"])
        slim["fields"] = {k: _slim_field(v) for k, v in fields.items()}
        return slim
    known = ", ".join(sorted(d.get("id", "") for d in _descriptors()))
    _die(3, "preset_not_found", f"no preset '{args.preset}'",
         hint=f"this platform offers: {known}")


def presets_list(args):
    result = api("GET", f"/external/agents/{args.agent_id}/presets")
    slim = lambda r: _apply_slim(r, lambda row: _pick(row, [
        "preset", "is_active", "updated_at"]))
    return _result(result, slim=slim)


def presets_get(args):
    r = api("GET", f"/external/agents/{args.agent_id}/presets/{args.preset}")
    return r.get("data", r)


def _config_arg(args):
    if args.config_file is not None:
        raw = sys.stdin.read() if args.config_file == "-" else open(args.config_file).read()
        try:
            return json.loads(raw)
        except json.JSONDecodeError as exc:
            _die(6, "invalid_json", f"config file is not valid JSON: {exc}")
    return args.config_json


def presets_set(args):
    """Replace the configuration.

    A key that was stored and is not sent is gone, which is the only way a leaf
    is removed at all - JSON carries no delete token.
    """
    r = api("PUT", f"/external/agents/{args.agent_id}/presets/{args.preset}",
            {"config": _config_arg(args)})
    return r.get("data", r)


def presets_patch(args):
    """Merge into the configuration.

    A merge cannot express a removal: a key left out keeps whatever it held.
    Use `presets set` to drop one.
    """
    r = api("PATCH", f"/external/agents/{args.agent_id}/presets/{args.preset}",
            {"config": _config_arg(args)})
    return r.get("data", r)


def presets_activate(args):
    """Make this the stack the agent's next call runs on.

    There is no separate confirming act, so an activation made mid-day changes
    live behaviour immediately.
    """
    r = api("POST", f"/external/agents/{args.agent_id}/presets/{args.preset}/activate")
    return r.get("data", r)


# ---------------------------------------------------------------------------
# Tools — what an agent can call, one record per tool
# ---------------------------------------------------------------------------
#
# Each tool is addressed by its own name, so an edit reaches only the tool it
# names and a stale view of the rest can no longer remove one. The name is the
# key the worker reads, and camelCase names are live, so it is sent exactly as
# the caller typed it and is never normalised here.


def _tool_path(args):
    """The tool's address, with the name escaped rather than trusted.

    A name the platform cannot hold is the platform's refusal to give, and it
    can only give it about the name it was actually handed: an unescaped `?` or
    `#` ends the path, so the server would answer about a shorter name than the
    caller typed. Nothing in a legal name is escaped by this.
    """
    key = urllib.parse.quote(args.key, safe="")
    return f"/external/agents/{args.agent_id}/tools/{key}"


def _tool_fields(args):
    """Only the fields the command actually named.

    A field sent unasked is a field overwritten: carrying `type` along with an
    `--is-enabled` toggle would strip the type off a tool the worker then cannot
    build, and a tool the cascade worker finds by module name has none to begin
    with.
    """
    fields = {}
    if args.type is not None:
        fields["type"] = args.type
    if args.is_enabled is not None:
        fields["is_enabled"] = args.is_enabled
    if args.position is not None:
        fields["position"] = args.position
    if args.config_json is not None or args.config_file is not None:
        fields["config"] = _config_arg(args)
    return fields


def tools_list(args):
    result = api("GET", f"/external/agents/{args.agent_id}/tools")
    slim = lambda r: _apply_slim(r, lambda row: _pick(row, [
        "key", "type", "is_enabled", "position", "updated_at"]))
    return _result(result, slim=slim)


def tools_get(args):
    r = api("GET", _tool_path(args))
    return r.get("data", r)


def tools_set(args):
    """Replace the record.

    Every field left out takes its default - no type, enabled, position 0 - and
    the body is stored as sent, which is the only way a leaf inside it, or the
    type itself, is removed.
    """
    fields = _tool_fields(args)
    if "config" not in fields:
        _die(6, "missing_config",
             "`tools set` states the whole record, so it needs the body: "
             "--config '{...}' or --config-file F",
             hint="`callva tools patch` changes named fields and leaves the rest")
    r = api("PUT", _tool_path(args), fields)
    return r.get("data", r)


def tools_patch(args):
    """Write only the fields this command names.

    The body is merged into what is stored, with lists replaced whole, so a
    merge cannot express a removal. Use `tools set` to drop one.
    """
    fields = _tool_fields(args)
    if not fields:
        _die(6, "nothing_to_update",
             "no fields to change; name at least one of "
             "--config, --config-file, --type, --is-enabled, --position")
    r = api("PATCH", _tool_path(args), fields)
    return r.get("data", r)


def tools_delete(args):
    """Leave the agent with no tool by that name, whether or not it had one."""
    api("DELETE", _tool_path(args))
    return {"deleted": args.key, "agent_id": args.agent_id}


