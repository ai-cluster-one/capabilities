# --- HTTP triggers ---------------------------------------------------------
# A trigger is addressed by its Windmill path (`f/proj_x/trigger_y`), which is
# always slashed; the API route matches it as `.*`, so the separators stay
# literal and only the other characters are escaped.


def _trigger_path(raw):
    return urllib.parse.quote(raw, safe="/")


def automations_triggers(args):
    result = api("GET", f"/external/automations/{args.id}/triggers")
    slim = lambda r: _apply_slim(r, lambda t: _pick(t, [
        "path", "route_path", "webhook_url", "mode", "http_method", "request_type",
        "authentication_method", "workspaced_route", "script_path"]))
    return _result(result, slim=slim)


_ROUTE_PATH_CHARS = "abcdefghijklmnopqrstuvwxyz0123456789_-"


def _trigger_fields(args, creating):
    route_path = args.route_path
    # The platform refuses any other shape, but reports the refusal as a retried
    # 500 rather than as validation, so the CLI has to make it legible here.
    if route_path is not None and not (
            0 < len(route_path) <= 100 and all(c in _ROUTE_PATH_CHARS for c in route_path)):
        _die(6, "invalid_route_path",
             f"route path {route_path!r} is not a single [a-z0-9_-] segment of 1 to 100 characters",
             "the platform mints only that shape; a slashed route path can exist on a trigger "
             "made directly in Windmill, but cannot be created or set here")
    if args.auth == "signature" and not args.secret:
        _die(6, "missing_secret", "--auth signature needs --secret",
             "the secret signs the caller's request; it is stored as a workspace variable")
    if args.secret is not None:
        if args.auth != "signature":
            _die(6, "secret_without_signature",
                 "--secret is only read with --auth signature",
                 "the platform drops it otherwise; pass --auth signature to set or rotate it")
        if len(args.secret) < 8:
            _die(6, "secret_too_short", "--secret must be at least 8 characters")
    data = {}
    if creating or args.method is not None:
        data["http_method"] = args.method
    if creating or args.mode is not None:
        data["request_type"] = args.mode
    if creating or args.auth is not None:
        data["auth_method"] = args.auth
    if args.secret is not None:
        data["secret"] = args.secret
    if route_path is not None:
        data["route_path"] = route_path
    return data


def automations_add_trigger(args):
    r = api("POST", f"/external/automations/{args.id}/triggers",
            _trigger_fields(args, creating=True))
    return r.get("data", r)


def automations_update_trigger(args):
    data = _trigger_fields(args, creating=False)
    if not data:
        _die(6, "nothing_to_update",
             "no fields to update; use --method, --mode, --auth, --secret, or --route-path")
    r = api("PUT",
            f"/external/automations/{args.id}/triggers/{_trigger_path(args.trigger_path)}",
            data)
    return r.get("data", r)


def automations_remove_trigger(args):
    api("DELETE",
        f"/external/automations/{args.id}/triggers/{_trigger_path(args.trigger_path)}")
    return {"deleted": args.trigger_path}


def automations_toggle_trigger(args):
    r = api("POST",
            f"/external/automations/{args.id}/triggers/"
            f"{_trigger_path(args.trigger_path)}/toggle",
            {"enabled": args.enabled})
    return r.get("data", r)


