    aut_rd.add_argument("id", help="Automation UUID")
    aut_rd.add_argument("job_id", help="Job UUID")
    aut_sub.add_parser("runtime-info", help="Get runtime environment info")

    _TRIGGER_PATH_HELP = ("The trigger's `path` as listed by `automations triggers` — its Windmill "
                          "identifier, not its URL; pass it whole, slashes included")
    _ROUTE_PATH_HELP = ("URL tail after /api/r/; the platform mints only a single [a-z0-9_-] "
                        "segment, omitted on add it derives one from the automation id")
    aut_trg = aut_sub.add_parser("triggers",
                                 help="List the HTTP triggers that call one automation, each with its webhook_url")
    aut_trg.add_argument("id", help="Automation UUID")
    aut_tadd = aut_sub.add_parser("add-trigger", help="Put an automation behind a webhook URL")
    aut_tadd.add_argument("id", help="Automation UUID")
    aut_tadd.add_argument("--method", required=True, choices=["get", "post"],
                          help="HTTP method the webhook accepts")
    aut_tadd.add_argument("--mode", required=True, choices=["async", "sync"],
                          help="async returns a job id at once; sync holds the request for the result")
    aut_tadd.add_argument("--auth", required=True, choices=["none", "signature"],
                          help="Caller authentication; signature requires --secret")
    aut_tadd.add_argument("--secret", help="HMAC secret for --auth signature (min 8 chars)")
    aut_tadd.add_argument("--route-path", dest="route_path", help=_ROUTE_PATH_HELP)
    aut_tupd = aut_sub.add_parser("update-trigger", help="Change an existing trigger")
    aut_tupd.add_argument("id", help="Automation UUID")
    aut_tupd.add_argument("trigger_path", help=_TRIGGER_PATH_HELP)
    aut_tupd.add_argument("--method", choices=["get", "post"], help="HTTP method the webhook accepts")
    aut_tupd.add_argument("--mode", choices=["async", "sync"], help="async job id at once, sync waits for the result")
    aut_tupd.add_argument("--auth", choices=["none", "signature"],
                          help="Caller authentication; signature requires --secret")
    aut_tupd.add_argument("--secret", help="HMAC secret for --auth signature (min 8 chars)")
    aut_tupd.add_argument("--route-path", dest="route_path", help=_ROUTE_PATH_HELP)
    aut_trm = aut_sub.add_parser("remove-trigger", help="Delete a trigger and its stored secret")
    aut_trm.add_argument("id", help="Automation UUID")
    aut_trm.add_argument("trigger_path", help=_TRIGGER_PATH_HELP)
    aut_ttg = aut_sub.add_parser("toggle-trigger", help="Enable or disable a trigger without deleting it")
    aut_ttg.add_argument("id", help="Automation UUID")
    aut_ttg.add_argument("trigger_path", help=_TRIGGER_PATH_HELP)
    aut_ttg.add_argument("--enabled", type=parse_bool, required=True,
                         help="true to serve the webhook, false to refuse it")

    # --- webhook-logs ---
    wl = subs.add_parser("webhook-logs", help="Inspect inbound webhook activity")
    wl_sub = wl.add_subparsers(dest="action", required=True)
    wl_ls = wl_sub.add_parser("list", help="List webhook logs with filters")
    wl_ls.add_argument("--per-page", type=int, help="Results per page (default 30, max 100)")
    wl_ls.add_argument("--page", type=int, help="Page number")
    wl_ls.add_argument("--sort", default="-received_at", help="Sort field (default: -received_at)")
    wl_ls.add_argument("--filter", "-f", action="append",
                       help=("Filter as key=value (repeatable): search, type (call|config_request), "
                             "event_type, processing_status, agent_id, related_call_id, received_from, "
