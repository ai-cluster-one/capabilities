#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "httpx>=0.27",
#     "capabilities-contract>=0.12,<1",
# ]
# ///
"""callva — agent-first CLI for the CallVA voice-AI platform.

This tool is designed to be invoked by agents. Run `callva help` to load the
full usage contract on demand — do not rely on memorised knowledge of its
surface. It is a pure CRUD / I/O adapter over the CallVA External API: voice
agents, assets (prompts), calls, transcripts, recordings, analytics, custom
fields, webhook schedules, automations (Windmill scripts), webhook logs,
variables, settings, projects, phone numbers, and providers.

`agents config` is the one place callva reaches outside the External API: it
calls the platform's call-configuration endpoint, POST /config/livekit, on the
same base URL with the same key.

CONNECTIONS
  Configuration requires an explicit connections registry, even for one
  connection. A flag wins (--api-url, non-secret only; a secret never has a
  flag); otherwise its values resolve through the credential cascade (`Where a
  secret resolves`, at the end of this help). Same CALLVA_* keys at every
  tier; the project you're in wins, so a deployed host's injected env governs
  when no config file is present. Never pass the key on the command line.
    CALLVA_API_KEY=<your CallVA API key>   secret — never passed on argv
    CALLVA_API_URL=<base URL>              optional; default
                                           https://api.callva.one/api/v1

  A project that talks to several CallVA tenants declares them as
  connections, kept where "Where connections live" below says:
    {
      "default": "<id>",
      "connections": {
        "<id>": {
          "api_url": "https://api.example.com/api/v1",
          "secret_env": "CALLVA_<ID>_API_KEY",
          "allow_write": true
        }
      }
    }
  Only the API key is secret: the entry names the env var holding it
  ("secret_env"); the value resolves through the credential cascade above.
  "api_url" is optional — absent, the
  default base URL applies. "allow_write": false makes the connection
  read-only: every mutating verb (the create/update/delete/batch/store/
  reorder/deploy/run actions on agents, assets, calls, transcripts, fields,
  field-groups, schedules, automations, and variables, the add/update/remove/
  toggle trigger actions on automations, the outbound `call`, and `agents
  config`, which runs the agent's start-of-call automation) exits 4, and no
  flag lifts the gate.

  Selection: --connection <id> (accepted anywhere on the command line).
  Unflagged, the registry's "default" pointer applies, else the sole entry;
  several entries without a pointer is refused as ambiguous.

  Outside any project, connections and doctor are machine reads: they use the
  machine's own connections read-only, unless a grant switched one off; every
  other verb that needs a connection is refused there.

Global options (accepted anywhere on the line — before or after the command):
  --full              return the full, unfiltered API response (list endpoints
                      are slimmed to the agent-useful fields by default)
  --connection <id>   select a registry connection (optional with a default
                      pointer or a sole entry)
  --key-env <KEY>     resolve the API key from a different env/cred KEY (default
                      CALLVA_API_KEY; with a registry connection it overrides
                      that entry's secret_env) — act as a different CallVA
                      account/tenant. Only the key NAME travels; the value
                      never touches argv. It never lifts a connection's write
                      gate.
  --api-url <URL>     override the base URL for this invocation

Output is JSON on stdout. List endpoints are slimmed to the fields an agent
needs; pass --full for the raw API response. `get` / detail commands always
return the full resource. `recordings stream` writes binary audio.

Commands (`-f key=value` is repeatable for list filters):

  connections                         where every connection's values resolve
                                      from (tier, source, secrets masked).
                                      Local only — no network.
  doctor [--connection <id>]          authenticated round-trip — proves the key
                                      resolves, the API is reachable, and what
                                      project the key sees — every connection,
                                      or one
  help                                print this contract

  agents list [--is-active B]
  agents default
  agents get <id>
  agents update <id> [--name N] [--prompt T | --prompt-file F]
                     [--greeting-type prompt|exact|instruction]
                     [--greeting-exact T] [--greeting-instruction T]
                     [--agent-speaks-first B] [--config JSON] [--data JSON]
  agents clone <id> [--name N]
  agents delete <id>
  agents config <id> [--direction inbound|outbound]

  --data is the base object of an update and every flag above writes over it
  under that flag's own key: pass --data and --prompt together and the prompt
  is the one from --prompt, and --config beats a `config` key inside --data.
  Keys --data carries that no flag names are sent as given.

  An agent owns the conversation; a preset owns the speech stack it runs on.
  Voice, model, temperature, transcriber and languages live on the preset, not
  on the agent, and `agents update` refuses them. An agent holds at most one
  configuration per preset and keeps the ones it is not running, so switching
  stacks loses nothing — and comparing two configurations of one stack means
  two agents, which is what `agents clone` is for.

  `agents get` and `presets get` show what is stored; `agents config` shows
  what a call actually starts from — the configuration the voice worker is
  handed for a call in that direction (default inbound): the agent, its active
  preset including backend_instructions, every {{prompt:...}} reference
  resolved, and whatever the agent's custom_config_url automation returned.
  Producing it runs that automation and files a call record on the platform,
  left in status `starting`, so the verb is write-gated; run it only against an
  agent whose start-of-call automation is safe to fire.

  presets catalog
  presets describe <preset> [--group G]
  presets list <agent-id>
  presets get <agent-id> <preset>
  presets set <agent-id> <preset> (--config JSON | --config-file F)
  presets patch <agent-id> <preset> (--config JSON | --config-file F)
  presets activate <agent-id> <preset>

  `catalog` names the presets this platform offers; `describe` is the one that
  says what a preset takes — every field, its type, its bounds, and whether a
  list is closed or merely suggested. Read it before writing a configuration:
  it is the same declaration the platform validates against, so a write it
  refuses is a write the API refuses.

  `set` replaces the configuration; `patch` merges into it. Prefer `set` when
  removing a key, because a merge has no way to express one. `activate` is what
  makes a preset the stack the agent's next call runs on.

  tools list <agent-id>
  tools get <agent-id> <key>
  tools set <agent-id> <key> (--config JSON | --config-file F)
            [--type end_call|http_request] [--is-enabled B] [--position N]
  tools patch <agent-id> <key> [--config JSON | --config-file F]
            [--type end_call|http_request] [--is-enabled B] [--position N]
  tools delete <agent-id> <key>

  A tool is a record of its own, addressed by the name it carries, so an edit
  reaches only the tool it names and no stale copy of the others can remove one.
  The name is case-sensitive and is written exactly as typed. `agents update`
  refuses a `tools` key inside --config for the same reason.

  `set` states the whole record: the body is stored as sent and every field left
  out takes its default — no type, enabled, position 0 — which is the only way a
  leaf inside the body, or the type itself, is removed. `patch` writes only the
  fields the command names and deep-merges the body, replacing lists whole, so
  toggling `--is-enabled` leaves the type, the position and the body as they
  were. Either creates the tool when the agent has none. `delete` leaves the
  agent with no tool by that name, whether or not it had one.

  assets list [--type prompt|schema|payload] [--per-page N]
  assets get <id>
  assets create --name N --type T (--content C | --content-file F) [--inactive]
  assets update <id> [--name N] [--content C | --content-file F] [--is-active B]
  assets delete <id>

  calls list [--per-page N] [--page N] [--sort F] [-f k=v ...]
  calls get <id>
  calls create --data JSON
  calls update <id> --data JSON
  calls delete <id>
  calls batch <id> [<id> ...] --data JSON
  calls webhook-logs <call_id> [--per-page N] [--page N] [--sort F] [-f k=v ...]
  calls automation-runs <call_id> [--per-page N] [--page N] [-f k=v ...]
                        [--no-include-args]
                        (the prepared view for runs whose args carry the id as a
                         nested call object, {"call":{"id":"<call_id>"}}; for any
                         other args shape use `automations all-runs --args-filter`)

  transcripts get <call_id>
  transcripts store <call_id> (--data JSON | --data-file F)
  transcripts delete <call_id>
  transcripts url <call_id>

  call <destination> --agent-id ID [--phone-number-id ID] [--call-id ID]
                     [--overrides JSON]

  stats aggregate --op count|sum|avg|min|max [--field F] [--group-by F]
                  [--interval day|week|month] [-f k=v ...]
  stats trends --from DATE --to DATE

  recordings stream <call_id> --url URL [--output FILE]   (binary; stdout if no
                                                           --output)

  fields list [--entity-type T]
  fields create --data JSON
  fields update <id> --data JSON
  fields delete <id>
  fields impact <id>

  field-groups list
  field-groups create --data JSON
  field-groups update <id> --data JSON
  field-groups delete <id>
  field-groups reorder --data JSON
  field-groups add-field <id> <field_id> [--position N]
  field-groups remove-field <id> <field_id>
  field-groups reorder-fields <id> --data JSON
  field-groups update-field <id> <field_id> --data JSON

  schedules list
  schedules get <id>
  schedules create --data JSON
  schedules update <id> --data JSON      (full PUT — send the complete payload,
                                          all rules included)
  schedules delete <id>
  schedules preview <id> <datetime>
  schedules executions <id> [--per-page N]

  automations list [--per-page N]
  automations get <id>
  automations create --name N [--description D]
  automations update <id> [--name N] [--description D] [--is-active B]
                          [--settings JSON] [--data JSON]
                          (--data is the base; each flag above writes over it
                           under its own key, and --settings beats a `settings`
                           key inside --data)
  automations delete <id>
  automations code <id>
  automations deploy <id> (--file F | --code C)
                          [--language bun|deno|python3|bash|go|nativets]
  automations run <id> [--args JSON | --args-file F]
  automations runs <id> [--per-page N]
  automations all-runs [--per-page N] [--page N] [-f k=v ...]
                       [--args-filter JSON] [--result-filter JSON]
                       [--include-args]
  automations run-detail <id> <job_id>
  automations runtime-info

  automations triggers <id>
  automations add-trigger <id> --method get|post --mode async|sync
                          --auth none|signature [--secret S] [--route-path P]
  automations update-trigger <id> <trigger_path> [--method M] [--mode M]
                             [--auth A] [--secret S] [--route-path P]
  automations remove-trigger <id> <trigger_path>
  automations toggle-trigger <id> <trigger_path> --enabled B
                          (HTTP triggers put an automation behind a URL. Each
                           trigger's `webhook_url` is the value an agent's
                           custom_config_url / custom_webhook_url takes.
                           <trigger_path> is the trigger's `path` — its Windmill
                           identifier, not its URL. Read it from `automations
                           triggers` and pass it whole: it may carry slashes
                           (`f/proj_ab12cd34/trigger_e5f6a7b8c9d0`) and they are
                           sent literally, not escaped.
                           --route-path is the other field, the URL tail after
                           /api/r/. The platform accepts only a single
                           [a-z0-9_-] segment there, so a trigger whose
                           route_path already carries slashes — Windmill permits
                           those, the platform does not mint them — can be
                           listed, toggled and otherwise changed here, but
                           neither created nor re-pathed. Omit --route-path on
                           add and the platform derives one from the automation
                           id. Whether the workspace name sits in the URL is the
                           trigger's own `workspaced_route`, set in Windmill and
                           read back, never sent.
                           --secret is required by --auth signature, min 8
                           chars; it is stored as a workspace variable and is
                           never read back.)

  webhook-logs list [--per-page N] [--page N] [--sort F] [-f k=v ...]
  webhook-logs get <id>
  webhook-logs filters

  variables list
  variables create --name N --value V [--description D] [--is-secret B]
  variables update <path> --value V
  variables delete <path>

  settings list
  settings get <key>

  projects list [--is-active B] [--per-page N]
  projects get <id>

  phone-numbers list [--is-active B] [--per-page N]
  phone-numbers get <id>

  providers list [--is-active B] [--provider-type T] [--per-page N]
  providers types

Conventions:
  - Filtering on list/stats commands is always `-f key=value` (repeatable):
    e.g. `calls list -f status=complete -f result=confirmed`. There are no bare
    per-field flags like `--status`.
  - `stats aggregate` filters dates with `-f created_at_gte=<date>`; `--from` /
    `--to` belong to `stats trends` only.
  - Use file flags (`--content-file`, `--prompt-file`, `--file`, `--data-file`,
    `--args-file`) for large content; `-` reads stdin.
  - `--data` / `--overrides` / `--settings` take a JSON object.

Contract commands (the same on every capability):
  callva stub                                 One-line awareness text.
  callva manifest --json                      Machine-readable declaration.
  callva guide [<topic>]                      Guide topics / one guide body,
                                              fetched live from the docs base.
  callva ids list|get <l>|set <l> <v>|rm <l>  The project identifiers envelope
         [--note <text>]                      (capabilities/callva/identifiers.json,
                                               or store rows once the agent moved).
  callva refs                                 Menu of the project's reference
                                              files for this capability.
  callva inventory [--network]                What this capability holds in
                                              this project (--network adds
                                              remote detail).

I/O contract:
  - Success: JSON on stdout, exit 0.
  - Error:   {"error": {"code", "message", "hint"?, "status"?}} on stderr,
             non-zero exit.

Exit codes:
  0  success
  2  auth (missing / rejected credentials, 401 / 403)
  3  not found (404)
  4  policy refusal — the project gate (store rows once the agent moved, else capabilities/settings.json) on any
     verb, or a write verb on a read-only connection (allow_write: false).
     Ask the user; never lift a gate yourself.
  5  server / network (timeout, connection error, 429 after retries, 5xx)
  6  input / validation (malformed argument, bad payload, 400 / 422)
"""

import argparse
import json
import os
import sys
import time
import urllib.parse
from pathlib import Path
from typing import NoReturn

import httpx

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

DEFAULT_API_URL = "https://api.callva.one/api/v1"
TIMEOUT = httpx.Timeout(60.0)
MAX_RETRIES = 3

# --- Capability declaration — one home for every contract fact ---------------

NAME = "callva"
SUMMARY = ("CallVA voice-AI platform CLI over the External API — "
           "read/create/update/delete agents, the speech-stack presets "
           "they run on and the tools they call, assets (prompts), calls, "
           "transcripts, recordings, call analytics, custom fields, webhook "
           "schedules, automations (Windmill scripts), webhook logs, "
           "variables, settings, projects, phone numbers, and providers.")
SCOPE = "project"   # credential scope: "project" | "user"
CRED_KEYS = [
    {"key": "CALLVA_API_KEY", "secret": True, "required": True,
     "note": "External API key (default identity; alternates via --key-env)"},
    {"key": "CALLVA_API_URL", "secret": False, "required": False,
     "note": "API base URL; default https://api.callva.one/api/v1"},
]

# What a person is asked for (SHEBANG.md, "What a person is asked for"):
# a connection entry's own fields, which `connection add` writes.
CONN_FIELDS = [{'key': 'api_url',
  'label': 'API URL',
  'help': 'The CallVA API base.',
  'type': 'url',
  'required': False,
  'default': 'https://api.callva.one/api/v1'},
 {'key': 'secret_env',
  'label': 'API key',
  'help': "The tenant's CallVA External API key.",
  'type': 'string',
  'secret': True,
  'required': True,
  'env': 'CALLVA_{ID}_API_KEY'}]
WRITE_VERBS = {     # domain verbs (resource [+ action]) that mutate the platform
    "agents update", "agents delete", "agents clone",
    "agents config",    # runs the agent's custom_config_url automation
    "presets set", "presets patch", "presets activate",
    "tools set", "tools patch", "tools delete",
    "assets create", "assets update", "assets delete",
    "calls create", "calls update", "calls delete", "calls batch",
    "transcripts store", "transcripts delete",
    "call",
    "fields create", "fields update", "fields delete",
    "field-groups create", "field-groups update", "field-groups delete",
    "field-groups reorder", "field-groups add-field", "field-groups remove-field",
    "field-groups reorder-fields", "field-groups update-field",
    "schedules create", "schedules update", "schedules delete",
    "automations create", "automations update", "automations delete",
    "automations deploy", "automations run",
    "automations add-trigger", "automations update-trigger",
    "automations remove-trigger", "automations toggle-trigger",
    "variables create", "variables update", "variables delete",
}
WRITE_DEFAULT = True    # writes stay inside a tenant the consumer owns
MACHINE_READS = ("connections", "doctor")   # outside any project, read-only on the machine's connections
DOCS_BASE = ("https://raw.githubusercontent.com/ai-cluster-one/capabilities/"
             "main/capabilities/callva/guides/")
STATE = False       # True when the capability writes session/cache state
INVENTORY = None     # or {"network": "none"|"optional"|"required"} with an _inventory(network) builder
POST_INSTALL: list = []

_CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
CONFIG_DIR = _CONFIG_HOME / "callva"
CREDENTIALS_ENV = CONFIG_DIR / "credentials.env"
_STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state"))

# Set by --full; list endpoints slim to agent-useful fields unless True.
FULL = False

# Holds the live client + resolved base URL, so handlers call api() freely.
_STATE: dict = {}


# The shared capability code is the capabilities-contract library's, bound here
# into this script's namespace (SHEBANG.md, "The contract verbs").
