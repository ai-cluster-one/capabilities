# ASSETS
# ===================================================================


def assets_list(args):
    query = {}
    if args.type:
        query["type"] = args.type
    if args.per_page:
        query["per_page"] = str(args.per_page)
    result = api("GET", "/external/assets", query=query)
    slim = lambda r: _apply_slim(r, lambda a: _pick(a, [
        "id", "name", "type", "is_active", "created_at", "updated_at"]))
    return _result(result, slim=slim)


def assets_get(args):
    r = api("GET", f"/external/assets/{args.id}")
    return r.get("data", r)


def assets_create(args):
    data = {
        "name": args.name,
        "type": args.type,
        "content": resolve_content(args),
        "is_active": not args.inactive,
    }
    r = api("POST", "/external/assets", data)
    return r.get("data", r)


def assets_update(args):
    content = resolve_content(args)
    data = {}
    if args.name is not None:
        data["name"] = args.name
    if content is not None:
        data["content"] = content
    if args.is_active is not None:
        data["is_active"] = args.is_active
    if not data:
        _die(6, "nothing_to_update",
             "no fields to update; use --name, --content/--content-file, or --is-active")
    r = api("PATCH", f"/external/assets/{args.id}", data)
    return r.get("data", r)


def assets_delete(args):
    api("DELETE", f"/external/assets/{args.id}")
    return {"deleted": args.id}


# ===================================================================
# CALLS
# ===================================================================


def _apply_filters(query, filters):
    """Fold repeatable -f key=value filters into a query dict."""
    for filt in filters or []:
        k, _, v = filt.partition("=")
        if v:
            query[k] = v


def calls_list(args):
    query = {"sort": args.sort}
    if args.per_page:
        query["per_page"] = str(args.per_page)
    if args.page:
        query["page"] = str(args.page)
    _apply_filters(query, args.filter)
    result = api("GET", "/external/calls", query=query)

    def slim_call(c):
        core = ["id", "name", "phone", "status", "result", "direction",
                "duration", "created_at", "company_name", "invoice_amount"]
        s = _pick(c, core)
        for k, v in c.items():
            if k not in s and v is not None and k not in (
                "tenant_id", "project_id", "updated_at"
            ):
                s[k] = v
        return s

    return _result(result, slim=lambda r: _apply_slim(r, slim_call))


def calls_get(args):
    r = api("GET", f"/external/calls/{args.id}")
    return r.get("data", r)


def calls_create(args):
    r = api("POST", "/external/calls", args.payload or {})
    return r.get("data", r)


def calls_update(args):
    r = api("PATCH", f"/external/calls/{args.id}", _data(args.payload))
    return r.get("data", r)


def calls_delete(args):
    api("DELETE", f"/external/calls/{args.id}")
    return {"deleted": args.id}


def calls_batch(args):
    data = {"ids": args.ids, "updates": _data(args.payload)}
    r = api("PATCH", "/external/calls/batch", data)
    return r.get("data", r)


def calls_webhook_logs(args):
    query = {}
    if args.per_page:
        query["per_page"] = str(args.per_page)
    if args.page:
        query["page"] = str(args.page)
    if args.sort:
        query["sort"] = args.sort
    for filt in args.filter or []:
        k, _, v = filt.partition("=")
        if v and k != "related_call_id":  # forced by route
            query[k] = v
    result = api("GET", f"/external/calls/{args.call_id}/webhook-logs", query=query)
    return _result(result, slim=lambda r: _apply_slim(
        r, lambda log: _slim_webhook_log(log, include_call=False)))


