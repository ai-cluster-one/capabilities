# ===================================================================
# DOCTOR
# ===================================================================


def _check_connection(conn: dict) -> dict:
    """One connection's round-trip, reported rather than died — doctor covers
    every connection, so a broken one becomes a finding, not a stop."""
    out: dict = {"base_url": conn["base"], "key_env": conn["key_env"]}
    try:
        resp = httpx.get(conn["base"] + "/external/projects",
                         params={"per_page": "1"},
                         headers={"Authorization": f"Bearer {conn['api_key']}"},
                         timeout=TIMEOUT)
        if resp.status_code >= 400:
            cat = 2 if resp.status_code in (401, 403) else 5
            return out | {"ok": False, "category": cat,
                          "error": f"/external/projects returned {resp.status_code}"}
        projects = resp.json().get("data") or []
        return out | {"ok": True, "projects_visible": len(projects),
                      "sample_project": (projects[0].get("name") if projects else None)}
    except httpx.RequestError as e:
        return out | {"ok": False, "category": 5, "error": f"network error: {e}"}
    except ValueError as e:
        return out | {"ok": False, "category": 5, "error": f"bad response: {e}"}


def cmd_doctor(reg: dict | None, wanted: str | None,
               key_env_override: str | None, api_url_flag: str | None) -> None:
    """Every connection bare; one with --connection. Exit 0 only when every
    examined connection is healthy, else the first failure's category.
    key_env_override (--key-env) feeds _build_conn, overriding each examined
    entry's secret_env."""
    _doctor_gate(_connections_report(), wanted)
    if wanted is not None or reg is None:
        targets = [_select_connection(reg, wanted)]
    else:
        targets = list(reg["connections"].items())
    connections: dict = {}
    fail_exit = 0
    for cid, entry in targets:
        conn, problem = _build_conn(cid, entry, key_env_override, api_url_flag)
        if problem:
            res = {"ok": False, "category": problem["exit"],
                   "error": problem["message"]}
            if problem.get("hint"):
                res["hint"] = problem["hint"]
        else:
            res = _check_connection(conn)
        if not res.get("ok") and not fail_exit:
            fail_exit = res.get("category") or 5
        res.pop("category", None)
        connections[cid] = res
    _emit({"ok": fail_exit == 0, "connections": connections})
    if fail_exit:
        sys.exit(fail_exit)


# ===================================================================
# CLI Parser
# ===================================================================


def build_parser():
    parser = argparse.ArgumentParser(
        prog="callva",
        description="CallVA External API client — agent-first CRUD over the voice-AI platform.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subs = parser.add_subparsers(dest="resource", required=True)

    subs.add_parser("help", help="Print the full usage contract")
    subs.add_parser("doctor", help="Authenticated round-trip — prove readiness")

    # --- agents ---
    ag = subs.add_parser("agents", help="Manage voice agents")
    ag_sub = ag.add_subparsers(dest="action", required=True)
    ag_ls = ag_sub.add_parser("list", help="List all agents")
    ag_ls.add_argument("--is-active", type=parse_bool, default=None, help="Filter by active status")
    ag_sub.add_parser("default", help="Get or create the default agent")
    ag_get = ag_sub.add_parser("get", help="Get agent by ID")
    ag_get.add_argument("id", help="Agent UUID")
    ag_upd = ag_sub.add_parser("update", help="Update agent")
    ag_upd.add_argument("id", help="Agent UUID")
    ag_upd.add_argument("--name", help="Agent name")
    # Declared so the refusal can name where it moved: argparse's own
    # "unrecognized arguments" would send the caller looking for a typo.
    ag_upd.add_argument("--voice", help="Moved to the preset; see `callva presets`")
    ag_upd.add_argument("--prompt", help="Prompt text (inline)")
    ag_upd.add_argument("--prompt-file", help="Read prompt from file")
    ag_upd.add_argument("--greeting-type", choices=["prompt", "exact", "instruction"])
    ag_upd.add_argument("--greeting-exact", help="Exact greeting text")
    ag_upd.add_argument("--greeting-instruction", help="Greeting instruction")
    ag_upd.add_argument("--agent-speaks-first", type=parse_bool, default=None)
    ag_upd.add_argument("--config", dest="config_json", type=parse_json_arg, help="Config JSON (partial merge); beats a `config` key in --data")
    ag_upd.add_argument("--data", dest="payload", type=parse_json_arg, help="Base update payload as JSON; the flags above write over it")
    ag_cl = ag_sub.add_parser("clone", help="Copy an agent with every preset row it holds")
    ag_cl.add_argument("id", help="Agent UUID")
    ag_cl.add_argument("--name", help="Name for the copy; derived from the source when omitted")
    ag_del = ag_sub.add_parser("delete", help="Delete agent")
    ag_del.add_argument("id", help="Agent UUID")
    ag_cfg = ag_sub.add_parser("config", help="The configuration a call starts from (runs its start-of-call automation)")
    ag_cfg.add_argument("id", help="Agent UUID")
    ag_cfg.add_argument("--direction", choices=["inbound", "outbound"], default="inbound",
                        help="Which call to compose for (default inbound)")

    # --- presets ---
    pr = subs.add_parser("presets", help="The speech stack an agent runs on")
    pr_sub = pr.add_subparsers(dest="action", required=True)
    pr_sub.add_parser("catalog", help="List the presets this platform offers")
    pr_desc = pr_sub.add_parser("describe", help="What one preset takes, field by field")
    pr_desc.add_argument("preset", help="Preset id, from `presets catalog`")
    pr_desc.add_argument("--group", help="Only the fields in one group")
    pr_ls = pr_sub.add_parser("list", help="The presets an agent has configured")
    pr_ls.add_argument("agent_id", metavar="agent-id", help="Agent UUID")
    pr_get = pr_sub.add_parser("get", help="One agent's configuration of one preset")
    pr_get.add_argument("agent_id", metavar="agent-id", help="Agent UUID")
    pr_get.add_argument("preset", help="Preset id")
    pr_set = pr_sub.add_parser("set", help="Replace the configuration")
    pr_set.add_argument("agent_id", metavar="agent-id", help="Agent UUID")
    pr_set.add_argument("preset", help="Preset id")
    pr_set.add_argument("--config", dest="config_json", type=parse_json_arg,
                        help="The whole configuration as JSON")
    pr_set.add_argument("--config-file", help="Read the configuration from a file (- for stdin)")
    pr_pat = pr_sub.add_parser("patch", help="Merge into the configuration")
    pr_pat.add_argument("agent_id", metavar="agent-id", help="Agent UUID")
    pr_pat.add_argument("preset", help="Preset id")
    pr_pat.add_argument("--config", dest="config_json", type=parse_json_arg,
                        help="The keys to change, as JSON")
    pr_pat.add_argument("--config-file", help="Read the keys from a file (- for stdin)")
    pr_act = pr_sub.add_parser("activate", help="Run the agent's next call on this preset")
    pr_act.add_argument("agent_id", metavar="agent-id", help="Agent UUID")
    pr_act.add_argument("preset", help="Preset id")

    # --- tools ---
    tl = subs.add_parser("tools", help="What an agent can call, one record per tool")
    tl_sub = tl.add_subparsers(dest="action", required=True)
    tl_ls = tl_sub.add_parser("list", help="Every tool this agent holds")
    tl_ls.add_argument("agent_id", metavar="agent-id", help="Agent UUID")
    tl_get = tl_sub.add_parser("get", help="One tool, whole")
    tl_get.add_argument("agent_id", metavar="agent-id", help="Agent UUID")
    tl_get.add_argument("key", help="Tool name, exactly as stored (case-sensitive)")
    for name, parser_help in (("set", "Replace the record; fields left out take their defaults"),
                              ("patch", "Write only the fields named here")):
        tl_w = tl_sub.add_parser(name, help=parser_help)
        tl_w.add_argument("agent_id", metavar="agent-id", help="Agent UUID")
        tl_w.add_argument("key", help="Tool name, exactly as the worker reads it (case-sensitive)")
        tl_w.add_argument("--config", dest="config_json", type=parse_json_arg,
                          help="The tool body as a JSON object")
        tl_w.add_argument("--config-file", help="Read the body from a file (- for stdin)")
        tl_w.add_argument("--type", choices=["end_call", "http_request"],
                          help="Tool type; a tool found by module name carries none")
        tl_w.add_argument("--is-enabled", type=parse_bool, default=None,
                          help="Whether the agent is offered this tool")
        tl_w.add_argument("--position", type=int, help="Order the tools are offered in (>= 0)")
    tl_del = tl_sub.add_parser("delete", help="Remove one tool, leaving the rest")
    tl_del.add_argument("agent_id", metavar="agent-id", help="Agent UUID")
    tl_del.add_argument("key", help="Tool name, exactly as stored (case-sensitive)")

    # --- assets ---
    ast = subs.add_parser("assets", help="Manage assets (prompts, schemas, payloads)")
    ast_sub = ast.add_subparsers(dest="action", required=True)
    ast_ls = ast_sub.add_parser("list", help="List assets")
    ast_ls.add_argument("--type", choices=["prompt", "schema", "payload"], help="Filter by type")
    ast_ls.add_argument("--per-page", type=int, help="Results per page")
    ast_get = ast_sub.add_parser("get", help="Get asset by ID")
    ast_get.add_argument("id", help="Asset UUID")
    ast_cr = ast_sub.add_parser("create", help="Create asset")
    ast_cr.add_argument("--name", required=True, help="Asset name")
    ast_cr.add_argument("--type", required=True, choices=["prompt", "schema", "payload"])
    ast_cr.add_argument("--content", help="Content inline")
    ast_cr.add_argument("--content-file", help="Read content from file (- for stdin)")
    ast_cr.add_argument("--inactive", action="store_true")
    ast_upd = ast_sub.add_parser("update", help="Update asset")
    ast_upd.add_argument("id", help="Asset UUID")
    ast_upd.add_argument("--name", help="New name")
    ast_upd.add_argument("--content", help="New content inline")
    ast_upd.add_argument("--content-file", help="Read content from file (- for stdin)")
    ast_upd.add_argument("--is-active", type=parse_bool, default=None)
    ast_del = ast_sub.add_parser("delete", help="Delete asset")
    ast_del.add_argument("id", help="Asset UUID")

    # --- calls ---
    cl = subs.add_parser("calls", help="Manage call records")
    cl_sub = cl.add_subparsers(dest="action", required=True)
    cl_ls = cl_sub.add_parser("list", help="List calls")
    cl_ls.add_argument("--per-page", type=int, help="Results per page")
    cl_ls.add_argument("--page", type=int, help="Page number")
    cl_ls.add_argument("--sort", default="-created_at", help="Sort field (prefix - for desc)")
    cl_ls.add_argument("--filter", "-f", action="append",
                       help="Filter as key=value, e.g. -f status=complete (repeatable)")
    cl_get = cl_sub.add_parser("get", help="Get call details (full payload — dynamic fields)")
    cl_get.add_argument("id", help="Call UUID")
    cl_cr = cl_sub.add_parser("create", help="Create call record")
    cl_cr.add_argument("--data", dest="payload", type=parse_json_arg, help="Call fields as JSON")
    cl_upd = cl_sub.add_parser("update", help="Update call")
    cl_upd.add_argument("id", help="Call UUID")
    cl_upd.add_argument("--data", dest="payload", type=parse_json_arg, help="Fields to update as JSON")
    cl_del = cl_sub.add_parser("delete", help="Delete call")
    cl_del.add_argument("id", help="Call UUID")
    cl_batch = cl_sub.add_parser("batch", help="Batch update calls")
    cl_batch.add_argument("ids", nargs="+", help="Call UUIDs")
    cl_batch.add_argument("--data", dest="payload", type=parse_json_arg, help="Update fields as JSON")
    cl_wl = cl_sub.add_parser("webhook-logs", help="List webhook logs received for a specific call")
    cl_wl.add_argument("call_id", help="Call UUID")
    cl_wl.add_argument("--per-page", type=int, help="Results per page")
    cl_wl.add_argument("--page", type=int, help="Page number")
    cl_wl.add_argument("--sort", default="-received_at", help="Sort field (default: -received_at)")
    cl_wl.add_argument("--filter", "-f", action="append",
                       help="Extra filter as key=value (repeatable); related_call_id is forced from the route")
    cl_ar = cl_sub.add_parser("automation-runs",
                              help="List automation runs whose args carry the id as a nested call object, {\"call\":{\"id\":\"<call_id>\"}} (include_args=true by default)")
    cl_ar.add_argument("call_id", help="Call UUID")
    cl_ar.add_argument("--per-page", type=int, help="Results per page")
    cl_ar.add_argument("--page", type=int, help="Page number")
    cl_ar.add_argument("--filter", "-f", action="append",
                       help="Filter as key=value, e.g. -f status=success -f triggered_by=webhook (repeatable)")
    cl_ar.add_argument("--no-include-args", action="store_true",
                       help="Disable the default include_args=true")

    # --- transcripts ---
    tr = subs.add_parser("transcripts", help="Manage call transcripts")
