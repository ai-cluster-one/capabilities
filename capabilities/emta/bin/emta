# ─── Connections (capability-specific report) ────────────────────────────────

def _connections_report() -> dict:
    """The resolution report — local only, no network. EMTA has no
    env-resolvable credential (the session is paste-fed into state; see
    deviations.md), so each entry's `keys` list is empty — readiness is
    judged at use-time by `doctor`'s round-trip, not by the cascade."""
    reg, _ = _connections_registry()
    report: dict = {"default": None, "connections": {}}
    if reg is None:
        report["default"] = "default"
        report["connections"]["default"] = {"allow_write": WRITE_DEFAULT, "keys": []}
        return report
    conns = reg["connections"]
    report["default"] = reg.get("default") or \
        (next(iter(conns)) if len(conns) == 1 else None)
    for cid, entry in conns.items():
        entry = entry if isinstance(entry, dict) else {}
        report["connections"][cid] = {
            "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT)),
            "keys": []}
    return report


def _cmd_connections() -> None:
    _emit(_connections_report())


# ─── Identifier helpers (internal — the records adapter's identifiers) ───────

def _ids_get(label: str) -> str | None:
    """Read one ids value through the same records adapter `ids get` reads,
    coerced to str; None where the identifier source cannot be read, so the
    caller falls back as it does for an unset value. ints/floats (e.g.
    principalId written by `ids set` as a JSON number) become their str form
    so the resolver works regardless of whether the value was stored as
    "749..." or 749…. Bools, lists, dicts, and None do not coerce."""
    try:
        e = _records().resolve(NAME, "identifier").get(label) or {}
    except StoreError:
        return None  # an unreadable identifier source reads as unset
    v = e.get("value")
    if isinstance(v, str):
        return v
    if isinstance(v, bool):
        return None
    if isinstance(v, (int, float)):
        return str(v)
    return None


def _ids_set_silent(label: str, value, note: str = "") -> bool:
    """Write one project identifier through the records adapter `ids set`
    writes, without stdout side effects, so the ingest verb can auto-populate
    principal_person_id without polluting its own response. Returns True on
    success. Outside a project envelope, under the read-only switch (an
    identifier is a project record), and where the identifier source cannot be
    read or written, this writes nothing and returns False, so the caller
    falls back to the session."""
    if read_only_switch():
        return False
    envdir = _env_dir()
    if envdir is None or not envdir.parent.is_dir():
        return False
    try:
        records = _records()
        if (records.mode_of("identifier") == "store"
                and _project_id(write=True, refuse=False) is None):
            return False
        kept = note or ((records.resolve_scope(NAME, "identifier", "project")
                         .get(label) or {}).get("note") or "")
        records.set(NAME, "identifier", label, value,
                    actor=f"{NAME} session ingest", note=kept or None,
                    scope="project")
    except StoreError:
        return False
    return True


# ─── Session state (per connection) ──────────────────────────────────────────

def _session_file(cid: str) -> Path:
    """The stored session's one home — per connection, 0600 on write."""
    return _state_dir() / cid / "session.json"


def _load_session(cid: str) -> dict | None:
    p = _session_file(cid)
    if not p.exists():
        return None
    try:
        return json.loads(p.read_text())
    except (OSError, ValueError):
        return None


def _save_session(cid: str, session: dict) -> Path:
    p = _session_file(cid)
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(session, ensure_ascii=False, indent=2, sort_keys=True) + "\n")
    os.chmod(p, 0o600)
    return p


def _clear_session(cid: str) -> bool:
    p = _session_file(cid)
    if not p.exists():
        return False
    p.unlink()
    return True


# ─── cURL parsing (stdin) ────────────────────────────────────────────────────

_CURL_LINE_CONT = re.compile(r"\\\s*\n")


def _parse_curl(text: str) -> dict:
    """Parse a `Copy as cURL` paste. Returns
        {"url": str, "headers": dict[str,str], "cookies": dict[str,str]}.
    Header names are normalized to lowercase. Cookie sources merge: any
    `-b`/`--cookie` cookie strings AND the value of a `cookie:` header are
    all merged. Raises ValueError on malformed input."""
    if not text or not text.strip():
        raise ValueError("empty input")
    flat = _CURL_LINE_CONT.sub(" ", text.strip())
    # shlex is POSIX-quote aware: handles 'single', "double", and $'...' in zsh.
    # zsh's $'...' notation is preserved as-is by shlex (the leading $ stays);
    # cURL paste from Chrome uses plain '...' quoting, so this is safe.
    try:
        tokens = shlex.split(flat, posix=True)
    except ValueError as e:
        raise ValueError(f"could not tokenize cURL ({e})") from e
    if not tokens or tokens[0] != "curl":
        raise ValueError("expected the paste to start with `curl`")

    url: str | None = None
    headers: dict[str, str] = {}
    cookie_strs: list[str] = []
    i = 1
    while i < len(tokens):
        t = tokens[i]
        if t in ("-H", "--header"):
            if i + 1 >= len(tokens):
                raise ValueError(f"{t} without a value")
            _add_header(headers, tokens[i + 1])
            i += 2
        elif t.startswith("--header="):
            _add_header(headers, t.split("=", 1)[1])
            i += 1
        elif t in ("-b", "--cookie"):
            if i + 1 >= len(tokens):
                raise ValueError(f"{t} without a value")
            cookie_strs.append(tokens[i + 1])
            i += 2
        elif t.startswith("--cookie="):
            cookie_strs.append(t.split("=", 1)[1])
            i += 1
        elif t in ("--data", "--data-raw", "--data-binary",
                   "--data-urlencode", "-d"):
            # Skip the body (paste may include POST data; we don't need it).
            i += 2
        elif t in ("-X", "--request", "-A", "--user-agent",
                   "--compressed", "-i", "--include", "-L", "--location"):
            # Flags we ignore; -X/-A/--user-agent take one arg, others none.
            if t in ("-X", "--request", "-A", "--user-agent"):
                i += 2
            else:
                i += 1
        elif t.startswith("-"):
            # Unknown flag → skip; some Chrome variants emit extras.
            i += 1
        else:
            if url is None:
                url = t
            i += 1

    if url is None:
        raise ValueError("no URL found in the cURL paste")

    # Cookie can also arrive as a `cookie:` request header.
    hcookie = headers.pop("cookie", None)
    if hcookie:
        cookie_strs.append(hcookie)

    cookies: dict[str, str] = {}
    for cs in cookie_strs:
        for pair in cs.split(";"):
            if "=" in pair:
                k, _, v = pair.strip().partition("=")
                k = k.strip()
                if k:
                    cookies[k] = v.strip()

    return {"url": url, "headers": headers, "cookies": cookies}


def _add_header(headers: dict, raw: str) -> None:
    if ":" not in raw:
        return
    name, _, value = raw.partition(":")
    headers[name.strip().lower()] = value.strip()


# ─── HTTP — authed calls with the stored bearer ──────────────────────────────

_STALE_HINT = (
    "Paste a fresh `Copy as cURL` via `emta session ingest` — open a logged-in "
    "maasikas.emta.ee browser, devtools → Network → any "
    "/payments-and-settlements-api/ request → Copy as cURL → pipe stdin to "
    "`emta session ingest`."
)


def _send(session: dict, path: str, params: dict | None,
          person_id: str | None) -> httpx.Response:
    """One authed GET against /payments-and-settlements-api/<path>. The
    bearer + xsrf + cookies come from `session`; `person_id` is sent as the
    `x-principal-person-id` header on every call except /client/session-user
    (which is the only authed path that does not require it, and the path
    used to discover person_id in the first place). Timeouts/5xx/429
    retried per MAX_RETRIES; 4xx is returned as-is for the caller to map."""
    bearer = session.get("bearer")
    xsrf = session.get("xsrf")
    if not bearer or not xsrf:
        _die(2, "session_stale",
             "stored session is missing the bearer or PAS-XSRF-TOKEN",
             _STALE_HINT)
    cookies = {k: v for k, v in (session.get("cookies") or {}).items() if v}
    cookies["PAS-AUTHORIZATION"] = bearer
    cookies["language"] = "et"
    headers = {
        "User-Agent": UA,
        "Accept": "application/json, text/plain, */*",
        "Authorization": f"Bearer {bearer}",
        "x-xsrf-token": xsrf,
        "Referer": HOST + "/customer-portal/client",
        "language": "et",
    }
    if person_id:
        headers["x-principal-person-id"] = str(person_id)
    url = API_BASE + "/" + path.lstrip("/")
    last_status: int | None = None
    for attempt in range(1, MAX_RETRIES + 1):
        try:
            with httpx.Client(timeout=TIMEOUT, follow_redirects=False) as c:
                r = c.get(url, params=params or {}, headers=headers, cookies=cookies)
        except httpx.TimeoutException:
            if attempt < MAX_RETRIES:
                time.sleep(attempt * 1.5); continue
            _die(5, "timeout", f"GET {path} timed out",
                 "maasikas.emta.ee was unresponsive")
        except httpx.RequestError as e:
            _die(5, "network_error", f"GET {path} network error: {e}",
                 "check connectivity to maasikas.emta.ee")
        last_status = r.status_code
        if r.status_code >= 500:
            if attempt < MAX_RETRIES:
                time.sleep(attempt * 1.5); continue
            _die(5, "server_error", f"maasikas.emta.ee returned {r.status_code}",
                 status=r.status_code)
        if r.status_code == 429:
            ra = float(r.headers.get("Retry-After", str(attempt * 1.5)))
            if attempt < MAX_RETRIES:
                time.sleep(ra); continue
            _die(5, "rate_limited", "rate-limited", status=429)
        return r
    _die(5, "exhausted_retries",
         f"exhausted {MAX_RETRIES} attempts on GET {path}", status=last_status)


def _data_call(session: dict, path: str,
               params: dict | None = None) -> dict | list:
    """GET an authenticated /payments-and-settlements-api/ path with the
    stored bearer. 401/406 collapses to one altitude — there is no
    programmatic refresh — so the user pastes a fresh cURL."""
    person_id = (_ids_get("principal_person_id")
                 or session.get("principal_person_id_fallback"))
    if not person_id:
        _die(6, "missing_identifier",
             "principal_person_id is not set",
             "run `emta session ingest` (auto-discovers via session-user) or "
             "`emta ids set principal_person_id <value>`")
    r = _send(session, path, params, person_id=str(person_id))
    return _decode(r, path)


def _decode(r: httpx.Response, path: str):
    if r.status_code in (401, 406):
        _die(2, "session_stale",
             f"GET {path} returned {r.status_code} — session is stale",
             _STALE_HINT, status=r.status_code)
    if r.status_code == 403:
        _die(2, "unauthorized", f"GET {path} returned 403",
             _STALE_HINT, status=403)
    if r.status_code == 404:
        _die(3, "not_found", f"GET {path} returned 404", status=404)
    if r.status_code >= 400:
        body = r.text[:500]
        _die(6, "bad_request", f"GET {path} returned {r.status_code}: {body}",
             status=r.status_code)
    try:
        return r.json()
    except ValueError:
        _die(5, "invalid_response", f"GET {path} returned non-JSON",
             status=r.status_code)


def _extract_principal_id(body) -> str | None:
    """Pluck `data.principal.principalId` from a /client/session-user body
    and coerce to str (the API returns it as a JSON number). The response
    envelope wraps everything under a top-level "data" key:
        {"data": {"principal": {"principalId": <int>, ...}, ...}, "ok": true}
    """
    if not isinstance(body, dict):
        return None
    inner = body.get("data")
    if not isinstance(inner, dict):
        return None
    principal = inner.get("principal")
    if not isinstance(principal, dict):
        return None
    pid = principal.get("principalId")
    if pid is None or isinstance(pid, bool):
        return None
    if isinstance(pid, (str, int, float)):
        return str(pid)
    return None


def _bootstrap(cid: str, session: dict) -> dict:
    """GET /client/session-user with stored bearer + xsrf + cookies — the
    one authed call that needs no x-principal-person-id. On 200, refresh
    the ids store with `principal.principalId`. Returns
        {"ok": bool, "status": int, "ids_action"?: str, "error"?: str}.
    Does NOT exit on auth failure — the caller decides exit semantics."""
    r = _send(session, SESSION_USER_PATH, params=None, person_id=None)
    if r.status_code != 200:
        return {"ok": False, "status": r.status_code}
    try:
        data = r.json()
    except ValueError:
        return {"ok": False, "status": 200,
                "error": "session-user returned non-JSON"}
    pid = _extract_principal_id(data)
    if not pid:
        return {"ok": True, "status": 200, "ids_action": "no_principal_in_response"}
    existing = _ids_get("principal_person_id")
    if existing == pid:
        return {"ok": True, "status": 200, "ids_action": "unchanged"}
    action = "updated" if existing else "set"
    if _ids_set_silent(
            "principal_person_id", pid,
            note="discovered from /client/session-user; sent as the "
                 "x-principal-person-id header on every data call"):
        return {"ok": True, "status": 200, "ids_action": action}
    # No project envelope to write into, an identifier source that cannot be
    # read or written, or the read-only switch keeps the project's identifiers
    # as they are — stash in the session as a fallback
    # so the same process and later invocations on this connection still work.
    session["principal_person_id_fallback"] = pid
    _save_session(cid, session)
    return {"ok": True, "status": 200, "ids_action": "session_fallback"}


# ─── Domain verbs ────────────────────────────────────────────────────────────

def _now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


_PAS_PASTE_HINT = (
    "Copy a request whose URL contains `/payments-and-settlements-api/`: "
    "in devtools → Network, filter by `payments-and-settlements-api`, "
    "reload, right-click any listed XHR (e.g. `session-user` or "
    "`prepay/account/active`) → Copy → Copy as cURL → "
    "`pbpaste | emta session ingest`. NOT the customer-portal page, NOT "
    "the access-token request, NOT anything under customer-kmd2/."
)


def _non_pas_diagnosis(missing: str, url: str) -> str:
    """Compose a bad_curl message that names what is missing AND the most
    likely reason — the paste is from a non-PAS surface. The cURL's URL
    pins down which surface it actually came from when it is recognisable."""
    surface = ""
    low = url.lower()
    if "/payments-and-settlements-api/" in low:
        surface = ("the URL is on the PAS surface but the request did not "
                   "carry full PAS auth — pick a different PAS XHR (most do)")
    elif "/customer-portal/" in low and "access-token" in low:
        surface = ("the paste is the `/customer-portal/access-token` "
                   "bootstrap — that is the browser's internal login; "
                   "it carries no PAS bearer")
    elif "/customer-portal/" in low:
        surface = ("the paste is a `/customer-portal/` page (document) "
                   "request — only PAS XHRs carry the bearer")
    elif "customer-kmd2" in low:
        surface = ("the paste is from the customer-kmd2 Wicket app — a "
                   "different surface this capability does not read")
    else:
        surface = ("the paste does not look like a PAS XHR (URL: "
                   f"{url or '<empty>'})")
    return f"{missing} — {surface}"


def _cmd_session_ingest(cid: str) -> None:
    """Read a `Copy as cURL` paste on stdin (argv refused — secrets do not
    sit on the command line). Extract bearer + xsrf + cookie jar, persist
    them, then bootstrap via /client/session-user to auto-discover
    principal_person_id."""
    if sys.stdin.isatty():
        _die(6, "stdin_required",
             "paste a `Copy as cURL` on stdin",
             "e.g. `pbpaste | emta session ingest`")
    raw = sys.stdin.read()
    try:
        parsed = _parse_curl(raw)
    except ValueError as e:
        _die(6, "bad_curl", f"could not parse the cURL paste: {e}",
             "copy a fresh `Copy as cURL` from devtools → Network → any "
             "/payments-and-settlements-api/ XHR")

    cookies = parsed["cookies"]
    headers = parsed["headers"]
    url = parsed.get("url") or ""

    # Bearer: prefer the Authorization header; fall back to the
    # PAS-AUTHORIZATION cookie (Chrome puts the same value in both).
    bearer = None
    auth = headers.get("authorization")
    if auth and auth.lower().startswith("bearer "):
        bearer = auth.split(" ", 1)[1].strip()
    if not bearer:
        bearer = cookies.get("PAS-AUTHORIZATION")
    if not bearer:
        _die(6, "bad_curl",
             _non_pas_diagnosis("no PAS bearer (no `Authorization: Bearer …` "
                                "header and no `PAS-AUTHORIZATION` cookie)",
                                url),
             _PAS_PASTE_HINT)

    xsrf = headers.get("x-xsrf-token") or cookies.get("PAS-XSRF-TOKEN")
    if not xsrf:
        _die(6, "bad_curl",
             _non_pas_diagnosis("no PAS-XSRF-TOKEN (neither the cookie nor "
                                "the `x-xsrf-token` header was present)",
                                url),
             _PAS_PASTE_HINT)

    # Cookies retained: the PAS-path session anchors + the XSRF cookie.
    # PAS-AUTHORIZATION is excluded — it lives separately under session["bearer"]
    # and is re-attached as a cookie on every call.
    kept = {k: cookies[k] for k in SESSION_COOKIE_NAMES
            if k in cookies and cookies[k]}
    if "customer-kmd2_JSESSIONID" not in kept:
        _die(6, "bad_curl",
             _non_pas_diagnosis("no `customer-kmd2_JSESSIONID` cookie", url),
             _PAS_PASTE_HINT)

    session = {
        "bearer": bearer,
        "xsrf": xsrf,
        "cookies": kept,
        "ingested_at": _now_iso(),
    }
    path = _save_session(cid, session)

    # Bootstrap: session-user verifies the bearer end-to-end and yields the
    # principalId — exactly the value the data verbs need.
    boot = _bootstrap(cid, session)

    out = {
        "connection": cid,
        "state_file": str(path),
        "bearer_stored": True,
        "xsrf_stored": True,
        "cookies_stored": sorted(kept.keys()),
        "ingested_at": session["ingested_at"],
        "bootstrap": boot,
    }
    _emit(out)
    if not boot.get("ok"):
        sys.exit(2)


def _cmd_session_show(cid: str) -> None:
    session = _load_session(cid)
    if session is None:
        _emit({"connection": cid, "stored": False})
        return
    cookies = session.get("cookies") or {}
    _emit({
        "connection": cid,
        "stored": True,
        "state_file": str(_session_file(cid)),
        "bearer_stored": bool(session.get("bearer")),
        "xsrf_stored": bool(session.get("xsrf")),
        "cookies_stored": sorted(k for k, v in cookies.items() if v),
        "ingested_at": session.get("ingested_at"),
        "principal_person_id_in_ids": bool(_ids_get("principal_person_id")),
        "principal_person_id_in_session_fallback":
            bool(session.get("principal_person_id_fallback")),
    })


def _cmd_session_clear(cid: str) -> None:
    removed = _clear_session(cid)
    _emit({"connection": cid, "cleared": removed,
           "state_file": str(_session_file(cid))})


def _require_session(cid: str) -> dict:
    session = _load_session(cid)
    if session is None:
        _die(2, "session_stale",
             f"no session stored for connection {cid!r}",
             _STALE_HINT)
    return session


def _check_connection(cid: str) -> dict:
    """One connection's round-trip — load session, GET /client/session-user.
    On 200, refresh principal_person_id in ids. Reported (not died) so
    doctor can cover every connection."""
    session = _load_session(cid)
    if session is None:
        return {"ok": False, "category": 2,
                "error": "no session stored for this connection",
                "hint": _STALE_HINT}
    if not session.get("bearer"):
        return {"ok": False, "category": 2,
                "error": "stored session has no bearer",
                "hint": _STALE_HINT}
    if not session.get("xsrf"):
        return {"ok": False, "category": 2,
                "error": "stored session has no PAS-XSRF-TOKEN",
                "hint": _STALE_HINT}
    boot = _bootstrap(cid, session)
    if boot.get("ok"):
        return {"ok": True, "session": "live",
                "ingested_at": session.get("ingested_at"),
                "principal_person_id": boot.get("ids_action", "unchanged")}
    status = boot.get("status")
    if status in (401, 406):
        return {"ok": False, "category": 2,
                "error": f"/client/session-user returned {status} — session stale",
                "hint": _STALE_HINT}
    return {"ok": False, "category": 5,
            "error": f"/client/session-user returned {status}"}


def _cmd_doctor(wanted: str | None) -> None:
    """Per-connection health — every connection bare; one with --connection.
    Exit 0 only when every examined connection is healthy."""
    _doctor_gate(_connections_report(), wanted)
    reg, _ = _connections_registry()
    if wanted is not None or reg is None:
        targets = [_select_connection(reg, wanted)]
    else:
        targets = list(reg["connections"].items())
    connections: dict = {}
    fail_exit = 0
    for cid, _entry in targets:
        res = _check_connection(cid)
        if not res.get("ok") and not fail_exit:
            fail_exit = res.get("category") or 5
        res.pop("category", None)
        connections[cid] = res
    _emit({"ok": fail_exit == 0, "connections": connections})
    if fail_exit:
        sys.exit(fail_exit)


def _cmd_balances(cid: str) -> None:
    session = _require_session(cid)
    _emit(_data_call(session, "client/prepay/account/active",
                     params={"isBankruptcyPeriod": "false"}))


_DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")


def _validate_date(label: str, raw: str) -> str:
    if not _DATE_RE.match(raw):
        _die(6, "bad_date", f"{label} must be YYYY-MM-DD, got {raw!r}")
    try:
        datetime.strptime(raw, "%Y-%m-%d")
    except ValueError as e:
        _die(6, "bad_date", f"{label} is not a valid date: {e}")
    return raw


_PERIOD_ROW_KEY = ("taxPeriodCode", "claimTypeCode", "documentNr")


def _dedup_period_rows(payload):
    """tax-period-balances and tax-period-interest sometimes return the same
    row twice on the wire. De-dup the `data` array in place on the natural
    key (taxPeriodCode, claimTypeCode, documentNr); first occurrence wins
    so order is preserved. Non-dict / non-list payloads are returned as-is."""
    if not isinstance(payload, dict):
        return payload
    rows = payload.get("data")
    if not isinstance(rows, list):
        return payload
    seen: set = set()
    out: list = []
    for row in rows:
        if not isinstance(row, dict):
            out.append(row); continue
        key = tuple(row.get(k) for k in _PERIOD_ROW_KEY)
        if key in seen:
            continue
        seen.add(key)
        out.append(row)
    payload["data"] = out
    return payload


def _cmd_period_balances(cid: str, date: str) -> None:
    _validate_date("--date", date)
    session = _require_session(cid)
    _emit(_dedup_period_rows(
        _data_call(session,
                   "client/claim/accrual/tax-period-balances",
                   params={"queryDate": date})))


def _cmd_interest(cid: str, date: str) -> None:
    _validate_date("--date", date)
    session = _require_session(cid)
    _emit(_dedup_period_rows(
        _data_call(session,
                   "client/claim/accrual/tax-period-interest",
                   params={"queryDate": date})))


def _cmd_ledger(cid: str, dfrom: str, dto: str) -> None:
    _validate_date("--from", dfrom)
    _validate_date("--to", dto)
    if dfrom[:4] != dto[:4]:
        _die(6, "multi_year_span",
             f"--from ({dfrom}) and --to ({dto}) are in different calendar years",
             "EMTA refuses multi-year spans; split into per-year calls")
    if dfrom > dto:
        _die(6, "bad_range", f"--from ({dfrom}) is after --to ({dto})")
    session = _require_session(cid)
    _emit(_data_call(session,
                     "client/prepay/account/transaction/search",
                     params={"dateFrom": dfrom, "dateTo": dto}))


# ─── CLI dispatch ────────────────────────────────────────────────────────────

def _opt(cleaned: list[str], name: str) -> str | None:
    if name in cleaned:
        i = cleaned.index(name)
        if i + 1 >= len(cleaned):
            _die(6, "input", f"{name} needs a value")
        return cleaned[i + 1]
    for tok in cleaned:
        if tok.startswith(name + "="):
            return tok.split("=", 1)[1]
    return None


def main() -> None:
    global _WANTED_CONN, _ACTIVE_VERB
    _gate()                          # every verb passes the effective policy gate first

    # `--connection <id>` extracted before dispatch so it works anywhere on
    # the line, including after the verb. Selection itself stays lazy:
    # `help`, the contract verbs, and the session verbs use no connection
    # config beyond the connection id key for state.
    argv = sys.argv[1:]
    cleaned: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--connection" and i + 1 < len(argv):
            _WANTED_CONN = argv[i + 1]; i += 2; continue
        if a.startswith("--connection="):
            _WANTED_CONN = a.split("=", 1)[1]; i += 1; continue
        cleaned.append(a); i += 1

    _ACTIVE_VERB = cleaned[0] if cleaned else ""

    if not cleaned or cleaned[0] in ("help", "--help", "-h"):
        sys.stdout.write((__doc__ or "").lstrip("\n"))
        sys.stdout.write(_connections_home_section())
        return

    _contract(cleaned)               # contract verbs; falls through otherwise

    verb = cleaned[0]

    # Resolve the connection id (used by state-keyed verbs even before any
    # auth call), via the same deterministic selector every capability uses.
    reg, _reg_path = _connections_registry()
    if verb == "doctor":
        _cmd_doctor(_WANTED_CONN)
        return

    cid, entry = _select_connection(reg, _WANTED_CONN)
    allow_write = WRITE_DEFAULT if entry is None else \
        bool(entry.get("allow_write", WRITE_DEFAULT))
    _write_gate(cid, allow_write, verb)

    if verb == "session":
        if len(cleaned) < 2:
            _die(6, "input",
                 "usage: emta session ingest|show|clear [--connection <id>]")
        sub = cleaned[1]
        if sub == "ingest":
            _cmd_session_ingest(cid)
        elif sub == "show":
            _cmd_session_show(cid)
        elif sub == "clear":
            _cmd_session_clear(cid)
        else:
            _die(6, "input", f"unknown session subcommand {sub!r}",
                 "emta session ingest|show|clear")
        return

    if verb == "balances":
        _cmd_balances(cid)
        return

    if verb == "period-balances":
        date = _opt(cleaned, "--date")
        if not date:
            _die(6, "input", "period-balances requires --date YYYY-MM-DD")
        _cmd_period_balances(cid, date)
        return

    if verb == "interest":
        date = _opt(cleaned, "--date")
        if not date:
            _die(6, "input", "interest requires --date YYYY-MM-DD")
        _cmd_interest(cid, date)
        return

    if verb == "ledger":
        dfrom = _opt(cleaned, "--from")
        dto = _opt(cleaned, "--to")
        if not dfrom or not dto:
            _die(6, "input",
                 "ledger requires --from YYYY-MM-DD and --to YYYY-MM-DD")
        _cmd_ledger(cid, dfrom, dto)
        return

    _die(6, "unknown_command", f"unknown command {verb!r}",
         "run `emta help` for the contract")


if __name__ == "__main__":
    main()
