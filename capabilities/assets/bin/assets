_contract_bind(globals(), "connections")


# ── the file store connection ────────────────────────────────────────────────

BUCKET_FIELDS = ("endpoint", "region", "bucket")
SECRET_FIELDS = ("access_key_id_env", "secret_access_key_env")
_BUCKET_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,254}")
_REGION_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]{0,63}")
_CONNECTION_HINT = (f"`{NAME} connection add <id> --field endpoint=<url> --field region=<region> "
                    "--field bucket=<bucket> --stdin` with the two keys in the JSON object on "
                    "stdin; `capabilities set` grants it")


def _connections_report() -> dict:
    """The resolution report: every file store connection, every value, its
    winning tier and source, the two keys masked. Local only. Without a
    registry the registry read refuses `connections_required`, as for every
    connection-bearing capability."""
    reg, _ = _connections_registry()
    conns = reg["connections"]
    report: dict = {
        "default": reg.get("default") or (next(iter(conns)) if len(conns) == 1 else None),
        "connections": {}}
    for cid, entry in conns.items():
        entry = entry if isinstance(entry, dict) else {}
        origin = (reg.get("sources") or {}).get(cid)
        keys = []
        for field in BUCKET_FIELDS:
            value = entry.get(field)
            value = str(value) if value not in (None, "") else None
            keys.append(_key_report(field, False, True, value, "connection", origin))
        for field in SECRET_FIELDS:
            env_key = entry.get(field)
            if env_key:
                value, tier, source = _resolve_env_key(str(env_key))
                keys.append(_key_report(str(env_key), True, True, value, tier, source))
            else:
                keys.append(_key_report(field, False, True, None, None, None))
        report["connections"][cid] = {
            "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT)), "keys": keys}
    return report


def _cmd_connections() -> None:
    _emit(_connections_report())


class _BucketError(Exception):
    """A refusal from, or on the way to, the bucket: raised rather than died
    with, so a verb over many files can report it per file."""

    def __init__(self, exit_code: int, code: str, message: str,
                 hint: str | None = None, status: int | None = None):
        super().__init__(message)
        self.exit_code, self.code, self.message = exit_code, code, message
        self.hint, self.status = hint, status

    def out(self) -> dict:
        return {k: v for k, v in (("code", self.code), ("error", self.message),
                                  ("hint", self.hint), ("status", self.status)) if v is not None}


def _bucket_refused(exc: _BucketError) -> NoReturn:
    _die(exc.exit_code, exc.code, exc.message, exc.hint, exc.status)


def _connection_grants() -> dict:
    """Every file store connection this project could see, by id, and whether
    it may use it - read as the registry is read, so a record that cannot be
    read refuses here as it would there; only an absent registry is none."""
    try:
        effective = _records().connections(NAME, write_default=WRITE_DEFAULT,
                                           include_disabled=True,
                                           machine_read=_machine_read()) or {}
    except StoreError as e:
        _die(5 if e.slug in STORE_ENVIRONMENT_SLUGS else 6, e.slug, e.message, e.hint)
    return {cid: bool(entry.get("enabled")) for cid, entry in effective.items()}


def _usable_connections() -> tuple[int, int]:
    """How many file store connections this project could see, and how many of
    them it may use."""
    grants = _connection_grants()
    return len(grants), sum(grants.values())


def _file_store(wanted: str | None, verb: str, *, required: bool):
    """The bucket of the selected file store connection, or (None, why) when
    none is configured and the verb can do without one. A verb that cannot -
    or a --connection given - selects as every capability selects, so the
    refusal is the contract's own."""
    if not required and not wanted:
        seen, usable = _usable_connections()
        if not seen:
            return None, "no file store connection is configured"
        if not usable:
            return None, "no file store connection is granted to this project"
    reg, _ = _connections_registry()
    cid, entry = _select_connection(reg, wanted)
    _write_gate(cid, bool((entry or {}).get("allow_write", WRITE_DEFAULT)), verb)
    try:
        return _Bucket.of(cid, entry or {}), None
    except _BucketError as exc:
        _bucket_refused(exc)


# ── the bucket: S3 over HTTP, path-style, AWS Signature Version 4 ────────────

S3_TIMEOUT = 60.0
S3_RETRIES = 3
SINGLE_PUT_MAX = 5 * 1024 ** 3      # the largest object one S3 PUT carries
STORAGE_KEY_MAX = 1024              # S3's limit on an object key, in UTF-8 bytes
_EMPTY_SHA256 = hashlib.sha256(b"").hexdigest()


def _uri_encode(text: str) -> str:
    """SigV4's URI encoding: every byte but the unreserved characters."""
    from urllib.parse import quote
    return quote(text, safe="-_.~")


def _s3_error(body: bytes) -> tuple[str | None, str | None]:
    text = body.decode("utf-8", "replace")
    code = re.search(r"<Code>([^<]*)</Code>", text)
    message = re.search(r"<Message>([^<]*)</Message>", text)
    return (code.group(1) if code else None), (message.group(1) if message else None)


class _Bucket:
    """One file store connection, resolved: where the bucket is and the keys
    that sign for it. Every request is signed whole - the payload's sha256 is
    in the signature, so the store refuses bytes that changed on the way."""

    def __init__(self, cid: str, endpoint: str, region: str, bucket: str,
                 access_key: str, secret_key: str):
        from urllib.parse import urlsplit
        parts = urlsplit(endpoint)
        self.cid, self.endpoint, self.region, self.bucket = cid, endpoint, region, bucket
        self.scheme = parts.scheme
        self.host = parts.hostname.lower() if parts.hostname else ""
        default_port = {"http": 80, "https": 443}[parts.scheme]
        self.netloc = self.host if parts.port in (None, default_port) else \
            f"{self.host}:{parts.port}"
        if ":" in self.host:        # an IPv6 literal keeps its brackets in Host
            self.netloc = f"[{self.host}]" + ("" if parts.port in (None, default_port)
                                              else f":{parts.port}")
        self.prefix = "/".join(_uri_encode(p) for p in parts.path.rstrip("/").split("/"))
        self._access, self._secret = access_key, secret_key
        self._client = None

    @classmethod
    def of(cls, cid: str, entry: dict) -> "_Bucket":
        missing = [f for f in BUCKET_FIELDS if entry.get(f) in (None, "")]
        if missing:
            raise _BucketError(6, "incomplete_connection",
                               f"file store connection {cid!r} is missing: "
                               f"{', '.join(missing)}", _CONNECTION_HINT)
        from urllib.parse import urlsplit
        endpoint = str(entry["endpoint"]).strip()
        parts = urlsplit(endpoint)
        if parts.scheme not in ("http", "https") or not parts.hostname \
                or parts.query or parts.fragment or parts.username or parts.password:
            raise _BucketError(6, "bad_endpoint",
                               f"connection {cid!r}: endpoint {endpoint!r} is not an http(s) "
                               "URL of a host, with no query, fragment or credentials",
                               "e.g. https://<account>.r2.cloudflarestorage.com")
        try:
            parts.port
        except ValueError:
            raise _BucketError(6, "bad_endpoint",
                               f"connection {cid!r}: endpoint {endpoint!r} has a bad port")
        bucket, region = str(entry["bucket"]).strip(), str(entry["region"]).strip()
        if not _BUCKET_NAME.fullmatch(bucket):
            raise _BucketError(6, "bad_bucket", f"connection {cid!r}: {bucket!r} is not a "
                               "bucket name", "letters, digits, `.`, `-` and `_`, e.g. "
                               "example-bucket")
        if not _REGION_NAME.fullmatch(region):
            raise _BucketError(6, "bad_region", f"connection {cid!r}: {region!r} is not a "
                               "region", "auto for R2, the bucket's region for AWS S3, "
                               "us-east-1 for most other stores")
        keys = []
        for field in SECRET_FIELDS:
            env_key = entry.get(field)
            if not env_key:
                raise _BucketError(6, "no_secret_env",
                                   f"file store connection {cid!r} is missing: {field}",
                                   _CONNECTION_HINT)
            value = _resolve_env_key(str(env_key))[0]
            if not value:
                raise _BucketError(2, "missing_credentials",
                                   f"env var {env_key} (for connection {cid!r}) is unset",
                                   f"set {env_key} in the project's .env.local or .env, "
                                   f"{CREDENTIALS_ENV}, or the environment")
            keys.append(value)
        return cls(cid, endpoint, region, bucket, *keys)

    def _path(self, key: str | None) -> str:
        path = f"{self.prefix}/{_uri_encode(self.bucket)}"
        if key is not None:
            path += "/" + "/".join(_uri_encode(part) for part in key.split("/"))
        return path

    def _signed(self, method: str, path: str, query: str, payload_sha: str,
                extra: dict) -> dict:
        import datetime
        import hmac
        now = datetime.datetime.now(datetime.timezone.utc)
        stamp, day = now.strftime("%Y%m%dT%H%M%SZ"), now.strftime("%Y%m%d")
        signed = {"host": self.netloc, "x-amz-content-sha256": payload_sha,
                  "x-amz-date": stamp}
        names = ";".join(sorted(signed))
        canonical = "\n".join([method, path, query,
                               "".join(f"{k}:{signed[k]}\n" for k in sorted(signed)),
                               names, payload_sha])
        scope = f"{day}/{self.region}/s3/aws4_request"
        to_sign = "\n".join(["AWS4-HMAC-SHA256", stamp, scope,
                             hashlib.sha256(canonical.encode()).hexdigest()])
        key = ("AWS4" + self._secret).encode()
        for part in (day, self.region, "s3", "aws4_request"):
            key = hmac.new(key, part.encode(), hashlib.sha256).digest()
        signature = hmac.new(key, to_sign.encode(), hashlib.sha256).hexdigest()
        return {"Host": self.netloc, "x-amz-content-sha256": payload_sha,
                "x-amz-date": stamp, **extra,
                "Authorization": f"AWS4-HMAC-SHA256 Credential={self._access}/{scope}, "
                                 f"SignedHeaders={names}, Signature={signature}"}

    def _request(self, method: str, key: str | None, *, query: dict | None = None,
                 body: bytes = b"", payload_sha: str = _EMPTY_SHA256,
                 headers: dict | None = None, missing: str = "no_such_key"):
        """One request with bounded, backed-off retries of what is transient:
        a timeout, a lost connection, 429 and 5xx. Every attempt is signed
        afresh. A 4xx is the store's answer and is not retried."""
        import time
        import httpx
        if self._client is None:
            self._client = httpx.Client(timeout=httpx.Timeout(S3_TIMEOUT),
                                        follow_redirects=False)
        path = self._path(key)
        qs = "&".join(f"{_uri_encode(k)}={_uri_encode(v)}"
                      for k, v in sorted((query or {}).items()))
        url = f"{self.scheme}://{self.netloc}{path}" + (f"?{qs}" if qs else "")
        what = f"{method} {self.bucket}/{key}" if key is not None else f"{method} {self.bucket}"
        status = None
        for attempt in range(1, S3_RETRIES + 1):
            try:
                resp = self._client.request(
                    method, url, content=body if method == "PUT" else None,
                    headers=self._signed(method, path, qs, payload_sha, headers or {}))
            except httpx.TimeoutException:
                if attempt < S3_RETRIES:
                    time.sleep(attempt * 1.5)
                    continue
                raise _BucketError(5, "timeout", f"the file store did not answer: {what}",
                                   f"check that {self.endpoint} is reachable")
            except httpx.RequestError as exc:
                if attempt < S3_RETRIES:
                    time.sleep(attempt * 1.5)
                    continue
                raise _BucketError(5, "network_error", f"cannot reach the file store "
                                   f"{self.endpoint}: {exc}", "check connectivity")
            status = resp.status_code
            if status == 429 or status >= 500:
                if attempt < S3_RETRIES:
                    try:
                        pause = float(resp.headers.get("Retry-After", ""))
                    except ValueError:
                        pause = attempt * 1.5
                    time.sleep(min(pause, 30.0))
                    continue
                code, message = _s3_error(resp.content)
                raise _BucketError(5, "rate_limited" if status == 429 else "server_error",
                                   f"the file store answered {status} to {what}"
                                   + (f": {code} {message or ''}".rstrip() if code else ""),
                                   status=status)
            if status < 300:
                return resp
            code, message = _s3_error(resp.content)
            said = f"{code}: {message}" if code and message else (code or message or
                                                                  f"HTTP {status}")
            if status in (401, 403):
                raise _BucketError(2, "unauthorized", f"the file store refused {what}: {said}",
                                   f"check the keys connection {self.cid!r} names, the "
                                   "region it signs for, and the machine's clock; "
                                   f"`{NAME} connections` shows where they resolve",
                                   status=status)
            if status == 404 and code == "NoSuchBucket":
                raise _BucketError(3, "no_such_bucket", f"the file store has no bucket "
                                   f"{self.bucket!r}", f"create it, or name the bucket "
                                   f"connection {self.cid!r} should use", status=status)
            if status == 404 and method != "PUT" and missing == "object_missing":
                raise _BucketError(8, "object_missing", f"the bucket holds no object for "
                                   f"{key!r}, which its record says is there",
                                   "the file's record is kept; put its bytes again with "
                                   f"`{NAME} files add`", status=status)
            raise _BucketError(3 if status == 404 else 6, "not_found" if status == 404
                               else "bucket_refused", f"the file store refused {what}: {said}",
                               status=status)
        raise _BucketError(5, "exhausted_retries", f"{S3_RETRIES} attempts at {what} failed",
                           status=status)

    def put(self, key: str, data: bytes, sha256: str, media_type: str) -> None:
        self._request("PUT", key, body=data, payload_sha=sha256,
                      headers={"Content-Type": media_type})

    def delete(self, key: str) -> None:
        """Delete the object; one already gone is deleted as well."""
        try:
            self._request("DELETE", key)
        except _BucketError as exc:
            if exc.code != "not_found":
                raise

    def get(self, key: str, *, size: int, sha256: str) -> bytes:
        """The object's bytes, checked against the size and sha256 its record
        carries; a mismatch is refused, never returned."""
        data = self._request("GET", key, missing="object_missing").content
        found = hashlib.sha256(data).hexdigest()
        if len(data) != size or found != sha256:
            raise _BucketError(8, "sha256_mismatch",
                               f"the bucket's object {key!r} is {len(data)} bytes with sha256 "
                               f"{found}, and its record says {size} bytes with sha256 "
                               f"{sha256}", "nothing was written; the record is kept - put "
                               f"the file's bytes again with `{NAME} files add`")
        return data

    def probe(self, prefix: str) -> dict:
        """The cheapest authenticated round trip: list at most one key under
        the project's prefix."""
        resp = self._request("GET", None, query={"list-type": "2", "max-keys": "1",
                                                 "prefix": prefix})
        return {"ok": True, "endpoint": self.endpoint, "bucket": self.bucket,
                "region": self.region, "prefix": prefix, "proof": ["list"],
                "objects_under_prefix": "<Key>" in resp.text}

    def prove(self, prefix: str) -> dict:
        """The round trips a file verb makes, with the keys it would make them
        with: put one throwaway object under the project's prefix, read its
        head, delete it."""
        import uuid
        key = f"{prefix}.assets-doctor-{uuid.uuid4().hex}"
        data = b"assets doctor\n"
        self.put(key, data, hashlib.sha256(data).hexdigest(), "text/plain")
        try:
            self._request("HEAD", key)
        except _BucketError:
            try:
                self._request("DELETE", key)
            except _BucketError:
                pass
            raise
        self._request("DELETE", key)
        return {"ok": True, "endpoint": self.endpoint, "bucket": self.bucket,
                "region": self.region, "prefix": prefix,
                "proof": ["put", "head", "delete"]}


# ── the tables ───────────────────────────────────────────────────────────────

# Versions reference their document with a foreign key: both tables are this
# capability's own, a document is never deleted (its guard refuses it), so the
# key costs nothing and keeps a version from naming a document that is not there.
# A file references the document it belongs to the same way; its bytes are in the
# bucket, so the row is what says the file exists, and its size and sha256 are
# what every read of the bytes is checked against. A file is deleted where its
# bytes are - `files rm` deletes the object of every record of the name - and
# its record is retired, not deleted: the store keeps refusing a delete, as for
# documents, so the record of what was kept and when outlives the bytes.
# Every write to a file's records is logged in the same transaction: one row of
# assets_file_operations naming the record it wrote or retired, the outcome the
# verb answered, who and when, so a removed file's trail says who removed it.
# The log references the file record by its key, as a file does its document,
# and like every other table here it is never edited or deleted. It starts when
# the step is applied: what happened to a file before then is not known, so
# nothing is backfilled.
TABLES_MAJOR, TABLES_MINOR = 1, 2
TABLE_STEPS = [
    ("0001-documents", """
    CREATE TABLE assets_documents (
        project_id  text NOT NULL CHECK (project_id <> ''),
        id          uuid PRIMARY KEY DEFAULT gen_random_uuid(),
        kind        text NOT NULL CHECK (kind IN ('plan', 'research', 'session', 'meeting',
                                                  'journal', 'digest', 'report', 'note')),
        name        text NOT NULL CHECK (name <> ''),
        created_at  timestamptz NOT NULL DEFAULT now(),
        created_by  text NOT NULL CHECK (created_by <> ''),
        retired_at  timestamptz
    );
    CREATE UNIQUE INDEX assets_documents_name ON assets_documents (project_id, kind, name)
        WHERE retired_at IS NULL;
    COMMENT ON TABLE assets_documents IS
        'A text asset of a project: what never changes about it. Its content is in assets_versions.';
    COMMENT ON COLUMN assets_documents.kind IS
        'From the top folder of the name: plans, research, sessions, meetings, journal, digests, reports; anything else is note.';
    COMMENT ON COLUMN assets_documents.name IS
        'The path under the agent''s assets/ folder without .md, e.g. plans/2026-10-20_x; unique per project and kind among unretired documents.';
    COMMENT ON COLUMN assets_documents.retired_at IS
        'Set when the document is retired; it then leaves list, search and export and nothing is deleted.';
    """),
    ("0002-versions", """
    CREATE TABLE assets_versions (
        id           uuid PRIMARY KEY DEFAULT gen_random_uuid(),
        document_id  uuid NOT NULL REFERENCES assets_documents (id),
        title        text NOT NULL CHECK (title <> '' AND strpos(title, E'\\n') = 0),
        body         text NOT NULL,
        search       tsvector NOT NULL GENERATED ALWAYS AS
                         (to_tsvector('simple'::regconfig, title || ' ' || body)) STORED,
        active       boolean NOT NULL DEFAULT true,
        created_at   timestamptz NOT NULL DEFAULT now(),
        created_by   text NOT NULL CHECK (created_by <> ''),
        note         text CHECK (note <> '')
    );
    CREATE UNIQUE INDEX assets_versions_active ON assets_versions (document_id) WHERE active;
    CREATE INDEX assets_versions_document ON assets_versions (document_id, created_at);
    CREATE INDEX assets_versions_search ON assets_versions USING gin (search);
    COMMENT ON TABLE assets_versions IS
        'Every version of an asset document. Immutable: a save inserts a version and clears active on the one it replaces.';
    COMMENT ON COLUMN assets_versions.title IS
        'The body''s first # heading, else the last segment of the document name.';
    COMMENT ON COLUMN assets_versions.body IS
        'The markdown exactly as saved, so an export writes back the same bytes.';
    COMMENT ON COLUMN assets_versions.search IS
        'Full-text vector of title and body in the simple configuration (no stemming: the texts mix languages).';
    COMMENT ON COLUMN assets_versions.active IS
        'True on the one version in force; at most one per document (assets_versions_active).';
    COMMENT ON COLUMN assets_versions.note IS
        'Why this version was saved, as the writer said.';
    """),
    ("0003-guards", """
    CREATE FUNCTION assets_versions_guard() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        IF tg_op IN ('DELETE', 'TRUNCATE') THEN
            RAISE EXCEPTION 'asset versions are never deleted: retire the document instead'
                USING ERRCODE = 'check_violation';
        END IF;
        IF new.id <> old.id OR new.document_id <> old.document_id OR new.title <> old.title
                OR new.body <> old.body OR new.created_at <> old.created_at
                OR new.created_by <> old.created_by OR new.note IS DISTINCT FROM old.note
                OR new.active AND NOT old.active THEN
            RAISE EXCEPTION 'an asset version is immutable: save a new version; clearing active on supersession is the only change'
                USING ERRCODE = 'check_violation';
        END IF;
        RETURN new;
    END $$;
    CREATE TRIGGER assets_versions_guard BEFORE UPDATE OR DELETE ON assets_versions
        FOR EACH ROW EXECUTE FUNCTION assets_versions_guard();
    CREATE TRIGGER assets_versions_truncate BEFORE TRUNCATE ON assets_versions
        FOR EACH STATEMENT EXECUTE FUNCTION assets_versions_guard();

    CREATE FUNCTION assets_documents_guard() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        IF tg_op IN ('DELETE', 'TRUNCATE') THEN
            RAISE EXCEPTION 'asset documents are never deleted: retire them'
                USING ERRCODE = 'check_violation';
        END IF;
        IF new.id <> old.id OR new.project_id <> old.project_id OR new.kind <> old.kind
                OR new.name <> old.name OR new.created_at <> old.created_at
                OR new.created_by <> old.created_by
                OR old.retired_at IS NOT NULL
                   AND new.retired_at IS DISTINCT FROM old.retired_at THEN
            RAISE EXCEPTION 'an asset document changes only by being retired, once'
                USING ERRCODE = 'check_violation';
        END IF;
        RETURN new;
    END $$;
    CREATE TRIGGER assets_documents_guard BEFORE UPDATE OR DELETE ON assets_documents
        FOR EACH ROW EXECUTE FUNCTION assets_documents_guard();
    CREATE TRIGGER assets_documents_truncate BEFORE TRUNCATE ON assets_documents
        FOR EACH STATEMENT EXECUTE FUNCTION assets_documents_guard();
    """),
    ("0004-files", """
    CREATE TABLE assets_files (
        project_id   text NOT NULL CHECK (project_id <> ''),
        id           uuid PRIMARY KEY DEFAULT gen_random_uuid(),
        document_id  uuid REFERENCES assets_documents (id),
        name         text NOT NULL CHECK (name <> ''),
        media_type   text NOT NULL CHECK (media_type ~ '^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*$'),
        bytes        bigint NOT NULL CHECK (bytes >= 0),
        sha256       text NOT NULL CHECK (sha256 ~ '^[0-9a-f]{64}$'),
        storage_key  text NOT NULL CHECK (storage_key = project_id || '/' || id::text || '/' || name),
        created_at   timestamptz NOT NULL DEFAULT now(),
        created_by   text NOT NULL CHECK (created_by <> ''),
        retired_at   timestamptz
    );
    CREATE UNIQUE INDEX assets_files_name ON assets_files (project_id, name)
        WHERE retired_at IS NULL;
    COMMENT ON TABLE assets_files IS
        'A file of a project that is not a markdown document: its bytes are the object storage_key in the bucket of the project''s file store connection, this row says it exists. Immutable: a replaced file is a new row and the old one is retired.';
    COMMENT ON COLUMN assets_files.document_id IS
        'The document the file belongs to, when it sits beside one or is linked from one; null when it belongs to none.';
    COMMENT ON COLUMN assets_files.name IS
        'The path under the agent''s assets/ folder, extension included, e.g. research/x/crash.ips; unique per project among unretired files.';
    COMMENT ON COLUMN assets_files.media_type IS
        'The media type the object was put with, from the name''s extension; application/octet-stream when none is known.';
    COMMENT ON COLUMN assets_files.bytes IS
        'The size of the object in bytes; a read of it is checked against this.';
    COMMENT ON COLUMN assets_files.sha256 IS
        'The lowercase hex SHA-256 of the bytes; a read of the object is checked against this.';
    COMMENT ON COLUMN assets_files.storage_key IS
        'The object key in the bucket: <project_id>/<id>/<name>, so no two rows share an object.';
    COMMENT ON COLUMN assets_files.retired_at IS
        'Set when the file is replaced or retired; the row and its object stay, and the name is free for a new row.';
    """),
    ("0005-files-guard", """
    CREATE FUNCTION assets_files_guard() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        IF tg_op IN ('DELETE', 'TRUNCATE') THEN
            RAISE EXCEPTION 'asset files are never deleted: retire them'
                USING ERRCODE = 'check_violation';
        END IF;
        IF new.id <> old.id OR new.project_id <> old.project_id
                OR new.document_id IS DISTINCT FROM old.document_id
                OR new.name <> old.name OR new.media_type <> old.media_type
                OR new.bytes <> old.bytes OR new.sha256 <> old.sha256
                OR new.storage_key <> old.storage_key OR new.created_at <> old.created_at
                OR new.created_by <> old.created_by
                OR old.retired_at IS NOT NULL
                   AND new.retired_at IS DISTINCT FROM old.retired_at THEN
            RAISE EXCEPTION 'an asset file changes only by being retired, once: keep the new bytes as a new file'
                USING ERRCODE = 'check_violation';
        END IF;
        RETURN new;
    END $$;
    CREATE TRIGGER assets_files_guard BEFORE UPDATE OR DELETE ON assets_files
        FOR EACH ROW EXECUTE FUNCTION assets_files_guard();
    CREATE TRIGGER assets_files_truncate BEFORE TRUNCATE ON assets_files
        FOR EACH STATEMENT EXECUTE FUNCTION assets_files_guard();
    """),
    ("0006-file-operations", """
    CREATE TABLE assets_file_operations (
        project_id  text NOT NULL CHECK (project_id <> ''),
        id          uuid PRIMARY KEY DEFAULT gen_random_uuid(),
        file_id     uuid NOT NULL REFERENCES assets_files (id),
        operation   text NOT NULL CHECK (operation IN ('created', 'replaced', 'linked',
                                                       'unlinked', 'removed')),
        created_at  timestamptz NOT NULL DEFAULT now(),
        created_by  text NOT NULL CHECK (created_by <> '')
    );
    CREATE INDEX assets_file_operations_project ON assets_file_operations (project_id, created_at);
    CREATE INDEX assets_file_operations_file ON assets_file_operations (file_id);
    COMMENT ON TABLE assets_file_operations IS
        'Every write to a project''s file records, one row each, written in the transaction of the write. Append-only: never edited or deleted.';
    COMMENT ON COLUMN assets_file_operations.file_id IS
        'The file record the operation wrote (created, replaced, linked, unlinked) or retired (removed).';
    COMMENT ON COLUMN assets_file_operations.operation IS
        'The outcome the verb answered: created and replaced by files add and import, linked and unlinked by files link, removed by files rm.';

    CREATE FUNCTION assets_file_operations_guard() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        RAISE EXCEPTION 'the file operations log is append-only: it is never edited or deleted'
            USING ERRCODE = 'check_violation';
    END $$;
    CREATE TRIGGER assets_file_operations_guard BEFORE UPDATE OR DELETE
        ON assets_file_operations
        FOR EACH ROW EXECUTE FUNCTION assets_file_operations_guard();
    CREATE TRIGGER assets_file_operations_truncate BEFORE TRUNCATE ON assets_file_operations
        FOR EACH STATEMENT EXECUTE FUNCTION assets_file_operations_guard();
    """),
]


def _tables():
    """The steps and version of the assets tables, for the contract's `migrate`."""
    return TABLE_STEPS, TABLES_MAJOR, TABLES_MINOR


# ── names, kinds, bodies ─────────────────────────────────────────────────────

KINDS = {"plans": "plan", "research": "research", "sessions": "session",
         "meetings": "meeting", "journal": "journal", "digests": "digest",
         "reports": "report"}
_SEGMENT = re.compile(r"[^/\\\x00-\x1f\x7f]+")
_VERSION_REF = re.compile(r"[0-9a-fA-F-]{6,36}")
TITLE_MAX = 200


def _name_problem(name: str) -> str | None:
    """Why `name` addresses no document, or None when it does."""
    if not name:
        return "a document name is not empty"
    parts = name.split("/")
    for part in parts:
        if part in ("", ".", "..") or not _SEGMENT.fullmatch(part):
            return (f"{name!r} is not a document name: each `/`-separated segment is "
                    "non-empty, not `.` or `..`, with no backslash or control character")
    if name.endswith(".md"):
        return f"{name!r} ends in .md: a document is named by its path without .md"
    return None


def _checked_name(name: str) -> str:
    problem = _name_problem(name)
    if problem:
        _die(6, "bad_name", problem,
             "name it by its path under assets/ without .md, e.g. plans/2026-10-20_rollout")
    return name


def _kind(name: str) -> str:
    parts = name.split("/")
    return KINDS.get(parts[0], "note") if len(parts) > 1 else "note"


def _title(name: str, body: str) -> str:
    """The body's first `# ` heading outside a fenced code block, else the name's
    last segment."""
    fenced = False
    for line in body.splitlines():
        stripped = line.strip()
        if stripped.startswith(("```", "~~~")):
            fenced = not fenced
            continue
        if not fenced and re.match(r"#\s+\S", stripped):
            heading = re.sub(r"\s+#+\s*$", "", stripped[1:].strip()).strip()
            if heading:
                return heading[:TITLE_MAX]
    return name.rsplit("/", 1)[-1][:TITLE_MAX]


def _body_problem(data: bytes) -> tuple[str | None, str | None]:
    """The body as text, or why it cannot be one."""
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError as exc:
        return None, f"not UTF-8 text ({exc.reason} at byte {exc.start})"
    if "\x00" in text:
        return None, "holds a NUL character, which a text body cannot keep"
    return text, None


def _read_body(source: str) -> str:
    if source == "-":
        data = sys.stdin.buffer.read()
        where = "stdin"
    else:
        path = Path(source).expanduser()
        try:
            data = path.read_bytes()
        except FileNotFoundError:
            _die(3, "not_found", f"no file {path}")
        except OSError as exc:
            _die(6, "input", f"cannot read {path}: {exc}")
        where = str(path)
    text, problem = _body_problem(data)
    if problem:
        _die(6, "bad_body", f"{where} {problem}", "an asset body is UTF-8 markdown text")
    return text


# ── the project and the store ────────────────────────────────────────────────

_SETTING_SLUGS = frozenset({
    "store_not_configured", "store_not_postgres", "store_setting_unreadable",
    "store_setting_too_new", "bad_store_setting", "sslmode_too_weak",
    "bad_schema_name", "driver_missing", "transaction_pooler", "checksum_mismatch",
    "schema_too_new", "naming_law", "step_failed", "bad_owner", "bad_step"})
_STORE_HINT = ("set AGENTKIT_DB_URL (or AGENTKIT_DB_HOST, AGENTKIT_DB_NAME, AGENTKIT_DB_USER, "
               "AGENTKIT_DB_PASSWORD) in the project's .env.local or the environment, or run "
               "`capabilities store set`")


def _root() -> Path:
    root = _project_root()
    if root is None:
        _die(6, "no_project", f"{NAME} keeps a project's assets; run it inside a project",
             "cd into the project, or set CLAUDE_PROJECT_DIR")
    return root


def _project(write: bool) -> str:
    """The id of the project this command stands in: verified for a write,
    as recorded for a read."""
    _root()
    project = _project_id(write=write)
    if not project:
        _die(6, "no_project_identity", "this project has no durable id",
             "run `capabilities init` in the project")
    return str(project)


def _actor() -> str:
    user = os.environ.get("USER") or os.environ.get("LOGNAME")
    if not user:
        try:
            import pwd
            user = pwd.getpwuid(os.getuid()).pw_name
        except (ImportError, KeyError):
            user = None
    return f"{user or 'unknown'}@{node_name()}"


def _db():
    try:
        from capabilities_contract import db
    except ImportError:
        _die(6, "driver_missing",
             "the shared database library capabilities-contract is not installed",
             f"run {NAME} through its own script header, which pins it")
    return db


def _store_refused(exc) -> NoReturn:
    if exc.slug == "store_not_configured":
        _die(6, "store_not_configured",
             f"{NAME} keeps a project's assets in a store, and none is configured here",
             _STORE_HINT)
    _die(6 if exc.slug in _SETTING_SLUGS else 5, exc.slug, exc.message, exc.hint)


def _setting(root: Path | None):
    db = _db()
    try:
        return db.resolve_setting(root)
    except db.DbError as exc:
        _store_refused(exc)


def _open(root: Path | None):
    """A transaction connection to the project's store, the assets tables
    migrated, in autocommit so each write states its own transaction."""
    db = _db()
    setting = _setting(root)
    conn = None
    try:
        conn = db.connect(application_name=NAME, setting=setting, transaction=True)
        db.migrate(conn, NAME, TABLE_STEPS, major=TABLES_MAJOR, minor=TABLES_MINOR)
        conn.autocommit = True
    except db.DbError as exc:
        if conn is not None:
            conn.close()
        _store_refused(exc)
    return conn


def _rows(conn, sql: str, params=()) -> list[dict]:
    from psycopg.rows import dict_row
    with conn.cursor(row_factory=dict_row) as cur:
        cur.execute(sql, params)
        return list(cur.fetchall()) if cur.description else []


def _one(conn, sql: str, params=()) -> dict | None:
    rows = _rows(conn, sql, params)
    return rows[0] if rows else None


def _iso(moment) -> str | None:
    return moment.isoformat().replace("+00:00", "Z") if moment is not None else None


def _version_out(row: dict, *, body: bool = False) -> dict:
    out = {"id": str(row["id"]), "short": str(row["id"])[:8], "title": row["title"],
           "active": row["active"], "created_at": _iso(row["created_at"]),
           "created_by": row["created_by"], "note": row["note"],
           "bytes": len(row["body"].encode("utf-8"))}
    if body:
        out["body"] = row["body"]
    return out


def _document_out(row: dict) -> dict:
    return {"id": str(row["id"]), "name": row["name"], "kind": row["kind"],
            "created_at": _iso(row["created_at"]), "created_by": row["created_by"],
            "retired_at": _iso(row["retired_at"])}


VERSION_COLUMNS = "id, document_id, title, body, active, created_at, created_by, note"
DOCUMENT_COLUMNS = "id, project_id, kind, name, created_at, created_by, retired_at"


def _document(conn, project: str, name: str, *, lock: bool = False) -> dict | None:
    return _one(conn, f"SELECT {DOCUMENT_COLUMNS} FROM assets_documents WHERE project_id = %s "
                      "AND kind = %s AND name = %s AND retired_at IS NULL"
                      + (" FOR UPDATE" if lock else ""), (project, _kind(name), name))


def _need_document(conn, project: str, name: str, *, lock: bool = False) -> dict:
    found = _document(conn, project, name, lock=lock)
    if found is None:
        _die(3, "not_found", f"no unretired document {name!r} in this project",
             f"`{NAME} list` names the documents there are")
    return found


def _versions(conn, document_id) -> list[dict]:
    """The document's versions, oldest first."""
    return _rows(conn, f"SELECT {VERSION_COLUMNS} FROM assets_versions WHERE document_id = %s "
                       "ORDER BY created_at, id", (document_id,))


def _active(conn, document_id, *, lock: bool = False) -> dict | None:
    return _one(conn, f"SELECT {VERSION_COLUMNS} FROM assets_versions "
                      "WHERE document_id = %s AND active" + (" FOR UPDATE" if lock else ""),
                (document_id,))


def _resolve_version(conn, document: dict, ref: str) -> dict:
    """The document's version `ref` names: its whole id or a prefix of 6 or more."""
    if not _VERSION_REF.fullmatch(ref):
        _die(6, "bad_version", f"{ref!r} is not a version id",
             f"give the whole id or its first 6 or more characters, as `{NAME} history` shows")
    found = _rows(conn, f"SELECT {VERSION_COLUMNS} FROM assets_versions WHERE document_id = %s "
                        "AND id::text LIKE %s ORDER BY created_at",
                  (document["id"], ref.lower() + "%"))
    if not found:
        _die(3, "version_not_found",
             f"{document['name']!r} has no version {ref!r}",
             f"`{NAME} history {document['name']}` lists its versions")
    if len(found) > 1:
        _die(6, "ambiguous_version", f"{ref!r} names {len(found)} versions of "
             f"{document['name']!r}", "give more characters of the id")
    return found[0]


class _StaleBase(Exception):
    def __init__(self, active: dict | None):
        super().__init__("stale base")
        self.active = active


def _save(conn, project: str, name: str, body: str, *, base: str | None,
          note: str | None, actor: str) -> dict:
    """Save `body` as the document's active version inside the caller's
    transaction: the document row is locked, so saves of one document queue,
    and the partial unique index keeps a second active version out whatever a
    writer does."""
    kind, title = _kind(name), _title(name, body)
    document = _document(conn, project, name, lock=True)
    created = False
    if document is None:
        if base is not None:
            raise _StaleBase(None)
        document = _one(
            conn, "INSERT INTO assets_documents (project_id, kind, name, created_by) "
                  "VALUES (%s, %s, %s, %s) ON CONFLICT (project_id, kind, name) "
                  f"WHERE retired_at IS NULL DO NOTHING RETURNING {DOCUMENT_COLUMNS}",
            (project, kind, name, actor))
        created = document is not None
        if document is None:
            document = _document(conn, project, name, lock=True)
    active = None if created else _active(conn, document["id"], lock=True)
    if active is not None and active["body"] == body and active["title"] == title:
        return {"document": _document_out(document), "version": _version_out(active),
                "created": False, "document_created": False, "replaced": None}
    if base is not None:
        wanted = _resolve_version(conn, document, base)
        if active is None or wanted["id"] != active["id"]:
            raise _StaleBase(active)
    if active is not None:
        _rows(conn, "UPDATE assets_versions SET active = false WHERE id = %s", (active["id"],))
    version = _one(conn, "INSERT INTO assets_versions (document_id, title, body, created_by, "
                         f"note) VALUES (%s, %s, %s, %s, %s) RETURNING {VERSION_COLUMNS}",
                   (document["id"], title, body, actor, note))
    return {"document": _document_out(document), "version": _version_out(version),
            "created": True, "document_created": created,
            "replaced": str(active["id"]) if active is not None else None}


def _stale_refusal(name: str, active: dict | None) -> NoReturn:
    if active is None:
        _die(7, "stale_base", f"--base names no active version of {name!r}: the document "
             "does not exist or was retired", f"save without --base to create {name!r}")
    _die(7, "stale_base",
         f"another save came first: the active version of {name!r} is now "
         f"{str(active['id'])[:8]} ({_iso(active['created_at'])}, {active['created_by']})",
         f"read it with `{NAME} show {name}`, merge, and save again with --base "
         f"{str(active['id'])[:8]}")


def _refused_by_store(exc) -> NoReturn:
    _die(6, "refused_by_store", str(exc).splitlines()[0])


# ── files ────────────────────────────────────────────────────────────────────

FILE_COLUMNS = ("id, project_id, document_id, name, media_type, bytes, sha256, storage_key, "
                "created_at, created_by, retired_at")
_LINK = re.compile(r"\]\(\s*(?:<([^>\n]*)>|([^)\s]+))|^[ \t]{0,3}\[[^\]\n]+\]:[ \t]*<?([^>\s]+)",
                   re.MULTILINE)


def _file_name_problem(name: str, project: str) -> str | None:
    """Why `name` addresses no file, or None when it does: the document rule
    for segments, a name a document would own refused, and a storage key S3
    can carry."""
    if not name:
        return "a file name is not empty"
    for part in name.split("/"):
        if part in ("", ".", "..") or not _SEGMENT.fullmatch(part):
            return (f"{name!r} is not a file name: each `/`-separated segment is "
                    "non-empty, not `.` or `..`, with no backslash or control character")
    if name.endswith(".md"):
        return f"{name!r} ends in .md: a markdown file is a document; `{NAME} save` it"
    if len(_storage_key(project, "00000000-0000-0000-0000-000000000000", name).encode()) \
            > STORAGE_KEY_MAX:
        return f"{name!r} is too long: its storage key would pass S3's {STORAGE_KEY_MAX} bytes"
    return None


def _checked_file_name(name: str, project: str) -> str:
    problem = _file_name_problem(name, project)
    if problem:
        _die(6, "bad_name", problem,
             "name it by its path under assets/ with its extension, e.g. research/x/crash.ips")
    return name


def _storage_key(project: str, file_id: str, name: str) -> str:
    return f"{project}/{file_id}/{name}"


def _media_type(name: str) -> str:
    """The media type of the name's extension in Python's own table, never the
    machine's, so one name has one type wherever it is kept."""
    import mimetypes
    suffix = Path(name.rsplit("/", 1)[-1]).suffix.lower()
    table = mimetypes.MimeTypes()
    return (table.types_map[True].get(suffix) or table.types_map[False].get(suffix)
            or "application/octet-stream")


def _file_out(row: dict, document: str | None = None) -> dict:
    return {"id": str(row["id"]), "name": row["name"], "media_type": row["media_type"],
            "bytes": row["bytes"], "sha256": row["sha256"], "storage_key": row["storage_key"],
            "document": document,
            "document_id": str(row["document_id"]) if row["document_id"] else None,
            "created_at": _iso(row["created_at"]), "created_by": row["created_by"],
            "retired_at": _iso(row["retired_at"])}


def _current_file(conn, project: str, name: str, *, lock: bool = False) -> dict | None:
    return _one(conn, f"SELECT {FILE_COLUMNS} FROM assets_files WHERE project_id = %s "
                      "AND name = %s AND retired_at IS NULL" + (" FOR UPDATE" if lock else ""),
                (project, name))


class _StaleFile(Exception):
    """The file's current record changed between the put and the write."""


def _upload(bucket, project: str, name: str, data: bytes, sha: str) -> dict:
    """Put the bytes in the bucket under a key no row names yet; the record
    that says the file exists is written after, in the caller's transaction."""
    import uuid
    file_id = str(uuid.uuid4())
    key = _storage_key(project, file_id, name)
    media = _media_type(name)
    bucket.put(key, data, sha, media)
    return {"id": file_id, "storage_key": key, "media_type": media}


def _write_file_row(conn, project: str, name: str, sha: str, size: int, put: dict | None,
                 document_id, actor: str, seen: dict | None) -> tuple[str, dict, dict | None]:
    """Write a file's record inside the caller's transaction: retire the
    current one and insert the new one, or nothing when the current one has
    these bytes. `seen` is the record read before the put; a different one
    now means another writer came first."""
    current = _current_file(conn, project, name, lock=True)
    if current is not None and current["sha256"] == sha and current["bytes"] == size:
        return "unchanged", current, None
    if (current["id"] if current else None) != (seen["id"] if seen else None) or put is None:
        raise _StaleFile(name)
    row = _replace_file_row(conn, project, name, sha, size, put, document_id, actor, current)
    outcome = "replaced" if current is not None else "created"
    _log_file(conn, project, row["id"], outcome, actor)
    return outcome, row, current


def _log_file(conn, project: str, file_id, operation: str, actor: str) -> None:
    """Log a write to a file's records, inside the caller's transaction."""
    _rows(conn, "INSERT INTO assets_file_operations (project_id, file_id, operation, "
                "created_by) VALUES (%s, %s, %s, %s)", (project, file_id, operation, actor))


def _replace_file_row(conn, project: str, name: str, sha: str, size: int, put: dict,
                      document_id, actor: str, current: dict | None) -> dict:
    """Retire `current`, when there is one, and insert the record of the
    object `put` names: the one way a file's record changes."""
    if current is not None:
        _rows(conn, "UPDATE assets_files SET retired_at = now() WHERE id = %s",
              (current["id"],))
    return _one(conn, "INSERT INTO assets_files (project_id, id, document_id, name, media_type, "
                      "bytes, sha256, storage_key, created_by) VALUES (%s, %s, %s, %s, %s, %s, "
                      f"%s, %s, %s) RETURNING {FILE_COLUMNS}",
                (project, put["id"], document_id, name, put["media_type"], size, sha,
                 put["storage_key"], actor))


def _links(document: str, body: str) -> set[str]:
    """The names under assets/ a document's body links to by a relative path:
    inline links and images, and reference definitions."""
    import posixpath
    from urllib.parse import unquote
    folder = posixpath.dirname(document)
    out = set()
    for match in _LINK.finditer(body):
        target = next(g for g in match.groups() if g is not None).strip()
        if not target or target.startswith(("#", "/")) \
                or re.match(r"[A-Za-z][A-Za-z0-9+.-]*:", target):
            continue
        target = unquote(re.split(r"[?#]", target, maxsplit=1)[0])
        name = posixpath.normpath(posixpath.join(folder, target))
        if name and name != "." and not name.startswith("../") and name != "..":
            out.add(name)
    return out


def _belongs_to(name: str, documents: dict[str, str]) -> str | None:
    """The document a file belongs to, among `documents` (name -> body): the
    one that links to it, else the one in its folder, else the one its folder
    is named after; none when no rule names exactly one."""
    import posixpath
    linking = [doc for doc, body in documents.items() if name in _links(doc, body)]
    if linking:
        return linking[0] if len(linking) == 1 else None
    folder = posixpath.dirname(name)
    beside = [doc for doc in documents if posixpath.dirname(doc) == folder]
    if beside:
        return beside[0] if len(beside) == 1 else None
    return folder if folder in documents else None


def _stale_file_refusal(name: str) -> NoReturn:
    _die(7, "stale_base", f"another write of the file {name!r} came first",
         f"read it with `{NAME} files list` and write again")


# ── verbs ────────────────────────────────────────────────────────────────────

def cmd_list(_args) -> None:
    project = _project(write=False)
    conn = _open(_root())
    rows = _rows(conn, "SELECT d.name, d.kind, d.created_at, v.id AS version, v.title, "
                       "v.created_at AS saved_at FROM assets_documents d LEFT JOIN "
                       "assets_versions v ON v.document_id = d.id AND v.active "
                       "WHERE d.project_id = %s AND d.retired_at IS NULL ORDER BY d.name",
                 (project,))
    _emit({"project": project, "count": len(rows), "documents": [
        {"name": r["name"], "kind": r["kind"], "title": r["title"],
         "version": str(r["version"]) if r["version"] else None,
         "created_at": _iso(r["created_at"]), "saved_at": _iso(r["saved_at"])}
        for r in rows]})


def cmd_show(args) -> None:
    project = _project(write=False)
    name = _checked_name(args.name)
    conn = _open(_root())
    if args.version is None:
        document = _need_document(conn, project, name)
        version = _active(conn, document["id"])
    else:
        if not _VERSION_REF.fullmatch(args.version):
            _die(6, "bad_version", f"{args.version!r} is not a version id",
                 "give the whole id or its first 6 or more characters")
        documents = _rows(conn, f"SELECT {DOCUMENT_COLUMNS} FROM assets_documents WHERE "
                                "project_id = %s AND kind = %s AND name = %s "
                                "ORDER BY created_at DESC", (project, _kind(name), name))
        if not documents:
            _need_document(conn, project, name)
        hits = []
        for document in documents:
            found = _rows(conn, f"SELECT {VERSION_COLUMNS} FROM assets_versions WHERE "
                                "document_id = %s AND id::text LIKE %s",
                          (document["id"], args.version.lower() + "%"))
            hits += [(document, row) for row in found]
        if not hits:
            _die(3, "version_not_found", f"{name!r} has no version {args.version!r}",
                 f"`{NAME} history {name}` lists its versions")
        if len(hits) > 1:
            _die(6, "ambiguous_version", f"{args.version!r} names {len(hits)} versions",
                 "give more characters of the id")
        document, version = hits[0]
    files = _rows(conn, "SELECT name FROM assets_files WHERE document_id = %s "
                        "AND retired_at IS NULL ORDER BY name", (document["id"],))
    _emit({"document": _document_out(document),
           "version": _version_out(version, body=True) if version else None,
           "files": [row["name"] for row in files]})


def cmd_history(args) -> None:
    project = _project(write=False)
    name = _checked_name(args.name)
    conn = _open(_root())
    document = _need_document(conn, project, name)
    versions = _versions(conn, document["id"])
    _emit({"document": _document_out(document), "count": len(versions),
           "versions": [_version_out(v) for v in reversed(versions)]})


def _unified(name: str, old: dict | None, new: dict) -> str:
    """A unified diff of two bodies that says where a line has no newline."""
    def lines(text: str) -> list[str]:
        out = text.splitlines(keepends=True)
        if out and not out[-1].endswith(("\n", "\r")):
            out[-1] += "\n\\ No newline at end of file\n"
        return out
    old_label = f"{name}@{str(old['id'])[:8]}" if old else "/dev/null"
    return "".join(difflib.unified_diff(lines(old["body"]) if old else [], lines(new["body"]),
                                        fromfile=old_label,
                                        tofile=f"{name}@{str(new['id'])[:8]}"))


def cmd_diff(args) -> None:
    project = _project(write=False)
    name = _checked_name(args.name)
    conn = _open(_root())
    document = _need_document(conn, project, name)
    versions = _versions(conn, document["id"])
    active = next((v for v in versions if v["active"]), versions[-1] if versions else None)
    if active is None:
        _die(3, "version_not_found", f"{name!r} has no versions")
    if args.a is None:
        new = active
        at = [v["id"] for v in versions].index(new["id"])
        old = versions[at - 1] if at > 0 else None
    elif args.b is None:
        old, new = _resolve_version(conn, document, args.a), active
    else:
        old = _resolve_version(conn, document, args.a)
        new = _resolve_version(conn, document, args.b)
    text = _unified(name, old, new)
    _emit({"name": name,
           "from": _version_out(old) if old else None, "to": _version_out(new),
           "changed": (old["body"] if old else None) != new["body"]
                      or (old["title"] if old else None) != new["title"],
           "diff": text})


def cmd_search(args) -> None:
    project = _project(write=False)
    terms = args.terms.strip()
    if not terms:
        _die(6, "input", "search takes the terms to look for")
    conn = _open(_root())
    where = ("d.project_id = %(project)s AND d.retired_at IS NULL AND v.active "
             "AND v.search @@ websearch_to_tsquery('simple', %(terms)s)")
    params = {"project": project, "terms": terms, "limit": args.limit}
    matched = _one(conn, "SELECT count(*) AS n FROM assets_versions v JOIN assets_documents d "
                         f"ON d.id = v.document_id WHERE {where}", params)["n"]
    rows = _rows(conn,
                 "SELECT d.name, d.kind, v.id, v.title, v.created_at, "
                 "ts_rank(v.search, websearch_to_tsquery('simple', %(terms)s)) AS rank, "
                 "ts_headline('simple', v.body, websearch_to_tsquery('simple', %(terms)s), "
                 "'MaxFragments=2, MaxWords=20, MinWords=6, FragmentDelimiter=\" ... \"') "
                 "AS headline FROM assets_versions v JOIN assets_documents d "
                 f"ON d.id = v.document_id WHERE {where} ORDER BY rank DESC, d.name "
                 "LIMIT %(limit)s", params)
    _emit({"terms": terms, "matched": matched, "count": len(rows), "results": [
        {"name": r["name"], "kind": r["kind"], "title": r["title"], "version": str(r["id"]),
         "saved_at": _iso(r["created_at"]), "rank": round(float(r["rank"]), 4),
         "headline": r["headline"]} for r in rows]})


def cmd_save(args) -> None:
    project = _project(write=True)
    name = _checked_name(args.name)
    if args.note is not None and not args.note.strip():
        _die(6, "input", "--note says why the document changed; it is not empty")
    if args.base is not None and not _VERSION_REF.fullmatch(args.base):
        _die(6, "bad_version", f"{args.base!r} is not a version id",
             f"give the whole id or its first 6 or more characters, as `{NAME} history` shows")
    body = _read_body(args.source)
    conn = _open(_root())
    import psycopg
    try:
        with conn.transaction():
            out = _save(conn, project, name, body, base=args.base, note=args.note,
                        actor=_actor())
    except _StaleBase as exc:
        _stale_refusal(name, exc.active)
    except psycopg.errors.UniqueViolation:
        _die(7, "stale_base", f"another save of {name!r} came first",
             f"read it with `{NAME} show {name}` and save again")
    except psycopg.errors.CheckViolation as exc:
        _refused_by_store(exc)
    _emit(out)


def cmd_retire(args) -> None:
    project = _project(write=True)
    name = _checked_name(args.name)
    conn = _open(_root())
    import psycopg
    try:
        with conn.transaction():
            document = _need_document(conn, project, name, lock=True)
            row = _one(conn, "UPDATE assets_documents SET retired_at = now() WHERE id = %s "
                             f"RETURNING {DOCUMENT_COLUMNS}", (document["id"],))
    except psycopg.errors.CheckViolation as exc:
        _refused_by_store(exc)
    _emit({"retired": _document_out(row)})


def _folder(given: str | None) -> Path:
    if given is not None:
        return Path(given).expanduser().resolve()
    return _root() / "assets"


# What an operating system or a version control habit leaves in a folder, not
# a file of the project: import never keeps it.
IMPORT_LITTER = frozenset({".DS_Store", ".gitkeep"})


def cmd_import(args) -> None:
    project = _project(write=True)
    folder = _folder(args.dir)
    if not folder.is_dir():
        _die(3, "not_found", f"no folder {folder}",
             "name the assets folder to import, or run it in a project that has assets/")
    files, others, skipped = [], [], []
    for here, dirs, names in os.walk(folder):
        here_path = Path(here)
        for d in sorted(dirs):
            if (here_path / d).is_symlink():
                skipped.append({"path": (here_path / d).relative_to(folder).as_posix(),
                                "reason": "a linked folder, not followed"})
        dirs.sort()
        for n in sorted(names):
            path = here_path / n
            rel = path.relative_to(folder).as_posix()
            if n in IMPORT_LITTER:
                skipped.append({"path": rel, "reason": "operating system or version "
                                "control litter, not a project file"})
                continue
            if not n.endswith(".md"):
                others.append((rel, path))
                continue
            name = rel[:-len(".md")]
            problem = _name_problem(name)
            if problem:
                skipped.append({"path": rel, "reason": problem})
                continue
            try:
                body, why = _body_problem(path.read_bytes())
            except OSError as exc:
                body, why = None, f"unreadable: {exc}"
            if why:
                skipped.append({"path": rel, "reason": why})
                continue
            files.append((rel, name, body))
    bucket, why = (_file_store(args.connection, "import", required=False)
                   if others or args.connection else (None, None))
    if bucket is None:
        skipped += [{"path": rel, "reason": f"not markdown and {why}"} for rel, _p in others]
        others = []
    conn = _open(_root())
    actor = _actor()
    import psycopg
    # The bytes go to the bucket first, each under a key no record names yet;
    # the records are written in the one transaction with the documents, so
    # an import that stops on the way leaves only objects nothing points at.
    planned = []
    for rel, path in others:
        problem = _file_name_problem(rel, project)
        try:
            data = path.read_bytes() if not problem else b""
        except OSError as exc:
            problem = f"unreadable: {exc}"
        if not problem and len(data) > SINGLE_PUT_MAX:
            problem = f"larger than the {SINGLE_PUT_MAX} bytes one put carries"
        if problem:
            skipped.append({"path": rel, "reason": problem})
            continue
        sha = hashlib.sha256(data).hexdigest()
        seen = _current_file(conn, project, rel)
        put = None
        if seen is None or seen["sha256"] != sha or seen["bytes"] != len(data):
            try:
                put = _upload(bucket, project, rel, data, sha)
            except _BucketError as exc:
                _bucket_refused(exc)
        planned.append((rel, sha, len(data), put, seen))
        del data
    skipped.sort(key=lambda row: row["path"])
    out, kept = [], []
    try:
        with conn.transaction():
            documents = {}
            for rel, name, body in sorted(files):
                saved = _save(conn, project, name, body, base=None,
                              note=f"imported from {rel}", actor=actor)
                outcome = ("unchanged" if not saved["created"] else
                           "created" if saved.get("document_created") else "saved")
                out.append({"path": rel, "name": name, "kind": saved["document"]["kind"],
                            "outcome": outcome, "version": saved["version"]["id"]})
                documents[name] = (saved["document"]["id"], body)
            bodies = {name: body for name, (_id, body) in documents.items()}
            for rel, sha, size, put, seen in planned:
                owner = _belongs_to(rel, bodies)
                outcome, row, old = _write_file_row(
                    conn, project, rel, sha, size, put,
                    documents[owner][0] if owner else None, actor, seen)
                kept.append({"path": rel, "name": rel, "outcome": outcome, "id": str(row["id"]),
                             "bytes": row["bytes"], "sha256": row["sha256"],
                             "document": owner if outcome != "unchanged" else
                             _document_name(conn, row["document_id"]),
                             "replaced": str(old["id"]) if old else None})
    except _StaleFile as exc:
        _stale_file_refusal(str(exc))
    except psycopg.errors.UniqueViolation as exc:
        _die(7, "stale_base", f"another write came first: {str(exc).splitlines()[0]}",
             f"run `{NAME} import` again")
    except psycopg.errors.CheckViolation as exc:
        _refused_by_store(exc)
    counts = {key: sum(1 for row in out if row["outcome"] == key)
              for key in ("created", "saved", "unchanged")}
    file_counts = {key: sum(1 for row in kept if row["outcome"] == key)
                   for key in ("created", "replaced", "unchanged")}
    _emit({"dir": str(folder), "project": project, "documents": out, "files": kept,
           "skipped": skipped, "counts": {**counts, "skipped": len(skipped)},
           "file_counts": file_counts,
           "file_store": bucket.cid if bucket is not None else None})


def _document_name(conn, document_id) -> str | None:
    if document_id is None:
        return None
    row = _one(conn, "SELECT name FROM assets_documents WHERE id = %s", (document_id,))
    return row["name"] if row else None


def _write_bytes(path: Path, data: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    try:
        tmp.write_bytes(data)
        os.replace(tmp, path)
    finally:
        tmp.unlink(missing_ok=True)


def _sha256_of(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def cmd_export(args) -> None:
    project = _project(write=False)
    folder = _folder(args.dir)
    if folder.exists() and not folder.is_dir():
        _die(6, "input", f"{folder} is not a folder")
    conn = _open(_root())
    rows = _rows(conn, "SELECT d.name, v.id, v.body FROM assets_documents d JOIN "
                       "assets_versions v ON v.document_id = d.id AND v.active "
                       "WHERE d.project_id = %s AND d.retired_at IS NULL ORDER BY d.name",
                 (project,))
    file_rows = _rows(conn, f"SELECT {FILE_COLUMNS} FROM assets_files WHERE project_id = %s "
                            "AND retired_at IS NULL ORDER BY name", (project,))
    bucket, why = (_file_store(args.connection, "export", required=False)
                   if file_rows or args.connection else (None, None))
    out = []
    for row in rows:
        path = folder / f"{row['name']}.md"
        data = row["body"].encode("utf-8")
        item = {"name": row["name"], "path": str(path), "version": str(row["id"])}
        try:
            if path.is_file():
                if path.read_bytes() == data:
                    item["outcome"] = "unchanged"
                else:
                    item.update(outcome="kept", reason="the file differs from the active "
                                f"version; `{NAME} save` it or move it away, then export again")
            elif path.exists():
                item.update(outcome="kept", reason="something other than a file is there")
            else:
                _write_bytes(path, data)
                item["outcome"] = "written"
        except OSError as exc:
            item.update(outcome="failed", reason=str(exc))
        out.append(item)
    counts = {key: sum(1 for row in out if row["outcome"] == key)
              for key in ("written", "unchanged", "kept", "failed")}
    files, fail_exit = [], 6 if counts["failed"] else 0
    for row in file_rows:
        path = folder / row["name"]
        item = {"name": row["name"], "path": str(path), "id": str(row["id"]),
                "sha256": row["sha256"]}
        try:
            if path.is_file():
                if path.stat().st_size == row["bytes"] and _sha256_of(path) == row["sha256"]:
                    item["outcome"] = "unchanged"
                else:
                    item.update(outcome="kept", reason="the file differs from the store's; "
                                f"`{NAME} files add` it or move it away, then export again")
            elif path.exists() or path.is_symlink():
                item.update(outcome="kept", reason="something other than a file is there")
            elif bucket is None:
                item.update(outcome="skipped", reason=why)
            else:
                _write_bytes(path, bucket.get(row["storage_key"], size=row["bytes"],
                                              sha256=row["sha256"]))
                item["outcome"] = "written"
        except _BucketError as exc:
            item.update(outcome="failed", reason=exc.message, code=exc.code)
            fail_exit = fail_exit or exc.exit_code
        except OSError as exc:
            item.update(outcome="failed", reason=str(exc))
            fail_exit = fail_exit or 6
        files.append(item)
    file_counts = {key: sum(1 for row in files if row["outcome"] == key)
                   for key in ("written", "unchanged", "kept", "skipped", "failed")}
    _emit({"dir": str(folder), "project": project, "documents": out, "counts": counts,
           "files": files, "file_counts": file_counts,
           "complete": counts["kept"] == 0 and counts["failed"] == 0
                       and file_counts["kept"] == 0 and file_counts["skipped"] == 0
                       and file_counts["failed"] == 0})
    if fail_exit:
        sys.exit(fail_exit)


def _read_file(source: str) -> bytes:
    if source == "-":
        return sys.stdin.buffer.read()
    path = Path(source).expanduser()
    try:
        if path.is_file() and path.stat().st_size > SINGLE_PUT_MAX:
            _die(6, "too_large", f"{path} is larger than the {SINGLE_PUT_MAX} bytes one put "
                 "carries")
        return path.read_bytes()
    except FileNotFoundError:
        _die(3, "not_found", f"no file {path}")
    except OSError as exc:
        _die(6, "input", f"cannot read {path}: {exc}")


def cmd_files_add(args) -> None:
    project = _project(write=True)
    name = _checked_file_name(args.name, project)
    document = _checked_name(args.document) if args.document is not None else None
    bucket, _why = _file_store(args.connection, "files add", required=True)
    data = _read_file(args.source)
    if len(data) > SINGLE_PUT_MAX:
        _die(6, "too_large", f"the file is larger than the {SINGLE_PUT_MAX} bytes one put "
             "carries")
    sha = hashlib.sha256(data).hexdigest()
    conn = _open(_root())
    owner = _need_document(conn, project, document) if document is not None else None
    seen = _current_file(conn, project, name)
    put = None
    if seen is None or seen["sha256"] != sha or seen["bytes"] != len(data):
        try:
            put = _upload(bucket, project, name, data, sha)
        except _BucketError as exc:
            _bucket_refused(exc)
    import psycopg
    try:
        with conn.transaction():
            outcome, row, old = _write_file_row(conn, project, name, sha, len(data), put,
                                             owner["id"] if owner else None, _actor(), seen)
    except _StaleFile:
        _stale_file_refusal(name)
    except psycopg.errors.UniqueViolation:
        _stale_file_refusal(name)
    except psycopg.errors.CheckViolation as exc:
        _refused_by_store(exc)
    _emit({"file": _file_out(row, _document_name(conn, row["document_id"])),
           "outcome": outcome, "replaced": str(old["id"]) if old else None,
           "file_store": bucket.cid})


def cmd_files_link(args) -> None:
    project = _project(write=True)
    name = _checked_file_name(args.name, project)
    document = _checked_name(args.document) if args.document is not None else None
    conn = _open(_root())
    owner = _need_document(conn, project, document) if document is not None else None
    wanted = owner["id"] if owner else None
    seen = _current_file(conn, project, name)
    if seen is None:
        _die(3, "not_found", f"no unretired file {name!r} in this project",
             f"`{NAME} files list` names the files there are")
    if seen["document_id"] == wanted:
        _emit({"file": _file_out(seen, document), "outcome": "unchanged", "replaced": None,
               "file_store": None})
        return
    # The record is immutable and names its object by its own id, so a new
    # document is a new record over a copy of the bytes, as any change is.
    bucket, _why = _file_store(args.connection, "files link", required=True)
    try:
        data = bucket.get(seen["storage_key"], size=seen["bytes"], sha256=seen["sha256"])
        put = _upload(bucket, project, name, data, seen["sha256"])
    except _BucketError as exc:
        _bucket_refused(exc)
    del data
    import psycopg
    try:
        with conn.transaction():
            current = _current_file(conn, project, name, lock=True)
            if current is None or current["id"] != seen["id"]:
                raise _StaleFile(name)
            actor = _actor()
            row = _replace_file_row(conn, project, name, seen["sha256"], seen["bytes"], put,
                                    wanted, actor, current)
            _log_file(conn, project, row["id"], "linked" if owner else "unlinked", actor)
    except (_StaleFile, psycopg.errors.UniqueViolation):
        _stale_file_refusal(name)
    except psycopg.errors.CheckViolation as exc:
        _refused_by_store(exc)
    _emit({"file": _file_out(row, document), "outcome": "linked" if owner else "unlinked",
           "replaced": str(seen["id"]), "file_store": bucket.cid})


def _confirmed(act: str, question: str) -> bool:
    """A yes typed on the terminal; never asked where nobody can answer."""
    if not sys.stdin.isatty():
        _die(6, "confirmation_required", f"{act} needs a yes, and there is no terminal "
             "to ask on", "pass --yes")
    sys.stderr.write(f"{question} [y/N] ")
    sys.stderr.flush()
    return sys.stdin.readline().strip().lower() in ("y", "yes")


def cmd_files_rm(args) -> None:
    project = _project(write=True)
    name = _checked_file_name(args.name, project)
    bucket, _why = _file_store(args.connection, "files rm", required=True)
    conn = _open(_root())
    seen = _current_file(conn, project, name)
    if seen is None:
        _die(3, "not_found", f"no unretired file {name!r} in this project",
             f"`{NAME} files list` names the files there are")
    if not args.yes and not _confirmed(
            f"deleting the file {name!r}",
            f"Delete the file {name!r} and every earlier version of it from bucket "
            f"{bucket.bucket!r}? This cannot be undone."):
        _die(6, "not_confirmed", f"the file {name!r} was not deleted",
             "answer y, or pass --yes")
    # Records are never deleted (the store refuses it), so a file leaves by its
    # bytes leaving the bucket and its record being retired. The bytes go first:
    # a refusal half way leaves the name current, so the same rm finishes it.
    keys = [row["storage_key"] for row in _rows(
        conn, "SELECT storage_key FROM assets_files WHERE project_id = %s AND name = %s "
              "ORDER BY created_at", (project, name))]
    try:
        for key in keys:
            bucket.delete(key)
    except _BucketError as exc:
        _bucket_refused(exc)
    import psycopg
    try:
        with conn.transaction():
            current = _current_file(conn, project, name, lock=True)
            if current is None or current["id"] != seen["id"]:
                raise _StaleFile(name)
            row = _one(conn, "UPDATE assets_files SET retired_at = now() WHERE id = %s "
                             f"RETURNING {FILE_COLUMNS}", (seen["id"],))
            _log_file(conn, project, row["id"], "removed", _actor())
    except _StaleFile:
        _stale_file_refusal(name)
    except psycopg.errors.CheckViolation as exc:
        _refused_by_store(exc)
    _emit({"file": _file_out(row, _document_name(conn, row["document_id"])),
           "outcome": "removed", "retired": str(row["id"]), "deleted": keys,
           "file_store": bucket.cid})


def cmd_files_list(_args) -> None:
    project = _project(write=False)
    conn = _open(_root())
    rows = _rows(conn, "SELECT f.*, d.name AS document FROM assets_files f LEFT JOIN "
                       "assets_documents d ON d.id = f.document_id WHERE f.project_id = %s "
                       "AND f.retired_at IS NULL ORDER BY f.name", (project,))
    _emit({"project": project, "count": len(rows),
           "files": [_file_out(row, row["document"]) for row in rows]})


def cmd_files_log(args) -> None:
    project = _project(write=False)
    name = _checked_file_name(args.name, project) if args.name is not None else None
    conn = _open(_root())
    rows = _rows(conn, "SELECT o.id, o.operation, o.created_at, o.created_by, o.file_id, "
                       "f.name, f.bytes, f.sha256, d.name AS document "
                       "FROM assets_file_operations o JOIN assets_files f ON f.id = o.file_id "
                       "LEFT JOIN assets_documents d ON d.id = f.document_id "
                       "WHERE o.project_id = %s AND (%s::text IS NULL OR f.name = %s) "
                       "ORDER BY o.created_at DESC, o.id DESC LIMIT %s",
                 (project, name, name, args.limit))
    _emit({"project": project, "name": name, "count": len(rows),
           "operations": [{"id": str(r["id"]), "operation": r["operation"], "name": r["name"],
                           "file": str(r["file_id"]), "bytes": r["bytes"],
                           "sha256": r["sha256"], "document": r["document"],
                           "at": _iso(r["created_at"]), "by": r["created_by"]}
                          for r in rows]})


def cmd_files_get(args) -> None:
    project = _project(write=False)
    name = _checked_file_name(args.name, project)
    out = None if args.out == "-" else Path(args.out).expanduser()
    if out is not None and out.exists() and not out.is_file():
        _die(6, "output_exists", f"{out} is there and is not a file", "name another --out")
    bucket, _why = _file_store(args.connection, "files get", required=True)
    conn = _open(_root())
    row = _current_file(conn, project, name)
    if row is None:
        _die(3, "not_found", f"no unretired file {name!r} in this project",
             f"`{NAME} files list` names the files there are")
    described = _file_out(row, _document_name(conn, row["document_id"]))
    if out is not None and out.is_file():
        if out.stat().st_size == row["bytes"] and _sha256_of(out) == row["sha256"]:
            _emit({"file": described, "path": str(out), "outcome": "unchanged"})
            return
        _die(6, "output_exists", f"{out} holds other bytes than the file {name!r}",
             "move it away, or name another --out")
    try:
        data = bucket.get(row["storage_key"], size=row["bytes"], sha256=row["sha256"])
    except _BucketError as exc:
        _bucket_refused(exc)
    if out is None:
        sys.stdout.buffer.write(data)
        sys.stdout.buffer.flush()
        return
    try:
        _write_bytes(out, data)
    except OSError as exc:
        _die(6, "input", f"cannot write {out}: {exc}")
    _emit({"file": described, "path": str(out), "outcome": "written"})


def _doctor_connections(wanted: str | None, project: str | None) -> tuple[dict, int]:
    """Each file store connection's bucket (or the one named) by the round
    trips a file verb makes, after the cascade gate: a put, head and delete
    under the project's prefix, or a listing where the connection may not be
    written or there is no project prefix to write under. A connection this
    project may not use is named with the grant it needs, and fails nothing:
    a machine's connection is withheld in every project that never asked for
    it. None configured is nothing to prove. Returns the findings by id and
    the first failure's exit."""
    grants = {} if wanted else _connection_grants()
    withheld = {cid: {"ok": False, "code": "connection_not_granted",
                      "error": f"connection {cid!r} is not granted to this project, so "
                               "no file verb may use it",
                      "hint": _grant_hint(cid)}
                for cid, usable in grants.items() if not usable}
    if not wanted and not any(grants.values()):
        return withheld, 0
    _doctor_gate(_connections_report(), wanted)
    reg, _ = _connections_registry()
    if wanted:
        targets = [_select_connection(reg, wanted)]
    else:
        targets = list(reg["connections"].items())
    found, fail_exit = {}, 0
    for cid, entry in targets:
        entry = entry or {}
        try:
            bucket = _Bucket.of(cid, entry)
            if project and entry.get("allow_write", WRITE_DEFAULT) and not read_only_switch():
                found[cid] = bucket.prove(f"{project}/")
            else:
                found[cid] = bucket.probe(f"{project}/" if project else "")
        except _BucketError as exc:
            found[cid] = {"ok": False, **exc.out()}
            fail_exit = fail_exit or exc.exit_code
    return {**found, **withheld}, fail_exit


def cmd_doctor(wanted: str | None = None) -> None:
    """Whether assets works here now: the project's id, the store setting in
    force, where the tables stand, and each file store connection's bucket."""
    root = _root()
    findings: dict = {}
    project = _project_id(write=True, refuse=False)
    findings["project"] = ({"ok": True, "id": project} if project else
                           {"ok": False, "error": "this project has no durable id a write may "
                            "stamp", "hint": "run `capabilities init` in the project"})
    db = _db()
    try:
        setting = db.resolve_setting(root)
    except db.DbError as exc:
        findings["store"] = {"ok": False, "code": exc.slug, "error": exc.message,
                             "hint": _STORE_HINT if exc.slug == "store_not_configured"
                             else exc.hint}
        _emit({"ok": False, **findings})
        sys.exit(6)
    store = {"setting": setting.report()}
    exit_code = 0 if project else 6
    conn = None
    try:
        conn = db.connect(application_name=NAME, setting=setting, transaction=True)
        found = db.status(conn, NAME, TABLE_STEPS, major=TABLES_MAJOR, minor=TABLES_MINOR)
        store["tables"] = {"state": found.state, "applied": found.applied,
                           "pending": found.pending}
        store["ok"] = found.state in ("current", "pending")
        if not store["ok"]:
            exit_code = exit_code or 6
        if found.state == "current" and project:
            conn.rollback()
            store["documents"] = _one(conn, "SELECT count(*) AS n FROM assets_documents "
                                            "WHERE project_id = %s AND retired_at IS NULL",
                                      (project,))["n"]
    except db.DbError as exc:
        store.update(ok=False, code=exc.slug, error=exc.message, hint=exc.hint)
        exit_code = 6 if exc.slug in _SETTING_SLUGS else 5
    finally:
        if conn is not None:
            conn.close()
    findings["store"] = store
    findings["connections"], bucket_exit = _doctor_connections(wanted, project)
    exit_code = exit_code or bucket_exit
    _emit({"ok": exit_code == 0, **findings})
    if exit_code:
        sys.exit(exit_code)


# ── the command line ─────────────────────────────────────────────────────────

class _Parser(argparse.ArgumentParser):
    """Usage errors leave through the envelope at exit 6."""

    def __init__(self, *args, **kwargs):
        kwargs.setdefault("allow_abbrev", False)
        kwargs.setdefault("add_help", False)
        super().__init__(*args, **kwargs)

    def error(self, message: str) -> NoReturn:
        _die(6, "invalid_arguments", f"{self.prog}: {message}", f"run `{NAME} help`")


def _limit(value: str) -> int:
    try:
        n = int(value)
    except ValueError:
        n = 0
    if n < 1:
        raise argparse.ArgumentTypeError("a positive whole number")
    return n


def _parser() -> _Parser:
    parser = _Parser(prog=NAME)
    sub = parser.add_subparsers(dest="cmd", required=True, parser_class=_Parser)
    one = sub.add_parser("doctor")
    one.add_argument("--connection")
    sub.add_parser("list")
    one = sub.add_parser("show")
    one.add_argument("name")
    one.add_argument("--version")
    one = sub.add_parser("history")
    one.add_argument("name")
    one = sub.add_parser("diff")
    one.add_argument("name")
    one.add_argument("a", nargs="?")
    one.add_argument("b", nargs="?")
    one = sub.add_parser("search")
    one.add_argument("terms")
    one.add_argument("--limit", type=_limit, default=20)
    one = sub.add_parser("save")
    one.add_argument("name")
    one.add_argument("--from", dest="source", required=True)
    one.add_argument("--base")
    one.add_argument("--note")
    one = sub.add_parser("retire")
    one.add_argument("name")
    one = sub.add_parser("import")
    one.add_argument("dir", nargs="?")
    one.add_argument("--connection")
    one = sub.add_parser("export")
    one.add_argument("dir", nargs="?")
    one.add_argument("--connection")
    files = sub.add_parser("files").add_subparsers(dest="files_cmd", required=True,
                                                   parser_class=_Parser)
    one = files.add_parser("add")
    one.add_argument("name")
    one.add_argument("--from", dest="source", required=True)
    one.add_argument("--document")
    one.add_argument("--connection")
    one = files.add_parser("link")
    one.add_argument("name")
    target = one.add_mutually_exclusive_group(required=True)
    target.add_argument("--document")
    target.add_argument("--none", action="store_true")
    one.add_argument("--connection")
    one = files.add_parser("rm")
    one.add_argument("name")
    one.add_argument("--yes", action="store_true")
    one.add_argument("--connection")
    one = files.add_parser("get")
    one.add_argument("name")
    one.add_argument("--out", required=True)
    one.add_argument("--connection")
    files.add_parser("list")
    one = files.add_parser("log")
    one.add_argument("name", nargs="?")
    one.add_argument("--limit", type=_limit, default=100)
    return parser


def main() -> None:
    _gate()
    argv = sys.argv[1:]
    _contract(argv)
    if not argv or argv[0] == "help":
        _cmd_help()
        return
    args = _parser().parse_args(argv)
    verb = f"files {args.files_cmd}" if args.cmd == "files" else args.cmd
    if verb in WRITE_VERBS:
        _read_only_gate(f"`{NAME} {verb}`")
    {"doctor": lambda a: cmd_doctor(a.connection), "list": cmd_list, "show": cmd_show,
     "history": cmd_history, "diff": cmd_diff, "search": cmd_search, "save": cmd_save,
     "retire": cmd_retire, "import": cmd_import, "export": cmd_export,
     "files add": cmd_files_add, "files link": cmd_files_link, "files get": cmd_files_get,
     "files rm": cmd_files_rm, "files list": cmd_files_list,
     "files log": cmd_files_log}[verb](args)


if __name__ == "__main__":
    main()
