#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "capabilities-contract>=0.12,<1",
#     "httpx>=0.27",
#     "psycopg[binary]>=3.2",
# ]
# ///
"""assets — a project's assets: text as documents in the project's store, every
other file in an S3-compatible bucket.

An asset is what an agent keeps beside its work. A markdown asset - a plan, a
research note, a session record, meeting notes, a journal entry, a digest, a
report - is a document: it keeps every version it ever had; one version is
active, and a version is never edited or deleted. A save adds a version;
retiring a document hides it from list, search and export and deletes nothing.
Any other file - an image, a log, a data file - is a file: its bytes are kept
in the bucket of the project's file store connection and its record in the
store, and a replaced file is a new record beside the retired old one.
Agent-invoked: every answer is JSON on stdout.

Assets live in the PostgreSQL the project resolves (the AGENTKIT_DB_* keys in
the project's .env.local / .env, then the process environment, then the
machine's store setting written by `capabilities store set`). Without a store
every verb but the contract's own exits 6 `store_not_configured`.

ADDRESSING
  A document is named by its path under the project's assets/ folder without
  `.md`: `plans/2026-10-20_rollout` is assets/plans/2026-10-20_rollout.md. The
  top folder gives the kind: plans -> plan, research -> research, sessions ->
  session, meetings -> meeting, journal -> journal, digests -> digest,
  reports -> report; any other folder, or none, -> note. A name is one or more
  `/`-separated segments, none empty, `.` or `..`, with no backslash or
  control character, and it does not end in `.md`.
  The body is stored byte for byte as UTF-8 text, so `export` writes back
  exactly the file that was saved. A version's title is the body's first
  `# ` heading, else the name's last segment.
  A version ID is the whole id or its first 6 or more characters, as
  `history` shows it, resolved among the document's own versions.
  A file is named by its whole path under assets/, extension included:
  `research/x/crash.ips` is assets/research/x/crash.ips. The segments follow
  the document rule, and a name ending in `.md` is a document's, not a file's.

THE FILE STORE CONNECTION
  Only the file verbs need it: without one every documents verb works as it
  does with one, `import` lists every file that is not markdown as skipped
  with the reason, `export` writes the documents and lists the files it could
  not fetch, and `doctor` proves the store alone. A connection is any
  S3-compatible bucket (Cloudflare R2, AWS S3, Backblaze B2, MinIO and the
  like), addressed path-style (<endpoint>/<bucket>/<key>) and signed with AWS
  Signature Version 4. Declare one with `assets connection add <id>`; its
  entry, kept where `capabilities` keeps the project's connections, holds:
    endpoint               the store's S3 API URL, e.g.
                           https://<account>.r2.cloudflarestorage.com
    region                 the region requests are signed for: auto for R2,
                           the bucket's region for AWS S3, us-east-1 for most
                           others
    bucket                 the bucket, e.g. example-bucket
    access_key_id_env      the env key holding the access key id
    secret_access_key_env  the env key holding the secret access key
  The two keys never sit in the entry and have no flag: each resolves through
  the cascade, first non-empty wins - the project's .env.local then .env, then
  $XDG_CONFIG_HOME/assets/credentials.env, then the process environment.
  `connection add` takes them on stdin and writes them to the project's
  .env.local as ASSETS_<ID>_ACCESS_KEY_ID and ASSETS_<ID>_SECRET_ACCESS_KEY;
  keys already set elsewhere are named instead, with --env
  access_key_id_env=<KEY> --env secret_access_key_env=<KEY>, and nothing is
  copied.
  A file of the project is the object <project id>/<file id>/<name> in the
  bucket; its record carries its size and sha256, and every read checks both.
  Selection: --connection <id> on the verbs that reach the bucket; unflagged,
  the default pointer, else the sole connection. Writing to the bucket is a
  write: a connection whose allow_write is false refuses `files add`,
  `files link`, `files rm` and an `import` that has files to keep with exit 4
  `read_only`.

READING
  assets list
      Every unretired document of this project, by name: its kind, the active
      version's id and title, and when the document was created and last saved.
  assets show <name> [--version ID]
      One document and its active version with the body whole, and under
      `files` the names of the unretired files that belong to it; --version
      answers any version of the document, a retired one's included.
  assets history <name>
      Every version of the document, newest first: id, title, whether it is
      active, who saved it, when, its note and its size. No bodies.
  assets diff <name> [A] [B]
      A unified diff between two versions of the document, in `diff`. Bare,
      the version before the active one against the active one; with A, A
      against the active one; with A and B, A against B. A document with one
      version is diffed against nothing (`from` is null).
  assets search <terms> [--limit N]
      Full-text search over the active versions of this project's unretired
      documents: PostgreSQL full text in the `simple` configuration (no
      stemming, any language; quoted phrases, `or` and `-` exclusion work as
      in a web search) over title and body, best match first, each with a
      headline of the matching text. --limit defaults to 20; `matched` says
      how many matched in all.

WRITING  (exit 4 `read_only_switch` under CAPABILITIES_READ_ONLY)
  assets save <name> --from FILE|- [--base ID] [--note TEXT]
      Save FILE (`-` reads stdin) as the document's new active version, in one
      transaction that clears `active` on the version it replaces. A new name
      creates the document. --base names the version the writer read: when it
      is no longer the active version, because another save came first, the
      save is refused with exit 7 `stale_base`, naming the active version, and
      nothing changes. Without --base the save replaces whatever version is
      active when it runs. --note says why it changed. Safe to repeat: a body
      identical to the active version's saves nothing and answers
      `"created": false`.
  assets retire <name>
      Retire the document: it leaves list, search and export, its versions stay
      readable through `show --version`, and its name is free for a new
      document. Not idempotent: a repeat finds no unretired document (exit 3).
  assets import [DIR] [--connection ID]
      Read an agent's assets folder (DIR, default the project's assets/) into
      the store: every `.md` file becomes the document its path names, saved
      as `save` saves it, in one transaction; with a file store connection
      every other file is kept as `files add` keeps it, its bytes put in the
      bucket before that transaction and its record written in it. Without a
      connection, every file that is not markdown is listed under `skipped`
      with the reason, as is a markdown file that is not UTF-8 text or a path
      no name can carry; `.DS_Store` and `.gitkeep` are always skipped. Each outcome is reported: a document `created`,
      `saved` (a new version) or `unchanged`; a file `created`, `replaced` (a
      new record, the old one retired) or `unchanged` (the same sha256), with
      the document it belongs to: the one document that links to it by a
      relative path, else the one document in its folder, else the document
      its folder is named after, else none. Safe to repeat.
  assets files add <name> --from FILE|- [--document NAME] [--connection ID]
      Keep FILE (`-` reads stdin) as the file <name>: its bytes are put in the
      bucket under a new key and its record written, retiring the record of
      the file it replaces. --document names the document it belongs to.
      Safe to repeat: bytes identical to the current file's put nothing and
      answer `"outcome": "unchanged"`, the record and its document as they
      were. A single put carries at most 5 GiB.
  assets files link <name> (--document NAME | --none) [--connection ID]
      Set the document the file belongs to, or with --none clear it. Recorded
      as any change to a file is: its bytes are copied in the bucket to a new
      key and a new record is written, retiring the current one, the bytes
      checked against their record on the way. Answers `linked`, `unlinked`,
      or `unchanged` - already so, nothing read or written - with the record
      it `replaced`.
  assets files rm <name> [--yes] [--connection ID]
      Delete the file: the object of every record the name has had, the
      current one and those it replaced, is deleted from the bucket, then the
      current record is retired, so the name leaves `files list`, export and
      its document's `files`, and is free for a new file. The records stay,
      retired, saying what was kept and when; no bytes do. Asks on the
      terminal before deleting; without a terminal it is refused (exit 6
      `confirmation_required`) unless --yes. Answers `removed` with the
      record it `retired` and the storage keys it `deleted`. Not idempotent:
      a repeat finds no unretired file (exit 3).

FILES  (reading; `files list` reads the store only)
  assets files list
      Every unretired file of this project, by name: media type, size,
      sha256, storage key, the document it belongs to, who kept it and when.
  assets files log [<name>] [--limit N]
      The log of writes to this project's file records, newest first (at most
      N, default 100), or only those of the file <name>, a removed one's
      included: each `created` or `replaced` (files add, import), `linked` or
      `unlinked` (files link) or `removed` (files rm), with the record it
      wrote or retired - its name, size, sha256 and document - and who did it
      and when. An `unchanged` answer writes nothing and logs nothing; the
      log starts when the store's assets tables reached schema 1.2.
  assets files get <name> --out PATH|- [--connection ID]
      Fetch the file from the bucket, check its size and sha256 against its
      record, and write it to PATH (`-` writes the bytes alone to stdout, with
      no JSON). A mismatch writes nothing and exits 8. A PATH that already
      holds those bytes is `unchanged`; one holding anything else is refused
      (exit 6 `output_exists`) and left as it is.

EXPORT  (writes no store record and puts nothing in the bucket, so it runs
  under the read-only switch)
  assets export [DIR] [--connection ID]
      Write the active version of every unretired document to DIR (default the
      project's assets/) as <DIR>/<name>.md, and every unretired file to
      <DIR>/<name>, byte for byte, each file's size and sha256 checked before
      it is written. A path already holding those bytes is `unchanged`; one
      holding anything else is `kept` and left as it is (save it, or move it
      away, then export again), and `complete` is false. Without a connection
      a file is `skipped` with the reason and `complete` is false. Paths the
      store does not hold are left alone.

CONTRACT
  assets doctor [--connection ID]
      Proves the store: the setting in force (secrets redacted), whether the
      tables are current, the project id and how many documents it holds; and
      with a file store connection, each connection's bucket (or the one
      named) by a put, head and delete of one throwaway object under the
      project's prefix - by an authenticated listing where the connection may
      not be written, under the read-only switch, or without a project id. A
      connection this project may not use is named `connection_not_granted`
      with the grant it needs, and fails nothing. Without a connection
      `connections` is {} and the store alone decides.
  assets migrate [status]
      Apply pending steps to the assets_* tables / report where they stand.
  assets connections
      Where each file store connection's values resolve from, secrets masked;
      exit 6 `connections_required` when the project declares none.
  assets connection add|remove <id> [--project|--global] [--default]
      [--replace] [--field KEY=VALUE ...] [--stdin]   (also --machine)
      Write or remove a file store connection from its declared fields; the
      two keys only in the JSON object on stdin.
  assets stub | assets manifest --json | assets help
  assets guide [topic]          no guides ship
  assets ids list|get|set|rm    the project identifiers envelope
  assets refs                   the project's reference menu
  assets inventory              empty: what assets holds is the store's

I/O CONTRACT
  Success is JSON on stdout (`files get --out -` writes the file's bytes
  instead); failure is {"error": {"code", "message", "hint"?}} on stderr.

EXIT CODES
  0 success
  2 the file store refused the connection's keys, or a key is unset
  3 not found: no unretired document or file of that name, no such version,
    no DIR, no such bucket
  4 policy: assets not enabled here, the read-only switch on a write, a write
    through a connection without allow_write, a connection not granted here
  5 the store or the file store cannot be reached
  6 input: a malformed name or version, a body that is not UTF-8 text, no
    project, no store configured, no file store connection
    (`connections_required`), an incomplete connection, `files rm` without a
    terminal or --yes (`confirmation_required`)
  7 stale_base: the version --base names is no longer the active one, or
    another write of the same name came first
  8 the bucket does not hold what the record says: `object_missing`, or
    `sha256_mismatch` when the bytes it returns differ in size or sha256
"""

import argparse
import difflib
import hashlib
import json
import os
import re
import sys
from pathlib import Path
from typing import NoReturn

NAME = 'assets'
SUMMARY = ("A project's assets: markdown as versioned documents in the project's PostgreSQL "
           "store - plans, research, sessions, meetings, journal, digests and reports saved "
           "one version at a time, searched in full text and diffed between versions - and "
           "every other file kept byte for byte in an S3-compatible bucket, sha256-checked, "
           "both imported from and exported to an agent's assets folder.")
SCOPE = "project"
CRED_KEYS = [       # a file store connection names its own keys; only the file verbs need one
    {"key": "ASSETS_ACCESS_KEY_ID", "secret": True, "required": False,
     "note": "S3 access key id of the file store; a connection names its own key via "
             "access_key_id_env"},
    {"key": "ASSETS_SECRET_ACCESS_KEY", "secret": True, "required": False,
     "note": "S3 secret access key of the file store; a connection names its own key via "
             "secret_access_key_env"},
]
WRITE_VERBS = {"save", "retire", "import", "files add", "files link", "files rm"}
WRITE_DEFAULT = True    # the bucket, like the store, is the consumer's own
DOCS_BASE = ""
STATE = False
TABLES = True       # the four assets_* tables, built by _tables()
INVENTORY = None    # what assets holds is in the store; reading it is `assets list`
POST_INSTALL: list[dict] = []

# What a person is asked for (SHEBANG.md, "What a person is asked for"):
# a file store connection's own fields, which `connection add` writes.
CONN_FIELDS: list[dict] = [
    {"key": "endpoint", "label": "Endpoint",
     "help": "The S3 API URL of the store, e.g. https://<account>.r2.cloudflarestorage.com.",
     "type": "url", "required": True},
    {"key": "region", "label": "Region",
     "help": "The region requests are signed for: auto for Cloudflare R2, the bucket's "
             "region for AWS S3, us-east-1 for most other stores.",
     "type": "string", "required": True},
    {"key": "bucket", "label": "Bucket",
     "help": "The bucket the project's files are kept in, under a prefix of the project id.",
     "type": "string", "required": True},
    {"key": "access_key_id_env", "label": "Access key id",
     "help": "The S3 access key id.", "type": "string", "secret": True, "required": True,
