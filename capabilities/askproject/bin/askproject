#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "httpx>=0.27",
# ]
# ///
"""
askproject — ask a coding agent running in ANOTHER project to answer in its own
context, then return its answer plus traceability to the caller.

This tool is designed to be invoked BY an agent (you), from inside your own
project. It spawns a headless peer agent in a target project's directory, so
that peer loads the target's project context (Claude reads CLAUDE.md, Codex
reads AGENTS.md) / settings / rights and answers as that project — then hands
back the answer with cost, token, and files-changed data.

Two engines drive the peer, selected with `--engine`:
  claude (default)  headless `claude -p` — the newest Sonnet in read mode, the
                    newest Opus in act mode, at high reasoning effort; override
                    either with --model / --effort.
  codex             headless `codex exec`; uses your ~/.codex/config.toml model
                    (the newest) unless you pass --model. No USD cost is
                    reported under ChatGPT auth, so cost_usd stays null.

Run `askproject help` to (re)load this contract on demand — do not rely on
memorised knowledge of its surface.

────────────────────────────────────────────────────────────────────────────
COMMANDS
  askproject <target> "<question>"        Ask the peer (read-only research).
  askproject <target> --act "<task>"      Let the peer modify its own project.
  askproject <target> -c "<follow-up>"    Continue the last conversation with
                                          that target (resumes its session).
  askproject targets [--json]              List targets you've talked to (this
                                          project) + their last session. Add
                                          --json for machine-readable output.
  askproject help                          Print this document.

<target> is a path to the other project: absolute, ~-expanded, or relative to
your cwd. YOU decide which project to talk to and pass its path. It must be a
directory (a git repo is strongly recommended — see snapshots below).

────────────────────────────────────────────────────────────────────────────
MODES  (the fence; how each engine implements it differs)
  read  (default)   Pure research. claude: ONLY Read/Glob/Grep + plan mode.
                    codex: an OS read-only sandbox (sandbox_mode=read-only) —
                    it may run read-only shell but cannot write. Use for
                    "what does X do", reviews.
  act   (--act)     Peer can edit, run tests, commit, and push from inside the
                    target project without prompts. claude: bypassPermissions +
                    target as --add-dir. codex: bypass approvals + sandbox.
                    Use for "fix X", "refactor".

MODELS: on claude the mode auto-picks the model — reading and comparing code
does not need the top tier, writing it does, so read mode runs the newest Sonnet
and act mode the newest Opus. Pass `--model haiku` to buy a cheaper peer where
the question is small, or name any model to force it. On codex no model is
forced — it uses your ~/.codex/config.toml default (the newest) unless --model
is given.

EFFORT: on claude the peer thinks at `high` reasoning effort by default;
--effort takes low|medium|high|xhigh|max. Effort is a claude-engine control —
codex takes its reasoning settings from your ~/.codex/config.toml, so on codex
the reported effort is null.

FENCING REALITY: read mode is a hard fence (claude has no harmful tools; codex
runs in an OS read-only sandbox). act mode intentionally drops the peer's
prompts so it can complete build work end-to-end. The prompt and the git
snapshot (below) are your safety net.

────────────────────────────────────────────────────────────────────────────
SESSION CONTINUITY  (state is LOCAL to the project you call from)
  The map of "which target → which session" is stored in your project:
    - If capabilities/ exists and is configured: capabilities/askproject/state/
    - Otherwise: ~/.local/state/askproject/<project-key>/

  This state is local to YOUR project, not the targets. `-c/--continue` resumes
  the last session for that target with its original engine and read/act mode;
  add --fork to branch instead of continue.

  Scope a session to ONE unit of work — resume with -c only while on that
  same item; start a fresh call for a new one; use --fork to branch off an
  existing thread without polluting it. Sessions that span unrelated tasks
  just carry dead context and grow costly — short, task-scoped is optimal.
  Use `askproject targets` to see which sessions exist and when they were
  last used.

────────────────────────────────────────────────────────────────────────────
OUTPUT  (stdout = one JSON object; use --text to get just the answer)
  {
    "ok": bool, "error": str|null,
    "target": "<abs path>", "engine": "claude|codex", "mode": "read|act",
    "model": "<model id>|null", "effort": "<level>|null",
    "session_id": "<uuid>", "resumed": bool,
    "answer": <string OR parsed object when --schema is used>,
    "cost_usd": float, "duration_ms": int, "num_turns": int,
    "tokens": {input, output, cache_read, cache_creation},
    "git": {"repo": bool, "head_before","head_after","dirty_before",
            "files_changed":[{"path","status"}]},
    "permission_denials": [ ... attempts the peer made and was blocked on ... ]
  }
  In read mode files_changed must be empty; if it isn't, ok=false and it is
  flagged loudly (a read query should never mutate).

  While the peer runs, concise stage updates are streamed to stderr. They are
  derived from the engines' native event streams and intentionally omit full
  commands, command output, reasoning, and the final answer. This keeps stdout
  machine-parseable while letting an invoking agent see that work is moving.
  Pass --quiet to suppress these updates for callers that require silent stderr.

FLAGS
  --engine <claude|codex>  Which peer engine to spawn (default: claude, or
                        $ASKPROJECT_ENGINE). A -c resume adopts the session's
                        own engine — a codex thread can't be resumed by claude.
  --act                 Modification mode (bypass prompts).
  -c, --continue        Resume the last session for this target, retaining its
                        engine and read/act mode.
  --fork                Reserved; neither headless CLI has a non-interactive
                        fork, so this exits with a controlled error.
  --model <m>           Override the model, forcing it regardless of mode
                        (default on claude: the newest Sonnet in read mode, the
                        newest Opus in act mode, or $ASKPROJECT_MODEL). On claude
                        the `haiku`/`sonnet`/`opus` aliases resolve to known-good
                        full ids; on codex the value is passed straight to
                        `codex -m`.
  --effort <level>      Reasoning effort on claude: low|medium|high|xhigh|max
                        (default: high, or $ASKPROJECT_EFFORT).
  --schema <file|json>  Pass a JSON Schema to constrain the peer's answer;
                        `answer` is then the parsed object.
  --timeout <seconds>   Kill the peer after N seconds (default 3600).
  --text                Print only the answer to stdout (still exits non-zero
                        on error).
  --quiet               Suppress the concise progress stream on stderr.
  --append <text>       Extra instruction appended to the peer's system prompt.

EXAMPLES
  askproject ../shop "Which file defines the pricing taxonomy?"
  askproject ~/dev/api --act "Add a --json flag to the export command"
  askproject ../shop -c "And where is it consumed?"
  askproject ../shop --engine codex "Trace the checkout flow end to end"

────────────────────────────────────────────────────────────────────────────
CONTRACT  (self-description an agent loads on demand; this capability has NO
           connections — it drives the local `claude`/`codex` CLI, no creds)
  askproject doctor        Readiness — reports which engine CLIs are on PATH.
  askproject stub          One-line awareness text.
  askproject manifest      Machine-readable declaration (JSON).
  askproject guide [topic] How-to guides — none ship; the menu is empty.
  askproject ids …         Project identifier store (list/get/set/rm).
  askproject refs          Project references menu.
  askproject connections   Connections report — empty; this capability has none.
"""

import argparse
import json
import os
import queue
import shutil
import subprocess
import sys
import threading
import time
from pathlib import Path
from typing import NoReturn

# --- Capability declaration — one home for every contract fact ---------------

NAME = "askproject"
SUMMARY = ("Bridge to a coding agent in ANOTHER project — spawn a headless peer "
           "(claude or codex) in a target project, fenced by mode (read/act), and "
           "return its answer with cost, token, and files-changed traceability.")
SCOPE = "user"      # credential scope: "project" | "user"
CRED_KEYS: list = []   # no credentials — it drives the local `claude` CLI on PATH
DOCS_BASE = ""
STATE = True        # session map lives in capabilities/askproject/state/ (or fallback)
POST_INSTALL: list = []

_CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
CREDENTIALS_ENV = _CONFIG_HOME / "askproject" / "credentials.env"
_STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state"))

ENGINES = ("claude", "codex")
DEFAULT_ENGINE = "claude"

# claude: the mode picks the model — reading and comparing code does not need the
# top tier, writing it does; these aliases resolve to full ids. codex: no model is
# forced — it falls back to ~/.codex/config.toml (the newest).
READ_MODEL = "claude-sonnet-5"
ACT_MODEL = "claude-opus-5"
MODEL_ALIASES = {
    "haiku": "claude-haiku-4-5-20251001",
    "sonnet": READ_MODEL,
    "opus": ACT_MODEL,
}

# claude: `--effort` levels. codex takes its reasoning settings from its own
# config, so effort is a claude-engine control and stays null elsewhere.
EFFORT_LEVELS = ("low", "medium", "high", "xhigh", "max")
DEFAULT_EFFORT = "high"
DEFAULT_TIMEOUT = 3600

# >>> contract: capability core (generated — edit contract/preamble.py, run `capabilities sync-contract`) >>>

# --- Error reporting ---------------------------------------------------------

def _die(exit_code: int, code: str, message: str,
         hint: str | None = None, status: int | None = None) -> NoReturn:
    err: dict = {"code": code, "message": message}
    if hint:
        err["hint"] = hint
    if status is not None:
        err["status"] = status
    sys.stderr.write(json.dumps({"error": err}, ensure_ascii=False) + "\n")
    sys.exit(exit_code)


def _emit(value) -> None:
    if isinstance(value, str):
        sys.stdout.write(value)
        if value and not value.endswith("\n"):
            sys.stdout.write("\n")
    else:
        sys.stdout.write(json.dumps(value, ensure_ascii=False, indent=2) + "\n")


# --- Project / file plumbing -------------------------------------------------

def _parse_env_file(path: Path) -> dict:
    """Parse a KEY=VALUE env/dotenv file. Missing/unreadable file -> {}."""
    out: dict = {}
    try:
        text = path.read_text()
    except OSError:
        return out
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        k = k.strip()
        if k.startswith("export "):
            k = k[len("export "):].strip()
        out[k] = v.strip().strip('"').strip("'")
    return out


def _project_root() -> Path | None:
    """Nearest project root, walking up from $CLAUDE_PROJECT_DIR (else cwd):
    the first directory holding capabilities/, legacy .capabilities/,
    .contextkit/config.toml, .env(.local), or .git.
    Markers are read from the filesystem alone: the root is what the envelope
    location is resolved against, so resolving one cannot depend on the other.
    $HOME is never a project root (the machine registry lives there)."""
    start = os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
    here = Path(start).resolve()
    home = Path.home().resolve()
    for d in (here, *here.parents):
        if d == home:
            return None
        # Either marker names a project. `settings.json` is the gate and
        # `project.json` the identity; a project keeping its records in the
        # store needs the second and may eventually stop carrying the first,
        # so neither is required while both worlds are in use.
        if ((d / "capabilities" / "settings.json").is_file()
                or (d / "capabilities" / "project.json").is_file()
                or (d / ".contextkit" / "config.toml").is_file()
                or (d / ".capabilities").is_dir()
                or (d / ".env").exists()
                or (d / ".env.local").exists() or (d / ".git").is_dir()):
            return d
    return None


_ENVELOPE_HOME: dict = {}


def _validated_project_envelope(root: Path, raw, provider: str) -> Path:
    """Validate the manager/context-owner answer without selecting a fallback."""
    value = str(raw or "").strip()
    if not value:
        _die(6, "project_envelope_empty",
             f"{provider} returned an empty capabilities envelope path")
    candidate = Path(value).expanduser()
    if not candidate.is_absolute():
        _die(6, "project_envelope_relative",
             f"{provider} returned a relative capabilities envelope path: {value!r}")
    try:
        resolved = candidate.resolve()
        resolved.relative_to(root.resolve())
    except (OSError, ValueError):
        _die(6, "project_envelope_outside_project",
             f"{provider} returned a capabilities envelope outside the project: {candidate}")
    return resolved


def _manager_project_envelope(root: Path) -> Path:
    """Consume the capabilities manager's one authoritative project answer."""
    override = os.environ.get("CAPABILITIES_PROJECT_ENVELOPE", "").strip()
    if override:
        return _validated_project_envelope(root, override, "environment handoff")

    import subprocess

    env = dict(os.environ)
    env["CLAUDE_PROJECT_DIR"] = str(root)
    manager = os.environ.get("CAPABILITIES_MANAGER_BIN", "").strip()
    if not manager:
        source_manager = Path(__file__).resolve().parents[3] / "bin" / "capabilities"
        manager = str(source_manager) if source_manager.is_file() else "capabilities"
    try:
        proc = subprocess.run(
            [manager, "path", "--json"], cwd=root, env=env,
            capture_output=True, text=True, timeout=10)
    except FileNotFoundError:
        _die(6, "capabilities_manager_unavailable",
             "the capabilities manager is required to resolve the project envelope",
             "install or repair the `capabilities` command")
    except subprocess.TimeoutExpired:
        _die(6, "capabilities_path_timeout",
             "the capabilities manager did not resolve the project envelope within 10 seconds")
    except OSError as exc:
        _die(6, "capabilities_manager_unavailable",
             f"could not run the capabilities manager: {exc}")
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip()
        try:
            error = json.loads(detail).get("error", {})
        except (AttributeError, ValueError):
            error = {}
        _die(proc.returncode if proc.returncode in (3, 4, 5, 6) else 6,
             str(error.get("code") or "capabilities_path_failed"),
             str(error.get("message") or "the capabilities manager could not resolve the project envelope"),
             str(error.get("hint") or detail or "run `capabilities path --json` for details"))
    try:
        answer = json.loads(proc.stdout)
    except ValueError as exc:
        _die(6, "capabilities_path_malformed",
             f"the capabilities manager returned invalid JSON: {exc}")
    if not isinstance(answer, dict):
        _die(6, "capabilities_path_malformed",
             "the capabilities manager path answer must be a JSON object")
    manager_root = Path(str(answer.get("project_root") or ""))
    if not manager_root.is_absolute() or manager_root.resolve() != root.resolve():
        _die(6, "capabilities_project_mismatch",
             "the capabilities manager resolved a different project root")
    provider = str(answer.get("provider") or "capabilities manager")
    return _validated_project_envelope(
        root, answer.get("project_envelope"), provider)


def _envelope_home(root: Path) -> Path:
    """The project's envelope root, resolved once per invocation.

    The capabilities manager owns project-envelope discovery, including any
    delegation to ContextKit. Capability CLIs consume that answer and never
    duplicate context-owner detection.
    """
    cached = _ENVELOPE_HOME.get(root)
    if cached is not None:
        return cached
    home = _manager_project_envelope(root)
    _ENVELOPE_HOME[root] = home
    return home


def _project_capabilities_dir(root: Path) -> Path:
    """The active project envelope root.

    The resolved envelope is canonical. A legacy `.capabilities/` remains
    readable until `capabilities init` migrates it. If both exist, the canonical
    tree wins once it carries settings.json; otherwise the legacy configured tree
    remains active so merely creating an empty visible directory loses no gate.
    """
    current = _envelope_home(root)
    legacy = root / ".capabilities"
    if (current / "settings.json").is_file() or not legacy.is_dir():
        return current
    return legacy


def _project_env() -> dict:
    """Project .env(.local) at the project root. .env.local overrides .env."""
    root = _project_root()
    if root is None:
        return {}
    merged = _parse_env_file(root / ".env")
    merged.update(_parse_env_file(root / ".env.local"))  # .local wins
    return merged


def _auth_context() -> dict | None:
    """Optional runtime authority envelope passed by an ingress/service.

    Absence means the ordinary project gate is the whole policy. Presence means
    a request-scoped authority layer exists and must fail closed before any
    credential or network work happens.
    """
    raw = os.environ.get("CAPABILITIES_AUTH_CONTEXT")
    if not raw:
        return None
    try:
        if raw.lstrip().startswith("{"):
            data = json.loads(raw)
        else:
            data = json.loads(Path(raw).read_text())
    except (OSError, ValueError) as e:
        _die(4, "auth_context_unreadable",
             "runtime authority context could not be read",
             f"{raw}: {e}")
    if not isinstance(data, dict):
        _die(4, "auth_context_invalid",
             "runtime authority context is not an object")
    return data


def _auth_capability_allowed(rule) -> bool:
    if rule is True or rule == "*":
        return True
    if rule in (False, None):
        return False
    if isinstance(rule, dict):
        if rule.get("deny") is True:
            return False
        if rule.get("enabled") is False or rule.get("allow") is False:
            return False
        return True
    return False


def _auth_gate() -> None:
    ctx = _auth_context()
    if ctx is None:
        return
    allowed = ctx.get("allowed_capabilities")
    if allowed is None:
        return
    if allowed is True or allowed == "*":
        return
    if isinstance(allowed, list):
        if NAME in allowed or "*" in allowed:
            return
    elif isinstance(allowed, dict):
        if _auth_capability_allowed(allowed.get(NAME, allowed.get("*"))):
            return
    else:
        _die(4, "auth_context_invalid",
             "runtime authority context has invalid allowed_capabilities")
    source = ctx.get("source") or "runtime"
    role = ctx.get("sender_role") or ctx.get("role") or "unknown"
    chat = ctx.get("chat_id") or "unknown"
    _die(4, "capability_not_authorized",
         f"{NAME} is not authorized for this {source} request",
         f"role={role}; chat_id={chat}; adjust runtime authority policy instead of bypassing the gate")


def _policy_entry(path: Path):
    if not path.is_file():
        return None
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError) as e:
        _die(6, "bad_policy", f"cannot read capability policy {path}: {e}")
    capabilities = data.get("capabilities") if isinstance(data, dict) else None
    if not isinstance(capabilities, dict):
        _die(6, "bad_policy", f"{path} is not a capability policy",
             'expected {"capabilities": {"<name>": {"enabled": true}}}')
    entry = capabilities.get(NAME)
    if entry is not None and (not isinstance(entry, dict)
                              or set(entry) != {"enabled"}
                              or not isinstance(entry.get("enabled"), bool)):
        _die(6, "bad_policy", f"invalid {NAME} policy entry in {path}",
             'expected {"enabled": true|false}')
    return entry


def _project_enabled_explicitly() -> bool:
    """True only for an explicit project enabled entry; global inheritance is
    deliberately insufficient for project-owned service activation."""
    root = _project_root()
    if root is None:
        return False
    entry = _policy_entry(_project_capabilities_dir(root) / "settings.json")
    return isinstance(entry, dict) and entry.get("enabled") is True


def _require_project_enabled_for_service() -> Path:
    root = _project_root()
    if root is None or not _project_enabled_explicitly():
        _die(4, "project_enable_required",
             f"{NAME} service activation requires an explicit project enable",
             f"ask the user, then run `capabilities enable {NAME} --project` "
             "before service init/start/run")
    return root


def _gate() -> None:
    """Project policy overrides global policy; absence inherits, and absence at
    both scopes is default deny. Safe local discovery verbs remain available so
    a disabled capability can be understood and configured before use.

    If an ingress supplied CAPABILITIES_AUTH_CONTEXT, that request-scoped gate
    is stricter and runs first, before credentials or network calls.
    """
    _auth_gate()
    verb = sys.argv[1] if len(sys.argv) > 1 else "help"
    service_action = sys.argv[2] if len(sys.argv) > 2 else None
    service_contract = globals().get("SERVICE")
    if isinstance(service_contract, dict) and verb == "service" \
            and service_action in {"init", "start", "run"}:
        _require_project_enabled_for_service()
    if verb in {"help", "stub", "manifest", "connections"}:
        return
    root = _project_root()
    project_file = (_project_capabilities_dir(root) / "settings.json") \
        if root is not None else None
    project_entry = _policy_entry(project_file) if project_file else None
    global_file = _CONFIG_HOME / "capabilities" / "settings.json"
    global_entry = _policy_entry(global_file)
    if isinstance(project_entry, dict) and project_entry.get("enabled") is True:
        return
    if isinstance(project_entry, dict) and project_entry.get("enabled") is False:
        _die(4, "disabled",
             f"{NAME} is disabled in this project ({project_file})",
             f"ask the user whether to enable {NAME} for this project; if yes, "
             f"run `capabilities enable {NAME} --project`")
    if isinstance(global_entry, dict) and global_entry.get("enabled") is True:
        return
    if isinstance(global_entry, dict) and global_entry.get("enabled") is False:
        message = f"{NAME} is disabled globally ({global_file})"
    else:
        message = f"{NAME} is not enabled by project or global policy"
    _die(4, "not_enabled", message,
         f"ask the user whether to enable {NAME} only for this project or "
         f"globally for every project; then run `capabilities enable {NAME} "
         "--project` or `--global` exactly as requested")


def _env_dir() -> Path | None:
    """The capability's envelope dir in the project's active capabilities/."""
    root = _project_root()
    return (_project_capabilities_dir(root) / NAME) if root is not None else None


def _store_mode() -> tuple[str, str]:
    """Whether this project keeps its records in files or in the store, and what
    answered. One project may be moved without moving any other, so the answer is
    per project and lives beside the project's identity — it has to be readable
    before the store is reachable.

    A project says nothing: files, which is every project that has not moved.
    `CAPABILITIES_STORE_MODE` overrides for one invocation, for comparing the two
    against each other. Nothing falls back silently in either direction: a
    project on the store that cannot reach it fails rather than reading a stale
    file it would have no way to report."""
    if "open_store" not in globals():
        return ("files", "capability carries no store tier")
    override = os.environ.get("CAPABILITIES_STORE_MODE")
    if override:
        if override not in ("files", "db"):
            _die(6, "bad_store_mode", f"CAPABILITIES_STORE_MODE must be files or db, got {override!r}")
        return (override, "CAPABILITIES_STORE_MODE")
    root = _project_root()
    if root is None:
        return ("files", "no project")
    identity_file = _project_capabilities_dir(root) / "project.json"
    try:
        identity = json.loads(identity_file.read_text())
    except (OSError, ValueError):
        return ("files", "no project identity")
    mode = identity.get("store", "files")
    if mode not in ("files", "db"):
        _die(6, "bad_store_mode", f"{identity_file} declares store {mode!r}",
             "expected \"files\" or \"db\"")
    return (mode, str(identity_file))


def _project_identity() -> dict:
    root = _project_root()
    if root is None:
        _die(6, "no_project", "no project here to resolve records for")
    identity_file = _project_capabilities_dir(root) / "project.json"
    try:
        identity = json.loads(identity_file.read_text())
    except (OSError, ValueError) as e:
        _die(6, "no_project_identity", f"cannot read {identity_file}: {e}",
             "run `capabilities init` in the project")
    if not identity.get("slug"):
        _die(6, "no_project_identity", f"{identity_file} declares no slug")
    return identity


def _state_dir() -> Path:
    """State follows the scope of the credentials that minted it; project state
    lands inside the envelope only where capabilities/ already exists."""
    if SCOPE == "project":
        root = _project_root()
        if root is not None:
            envelope = _project_capabilities_dir(root)
            if (envelope / "settings.json").is_file():
                return envelope / NAME / "state"
    return _STATE_HOME / NAME


# --- Capability contract — the declaration surface --------------------------

def _docs_base() -> str:
    key = f"{NAME.upper()}_DOCS_BASE"
    return (_project_env().get(key)
            or _parse_env_file(CREDENTIALS_ENV).get(key)
            or os.environ.get(key)
            or DOCS_BASE)


def _guide_dir() -> Path:
    executable = Path(__file__).resolve()
    bundle = (executable.parent.parent
              if executable.parent.name == "bin" else executable.parent)
    return bundle / "guides"


def _guide_menu() -> list[dict[str, str]]:
    menu = []
    guide_dir = _guide_dir()
    files = sorted(guide_dir.glob("*.md")) if guide_dir.is_dir() else []
    for path in files:
        lines = path.read_text().splitlines()
        title = ""
        title_index = -1
        for index, line in enumerate(lines):
            if line.startswith("# "):
                title = line[2:].strip()
                title_index = index
                break
        paragraph = []
        for line in lines[title_index + 1:]:
            stripped = line.strip()
            if not stripped:
                if paragraph:
                    break
                continue
            if stripped.startswith("#"):
                break
            paragraph.append(stripped)
        topic = path.stem
        menu.append({
            "topic": topic,
            "title": title,
            "preview": " ".join(paragraph),
            "command": f"{NAME} guide {topic}",
        })
    return menu


def _cmd_guide(argv: list[str]) -> None:
    menu = _guide_menu()
    if not argv:
        _emit(menu); return
    topic = argv[0]
    topics = {entry["topic"] for entry in menu}
    if topic not in topics:
        _die(3, "not_found", f"no guide topic {topic!r}",
             f"run `{NAME} guide` to list available guides")
    import urllib.error as _ue
    import urllib.request as _ur
    url = _docs_base().rstrip("/") + "/" + topic + ".md"
    cache_dir = _STATE_HOME / NAME / "guides"
    cache, etag_f = cache_dir / f"{topic}.md", cache_dir / f"{topic}.etag"
    headers = {}
    if cache.exists() and etag_f.exists():
        headers["If-None-Match"] = etag_f.read_text().strip()
    try:
        req = _ur.Request(url, headers=headers)
        with _ur.urlopen(req, timeout=10.0) as resp:
            text = resp.read().decode(resp.headers.get_content_charset() or "utf-8")
            cache_dir.mkdir(parents=True, exist_ok=True)
            cache.write_text(text)
            if resp.headers.get("etag"):
                etag_f.write_text(resp.headers["etag"])
            _emit(text); return
    except _ue.HTTPError as e:
        if e.code == 304 and cache.exists():
            _emit(cache.read_text()); return
        if e.code == 404:
            _die(3, "not_found", f"guide {topic!r} missing upstream", url)
        err = f"upstream returned {e.code}"
    except _ue.URLError as e:
        err = str(e.reason)
    except OSError as e:
        err = str(e)
    if cache.exists():
        sys.stderr.write(json.dumps(
            {"warning": f"upstream unreachable; serving cached copy ({err})"},
            ensure_ascii=False) + "\n")
        _emit(cache.read_text()); return
    _die(5, "network_error", f"could not fetch guide {topic!r}; no cache exists", url)


def _render_ids_markdown(data: dict) -> str:
    """Render the {label: {value, note}} envelope as the labelled markdown
    list the manager's `capabilities ids <NAME>` also produces — one shared
    format across the ids surface and the identifiers section of `help`."""
    lines: list[str] = []
    for label, entry in sorted(data.items()):
        entry = entry if isinstance(entry, dict) else {"value": entry}
        v = entry.get("value")
        vs = f"`{v}`" if isinstance(v, str) else "`" + json.dumps(v, ensure_ascii=False) + "`"
        line = f"- **{label}**: {vs}"
        note = entry.get("note")
        if note:
            line += f" — {note}"
        lines.append(line)
    return "\n".join(lines)


def _identifiers_scopes() -> "Scopes":
    identity = _project_identity()
    return Scopes(project=identity["slug"])


def _identifiers_load() -> dict:
    """The identifiers envelope, from wherever this project keeps its records.

    The shape is the same either way — `{label: {value, note}}` — so the help
    section, the report and `ids get` never learn which answered."""
    mode, _why = _store_mode()
    if mode == "db":
        try:
            with open_store() as store:
                resolved = store.config_resolve(NAME, "identifier", _identifiers_scopes())
        except StoreError as e:
            _die(6, e.slug, e.message, e.hint)
        # Key order matches the file envelope's `sort_keys` output so the two
        # sources diff cleanly against each other.
        return {label: {"note": row["note"] or "", "value": row["value"]}
                for label, row in sorted(resolved.items())}
    envdir = _env_dir()
    ids_file = (envdir / "identifiers.json") if envdir else None
    if not ids_file or not ids_file.exists():
        return {}
    try:
        data = json.loads(ids_file.read_text())
    except (OSError, ValueError):
        _die(6, "bad_envelope", f"{ids_file} is not valid JSON")
    return data if isinstance(data, dict) else {}


def _identifiers_write(label: str, value, note: str) -> None:
    """Rule 15 holds either way: a capability is the sole writer of its own
    identifiers, addressed by (capability, collection) rather than by path."""
    mode, _why = _store_mode()
    if mode == "db":
        try:
            with open_store() as store:
                store.config_set(NAME, "identifier", label, value,
                                 _identifiers_scopes().write_target("project"),
                                 actor=f"{NAME} ids set", note=note or None)
        except StoreError as e:
            _die(6, e.slug, e.message, e.hint)
        return
    envdir = _env_dir()
    if envdir is None or not (envdir.parent / "settings.json").is_file():
        _die(6, "no_envelope", "no capabilities/ envelope in this project",
             "run `capabilities init` first")
    data = _identifiers_load()
    data[label] = {"value": value, "note": note or (data.get(label) or {}).get("note", "")}
    envdir.mkdir(parents=True, exist_ok=True)
    (envdir / "identifiers.json").write_text(
        json.dumps(data, ensure_ascii=False, indent=2, sort_keys=True) + "\n")


def _identifiers_remove(label: str) -> None:
    mode, _why = _store_mode()
    if mode == "db":
        try:
            with open_store() as store:
                store.config_delete(NAME, "identifier", label,
                                    _identifiers_scopes().write_target("project"),
                                    actor=f"{NAME} ids rm")
        except StoreError as e:
            _die(6, e.slug, e.message, e.hint)
        return
    envdir = _env_dir()
    data = _identifiers_load()
    del data[label]
    (envdir / "identifiers.json").write_text(
        json.dumps(data, ensure_ascii=False, indent=2, sort_keys=True) + "\n")


def _identifiers_section() -> str:
    """The Identifiers block appended to the bare top-level help — deterministic
    first-touch surfacing of `capabilities/<NAME>/identifiers.json` so an
    agent following the `<NAME> help` startup protocol loads the discovered
    labels/values/notes into context at once. Empty when no project envelope
    or nothing recorded (do not bloat help with an empty section)."""
    if _store_mode()[0] == "files" and _env_dir() is None:
        return ""
    data = _identifiers_load()
    if not data:
        return ""
    header = (
        "\n═══ Identifiers ═════════════════════════════════════════════════════════════\n\n"
        f"Structural lookups discovered for `{NAME}` in this project. Fetch a single\n"
        f"raw value with `{NAME} ids get <label>`; the full envelope is also at\n"
        f"`capabilities ids {NAME}`.\n\n"
    )
    return header + _render_ids_markdown(data) + "\n"


def _cmd_help() -> None:
    """Bare top-level help: the CLI's HELP body (module-level `HELP` if
    defined, else the module docstring), then the project's Identifiers
    section. Only fires when no extra args follow — per-verb help stays
    untouched so `<NAME> help <subcommand>` is not intercepted."""
    g = globals()
    text = g.get("HELP") or g.get("__doc__") or ""
    if text.startswith("\n"):
        text = text.lstrip("\n")
    sys.stdout.write(text)
    if text and not text.endswith("\n"):
        sys.stdout.write("\n")
    section = _identifiers_section()
    if section:
        sys.stdout.write(section)


def _cmd_ids(argv: list[str]) -> None:
    sub = argv[0] if argv else "list"
    data = _identifiers_load()
    if sub == "list":
        _emit(data); return
    if sub == "get":
        if len(argv) < 2 or argv[1] not in data:
            _die(3, "not_found", "unknown identifier label",
                 f"`{NAME} ids list` shows the labels")
        _emit((data[argv[1]] or {}).get("value")); return
    if sub == "set":
        if len(argv) < 3:
            _die(6, "input", f"usage: {NAME} ids set <label> <value> [--note <text>]")
        label, raw = argv[1], argv[2]
        try:
            value = json.loads(raw)
        except ValueError:
            value = raw
        note = ""
        if "--note" in argv:
            ni = argv.index("--note")
            if ni + 1 >= len(argv):
                _die(6, "input", "--note needs a value")
            note = argv[ni + 1]
        _identifiers_write(label, value, note)
        _emit({"set": label}); return
    if sub == "rm":
        if len(argv) < 2 or argv[1] not in data:
            _die(3, "not_found", "unknown identifier label",
                 f"`{NAME} ids list` shows the labels")
        _identifiers_remove(argv[1])
        _emit({"removed": argv[1]}); return
    _die(6, "input", f"unknown ids subcommand {sub!r}", f"{NAME} ids list|get|set|rm")


REFERENCE_PREFIX = "reference."


def _front_matter(body: str) -> tuple[str | None, str | None]:
    """`name` and `description` out of a reference's leading front matter."""
    lines = body.splitlines()
    if not lines or lines[0].strip() != "---":
        return None, None
    name = desc = None
    for line in lines[1:30]:
        if line.strip() == "---":
            break
        if line.startswith("name:"):
            name = line.split(":", 1)[1].strip()
        elif line.startswith("description:"):
            desc = line.split(":", 1)[1].strip()
    return name, desc


def _reference_bodies() -> dict[str, str]:
    """Every reference this project can see, keyed by its document key.

    In the store a reference is a pinned document like any other long text, so
    an edit reaches every host at once and an unpinned draft reaches none."""
    mode, _why = _store_mode()
    if mode == "db":
        scopes = _identifiers_scopes()
        out: dict[str, str] = {}
        try:
            with open_store() as store:
                for key in store.context_keys(NAME, scopes):
                    if not key.startswith(REFERENCE_PREFIX):
                        continue
                    doc = store.context_read(NAME, key, scopes)
                    if doc:
                        out[key] = doc["body"]
        except StoreError as e:
            _die(6, e.slug, e.message, e.hint)
        return out
    envdir = _env_dir()
    refdir = (envdir / "reference") if envdir else None
    if not refdir or not refdir.is_dir():
        return {}
    bodies = {}
    for md in sorted(refdir.glob("*.md")):
        try:
            bodies[REFERENCE_PREFIX + md.stem.replace("_", "-").lower()] = md.read_text()
        except OSError:
            continue
    return bodies


def _cmd_refs(argv: list[str] | None = None) -> None:
    """`refs` lists what this project can load; `refs show <name>` prints one.

    The listing carries a `source` rather than a path, because a reference kept
    in the store has no path to open — `refs show` is the one way to read a
    body that works whichever source answered."""
    argv = argv or []
    bodies = _reference_bodies()
    mode, _why = _store_mode()
    entries = []
    for key, body in sorted(bodies.items()):
        name, desc = _front_matter(body)
        if not name:
            continue
        entry = {"name": name, "description": desc or "", "key": key}
        if mode == "db":
            entry["source"] = _store_source_label()
        else:
            envdir = _env_dir()
            stem = key[len(REFERENCE_PREFIX):]
            entry["path"] = str((envdir / "reference" / f"{stem}.md")) if envdir else ""
        entries.append((name, entry, body))

    if argv and argv[0] == "show":
        if len(argv) < 2:
            _die(6, "input", f"usage: {NAME} refs show <name>")
        wanted = argv[1]
        for name, entry, body in entries:
            if wanted in (name, entry["key"], entry["key"][len(REFERENCE_PREFIX):]):
                sys.stdout.write(body if body.endswith("\n") else body + "\n")
                return
        _die(3, "not_found", f"no reference named {wanted!r}",
             f"`{NAME} refs` lists them")
    if argv:
        _die(6, "input", f"unknown refs subcommand {argv[0]!r}", f"{NAME} refs [show <name>]")
    _emit([entry for _name, entry, _body in entries])


def _contract(argv: list[str]) -> None:
    """Dispatch the contract verbs; domain verbs fall through to the CLI's own
    parser. Runs after _gate(), before any credential is resolved.

    `help` is a contract verb only when bare (no extra args) — the top-level
    dump plus the Identifiers section. `<NAME> help <subcommand>` falls
    through to the CLI so per-verb help stays clean."""
    cmd = argv[0] if argv else ""
    if cmd == "stub":
        _emit(f"{SUMMARY} Run `{NAME} help`.")
    elif cmd == "manifest":
        _emit({"name": NAME, "summary": SUMMARY,
               "credentials": {"scope": SCOPE, "keys": CRED_KEYS},
               "docs": {"base": DOCS_BASE,
                        "topics": [entry["topic"] for entry in _guide_menu()]},
               "state": STATE, "post_install": POST_INSTALL})
    elif cmd == "guide":
        _cmd_guide(argv[1:])
    elif cmd == "ids":
        _cmd_ids(argv[1:])
    elif cmd == "refs":
        _cmd_refs(argv[1:])
    elif cmd == "connections":
        _cmd_connections()
    elif cmd == "help" and len(argv) == 1:
        _cmd_help()
    else:
        return
    sys.exit(0)

# <<< contract: capability core <<<


def _cmd_connections() -> None:
    """Core-only capability: askproject drives the local `claude` CLI and has no
    configured connection, so the connections report is empty by contract."""
    _emit({"connections": {}, "default": None})


def die(msg: str, *, as_json: bool, code: int = 1):
    if as_json:
        print(json.dumps({"ok": False, "error": msg}, indent=2))
    else:
        print(f"askproject: {msg}", file=sys.stderr)
    sys.exit(code)


class PeerTimeout(Exception):
    """A timed-out peer plus the native session id observed before it stopped."""

    def __init__(self, seconds: int, session_id: str | None = None):
        super().__init__(f"peer timed out after {seconds}s")
        self.seconds = seconds
        self.session_id = session_id


def _timeout_output(exc: subprocess.TimeoutExpired) -> str:
    value = exc.output or ""
    if isinstance(value, bytes):
        return value.decode(errors="replace")
    return value


def _parse_claude_session_id(stdout: str) -> str | None:
    for line in (stdout or "").splitlines():
        evt = _event(line)
        if evt and evt.get("session_id"):
            return evt["session_id"]
    return None


def _state_path() -> Path:
    """State home following the standard project envelope convention.

    For projects with a capabilities/ envelope, state lives inside it.
    Otherwise state goes under _STATE_HOME with a project-keyed path.
    """
    root = _project_root()
    if root is not None:
        envelope = _project_capabilities_dir(root)
        # Only use the project envelope if settings.json exists (it's configured)
        if (envelope / "settings.json").is_file():
            state_dir = envelope / NAME / "state"
            state_dir.mkdir(parents=True, exist_ok=True)
            return state_dir / "sessions.json"

    # Fallback: state lives outside any project, keyed by project root path
    if root is not None:
        # Hash the root path for a stable filename
        import hashlib
        key = hashlib.sha256(str(root).encode()).hexdigest()[:16]
        state_dir = _STATE_HOME / NAME / key
    else:
        # No project root at all (bare cwd) - use a default bucket
        state_dir = _STATE_HOME / NAME / "default"

    state_dir.mkdir(parents=True, exist_ok=True)
    return state_dir / "sessions.json"


def _legacy_state_path() -> Path | None:
    """The old .claude/askproject/sessions.json location.
    Returns None if no .git or .claude root exists (matching old behavior)."""
    cwd = Path.cwd().resolve()
    for d in [cwd, *cwd.parents]:
        if (d / ".git").exists() or (d / ".claude").exists():
            legacy = d / ".claude" / "askproject" / "sessions.json"
            return legacy if legacy.exists() else None
    return None


def load_state() -> dict:
    """Load session state, migrating from legacy .claude/ location if needed."""
    p = _state_path()

    # Try the new path first
    if p.exists():
        try:
            return json.loads(p.read_text())
        except json.JSONDecodeError:
            return {}

    # One-time migration from legacy path
    legacy = _legacy_state_path()
    if legacy and legacy.exists():
        try:
            data = json.loads(legacy.read_text())
            # Migrate to new location
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(json.dumps(data, indent=2) + "\n")
            return data
        except (json.JSONDecodeError, OSError):
            pass

    return {}


def save_state(state: dict):
    p = _state_path()
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(state, indent=2) + "\n")


def git(target: Path, *args) -> str | None:
    try:
        out = subprocess.run(
            ["git", "-C", str(target), *args],
            capture_output=True, text=True, timeout=30,
        )
        if out.returncode != 0:
            return None
        return out.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return None


def snapshot(target: Path) -> dict:
    head = git(target, "rev-parse", "HEAD")
    if head is None:
        return {"repo": False}
    status = git(target, "status", "--porcelain") or ""
    return {"repo": True, "head": head, "status": status}


def diff_snapshots(before: dict, after: dict) -> tuple[list[dict], bool]:
    """Return (files_changed, dirty_before)."""
    if not before.get("repo"):
        return [], False
    dirty_before = bool(before.get("status"))
    before_lines = set(before.get("status", "").splitlines())
    after_lines = set(after.get("status", "").splitlines())
    changed = []
    for line in sorted(after_lines - before_lines):
        # porcelain: "XY path"
        code, _, path = line.partition(" ")
        changed.append({"path": path.strip() or line, "status": code.strip()})
    if before.get("head") != after.get("head"):
        changed.append({"path": "<HEAD>", "status": "moved"})
    return changed, dirty_before


def resolve_schema(spec: str) -> str:
    p = Path(spec).expanduser()
    if p.exists():
        return p.read_text()
    return spec  # assume inline JSON


def resolve_model(model: str) -> str:
    return MODEL_ALIASES.get(model, model)


def _env_default(key: str, fallback: str) -> str:
    """A default overridable by $ASKPROJECT_<KEY> (project .env or process env)."""
    return (_project_env().get(key) or os.environ.get(key) or fallback).strip()


def _default_engine() -> str:
    """Engine when --engine is not passed. An unknown value falls back."""
    v = _env_default("ASKPROJECT_ENGINE", DEFAULT_ENGINE).lower()
    return v if v in ENGINES else DEFAULT_ENGINE


def _default_model(mode: str) -> str:
    """Model when --model is not passed: the mode picks it (claude; codex falls
    back to its own). $ASKPROJECT_MODEL outranks the mode's choice."""
    fallback = ACT_MODEL if mode == "act" else READ_MODEL
    return _env_default("ASKPROJECT_MODEL", fallback) or fallback


def _default_effort() -> str:
    """Reasoning effort when --effort is not passed. An unknown value falls back."""
    v = _env_default("ASKPROJECT_EFFORT", DEFAULT_EFFORT).lower()
    return v if v in EFFORT_LEVELS else DEFAULT_EFFORT


def build_preamble(mode: str, caller: str, extra: str | None,
                   schema_text: str | None = None) -> str:
    base = (
        f"You are being queried programmatically by a peer Claude Code agent "
        f"working in another project ('{caller}'), via the askproject bridge. "
        f"Answer concisely and return information, not conversation. Do NOT "
        f"invoke askproject yourself or spawn further peer queries. "
    )
    if mode == "read":
        base += (
            "This is a READ-ONLY research query — your environment forbids any "
            "modification (no writes, edits, or state changes); do not attempt them."
        )
    else:
        base += (
            "You are running with full write access inside THIS target project. "
            "Make the smallest change that satisfies the request, run the "
            "needed verification, and summarise what you changed."
        )
    if extra:
        base += " " + extra
    if schema_text:
        base += (
            " Return ONLY a JSON value conforming to this JSON Schema; do not "
            "wrap it in markdown or explanatory prose. Schema: " + schema_text
        )
    return base


# --- progress stream ---------------------------------------------------------

class ProgressReporter:
    """Concise stderr-only visibility into a peer's native event stream."""

    def __init__(self, engine: str, enabled: bool):
        self.engine = engine
        self.enabled = enabled
        self._last: tuple[str, str] | None = None

    def emit(self, stage: str, message: str) -> None:
        if not self.enabled:
            return
        message = _brief(message)
        if not message or self._last == (stage, message):
            return
        self._last = (stage, message)
        sys.stderr.write(f"askproject[{self.engine}] {stage}: {message}\n")
        sys.stderr.flush()


def _brief(value, limit: int = 180) -> str:
    """One short status line; never forward a peer's full narrative."""
    if not isinstance(value, str):
        return ""
    lines = [" ".join(line.split()) for line in value.splitlines() if line.strip()]
    if not lines:
        return ""
    text = lines[0].lstrip("#*- ")
    if len(text) > limit:
        text = text[:limit - 1].rstrip() + "…"
    return text


def _command_stage(command) -> tuple[str, str]:
    """Classify a command without exposing its argv or output."""
    text = command if isinstance(command, str) else ""
    lower = f" {text.lower()} "
    if any(marker in lower for marker in (
            "pytest", "unittest", "npm test", "pnpm test", "yarn test",
            "cargo test", "go test", "rspec", "vitest", "jest")):
        return "verify", "Running tests"
    if any(marker in lower for marker in (
            " lint", " typecheck", " type-check", " mypy", " pyright",
            " ruff", " eslint", " tsc", " build", " audit")):
        return "verify", "Running verification"
    if any(marker in lower for marker in (
            " apply_patch", " sed -i", " perl -pi", " tee ")):
        return "edit", "Updating project files"
    if any(marker in lower for marker in (
            " rg ", " grep ", " find ", " ls ", " sed -n", " git status",
            " git diff", " git log", " cat ", " head ", " tail ")):
        return "inspect", "Inspecting the project"
    return "work", "Running a project command"


def _tool_stage(name, tool_input=None) -> tuple[str, str]:
    """Map a Claude tool event to a small, host-neutral status vocabulary."""
    name = name if isinstance(name, str) else ""
    if name in ("Read", "Glob", "Grep", "LS", "NotebookRead"):
        return "inspect", "Inspecting the project"
    if name == "Bash":
        command = tool_input.get("command", "") if isinstance(tool_input, dict) else ""
        return _command_stage(command)
    if name in ("Edit", "MultiEdit", "Write", "NotebookEdit"):
        return "edit", "Updating project files"
    if name in ("WebFetch", "WebSearch"):
        return "research", "Checking external documentation"
    if name in ("TodoWrite", "ExitPlanMode"):
        return "plan", "Updating the work plan"
    return "work", "Using a project tool"


def _stream_process(cmd: list[str], *, cwd: str, timeout: int,
                    on_stdout) -> subprocess.CompletedProcess:
    """Capture both pipes without deadlock while delivering stdout lines live."""
    proc = subprocess.Popen(
        cmd, cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
        stderr=subprocess.PIPE, text=True, bufsize=1,
    )
    events: queue.Queue = queue.Queue()

    def pump(kind: str, stream) -> None:
        try:
            for line in iter(stream.readline, ""):
                events.put((kind, line))
        finally:
            events.put((kind, None))

    threads = [
        threading.Thread(target=pump, args=("stdout", proc.stdout), daemon=True),
        threading.Thread(target=pump, args=("stderr", proc.stderr), daemon=True),
    ]
    for thread in threads:
        thread.start()

    captured = {"stdout": [], "stderr": []}
    open_streams = 2
    deadline = time.monotonic() + timeout
    while open_streams:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            proc.kill()
            proc.wait()
            raise subprocess.TimeoutExpired(
                cmd, timeout,
                output="".join(captured["stdout"]),
                stderr="".join(captured["stderr"]),
            )
        try:
            kind, line = events.get(timeout=min(0.25, remaining))
        except queue.Empty:
            continue
        if line is None:
            open_streams -= 1
            continue
        captured[kind].append(line)
        if kind == "stdout":
            on_stdout(line)

    returncode = proc.wait()
    for thread in threads:
        thread.join(timeout=1)
    return subprocess.CompletedProcess(
        cmd, returncode,
        stdout="".join(captured["stdout"]),
        stderr="".join(captured["stderr"]),
    )


def _event(line: str) -> dict | None:
    try:
        value = json.loads(line)
    except (TypeError, ValueError):
        return None
    return value if isinstance(value, dict) else None


class CodexProgress:
    """Render Codex JSONL while withholding the last agent message (the answer)."""

    def __init__(self, reporter: ProgressReporter):
        self.reporter = reporter
        self.pending_message = ""

    def feed(self, line: str) -> None:
        evt = _event(line)
        if evt is None:
            return
        kind = evt.get("type")
        item = evt.get("item") if isinstance(evt.get("item"), dict) else {}
        item_type = item.get("type")

        if kind == "item.completed" and item_type == "agent_message":
            # Codex uses the same event for commentary and the final answer.
            # Hold it until the next event: a following tool makes it commentary;
            # turn.completed makes it the answer, which progress must not echo.
            self.pending_message = _brief(item.get("text"))
            return

        if self.pending_message:
            if kind != "turn.completed":
                self.reporter.emit("update", self.pending_message)
            self.pending_message = ""

        if kind == "thread.started":
            self.reporter.emit("started", "Codex peer started")
        elif kind == "turn.started":
            self.reporter.emit("work", "Peer is working")
        elif kind == "item.started":
            if item_type == "command_execution":
                self.reporter.emit(*_command_stage(item.get("command")))
            elif item_type in ("file_change", "file_changes"):
                self.reporter.emit("edit", "Updating project files")
            elif item_type in ("mcp_tool_call", "dynamic_tool_call"):
                self.reporter.emit("work", "Using a project tool")
            elif item_type == "web_search":
                self.reporter.emit("research", "Checking external documentation")
        elif kind == "item.completed" and item_type == "command_execution":
            if item.get("exit_code") not in (None, 0):
                self.reporter.emit("update", "A command failed; the peer is handling it")
        elif kind == "item.completed" and item_type in ("file_change", "file_changes"):
            self.reporter.emit("edit", "Updated project files")
        elif kind == "turn.completed":
            self.reporter.emit("completed", "Codex peer finished")
        elif kind in ("turn.failed", "error"):
            self.reporter.emit("failed", "Codex peer reported a failure")


def _claude_progress(evt: dict, reporter: ProgressReporter) -> None:
    kind = evt.get("type")
    if kind == "system" and evt.get("subtype") == "init":
        reporter.emit("started", "Claude peer started")
        return
    if kind == "assistant":
        message = evt.get("message") if isinstance(evt.get("message"), dict) else {}
        content = message.get("content") if isinstance(message.get("content"), list) else []
        tools = [block for block in content
                 if isinstance(block, dict) and block.get("type") == "tool_use"]
        if tools:
            # Text accompanying a tool call is commentary, not the final answer.
            for block in content:
                if isinstance(block, dict) and block.get("type") == "text":
                    reporter.emit("update", block.get("text", ""))
                    break
            for block in tools:
                reporter.emit(*_tool_stage(block.get("name"), block.get("input")))
        return
    if kind == "result":
        if evt.get("is_error"):
            reporter.emit("failed", "Claude peer reported a failure")
        else:
            reporter.emit("completed", "Claude peer finished")


# --- engines -----------------------------------------------------------------
# Each engine turns (target, prompt, mode, model, effort, resume) into ONE
# normalized dict so run() stays engine-blind:
#   {answer, session_id, model, effort, cost_usd, duration_ms, num_turns,
#    tokens:{input,output,cache_read,cache_creation}, is_error, permission_denials}

def run_claude(target, prompt, mode, model, effort, caller, append,
               schema_text, resume_id, timeout, as_json,
               reporter: ProgressReporter) -> dict:
    """Headless Claude. Progress uses stream-json; --quiet retains json mode."""
    output_format = "stream-json" if reporter.enabled else "json"
    cmd = ["claude", "-p", prompt, "--output-format", output_format,
           "--model", model, "--effort", effort]
    if reporter.enabled:
        cmd += ["--verbose"]
    if resume_id:
        cmd += ["--resume", resume_id]
    if mode == "read":
        cmd += ["--allowedTools", "Read,Glob,Grep", "--permission-mode", "plan"]
    else:
        cmd += ["--permission-mode", "bypassPermissions", "--add-dir", str(target)]
    cmd += ["--append-system-prompt", build_preamble(mode, caller, append, schema_text)]

    result_event: dict = {}
    try:
        if reporter.enabled:
            def on_stdout(line: str) -> None:
                evt = _event(line)
                if evt is None:
                    return
                _claude_progress(evt, reporter)
                if evt.get("type") == "result":
                    result_event.update(evt)

            proc = _stream_process(cmd, cwd=str(target), timeout=timeout,
                                   on_stdout=on_stdout)
        else:
            proc = subprocess.run(cmd, cwd=str(target), capture_output=True,
                                  text=True, timeout=timeout,
                                  stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired as exc:
        reporter.emit("failed", f"Peer timed out after {timeout}s")
        session_id = _parse_claude_session_id(_timeout_output(exc)) or resume_id
        raise PeerTimeout(timeout, session_id) from exc
    if proc.returncode != 0:
        reporter.emit("failed", f"Claude peer exited with status {proc.returncode}")
        snippet = (proc.stderr or proc.stdout or "").strip()[-800:]
        die(f"peer exited {proc.returncode}: {snippet}", as_json=as_json)
    if reporter.enabled:
        env = result_event
        if not env:
            die(f"could not parse peer output: {proc.stdout[:800]}", as_json=as_json)
    else:
        try:
            env = json.loads(proc.stdout)
        except json.JSONDecodeError:
            die(f"could not parse peer output: {proc.stdout[:800]}", as_json=as_json)

    answer = env.get("result", "")
    if schema_text:
        # structured output may arrive parsed in `structured_output`, or as a
        # JSON string in `result` depending on harness version — handle both.
        if env.get("structured_output") is not None:
            answer = env["structured_output"]
        elif isinstance(answer, str):
            try:
                answer = json.loads(answer)
            except json.JSONDecodeError:
                pass
    usage = env.get("usage", {}) or {}
    return {
        "answer": answer,
        "session_id": env.get("session_id"),
        "model": model,
        "effort": effort,
        "cost_usd": env.get("total_cost_usd"),
        "duration_ms": env.get("duration_ms"),
        "num_turns": env.get("num_turns"),
        "tokens": {
            "input": usage.get("input_tokens"),
            "output": usage.get("output_tokens"),
            "cache_read": usage.get("cache_read_input_tokens"),
            "cache_creation": usage.get("cache_creation_input_tokens"),
        },
        "is_error": bool(env.get("is_error", False)),
        "permission_denials": env.get("permission_denials", []),
    }


def _parse_codex_events(stdout: str) -> tuple[dict, str | None, bool]:
    """Pull usage + thread id (+ any failure) out of codex's --json JSONL."""
    usage: dict = {}
    thread_id = None
    is_error = False
    for line in (stdout or "").splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            o = json.loads(line)
        except ValueError:
            continue
        t = o.get("type")
        if t == "turn.completed":
            usage = o.get("usage") or usage
        elif t == "thread.started":
            thread_id = o.get("thread_id") or thread_id
        elif t in ("turn.failed", "error"):
            is_error = True
    return usage, thread_id, is_error


def run_codex(target, prompt, mode, model, effort, caller, append,
              schema_text, resume_id, timeout, as_json,
              reporter: ProgressReporter) -> dict:
    """Headless `codex exec`. codex has no system-prompt flag, so the peer
    preamble is folded into the prompt; the final message is read from -o and
    usage/thread id from the --json JSONL. Schema uses codex's native
    --output-schema. Reasoning effort comes from ~/.codex/config.toml, so the
    reported effort is null. No USD cost under ChatGPT auth → cost_usd null."""
    import tempfile
    prompt = build_preamble(mode, caller, append, None) + "\n\n" + prompt
    out_fd, outfile = tempfile.mkstemp(prefix="askproject-codex-", suffix=".txt")
    os.close(out_fd)
    schema_file = None
    try:
        cmd = ["codex", "exec"]
        if resume_id:
            cmd += ["resume", resume_id]
        cmd += [prompt, "--skip-git-repo-check", "--json", "-o", outfile]
        if mode == "read":
            # -s/--sandbox is absent on `resume`; the config override works on
            # both the fresh and resume paths and genuinely blocks writes.
            cmd += ["-c", 'sandbox_mode="read-only"', "-c", 'approval_policy="never"']
        else:
            cmd += ["--dangerously-bypass-approvals-and-sandbox"]
        if model:
            cmd += ["-m", model]
        if schema_text:
            s_fd, schema_file = tempfile.mkstemp(prefix="askproject-schema-", suffix=".json")
            os.close(s_fd)
            Path(schema_file).write_text(schema_text)
            cmd += ["--output-schema", schema_file]

        try:
            if reporter.enabled:
                progress = CodexProgress(reporter)
                proc = _stream_process(cmd, cwd=str(target), timeout=timeout,
                                       on_stdout=progress.feed)
            else:
                proc = subprocess.run(cmd, cwd=str(target), capture_output=True,
                                      text=True, timeout=timeout,
                                      stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired as exc:
            reporter.emit("failed", f"Peer timed out after {timeout}s")
            _, session_id, _ = _parse_codex_events(_timeout_output(exc))
            raise PeerTimeout(timeout, session_id or resume_id) from exc
        if proc.returncode != 0:
            reporter.emit("failed", f"Codex peer exited with status {proc.returncode}")
            snippet = (proc.stderr or proc.stdout or "").strip()[-800:]
            die(f"peer exited {proc.returncode}: {snippet}", as_json=as_json)

        answer = Path(outfile).read_text().strip()
        usage, thread_id, evt_error = _parse_codex_events(proc.stdout)
        if schema_text and answer:
            try:
                answer = json.loads(answer)
            except json.JSONDecodeError:
                pass
    finally:
        for f in (outfile, schema_file):
            if f:
                try:
                    os.unlink(f)
                except OSError:
                    pass

    return {
        "answer": answer,
        "session_id": thread_id,
        "model": model,
        "effort": None,
        "cost_usd": None,
        "duration_ms": None,
        "num_turns": None,
        "tokens": {
            "input": usage.get("input_tokens"),
            "output": usage.get("output_tokens"),
            "cache_read": usage.get("cached_input_tokens"),
            "cache_creation": None,
        },
        "is_error": bool(evt_error or not answer),
        "permission_denials": [],
    }


ENGINE_RUNNERS = {"claude": run_claude, "codex": run_codex}


def run(args):
    text_only = args.text
    as_json = not text_only

    target = Path(args.target).expanduser()
    if not target.is_absolute():
        target = (Path.cwd() / target).resolve()
    if not target.is_dir():
        die(f"target is not a directory: {target}", as_json=as_json)

    requested_mode = "act" if args.act else "read"
    root = _project_root()
    caller = root.name if root else Path.cwd().name

    state = load_state()
    key = str(target)
    entry = state.get(key, {})

    # engine selection: explicit --engine > env/default. A -c resume adopts the
    # session's own engine (a codex thread can't be resumed by claude).
    resumed = False
    resume_id = None
    if args.cont:
        last_attempt = entry.get("last_attempt") or {}
        timed_out = last_attempt.get("status") == "timed_out"
        session_source = last_attempt if timed_out else entry
        stored_engine = session_source.get("engine") or entry.get("engine") or "claude"
        if args.engine and args.engine != stored_engine:
            die(f"cannot resume {target} with {args.engine}: the last session "
                f"used {stored_engine}", as_json=as_json)
        engine = args.engine or stored_engine
        resume_id = (session_source.get("session_id") if timed_out
                     else entry.get("last_session_id"))
        if not resume_id:
            if timed_out:
                die(f"the last attempt for {target} timed out before its session "
                    "id was observed; start a fresh call without -c",
                    as_json=as_json)
            die(f"no prior session for {target}; run without -c first", as_json=as_json)
        stored_mode = (session_source.get("mode") or entry.get("last_mode")
                       or requested_mode)
        if args.act and stored_mode != "act":
            die(f"cannot resume {target} in act mode: the last session used "
                f"{stored_mode}; start a fresh call without -c", as_json=as_json)
        mode = stored_mode
        if args.fork:
            die("--fork is not supported in headless mode", as_json=as_json)
        resumed = True
    else:
        engine = args.engine or _default_engine()
        mode = requested_mode

    if not shutil.which(engine):
        die(f"`{engine}` CLI not found on PATH", as_json=as_json)

    if engine == "claude":
        model = resolve_model(args.model or _default_model(mode))
    else:
        model = args.model or None   # codex: fall back to its config default (newest)

    effort = (args.effort or _default_effort()).strip().lower()
    if effort not in EFFORT_LEVELS:
        die(f"unknown effort {args.effort!r}; expected one of "
            f"{', '.join(EFFORT_LEVELS)}", as_json=as_json)

    schema_text = resolve_schema(args.schema) if args.schema else None

    reporter = ProgressReporter(engine, enabled=not args.quiet)
    reporter.emit("starting", f"Launching {engine} peer")
    before = snapshot(target)
    try:
        res = ENGINE_RUNNERS[engine](target, args.prompt, mode, model, effort,
                                     caller, args.append, schema_text, resume_id,
                                     args.timeout, as_json, reporter)
    except PeerTimeout as exc:
        entry["last_attempt"] = {
            "status": "timed_out",
            "engine": engine,
            "mode": mode,
            "session_id": exc.session_id,
            "at": time.time(),
        }
        if exc.session_id:
            entry["last_session_id"] = exc.session_id
            entry["last_model"] = model
            entry["last_effort"] = effort if engine == "claude" else None
            entry["last_mode"] = mode
            entry["engine"] = engine
        state[key] = entry
        save_state(state)
        hint = ("; resume it with -c" if exc.session_id else
                "; no session id was observed, so start a fresh call without -c")
        die(f"peer timed out after {exc.seconds}s{hint}", as_json=as_json)
    after = snapshot(target)
    files_changed, dirty_before = diff_snapshots(before, after)

    answer = res["answer"]
    session_id = res["session_id"]
    ok = not res["is_error"]
    err = None
    if mode == "read" and files_changed:
        ok = False
        err = "READ MODE MUTATED THE TARGET — investigate"

    # persist session mapping (local to the initiating project)
    if session_id:
        entry["last_session_id"] = session_id
        entry["last_model"] = res.get("model")
        entry["last_effort"] = res.get("effort")
        entry["last_mode"] = mode
        entry["engine"] = engine
        entry["interactions"] = entry.get("interactions", 0) + 1
        entry["last_used_at"] = time.time()
        entry["last_attempt"] = {
            "status": "completed",
            "engine": engine,
            "mode": mode,
            "session_id": session_id,
            "at": entry["last_used_at"],
        }
        state[key] = entry
        save_state(state)

    if text_only:
        out = answer if isinstance(answer, str) else json.dumps(answer, indent=2)
        print(out)
        sys.exit(0 if ok else 1)

    result = {
        "ok": ok,
        "error": err,
        "target": str(target),
        "engine": engine,
        "mode": mode,
        "model": res.get("model"),
        "effort": res.get("effort"),
        "session_id": session_id,
        "resumed": resumed,
        "answer": answer,
        "cost_usd": res.get("cost_usd"),
        "duration_ms": res.get("duration_ms"),
        "num_turns": res.get("num_turns"),
        "tokens": res.get("tokens", {}),
        "git": {
            "repo": before.get("repo", False),
            "head_before": before.get("head"),
            "head_after": after.get("head"),
            "dirty_before": dirty_before,
            "files_changed": files_changed,
        },
        "permission_denials": res.get("permission_denials", []),
    }
    print(json.dumps(result, indent=2))
    sys.exit(0 if ok else 1)


def cmd_targets():
    import datetime
    as_json = "--json" in sys.argv
    state = load_state()

    if not state:
        if as_json:
            _emit({"targets": []})
        else:
            print("no targets recorded for this project")
        return

    if as_json:
        targets = []
        for k, v in state.items():
            entry = {
                "target": k,
                "last_session_id": v.get("last_session_id"),
                "engine": v.get("engine", "claude"),
                "model": v.get("last_model"),
                "effort": v.get("last_effort"),
                "interactions": v.get("interactions", 0),
            }
            last_used = v.get("last_used_at")
            if last_used:
                entry["last_used_at"] = last_used
                entry["last_used_iso"] = datetime.datetime.fromtimestamp(
                    last_used, tz=datetime.timezone.utc
                ).isoformat()
            targets.append(entry)
        _emit({"targets": targets})
    else:
        for k, v in state.items():
            print(f"{k}")
            parts = [
                f"last_session: {v.get('last_session_id')}",
                f"engine: {v.get('engine', 'claude')}",
            ]
            last_used = v.get("last_used_at")
            if last_used:
                dt = datetime.datetime.fromtimestamp(last_used, tz=datetime.timezone.utc)
                parts.append(f"last_used: {dt.strftime('%Y-%m-%d %H:%M UTC')}")
            print(f"  {parts[0]}  {parts[1]}")
            print(f"  model: {v.get('last_model')}  effort: {v.get('last_effort')}"
                  f"  interactions: {v.get('interactions', 0)}", end="")
            if last_used:
                print(f"  {parts[2]}")
            else:
                print()


def cmd_doctor():
    """Readiness: report which engine CLIs are on PATH. ok requires the default
    engine to be present (either engine covers its own --engine calls)."""
    engines = {name: shutil.which(name) for name in ENGINES}
    default = _default_engine()
    ok = bool(engines.get(default))
    _emit({"ok": ok, "engines": engines, "default_engine": default,
           "error": None if ok else f"default engine {default!r} not found on PATH"})
    sys.exit(0 if ok else 2)


def main():
    argv = sys.argv[1:]
    _gate()              # disabled in this project → exit 4
    _contract(argv)      # stub/manifest/guide/ids/refs/connections → emit + exit; else return
    if not argv or argv[0] in ("help", "-h", "--help"):
        print(__doc__)
        return
    if argv[0] == "doctor":
        cmd_doctor()
        return
    if argv[0] == "targets":
        cmd_targets()
        return

    p = argparse.ArgumentParser(prog="askproject", add_help=False)
    p.add_argument("target")
    p.add_argument("prompt")
    p.add_argument("--engine", choices=ENGINES)
    p.add_argument("--act", action="store_true")
    p.add_argument("-c", "--continue", dest="cont", action="store_true")
    p.add_argument("--fork", action="store_true")
    p.add_argument("--model")
    p.add_argument("--effort")
    p.add_argument("--schema")
    p.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT)
    p.add_argument("--text", action="store_true")
    p.add_argument("--quiet", action="store_true")
    p.add_argument("--append")
    args = p.parse_args(argv)
    run(args)


if __name__ == "__main__":
    main()
