#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "httpx>=0.27",
#     "callva-harness-runner==0.10.1",
#     "capabilities-contract>=0.12,<1",
# ]
# ///
"""
askproject — ask a coding agent running in ANOTHER project to answer in its own
context, then return its answer plus traceability to the caller.

This tool is designed to be invoked BY an agent (you), from inside your own
project. It spawns a headless peer agent in a target project's directory, so
that peer reads whatever project context is compiled on disk there at that
moment (Claude reads CLAUDE.md, Codex reads AGENTS.md) / settings / rights —
then hands back the answer with cost, token, and files-changed data.

Two engines (harnesses) drive the peer, and the profile a call runs names its
engine: `--engine` picks the shipped profile of that engine, and `--profile`
names a file that names its own. Each is launched through the
callva-harness-runner library (Claude Code through its agent SDK, Codex through
its app-server SDK, always the CLI installed on this machine), which finds and
applies the profile, resumes sessions, keeps the deadline and reads cost,
tokens and the session id back out of what the harness reported:
  claude (default)  Claude Code.
  codex             Codex. No USD cost is reported under ChatGPT auth, so
                    cost_usd stays null.
What the peer may do, and on which model, is its profile — see PROFILES.

Run `askproject help` to (re)load this contract on demand — do not rely on
memorised knowledge of its surface.

────────────────────────────────────────────────────────────────────────────
COMMANDS
  askproject <target> "<question>"        Ask the peer (read-only research).
  askproject <target> --act "<task>"      Let the peer modify its own project.
  askproject <target> -c "<follow-up>"    Continue the last conversation with
                                          that target (resumes its session).
  askproject targets [--json]              List targets you've talked to (this
                                          project) + their last session. Add
                                          --json for machine-readable output.
  askproject profiles                      List every profile in sight (JSON):
                                          name, where it comes from, and the
                                          same-named files it shadows.
  askproject profiles show <name>          Print the file <name> resolves to,
                                          verbatim, to copy and edit.
  askproject help                          Print this document.

<target> is a path to the other project: absolute, ~-expanded, or relative to
your cwd. YOU decide which project to talk to and pass its path. It must be a
directory (a git repo is strongly recommended — see snapshots below), and it
must not be your OWN project root: that call is refused before any peer starts,
because you already stand there with the context loaded and a peer would only
re-read what you can read yourself. A subdirectory of your project, and a git
worktree of your repository at another path, are other projects and are fine.

────────────────────────────────────────────────────────────────────────────
COMPILED PROJECT CONTEXT
  Some targets do not author the file the peer reads — a tool compiles it from
  that project's own sources. The peer then reads the snapshot sitting on disk
  when it starts, which can lag those sources. askproject never builds it, and
  a build wired to the engine's session start refreshes the snapshot for the
  NEXT call rather than this one, so a single-shot peer answers one revision
  behind. `compiled_context` in the result names that artifact and how old it
  is — a fact, not a verdict: a build legitimately leaves an unchanged file
  alone, so older does not mean behind. Run the target's own build yourself
  before asking when the difference matters.

────────────────────────────────────────────────────────────────────────────
MODES
  read  (default;   Research. The engine's read profile, claude-read or
        --read)     codex-read, holds the peer to reading by instruction alone:
                    it has every tool, a full shell and the network, with no
                    tool fence and no OS sandbox, so it can run the target's own
                    commands and capabilities to answer. It loads the target's
                    own context (claude: the project and local settings,
                    CLAUDE.md and rules, not your user settings; codex:
                    AGENTS.md), and it runs with CAPABILITIES_READ_ONLY=1, so
                    every capability call it makes is read-only. Use for "what
                    does X do", reviews.
  act   (--act)     The engine's act profile, claude-act or codex-act, gives
                    the peer full access: every tool without a prompt on claude,
                    no sandbox and no approvals on codex. It can edit, run
                    tests, commit, and push from inside the target project. Use
                    for "fix X", "refactor". Under CAPABILITIES_READ_ONLY --act
                    is refused before any peer starts.

  Under a read profile, read mode is an instruction, not a fence: nothing but
  the prompt and the capabilities' read-only switch stops the peer from
  writing. `--profile claude-read-sandboxed` (or codex-read-sandboxed) is the
  same read enforced by the operating system: the target directory cannot be
  written, while the network, ~/.cache and the temporary directory stay
  writable; on claude it runs no target hooks, so context a hook would build is
  read as it already is on disk. The git snapshot (below) is the check either
  way — a read call that changed the target returns ok=false. A peer started
  while you run under CAPABILITIES_READ_ONLY carries the switch whatever its
  profile.

────────────────────────────────────────────────────────────────────────────
PROFILES
  A profile is a TOML file, <name>.toml, holding one callva-harness-runner
  profile: a top-level `harness = "claude"` or `harness = "codex"`, and that
  harness's knobs beside it (model, effort, timeout_seconds,
  permission_mode, setting_sources, settings, tools, codex_config,
  approval_policy, append_system_prompt, env_set, ...); the library's README
  lists every knob and what it does on each harness. A profile is one engine,
  so the profile a call runs decides the engine:
    --engine E          runs the profile E-read, or E-act with --act.
    --profile <name>    runs that file on the engine its `harness` names. An
                        --engine naming the other engine is refused before any
                        peer starts.
  With neither flag the engine is ASKPROJECT_ENGINE's, else claude (see
  OVERRIDES), and its read or act profile runs. A -c follow-up keeps the
  profile its thread ran under while it keeps its mode, and a --profile given
  with -c must run the thread's own engine.

  callva-harness-runner finds a name in this order, and the first file found is
  used whole — nothing is merged from a same-named file further down, nothing
  inherited; a file that is not one flat profile is an error, not a reason to
  look further:
    1. folder    this project's capabilities/askproject/profiles/<name>.toml
                 (for an agent whose records moved into the store, its harness
                 profile askproject-<name> at its scope instead)
    2. machine   the library's machine folder, shared by everything that runs
                 on callva-harness-runner:
                 $XDG_CONFIG_HOME/callva-harness-runner/profiles/<name>.toml
                 (default ~/.config/callva-harness-runner/profiles/). Put a
                 machine-wide profile there.
    3. shipped   the library's own claude-read, claude-act,
                 claude-read-sandboxed, codex-read, codex-act and
                 codex-read-sandboxed
  So a project or machine file named claude-read or codex-act replaces the
  shipped one. `askproject profiles` lists every profile in sight — name,
  source, path, the harness it runs, and the same-named files it shadows — and
  `askproject profiles show <name>` prints the file a name resolves to, after a
  comment line naming its source and path.

  `askproject profiles show <name>` is where a shipped profile's model,
  effort and timeout are read; they move with the library. To write your own,
  copy one (`askproject profiles show claude-read`) into this project's folder
  or the machine folder under a new name and edit it; a profile the library
  refuses is reported with its own message before any peer starts.

  askproject adds to every profile, per call: its bridge instruction, in front
  of the profile's own append_system_prompt (the engine's system prompt is
  appended to, never replaced), then --append, then on claude the --schema;
  the peer name on claude; the --schema as codex's output schema. The peer
  starts in the target with CLAUDE_PROJECT_DIR naming it, and without the
  caller's envelope handoff or ingress worker keys.

OVERRIDES
  --model, --effort and --timeout override the chosen profile's values for the
  engine that runs, and so do their environment variables. Each resolves in
  this order, the first that is set winning:
    1. the flag              --engine  --model  --effort  --timeout
    2. the project's .env.local  } ASKPROJECT_ENGINE  ASKPROJECT_MODEL
    3. the project's .env        } ASKPROJECT_EFFORT  ASKPROJECT_TIMEOUT
    4. the process environment   }
    5. the profile (the engine: claude)
  A --profile settles the engine ahead of this chain: its file's harness runs,
  whatever ASKPROJECT_ENGINE says. An unknown ASKPROJECT_ENGINE or
  ASKPROJECT_EFFORT, and an ASKPROJECT_TIMEOUT that is not a positive whole
  number of seconds, is ignored; the same values given as flags are refused.

  ASKPROJECT_MODEL and ASKPROJECT_EFFORT belong to the engine that
  ASKPROJECT_ENGINE (or the default engine) selects, and apply only to a run on
  that engine. A run on the other engine — by --engine, by a --profile of that
  engine, or by a -c resume of a thread that engine started — keeps its
  profile's values, so a model or effort written for one engine never reaches
  the other. The --model and --effort flags name this call and apply to
  whichever engine it runs on.

  On claude the `haiku`/`sonnet`/`opus` aliases resolve to known-good full ids;
  on codex a model is passed verbatim. --effort takes low|medium|high|xhigh|max.

────────────────────────────────────────────────────────────────────────────
SESSION CONTINUITY  (state belongs to the project you call from)
  The map of "which target → which session" lives in the table
  askproject_sessions of the calling project's PostgreSQL database: the first
  that answers among the project's .env.local / .env, the process environment
  and the machine's store setting (`capabilities store show` shows which). One
  row per calling project, machine and target. A project without an id is
  keyed by its root. With no store askproject refuses with exit 6
  store_not_configured before a peer starts, and exits 5 when the store cannot
  be reached.

  This state belongs to YOUR project on this machine, not to the targets.
  `-c/--continue` resumes the last session for that target with its original
  engine. A read thread also keeps its mode, but a thread whose last session
  ran in act mode refuses a bare -c and asks you to name --act or --read for
  that follow-up, so nothing hands the peer write tools with no flag typed; add
  --fork to branch instead of continue.

  Scope a session to ONE unit of work — resume with -c only while on that
  same item; start a fresh call for a new one; use --fork to branch off an
  existing thread without polluting it. Sessions that span unrelated tasks
  just carry dead context and grow costly — short, task-scoped is optimal.
  Use `askproject targets` to see which sessions exist and when they were
  last used.

  On claude the session id is chosen before the peer starts and handed to it,
  rather than read back out of what it printed. It is therefore known for the
  whole run, including a run that times out or dies mid-turn with work already
  done in the target: `-c` still reaches that session. Both the id and the peer
  name are announced on stderr as the run begins, because stdout carries the
  result only once the process exits. codex reports its own thread id when it
  is done, and takes no name.

────────────────────────────────────────────────────────────────────────────
OUTPUT  (stdout = one JSON object; use --text to get just the answer)
  {
    "ok": bool, "error": str|null,
    "target": "<abs path>", "engine": "claude|codex", "mode": "read|act",
    "profile": {"name", "source": "folder|machine|shipped", "path"},
    "model": "<model id>", "effort": "<level>",
    "session_id": "<uuid>", "peer_name": "<name>|null", "resumed": bool,
    "answer": <string OR parsed object when --schema is used>,
    "cost_usd": float|null, "duration_ms": int, "num_turns": int|null,
    "tokens": {input, output, cache_read, cache_creation},
    "git": {"repo": bool, "head_before","head_after","dirty_before",
            "files_changed":[{"path","status"}]},
    "compiled_context": {"path","modified_at","age_seconds"} | null,
    "permission_denials": [ ... attempts the peer made and was blocked on ... ]
  }
  `compiled_context` describes the engine's compiled project-context file in
  the target as it stood when the peer started — see above. It is null, with
  no warning, for the ordinary target that compiles no such file.
  In read mode files_changed must be empty; if it isn't, ok=false and it is
  flagged loudly (a read query should never mutate).

  While the peer runs, concise stage updates are streamed to stderr. They are
  derived from the engines' native event streams and intentionally omit full
  commands, command output, reasoning, and the final answer. This keeps stdout
  machine-parseable while letting an invoking agent see that work is moving.
  Pass --quiet to suppress these updates for callers that require silent stderr.

FLAGS
  --engine <claude|codex>  Which peer engine to spawn (default: claude, or
                        $ASKPROJECT_ENGINE): its read profile, or its act
                        profile with --act. A -c resume adopts the session's
                        own engine — a codex thread can't be resumed by claude.
                        Refused beside a --profile that runs the other engine.
  --act                 Modification mode: the engine's act profile unless
                        --profile names another.
  --read                Read mode: the engine's read profile unless --profile
                        names another. It is already the default for a fresh
                        call; on a -c resume of an act thread it is how you
                        deliberately put the follow-up back in read mode.
                        Contradicts --act.
  -c, --continue        Resume the last session for this target, retaining its
                        engine. A read thread continues in read mode. An act
                        thread refuses until you say which mode this follow-up
                        runs in: --act to keep writing, --read to read.
  --fork                Reserved; neither headless CLI has a non-interactive
                        fork, so this exits with a controlled error.
  --profile <name>      The profile to run, on the engine its file names
                        (default: <engine>-read, or <engine>-act with --act).
                        See PROFILES.
  --model <m>           The model for this call's engine (default: the
                        profile's, or $ASKPROJECT_MODEL on the engine it
                        belongs to).
  --effort <level>      Reasoning effort for this call's engine:
                        low|medium|high|xhigh|max (default: the profile's, or
                        $ASKPROJECT_EFFORT on the engine it belongs to).
  --schema <file|json>  Pass a JSON Schema to constrain the peer's answer;
                        `answer` is then the parsed object.
  --timeout <seconds>   Kill the peer after N seconds (default: the
                        profile's, 3600 in the shipped ones, or
                        $ASKPROJECT_TIMEOUT). The peer's whole process tree
                        is stopped; resume it with -c.
  --text                Print only the answer to stdout (still exits non-zero
                        on error).
  --quiet               Suppress the concise progress stream on stderr.
  --append <text>       Extra instruction appended to the peer's system prompt.
  --name <name>         Display name for the claude peer's session, so several
                        live peers are told apart in a listing. Default: the
                        target's basename plus the session's own prefix, which
                        is what keeps two peers in one target from sharing a
                        name. A claude-engine control; codex refuses it.

EXAMPLES
  askproject ../shop "Which file defines the pricing taxonomy?"
  askproject ~/dev/api --act "Add a --json flag to the export command"
  askproject ../shop -c "And where is it consumed?"
  askproject ../shop --engine codex "Trace the checkout flow end to end"

────────────────────────────────────────────────────────────────────────────
CONTRACT  (self-description an agent loads on demand; this capability has NO
           connections — it drives the local `claude`/`codex` CLI, no creds)
  askproject doctor        Readiness — reports which engine CLIs are on PATH
                           and whether the session store can be used.
  askproject stub          One-line awareness text.
  askproject manifest      Machine-readable declaration (JSON).
  askproject guide [topic] How-to guides — none ship; the menu is empty.
  askproject ids …         Project identifier store (list/get/set/rm).
  askproject refs          Project references menu.
  askproject inventory [--network]
                           What this capability holds in this project
                           (--network adds remote detail).
  askproject migrate [status]
                           Apply the session map's pending steps to the
                           machine's store; `status` reports where its
                           tables stand, without a lock, changing nothing.
  askproject connections   Connections report — empty; this capability has none.
"""

import argparse
import json
import os
import shutil
import socket
import subprocess
import sys
import time
import uuid
from pathlib import Path
from typing import NoReturn

# --- Capability declaration — one home for every contract fact ---------------

NAME = "askproject"
SUMMARY = ("Bridge to a coding agent in ANOTHER project — spawn a headless peer "
           "(claude or codex) in a target project under a read or act profile, and "
           "return its answer with cost, token, and files-changed traceability.")
SCOPE = "user"      # credential scope: "project" | "user"
CRED_KEYS: list = []   # no credentials — it drives the local `claude` CLI on PATH
DOCS_BASE = ""
STATE = False       # the session map lives in the machine's store (askproject_sessions)
TABLES = True       # askproject_sessions in the machine's store, built by _tables()
INVENTORY = None     # or {"network": "none"|"optional"|"required"} with an _inventory(network) builder
POST_INSTALL: list = []

_CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
CREDENTIALS_ENV = _CONFIG_HOME / "askproject" / "credentials.env"
_STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state"))

ENGINES = ("claude", "codex")
DEFAULT_ENGINE = "claude"

# A profile is a TOML file holding one callva-harness-runner profile, and so
# one harness. Without --profile a call runs its engine's profile for its mode,
# "<engine>-read" or "<engine>-act"; the library ships all four.
def default_profile(engine: str, mode: str) -> str:
    return f"{engine}-{mode}"


# claude only: short names resolved to full ids. codex takes --model verbatim.
MODEL_ALIASES = {
    "haiku": "claude-haiku-4-5-20251001",
    "sonnet": "claude-sonnet-5",
    "opus": "claude-opus-5-5",
}

EFFORT_LEVELS = ("low", "medium", "high", "xhigh", "max")

# The shared capability code is the capabilities-contract library's, bound here
# into this script's namespace (SHEBANG.md, "The contract verbs").
from capabilities_contract.capability import bind as _contract_bind

_contract_bind(globals(), "core")

_contract_bind(globals(), "store")


def _cmd_connections() -> None:
    """Core-only capability: askproject drives the local `claude` CLI and has no
    configured connection, so the connections report is empty by contract."""
    _emit({"connections": {}, "default": None})


def die(msg: str, *, as_json: bool, code: int = 1):
    if as_json:
        print(json.dumps({"ok": False, "error": msg}, indent=2))
    else:
        print(f"askproject: {msg}", file=sys.stderr)
    sys.exit(code)


def _real(path: Path) -> Path | None:
    """The fully resolved real path, or None when the filesystem cannot say.

    Identity is decided here and nowhere else, so `~/dev/p`, `../p`, a trailing
    slash, an uncollapsed `..` and a symlinked path all reduce to one answer.
    Only used to compare; the caller keeps its own unresolved path.
    """
    try:
        return Path(os.path.realpath(str(path)))
    except OSError:
        return None


def _root_is_where_caller_stands(root: Path) -> bool:
    """Whether `root` is the project the caller actually stands in.

    Root detection reads `.git` as a directory marker, so it walks straight
    through a linked git worktree — whose `.git` is a file — and settles on an
    enclosing checkout that is a different project. Identity cannot be decided
    from that answer, so say no and let the call through: a peer that should
    have been refused is the old behaviour, refusing a legitimate one is not.
    """
    try:
        here = Path.cwd().resolve()
    except OSError:
        return False
    for d in (here, *here.parents):
        if d == root:
            return True
        if (d / ".git").is_file():
            return False
    return False


def _refuse_self_target(target: Path, root: Path | None, *, as_json: bool) -> None:
    """Refuse a target that is the caller's own project root.

    The peer would load the context the caller already holds and re-read files
    the caller can read itself, at the price of a fresh prompt cache — always
    waste, and silent, because the answer comes back correct. Only the root
    itself is refused: a subdirectory of this project, and a git worktree of
    this repository living at another path, are different targets.
    """
    if root is None:
        return
    real_root = _real(root)
    real_target = _real(target)
    if real_root is None or real_target is None or real_target != real_root:
        return
    if not _root_is_where_caller_stands(root):
        return
    die(f"target is this project itself ({root}) — askproject reaches a peer in "
        "ANOTHER project; you already stand here with this context loaded, so "
        "read the files directly (Read/Glob/Grep) instead of paying for a peer",
        as_json=as_json)


class PeerTimeout(Exception):
    """A timed-out peer plus the native session id observed before it stopped."""

    def __init__(self, seconds: int, session_id: str | None = None):
        super().__init__(f"peer timed out after {seconds}s")
        self.seconds = seconds
        self.session_id = session_id


# The session map: one row per caller, machine and target in the machine's
# store, so the next question to a target continues the same peer session. The
# host is part of the key because a peer session lives in that machine's claude
# or codex store, where the same target path means nothing on another machine.
SESSIONS_MAJOR, SESSIONS_MINOR = 1, 0
SESSIONS_STEPS = [
    ("0001-sessions", """
    CREATE TABLE askproject_sessions (
        project_id      text NOT NULL,
        host            text NOT NULL,
        target_path     text NOT NULL,
        engine          text,
        last_session_id text,
        last_model      text,
        last_effort     text,
        last_mode       text,
        last_profile    text,
        interactions    integer NOT NULL DEFAULT 0,
        last_used_at    timestamptz,
        last_attempt    jsonb,
        CONSTRAINT askproject_sessions_pkey
            PRIMARY KEY (project_id, host, target_path)
    )"""),
]


def _tables():
    """The steps and version of askproject's tables, for the contract's `migrate`."""
    return SESSIONS_STEPS, SESSIONS_MAJOR, SESSIONS_MINOR


SESSION_COLUMNS = ("engine", "last_session_id", "last_model", "last_effort",
                   "last_mode", "last_profile", "interactions", "last_used_at",
                   "last_attempt")

# A store setting that cannot be used is a configuration fault; a store that
# cannot be reached or refuses the migration is the environment's.
_STORE_CONFIG_SLUGS = frozenset({
    "store_not_configured", "store_not_postgres", "store_setting_unreadable",
    "bad_store_setting", "sslmode_too_weak", "bad_schema_name"})


class SessionStoreError(Exception):
    def __init__(self, slug: str, message: str, hint: str | None = None):
        super().__init__(message)
        self.slug, self.message, self.hint = slug, message, hint

    def refuse(self) -> NoReturn:
        _die(6 if self.slug in _STORE_CONFIG_SLUGS else 5,
             self.slug, self.message, self.hint)


def _caller_key() -> str:
    """Whose sessions these are: the calling project's id, or, for a caller
    with no id a write may stamp, `path:` and its root (else the working
    directory), so two callers without an id never share a session."""
    root = _project_root()
    project_id = _project_id(write=True, refuse=False) if root is not None else None
    return project_id or f"path:{root or Path.cwd().resolve()}"


def _db():
    try:
        from capabilities_contract import db
    except ImportError as exc:
        raise SessionStoreError(
            "driver_missing", "the shared database library is not installed",
            "reinstall askproject, whose script header pins capabilities-contract") from exc
    return db


def _store_setting():
    """The database the calling project uses, as the shared library resolves it
    for the project root: its .env.local / .env, then the process environment,
    then the machine's store setting."""
    db = _db()
    try:
        return db.resolve_setting(_project_root())
    except db.DbError as exc:
        raise SessionStoreError(exc.slug, exc.message, exc.hint) from exc


class SessionMap:
    """This caller's sessions on this machine, read and written a row at a time.

    Each use opens its own connection and closes it: a peer may run for an hour
    between reading a session and recording the next, longer than a connection
    across a network is worth holding idle."""

    def __init__(self):
        self.project_id = _caller_key()
        self.host = node_name()
        self.setting = None

    def _open(self):
        """A connection to the database this map first resolved, so a read and
        the write an hour later land on the same one."""
        if self.setting is None:
            self.setting = _store_setting()
        return self._connect(self.setting)

    @staticmethod
    def _connect(setting=None):
        """A connection to the calling project's database, its table migrated;
        `setting` when already resolved, else resolved now."""
        db = _db()
        setting = setting if setting is not None else _store_setting()
        conn = None
        try:
            conn = db.connect(application_name=NAME, setting=setting, transaction=True)
            db.migrate(conn, NAME, SESSIONS_STEPS,
                       major=SESSIONS_MAJOR, minor=SESSIONS_MINOR)
        except db.DbError as exc:
            if conn is not None:
                conn.close()
            raise SessionStoreError(exc.slug, exc.message, exc.hint) from exc
        return conn

    @staticmethod
    def _entry(row) -> dict:
        entry = {k: v for k, v in zip(SESSION_COLUMNS, row) if v is not None}
        if "last_used_at" in entry:
            entry["last_used_at"] = entry["last_used_at"].timestamp()
        return entry

    def _select(self, where: str = "", params: tuple = ()) -> list:
        conn = self._open()
        try:
            with conn.cursor() as cur:
                cur.execute(
                    f"SELECT target_path, {', '.join(SESSION_COLUMNS)} "
                    "FROM askproject_sessions WHERE project_id = %s AND host = %s"
                    f"{where} ORDER BY last_used_at NULLS FIRST, target_path",
                    (self.project_id, self.host, *params))
                rows = cur.fetchall()
            conn.commit()
        finally:
            conn.close()
        return [(row[0], self._entry(row[1:])) for row in rows]

    def get(self, target: str) -> dict:
        rows = self._select(" AND target_path = %s", (target,))
        return rows[0][1] if rows else {}

    def all(self) -> list:
        return self._select()

    def put(self, target: str, entry: dict, *, interaction: bool) -> None:
        """Record `entry` for `target`. An interaction is counted by the store
        rather than by this call, so two calls at once each count."""
        import datetime
        used = entry.get("last_used_at")
        values = [entry.get(column) for column in SESSION_COLUMNS[:6]]
        conn = self._open()
        try:
            with conn.cursor() as cur:
                cur.execute(
                    "INSERT INTO askproject_sessions (project_id, host, target_path, "
                    f"{', '.join(SESSION_COLUMNS)}) VALUES "
                    "(%s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s::jsonb) "
                    "ON CONFLICT (project_id, host, target_path) DO UPDATE SET "
                    + ", ".join(f"{c} = EXCLUDED.{c}" for c in SESSION_COLUMNS
                                if c != "interactions")
                    + ", interactions = askproject_sessions.interactions + %s",
                    (self.project_id, self.host, target, *values,
                     int(interaction),
                     None if used is None else datetime.datetime.fromtimestamp(
                         used, tz=datetime.timezone.utc),
                     None if entry.get("last_attempt") is None
                     else json.dumps(entry["last_attempt"]),
                     int(interaction)))
            conn.commit()
        finally:
            conn.close()


def git(target: Path, *args) -> str | None:
    try:
        out = subprocess.run(
            ["git", "-C", str(target), *args],
            capture_output=True, text=True, timeout=30,
        )
        if out.returncode != 0:
            return None
        return out.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return None


def snapshot(target: Path) -> dict:
    head = git(target, "rev-parse", "HEAD")
    if head is None:
        return {"repo": False}
    status = git(target, "status", "--porcelain") or ""
    return {"repo": True, "head": head, "status": status}


def diff_snapshots(before: dict, after: dict) -> tuple[list[dict], bool]:
    """Return (files_changed, dirty_before)."""
    if not before.get("repo"):
        return [], False
    dirty_before = bool(before.get("status"))
    before_lines = set(before.get("status", "").splitlines())
    after_lines = set(after.get("status", "").splitlines())
    changed = []
    for line in sorted(after_lines - before_lines):
        # porcelain: "XY path"
        code, _, path = line.partition(" ")
        changed.append({"path": path.strip() or line, "status": code.strip()})
    if before.get("head") != after.get("head"):
        changed.append({"path": "<HEAD>", "status": "moved"})
    return changed, dirty_before


# A ContextKit-bound project compiles its context into one file per engine and
# declares each destination in its own `.contextkit/config.toml`; these are the
# destinations it writes when the binding declares none.
CONTEXT_OUTPUT_DEFAULTS = {
    "claude": ".claude/rules/CONTEXT.md",
    "codex": ".codex/generated/context.md",
}


def _compiled_context(target: Path, engine: str) -> dict | None:
    """Describe the compiled project-context file the peer is about to read.

    A fact for the caller to weigh, never a verdict: a build legitimately
    leaves a file whose content did not change alone, so an artifact older than
    its sources may still be current. Every failure to find or read one — no
    binding, no declaration, no file, an unparseable config, a declaration that
    does not name a regular file of the target — returns None, so the ordinary
    target that compiles nothing is silent and unaffected.

    The declaration is the target's own file and the result is printed into the
    caller's, so what it may name is bounded here: the artifact must resolve to
    a regular file strictly inside the target. Containment is judged after
    every symlink is followed, because a link out of the target discloses the
    outside path exactly as naming it would.
    """
    import datetime

    binding = target / ".contextkit" / "config.toml"
    if not binding.is_file():
        return None
    try:
        import tomllib

        declared = tomllib.loads(binding.read_text(encoding="utf-8"))
        output = ((declared.get("targets") or {}).get(engine) or {}).get("output")
    except (OSError, ValueError, TypeError, AttributeError):
        output = None
    if not isinstance(output, str) or not output.strip():
        output = CONTEXT_OUTPUT_DEFAULTS.get(engine)
    if not output:
        return None
    try:
        inside = _real(target)
        path = _real(target / output.strip())
        if inside is None or path is None:
            return None
        if path == inside or not path.is_relative_to(inside):
            return None
        if not path.is_file():
            return None
        mtime = path.stat().st_mtime
    except (OSError, ValueError, RuntimeError):
        return None
    modified = datetime.datetime.fromtimestamp(mtime, tz=datetime.timezone.utc)
    return {
        "path": str(path),
        "modified_at": modified.isoformat(),
        "age_seconds": round(max(0.0, time.time() - mtime), 3),
    }


def resolve_schema(spec: str) -> str:
    p = Path(spec).expanduser()
    if p.exists():
        return p.read_text()
    return spec  # assume inline JSON


def resolve_model(model: str) -> str:
    return MODEL_ALIASES.get(model, model)


def _env_value(key: str) -> str | None:
    """$<KEY> from the chain below a flag: the project's .env.local, then its
    .env, then the process environment. None when no layer sets it."""
    value = (_project_env().get(key) or os.environ.get(key) or "").strip()
    return value or None


def _default_engine() -> str:
    """Engine when --engine is not passed. An unknown value falls back."""
    v = (_env_value("ASKPROJECT_ENGINE") or DEFAULT_ENGINE).lower()
    return v if v in ENGINES else DEFAULT_ENGINE


def _env_override(engine: str, key: str) -> str | None:
    """$ASKPROJECT_<KEY> for `engine`, or None to leave the profile's value.

    $ASKPROJECT_MODEL and $ASKPROJECT_EFFORT belong to the engine the same chain
    selects through $ASKPROJECT_ENGINE, so they apply only when the run is on
    that engine. A run that lands on the other engine - by --engine, or by a -c
    resume of that engine's thread - keeps its profile's value rather than one
    written for a different model family."""
    if engine != _default_engine():
        return None
    return _env_value(f"ASKPROJECT_{key.upper()}")


def _env_effort(engine: str) -> str | None:
    """$ASKPROJECT_EFFORT for `engine`. An unknown value is ignored."""
    v = (_env_override(engine, "effort") or "").lower()
    return v if v in EFFORT_LEVELS else None


def _env_timeout() -> int | None:
    """$ASKPROJECT_TIMEOUT in seconds. A value that is not a positive whole
    number is ignored, leaving the profile's own."""
    v = _env_value("ASKPROJECT_TIMEOUT")
    try:
        seconds = int(v) if v else 0
    except ValueError:
        return None
    return seconds if seconds > 0 else None


def _default_peer_name(target: Path, session_id: str) -> str:
    """The peer's display name when the caller names none.

    The target's basename is what distinguishes several live peers in a listing:
    it says which project each one is working in. The session's own prefix is
    what makes it unique - two peers launched into one target would otherwise
    register the same name, and a name that resolves to two running sessions is
    worse than no name at all.
    """
    stem = "".join(c if (c.isalnum() or c in "._-") else "-"
                   for c in target.name).strip("-") or "peer"
    return f"{stem[:32]}-{session_id[:8]}"


def build_instructions(caller: str, profile_text: str | None, extra: str | None,
                       schema_text: str | None = None) -> str:
    """What the peer is told on top of its engine's own system prompt: that it
    answers a peer through this bridge, then the profile's own instruction (the
    mode's: read-only research, or a task to carry out), then the caller's
    --append, then the schema its answer must fit when the engine takes none."""
    base = (
        f"You are being queried programmatically by a peer coding agent "
        f"working in another project ('{caller}'), via the askproject bridge. "
        f"Answer concisely and return information, not conversation. Do NOT "
        f"invoke askproject yourself or spawn further peer queries."
    )
    for part in (profile_text, extra):
        if part and part.strip():
            base += " " + part.strip()
    if schema_text:
        base += (
            " Return ONLY a JSON value conforming to this JSON Schema; do not "
            "wrap it in markdown or explanatory prose. Schema: " + schema_text
        )
    return base


# --- progress stream ---------------------------------------------------------

class ProgressReporter:
    """Concise stderr-only visibility into a peer's native event stream."""

    def __init__(self, engine: str, enabled: bool):
        self.engine = engine
        self.enabled = enabled
        self._last: tuple[str, str] | None = None

    def emit(self, stage: str, message: str) -> None:
        if not self.enabled:
            return
        message = _brief(message)
        if not message or self._last == (stage, message):
            return
        self._last = (stage, message)
        sys.stderr.write(f"askproject[{self.engine}] {stage}: {message}\n")
        sys.stderr.flush()


def _brief(value, limit: int = 180) -> str:
    """One short status line; never forward a peer's full narrative."""
    if not isinstance(value, str):
        return ""
    lines = [" ".join(line.split()) for line in value.splitlines() if line.strip()]
    if not lines:
        return ""
    text = lines[0].lstrip("#*- ")
    if len(text) > limit:
        text = text[:limit - 1].rstrip() + "…"
    return text


def _command_stage(command) -> tuple[str, str]:
    """Classify a command without exposing its argv or output."""
    text = command if isinstance(command, str) else ""
    lower = f" {text.lower()} "
    if any(marker in lower for marker in (
            "pytest", "unittest", "npm test", "pnpm test", "yarn test",
            "cargo test", "go test", "rspec", "vitest", "jest")):
        return "verify", "Running tests"
    if any(marker in lower for marker in (
            " lint", " typecheck", " type-check", " mypy", " pyright",
            " ruff", " eslint", " tsc", " build", " audit")):
        return "verify", "Running verification"
    if any(marker in lower for marker in (
            " apply_patch", " sed -i", " perl -pi", " tee ")):
        return "edit", "Updating project files"
    if any(marker in lower for marker in (
            " rg ", " grep ", " find ", " ls ", " sed -n", " git status",
            " git diff", " git log", " cat ", " head ", " tail ")):
        return "inspect", "Inspecting the project"
    return "work", "Running a project command"


def _tool_stage(name, tool_input=None) -> tuple[str, str]:
    """Map a Claude tool event to a small, host-neutral status vocabulary."""
    name = name if isinstance(name, str) else ""
    if name in ("Read", "Glob", "Grep", "LS", "NotebookRead"):
        return "inspect", "Inspecting the project"
    if name == "Bash":
        command = tool_input.get("command", "") if isinstance(tool_input, dict) else ""
        return _command_stage(command)
    if name in ("Edit", "MultiEdit", "Write", "NotebookEdit"):
        return "edit", "Updating project files"
    if name in ("WebFetch", "WebSearch"):
        return "research", "Checking external documentation"
    if name in ("TodoWrite", "ExitPlanMode"):
        return "plan", "Updating the work plan"
    return "work", "Using a project tool"


def _runner(as_json: bool):
    """The harness library, imported at the moment a profile or a peer is needed.

    Every other verb here works without it, and a reading verb should not wait
    on a dependency it never reaches."""
    try:
        from callva import harness_runner
    except ImportError as exc:  # pragma: no cover - a broken install, not a path
        die(f"the harness library is not importable: {exc}; reinstall askproject - "
            "its script header declares callva-harness-runner and uv resolves it",
            as_json=as_json)
    return harness_runner


def _inside_id_root(target, root) -> bool:
    """Whether `target` lies in the handed-down id's root, after symlinks."""
    if not root:
        return False
    real_root = _real(Path(root))
    real_target = _real(Path(target))
    if real_root is None or real_target is None:
        return False
    return real_target == real_root or real_root in real_target.parents


def _peer_env(target) -> dict:
    """The caller's environment, made to belong to the target project.

    A peer is started in another project's directory, and cwd is the weakest
    thing that says so: a capability CLI reads $CLAUDE_PROJECT_DIR first and
    falls back to cwd only in its absence, and it honours a handed-off envelope
    whenever the handoff names the root it stands in. The project id handed down
    with its root names that root even from a folder bound to nothing, so a
    target never initialised would resolve as the caller. Inherited unchanged,
    these make the peer answer as the CALLER's project while standing in the
    target — its capability calls resolve the caller's envelope and the caller's
    credentials. So the target is named and both handoffs are dropped rather
    than re-pointed: the envelope answer and the id belong to whoever resolved
    them, and a descendant in another project resolves its own. The id is kept
    for a target inside its root, a subfolder of the caller's project: that
    target is the caller's project, and a node whose id lives only in its
    environment would otherwise lose it there.

    A per-turn authority granted to the caller by whatever ingress launched it
    is the caller's alone. The Telegram service's worker keys are that authority
    here — the launch nonce, the authorized chat, the progress outbox — and a
    peer holding them writes into the caller's own chat through the worker shim
    the same service left on the inherited PATH. TELEGRAM_REAL_TELEGRAM is kept
    because it names the real executable rather than any authority; without it
    that shim finds itself on PATH again and re-execs forever.

    The markers a calling Claude session leaves in its children's environment
    are removed by callva-harness-runner unless the profile says otherwise, so a
    peer does not believe it runs inside its caller's session.

    Everything else is inherited deliberately: PATH, HOME, the language runtime
    and the engine's own credentials are what let the peer run at all, and no
    list written here could name them.

    The read-only switch is carried to the peer by name, so its own capability
    calls change nothing either, whatever spelling the caller used for it.
    """
    env = dict(os.environ)
    env["CLAUDE_PROJECT_DIR"] = str(target)
    if read_only_switch():
        env[READ_ONLY_ENV] = "1"
    env.pop("CAPABILITIES_PROJECT_ENVELOPE", None)
    env.pop("CAPABILITIES_PROJECT_ENVELOPE_ROOT", None)
    if not _inside_id_root(target, env.get("CAPABILITIES_PROJECT_ID_ROOT")):
        env.pop("CAPABILITIES_PROJECT_ID", None)
        env.pop("CAPABILITIES_PROJECT_ID_ROOT", None)
    for key in [k for k in env
                if k.startswith("TELEGRAM_") and k != "TELEGRAM_REAL_TELEGRAM"]:
        env.pop(key, None)
    return env


class CodexProgress:
    """Render codex app-server notifications while withholding the answer.

    Each event is `{"method", "params"}` as callva-harness-runner hands it over."""

    def __init__(self, reporter: ProgressReporter):
        self.reporter = reporter
        self.pending_message = ""

    def feed(self, evt: dict) -> None:
        kind = evt.get("method")
        params = evt.get("params") if isinstance(evt.get("params"), dict) else {}
        item = params.get("item") if isinstance(params.get("item"), dict) else {}
        item_type = item.get("type")

        if kind == "item/completed" and item_type == "agentMessage":
            # Commentary and the final answer arrive the same way; the phase
            # says which, and the answer is never echoed. A message without a
            # phase is held: a following item makes it commentary, and the
            # turn's completion makes it the answer.
            phase = item.get("phase")
            if phase == "commentary":
                self.reporter.emit("update", _brief(item.get("text")))
            elif phase != "final_answer":
                self.pending_message = _brief(item.get("text"))
            return

        if kind == "turn/completed":
            self.pending_message = ""
        elif self.pending_message and kind in ("item/started", "item/completed"):
            self.reporter.emit("update", self.pending_message)
            self.pending_message = ""

        if kind == "turn/started":
            self.reporter.emit("started", "Codex peer started")
        elif kind == "item/started":
            if item_type == "commandExecution":
                self.reporter.emit(*_command_stage(item.get("command")))
            elif item_type == "fileChange":
                self.reporter.emit("edit", "Updating project files")
            elif item_type in ("mcpToolCall", "dynamicToolCall"):
                self.reporter.emit("work", "Using a project tool")
            elif item_type == "webSearch":
                self.reporter.emit("research", "Checking external documentation")
        elif kind == "item/completed" and item_type == "commandExecution":
            if item.get("exitCode") not in (None, 0):
                self.reporter.emit("update", "A command failed; the peer is handling it")
        elif kind == "item/completed" and item_type == "fileChange":
            self.reporter.emit("edit", "Updated project files")
        elif kind == "turn/completed":
            turn = params.get("turn") if isinstance(params.get("turn"), dict) else {}
            if turn.get("status") == "completed":
                self.reporter.emit("completed", "Codex peer finished")
            else:
                self.reporter.emit("failed", "Codex peer reported a failure")
        elif kind == "error":
            self.reporter.emit("failed", "Codex peer reported a failure")


def _claude_progress(evt: dict, reporter: ProgressReporter) -> None:
    """Render one claude-agent-sdk message as callva-harness-runner hands it over:
    the engine's own system event, or a message's fields plus its class name."""
    kind = evt.get("type")
    if kind == "system" and evt.get("subtype") == "init":
        reporter.emit("started", "Claude peer started")
        return
    if kind == "AssistantMessage":
        content = evt.get("content") if isinstance(evt.get("content"), list) else []
        tools = [block for block in content
                 if isinstance(block, dict) and "name" in block and "input" in block]
        if tools:
            # Text accompanying a tool call is commentary, not the final answer.
            for block in content:
                if isinstance(block, dict) and isinstance(block.get("text"), str):
                    reporter.emit("update", block["text"])
                    break
            for block in tools:
                reporter.emit(*_tool_stage(block.get("name"), block.get("input")))
        return
    if kind == "ResultMessage":
        if evt.get("is_error"):
            reporter.emit("failed", "Claude peer reported a failure")
        else:
            reporter.emit("completed", "Claude peer finished")


# --- profiles ----------------------------------------------------------------
# A profile is a TOML file holding one callva-harness-runner profile: a
# top-level `harness` and that harness's knobs. callva-harness-runner finds it
# by name: askproject's own folder in the project envelope first, then the
# library's machine folder, then the profiles the library ships. The first file
# found is used whole, and its harness is the engine the call runs.

def _profile_folders() -> list[Path]:
    """askproject's own profile folders, searched before the library's machine
    folder and shipped set: the project envelope's askproject/profiles. An
    agent whose records moved into the store keeps its profiles there instead,
    and has no folder."""
    env_dir = _env_dir()
    if env_dir is None or _records_in_store():
        return []
    return [env_dir / "profiles"]


# An agent whose records moved into the store keeps askproject's profiles as
# harness profiles named `askproject-<name>` at its project's scope, beside the
# ones automations, tasks and telegram keep there; askproject lists and
# resolves only its own, under the name its folder gave them, as it saw only
# its folder before.
STORE_PROFILE_PREFIX = "askproject-"


def _store_profiles(runner) -> list:
    """This agent's own profiles as the store holds them, for an agent whose
    records moved there: the active `askproject-<name>` harness profiles at
    its project's scope, where `capabilities migrate` moved its profiles
    folder, each by the name it is asked for."""
    if not _records_in_store():
        return []
    from capabilities_contract import db
    project = _project_id()
    try:
        setting = db.resolve_setting(_project_root())
        conn = db.connect(application_name=NAME, setting=setting, transaction=True)
    except db.DbError as exc:
        _die(5 if exc.slug in STORE_ENVIRONMENT_SLUGS else 6, exc.slug, exc.message,
             exc.hint)
    try:
        try:
            active = runner.stored_profiles(conn, project=project, schema=setting.schema)
        except Exception as exc:
            if type(exc).__name__ != "UndefinedTable":
                raise
            active = []
    finally:
        conn.close()
    return [(one.name[len(STORE_PROFILE_PREFIX):], one)
            for one in active if one.scope == "project" and one.scope_id == project
            and one.name.startswith(STORE_PROFILE_PREFIX)
            and len(one.name) > len(STORE_PROFILE_PREFIX)]


def _stored_file(runner, name: str, version, shadows: tuple = ()):
    """A stored profile version as the file a lookup answers, by the name it
    was asked for."""
    return runner.ProfileFile(name, "store", version.where, version.text(), shadows)


def _find_profile_file(runner, name: str):
    """The profile `name` resolves to: this agent's stored version where its
    records moved into the store, else the library's search of the project
    folder, the machine folder and the shipped set. Raises the library's
    ProfileNotFound or ProfileError."""
    stored = dict(_store_profiles(runner))
    if name in stored:
        runner.check_profile_name(name)
        try:
            below = runner.find_profile_file(name, [])
            shadows = (below.path, *below.shadows)
        except runner.ProfileError:
            shadows = ()
        return _stored_file(runner, name, stored[name], shadows)
    return runner.find_profile_file(name, _profile_folders())


def _list_profiles(runner) -> list[dict]:
    """Every profile in sight, as the library lists it, with this agent's
    stored profiles first where its records moved into the store."""
    listed = [entry.to_dict() for entry in runner.list_profiles(_profile_folders())]
    stored = _store_profiles(runner)
    if not stored:
        return listed
    out = []
    held = {entry["name"]: entry for entry in listed}
    for name, version in sorted(stored, key=lambda pair: pair[0]):
        below = held.pop(name, None)
        out.append({"name": name, "source": "store", "path": version.where,
                    "harness": version.harness,
                    "shadows": ([below["path"], *below.get("shadows", [])] if below else [])})
    return sorted(out + list(held.values()), key=lambda e: e["name"])


def _profile_lookup(runner) -> list[dict]:
    """Where a name is looked for, in order, as the library searches."""
    first = ([{"source": "store",
                "dir": "this agent's askproject-<name> harness profiles in the store"}]
             if _records_in_store() else
             [{"source": "folder", "dir": str(folder)} for folder in _profile_folders()])
    return (first
            + [{"source": "machine", "dir": str(runner.machine_folder())},
               {"source": "shipped", "dir": "the profiles shipped in callva-harness-runner"}])


def cmd_profiles(argv: list[str]) -> None:
    """`profiles` lists every profile in sight, as the library lists it;
    `profiles show NAME` prints the file NAME resolves to after a comment line
    naming its source and path, for an operator to copy and edit."""
    runner = _runner(as_json=True)
    if argv and argv[0] == "show":
        if len(argv) != 2:
            _die(6, "input", "usage: askproject profiles show <name>")
        try:
            found = _find_profile_file(runner, argv[1])
        except runner.ProfileNotFound as exc:
            _die(3, "not_found", str(exc), "`askproject profiles` lists the ones that exist")
        except runner.ProfileError as exc:
            _die(6, "input", str(exc))
        text = found.text if found.text.endswith("\n") else found.text + "\n"
        sys.stdout.write(f"# {found.source}: {found.path}\n{text}")
        return
    if argv:
        _die(6, "input", "usage: askproject profiles [show <name>]")
    _emit({
        "profiles": _list_profiles(runner),
        "lookup": _profile_lookup(runner),
    })


def _migrate_files_mover(action: str, mine: dict, answers: dict) -> dict:
    """`capabilities migrate`'s move of this project's profile folder into the
    store, as harness profiles at the project's scope, all of them or none,
    leaving the files for the manager to archive and remove once the whole move
    is verified. A file the store already holds differently refuses the move,
    naming it; `verify` finds each held exactly as the file says."""
    folders = [folder for folder in _profile_folders() if folder.is_dir()]
    files = sorted(p for folder in folders for p in folder.glob("*.toml") if p.is_file())
    report: dict = {"items": [], "files": [str(p) for p in files]}
    if not files:
        if action == "verify":
            report["verified"] = True
        return report
    runner = _runner(as_json=True)
    from capabilities_contract import db
    root = _project_root()
    project = _project_id(write=action == "write")
    if not project:
        _die(6, "no_project_identity", "this project declares no id",
             "run `capabilities init` in the project")
    try:
        setting = db.resolve_setting(root)
        conn = db.connect(application_name=NAME, setting=setting, transaction=True)
    except db.DbError as exc:
        _die(5 if exc.slug in STORE_ENVIRONMENT_SLUGS else 6, exc.slug, exc.message,
             exc.hint)
    rows, refused = [], []
    try:
        try:
            active = runner.stored_profiles(conn, project=project, schema=setting.schema)
        except Exception as exc:
            if type(exc).__name__ != "UndefinedTable":
                raise
            conn.rollback()
            active = []
        held = {one.name: one for one in active
                if one.scope == "project" and one.scope_id == project}
        stored_as = {}
        for path in files:
            name = path.stem
            row = {"kind": "profile", "name": name, "file": str(path)}
            stored_as[name] = STORE_PROFILE_PREFIX + name
            try:
                runner.check_profile_name(name)
                runner.check_profile_name(stored_as[name])
                knobs = runner.ProfileFile(name, "folder", str(path), path.read_text()).knobs()
                spec = runner.check_spec(knobs, f"profile {name!r} at {path}")
            except (OSError, UnicodeDecodeError, runner.ProfileError, ValueError,
                    TypeError, KeyError) as exc:
                refused.append(f"{path}: {exc}")
                continue
            version = held.get(stored_as[name])
            if version is None:
                row["outcome"] = {"plan": "would_write", "write": "write",
                                  "verify": "missing"}[action]
            elif version.spec == spec:
                row.update(outcome="held", version=version.id)
            else:
                row.update(outcome="differs", version=version.id)
                refused.append(f"{path} differs from version {version.id} the store "
                               f"holds for {name!r}")
            rows.append({**row, "spec": spec})
        if refused and action != "verify":
            conn.rollback()
            _die(6, "profiles_not_movable",
                 f"{len(refused)} profile file(s) cannot be moved, so none is: "
                 + "; ".join(refused),
                 "repair or remove them, then run `capabilities migrate` again")
        if action == "write":
            conn.rollback()
            db.migrate(conn, runner.PROFILE_STORE_OWNER, runner.PROFILE_STORE_STEPS,
                       major=runner.PROFILE_STORE_MAJOR, minor=runner.PROFILE_STORE_MINOR)
            with conn.transaction():
                for row in rows:
                    if row["outcome"] != "write":
                        continue
                    version, _created = runner.save_profile(
                        conn, stored_as[row["name"]], row["spec"], scope="project",
                        scope_id=project,
                        created_by=f"migrate@{answers.get('_master') or node_name()}",
                        schema=setting.schema)
                    row.update(outcome="written", version=version.id)
        else:
            conn.rollback()
    except db.DbError as exc:
        _die(5 if exc.slug in STORE_ENVIRONMENT_SLUGS else 6, exc.slug, exc.message,
             exc.hint)
    finally:
        conn.close()
    report["items"] = [{k: v for k, v in row.items() if k != "spec"} for row in rows]
    if action == "verify":
        report["differences"] = refused + [f"profile {row['name']}: missing ({row['file']})"
                                           for row in rows if row["outcome"] == "missing"]
        report["verified"] = not report["differences"]
    return report


# --- the peer ---------------------------------------------------------------
# callva-harness-runner runs the harness: it turns the profile into the harness's
# own configuration, resumes sessions, keeps the deadline and reads what the
# engine reported. askproject owns which profile runs, what the peer is asked
# and told, where it stands, and what is reported. The launcher turns one call
# into ONE normalized dict so run() stays engine-blind:
#   {answer, session_id, model, effort, cost_usd, duration_ms, num_turns,
#    tokens:{input,output,cache_read,cache_creation}, is_error, permission_denials}

def run_peer(engine, target, prompt, profile, resume_id, schema_text, as_json,
             reporter: ProgressReporter, session_id=None) -> dict:
    """One headless turn of the peer through callva-harness-runner.

    claude runs under the session id chosen before launch; codex reports its
    own thread id. The schema reaches codex as its native output schema and
    claude as an instruction, as the profile built in run() says."""
    runner = _runner(as_json)
    if engine == "claude":
        session = (runner.Session.resume(resume_id) if resume_id
                   else runner.Session.pinned(session_id))
    else:
        session = runner.Session.resume(resume_id) if resume_id else runner.Session.fresh()
    on_event = None
    if reporter.enabled:
        if engine == "claude":
            def on_event(evt: dict) -> None:
                _claude_progress(evt, reporter)
        else:
            on_event = CodexProgress(reporter).feed

    result = runner.run(prompt, profile, str(target), session=session,
                    environ=_peer_env(target), on_event=on_event)

    failure = result.failure
    if failure is not None and failure.kind == runner.FailureKind.TIMEOUT:
        reporter.emit("failed", f"Peer timed out after {profile.timeout_seconds:g}s")
        # claude's id was settled before launch and codex's is known once its
        # thread started, so a peer stopped mid-turn stays resumable whenever
        # an id exists at all.
        raise PeerTimeout(int(profile.timeout_seconds), result.session_id)
    if failure is not None and failure.kind == runner.FailureKind.BINARY_MISSING:
        die(f"`{engine}` CLI not found on PATH", as_json=as_json)
    # A schema answer that did not parse is still the peer's answer; it is
    # returned as text, as it always was, rather than failed.
    if failure is not None and failure.kind != runner.FailureKind.INVALID_OUTPUT:
        reporter.emit("failed", f"{engine.capitalize()} peer failed: {failure.kind}")
        exited = "" if result.exit_code is None else f", exit {result.exit_code}"
        die(f"peer failed ({failure.kind}{exited}): {failure.message[-800:]}",
            as_json=as_json)

    answer = result.answer
    if schema_text:
        if result.structured is not None:
            answer = result.structured
        else:
            try:
                answer = json.loads(answer)
            except (TypeError, ValueError):
                pass
    tokens = result.tokens
    return {
        "answer": answer,
        "session_id": result.session_id,
        "model": result.model or profile.model,
        "effort": profile.effort,
        "cost_usd": result.cost_usd,
        "duration_ms": result.duration_ms,
        "num_turns": result.num_turns,
        "tokens": {
            "input": tokens.input,
            "output": tokens.output,
            "cache_read": tokens.cache_read,
            "cache_creation": tokens.cache_creation,
        },
        "is_error": False,
        "permission_denials": list(result.permission_denials),
    }


def _find_profile(name: str, as_json: bool):
    """The file `name` resolves to and the harness it names, or the library's
    refusal before any peer starts."""
    runner = _runner(as_json)
    try:
        found = _find_profile_file(runner, name)
        return found, found.harness
    except runner.ProfileError as exc:
        die(f"profile {name!r} is refused by callva-harness-runner: {exc}",
            as_json=as_json)


def _build_profile(found, engine: str, *, caller: str, model, effort,
                   timeout, append, schema_text, peer_name, as_json: bool):
    """The profile this call runs, and where it came from: the file `found`,
    whole, with the call's overrides and askproject's own per-call settings on
    top."""
    import dataclasses
    runner = _runner(as_json)
    name = found.name
    try:
        profile = found.profile()
    except runner.ProfileError as exc:
        die(f"profile {name!r} is refused by callva-harness-runner: {exc}",
            as_json=as_json)
    record = {"name": found.name, "source": found.source, "path": found.path}
    changes = {"append_system_prompt": build_instructions(
        caller, profile.append_system_prompt, append,
        schema_text if engine == "claude" else None)}
    if model:
        changes["model"] = model
    if effort:
        changes["effort"] = effort
    if timeout:
        changes["timeout_seconds"] = timeout
    if engine == "claude":
        changes["name"] = peer_name
    elif schema_text:
        changes["output_schema"] = json.loads(schema_text)
    try:
        return dataclasses.replace(profile, **changes), record
    except runner.ProfileError as exc:
        die(f"profile {name!r} ({found.source} {found.path}) with this call's "
            f"overrides is refused by callva-harness-runner: {exc}", as_json=as_json)


def run(args):
    text_only = args.text
    as_json = not text_only

    target = Path(args.target).expanduser()
    if not target.is_absolute():
        target = (Path.cwd() / target).resolve()
    if not target.is_dir():
        die(f"target is not a directory: {target}", as_json=as_json)

    if args.act and args.read:
        die("--act and --read are contradictory; pass one", as_json=as_json)
    requested_mode = "act" if args.act else "read"
    root = _project_root()
    _refuse_self_target(target, root, as_json=as_json)
    caller = root.name if root else Path.cwd().name

    # The store is resolved before any work is taken: a machine with no store
    # refuses here, before a peer is started or anything is recorded.
    sessions = SessionMap()
    key = str(target)
    try:
        entry = sessions.get(key)
    except SessionStoreError as exc:
        exc.refuse()

    # engine selection: explicit --engine > env/default. A -c resume adopts the
    # session's own engine (a codex thread can't be resumed by claude).
    resumed = False
    resume_id = None
    stored_profile = None
    if args.cont:
        last_attempt = entry.get("last_attempt") or {}
        timed_out = last_attempt.get("status") == "timed_out"
        session_source = last_attempt if timed_out else entry
        stored_engine = session_source.get("engine") or entry.get("engine") or "claude"
        if args.engine and args.engine != stored_engine:
            die(f"cannot resume {target} with {args.engine}: the last session "
                f"used {stored_engine}", as_json=as_json)
        engine = args.engine or stored_engine
        resume_id = (session_source.get("session_id") if timed_out
                     else entry.get("last_session_id"))
        if not resume_id:
            if timed_out:
                die(f"the last attempt for {target} timed out before its session "
                    "id was observed; start a fresh call without -c",
                    as_json=as_json)
            die(f"no prior session for {target}; run without -c first", as_json=as_json)
        stored_mode = (session_source.get("mode") or entry.get("last_mode")
                       or requested_mode)
        if args.act and stored_mode != "act":
            die(f"cannot resume {target} in act mode: the last session used "
                f"{stored_mode}; start a fresh call without -c", as_json=as_json)
        # An act thread is never continued by inheritance: a bare -c would hand
        # the peer write tools with no flag typed, while a silent downgrade to
        # read would stop a scripted act workflow writing without saying so.
        if stored_mode == "act" and not (args.act or args.read):
            die(f"cannot resume {target} without naming a mode: the last "
                "session used act, so the peer could write; pass --act to "
                "continue writing or --read to continue in read mode",
                as_json=as_json)
        mode = "read" if args.read else stored_mode
        # The thread keeps the profile it ran under while it keeps its mode;
        # a follow-up in the other mode takes that mode's profile.
        if mode == stored_mode:
            stored_profile = (session_source.get("profile") or entry.get("last_profile"))
        if args.fork:
            die("--fork is not supported in headless mode", as_json=as_json)
        resumed = True
    else:
        engine = args.engine or _default_engine()
        mode = requested_mode

    if mode == "act":
        # Act hands the peer write tools; under the read-only switch nothing
        # started from here may change anything, so it is not started at all.
        _read_only_gate("`askproject --act`")

    # A profile is one engine. A named profile runs the engine its file names,
    # and an --engine naming the other one is a contradiction, refused before
    # anything starts; without one, the engine's own profile for the mode runs.
    profile_name = args.profile or stored_profile
    if profile_name:
        found, harness = _find_profile(profile_name, as_json)
        if args.engine and args.engine != harness:
            die(f"--profile {profile_name} runs {harness} and --engine names "
                f"{args.engine}; drop --engine, or name a {args.engine} profile "
                f"such as {default_profile(args.engine, mode)}", as_json=as_json)
        if resumed and harness != engine:
            die(f"cannot resume {target} with profile {profile_name!r}: it runs "
                f"{harness} and the last session used {engine}", as_json=as_json)
        engine = harness
    else:
        found, _harness = _find_profile(default_profile(engine, mode), as_json)

    if not _runner(as_json).find_binary(engine):
        die(f"`{engine}` CLI not found on PATH", as_json=as_json)

    # Overrides of the profile's values: a flag names this call, else the
    # environment chain; neither leaves the profile's own value in place.
    model = (args.model or _env_override(engine, "model") or "").strip() or None
    if model and engine == "claude":
        model = resolve_model(model)

    effort = None
    if args.effort:
        effort = args.effort.strip().lower()
        if effort not in EFFORT_LEVELS:
            die(f"unknown effort {args.effort!r}; expected one of "
                f"{', '.join(EFFORT_LEVELS)}", as_json=as_json)
    else:
        effort = _env_effort(engine)

    timeout = args.timeout if args.timeout is not None else _env_timeout()
    if timeout is not None and timeout <= 0:
        die(f"--timeout takes a positive number of seconds, not {timeout}",
            as_json=as_json)

    schema_text = resolve_schema(args.schema) if args.schema else None
    if schema_text and engine == "codex":
        try:
            parsed_schema = json.loads(schema_text)
        except ValueError:
            parsed_schema = None
        if not isinstance(parsed_schema, dict):
            die("--schema must be a JSON object (a file or inline JSON)",
                as_json=as_json)

    if args.name and engine != "claude":
        die(f"--name is a claude-engine control; {engine} names no peer",
            as_json=as_json)

    # The peer's identity is settled here rather than read back out of its
    # output. An id that exists only once the peer has spoken is missing exactly
    # when it is worth most: a peer that times out or dies mid-turn has already
    # worked in the target, and with no id there is nothing left to resume or
    # inspect. codex reports its own thread id and takes neither.
    if engine == "claude":
        session_id_upfront = resume_id or str(uuid.uuid4())
        peer_name = args.name or _default_peer_name(target, session_id_upfront)
    else:
        session_id_upfront = None
        peer_name = None

    profile, profile_record = _build_profile(
        found, engine, caller=caller, model=model, effort=effort,
        timeout=timeout, append=args.append, schema_text=schema_text,
        peer_name=peer_name, as_json=as_json)

    reporter = ProgressReporter(engine, enabled=not args.quiet)
    # Before the launch line: stdout carries the result only at exit, so this is
    # the only moment a caller watching a live run learns what it is watching.
    if peer_name:
        reporter.emit("peer", f"{peer_name} session {session_id_upfront}")
    reporter.emit("starting",
                  f"Launching {engine} peer with profile {profile_record['name']} "
                  f"({profile_record['source']})")
    before = snapshot(target)
    # Read before the peer starts: an engine that builds its context at session
    # start rewrites this file during the run, and the peer answered from the
    # revision that was there when it began.
    compiled_context = _compiled_context(target, engine)
    try:
        res = run_peer(engine, target, args.prompt, profile, resume_id,
                       schema_text, as_json, reporter, session_id_upfront)
    except PeerTimeout as exc:
        entry["last_attempt"] = {
            "status": "timed_out",
            "engine": engine,
            "mode": mode,
            "profile": profile_record["name"],
            "session_id": exc.session_id,
            "at": time.time(),
        }
        if exc.session_id:
            entry["last_session_id"] = exc.session_id
            entry["last_model"] = profile.model
            entry["last_effort"] = profile.effort
            entry["last_mode"] = mode
            entry["last_profile"] = profile_record["name"]
            entry["engine"] = engine
        _record_session(sessions, key, entry, interaction=False)
        hint = ("; resume it with -c" if exc.session_id else
                "; no session id was observed, so start a fresh call without -c")
        die(f"peer timed out after {exc.seconds}s{hint}", as_json=as_json)
    after = snapshot(target)
    files_changed, dirty_before = diff_snapshots(before, after)

    answer = res["answer"]
    session_id = res["session_id"]
    ok = not res["is_error"]
    err = None
    if mode == "read" and files_changed:
        ok = False
        err = "READ MODE MUTATED THE TARGET — investigate"

    # persist session mapping (local to the initiating project)
    if session_id:
        entry["last_session_id"] = session_id
        entry["last_model"] = res.get("model")
        entry["last_effort"] = res.get("effort")
        entry["last_mode"] = mode
        entry["last_profile"] = profile_record["name"]
        entry["engine"] = engine
        entry["last_used_at"] = time.time()
        entry["last_attempt"] = {
            "status": "completed",
            "engine": engine,
            "mode": mode,
            "profile": profile_record["name"],
            "session_id": session_id,
            "at": entry["last_used_at"],
        }
        _record_session(sessions, key, entry, interaction=True)

    if text_only:
        out = answer if isinstance(answer, str) else json.dumps(answer, indent=2)
        print(out)
        sys.exit(0 if ok else 1)

    result = {
        "ok": ok,
        "error": err,
        "target": str(target),
        "engine": engine,
        "mode": mode,
        "profile": profile_record,
        "model": res.get("model"),
        "effort": res.get("effort"),
        "session_id": session_id,
        "peer_name": peer_name,
        "resumed": resumed,
        "answer": answer,
        "cost_usd": res.get("cost_usd"),
        "duration_ms": res.get("duration_ms"),
        "num_turns": res.get("num_turns"),
        "tokens": res.get("tokens", {}),
        "git": {
            "repo": before.get("repo", False),
            "head_before": before.get("head"),
            "head_after": after.get("head"),
            "dirty_before": dirty_before,
            "files_changed": files_changed,
        },
        "compiled_context": compiled_context,
        "permission_denials": res.get("permission_denials", []),
    }
    print(json.dumps(result, indent=2))
    sys.exit(0 if ok else 1)


def _record_session(sessions: "SessionMap", key: str, entry: dict, *,
                    interaction: bool) -> None:
    """Record the session a peer ran. The peer has already worked in the
    target, so a store that fails now costs the next -c, not this answer."""
    try:
        sessions.put(key, entry, interaction=interaction)
    except Exception as exc:  # the answer outranks the record of it
        slug = getattr(exc, "slug", type(exc).__name__)
        sys.stderr.write(f"askproject: the session was not recorded ({slug}: {exc}); "
                         "-c cannot resume it\n")


def cmd_targets():
    import datetime
    as_json = "--json" in sys.argv
    try:
        state = dict(SessionMap().all())
    except SessionStoreError as exc:
        exc.refuse()

    if not state:
        if as_json:
            _emit({"targets": []})
        else:
            print("no targets recorded for this project")
        return

    if as_json:
        targets = []
        for k, v in state.items():
            entry = {
                "target": k,
                "last_session_id": v.get("last_session_id"),
                "engine": v.get("engine", "claude"),
                "model": v.get("last_model"),
                "effort": v.get("last_effort"),
                "profile": v.get("last_profile"),
                "interactions": v.get("interactions", 0),
            }
            last_used = v.get("last_used_at")
            if last_used:
                entry["last_used_at"] = last_used
                entry["last_used_iso"] = datetime.datetime.fromtimestamp(
                    last_used, tz=datetime.timezone.utc
                ).isoformat()
            targets.append(entry)
        _emit({"targets": targets})
    else:
        for k, v in state.items():
            print(f"{k}")
            parts = [
                f"last_session: {v.get('last_session_id')}",
                f"engine: {v.get('engine', 'claude')}",
            ]
            last_used = v.get("last_used_at")
            if last_used:
                dt = datetime.datetime.fromtimestamp(last_used, tz=datetime.timezone.utc)
                parts.append(f"last_used: {dt.strftime('%Y-%m-%d %H:%M UTC')}")
            print(f"  {parts[0]}  {parts[1]}")
            print(f"  model: {v.get('last_model')}  effort: {v.get('last_effort')}"
                  f"  interactions: {v.get('interactions', 0)}", end="")
            if last_used:
                print(f"  {parts[2]}")
            else:
                print()


def cmd_doctor():
    """Readiness: report which engine CLIs are on PATH and whether the store
    that keeps the session map can be used. ok requires the default engine to
    be present (either engine covers its own --engine calls) and the store."""
    engines = {name: shutil.which(name) for name in ENGINES}
    default = _default_engine()
    store, store_error = None, None
    try:
        setting = _store_setting()
        SessionMap._connect(setting).close()
        store = setting.report()
    except SessionStoreError as exc:
        store_error = {"code": exc.slug, "message": exc.message}
        if exc.hint:
            store_error["hint"] = exc.hint
    error = None
    if not engines.get(default):
        error = f"default engine {default!r} not found on PATH"
    elif store_error:
        error = f"the session store cannot be used: {store_error['message']}"
    ok = error is None
    _emit({"ok": ok, "engines": engines, "default_engine": default,
           "store": store,
           "store_error": store_error, "error": error})
    sys.exit(0 if ok else 2)


def main():
    argv = sys.argv[1:]
    _gate()              # disabled in this project → exit 4
    _contract(argv)      # stub/manifest/guide/ids/refs/connections → emit + exit; else return
    if not argv or argv[0] in ("help", "-h", "--help"):
        print(__doc__)
        return
    if argv[0] == "doctor":
        cmd_doctor()
        return
    if argv[0] == "targets":
        cmd_targets()
        return
    if argv[0] == "profiles":
        cmd_profiles(argv[1:])
        return

    p = argparse.ArgumentParser(prog="askproject", add_help=False)
    p.add_argument("target")
    p.add_argument("prompt")
    p.add_argument("--engine", choices=ENGINES)
    p.add_argument("--act", action="store_true")
    p.add_argument("--read", action="store_true")
    p.add_argument("-c", "--continue", dest="cont", action="store_true")
    p.add_argument("--fork", action="store_true")
    p.add_argument("--model")
    p.add_argument("--effort")
    p.add_argument("--schema")
    p.add_argument("--timeout", type=int)
    p.add_argument("--profile")
    p.add_argument("--text", action="store_true")
    p.add_argument("--quiet", action="store_true")
    p.add_argument("--append")
    p.add_argument("--name")
    args = p.parse_args(argv)
    run(args)


if __name__ == "__main__":
    main()
