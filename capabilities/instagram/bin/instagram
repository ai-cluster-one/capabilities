PROFILE_RE = re.compile(r"^[A-Za-z0-9._]{1,30}$")
GRAPHQL_URL = "https://www.instagram.com/api/graphql"
PREFLIGHT_URL = "https://www.instagram.com/api/v1/accounts/edit/web_form_data/"
WEB_PROFILE_INFO_URL = "https://www.instagram.com/api/v1/users/web_profile_info/"
USER_FEED_URL = "https://www.instagram.com/api/v1/feed/user/{user_id}/"
DIRECT_INBOX_URL = "https://www.instagram.com/api/v1/direct_v2/inbox/"
DIRECT_THREAD_URL = "https://www.instagram.com/api/v1/direct_v2/threads/{thread_id}/"
DIRECT_REQUESTS_FRIENDLY_NAME = "PolarisDirectMessageRequestQuery"
DIRECT_REQUESTS_DOC_ID = "27314940144869221"
LIKE_FRIENDLY_NAME = "usePolarisLikeMediaXIGLikeMutation"
LIKE_DOC_ID = "27182485238052618"
FOLLOW_FRIENDLY_NAME = "usePolarisFollowMutation"
FOLLOW_DOC_ID = "26508036048874888"
CREATE_THREAD_URL = (
    "https://www.instagram.com/api/v1/direct_v2/create_group_thread/"
)
SESSION_VERSION = 1
SENSITIVE_HEADERS = {"cookie", "x-csrftoken"}
REMOVED_HEADERS = {"content-length", "accept-encoding"}
DATA_FLAGS = {"--data", "--data-raw", "--data-binary", "-d"}

HELP = """instagram — agent-first CLI over an authenticated Instagram web session.

This capability drives the same private browser-session endpoints used by
instagram.com. It is stateful and may stop working when Instagram changes its
web client. Run `instagram doctor` before domain work. Checkpoints, challenges,
CAPTCHA, and 2FA always require the user in the browser; this tool never bypasses
them.

Connections
  An explicit connections registry is required, even for one account. Put it in
  the consuming project's Instagram envelope or in
  ~/.config/instagram/connections.json:

    {
      "default": "main",
      "connections": {
        "main": {
          "expected_username": "account.handle",
          "allow_write": false,
          "timeout_seconds": 30
        }
      }
    }

  `expected_username` is mandatory and doctor refuses a session authenticated as
  another account. Each connection owns a separate session under the user state
  home. Session JSON contains live cookies and is written with mode 0600.

Authentication
  Sign in to Instagram in a browser, send one authorized test text DM, select the
  successful IGDirectTextSendMutation in Network, and choose Copy as cURL. Keep
  the capture out of chat and import it locally:

    instagram refresh --clipboard [--connection ID]
    instagram refresh /protected/path/request.curl [--connection ID]
    instagram refresh - [--connection ID]        # read cURL from stdin

  Refresh only mints local session state. Run doctor immediately afterwards.

Commands
  instagram help
  instagram doctor [--connection ID]             Validate identity and session.
  instagram connections                           Local masked configuration report.
  instagram refresh <PATH|-|--clipboard>          Import a browser capture locally.
  instagram whoami [--connection ID]              Return authenticated username.
  instagram profile show <handle-or-url>           Read profile routing metadata.
  instagram relationship show <handle-or-url>      Read current follow relationship.
  instagram relationship follow <handle-or-url>    Follow unless already followed/requested.
  instagram media list <handle-or-url> [--limit N]
                                                  List recent profile media.
  instagram media like <handle-or-url> <code-or-id>
                                                  Like one listed media item.
  instagram conversations find <handle-or-url> [--max-pages N] [--folders main|requests|spam|all]
                                                  Find a thread in main inbox, message requests, and/or spam.
  instagram messages inspect <handle-or-url> [--max-pages N] [--folders main|requests|spam|all]
                                                  Detect prior outgoing messages without exposing text.
  instagram messages eligibility <handle-or-url> [--max-pages N] [--folders main|requests|spam|all]
                                                  Read-only DM routing verdict; null means Instagram exposes no decisive preflight.
  instagram messages reconcile <handle-or-url>
      (--offline-id ID | --server-message-id ID) [--max-pages N]
                                                  Confirm a possibly ambiguous send from thread history; never authorizes retry.
  instagram conversations resolve <handle-or-url> Obtain/create the private thread.
  instagram messages send <handle-or-url>
      (--text TEXT | --text-file PATH | --stdin)
                                                  Resolve the thread and send text.

Write policy
  `relationship follow`, `media like`, `conversations resolve`, and
  `messages send` leave state on Instagram and are refused unless the selected connection has
  `allow_write: true`. Exit 4 means policy refusal; ask the user rather than
  changing the gate. Existing follows, pending requests, and media already
  liked return without a write. Ambiguous write failures are never retried
  automatically because that could duplicate an action.

Exit codes
  0 success · 2 authentication/session · 3 profile not found · 4 policy refusal
  5 Instagram/network failure · 6 input/configuration · 7 contract/audit failure

Contract commands
  instagram stub
  instagram manifest --json
  instagram guide [topic]
  instagram ids list|get|set|rm
  instagram refs
"""


@dataclass
class RequestTemplate:
    version: int
    captured_at: str
    url: str
    method: str
    headers: dict[str, str]
    cookies: dict[str, str]
    form: dict[str, str]

    @classmethod
    def from_dict(cls, raw: dict[str, Any]) -> RequestTemplate:
        try:
            return cls(
                version=int(raw["version"]),
                captured_at=str(raw["captured_at"]),
                url=str(raw["url"]),
                method=str(raw["method"]),
                headers={str(k): str(v) for k, v in dict(raw["headers"]).items()},
                cookies={str(k): str(v) for k, v in dict(raw["cookies"]).items()},
                form={str(k): str(v) for k, v in dict(raw["form"]).items()},
            )
        except (KeyError, TypeError, ValueError) as exc:
            raise InstagramFailure(
                2, "session_invalid", "Stored session has an invalid shape"
            ) from exc


@dataclass(frozen=True)
class Connection:
    id: str
    expected_username: str
    allow_write: bool
    timeout_seconds: int
    session_path: Path


@dataclass(frozen=True)
class RoutingResult:
    username: str
    recipient_pk: str
    thread_igid: str


@dataclass(frozen=True)
class SendResult:
    status: str
    server_message_id: str | None = None
    timestamp_ms: str | None = None
    error_code: str | None = None
    error_summary: str | None = None


class InstagramFailure(RuntimeError):
    def __init__(
        self,
        exit_code: int,
        code: str,
        message: str,
        hint: str | None = None,
        status: int | None = None,
    ) -> None:
        super().__init__(message)
        self.exit_code = exit_code
        self.code = code
        self.message = message
        self.hint = hint
        self.status = status


class _JsonScripts(HTMLParser):
    def __init__(self) -> None:
        super().__init__()
        self.active = False
        self.parts: list[str] = []
        self.scripts: list[str] = []

    def handle_starttag(
        self, tag: str, attrs: list[tuple[str, str | None]]
    ) -> None:
        if tag == "script" and dict(attrs).get("type") == "application/json":
            self.active = True
            self.parts = []

    def handle_data(self, data: str) -> None:
        if self.active:
            self.parts.append(data)

    def handle_endtag(self, tag: str) -> None:
        if tag == "script" and self.active:
            self.scripts.append("".join(self.parts))
            self.active = False


def _normalize_profile(value: str) -> tuple[str, str]:
    raw = value.strip()
    if not raw:
        raise InstagramFailure(6, "input", "Profile must not be empty")
    if "://" not in raw:
        username = raw.removeprefix("@").strip("/")
    else:
        parsed = urlparse(raw)
        if parsed.scheme not in {"http", "https"}:
            raise InstagramFailure(
                6, "input", f"Unsupported profile URL scheme: {parsed.scheme!r}"
            )
        if parsed.hostname not in {"instagram.com", "www.instagram.com"}:
            raise InstagramFailure(
                6, "input", "Profile URL must use instagram.com"
            )
        parts = [part for part in parsed.path.split("/") if part]
        if len(parts) != 1:
            raise InstagramFailure(
                6, "input", "Expected an Instagram profile URL with one path segment"
            )
        username = parts[0]
    if not PROFILE_RE.fullmatch(username):
        raise InstagramFailure(
            6, "input", f"Invalid Instagram username: {username!r}"
        )
    return f"https://www.instagram.com/{username}/", username


def _header_name(name: str) -> str:
    return "-".join(part.capitalize() for part in name.split("-"))


def _parse_cookie_header(value: str) -> dict[str, str]:
    parsed = SimpleCookie()
    parsed.load(value)
    cookies = {name: morsel.value for name, morsel in parsed.items()}
    if not cookies:
        raise InstagramFailure(
            6, "capture_invalid", "Cookie header could not be parsed"
        )
    return cookies


def _consume_option(tokens: list[str], index: int) -> tuple[str, int]:
    if index + 1 >= len(tokens):
        raise InstagramFailure(
            6, "capture_invalid", f"Missing value after {tokens[index]}"
        )
    return tokens[index + 1], index + 2


def _parse_curl(text: str) -> RequestTemplate:
    normalized = re.sub(r"\\\s*\n", " ", text).strip()
    try:
        tokens = shlex.split(normalized, posix=True)
    except ValueError as exc:
        raise InstagramFailure(6, "capture_invalid", str(exc)) from exc
    if not tokens or Path(tokens[0]).name != "curl":
        raise InstagramFailure(6, "capture_invalid", "Input must start with curl")

    url = ""
    method = "GET"
    headers: dict[str, str] = {}
    data_parts: list[str] = []
    index = 1
    while index < len(tokens):
        token = tokens[index]
        if token in {"-X", "--request"}:
            method, index = _consume_option(tokens, index)
            method = method.upper()
        elif token in {"-H", "--header"}:
            header, index = _consume_option(tokens, index)
            if ":" not in header:
                raise InstagramFailure(
                    6, "capture_invalid", f"Invalid header: {header!r}"
                )
            name, value = header.split(":", 1)
            headers[_header_name(name.strip())] = value.strip()
        elif token in DATA_FLAGS:
            value, index = _consume_option(tokens, index)
            data_parts.append(value)
            method = "POST"
        elif any(token.startswith(f"{flag}=") for flag in DATA_FLAGS):
            data_parts.append(token.split("=", 1)[1])
            method = "POST"
            index += 1
        elif token in {"--compressed", "-s", "-S", "-sS", "--location"}:
            index += 1
        elif token in {
            "--max-time",
            "--connect-timeout",
            "-w",
            "--write-out",
        }:
            _, index = _consume_option(tokens, index)
        elif token.startswith("-"):
            raise InstagramFailure(
                6, "capture_invalid", f"Unsupported curl option: {token}"
            )
        elif not url:
            url = token
            index += 1
        else:
            raise InstagramFailure(
                6, "capture_invalid", f"Unexpected curl argument: {token!r}"
            )

    if method != "POST":
        raise InstagramFailure(
            6, "capture_invalid", f"Expected POST request, got {method}"
        )
    if url.rstrip("/") != GRAPHQL_URL:
        raise InstagramFailure(
            6, "capture_invalid", f"Expected {GRAPHQL_URL}"
        )
    if len(data_parts) != 1:
        raise InstagramFailure(
            6, "capture_invalid", "Expected one complete --data value"
        )
    lower_headers = {name.lower(): value for name, value in headers.items()}
    if lower_headers.get("x-fb-friendly-name") != "IGDirectTextSendMutation":
        raise InstagramFailure(
            6, "capture_invalid", "Request is not IGDirectTextSendMutation"
        )
    cookie_header = lower_headers.get("cookie")
    if not cookie_header:
        raise InstagramFailure(
            6, "capture_invalid", "Captured request has no Cookie header"
        )
    form = dict(parse_qsl(data_parts[0], keep_blank_values=True))
    if "variables" not in form or "doc_id" not in form:
        raise InstagramFailure(
            6, "capture_invalid", "Captured form lacks variables or doc_id"
        )
    try:
        variables = json.loads(form["variables"])
    except (json.JSONDecodeError, TypeError) as exc:
        raise InstagramFailure(
            6, "capture_invalid", "variables is not valid JSON"
        ) from exc
    if not isinstance(variables, dict) or not {
        "ig_thread_igid",
        "text",
    }.issubset(variables):
        raise InstagramFailure(
            6, "capture_invalid", "variables lacks thread or text fields"
        )
    variables["offline_threading_id"] = ""
    variables["text"] = {"sensitive_string_value": ""}
    form["variables"] = json.dumps(
        variables, ensure_ascii=False, separators=(",", ":")
    )
    clean_headers = {
        name: value
        for name, value in headers.items()
        if name.lower() not in SENSITIVE_HEADERS | REMOVED_HEADERS
    }
    return RequestTemplate(
        version=SESSION_VERSION,
        captured_at=datetime.now(UTC).isoformat(),
        url=url,
        method=method,
        headers=clean_headers,
        cookies=_parse_cookie_header(cookie_header),
        form=form,
    )


def _write_template(template: RequestTemplate, path: Path) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.parent.chmod(0o700)
    payload = json.dumps(asdict(template), ensure_ascii=False, indent=2) + "\n"
    fd, temporary_name = tempfile.mkstemp(
        dir=path.parent, prefix=f".{path.name}.", suffix=".tmp", text=True
    )
    temporary = Path(temporary_name)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        path.chmod(0o600)
    finally:
        if temporary.exists():
            temporary.unlink()


def _load_template(path: Path) -> RequestTemplate:
    if not path.is_file():
        raise InstagramFailure(
            2,
            "session_missing",
            "Instagram browser session has not been imported",
            "run `instagram refresh --clipboard`, then `instagram doctor`",
        )
    mode = path.stat().st_mode & 0o777
    if mode & 0o077:
        raise InstagramFailure(
            2,
            "session_permissions",
            f"Session file must be mode 0600, found {mode:04o}: {path}",
        )
    try:
        raw = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise InstagramFailure(
            2, "session_invalid", f"Cannot read stored session: {exc}"
        ) from exc
    if not isinstance(raw, dict):
        raise InstagramFailure(2, "session_invalid", "Stored session is not an object")
    return RequestTemplate.from_dict(raw)


def _connection_from_entry(cid: str, raw: Any) -> Connection:
    if not isinstance(raw, dict):
        raise InstagramFailure(
            6, "bad_config", f"Connection {cid!r} must be a JSON object"
        )
    username = str(raw.get("expected_username") or "").strip().removeprefix("@")
    if not PROFILE_RE.fullmatch(username):
        raise InstagramFailure(
            6,
            "bad_config",
            f"Connection {cid!r} requires a valid expected_username",
        )
    try:
        timeout = int(raw.get("timeout_seconds", 30))
    except (TypeError, ValueError) as exc:
        raise InstagramFailure(
            6, "bad_config", f"Connection {cid!r} timeout_seconds must be an integer"
        ) from exc
    if timeout < 5 or timeout > 120:
        raise InstagramFailure(
            6,
            "bad_config",
            f"Connection {cid!r} timeout_seconds must be between 5 and 120",
        )
    return Connection(
        id=cid,
        expected_username=username,
        allow_write=bool(raw.get("allow_write", WRITE_DEFAULT)),
        timeout_seconds=timeout,
        session_path=_state_dir() / cid / "session.json",
    )


def _connection(wanted: str | None) -> Connection:
    reg, _ = _connections_registry()
    cid, raw = _select_connection(reg, wanted)
    return _connection_from_entry(cid, raw)


def _connections_report() -> dict:
    reg, reg_file = _connections_registry()
    conns = reg["connections"]
    out: dict[str, Any] = {
        "default": reg.get("default")
        or (next(iter(conns)) if len(conns) == 1 else None),
        "registry": str(reg_file) if reg_file else None,
        "connections": {},
    }
    for cid, raw in conns.items():
        try:
            conn = _connection_from_entry(cid, raw)
            path = conn.session_path
            present = path.is_file()
            mode = (path.stat().st_mode & 0o777) if present else None
            out["connections"][cid] = {
                "allow_write": conn.allow_write,
                "expected_username": conn.expected_username,
                "timeout_seconds": conn.timeout_seconds,
                "keys": [],
                "session": {
                    "set": present,
                    "path": str(path),
                    "secure": bool(present and mode is not None and not (mode & 0o077)),
                },
            }
        except InstagramFailure as exc:
            out["connections"][cid] = {
                "allow_write": bool(
                    raw.get("allow_write", WRITE_DEFAULT)
                    if isinstance(raw, dict)
                    else WRITE_DEFAULT
                ),
                "keys": [],
                "configuration_error": exc.message,
            }
    return out


def _cmd_connections() -> None:
    _emit(_connections_report())


def _bootstrap_data(
    html: str, expected_username: str
) -> tuple[str, str, dict[str, Any], dict[str, Any] | None]:
    parser = _JsonScripts()
    parser.feed(html)
    modules: dict[str, dict[str, Any]] = {}
    matched: dict[str, Any] | None = None
    for raw in parser.scripts:
        try:
            decoded = json.loads(raw)
        except json.JSONDecodeError:
            continue
        stack: list[Any] = [decoded]
        while stack:
            value = stack.pop()
            if isinstance(value, dict):
                candidate = str(value.get("username") or "")
                if (
                    candidate.lower() == expected_username.lower()
                    and value.get("pk") is not None
                    and (matched is None or len(value) > len(matched))
                ):
                    matched = value
                for key, child in value.items():
                    if key in {"define", "require"} and isinstance(child, list):
                        for entry in child:
                            if (
                                isinstance(entry, list)
                                and len(entry) > 2
                                and entry[0] in {"DTSGInitialData", "LSD", "SiteData"}
                                and isinstance(entry[2], dict)
                            ):
                                modules[str(entry[0])] = entry[2]
                    stack.append(child)
            elif isinstance(value, list):
                stack.extend(value)
    missing = {"DTSGInitialData", "LSD", "SiteData"} - modules.keys()
    if missing:
        raise InstagramFailure(
            5,
            "profile_bootstrap_missing",
            "Profile page did not contain fresh request tokens",
        )
    dtsg = str(modules["DTSGInitialData"].get("token") or "")
    lsd = str(modules["LSD"].get("token") or "")
    if not dtsg or not lsd:
        raise InstagramFailure(
            5,
            "profile_tokens_missing",
            "Profile page did not contain fresh request tokens",
        )
    return dtsg, lsd, modules["SiteData"], matched


def _bootstrap_profile(
    html: str, expected_username: str
) -> tuple[str, str, dict[str, Any], dict[str, Any]]:
    dtsg, lsd, site, matched = _bootstrap_data(html, expected_username)
    if matched is None:
        raise InstagramFailure(
            5,
            "profile_bootstrap_missing",
            "Profile page did not contain required routing data",
        )
    return dtsg, lsd, site, matched


def _decode_json(text: str) -> dict[str, Any]:
    payload = text.strip().removeprefix("for (;;);")
    decoded = json.loads(payload)
    if not isinstance(decoded, dict):
        raise TypeError("Expected a JSON object")
    return decoded


def _parse_send_response(http_status: int, text: str) -> SendResult:
    if http_status in {401, 403}:
        return SendResult(status="auth_failure", error_code=str(http_status))
    if http_status == 429:
        return SendResult(status="rate_limited", error_code="429")
    if http_status >= 500:
        return SendResult(status="unknown", error_code=str(http_status))
    try:
        payload = _decode_json(text)
    except (json.JSONDecodeError, TypeError, ValueError):
        return SendResult(status="unknown", error_code="invalid_json")
    data = payload.get("data")
    result = (
        data.get("xig_direct_text_send_with_slide_messaging_response")
        if isinstance(data, dict)
        else None
    )
    if isinstance(result, dict) and result.get("message_id"):
        return SendResult(
            status="sent",
            server_message_id=str(result["message_id"]),
            timestamp_ms=(
                str(result["timestamp_ms"])
                if result.get("timestamp_ms") is not None
                else None
            ),
        )
    errors = payload.get("errors")
    graphql_error = (
        errors[0]
        if isinstance(errors, list) and errors and isinstance(errors[0], dict)
        else {}
    )
    error_code = (
        graphql_error.get("code")
        or graphql_error.get("api_error_code")
        or payload.get("error")
        or payload.get("error_code")
    )
    summary = (
        graphql_error.get("description_raw")
        or graphql_error.get("description")
        or graphql_error.get("summary")
        or graphql_error.get("message")
        or payload.get("errorSummary")
        or payload.get("message")
    )
    normalized = json.dumps(payload, ensure_ascii=False).lower()
    if str(error_code) == "1545120" or (
        "invitation to chat" in normalized and "accepted" in normalized
    ):
        status = "awaiting_acceptance"
    elif any(
        marker in normalized
        for marker in ("login_required", "checkpoint", "challenge_required")
    ):
        status = "auth_failure"
    elif str(error_code) == "1357054":
        status = "template_failure"
    else:
        status = "explicit_failure"
    return SendResult(
        status=status,
        error_code=str(error_code) if error_code is not None else None,
        error_summary=str(summary) if summary is not None else None,
    )


class InstagramWebClient:
    def __init__(self, connection: Connection) -> None:
        self.connection = connection
        self.template = _load_template(connection.session_path)
        self.http = httpx.Client(
            cookies=self.template.cookies,
            follow_redirects=True,
            timeout=connection.timeout_seconds,
        )

    def close(self) -> None:
        self.http.close()

    def __enter__(self) -> Self:
        return self

    def __exit__(self, *_args: object) -> None:
        self.close()

    def _cookie_value(self, name: str) -> str | None:
        values = [cookie.value for cookie in self.http.cookies.jar if cookie.name == name]
        return values[-1] if values else None

    def _header_value(self, name: str) -> str:
        lowered = name.lower()
        for header_name, value in self.template.headers.items():
            if header_name.lower() == lowered:
                return value
        return ""

    def _persist(self) -> None:
        latest: dict[str, str] = {}
        for cookie in self.http.cookies.jar:
            if not cookie.domain or cookie.domain.endswith("instagram.com"):
                latest[str(cookie.name)] = str(cookie.value)
        self.template.cookies.update(latest)
        _write_template(self.template, self.connection.session_path)

    def preflight(self) -> dict[str, Any]:
        csrf = self._cookie_value("csrftoken")
        headers = {
            "Accept": "*/*",
            "Referer": "https://www.instagram.com/accounts/edit/",
            "User-Agent": self._header_value("User-Agent"),
            "X-IG-App-ID": self._header_value("X-IG-App-ID"),
        }
        if csrf:
            headers["X-CSRFToken"] = csrf
        try:
            response = self.http.get(
                PREFLIGHT_URL,
                headers={key: value for key, value in headers.items() if value},
            )
        except httpx.HTTPError as exc:
            raise InstagramFailure(
                5,
                "network_error",
                f"Instagram preflight failed: {type(exc).__name__}",
            ) from exc
        finally:
            self._persist()
        try:
            payload = response.json()
        except ValueError as exc:
            raise InstagramFailure(
                2,
                "auth_invalid_response",
                f"Instagram preflight returned non-JSON HTTP {response.status_code}",
                status=response.status_code,
            ) from exc
        username = str((payload.get("form_data") or {}).get("username") or "")
        if response.status_code != 200 or payload.get("status") != "ok" or not username:
            raise InstagramFailure(
                2,
                "auth_failed",
                "Instagram session is missing or expired",
                "refresh it from a fresh successful browser request",
                response.status_code,
            )
        if username.lower() != self.connection.expected_username.lower():
            raise InstagramFailure(
                2,
                "unexpected_account",
                f"Session is authenticated as {username!r}, expected "
                f"{self.connection.expected_username!r}",
            )
        return {"username": username, "status": "healthy"}

    def _profile_api(self, canonical_url: str, username: str) -> dict[str, Any]:
        headers = {
            "Accept": "*/*",
            "Referer": canonical_url,
            "User-Agent": self._header_value("User-Agent"),
            "X-IG-App-ID": self._header_value("X-IG-App-ID"),
        }
        csrf = self._cookie_value("csrftoken")
        if csrf:
            headers["X-CSRFToken"] = csrf
        try:
            response = self.http.get(
                WEB_PROFILE_INFO_URL,
                params={"username": username},
                headers={key: value for key, value in headers.items() if value},
            )
        except httpx.HTTPError as exc:
            raise InstagramFailure(
                5,
                "network_error",
                f"Profile metadata request failed: {type(exc).__name__}",
            ) from exc
        finally:
            self._persist()
        if response.status_code in {401, 403}:
            raise InstagramFailure(
                2,
                "auth_failed",
                "Instagram login is required",
                status=response.status_code,
            )
        try:
            payload = response.json()
        except ValueError as exc:
            raise InstagramFailure(
                5,
                "invalid_response",
                "Profile metadata response was not JSON",
                status=response.status_code,
            ) from exc
        raw = (payload.get("data") or {}).get("user")
        if response.status_code == 404 or not isinstance(raw, dict):
            raise InstagramFailure(3, "not_found", f"Profile @{username} was not found")
        if response.status_code != 200 or payload.get("status") != "ok":
            raise InstagramFailure(
                5,
                "instagram_error",
                "Profile metadata request was rejected",
                status=response.status_code,
            )
        actual_username = str(raw.get("username") or "")
        recipient_pk = raw.get("pk") or raw.get("pk_id") or raw.get("id")
        if actual_username.lower() != username.lower() or recipient_pk is None:
            raise InstagramFailure(
                5,
                "profile_unvalidated",
                "Instagram did not return validated profile routing data",
            )
        result = dict(raw)
        result["pk"] = str(recipient_pk)
        return result

    def profile(self, profile_value: str) -> dict[str, Any]:
        canonical_url, username = _normalize_profile(profile_value)
        headers = {
            "Accept": "text/html,application/xhtml+xml",
            "User-Agent": self._header_value("User-Agent"),
        }
        try:
            response = self.http.get(
                canonical_url,
                headers={key: value for key, value in headers.items() if value},
            )
        except httpx.HTTPError as exc:
            raise InstagramFailure(
                5, "network_error", f"Profile request failed: {type(exc).__name__}"
            ) from exc
        finally:
            self._persist()
        if response.status_code in {401, 403} or "/accounts/login" in str(
            response.url
        ):
            raise InstagramFailure(
                2, "auth_failed", "Instagram login is required", status=response.status_code
            )
        if response.status_code == 404:
            raise InstagramFailure(3, "not_found", f"Profile @{username} was not found")
        if response.status_code != 200:
            raise InstagramFailure(
                5,
                "instagram_error",
                "Profile page request was rejected",
                status=response.status_code,
            )
        dtsg, lsd, site, raw = _bootstrap_data(response.text, username)
        if raw is None:
            raw = self._profile_api(canonical_url, username)
        self.template.form["fb_dtsg"] = dtsg
        self.template.form["lsd"] = lsd
        self.template.form["jazoest"] = "2" + str(sum(ord(char) for char in dtsg))
        for form_key, site_key in (
            ("__rev", "server_revision"),
            ("__hsi", "hsi"),
            ("__spin_r", "__spin_r"),
            ("__spin_b", "__spin_b"),
            ("__spin_t", "__spin_t"),
        ):
            if site.get(site_key) is not None:
                self.template.form[form_key] = str(site[site_key])
        for name in list(self.template.headers):
            if name.lower() == "x-fb-lsd":
                self.template.headers[name] = lsd
            elif name.lower() == "referer":
                self.template.headers[name] = canonical_url
        claim = response.headers.get("x-ig-set-www-claim")
        if claim:
            self.template.headers["X-IG-WWW-Claim"] = claim
        _write_template(self.template, self.connection.session_path)
        follower_count = raw.get("follower_count")
        if follower_count is None and isinstance(raw.get("edge_followed_by"), dict):
            follower_count = raw["edge_followed_by"].get("count")
        following_count = raw.get("following_count")
        if following_count is None and isinstance(raw.get("edge_follow"), dict):
            following_count = raw["edge_follow"].get("count")
        media_count = raw.get("media_count")
        timeline = raw.get("edge_owner_to_timeline_media")
        if media_count is None and isinstance(timeline, dict):
            media_count = timeline.get("count")
        fields = {
            "username": str(raw.get("username") or username),
            "profile_url": canonical_url,
            "recipient_pk": str(raw.get("pk")),
            "full_name": raw.get("full_name"),
            "is_private": raw.get("is_private"),
            "is_verified": raw.get("is_verified"),
            "follower_count": follower_count,
            "following_count": following_count,
            "media_count": media_count,
            "followed_by_viewer": bool(raw.get("followed_by_viewer")),
            "requested_by_viewer": bool(raw.get("requested_by_viewer")),
            "follows_viewer": bool(raw.get("follows_viewer")),
            "blocked_by_viewer": bool(raw.get("blocked_by_viewer")),
            "restricted_by_viewer": bool(raw.get("restricted_by_viewer")),
        }
        return {key: value for key, value in fields.items() if value is not None}

    def relationship_show(self, profile_value: str) -> dict[str, Any]:
        profile = self.profile(profile_value)
        if profile["blocked_by_viewer"]:
            status = "blocked"
        elif profile["followed_by_viewer"]:
            status = "following"
        elif profile["requested_by_viewer"]:
            status = "requested"
        else:
            status = "not_following"
        return {
            "username": profile["username"],
            "recipient_pk": profile["recipient_pk"],
            "is_private": profile.get("is_private"),
            "status": status,
            "following": profile["followed_by_viewer"],
            "outgoing_request": profile["requested_by_viewer"],
            "followed_by": profile["follows_viewer"],
            "blocked": profile["blocked_by_viewer"],
            "restricted": profile["restricted_by_viewer"],
        }

    def follow(self, profile_value: str) -> dict[str, Any]:
        relationship = self.relationship_show(profile_value)
        if relationship["blocked"]:
            return {**relationship, "status": "blocked"}
        if relationship["following"]:
            return {**relationship, "status": "already_following"}
        if relationship["outgoing_request"]:
            return {**relationship, "status": "already_requested"}

        csrf = self._cookie_value("csrftoken")
        if not csrf:
            raise InstagramFailure(
                2,
                "session_tokens_missing",
                "Follow request requires a current CSRF token",
                "refresh the browser session and retry relationship show",
            )
        variables = {
            "target_user_id": relationship["recipient_pk"],
            "container_module": "profile",
            "nav_chain": "PolarisProfilePostsTabRoot:profilePage:1:via_cold_start",
        }
        form = dict(self.template.form)
        form.update(
            {
                "fb_api_caller_class": "RelayModern",
                "fb_api_req_friendly_name": FOLLOW_FRIENDLY_NAME,
                "server_timestamps": "true",
                "variables": json.dumps(variables, separators=(",", ":")),
                "doc_id": FOLLOW_DOC_ID,
            }
        )
        headers = {
            name: value
            for name, value in self.template.headers.items()
            if name.lower()
            not in {
                "cookie",
                "content-length",
                "accept-encoding",
                "x-csrftoken",
                "x-fb-friendly-name",
            }
        }
        headers.update(
            {
                "Referer": f"https://www.instagram.com/{relationship['username']}/",
                "X-CSRFToken": csrf,
                "X-FB-Friendly-Name": FOLLOW_FRIENDLY_NAME,
            }
        )
        try:
            response = self.http.post(GRAPHQL_URL, headers=headers, data=form)
        except httpx.HTTPError as exc:
            raise InstagramFailure(
                5,
                "follow_unknown",
                "Follow result is unknown; do not retry automatically",
                type(exc).__name__,
            ) from exc
        finally:
            self._persist()
        if response.status_code in {401, 403}:
            raise InstagramFailure(
                2,
                "auth_failed",
                "Instagram rejected the current session",
                status=response.status_code,
            )
        if response.status_code == 429:
            raise InstagramFailure(5, "rate_limited", "Instagram rate-limited the follow")
        try:
            payload = _decode_json(response.text)
        except (json.JSONDecodeError, TypeError, ValueError) as exc:
            raise InstagramFailure(
                5,
                "follow_unknown",
                "Follow response was not valid JSON; do not retry automatically",
                status=response.status_code,
            ) from exc
        result = ((payload.get("data") or {}).get("xdt_create_friendship") or {})
        friendship = result.get("friendship_status")
        result_id = str(result.get("id") or "")
        following = bool(friendship.get("following")) if isinstance(friendship, dict) else False
        outgoing_request = (
            bool(friendship.get("outgoing_request")) if isinstance(friendship, dict) else False
        )
        if (
            response.status_code != 200
            or result_id != relationship["recipient_pk"]
            or not isinstance(friendship, dict)
            or not (following or outgoing_request)
        ):
            raise InstagramFailure(
                5,
                "follow_rejected",
                "Instagram did not confirm the follow or outgoing request",
                status=response.status_code,
            )
        return {
            **relationship,
            "status": "followed" if following else "requested",
            "following": following,
            "outgoing_request": outgoing_request,
        }

    def media_list(
        self, profile_value: str, *, limit: int = 12, max_id: str | None = None
    ) -> dict[str, Any]:
        if limit < 1 or limit > 50:
            raise InstagramFailure(6, "input", "Media limit must be between 1 and 50")
        profile = self.profile(profile_value)
        username = str(profile["username"])
        recipient_pk = str(profile["recipient_pk"])
        canonical_url = str(profile["profile_url"])
        headers = {
            "Accept": "*/*",
            "Referer": canonical_url,
            "User-Agent": self._header_value("User-Agent"),
            "X-IG-App-ID": self._header_value("X-IG-App-ID"),
            "X-ASBD-ID": self._header_value("X-ASBD-ID"),
        }
        csrf = self._cookie_value("csrftoken")
        if csrf:
            headers["X-CSRFToken"] = csrf
        params = {"count": str(limit)}
        if max_id:
            params["max_id"] = max_id
        try:
            response = self.http.get(
                USER_FEED_URL.format(user_id=recipient_pk),
                params=params,
                headers={key: value for key, value in headers.items() if value},
            )
        except httpx.HTTPError as exc:
            raise InstagramFailure(
                5, "network_error", f"Media request failed: {type(exc).__name__}"
            ) from exc
        finally:
            self._persist()
        if response.status_code in {401, 403}:
            raise InstagramFailure(
                2,
                "auth_failed",
                "Instagram login is required",
                status=response.status_code,
            )
        try:
            payload = response.json()
        except ValueError as exc:
            raise InstagramFailure(
                5,
                "invalid_response",
                "Media response was not JSON",
                status=response.status_code,
            ) from exc
        raw_items = payload.get("items")
        if (
            response.status_code != 200
            or payload.get("status") != "ok"
            or not isinstance(raw_items, list)
        ):
            raise InstagramFailure(
                5,
                "media_unvalidated",
                "Instagram did not return a validated media list",
                status=response.status_code,
            )
        pinned = {str(value).split("_", 1)[0] for value in (
            payload.get("pinned_profile_grid_items_ids") or []
        )}
        items: list[dict[str, Any]] = []
        for raw in raw_items:
            if not isinstance(raw, dict):
                continue
            pk = str(raw.get("pk") or "")
            code = str(raw.get("code") or "")
            if not pk or not code:
                continue
            owner = raw.get("user") if isinstance(raw.get("user"), dict) else {}
            product_type = str(raw.get("product_type") or "")
            route = "reel" if product_type == "clips" else "p"
            items.append(
                {
                    "media_pk": pk,
                    "media_id": str(raw.get("id") or pk),
                    "code": code,
                    "permalink": f"https://www.instagram.com/{route}/{code}/",
                    "owner_username": str(owner.get("username") or ""),
                    "media_type": raw.get("media_type"),
                    "product_type": product_type or None,
                    "has_liked": bool(raw.get("has_liked")),
                    "like_count": raw.get("like_count"),
                    "taken_at": raw.get("taken_at"),
                    "is_pinned": pk in pinned,
                    "_tracking_token": str(
                        raw.get("organic_tracking_token")
                        or raw.get("tracking_token")
                        or ""
                    ),
                }
            )
        return {
            "username": username,
            "recipient_pk": recipient_pk,
            "items": items,
            "more_available": bool(payload.get("more_available")),
            "next_max_id": payload.get("next_max_id"),
        }

    def like_media(self, profile_value: str, media_selector: str) -> dict[str, Any]:
        listing = self.media_list(profile_value, limit=50)
        selector = media_selector.strip()
        item = next(
            (
                candidate
                for candidate in listing["items"]
                if selector
                in {
                    candidate["media_pk"],
                    candidate["media_id"],
                    candidate["code"],
                }
            ),
            None,
        )
        if item is None:
            raise InstagramFailure(
                3,
                "media_not_found",
                f"Media {media_selector!r} was not found in the recent profile feed",
            )
        public_item = {key: value for key, value in item.items() if not key.startswith("_")}
        if item["has_liked"]:
            return {"status": "already_liked", **public_item}
        tracking_token = str(item.get("_tracking_token") or "")
        actor_id = str(self.template.form.get("av") or "")
        csrf = self._cookie_value("csrftoken")
        if not tracking_token or not actor_id or not csrf:
            raise InstagramFailure(
                2,
                "session_tokens_missing",
                "Like request requires fresh media and session tokens",
                "refresh the browser session and retry the media list",
            )
        variables = {
            "input": {
                "actor_id": actor_id,
                "client_mutation_id": "1",
                "container_module": "single_post",
                "media_id": item["media_pk"],
                "tracking_token": tracking_token,
            }
        }
        form = dict(self.template.form)
        form.update(
            {
                "fb_api_caller_class": "RelayModern",
                "fb_api_req_friendly_name": LIKE_FRIENDLY_NAME,
                "server_timestamps": "true",
                "variables": json.dumps(variables, separators=(",", ":")),
                "doc_id": LIKE_DOC_ID,
            }
        )
        headers = {
            name: value
            for name, value in self.template.headers.items()
            if name.lower()
            not in {
                "cookie",
                "content-length",
                "accept-encoding",
                "x-csrftoken",
                "x-fb-friendly-name",
            }
        }
        headers.update(
            {
                "Referer": item["permalink"],
                "X-CSRFToken": csrf,
                "X-FB-Friendly-Name": LIKE_FRIENDLY_NAME,
            }
        )
        try:
            response = self.http.post(GRAPHQL_URL, headers=headers, data=form)
        except httpx.HTTPError as exc:
            raise InstagramFailure(
                5,
                "like_unknown",
                "Like result is unknown; do not retry automatically",
                type(exc).__name__,
            ) from exc
        finally:
            self._persist()
        if response.status_code in {401, 403}:
            raise InstagramFailure(
                2,
                "auth_failed",
                "Instagram rejected the current session",
                status=response.status_code,
            )
        if response.status_code == 429:
            raise InstagramFailure(5, "rate_limited", "Instagram rate-limited the like")
        try:
            payload = _decode_json(response.text)
        except (json.JSONDecodeError, TypeError, ValueError) as exc:
            raise InstagramFailure(
                5,
                "like_unknown",
                "Like response was not valid JSON; do not retry automatically",
                status=response.status_code,
            ) from exc
        media = ((payload.get("data") or {}).get("xig_media_like") or {}).get("media")
        response_id = str(media.get("id") or "") if isinstance(media, dict) else ""
        if (
            response.status_code != 200
            or not isinstance(media, dict)
            or media.get("has_liked") is not True
            or response_id.split("_", 1)[0] != item["media_pk"]
        ):
            errors = payload.get("errors") if isinstance(payload.get("errors"), list) else []
            error_code = errors[0].get("code") if errors and isinstance(errors[0], dict) else None
            raise InstagramFailure(
                5,
                "like_rejected",
                "Instagram did not confirm the like"
                + (f" (code {error_code})" if error_code is not None else ""),
                status=response.status_code,
            )
        return {"status": "liked", **public_item, "server_media_id": response_id}

    def _direct_headers(self) -> dict[str, str]:
        headers = {
            "Accept": "*/*",
            "Referer": "https://www.instagram.com/direct/inbox/",
            "User-Agent": self._header_value("User-Agent"),
            "X-IG-App-ID": self._header_value("X-IG-App-ID"),
            "X-ASBD-ID": self._header_value("X-ASBD-ID"),
        }
        csrf = self._cookie_value("csrftoken")
        if csrf:
            headers["X-CSRFToken"] = csrf
        return {key: value for key, value in headers.items() if value}

    @staticmethod
    def _thread_match_status(
        thread: dict[str, Any], *, username: str, recipient_pk: str
    ) -> str:
        """Return match, different, or unknown without trusting a mutable handle.

        A matching immutable user id is decisive even if a cached username is
        absent or stale.  A handle-only candidate is not enough to identify a
        private thread and makes an otherwise negative scan incomplete.
        """
        if thread.get("is_group") is True:
            return "different"
        users = thread.get("users") if isinstance(thread.get("users"), list) else []
        handle_only_candidate = False
        for user in users:
            if not isinstance(user, dict):
                continue
            user_id = str(user.get("pk") or user.get("pk_id") or user.get("id") or "")
            handle_matches = str(user.get("username") or "").lower() == username.lower()
            if user_id:
                if user_id == recipient_pk:
                    return "match"
                continue
            if handle_matches:
                handle_only_candidate = True
        return "unknown" if handle_only_candidate else "different"

    def _conversation_find_main(
        self, profile: dict[str, Any], *, max_pages: int
    ) -> dict[str, Any]:
        username = str(profile["username"])
        recipient_pk = str(profile["recipient_pk"])
        cursor = None
        pages_scanned = 0
        threads_scanned = 0
        identity_unknown = False
        while pages_scanned < max_pages:
            params = {"limit": "20"}
            if cursor:
                params["cursor"] = cursor
            try:
                response = self.http.get(
                    DIRECT_INBOX_URL,
                    params=params,
                    headers=self._direct_headers(),
                )
            except httpx.HTTPError as exc:
                raise InstagramFailure(
                    5,
                    "network_error",
                    f"Inbox request failed: {type(exc).__name__}",
                ) from exc
            finally:
                self._persist()
            if response.status_code in {401, 403}:
                raise InstagramFailure(
                    2,
                    "auth_failed",
                    "Instagram login is required",
                    status=response.status_code,
                )
            try:
                payload = response.json()
            except ValueError as exc:
                raise InstagramFailure(
                    5,
                    "invalid_response",
                    "Inbox response was not JSON",
                    status=response.status_code,
                ) from exc
            inbox = payload.get("inbox")
            threads = inbox.get("threads") if isinstance(inbox, dict) else None
            if (
                response.status_code != 200
                or payload.get("status") != "ok"
                or not isinstance(threads, list)
            ):
                raise InstagramFailure(
                    5,
                    "inbox_unvalidated",
                    "Instagram did not return a validated inbox page",
                    status=response.status_code,
                )
            pages_scanned += 1
            threads_scanned += len(threads)
            for thread in threads:
                if not isinstance(thread, dict):
                    continue
                match_status = self._thread_match_status(
                    thread, username=username, recipient_pk=recipient_pk
                )
                if match_status == "unknown":
                    identity_unknown = True
                if match_status != "match":
                    continue
                thread_id = str(thread.get("thread_id") or "")
                thread_igid = str(thread.get("thread_v2_id") or "")
                if thread_id and thread_igid:
                    return {
                        "status": "found",
                        "found": True,
                        "scan_complete": True,
                        "username": username,
                        "recipient_pk": recipient_pk,
                        "thread_id": thread_id,
                        "thread_igid": thread_igid,
                        "pending": bool(thread.get("pending")),
                        "folder": "main",
                        "pages_scanned": pages_scanned,
                        "threads_scanned": threads_scanned,
                    }
            if not inbox.get("has_older"):
                if identity_unknown:
                    return {
                        "status": "unknown",
                        "found": False,
                        "scan_complete": False,
                        "username": username,
                        "recipient_pk": recipient_pk,
                        "folder": "main",
                        "pages_scanned": pages_scanned,
                        "threads_scanned": threads_scanned,
                        "reason": "thread_identity_unverified",
                    }
                return {
                    "status": "not_found",
                    "found": False,
                    "scan_complete": True,
                    "username": username,
                    "recipient_pk": recipient_pk,
                    "folder": "main",
                    "pages_scanned": pages_scanned,
                    "threads_scanned": threads_scanned,
                }
            next_cursor = str(inbox.get("oldest_cursor") or "")
            if not next_cursor or next_cursor == cursor:
                return {
                    "status": "unknown",
                    "found": False,
                    "scan_complete": False,
                    "username": username,
                    "recipient_pk": recipient_pk,
                    "folder": "main",
                    "pages_scanned": pages_scanned,
                    "threads_scanned": threads_scanned,
                    "reason": "inbox_cursor_missing",
                }
            cursor = next_cursor
        return {
            "status": "unknown",
            "found": False,
            "scan_complete": False,
            "username": username,
            "recipient_pk": recipient_pk,
            "folder": "main",
            "pages_scanned": pages_scanned,
            "threads_scanned": threads_scanned,
            "reason": "max_pages_reached",
        }

    def _requests_graphql_form(self, *, cursor: str | None = None) -> dict[str, str]:
        variables: dict[str, Any] = {
            "device_id_for_iris_subscription": self._cookie_value("ig_did")
            or "00000000-0000-4000-8000-000000000000",
            "__relay_internal__pv__IGD30DayAgoTimestampMsrelayprovider": str(
                int(time.time() * 1000) - 30 * 24 * 60 * 60 * 1000
            ),
            "__relay_internal__pv__IGDPinnedThreadsRenderEnabledGKrelayprovider": True,
            "__relay_internal__pv__IGDMaxUnreadMessagesCountrelayprovider": 5,
            "__relay_internal__pv__PolarisAIGMAccountLabelEnabledrelayprovider": False,
            "__relay_internal__pv__IGDThreadListActionsEnabledGKrelayprovider": True,
        }
        if cursor:
            variables["after"] = cursor
        browser_form_keys = {
            "av",
            "__d",
            "__user",
            "__a",
            "__req",
            "__hs",
            "dpr",
            "__ccg",
            "__rev",
            "__s",
            "__hsi",
            "__dyn",
            "__csr",
            "__hsdp",
            "__hblp",
            "__sjsp",
            "__comet_req",
            "fb_dtsg",
            "jazoest",
            "lsd",
            "__spin_r",
            "__spin_b",
            "__spin_t",
        }
        form = {
            key: value
            for key, value in self.template.form.items()
            if key in browser_form_keys
        }
        form.update(
            {
                "fb_api_caller_class": "RelayModern",
                "fb_api_req_friendly_name": DIRECT_REQUESTS_FRIENDLY_NAME,
                "server_timestamps": "true",
                "variables": json.dumps(variables, separators=(",", ":")),
                "doc_id": DIRECT_REQUESTS_DOC_ID,
            }
        )
        return form

    def _conversation_find_requests(
        self,
        profile: dict[str, Any],
        *,
        max_pages: int,
        folders: tuple[str, ...] = ("requests", "spam"),
    ) -> dict[str, Any]:
        username = str(profile["username"])
        recipient_pk = str(profile["recipient_pk"])
        cursor = None
        pages_scanned = 0
        threads_scanned = 0
        identity_unknown = False
        while pages_scanned < max_pages:
            headers = self._direct_headers()
            headers.update(
                {
                    "Content-Type": "application/x-www-form-urlencoded",
                    "Referer": "https://www.instagram.com/direct/requests/",
                    "X-FB-Friendly-Name": DIRECT_REQUESTS_FRIENDLY_NAME,
                    "X-FB-LSD": self.template.form.get("lsd", ""),
                }
            )
            try:
                response = self.http.post(
                    GRAPHQL_URL,
                    headers={key: value for key, value in headers.items() if value},
                    data=self._requests_graphql_form(cursor=cursor),
                )
            except httpx.HTTPError as exc:
                raise InstagramFailure(
                    5,
                    "network_error",
                    f"Direct requests scan failed: {type(exc).__name__}",
                ) from exc
            finally:
                self._persist()
            if response.status_code in {401, 403}:
                raise InstagramFailure(
                    2,
                    "auth_failed",
                    "Instagram login is required",
                    status=response.status_code,
                )
            if response.status_code == 429:
                return {
                    "status": "unknown",
                    "found": False,
                    "scan_complete": False,
                    "username": username,
                    "recipient_pk": recipient_pk,
                    "folders_scanned": list(folders),
                    "pages_scanned": pages_scanned,
                    "threads_scanned": threads_scanned,
                    "reason": "requests_scan_rate_limited",
                }
            try:
                payload = _decode_json(response.text)
            except (json.JSONDecodeError, TypeError, ValueError):
                return {
                    "status": "unknown",
                    "found": False,
                    "scan_complete": False,
                    "username": username,
                    "recipient_pk": recipient_pk,
                    "folders_scanned": list(folders),
                    "pages_scanned": pages_scanned,
                    "threads_scanned": threads_scanned,
                    "reason": "requests_invalid_response",
                    "http_status": response.status_code,
                }
            data = payload.get("data") if isinstance(payload.get("data"), dict) else {}
            mailboxes = {
                "requests": data.get("get_slide_mailbox_for_iris_subscription"),
                "spam": data.get("spamMailbox"),
            }
            if response.status_code != 200:
                return {
                    "status": "unknown",
                    "found": False,
                    "scan_complete": False,
                    "username": username,
                    "recipient_pk": recipient_pk,
                    "folders_scanned": list(folders),
                    "pages_scanned": pages_scanned,
                    "threads_scanned": threads_scanned,
                    "reason": "requests_unvalidated",
                    "http_status": response.status_code,
                }
            connections: list[tuple[str, dict[str, Any]]] = []
            invalid_folders = []
            for folder in folders:
                mailbox = mailboxes.get(folder)
                connection = (
                    mailbox.get("threads_by_folder")
                    if isinstance(mailbox, dict)
                    else None
                )
                if (
                    not isinstance(connection, dict)
                    or not isinstance(connection.get("edges"), list)
                    or not isinstance(connection.get("page_info"), dict)
                ):
                    invalid_folders.append(folder)
                    continue
                connections.append((folder, connection))
            pages_scanned += 1
            for folder, connection in connections:
                edges = connection["edges"]
                threads_scanned += len(edges)
                for edge in edges:
                    node = edge.get("node") if isinstance(edge, dict) else None
                    thread = (
                        node.get("as_ig_direct_thread")
                        if isinstance(node, dict)
                        else None
                    )
                    if not isinstance(thread, dict):
                        continue
                    match_status = self._thread_match_status(
                        thread, username=username, recipient_pk=recipient_pk
                    )
                    if match_status == "unknown":
                        identity_unknown = True
                    if match_status != "match":
                        continue
                    thread_id = str(thread.get("thread_id") or "")
                    thread_igid = str(
                        thread.get("thread_fbid") or thread.get("id") or ""
                    )
                    if thread_id and thread_igid:
                        return {
                            "status": "found",
                            "found": True,
                            "scan_complete": True,
                            "username": username,
                            "recipient_pk": recipient_pk,
                            "thread_id": thread_id,
                            "thread_igid": thread_igid,
                            "pending": True,
                            "folder": folder,
                            "folders_scanned": list(folders),
                            "pages_scanned": pages_scanned,
                            "threads_scanned": threads_scanned,
                        }
            if invalid_folders:
                return {
                    "status": "unknown",
                    "found": False,
                    "scan_complete": False,
                    "username": username,
                    "recipient_pk": recipient_pk,
                    "folders_scanned": list(folders),
                    "pages_scanned": pages_scanned,
                    "threads_scanned": threads_scanned,
                    "reason": "direct_folder_unvalidated",
                }
            page_infos = [
                connection.get("page_info")
                for _folder, connection in connections
                if isinstance(connection.get("page_info"), dict)
            ]
            paged = [info for info in page_infos if info.get("has_next_page")]
            if not paged:
                if identity_unknown:
                    return {
                        "status": "unknown",
                        "found": False,
                        "scan_complete": False,
                        "username": username,
                        "recipient_pk": recipient_pk,
                        "folders_scanned": list(folders),
                        "pages_scanned": pages_scanned,
                        "threads_scanned": threads_scanned,
                        "reason": "thread_identity_unverified",
                    }
                return {
                    "status": "not_found",
                    "found": False,
                    "scan_complete": True,
                    "username": username,
                    "recipient_pk": recipient_pk,
                    "folders_scanned": list(folders),
                    "pages_scanned": pages_scanned,
                    "threads_scanned": threads_scanned,
                }
            next_cursors = {
                str(info.get("end_cursor") or "") for info in paged
            } - {""}
            if len(next_cursors) != 1 or cursor in next_cursors:
                return {
                    "status": "unknown",
                    "found": False,
                    "scan_complete": False,
                    "username": username,
                    "recipient_pk": recipient_pk,
                    "folders_scanned": list(folders),
                    "pages_scanned": pages_scanned,
                    "threads_scanned": threads_scanned,
                    "reason": "requests_cursor_ambiguous",
                }
            cursor = next_cursors.pop()
        return {
            "status": "unknown",
            "found": False,
            "scan_complete": False,
            "username": username,
            "recipient_pk": recipient_pk,
            "folders_scanned": list(folders),
            "pages_scanned": pages_scanned,
            "threads_scanned": threads_scanned,
            "reason": "max_pages_reached",
        }

    def conversation_find(
        self, profile_value: str, *, max_pages: int = 25, folders: str = "all"
    ) -> dict[str, Any]:
        if max_pages < 1 or max_pages > 100:
            raise InstagramFailure(6, "input", "max_pages must be between 1 and 100")
        if folders not in {"main", "requests", "spam", "all"}:
            raise InstagramFailure(
                6, "input", "folders must be one of main, requests, spam, or all"
            )
        profile = self.profile(profile_value)
        scans = []
        if folders in {"main", "all"}:
            scans.append(self._conversation_find_main(profile, max_pages=max_pages))
            if scans[-1]["found"]:
                return {**scans[-1], "folders_scanned": ["main"]}
        direct_folders = (
            (("requests", "spam") if folders == "all" else (folders,))
            if folders in {"requests", "spam", "all"}
            else ()
        )
        if direct_folders:
            scans.append(
                self._conversation_find_requests(
                    profile, max_pages=max_pages, folders=direct_folders
                )
            )
            if scans[-1]["found"]:
                return {
                    **scans[-1],
                    "folders_scanned": [
                        folder
                        for scan in scans
                        for folder in scan.get("folders_scanned", [scan.get("folder")])
                        if folder
                    ],
                    "pages_scanned": sum(scan["pages_scanned"] for scan in scans),
                    "threads_scanned": sum(scan["threads_scanned"] for scan in scans),
                }
        incomplete = next((scan for scan in scans if not scan["scan_complete"]), None)
        return {
            "status": "unknown" if incomplete else "not_found",
            "found": False,
            "scan_complete": incomplete is None,
            "username": str(profile["username"]),
            "recipient_pk": str(profile["recipient_pk"]),
            "pages_scanned": sum(scan["pages_scanned"] for scan in scans),
            "threads_scanned": sum(scan["threads_scanned"] for scan in scans),
            "folders_scanned": [
                folder
                for scan in scans
                for folder in scan.get("folders_scanned", [scan.get("folder")])
                if folder
            ],
            **({"reason": incomplete.get("reason")} if incomplete else {}),
        }

    @staticmethod
    def _message_metadata(
        item: dict[str, Any], *, viewer_id: str, recipient_pk: str
    ) -> dict[str, Any]:
        user_id = str(item.get("user_id") or "")
        if item.get("is_sent_by_viewer") is True or user_id == viewer_id:
            sender = "viewer"
        elif user_id == recipient_pk:
            sender = "recipient"
        else:
            sender = "other"
        return {
            "item_id": str(item.get("item_id") or ""),
            "message_id": str(item.get("message_id") or "") or None,
            "client_context": str(item.get("client_context") or "") or None,
            "offline_threading_id": str(
                item.get("offline_threading_id") or ""
            )
            or None,
            "item_type": item.get("item_type"),
            "timestamp": str(item.get("timestamp") or "") or None,
            "sender": sender,
            "has_text": isinstance(item.get("text"), str),
        }

    def messages_inspect(
        self, profile_value: str, *, max_pages: int = 25, folders: str = "all"
    ) -> dict[str, Any]:
        conversation = self.conversation_find(
            profile_value, max_pages=max_pages, folders=folders
        )
        base = {
            "username": conversation["username"],
            "recipient_pk": conversation["recipient_pk"],
            "conversation_found": conversation["found"],
            "inbox_pages_scanned": conversation["pages_scanned"],
            "folders_scanned": conversation.get("folders_scanned", []),
        }
        if not conversation["found"]:
            if conversation["scan_complete"]:
                return {
                    **base,
                    "status": "no_conversation",
                    "viewer_sent_message": False,
                    "scan_complete": True,
                    "history_pages_scanned": 0,
                    "items_scanned": 0,
                }
            return {
                **base,
                "status": "unknown",
                "viewer_sent_message": None,
                "scan_complete": False,
                "history_pages_scanned": 0,
                "items_scanned": 0,
                "reason": conversation.get("reason"),
            }

        thread_id = str(conversation["thread_id"])
        cursor = None
        pages_scanned = 0
        items_scanned = 0
        last_item = None
        while pages_scanned < max_pages:
            params = {"limit": "50"}
            if cursor:
                params["cursor"] = cursor
            try:
                response = self.http.get(
                    DIRECT_THREAD_URL.format(thread_id=thread_id),
                    params=params,
                    headers=self._direct_headers(),
                )
            except httpx.HTTPError as exc:
                raise InstagramFailure(
                    5,
                    "network_error",
                    f"Thread history request failed: {type(exc).__name__}",
                ) from exc
            finally:
                self._persist()
            if response.status_code in {401, 403}:
                raise InstagramFailure(
                    2,
                    "auth_failed",
                    "Instagram login is required",
                    status=response.status_code,
                )
            try:
                payload = response.json()
            except ValueError as exc:
                raise InstagramFailure(
                    5,
                    "invalid_response",
                    "Thread history response was not JSON",
                    status=response.status_code,
                ) from exc
            thread = payload.get("thread")
            items = thread.get("items") if isinstance(thread, dict) else None
            if (
                response.status_code != 200
                or payload.get("status") != "ok"
                or not isinstance(items, list)
                or str(thread.get("thread_id") or "") != thread_id
            ):
                raise InstagramFailure(
                    5,
                    "thread_history_unvalidated",
                    "Instagram did not return validated thread history",
                    status=response.status_code,
                )
            pages_scanned += 1
            viewer_id = str(thread.get("viewer_id") or "")
            for item in items:
                if not isinstance(item, dict):
                    continue
                metadata = self._message_metadata(
                    item,
                    viewer_id=viewer_id,
                    recipient_pk=str(conversation["recipient_pk"]),
                )
                if last_item is None:
                    last_item = metadata
                items_scanned += 1
                if metadata["sender"] == "viewer" and metadata["item_type"] != "action_log":
                    return {
                        **base,
                        "status": "already_contacted",
                        "viewer_sent_message": True,
                        "scan_complete": True,
                        "thread_id": thread_id,
                        "thread_igid": conversation["thread_igid"],
                        "pending": conversation["pending"],
                        "folder": conversation.get("folder"),
                        "history_pages_scanned": pages_scanned,
                        "items_scanned": items_scanned,
                        "last_item": last_item,
                        "last_outgoing_item": metadata,
                    }
            if not thread.get("has_older"):
                return {
                    **base,
                    "status": "no_outgoing_messages",
                    "viewer_sent_message": False,
                    "scan_complete": True,
                    "thread_id": thread_id,
                    "thread_igid": conversation["thread_igid"],
                    "pending": conversation["pending"],
                    "folder": conversation.get("folder"),
                    "history_pages_scanned": pages_scanned,
                    "items_scanned": items_scanned,
                    "last_item": last_item,
                }
            next_cursor = str(thread.get("oldest_cursor") or "")
            if not next_cursor or next_cursor == cursor:
                break
            cursor = next_cursor
        return {
            **base,
            "status": "unknown",
            "viewer_sent_message": None,
            "scan_complete": False,
            "thread_id": thread_id,
            "thread_igid": conversation["thread_igid"],
            "pending": conversation["pending"],
            "folder": conversation.get("folder"),
            "history_pages_scanned": pages_scanned,
            "items_scanned": items_scanned,
            "last_item": last_item,
            "reason": "message_history_incomplete",
        }

    def messages_eligibility(
        self, profile_value: str, *, max_pages: int = 25, folders: str = "all"
    ) -> dict[str, Any]:
        """Return the strongest read-only verdict Instagram makes observable.

        Instagram does not expose a reliable preflight for a first Direct message.
        A missing conversation therefore stays unknown rather than being reported as
        allowed. Existing thread state can still identify a normal send path or an
        invitation that must be accepted before another message is sent.
        """
        relationship = self.relationship_show(profile_value)
        base = {
            "username": relationship["username"],
            "recipient_pk": relationship["recipient_pk"],
            "eligible": None,
            "following": relationship["following"],
            "followed_by": relationship["followed_by"],
            "blocked": relationship["blocked"],
            "restricted": relationship["restricted"],
        }
        if relationship["blocked"]:
            return {
                **base,
                "status": "blocked_by_viewer",
                "eligible": False,
                "conversation_found": None,
                "requires_new_invitation": None,
                "reason": "recipient_is_blocked_by_viewer",
            }

        inspection = self.messages_inspect(
            profile_value, max_pages=max_pages, folders=folders
        )
        base.update(
            {
                "conversation_found": inspection["conversation_found"],
                "scan_complete": inspection["scan_complete"],
                "inbox_pages_scanned": inspection["inbox_pages_scanned"],
                "folders_scanned": inspection.get("folders_scanned", []),
            }
        )
        if not inspection["scan_complete"]:
            return {
                **base,
                "status": "unknown",
                "requires_new_invitation": None,
                "reason": inspection.get("reason") or "conversation_scan_incomplete",
            }
        if not inspection["conversation_found"]:
            return {
                **base,
                "status": "new_invitation_unverified",
                "requires_new_invitation": True,
                "reason": "instagram_exposes_no_read_only_first_message_preflight",
            }

        pending = bool(inspection.get("pending"))
        viewer_sent_message = inspection.get("viewer_sent_message")
        thread_fields = {
            "thread_id": inspection.get("thread_id"),
            "thread_igid": inspection.get("thread_igid"),
            "pending": pending,
            "viewer_sent_message": viewer_sent_message,
            "requires_new_invitation": False,
        }
        if pending and viewer_sent_message is True:
            return {
                **base,
                **thread_fields,
                "status": "awaiting_acceptance",
                "eligible": False,
                "reason": "existing_chat_invitation_is_pending",
            }
        return {
            **base,
            **thread_fields,
            "status": "existing_conversation",
            "eligible": True,
            "reason": "validated_existing_thread",
        }

    def messages_reconcile(
        self,
        profile_value: str,
        *,
        offline_id: str | None = None,
        server_message_id: str | None = None,
        max_pages: int = 25,
    ) -> dict[str, Any]:
        if bool(offline_id) == bool(server_message_id):
            raise InstagramFailure(
                6,
                "input",
                "choose exactly one of offline_id or server_message_id",
            )
        conversation = self.conversation_find(
            profile_value, max_pages=max_pages, folders="all"
        )
        base = {
            "username": conversation["username"],
            "recipient_pk": conversation["recipient_pk"],
            "conversation_found": conversation["found"],
            "folders_scanned": conversation.get("folders_scanned", []),
            "lookup": "offline_id" if offline_id else "server_message_id",
            "retry_safe": False,
        }
        if not conversation["found"]:
            return {
                **base,
                "status": "unknown" if not conversation["scan_complete"] else "not_found",
                "delivery_confirmed": None if not conversation["scan_complete"] else False,
                "scan_complete": conversation["scan_complete"],
                "history_pages_scanned": 0,
                "items_scanned": 0,
                **(
                    {"reason": conversation.get("reason")}
                    if not conversation["scan_complete"]
                    else {"reason": "message_not_observed"}
                ),
            }

        thread_id = str(conversation["thread_id"])
        cursor = None
        pages_scanned = 0
        items_scanned = 0
        while pages_scanned < max_pages:
            params = {"limit": "50"}
            if cursor:
                params["cursor"] = cursor
            try:
                response = self.http.get(
                    DIRECT_THREAD_URL.format(thread_id=thread_id),
                    params=params,
                    headers=self._direct_headers(),
                )
            except httpx.HTTPError as exc:
                raise InstagramFailure(
                    5,
                    "network_error",
                    f"Thread reconciliation failed: {type(exc).__name__}",
                ) from exc
            finally:
                self._persist()
            if response.status_code in {401, 403}:
                raise InstagramFailure(
                    2,
                    "auth_failed",
                    "Instagram login is required",
                    status=response.status_code,
                )
            try:
                payload = response.json()
            except ValueError as exc:
                raise InstagramFailure(
                    5,
                    "invalid_response",
                    "Thread reconciliation response was not JSON",
                    status=response.status_code,
                ) from exc
            thread = payload.get("thread")
            items = thread.get("items") if isinstance(thread, dict) else None
            if (
                response.status_code != 200
                or payload.get("status") != "ok"
                or not isinstance(items, list)
                or str(thread.get("thread_id") or "") != thread_id
            ):
                raise InstagramFailure(
                    5,
                    "thread_history_unvalidated",
                    "Instagram did not return validated reconciliation history",
                    status=response.status_code,
                )
            pages_scanned += 1
            viewer_id = str(thread.get("viewer_id") or "")
            for item in items:
                if not isinstance(item, dict):
                    continue
                items_scanned += 1
                metadata = self._message_metadata(
                    item,
                    viewer_id=viewer_id,
                    recipient_pk=str(conversation["recipient_pk"]),
                )
                if metadata["sender"] != "viewer":
                    continue
                matched = (
                    offline_id
                    in {
                        metadata["client_context"],
                        metadata["offline_threading_id"],
                    }
                    if offline_id
                    else server_message_id
                    in {metadata["message_id"], metadata["item_id"]}
                )
                if matched:
                    return {
                        **base,
                        "status": "delivered",
                        "delivery_confirmed": True,
                        "scan_complete": True,
                        "thread_id": thread_id,
                        "thread_igid": conversation["thread_igid"],
                        "pending": conversation["pending"],
                        "folder": conversation.get("folder"),
                        "history_pages_scanned": pages_scanned,
                        "items_scanned": items_scanned,
                        "matched_item": metadata,
                    }
            if not thread.get("has_older"):
                return {
                    **base,
                    "status": "not_found",
                    "delivery_confirmed": False,
                    "scan_complete": True,
                    "thread_id": thread_id,
                    "thread_igid": conversation["thread_igid"],
                    "history_pages_scanned": pages_scanned,
                    "items_scanned": items_scanned,
                    "reason": "message_not_observed",
                }
            next_cursor = str(thread.get("oldest_cursor") or "")
            if not next_cursor or next_cursor == cursor:
                break
            cursor = next_cursor
        return {
            **base,
            "status": "unknown",
            "delivery_confirmed": None,
            "scan_complete": False,
            "thread_id": thread_id,
            "thread_igid": conversation["thread_igid"],
            "history_pages_scanned": pages_scanned,
            "items_scanned": items_scanned,
            "reason": "message_history_incomplete",
        }

    def resolve_thread(self, profile_value: str) -> RoutingResult:
        profile = self.profile(profile_value)
        username = str(profile["username"])
        recipient_pk = str(profile["recipient_pk"])
        canonical_url = str(profile["profile_url"])
        csrf = self._cookie_value("csrftoken")
        fb_dtsg = self.template.form.get("fb_dtsg", "")
        if not csrf or not fb_dtsg:
            raise InstagramFailure(
                2, "session_tokens_missing", "Session tokens are missing"
            )
        headers = {
            "Accept": "*/*",
            "Content-Type": "application/x-www-form-urlencoded",
            "Origin": "https://www.instagram.com",
            "Referer": canonical_url,
            "User-Agent": self._header_value("User-Agent"),
            "X-Requested-With": "XMLHttpRequest",
            "X-IG-App-ID": self._header_value("X-IG-App-ID"),
            "X-ASBD-ID": self._header_value("X-ASBD-ID"),
            "X-CSRFToken": csrf,
            "X-Instagram-AJAX": self.template.form.get("__rev", ""),
            "X-Web-Session-ID": self.template.form.get("__s", ""),
            "X-IG-WWW-Claim": self._header_value("X-IG-WWW-Claim"),
        }
        data = {
            "recipient_users": json.dumps([recipient_pk], separators=(",", ":")),
            "fb_dtsg": fb_dtsg,
            "jazoest": "2" + str(sum(ord(char) for char in csrf)),
        }
        try:
            response = self.http.post(
                CREATE_THREAD_URL,
                headers={key: value for key, value in headers.items() if value},
                data=data,
            )
        except httpx.HTTPError as exc:
            raise InstagramFailure(
                5, "network_error", f"Thread request failed: {type(exc).__name__}"
            ) from exc
        finally:
            self._persist()
        if response.status_code in {401, 403}:
            raise InstagramFailure(
                2, "auth_failed", "Instagram login is required", status=response.status_code
            )
        try:
            payload = response.json()
        except ValueError as exc:
            raise InstagramFailure(
                5,
                "invalid_response",
                "Thread response was not JSON",
                status=response.status_code,
            ) from exc
        users = payload.get("users") if isinstance(payload.get("users"), list) else []
        recipient_matches = any(
            isinstance(user, dict)
            and str(user.get("pk") or user.get("pk_id") or user.get("id") or "")
            == recipient_pk
            and str(user.get("username") or "").lower() == username.lower()
            for user in users
        )
        thread_igid = str(payload.get("thread_v2_id") or "")
        if (
            response.status_code != 200
            or not recipient_matches
            or not thread_igid
            or payload.get("thread_type") != "private"
        ):
            raise InstagramFailure(
                5,
                "thread_unvalidated",
                "Instagram did not return a validated private thread",
                status=response.status_code,
            )
        return RoutingResult(username, recipient_pk, thread_igid)

    def send_text(
        self, thread_igid: str, text: str, offline_threading_id: str
    ) -> SendResult:
        form = dict(self.template.form)
        try:
            variables = json.loads(form["variables"])
        except (KeyError, json.JSONDecodeError, TypeError) as exc:
            raise InstagramFailure(
                2, "session_invalid", "Stored send template has invalid variables"
            ) from exc
        variables["ig_thread_igid"] = str(thread_igid)
        variables["offline_threading_id"] = str(offline_threading_id)
        variables["text"] = {"sensitive_string_value": text}
        form["variables"] = json.dumps(
            variables, ensure_ascii=False, separators=(",", ":")
        )
        headers = {
            name: value
            for name, value in self.template.headers.items()
            if name.lower()
            not in {"cookie", "content-length", "accept-encoding", "x-csrftoken"}
        }
        csrf = self._cookie_value("csrftoken")
        if not csrf:
            return SendResult(status="auth_failure", error_summary="missing csrftoken")
        headers["X-CSRFToken"] = csrf
        try:
            response = self.http.post(self.template.url, headers=headers, data=form)
        except httpx.HTTPError as exc:
            return SendResult(
                status="unknown",
                error_code=type(exc).__name__,
                error_summary="Transport failed after send began; delivery is unknown",
            )
        finally:
            self._persist()
        return _parse_send_response(response.status_code, response.text)


def _offline_threading_id() -> str:
    return str(int(time.time() * 1000) * (1 << 22) + secrets.randbelow(1 << 22))


def _selected_connections(wanted: str | None) -> list[Connection]:
    reg, _ = _connections_registry()
    if wanted:
        cid, raw = _select_connection(reg, wanted)
        return [_connection_from_entry(cid, raw)]
    return [_connection_from_entry(cid, raw) for cid, raw in reg["connections"].items()]


def cmd_doctor(wanted: str | None) -> None:
    report = _connections_report()
    _doctor_gate(report, wanted)
    results = []
    failures = []
    for conn in _selected_connections(wanted):
        try:
            with InstagramWebClient(conn) as client:
                identity = client.preflight()
            results.append(
                {
                    "connection": conn.id,
                    "ok": True,
                    "username": identity["username"],
                    "session_path": str(conn.session_path),
                }
            )
        except InstagramFailure as exc:
            failures.append(
                {"connection": conn.id, "code": exc.code, "message": exc.message}
            )
    if failures:
        raise InstagramFailure(
            2,
            "doctor_failed",
            "One or more Instagram connections are not ready: "
            + "; ".join(
                f"{item['connection']}: {item['code']}" for item in failures
            ),
            "run `instagram connections`, refresh the affected session, and retry",
        )
    _emit({"ok": True, "connections": results})


def _read_capture_source(args: list[str]) -> str:
    if args == ["--clipboard"]:
        try:
            proc = subprocess.run(
                ["pbpaste"], capture_output=True, text=True, timeout=10, check=False
            )
        except (OSError, subprocess.SubprocessError) as exc:
            raise InstagramFailure(
                6, "clipboard_unavailable", f"Cannot read clipboard: {exc}"
            ) from exc
        if proc.returncode != 0:
            raise InstagramFailure(
                6, "clipboard_unavailable", "pbpaste could not read the clipboard"
            )
        return proc.stdout
    if len(args) != 1:
        raise InstagramFailure(
            6,
            "input",
            "usage: instagram refresh <PATH|-|--clipboard> [--connection ID]",
        )
    if args[0] == "-":
        return sys.stdin.read()
    source = Path(args[0]).expanduser()
    try:
        return source.read_text()
    except OSError as exc:
        raise InstagramFailure(
            6, "input", f"Cannot read captured cURL file: {exc}"
        ) from exc


def cmd_refresh(conn: Connection, args: list[str]) -> None:
    template = _parse_curl(_read_capture_source(args))
    _write_template(template, conn.session_path)
    _emit(
        {
            "refreshed": True,
            "connection": conn.id,
            "session_path": str(conn.session_path),
            "captured_at": template.captured_at,
            "cookies": len(template.cookies),
            "next": f"instagram doctor --connection {conn.id}",
        }
    )


def _message_text(args: list[str]) -> tuple[str, list[str]]:
    values: list[tuple[str, str]] = []
    remaining: list[str] = []
    index = 0
    while index < len(args):
        token = args[index]
        if token in {"--text", "--text-file"}:
            if index + 1 >= len(args):
                raise InstagramFailure(6, "input", f"{token} needs a value")
            values.append((token, args[index + 1]))
            index += 2
        elif token == "--stdin":
            values.append((token, ""))
            index += 1
        else:
            remaining.append(token)
            index += 1
    if len(values) != 1:
        raise InstagramFailure(
            6, "input", "choose exactly one of --text, --text-file, or --stdin"
        )
    kind, value = values[0]
    if kind == "--text":
        text = value
    elif kind == "--text-file":
        try:
            text = Path(value).expanduser().read_text()
        except OSError as exc:
            raise InstagramFailure(6, "input", f"Cannot read message file: {exc}") from exc
    else:
        text = sys.stdin.read()
    text = text.strip()
    if not text:
        raise InstagramFailure(6, "input", "Message text must not be empty")
    if len(text) > 1000:
        raise InstagramFailure(6, "input", "Message text exceeds 1000 characters")
    return text, remaining


def _extract_connection(argv: list[str]) -> tuple[str | None, list[str]]:
    wanted = None
    cleaned = []
    index = 0
    while index < len(argv):
        token = argv[index]
        if token == "--connection":
            if index + 1 >= len(argv):
                raise InstagramFailure(6, "input", "--connection needs a value")
            wanted = argv[index + 1]
            index += 2
        elif token.startswith("--connection="):
            wanted = token.split("=", 1)[1]
            index += 1
        else:
            cleaned.append(token)
            index += 1
    return wanted, cleaned


def _media_list_options(args: list[str]) -> tuple[int, str | None]:
    limit = 12
    max_id = None
    index = 0
    while index < len(args):
        token = args[index]
        if token in {"--limit", "--max-id"}:
            if index + 1 >= len(args):
                raise InstagramFailure(6, "input", f"{token} needs a value")
            value = args[index + 1]
            if token == "--limit":
                try:
                    limit = int(value)
                except ValueError as exc:
                    raise InstagramFailure(6, "input", "--limit must be an integer") from exc
            else:
                max_id = value
            index += 2
            continue
        raise InstagramFailure(6, "input", f"Unexpected media list argument: {token}")
    if limit < 1 or limit > 50:
        raise InstagramFailure(6, "input", "--limit must be between 1 and 50")
    return limit, max_id


def _conversation_options(args: list[str]) -> tuple[int, str]:
    max_pages = 25
    folders = "all"
    index = 0
    while index < len(args):
        token = args[index]
        if token not in {"--max-pages", "--folders"} or index + 1 >= len(args):
            raise InstagramFailure(
                6, "input", "Expected --max-pages N and/or --folders main|requests|spam|all"
            )
        value = args[index + 1]
        if token == "--max-pages":
            try:
                max_pages = int(value)
            except ValueError as exc:
                raise InstagramFailure(
                    6, "input", "--max-pages must be an integer"
                ) from exc
        else:
            folders = value
        index += 2
    if max_pages < 1 or max_pages > 100:
        raise InstagramFailure(6, "input", "--max-pages must be between 1 and 100")
    if folders not in {"main", "requests", "spam", "all"}:
        raise InstagramFailure(
            6, "input", "--folders must be one of main, requests, spam, or all"
        )
    return max_pages, folders


def _reconcile_options(args: list[str]) -> tuple[str | None, str | None, int]:
    offline_id = None
    server_message_id = None
    max_pages = 25
    index = 0
    while index < len(args):
        token = args[index]
        if token not in {"--offline-id", "--server-message-id", "--max-pages"}:
            raise InstagramFailure(6, "input", f"Unexpected reconcile argument: {token}")
        if index + 1 >= len(args):
            raise InstagramFailure(6, "input", f"{token} needs a value")
        value = args[index + 1]
        if token == "--offline-id":
            offline_id = value
        elif token == "--server-message-id":
            server_message_id = value
        else:
            try:
                max_pages = int(value)
            except ValueError as exc:
                raise InstagramFailure(
                    6, "input", "--max-pages must be an integer"
                ) from exc
        index += 2
    if bool(offline_id) == bool(server_message_id):
        raise InstagramFailure(
            6,
            "input",
            "choose exactly one of --offline-id or --server-message-id",
        )
    if max_pages < 1 or max_pages > 100:
        raise InstagramFailure(6, "input", "--max-pages must be between 1 and 100")
    return offline_id, server_message_id, max_pages


def _raise_send_failure(
    result: SendResult, *, username: str | None = None, offline_id: str | None = None
) -> None:
    if result.status == "auth_failure":
        raise InstagramFailure(
            2,
            "auth_failed",
            "Instagram rejected the current session",
            "refresh the browser session and run doctor",
        )
    if result.status == "awaiting_acceptance":
        raise InstagramFailure(
            5,
            "awaiting_acceptance",
            "The recipient must accept the chat invitation before more messages",
        )
    if result.status == "rate_limited":
        raise InstagramFailure(5, "rate_limited", "Instagram rate-limited the send")
    if result.status == "unknown":
        hint = None
        if username and offline_id:
            hint = (
                f"run `instagram messages reconcile {username} "
                f"--offline-id {offline_id}` before any manual retry"
            )
        raise InstagramFailure(
            5,
            "delivery_unknown",
            "Delivery could not be confirmed; do not retry automatically",
            hint,
        )
    raise InstagramFailure(
        5,
        result.status,
        result.error_summary or "Instagram rejected the message",
    )


def main() -> None:
    try:
        wanted, argv = _extract_connection(sys.argv[1:])
        sys.argv = [sys.argv[0], *argv]
        _gate()
        _contract(argv)
        if argv and argv[0] == "help":
            _emit(HELP)
            return
        if argv == ["doctor"]:
            cmd_doctor(wanted)
            return
        conn = _connection(wanted)
        if argv == ["whoami"]:
            with InstagramWebClient(conn) as client:
                identity = client.preflight()
            _emit({"connection": conn.id, **identity})
            return
        if argv and argv[0] == "refresh":
            cmd_refresh(conn, argv[1:])
            return
        if len(argv) == 3 and argv[:2] == ["profile", "show"]:
            with InstagramWebClient(conn) as client:
                profile = client.profile(argv[2])
            _emit({"connection": conn.id, **profile})
            return
        if len(argv) == 3 and argv[:2] == ["relationship", "show"]:
            with InstagramWebClient(conn) as client:
                relationship = client.relationship_show(argv[2])
            _emit({"connection": conn.id, **relationship})
            return
        if len(argv) == 3 and argv[:2] == ["relationship", "follow"]:
            _write_gate(conn.id, conn.allow_write, "relationship.follow")
            with InstagramWebClient(conn) as client:
                result = client.follow(argv[2])
            _emit({"connection": conn.id, **result})
            return
        if len(argv) >= 3 and argv[:2] == ["media", "list"]:
            limit, max_id = _media_list_options(argv[3:])
            with InstagramWebClient(conn) as client:
                listing = client.media_list(argv[2], limit=limit, max_id=max_id)
            listing["items"] = [
                {key: value for key, value in item.items() if not key.startswith("_")}
                for item in listing["items"]
            ]
            _emit({"connection": conn.id, **listing})
            return
        if len(argv) == 4 and argv[:2] == ["media", "like"]:
            _write_gate(conn.id, conn.allow_write, "media.like")
            with InstagramWebClient(conn) as client:
                result = client.like_media(argv[2], argv[3])
            _emit({"connection": conn.id, **result})
            return
        if len(argv) >= 3 and argv[:2] == ["conversations", "find"]:
            max_pages, folders = _conversation_options(argv[3:])
            with InstagramWebClient(conn) as client:
                result = client.conversation_find(
                    argv[2], max_pages=max_pages, folders=folders
                )
            _emit({"connection": conn.id, **result})
            return
        if len(argv) >= 3 and argv[:2] == ["messages", "inspect"]:
            max_pages, folders = _conversation_options(argv[3:])
            with InstagramWebClient(conn) as client:
                result = client.messages_inspect(
                    argv[2], max_pages=max_pages, folders=folders
                )
            _emit({"connection": conn.id, **result})
            return
        if len(argv) >= 3 and argv[:2] == ["messages", "eligibility"]:
            max_pages, folders = _conversation_options(argv[3:])
            with InstagramWebClient(conn) as client:
                result = client.messages_eligibility(
                    argv[2], max_pages=max_pages, folders=folders
                )
            _emit({"connection": conn.id, **result})
            return
        if len(argv) >= 3 and argv[:2] == ["messages", "reconcile"]:
            offline_id, server_message_id, max_pages = _reconcile_options(argv[3:])
            with InstagramWebClient(conn) as client:
                result = client.messages_reconcile(
                    argv[2],
                    offline_id=offline_id,
                    server_message_id=server_message_id,
                    max_pages=max_pages,
                )
            _emit({"connection": conn.id, **result})
            return
        if len(argv) == 3 and argv[:2] == ["conversations", "resolve"]:
            _write_gate(conn.id, conn.allow_write, "conversations.resolve")
            with InstagramWebClient(conn) as client:
                routing = client.resolve_thread(argv[2])
            _emit({"connection": conn.id, **asdict(routing)})
            return
        if len(argv) >= 3 and argv[:2] == ["messages", "send"]:
            text, remaining = _message_text(argv[3:])
            if remaining:
                raise InstagramFailure(
                    6,
                    "input",
                    "Unexpected messages send arguments: " + " ".join(remaining),
                )
            _write_gate(conn.id, conn.allow_write, "messages.send")
            offline_id = _offline_threading_id()
            with InstagramWebClient(conn) as client:
                routing = client.resolve_thread(argv[2])
                result = client.send_text(routing.thread_igid, text, offline_id)
            if result.status != "sent" or not result.server_message_id:
                _raise_send_failure(
                    result, username=routing.username, offline_id=offline_id
                )
            _emit(
                {
                    "status": "sent",
                    "connection": conn.id,
                    "username": routing.username,
                    "recipient_pk": routing.recipient_pk,
                    "thread_igid": routing.thread_igid,
                    "offline_threading_id": offline_id,
                    "server_message_id": result.server_message_id,
                    "timestamp_ms": result.timestamp_ms,
                }
            )
            return
        raise InstagramFailure(
            6, "input", "unknown or incomplete command", f"run `{NAME} help`"
        )
    except InstagramFailure as exc:
        _die(exc.exit_code, exc.code, exc.message, exc.hint, exc.status)


if __name__ == "__main__":
    main()
