# ── the call record's table ─────────────────────────────────────────────────

from capabilities_contract.db import Step  # noqa: E402  (bound with the tiers above)

TABLES_MAJOR, TABLES_MINOR = 1, 0
TABLE_STEPS = [
    # 1.0: one row per call, written when it ends. A row is the agent's own and goes with
    # it (ON DELETE CASCADE): its calls are nobody else's record.
    Step("0001-calls", """
    CREATE TABLE lkagent_calls (
        id                  uuid PRIMARY KEY DEFAULT gen_random_uuid(),
        agent_id            text NOT NULL CHECK (agent_id <> '')
                            REFERENCES agents (id) ON DELETE CASCADE,
        call_id             text NOT NULL CHECK (call_id <> ''),
        direction           text NOT NULL CHECK (direction IN ('inbound', 'outbound')),
        from_number         text,
        caller_name         text,
        to_number           text,
        started_at          timestamptz,
        ended_at            timestamptz,
        duration_seconds    numeric CHECK (duration_seconds >= 0),
        status              text NOT NULL
                            CHECK (status IN ('completed', 'no_answer', 'failed')),
        ended_by            text
                            CHECK (ended_by IN ('agent', 'user', 'silence', 'duration',
                                                'no_answer')),
        failure_reason      text,
        transcript          jsonb NOT NULL DEFAULT '[]'::jsonb
                            CHECK (jsonb_typeof(transcript) = 'array'),
        outcome             text,
        tags                text[],
        backend_session_id  text,
        task                text,
        scheduled_at        timestamptz,
        recording_url       text,
        body                jsonb NOT NULL CHECK (jsonb_typeof(body) = 'object'),
        CONSTRAINT lkagent_calls_call_key UNIQUE (agent_id, call_id)
    );
    CREATE INDEX lkagent_calls_ended ON lkagent_calls (agent_id, ended_at DESC);
    COMMENT ON TABLE lkagent_calls IS
        'One row per call of an agent''s phone line, written by the lkagent worker when the call ends, from callva-livekit''s call.ended body.';
    COMMENT ON COLUMN lkagent_calls.agent_id IS
        'The agent whose line took or placed the call.';
    COMMENT ON COLUMN lkagent_calls.call_id IS
        'LiveKit''s call id as callva-livekit reports it (call.id), unique per agent.';
    COMMENT ON COLUMN lkagent_calls.from_number IS
        'The calling number: the caller''s on an inbound call, the line''s own on an outbound one.';
    COMMENT ON COLUMN lkagent_calls.caller_name IS
        'The calling party''s name where the SIP participant carries one.';
    COMMENT ON COLUMN lkagent_calls.to_number IS
        'The called number: the line''s own on an inbound call, the person''s on an outbound one.';
    COMMENT ON COLUMN lkagent_calls.started_at IS
        'When someone was on the call; for a call that never began, when it was placed or arrived.';
    COMMENT ON COLUMN lkagent_calls.duration_seconds IS
        'From started_at to ended_at, in seconds; null for a call that never began.';
    COMMENT ON COLUMN lkagent_calls.status IS
        'completed, no_answer (nobody took it: unanswered, rejected or cancelled), or failed.';
    COMMENT ON COLUMN lkagent_calls.ended_by IS
        'Who decided the call was over: agent, user, silence, duration or no_answer; null where nothing claimed it.';
    COMMENT ON COLUMN lkagent_calls.failure_reason IS
        'Why the call never began: not answered, a carrier refusal, or a number the line takes no call on.';
    COMMENT ON COLUMN lkagent_calls.transcript IS
        'Both sides in the order they spoke, [{role, text, at}], role user (the person) or assistant (the voice), at ISO 8601 UTC, from LiveKit''s session report.';
    COMMENT ON COLUMN lkagent_calls.outcome IS
        'The session''s outcome tag, where one was set.';
    COMMENT ON COLUMN lkagent_calls.tags IS
        'The session''s tags, where any were set.';
    COMMENT ON COLUMN lkagent_calls.backend_session_id IS
        'The harness session (claude or codex) the call''s backend ran in.';
    COMMENT ON COLUMN lkagent_calls.task IS
        'The task an outbound call was placed with (`lkagent call --task`).';
    COMMENT ON COLUMN lkagent_calls.scheduled_at IS
        'When a scheduled call was due; null until calls are scheduled.';
    COMMENT ON COLUMN lkagent_calls.recording_url IS
        'Where the call''s recording is; null until recordings are kept.';
    COMMENT ON COLUMN lkagent_calls.body IS
        'The whole call.ended body, the same body the webhook gets.';
    """, core=(4, 0)),
]


def _tables():
    """The steps and version of the lkagent_* tables, for the contract's `migrate`."""
    return TABLE_STEPS, TABLES_MAJOR, TABLES_MINOR


# ── settings and connection ─────────────────────────────────────────────────

def _line_module():
    """The service's own logic (service/line.py), free of LiveKit sessions."""
    service = str(_BUNDLE / "service")
    if service not in sys.path:
        sys.path.insert(0, service)
    import line  # noqa: PLC0415

    return line


def _settings_check(scope: str, document: dict) -> list[str]:
    """What the line's own reader finds wrong in a settings document about to be written."""
    if not isinstance(document, dict):
        return ["the settings document is an object"]
    return _line_module().numbers_problems(document.get("numbers"))


def _line_settings() -> dict:
    documents = {}
    for home in _settings_homes():
        _, document, error = _settings_read(home)
        if error:
            _die(6, "settings_unreadable", error)
        documents[home["scope"]] = document or {}
    return {decl["key"]: _settings_value(decl, documents)[0] for decl in SETTINGS["keys"]}


def _connection(wanted: str | None) -> tuple[str, dict]:
    reg, _ = _connections_registry()
    if reg is None:
        _die(6, "connections_required", "the line has no LiveKit connection",
             f"add one: {NAME} connection add <id> --stdin <<< "
             "'{\"url\": \"wss://...\", \"api_key_env\": \"<key>\", \"secret_env\": \"<secret>\"}'")
    cid, entry = _select_connection(reg, wanted)
    return cid, dict(entry or {})


def _resolved(entry: dict, field: str) -> str | None:
    name = entry.get(field)
    return _resolve_env_key(name)[0] if name else None


def _livekit_env(cid: str, entry: dict) -> tuple[dict, list]:
    """LIVEKIT_* for the worker and the API client, and what is missing."""
    env, missing = {}, []
    if entry.get("url"):
        env["LIVEKIT_URL"] = entry["url"]
    else:
        missing.append("url")
    for field, var in (("api_key_env", "LIVEKIT_API_KEY"), ("secret_env", "LIVEKIT_API_SECRET")):
        value = _resolved(entry, field)
        if value:
            env[var] = value
        else:
            missing.append(field)
    return env, missing


def _agent_name(cid: str, settings: dict) -> str:
    """The dispatch name the worker registers under: the setting, else lkagent-<connection>."""
    named = settings.get("agent_name")
    return (named.strip() if isinstance(named, str) else "") or f"{NAME}-{cid}"


def _openai_key() -> tuple[str | None, str | None, Path | str | None]:
    """OPENAI_API_KEY through the credential cascade: the agent's vault first, then the
    project's env files, the machine's shared.env and credentials.env, the environment."""
    return _resolve_env_key("OPENAI_API_KEY")


def _state_dir() -> Path:
    root = _project_root()
    slug = (root.name if root else "no-project")
    return _STATE_HOME / "capabilities" / "projects" / slug / NAME


def _connections_report() -> dict:
    """Every connection, every field and the OpenAI key, where each resolves from, secrets
    masked. Local: settings are files, and no system a connection names is asked."""
    reg, _ = _connections_registry()
    conns = reg["connections"]
    try:
        settings = _line_settings()
    except SystemExit:
        settings = {}
    report: dict = {"default": reg.get("default") or
                    (next(iter(conns)) if len(conns) == 1 else None), "connections": {}}
    for cid, entry in conns.items():
        entry = entry if isinstance(entry, dict) else {}
        keys = []
        for field in CONN_FIELDS:
            key, secret = field["key"], bool(field.get("secret"))
            required = bool(field.get("required"))
            if secret:
                name = entry.get(key)
                value, tier, source = _resolve_env_key(name) if name else (None, None, None)
                keys.append(_key_report(name or key, True, required, value, tier, source))
            else:
                value = entry.get(key)
                keys.append(_key_report(key, False, required, value,
                                        "connection" if value else None, None))
        for spec in CRED_KEYS:
            value, tier, source = _resolve_env_key(spec["key"])
            keys.append(_key_report(spec["key"], True, bool(spec.get("required")), value,
                                    tier, source))
        report["connections"][cid] = {
            "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT)),
            "agent_name": _agent_name(cid, settings), "keys": keys}
    return report


def _cmd_connections() -> None:
    _emit(_connections_report())


def _pid_file() -> Path:
    return _state_dir() / "worker.pid"


# ── what LiveKit routes to the line ─────────────────────────────────────────

LIVEKIT_API = None
"""Makes the LiveKit API client from the connection's environment; tests put a fake here."""


def _livekit_api(env: dict):
    if LIVEKIT_API is not None:
        return LIVEKIT_API(env)
    from livekit import api

    return api.LiveKitAPI(env["LIVEKIT_URL"], env["LIVEKIT_API_KEY"], env["LIVEKIT_API_SECRET"])


async def _sip_read(lk) -> tuple[list, list]:
    """The project's SIP dispatch rules and inbound trunks, as plain objects, from LiveKit's
    SIP service (livekit-api: SipService.list_dispatch_rule, list_inbound_trunk)."""
    from google.protobuf.json_format import MessageToDict
    from livekit import api

    rules = await lk.sip.list_dispatch_rule(api.ListSIPDispatchRuleRequest())
    trunks = await lk.sip.list_inbound_trunk(api.ListSIPInboundTrunkRequest())

    def plain(message) -> dict:
        return MessageToDict(message, preserving_proto_field_name=True)

    return [plain(r) for r in rules.items], [plain(t) for t in trunks.items]


def _routing(rules: list, trunks: list, agent_name: str) -> dict:
    """The dispatch rules that route calls to `agent_name` - those whose room configuration
    dispatches it - and the phone numbers they route: a rule's own numbers where it names
    any, else those of the inbound trunks it applies to (every inbound trunk where it
    names none)."""
    numbers_of = {t.get("sip_trunk_id"): list(t.get("numbers") or []) for t in trunks}
    routed, numbers = [], set()
    for rule in rules:
        agents = ((rule.get("room_config") or {}).get("agents")) or []
        if not any((a or {}).get("agent_name") == agent_name for a in agents):
            continue
        trunk_ids = list(rule.get("trunk_ids") or [])
        reach = list(rule.get("numbers") or []) or [
            n for tid in (trunk_ids or list(numbers_of)) for n in numbers_of.get(tid, [])]
        routed.append({"id": rule.get("sip_dispatch_rule_id"), "name": rule.get("name") or None,
                       "kind": next(iter(rule.get("rule") or {}), None),
                       "trunk_ids": trunk_ids, "numbers": sorted(set(reach))})
        numbers.update(reach)
    return {"agent_name": agent_name, "rules": routed, "numbers": sorted(numbers),
            "rules_read": len(rules), "inbound_trunks_read": len(trunks)}


async def _sip_check(lk, agent_name: str) -> tuple[dict, list[str]]:
    """What LiveKit routes to the line, and the warnings it raises: none routed, or no SIP
    service that answers."""
    try:
        rules, trunks = await _sip_read(lk)
    except Exception as exc:
        error = f"{type(exc).__name__}: {str(exc)[:300]}"
        return ({"ok": False, "agent_name": agent_name, "error": error},
                [f"LiveKit's SIP service did not answer ({error}); no call can reach the line "
                 "until the server has SIP"])
    found = {"ok": True, **_routing(rules, trunks, agent_name)}
    warnings = []
    if not found["rules"]:
        warnings.append(f"no SIP dispatch rule routes to {agent_name}, so no inbound call "
                        f"reaches the line; `{NAME} guide twilio-number` sets one up")
    return found, warnings


# ── inventory ───────────────────────────────────────────────────────────────

def _inventory(network: bool) -> dict:
    """The worker's state and the line's numbers, from this machine; under --network the
    dispatch rules and phone numbers LiveKit routes to the line."""
    pid, state = None, "stopped"
    with __import__("contextlib").suppress(Exception):
        pid = int(_pid_file().read_text().strip())
        os.kill(pid, 0)
        state = "running"
    service = {"state": state, **({"detail": f"pid {pid}"} if state == "running" else {})}
    metrics, items, deferred = [], [], []
    try:
        settings = _line_settings()
    except SystemExit:
        settings = {}
        deferred.append({"label": "numbers", "note": "the line's settings could not be read"})
    numbers = [n for n in (settings.get("numbers") or []) if isinstance(n, dict)]
    metrics.append({"label": "numbers", "value": len(numbers)})
    for entry in numbers:
        allowed = entry.get("allowed_capabilities") or []
        items.append({"group": "numbers", "name": str(entry.get("number")),
                      "state": "read-only" if entry.get("read_only") is True else "read-write",
                      "detail": ("every capability" if "*" in allowed
                                 else ", ".join(allowed) or "no capability")})
    if not network:
        deferred.append({"label": "dispatch rules",
                         "note": "the SIP dispatch rules routing to the line and the phone "
                                 "numbers they route, read from LiveKit with --network"})
        return {"metrics": metrics, "items": items, "deferred": deferred, "service": service}
    try:
        cid, entry = _connection(None)
    except SystemExit:
        deferred.append({"label": "dispatch rules", "note": "no single LiveKit connection to read"})
        return {"metrics": metrics, "items": items, "deferred": deferred, "service": service}
    env, missing = _livekit_env(cid, entry)
    if missing:
        deferred.append({"label": "dispatch rules",
                         "note": f"the connection lacks {', '.join(missing)}"})
        return {"metrics": metrics, "items": items, "deferred": deferred, "service": service}
    import asyncio

    async def read():
        async with _livekit_api(env) as lk:
            return await _sip_check(lk, _agent_name(cid, settings))

    try:
        found, _warnings = asyncio.run(read())
    except Exception as exc:
        found = {"ok": False, "error": f"{type(exc).__name__}: {str(exc)[:300]}"}
    if not found.get("ok"):
        deferred.append({"label": "dispatch rules", "note": found.get("error")})
        return {"metrics": metrics, "items": items, "deferred": deferred, "service": service}
    metrics += [{"label": "dispatch rules", "value": len(found["rules"]),
                 "note": f"routing to {found['agent_name']}"},
                {"label": "phone numbers routed", "value": len(found["numbers"])}]
    for rule in found["rules"]:
        items.append({"group": "dispatch rules", "name": rule["name"] or rule["id"],
                      "state": "routes", "detail": ", ".join(rule["numbers"]) or "any number",
                      "attributes": [{"label": "id", "value": rule["id"]},
                                     {"label": "kind", "value": rule["kind"]},
                                     {"label": "trunks",
                                      "value": ", ".join(rule["trunk_ids"]) or "every inbound"}]})
    configured = {_line_module().digits(n.get("number")) for n in numbers}
    for number in found["numbers"]:
        items.append({"group": "phone numbers", "name": number,
                      "state": "configured" if _line_module().digits(number) in configured
                      else "not configured",
                      "detail": f"routed to {found['agent_name']}"})
    return {"metrics": metrics, "items": items, "deferred": deferred, "service": service}


# ── doctor ──────────────────────────────────────────────────────────────────

def cmd_doctor(wanted: str | None, offline: bool) -> None:
    report: dict = {"ok": True, "checks": {}, "warnings": []}

    def check(name: str, ok: bool, **detail) -> None:
        report["checks"][name] = {"ok": ok, **detail}
        if not ok:
            report["ok"] = False

    _doctor_gate(_connections_report(), wanted)
    settings = _line_settings()
    reg, _ = _connections_registry()
    entry, cid = None, None
    if reg is None:
        check("connection", False, error="no LiveKit connection",
              hint=f"{NAME} connection add <id> --stdin")
    else:
        cid, entry = _select_connection(reg, wanted)
        entry = dict(entry or {})
        env, missing = _livekit_env(cid, entry)
        check("connection", not missing, id=cid, url=entry.get("url"), missing=missing,
              agent_name=_agent_name(cid, settings),
              outbound_trunk=bool(settings.get("outbound_trunk")))
    value, tier, source = _openai_key()
    check("openai_key", bool(value), key="OPENAI_API_KEY", tier=tier,
          source=str(source) if source else None)
    del value
    try:
        from callva import harness_runner as hr

        profile = hr.Profile.from_dict(_line_module().backend_profile(settings))
        probe_ = hr.probe(profile.harness)
        check("backend", bool(probe_.found), harness=profile.harness, model=profile.model,
              effort=profile.effort, version=probe_.version, error=probe_.error)
    except Exception as exc:
        check("backend", False, error=f"{type(exc).__name__}: {exc}")
    numbers = [n for n in (settings.get("numbers") or []) if isinstance(n, dict)]
    check("line", True, numbers=[{"number": n.get("number"),
                                  "allowed_capabilities": n.get("allowed_capabilities") or [],
                                  "read_only": n.get("read_only") is True} for n in numbers],
          recording=settings.get("recording") is True, voice=settings.get("voice"),
          agent_speaks_first=settings.get("agent_speaks_first"),
          greeting_type=settings.get("greeting_type"),
          max_duration_seconds=settings.get("max_duration_seconds"),
          liveness=bool(settings.get("user_silence_timeout_seconds")
                        and settings.get("max_prompt_attempts")),
          webhook=bool(settings.get("webhook_url")))
    if not numbers:
        report["warnings"].append(f"the line has no numbers, so it takes no call; `{NAME} help "
                                  "settings` shows how to add one")
    if not offline and entry is not None and report["checks"]["connection"]["ok"]:
        import asyncio

        async def probe():
            from livekit import api

            env, _ = _livekit_env(cid, entry)
            async with _livekit_api(env) as lk:
                rooms = await lk.room.list_rooms(api.ListRoomsRequest())
                sip = await _sip_check(lk, _agent_name(cid, settings))
                return len(rooms.rooms), sip

        try:
            rooms, (sip, warnings) = asyncio.run(probe())
            check("livekit", True, rooms=rooms)
            report["checks"]["sip"] = sip
            report["warnings"] += warnings
        except Exception as exc:
            check("livekit", False, error=f"{type(exc).__name__}: {str(exc)[:300]}")
    _emit(report)
    if not report["ok"]:
        sys.exit(2)


# ── call ────────────────────────────────────────────────────────────────────

def _caller_number(numbers: list, wanted: str | None) -> dict:
    """The line's number an outgoing call is placed from: the one --from names, else the
    only one configured; exit 6 where none is configured, --from names none of them, or
    several are configured and none is named."""
    line = _line_module()
    configured = [n for n in (numbers or []) if isinstance(n, dict) and n.get("number")]
    if not configured:
        _die(6, "no_number", "the line has no numbers to call from",
             f"add one to the `numbers` setting: `{NAME} help settings`")
    if wanted:
        entry = line.number_entry(configured, wanted)
        if entry is None:
            _die(6, "number_not_configured", f"{wanted} is not one of the line's numbers",
                 "--from takes one of: " + ", ".join(str(n["number"]) for n in configured))
        return entry
    if len(configured) > 1:
        _die(6, "ambiguous_number",
             f"the line has {len(configured)} numbers and the call names none",
             "pass --from <number>, one of: "
             + ", ".join(str(n["number"]) for n in configured))
    return configured[0]


def _outbound_requests(*, agent_name: str, room: str, config: dict, number: str,
                       caller: str, trunk: str):
    """The dispatch that sends the worker into the call's room, with callva-livekit's
    envelope - the direction, both numbers and the call's configuration - and the SIP
    participant that dials `number` from the line's number `caller`."""
    from livekit import api

    metadata = json.dumps({"callva": {"direction": "outbound", "to": number, "from": caller,
                                      "config": config}}, ensure_ascii=False)
    dispatch = api.CreateAgentDispatchRequest(agent_name=agent_name, room=room,
                                              metadata=metadata)
    dial = api.CreateSIPParticipantRequest(
        room_name=room, sip_trunk_id=trunk, sip_call_to=number, sip_number=caller,
        participant_identity=f"sip_{number.strip().lstrip('+')}",
        wait_until_answered=False)
    return dispatch, dial


def cmd_call(wanted: str | None, number: str, task: str | None, caller: str | None) -> None:
    cid, entry = _connection(wanted)
    _write_gate(cid, bool(entry.get("allow_write", WRITE_DEFAULT)), "call")
    if not number.strip().lstrip("+").isdigit():
        _die(6, "bad_number", f"{number!r} is not a phone number", "give it as +<digits>")
    settings = _line_settings()
    line_number = _caller_number(settings.get("numbers") or [], caller)["number"]
    config_file = _state_dir() / "call-config.json"
    try:
        config = json.loads(config_file.read_text())
    except (OSError, ValueError):
        _die(6, "worker_not_prepared", "the line's call configuration is not written",
             f"start the worker first: {NAME} service run")
    variables = {"number": number}
    if task and task.strip():
        variables["task"] = task.strip()
    config.setdefault("agent", {}).setdefault("prompt_variables", {}).update(variables)
    trunk = (settings.get("outbound_trunk") or "").strip()
    if not trunk:
        _die(6, "no_outbound_trunk", "the line names no outbound SIP trunk",
             f"create an outbound trunk in LiveKit and `{NAME} settings set outbound_trunk "
             "ST_<id>`")
    env, missing = _livekit_env(cid, entry)
    if missing:
        _die(2, "missing_credentials", f"the connection lacks {', '.join(missing)}")
    import asyncio
    import uuid

    room = f"{NAME}-out-{uuid.uuid4().hex[:12]}"
    agent_name = _agent_name(cid, settings)
    dispatch_request, dial_request = _outbound_requests(
        agent_name=agent_name, room=room, config=config, number=number, caller=line_number,
        trunk=trunk)

    async def dispatch():
        async with _livekit_api(env) as lk:
            made = await lk.agent_dispatch.create_dispatch(dispatch_request)
            # The dial is the dispatcher's; the worker waits for the pickup.
            await lk.sip.create_sip_participant(dial_request)
            return made

    try:
        made = asyncio.run(dispatch())
    except Exception as exc:
        _die(5, "dispatch_failed", f"{type(exc).__name__}: {str(exc)[:300]}")
    _emit({"room": room, "dispatch_id": made.id, "agent_name": agent_name, "number": number,
           "from": line_number})


# ── service ─────────────────────────────────────────────────────────────────

def _calls_store(agent_id: str | None, migrate: bool) -> dict:
    """Whether finished calls are recorded here: a store resolves for the project and the
    project has an agent id. With `migrate`, lkagent_calls is brought up to date first."""
    if not agent_id:
        return {"recorded": False, "reason": "the project has no agent id "
                                             "(`capabilities init` binds one)"}
    try:
        from capabilities_contract import db
    except ImportError:
        return {"recorded": False, "reason": "the shared database library is not installed"}
    try:
        setting = db.resolve_setting(_project_root())
    except db.DbError as exc:
        return {"recorded": False, "reason": f"{exc.slug}: {exc.message}"}
    if not migrate:
        return {"recorded": True, "reason": None}
    conn = None
    try:
        conn = db.connect(application_name=NAME, setting=setting, transaction=True)
        db.migrate(conn, NAME, TABLE_STEPS, major=TABLES_MAJOR, minor=TABLES_MINOR)
    except db.DbError as exc:
        return {"recorded": False, "reason": f"{exc.slug}: {exc.message}"}
    finally:
        if conn is not None:
            conn.close()
    return {"recorded": True, "reason": None}


def _service_plan(wanted: str | None, migrate: bool = False) -> tuple[dict, dict]:
    """The environment and line the worker starts with; secrets only in the first."""
    cid, entry = _connection(wanted)
    env, missing = _livekit_env(cid, entry)
    if missing:
        _die(2, "missing_credentials", f"the connection lacks {', '.join(missing)}")
    settings = _line_settings()
    key = _openai_key()[0]
    if not key:
        _die(2, "missing_credentials", "OPENAI_API_KEY does not resolve",
             "store it in the agent's vault: capabilities secrets set OPENAI_API_KEY, or "
             f"`{NAME} setup set --stdin`")
    env["OPENAI_API_KEY"] = key
    root = _project_root()
    agent_id = _project_id(write=True, refuse=False) if root is not None else None
    line = {"settings": settings, "connection": cid,
            "agent_root": str(root) if root else os.getcwd(),
            "state_dir": str(_state_dir()), "agent_id": agent_id,
            "calls": _calls_store(agent_id, migrate)}
    env["LKAGENT_AGENT_NAME"] = _agent_name(cid, settings)
    return env, line


def cmd_service(args, wanted: str | None) -> None:
    env, line = _service_plan(wanted, migrate=args.service_cmd == "run")
    settings = line["settings"]
    if args.service_cmd == "doctor":
        _emit({"ok": True, "agent_name": env["LKAGENT_AGENT_NAME"], "url": env["LIVEKIT_URL"],
               "agent_root": line["agent_root"], "state_dir": line["state_dir"],
               "settings": settings, "connection": line["connection"],
               "outbound": bool(settings.get("outbound_trunk")),
               "numbers": [n.get("number") for n in settings.get("numbers") or []
                           if isinstance(n, dict)],
               "calls_recorded": line["calls"]})
        return
    os.environ.update(env)
    os.environ["LKAGENT_LINE"] = json.dumps(line)
    _pid_file().parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    _pid_file().write_text(str(os.getpid()))
    if not line["calls"]["recorded"]:
        print(json.dumps({"warning": f"calls are not recorded: {line['calls']['reason']}"}),
              file=sys.stderr)
    sys.path.insert(0, str(_BUNDLE / "service"))
    import worker  # noqa: PLC0415 - heavy, and only for the running service

    worker.run("dev" if args.dev else "start")


# ── main ────────────────────────────────────────────────────────────────────

def _parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog=NAME, description=HELP, allow_abbrev=False,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    d = sub.add_parser("doctor", allow_abbrev=False)
    d.add_argument("--offline", action="store_true")
    c = sub.add_parser("call", allow_abbrev=False)
    c.add_argument("number")
    c.add_argument("--from", dest="caller")
    c.add_argument("--task")
    s = sub.add_parser("service", allow_abbrev=False)
    ss = s.add_subparsers(dest="service_cmd", required=True)
    r = ss.add_parser("run", allow_abbrev=False)
    r.add_argument("--dev", action="store_true")
    ss.add_parser("doctor", allow_abbrev=False)
    return p


def main() -> None:
    _gate()
    argv = sys.argv[1:]
    if argv[:1] == ["manifest"]:
        _emit({**_manifest_core(), "service": SERVICE})
        return
    _contract(argv)
    wanted, cleaned, i = None, [], 0
    while i < len(argv):
        if argv[i] == "--connection" and i + 1 < len(argv):
            wanted = argv[i + 1]
            i += 2
            continue
        if argv[i].startswith("--connection="):
            wanted = argv[i].split("=", 1)[1]
            i += 1
            continue
        cleaned.append(argv[i])
        i += 1
    args = _parser().parse_args(cleaned)
    if args.cmd == "doctor":
        cmd_doctor(wanted, args.offline)
    elif args.cmd == "call":
        cmd_call(wanted, args.number, args.task, args.caller)
    elif args.cmd == "service":
        cmd_service(args, wanted)


if __name__ == "__main__":
    main()
