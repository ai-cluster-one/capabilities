    ("articles", "list"):             (articles_list, [ARG_PROJECT_OPT, ARG_LIMIT100, ARG_OFFSET]),
    ("articles", "get"):              (articles_get, [ARG_ARTICLE]),
    ("articles", "create"):           (articles_create, [ARG_PROJECT_REQ, ARG_SUMMARY_REQ,
                                                         ARG_CONTENT, ARG_PARENT]),
    ("articles", "search"):           (articles_search, [ARG_QUERY, ARG_LIMIT100, ARG_OFFSET]),
    ("articles", "update"):           (articles_update, [ARG_ARTICLE, ARG_SUMMARY_OPT,
                                                         ARG_CONTENT, ARG_PARENT]),
    ("articles", "comments", "list"): (articles_comments_list, [ARG_ARTICLE, ARG_LIMIT50, ARG_OFFSET]),
    ("articles", "comments", "add"):  (articles_comments_add, [ARG_ARTICLE, ARG_TEXT]),
}


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=NAME, add_help=True)
    subs = {(): parser.add_subparsers(dest="_l0", required=True, metavar="verb")}
    for path, (_handler, argspecs) in COMMANDS.items():
        for depth in range(1, len(path)):
            prefix = path[:depth]
            if prefix not in subs:
                node = subs[prefix[:-1]].add_parser(prefix[-1])
                subs[prefix] = node.add_subparsers(dest=f"_l{depth}", required=True,
                                                   metavar="verb")
        leaf = subs[path[:-1]].add_parser(path[-1])
        for names, kwargs in argspecs:
            leaf.add_argument(*names, **kwargs)
        leaf.set_defaults(_path=path)
    subs[()].add_parser("doctor").set_defaults(_path=("doctor",))
    return parser


def _check_connection(base_url, token):
    with _client(base_url, token) as c:
        return {"ok": True, "base_url": base_url, "identity": users_me(c, argparse.Namespace())}

def cmd_doctor(reg, reg_file, wanted, token_key):
    report = _connections_report()
    _doctor_gate(report, wanted)
    targets = [wanted] if wanted else list(report["connections"])
    checked = {}
    for cid in targets:
        selected, entry = _select_connection(reg, cid)
        key = token_key or (entry or {}).get("secret_env") or "YOUTRACK_TOKEN"
        base_url, _, _ = _resolve_base_url(entry, reg_file)
        checked[selected] = _check_connection(base_url, _load_token(key))
    _emit({"ok": True, "connections": checked})

def main() -> None:
    _gate()
    argv = sys.argv[1:]
    _contract(argv)
    parser = _build_parser()

    token_key = wanted = None
    cleaned = []
    i = 0
    while i < len(argv):
        if argv[i] in ("--token-env", "--connection") and i + 1 < len(argv):
            if argv[i] == "--token-env": token_key = argv[i + 1]
            else: wanted = argv[i + 1]
            i += 2; continue
        if argv[i].startswith("--token-env="): token_key = argv[i].split("=", 1)[1]; i += 1; continue
        if argv[i].startswith("--connection="): wanted = argv[i].split("=", 1)[1]; i += 1; continue
        cleaned.append(argv[i]); i += 1
    args = parser.parse_args(cleaned)
    reg, reg_file = _connections_registry()
    if args._path == ("doctor",):
        cmd_doctor(reg, reg_file, wanted, token_key); return
    cid, entry = _select_connection(reg, wanted)
    allow_write = WRITE_DEFAULT if entry is None else bool(entry.get("allow_write", WRITE_DEFAULT))
    _write_gate(cid, allow_write, " ".join(args._path))
    key = token_key or (entry or {}).get("secret_env") or "YOUTRACK_TOKEN"
    base_url, _, _ = _resolve_base_url(entry, reg_file)
    if not base_url: _die(2, "missing_url", "YOUTRACK_URL/base_url is not configured")
    handler, _argspecs = COMMANDS[args._path]
    with _client(base_url, _load_token(key)) as client:
        _emit(handler(client, args))

if __name__ == "__main__":
    main()
