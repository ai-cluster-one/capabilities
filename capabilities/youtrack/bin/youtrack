    ("searches", "list"):             (searches_list, [ARG_LIMIT100, ARG_OFFSET]),
    ("groups", "find"):               (groups_find, [ARG_SUBSTRING_OPT, ARG_LIMIT100, ARG_OFFSET]),
    ("groups", "members"):            (groups_members, [ARG_GROUP_POS, ARG_LIMIT100, ARG_OFFSET]),
    ("issues", "get"):                (issues_get, [ARG_ISSUE]),
    ("issues", "search"):             (issues_search, [ARG_QUERY, ARG_LIMIT100, ARG_OFFSET, ARG_SELECT]),
    ("issues", "create"):             (issues_create, [ARG_PROJECT_REQ, ARG_SUMMARY_REQ,
                                                       ARG_DESCRIPTION, ARG_FIELD,
                                                       ARG_FIELDS, ARG_DRAFT]),
    ("issues", "update"):             (issues_update, [ARG_ISSUE, ARG_FIELD, ARG_FIELDS,
                                                       ARG_SUMMARY_OPT, ARG_DESCRIPTION]),
    ("issues", "comments", "list"):   (issues_comments_list, [ARG_ISSUE, ARG_LIMIT50, ARG_OFFSET]),
    ("issues", "comments", "add"):    (issues_comments_add, [ARG_ISSUE, ARG_TEXT,
