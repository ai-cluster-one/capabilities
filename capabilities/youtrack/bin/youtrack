ARG_PROJECT_REQ   = (("--project",), {"required": True})
ARG_PROJECT_OPT   = (("--project",), {})
ARG_PROJECT_POS   = (("project",), {})
ARG_GROUP_POS     = (("group",), {})
ARG_FIELD_NAME    = (("name",), {})
ARG_SUMMARY_REQ   = (("--summary",), {"required": True})
ARG_SUMMARY_OPT   = (("--summary",), {})
ARG_DESCRIPTION   = (("--description",), {})
ARG_CONTENT       = (("--content",), {})
ARG_TEXT          = (("--text",), {})
ARG_PARENT        = (("--parent",), {})
ARG_FIELD         = (("--field",), {"action": "append", "default": [],
                                    "metavar": "NAME=VALUE"})
ARG_FIELDS        = (("--fields",), {"metavar": "JSON|FILE|-"})
ARG_DRAFT         = (("--draft",), {"action": "store_true"})
ARG_TAG_POS       = (("tag",), {"metavar": "TAG"})
ARG_LINK_TO       = (("--to",), {"required": True})
ARG_LINK_TYPE     = (("--type",), {"required": True, "metavar": "PHRASE"})
ARG_PERMITTED_USERS  = (("--permitted-users",), {"action": "append", "default": [],
                                                 "metavar": "LOGIN"})
ARG_PERMITTED_GROUPS = (("--permitted-groups",), {"action": "append", "default": [],
                                                  "metavar": "NAME"})
ARG_DURATION      = (("--duration",), {"required": True, "metavar": "D"})
ARG_DATE          = (("--date",), {"metavar": "YYYY-MM-DD"})
ARG_WORK_TYPE     = (("--type",), {"metavar": "NAME"})

COMMANDS = {
    ("users", "me"):                  (users_me, []),
    ("users", "find"):                (users_find, [ARG_SUBSTRING_REQ, ARG_LIMIT50, ARG_OFFSET]),
    ("projects", "find"):             (projects_find, [ARG_SUBSTRING_OPT, ARG_LIMIT100, ARG_OFFSET]),
    ("projects", "get"):              (projects_get, [ARG_PROJECT_POS]),
