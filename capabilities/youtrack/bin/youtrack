#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "httpx>=0.27",
#     "capabilities-contract==0.4.1",
# ]
# ///
"""
youtrack — agent-first CLI for YouTrack issues and knowledge-base articles.

Run `youtrack help` before use; this is the complete contract.

Configuration resolves as named connections. Without a registry, `default`
uses YOUTRACK_URL and YOUTRACK_TOKEN from the standard cascade (project
.env/.env.local, ~/.config/youtrack/credentials.env, then process env).
YOUTRACK_URL is the YouTrack origin, for example https://acme.youtrack.cloud.
YOUTRACK_TOKEN is a permanent token and never belongs on the command line.

A project may declare capabilities/youtrack/connections.json:
  {
    "default": "work",
    "connections": {
      "work": {
        "secret_env": "YOUTRACK_WORK_TOKEN",
        "base_url": "https://acme.youtrack.cloud",
        "allow_write": true
      }
    }
  }

Outside any project, connections and doctor are machine reads: they use the
machine's own connections read-only, unless a grant switched one off; every
other verb that needs a connection is refused there.

Commands:
  youtrack help                              Print this contract.
  youtrack connections                       Show local config resolution.
  youtrack doctor [--connection ID]          Check config, identity, reachability.

Contract commands:
  youtrack stub
  youtrack manifest --json
  youtrack guide [topic]
  youtrack ids list|get|set|rm
  youtrack refs
  youtrack inventory [--network]

Read:
  youtrack users me                          Current YouTrack user.
  youtrack users find SUBSTRING [--limit N] [--offset N]
                                             Find users by substring across
                                             login, name and email. The visible
                                             set is token-scoped, so absence
                                             here does not prove a login is
                                             invalid.
  youtrack projects find [SUBSTRING] [--limit N] [--offset N]
                                             Projects visible to the token;
                                             optional substring match on name.
  youtrack projects get ID                   One project: name, shortName,
                                             description, archived, leader.
  youtrack projects fields list ID [--limit N] [--offset N]
                                             Custom-field schema for a project:
                                             name, type, multiValue, canBeEmpty,
                                             and allowed values where bundled.
                                             canBeEmpty is YouTrack's own flag and
                                             governs whether an existing value may
                                             be emptied — it does NOT mean a create
                                             must supply the field. A create that
                                             omits a canBeEmpty=false field
                                             succeeds; YouTrack supplies its own
                                             default (measured).
  youtrack projects fields get ID NAME       One field's schema; NAME matches
                                             case-insensitively.
  youtrack groups find [SUBSTRING] [--limit N] [--offset N]
                                             Find user groups by substring on
                                             name. Returns the group id, which
                                             is what comment visibility needs —
                                             permittedGroups rejects a name.
  youtrack groups members GROUPID [--limit N] [--offset N]
                                             List the users in a group. Takes
                                             the group id from `groups find`.
  youtrack searches list [--limit N] [--offset N]
                                             Saved issue searches visible to
                                             the token, with their queries.
  youtrack issues get ISSUE                  Read one issue (ID or URL),
                                             including its tags.
  youtrack issues search QUERY [--limit N] [--offset N] [--select KEY,KEY]
                                             Search issues server-side using
                                             YouTrack query language.
                                             --select trims the output to the
                                             named keys: core attributes
                                             (idReadable, summary, …) or
                                             fields.<name> for one custom
                                             field. A named custom field the
                                             issue does not carry is omitted,
                                             not an error.
  youtrack issues comments list ISSUE [--limit N] [--offset N]
                                             Read recent comments on an issue.
  youtrack issues work list ISSUE [--limit N] [--offset N]
                                             Work items logged on an issue:
                                             date, duration, type, author, text.
  youtrack articles list [--project ID] [--limit N] [--offset N]
                                             List knowledge-base articles (paged;
                                             --project scopes to one project). This
                                             is a listing, not a full-text search.
  youtrack articles get ID                   Read one article (ID or URL): summary,
                                             content, project, parent/child refs.
  youtrack articles comments list ID [--limit N] [--offset N]
                                             Read recent comments on an article.

Write:
  youtrack issues create --project ID        Create an issue, with its custom
        --summary S [--description TEXT|-]    fields set in the same call. Project
        [--field NAME=VALUE]…                 is the database entity id (for
        [--fields JSON|FILE|-] [--draft]      example 0-0), not its short name;
                                             store stable ids with `youtrack ids
                                             set project …`. --field and --fields
                                             take the same values as on `issues
                                             update` below. Omitted fields are left
                                             to YouTrack, which fills in its own
                                             defaults. --draft creates an
                                             unnumbered draft instead: its
                                             idReadable is the literal
                                             `Issue.Draft`, it is invisible to
                                             search, and only the returned `id`
                                             addresses it — keep it. There is no
                                             promote verb; to turn a draft into a
                                             numbered issue call
                                             `POST /api/issues?draftId={id}`
                                             directly. Measured: the draft's
                                             fields carry over intact, the draft
                                             is consumed (it 404s afterwards), the
                                             new issue gets a *different* internal
                                             id that must be read from the
                                             promotion response, and the Assignee
                                             auto-default does NOT fire — so
                                             promoting a draft and creating
                                             directly are not equivalent.
  youtrack issues update ISSUE               Update an issue's summary, description,
        [--summary S] [--description TEXT|-]  and custom fields. Field names match
        [--field NAME=VALUE]…                 case-insensitively. --field splits on
        [--fields JSON|FILE|-]                the first `=` only; repeat it to give a
                                             multi-value field several values, and
                                             `--field NAME=` clears one. --fields
                                             takes a JSON object of NAME: VALUE and
                                             is applied first, so an explicit --field
                                             patches one value of a piped template.
                                             Enum/state/version/build/owned values are
                                             names, user fields are logins, `date`
                                             fields are YYYY-MM-DD, and `date and
                                             time` fields are epoch milliseconds.
                                             Respects allow_write connection policy.
  youtrack issues comments add ISSUE [--text TEXT|-]
        [--permitted-users LOGIN]…           Restrict who can see the comment.
        [--permitted-groups NAME]…           Users are named by login, groups by
                                             name — the name is resolved to an
                                             id here because YouTrack's
                                             permittedGroups rejects names. An
                                             unknown group exits 6 before any
                                             write. Omit both flags and the
                                             comment is unrestricted.
  youtrack issues links add ISSUE --to ISSUE --type PHRASE
                                             Link two issues. --type takes the
                                             direction phrase, not a type name:
                                             "subtask of", "parent for",
                                             "relates to", "depends on", "is
                                             required for", "duplicates", "is
                                             duplicated by". One write fills in
                                             both sides. Linking an issue to
                                             itself is refused.
  youtrack issues links remove ISSUE --to ISSUE --type PHRASE
                                             Remove a link. Not idempotent:
                                             removing a link that is not there
                                             exits 3.
  youtrack issues tags add ISSUE TAG         Tag an issue. TAG is the tag name;
  youtrack issues tags remove ISSUE TAG      it is resolved to an id here
                                             because YouTrack's tag endpoint
                                             rejects a name. Tags are
                                             instance-wide, not per project, and
                                             a tag owned by someone else can be
                                             applied. A name that is not visible
                                             to this token exits 6 before any
                                             write. add is idempotent; removing
                                             a tag the issue does not carry
                                             exits 3.
  youtrack issues work log ISSUE             Log time against an issue. Adds an
        --duration D [--date YYYY-MM-DD]      entry; it never rewrites a field.
        [--type NAME] [--text TEXT|-]         --duration needs a unit — 45m,
                                             1h 30m, 2d — because YouTrack reads
                                             a bare number as HOURS, so a
                                             unit-less value is refused here. 1d
                                             is the project's workday, not 24h,
                                             and the server re-renders the
                                             duration it stores, so the reply
                                             carries both minutes and its own
                                             presentation. --type is optional
                                             and is validated against this
                                             project's work item types, which
                                             can differ from the instance's.
                                             --date is a calendar day and
                                             defaults to today. The Spent time
                                             field is calculated from these
                                             entries and cannot be set directly.
  youtrack articles create --project ID      Create an article in a project
        --summary S [--content TEXT|-]        (database entity id); optionally give
        [--parent ID|URL]                    a parent article to create a sub-article.
  youtrack articles search QUERY [--limit N] [--offset N]
                                             Full-text / query-language search
                                             over articles. Same endpoint as
                                             `articles list`, with a query.
  youtrack articles update ID                Update an article's summary and/or
        [--summary S] [--content TEXT|-]     content and/or parent (ID|URL).
        [--parent ID|URL]                    Respects allow_write policy. An
                                             article cannot be given itself as
                                             --parent (refused before the write).
  youtrack articles comments add ID [--text TEXT|-]
                                             Add a comment to an article.

Global options accepted anywhere:
  --connection ID                            Select a named connection.
  --token-env KEY                            Select the env key holding the token.

Text arguments accept inline text, a readable file path, or `-` for stdin.
Every verb that takes --limit returns {"items": [...], "has_more": bool}
rather than a bare array. has_more is true when the server had more rows
than --limit; page on with --offset. This is how a sprint rollup detects
that it was cut short instead of quietly reporting a partial total.
Success is JSON on stdout. Errors are JSON on stderr. Exit codes: 0 success,
2 auth/config, 3 not found, 4 policy refusal (this connection is read-only),
5 network/server, 6 input, 7 a YouTrack workflow rule rejected the change.
Exit 7 is deterministic — the input was valid, so retrying it unchanged will
fail again; the rule name is in the error body.
"""

import argparse
import datetime
import difflib
import json
import os
import re
import sys
import time
from pathlib import Path
from typing import NoReturn

import httpx

NAME = "youtrack"
SUMMARY = "YouTrack CLI for issues (read with links and tags, paged search with field projection, comment — optionally visible only to named users or groups — create as a numbered issue or a draft with any custom field set in the create call, update of summary, description and any custom field, add/remove issue links by direction phrase, tag and untag by tag name, and log and list work items), user and group lookup, project reads and paged custom-field schemas, saved searches, and the knowledge base (search, read, create, update and re-parent articles, and article comments)."
SCOPE = "project"
CRED_KEYS = [
    {"key": "YOUTRACK_URL", "secret": False, "required": True,
     "note": "YouTrack origin, e.g. https://acme.youtrack.cloud"},
    {"key": "YOUTRACK_TOKEN", "secret": True, "required": True,
     "note": "permanent token (perm:…); alternates via --token-env"},
]

