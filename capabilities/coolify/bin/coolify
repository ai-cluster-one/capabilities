    env_list = _normalize_env_list(existing)

    # Find all entries with this key (both preview and non-preview)
    matching = [
        e for e in env_list
        if isinstance(e, dict) and e.get("key") == key
    ]

    if matching:
        # Update all matching entries to keep preview/non-preview siblings aligned
        results = []
        for entry in matching:
            result = _request(c, "PATCH", f"/{base}/{uuid}/envs",
                            json_body={"key": key, "value": value, "is_preview": entry.get("is_preview", False)})
            results.append(result)
        return {"updated": len(matching), "key": key, "results": results}
    else:
        # Create new entry
        return _request(c, "POST", f"/{base}/{uuid}/envs",
                       json_body={"key": key, "value": value})


def cmd_env_rm_typed(c, uuid: str, key: str, rtype: str):
    """Remove all environment variable entries matching KEY for an application or service."""
    base = "applications" if rtype == "application" else "services"
    # List existing env vars to find all matching entries
    existing = _request(c, "GET", f"/{base}/{uuid}/envs")
    env_list = _normalize_env_list(existing)

    # Find all entries with this key (both preview and non-preview)
    matching = [
        e for e in env_list
        if isinstance(e, dict) and e.get("key") == key
    ]

    if not matching:
        _die(3, "not_found", f"environment variable {key!r} not found",
             f"use `coolify env list {uuid} --type {rtype}` to see available variables")

    # Delete all matching entries
    deleted = []
    for entry in matching:
        env_uuid = entry.get("uuid")
        is_preview = entry.get("is_preview", False)
        _request(c, "DELETE", f"/{base}/{uuid}/envs/{env_uuid}")
        deleted.append({"uuid": env_uuid, "is_preview": is_preview})

    return {"deleted": len(matching), "key": key, "entries": deleted}


def cmd_env_bulk(c, uuid: str, env_data: str, rtype: str):
    """Bulk update environment variables (PATCH). env_data is newline-separated KEY=VALUE pairs."""
    base = "applications" if rtype == "application" else "services"
    # Parse KEY=VALUE pairs from input
    env_vars = []
    for line in env_data.strip().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        env_vars.append({"key": key.strip(), "value": value.strip()})

    if not env_vars:
        _die(6, "input", "no valid KEY=VALUE pairs found in input")

    return _request(
        c, "PATCH", f"/{base}/{uuid}/envs/bulk",
        json_body={"data": env_vars},
    )


def cmd_projects_create(c, name: str, description: str | None):
    """Create a new project."""
    payload = {"name": name}
    if description:
        payload["description"] = description
    result = _request(c, "POST", "/projects", json_body=payload)
    return result


APP_PATCH_FIELDS = (
    ("name", "name"),
    ("domains", "domains"),
    ("ports_exposes", "ports_exposes"),
    ("base_directory", "base_directory"),
    ("dockerfile_location", "dockerfile_location"),
    ("docker_compose_location", "docker_compose_location"),
    ("build_pack", "build_pack"),
    ("git_repository", "git_repository"),
    ("git_branch", "git_branch"),
    ("watch_paths", "watch_paths"),
    ("is_auto_deploy_enabled", "is_auto_deploy_enabled"),
    ("health_check_enabled", "health_check_enabled"),
    ("health_check_path", "health_check_path"),
    ("health_check_port", "health_check_port"),
    ("health_check_host", "health_check_host"),
    ("health_check_scheme", "health_check_scheme"),
    ("health_check_return_code", "health_check_return_code"),
    ("health_check_interval", "health_check_interval"),
    ("health_check_timeout", "health_check_timeout"),
    ("health_check_retries", "health_check_retries"),
    ("health_check_start_period", "health_check_start_period"),
)


def _app_patch_payload(args) -> dict:
    """Map only explicitly supplied argparse values to Coolify API fields."""
    payload = {}
    for attribute, field in APP_PATCH_FIELDS:
        value = getattr(args, attribute, None)
        if value is not None:
            payload[field] = value
    return payload


def cmd_app_create(c, args):
    """Create an application with various source types."""
    # Build the payload - common fields
    payload = {
        "project_uuid": args.project,
        "server_uuid": args.server,
        "environment_name": args.environment,
    }
    payload.update(_app_patch_payload(args))

    # Optional common fields
    if hasattr(args, 'name') and args.name:
        payload["name"] = args.name
    if hasattr(args, 'domains') and args.domains:
        payload["domains"] = args.domains
    if hasattr(args, 'ports_exposes') and args.ports_exposes:
        payload["ports_exposes"] = args.ports_exposes
    if hasattr(args, 'instant_deploy') and args.instant_deploy:
        payload["instant_deploy"] = False
    if hasattr(args, 'destination') and args.destination:
        payload["destination_uuid"] = args.destination

    # Determine source type and endpoint
    if hasattr(args, 'image') and args.image:
        # Registry image
        endpoint = "/applications/dockerimage"
        parts = args.image.rsplit(":", 1)
        payload["docker_registry_image_name"] = parts[0]
        payload["docker_registry_image_tag"] = parts[1] if len(parts) > 1 else "latest"
    elif hasattr(args, 'dockerfile') and args.dockerfile:
        # Inline dockerfile
        endpoint = "/applications/dockerfile"
        if args.dockerfile == "-":
            dockerfile_content = sys.stdin.read()
        else:
            dockerfile_content = Path(args.dockerfile).read_text()
        payload["dockerfile"] = dockerfile_content
    elif hasattr(args, 'git_repository') and args.git_repository:
        # Git-based - determine which endpoint
        payload["git_repository"] = args.git_repository
        payload["git_branch"] = args.git_branch
        if hasattr(args, 'build_pack') and args.build_pack:
            payload["build_pack"] = args.build_pack
        if hasattr(args, 'docker_compose_location') and args.docker_compose_location:
            payload["docker_compose_location"] = args.docker_compose_location
        if hasattr(args, 'dockerfile_location') and args.dockerfile_location:
            payload["dockerfile_location"] = args.dockerfile_location

        if hasattr(args, 'private_deploy_key') and args.private_deploy_key:
            endpoint = "/applications/private-deploy-key"
            payload["private_key_uuid"] = args.private_deploy_key
        elif hasattr(args, 'github_app') and args.github_app:
            endpoint = "/applications/private-github-app"
            payload["github_app_uuid"] = args.github_app
        else:
            endpoint = "/applications/public"
    else:
        _die(6, "input", "must specify one source type: --image, --dockerfile, or --git-repository")

    result = _request(c, "POST", endpoint, json_body=payload)
    if getattr(args, "instant_deploy", False) and isinstance(result, dict) and result.get("uuid"):
        deployment = cmd_deploy(c, result["uuid"], False, None)
        result = dict(result, instant_deploy=True, deployments=deployment.get("deployments", []))
        rows = result["deployments"]
        if len(rows) == 1 and rows[0].get("deployment_uuid"):
            result["deployment_uuid"] = rows[0]["deployment_uuid"]
    return result


def cmd_app_update(c, args):
    """Patch only the application fields supplied on the command line."""
    payload = _app_patch_payload(args)
    if not payload:
        _die(6, "input", "app update requires at least one field flag")
    return _request(
        c, "PATCH", f"/applications/{args.uuid}", json_body=payload,
    )


def cmd_service_create(c, args):
    """Create a service from docker-compose file."""
    import base64

    # Read compose file
    if args.compose == "-":
        compose_content = sys.stdin.read()
    else:
        compose_content = Path(args.compose).read_text()

    # Base64 encode the compose content
    compose_b64 = base64.b64encode(compose_content.encode()).decode()

    payload = {
        "project_uuid": args.project,
        "server_uuid": args.server,
        "environment_name": args.environment,
        "docker_compose_raw": compose_b64,
    }

    if args.name:
        payload["name"] = args.name
    if args.instant_deploy:
        payload["instant_deploy"] = True
    if args.destination:
        payload["destination_uuid"] = args.destination

    return _request(c, "POST", "/services", json_body=payload)


# One create endpoint per engine, at /databases/<engine>. Coolify keeps the
# envelope (project, server, environment, name, image, limits, tags) identical
# across all eight and varies only the engine's own credential and conf fields,
# which this capability passes through rather than models.
DATABASE_ENGINES = (
    "postgresql", "mysql", "mariadb", "mongodb",
    "redis", "keydb", "dragonfly", "clickhouse",
)


def _database_overrides(args) -> dict:
    """Body fields the caller supplies verbatim, sent without validation.

    The engine-specific surface is wide, differs per engine and moves upstream,
    so the capability carries no copy of it: `--set` types a value as a string,
    `--set-json` types it by parsing, and Coolify judges the field.
    """
    payload: dict = {}
    for raw in getattr(args, "set_string", None) or []:
        key, sep, value = raw.partition("=")
        if not sep or not key:
            _die(6, "input", f"--set expects KEY=VALUE, got {raw!r}")
        _warn_argv_secret("--set", key)
        payload[key] = value
    for raw in getattr(args, "set_json", None) or []:
        key, sep, value = raw.partition("=")
        if not sep or not key:
            _die(6, "input", f"--set-json expects KEY=JSON, got {raw!r}")
        _warn_argv_secret("--set-json", key)
        try:
            payload[key] = json.loads(value)
        except ValueError:
            _die(6, "input",
                 f"--set-json value for {key!r} is not JSON",
                 "quote a JSON literal, for example --set-json is_public=true")
    return payload


def _warn_argv_secret(flag: str, key: str) -> None:
    if _is_password_field(key):
        _warn(f"{flag} {key}=... puts a secret on the argument list; this form "
              "is deprecated and goes in the next release; use --set-stdin "
              f"{key}, --set-file {key}=<path> or --set-env {key}=<ENV_KEY>")


def _database_secret_fields(args, taken: dict) -> dict:
    """Body fields whose values come from stdin, a file or an env key, so a
    password never sits on the argument list. Sent as strings, unvalidated,
    like --set."""
    payload: dict = {}
    stdin_keys = getattr(args, "set_stdin", None) or []
    if len(stdin_keys) > 1:
        _die(6, "input", "--set-stdin is given once: standard input carries one value",
             "read the others with --set-file KEY=PATH or --set-env KEY=ENV_KEY")
    sources = [(key, "--set-stdin", {"stdin": True}) for key in stdin_keys]
    for flag, attr, kind in (("--set-file", "set_file", "file"),
                             ("--set-env", "set_env", "env")):
        for raw in getattr(args, attr, None) or []:
            key, sep, source = raw.partition("=")
            if not sep or not key or not source:
                _die(6, "input", f"{flag} expects KEY={'PATH' if kind == 'file' else 'ENV_KEY'}, got {raw!r}")
            sources.append((key, flag, {kind: source}))
    for key, flag, source in sources:
        if not key:
            _die(6, "input", f"{flag} expects a field name")
        if key in taken or key in payload:
            _die(6, "input", f"field {key!r} is given twice",
                 "give each body field one source")
        payload[key] = _secret_from(f"{flag} {key}", **source)
    return payload


def cmd_database_create(c, args):
    """Create a standalone database of one engine."""
    if not (args.environment or args.environment_uuid):
        _die(6, "input",
             "database create requires --environment or --environment-uuid")

    payload = {
        "project_uuid": args.project,
        "server_uuid": args.server,
    }
    if args.environment:
        payload["environment_name"] = args.environment
    if args.environment_uuid:
        payload["environment_uuid"] = args.environment_uuid
    if args.name:
        payload["name"] = args.name
    if args.description:
        payload["description"] = args.description
    if args.image:
        payload["image"] = args.image
    if args.destination:
        payload["destination_uuid"] = args.destination
    if args.instant_deploy:
        payload["instant_deploy"] = True
    overrides = _database_overrides(args)
    payload.update(overrides)
    payload.update(_database_secret_fields(args, overrides))

    return _request(c, "POST", f"/databases/{args.engine}", json_body=payload)


