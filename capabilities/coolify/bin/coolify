        "--ports-exposes", dest="ports_exposes",
        help="comma-separated container ports exposed by the application",
    )
    parser.add_argument(
        "--base-directory", dest="base_directory",
        help="repository subdirectory used as build context (for example /mcp-server)",
    )
    parser.add_argument(
        "--dockerfile-location", dest="dockerfile_location",
        help="Dockerfile path relative to base directory (for example /Dockerfile)",
    )
    parser.add_argument(
        "--docker-compose-location", dest="docker_compose_location",
        help="Docker Compose path relative to base directory",
    )
    parser.add_argument(
        "--build-pack", dest="build_pack",
        choices=["nixpacks", "railpack", "static", "dockerfile", "dockercompose"],
    )
    parser.add_argument(
        "--git-repository", dest="git_repository", help="git repository URL",
    )
    parser.add_argument("--git-branch", dest="git_branch", help="git branch")
    parser.add_argument(
        "--watch-paths", dest="watch_paths",
        help="newline-separated glob patterns filtering which changes trigger deploys; empty string clears",
    )
    parser.add_argument(
        "--health-check-enabled", dest="health_check_enabled",
        action=argparse.BooleanOptionalAction, default=None,
        help="enable or disable the application health check",
    )
    parser.add_argument("--health-check-path", dest="health_check_path")
    parser.add_argument("--health-check-port", dest="health_check_port")
    parser.add_argument("--health-check-host", dest="health_check_host")
    parser.add_argument("--health-check-scheme", dest="health_check_scheme")
    parser.add_argument(
        "--health-check-return-code", dest="health_check_return_code", type=int,
    )
    parser.add_argument(
        "--health-check-interval", dest="health_check_interval", type=int,
    )
    parser.add_argument(
        "--health-check-timeout", dest="health_check_timeout", type=int,
    )
    parser.add_argument(
        "--health-check-retries", dest="health_check_retries", type=int,
    )
    parser.add_argument(
        "--health-check-start-period", dest="health_check_start_period", type=int,
    )


# ── secrets: in from stdin, a file or an env key; out redacted ──────────────
#
# A secret never rides on argv, where process lists and shell history keep it,
# and nothing this capability prints carries one unless a person at a terminal
# asks for it with --reveal. The argv forms that existed before keep working
# for one release, with a warning on stderr.

REDACTED = "<redacted>"

# scheme://user:password@ — the password is the run up to the first `@`.
_URL_PASSWORD_RE = re.compile(
    r"(?P<head>[A-Za-z][A-Za-z0-9+.\-]*://[^\s:/?#@]+:)(?P<password>[^\s@]+)(?P<at>@)")


def _is_password_field(key) -> bool:
    return isinstance(key, str) and "password" in key.lower()


def _redact(value):
    """The same value with every password in a connection URL, and every
    password-named field, replaced by REDACTED. Shape is kept, so a caller can
    still tell a redacted value from an absent one."""
    if isinstance(value, dict):
        return {k: (REDACTED if _is_password_field(k) and isinstance(v, str) and v
                    else _redact(v))
                for k, v in value.items()}
    if isinstance(value, list):
        return [_redact(v) for v in value]
    if isinstance(value, str):
        return _URL_PASSWORD_RE.sub(
            lambda m: m.group("head") + REDACTED + m.group("at"), value)
    return value


def _reveal_gate(reveal: bool) -> None:
    """--reveal prints secrets, so it prints them only where a person reads
    them: a terminal. Refused before any request is made."""
    if reveal and not sys.stdout.isatty():
        _die(4, "reveal_needs_terminal",
             "--reveal prints passwords in full and does so only to a terminal; "
             "stdout here is not one",
             "Do not work around this — read the redacted answer, or ask the "
             "user to run the command with --reveal in their own terminal.")


def _emit_domain(value, reveal: bool = False) -> None:
    _emit(value if reveal else _redact(value))


def _warn(message: str) -> None:
    sys.stderr.write(json.dumps({"warning": message}, ensure_ascii=False) + "\n")


def _strip_one_newline(text: str) -> str:
    if text.endswith("\r\n"):
        return text[:-2]
    if text.endswith("\n"):
        return text[:-1]
    return text


def _read_stdin_secret() -> str:
    """Standard input whole, less one trailing newline; without echo when it is
    a terminal."""
    if sys.stdin.isatty():
        import getpass
        return getpass.getpass("")
    return _strip_one_newline(sys.stdin.read())


def _read_file_secret(path: str, what: str) -> str:
    try:
        return _strip_one_newline(Path(path).expanduser().read_text())
    except OSError as e:
        _die(6, "input", f"cannot read {what} from {path}: {e.strerror or e}")


def _read_env_secret(key: str, what: str) -> str:
    """An env key resolves through the cascade every secret here resolves
    through: project .env.local, .env, the user credentials.env, then the
    process environment."""
    value = _resolve_env_key(key)[0]
    if not value:
        _die(6, "input", f"env key {key} (for {what}) is not set",
             f"set {key} in the project's .env.local or .env, {CREDENTIALS_ENV}, "
             "or the environment")
    return value


def _secret_from(what: str, stdin: bool = False, file: str | None = None,
                 env: str | None = None, allow_empty: bool = False) -> str:
    """The one secret a flag group names, from exactly one source."""
    if stdin:
        value = _read_stdin_secret()
    elif file is not None:
        value = _read_file_secret(file, what)
    else:
        value = _read_env_secret(env, what)
    if not value and not allow_empty:
        _die(6, "input", f"{what} is empty")
    return value


def _env_set_value(args) -> str:
    """env set's value: from --value-stdin, --value-file or --value-env, or
    from standard input when none is named. The positional VALUE keeps working
    for one release, with a warning."""
    sources = (args.value_stdin, args.value_file is not None,
               args.value_env is not None)
    if args.value is not None:
        if any(sources):
            _die(6, "input", "env set was given its value twice",
                 "drop the positional VALUE")
        _warn("`env set <uuid> <KEY> <VALUE>` puts the value on the argument "
              "list; this form is deprecated and goes in the next release; use "
              "--value-stdin, --value-file <path> or --value-env <ENV_KEY>")
        return args.value
    if not any(sources):
        return _secret_from(f"the value of {args.key}", stdin=True,
                            allow_empty=True)
    return _secret_from(f"the value of {args.key}", stdin=args.value_stdin,
                        file=args.value_file, env=args.value_env,
                        allow_empty=True)


# ── connect: write a connection and its token in one act ───────────────────

def _connection_env_key(name: str) -> str:
    return "COOLIFY_" + re.sub(r"[^A-Z0-9]", "_", name.upper()) + "_TOKEN"


def _connect_url(raw: str) -> str:
    url = raw.strip().rstrip("/")
    if not re.match(r"https?://[^/\s]+", url):
        _die(6, "input", f"--url must be http(s)://<host>[:port], got {raw!r}",
             "for example https://coolify.example.com")
    if "@" in url.split("://", 1)[1].split("/", 1)[0]:
        _die(6, "input", "--url must not carry credentials",
             "the token comes from --token-stdin, --token-file or --token-env")
    if url.endswith(API_VERSION):
        _die(6, "input", f"--url is the instance root without {API_VERSION}",
             f"use {url[:-len(API_VERSION)]}")
    return url


def _check_token_shape(token: str) -> str:
    token = token.strip()
    if not token:
        _die(6, "input", "the token is empty")
    if any(ch.isspace() for ch in token):
        _die(6, "input", "the token holds whitespace or more than one line",
             "hand connect the token alone, one line")
    if "'" in token or '"' in token:
        _die(6, "input", "the token holds a quote character, which no Coolify "
             "token carries", "hand connect the token alone")
    return token


def _env_line_key(line: str) -> str | None:
    stripped = line.strip()
    if not stripped or stripped.startswith("#") or "=" not in stripped:
        return None
    key = stripped.split("=", 1)[0].strip()
    if key.startswith("export "):
        key = key[len("export "):].strip()
    return key


def _write_env_key(path: Path, key: str, value: str) -> None:
    """Set KEY in an env file, keeping every other line as it was.

    The value is written single-quoted, which the contract's parser reads back
    whole (a `|` included) and which a shell that sources the file anyway does
    not split. The file is replaced atomically and left at mode 0600; the write
    is proven by reading it back through the same parser every verb uses."""
    lines = path.read_text().splitlines() if path.exists() else []
    written = f"{key}='{value}'"
    out, done = [], False
    for line in lines:
        if _env_line_key(line) == key:
            if not done:
                out.append(written)
                done = True
            continue
        out.append(line)
    if not done:
        out.append(written)
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write("\n".join(out) + "\n")
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    finally:
        if temporary.exists():
            temporary.unlink()
    os.chmod(path, 0o600)
    if _parse_env_file(path).get(key) != value:
        _die(5, "credentials_write_failed",
             f"{path} does not read back the value written for {key}")


def cmd_connect(args) -> None:
    """Pair one Coolify instance: the entry, the token, then the doctor probe."""
    if getattr(args, "token", None) or getattr(args, "base_url", None):
        _die(6, "input", "connect takes its URL from --url and its token from "
             "--token-stdin, --token-file or --token-env",
             "drop the global --base-url/--token flags")
    _read_only_gate(f"connect {args.name!r}")
    name = args.name
    if not KEY_RE.fullmatch(name):
        _die(6, "input", f"connection name {name!r} must match {KEY_RE.pattern}")
    url = _connect_url(args.url)
    scope = args.scope or "project"
    root = _project_root()
    adapter = _records()
    if scope == "project":
        if root is None:
            _die(6, "no_project", "--project pairs this project and there is no "
                 "project here", "run it inside the project, or pass --global")
        envelope = getattr(adapter, "envelope", None)
        if envelope is not None and not Path(envelope).is_dir():
            _die(6, "no_envelope", "no capabilities/ envelope in this project",
                 "run `capabilities init` first")
    ssh = None
    if args.ssh_key:
        key_path = Path(args.ssh_key).expanduser().absolute()
        if not key_path.is_file():
            _die(6, "input", f"--ssh-key {args.ssh_key!r} is not a file")
        ssh = {"user": "root", "key_path": str(key_path)}
    token = _check_token_shape(_secret_from(
        "the token", stdin=args.token_stdin, file=args.token_file,
        env=args.token_env))

    secret_env = _connection_env_key(name)
    credentials = CREDENTIALS_ENV if scope == "global" else root / ".env.local"
    _write_env_key(credentials, secret_env, token)
    entry = {"base_url": url, "secret_env": secret_env}
    if ssh:
        entry["ssh"] = ssh
    try:
        adapter.set(NAME, "connection", name, entry, scope=scope)
        if args.default:
            adapter.set(NAME, "setting", "connection.default", name, scope=scope)
        registry = adapter.scope_source(NAME, "connection", scope)
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)

    probe = _check_connection({"id": name, "allow_write": WRITE_DEFAULT,
                               "base_url": url, "token": token})
    category = probe.pop("category", None)
    out = {"ok": bool(probe.get("ok")), "connection": name, "scope": scope,
           "base_url": url, "secret_env": secret_env,
           "credentials": str(credentials), "registry": registry,
           "default": bool(args.default)}
    if ssh:
        out["ssh"] = ssh
    out["doctor"] = probe
    machine_read = _machine_read("doctor")
    granted = (_inventory_connections(machine_read)["connections"].get(name)
               or {}).get("granted")
    if granted is False:
        out["usable_here"] = False
        out["hint"] = _grant_hint(name)
    elif granted and machine_read:
        out["usable_here"] = True
        out["machine_reads"] = list(MACHINE_READS)
    _emit(out)
    if not probe.get("ok"):
        sys.exit(category or 5)


# ── projects: list, get, create <name> ─────────────────────────────────────

def _projects_call(operands: list, name_flag: str | None) -> tuple:
    """(action, uuid, name) from `projects [<uuid>] | projects create <name>`.

    The forms that went before - `--name` beside `create`, and a uuid in front
    of `create` - keep working for one release, with a warning."""
    legacy = ("`projects create --name <name>` is deprecated and goes in the "
              "next release; use `projects create <name>`")
    if not operands:
        return "list", None, None
    if operands[0] == "delete":
        if len(operands) != 2:
            _die(6, "input", "projects delete requires one uuid")
        return "delete", operands[1], None
    if operands[0] == "create":
        if len(operands) > 2:
            _die(6, "input", "projects create takes one name",
                 "quote a name with spaces: coolify projects create \"<name>\"")
        if len(operands) == 2:
            name = operands[1]
            if name_flag is not None and name_flag != name:
                _die(6, "input", f"projects create was given two names: "
                     f"{name!r} and --name {name_flag!r}",
                     "pass the name once: coolify projects create <name>")
            if name_flag is not None:
                _warn(legacy)
            return "create", None, name
        if name_flag:
            _warn(legacy)
            return "create", None, name_flag
        _die(6, "input", "projects create requires a name",
             "coolify projects create <name>")
    if len(operands) == 2 and operands[1] == "create":
        if not name_flag:
            _die(6, "input", "projects create requires a name",
                 "coolify projects create <name>")
        _warn(legacy)
        return "create", None, name_flag
    if len(operands) == 1:
        return "get", operands[0], None
    _die(6, "input", f"projects takes [<uuid>] or create <name>, got {' '.join(operands)!r}")


def _add_reveal(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--reveal", action="store_true",
        help="print passwords in full; refused unless stdout is a terminal")


# ── dispatch ────────────────────────────────────────────────────────────────

def main() -> None:
    _gate()                      # every verb passes the effective policy gate first
    _contract(sys.argv[1:])      # contract verbs; domain verbs fall through

    p = argparse.ArgumentParser(prog="coolify", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--connection", default=None,
                   help="select a named connection from the registry")
    p.add_argument("--base-url", dest="base_url", default=None,
                   help="Coolify instance base URL (overrides env/config)")
    p.add_argument("--token", default=None,
                   help="API token (prefer config/env; avoid on CLI)")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("help")
    sub.add_parser("doctor")
    _add_reveal(sub.add_parser("resources"))
    sub.add_parser("sources")

    sp = sub.add_parser("connect", help="write a connection and its token")
    sp.add_argument("name")
    sp.add_argument("--url", required=True)
    token_source = sp.add_mutually_exclusive_group(required=True)
    token_source.add_argument("--token-stdin", dest="token_stdin", action="store_true")
    token_source.add_argument("--token-file", dest="token_file", default=None)
    token_source.add_argument("--token-env", dest="token_env", default=None)
    connect_scope = sp.add_mutually_exclusive_group()
    connect_scope.add_argument("--global", dest="scope", action="store_const",
                               const="global", default=None)
    connect_scope.add_argument("--project", dest="scope", action="store_const",
                               const="project")
    sp.add_argument("--default", action="store_true")
    sp.add_argument("--ssh-key", dest="ssh_key", default=None)

    # projects [<uuid>] | projects create <name>
    sp = sub.add_parser("projects")
    sp.add_argument("operands", nargs="*", metavar="<uuid> | create <name>")
    sp.add_argument("--name", default=None)
    sp.add_argument("--description", default=None)
    _add_reveal(sp)
    _add_delete_arguments(sp)

    for verb in ("applications", "services", "databases",
                 "servers", "deployments"):
        sp = sub.add_parser(verb)
        sp.add_argument("uuid", nargs="?", default=None)
        _add_reveal(sp)

    sp = sub.add_parser("logs")
    sp.add_argument("uuid")
    sp.add_argument("--lines", type=int, default=100)
    _add_reveal(sp)

    sp = sub.add_parser("deploy")
    sp.add_argument("uuid", nargs="?", default=None)
    sp.add_argument("--force", action="store_true", help="rebuild without cache")
    sp.add_argument("--tag", default=None, help="deploy every resource with this tag")

    sp = sub.add_parser("wait")
    sp.add_argument("uuid")
    sp.add_argument("--deployment", default=None)
    sp.add_argument("--timeout", type=float, default=600)

    for verb in ("start", "stop", "restart"):
        sp = sub.add_parser(verb)
        sp.add_argument("uuid")
        sp.add_argument("--type", dest="rtype", default="application",
                        choices=["application", "service", "database"])

    # app create/update
    sp = sub.add_parser("app", help="create or update an application")
    app_sub = sp.add_subparsers(dest="app_cmd", required=True)
    sp_delete = app_sub.add_parser("delete")
    sp_delete.add_argument("uuid")
    _add_delete_arguments(sp_delete)
    sp_create = app_sub.add_parser("create", help="create application")
    sp_create.add_argument("--project", required=True, help="project UUID")
    sp_create.add_argument("--server", required=True, help="server UUID")
    sp_create.add_argument("--environment", required=True, help="environment name")
    _add_app_patch_arguments(sp_create)
    sp_create.add_argument("--instant-deploy", dest="instant_deploy", action="store_true")
    sp_create.add_argument("--destination", help="destination UUID")
    # Source type flags
    sp_create.add_argument("--private-deploy-key", dest="private_deploy_key", help="deploy key UUID")
    sp_create.add_argument("--github-app", dest="github_app", help="GitHub app UUID")
    sp_create.add_argument("--image", help="registry image (name:tag)")
    sp_create.add_argument("--dockerfile", help="inline dockerfile (file path or - for stdin)")

    sp_update = app_sub.add_parser(
        "update", help="patch supplied application fields only",
    )
    sp_update.add_argument("uuid", help="application UUID")
    _add_app_patch_arguments(sp_update)
    auto_deploy = sp_update.add_mutually_exclusive_group()
    auto_deploy.add_argument(
        "--auto-deploy-enabled", dest="is_auto_deploy_enabled",
        action="store_true", default=None,
        help="enable automatic deployments from source webhooks",
    )
    auto_deploy.add_argument(
        "--no-auto-deploy-enabled", dest="is_auto_deploy_enabled",
        action="store_false",
        help="disable automatic deployments from source webhooks",
    )

    # service create
    sp = sub.add_parser("service", help="create service")
    service_sub = sp.add_subparsers(dest="service_cmd", required=True)
    sp_delete = service_sub.add_parser("delete")
    sp_delete.add_argument("uuid")
    _add_delete_arguments(sp_delete)
    sp_create = service_sub.add_parser("create", help="create service")
    sp_create.add_argument("--compose", required=True, help="docker-compose file (path or - for stdin)")
    sp_create.add_argument("--project", required=True, help="project UUID")
    sp_create.add_argument("--server", required=True, help="server UUID")
    sp_create.add_argument("--environment", required=True, help="environment name")
    sp_create.add_argument("--name", help="service name")
    sp_create.add_argument("--instant-deploy", dest="instant_deploy", action="store_true")
    sp_create.add_argument("--destination", help="destination UUID")

    # database create
    sp = sub.add_parser("database", help="create a database")
    database_sub = sp.add_subparsers(dest="database_cmd", required=True)
    sp_delete = database_sub.add_parser("delete")
    sp_delete.add_argument("uuid")
    _add_delete_arguments(sp_delete)
    sp_create = database_sub.add_parser("create", help="create database")
    sp_create.add_argument(
        "--engine", required=True, choices=list(DATABASE_ENGINES),
        help="database engine; selects the POST /databases/<engine> endpoint",
    )
    sp_create.add_argument("--project", required=True, help="project UUID")
    sp_create.add_argument("--server", required=True, help="server UUID")
    sp_create.add_argument(
        "--environment", default=None,
        help="environment name (supply this or --environment-uuid)",
    )
    sp_create.add_argument(
        "--environment-uuid", dest="environment_uuid", default=None,
        help="environment UUID (supply this or --environment)",
    )
    sp_create.add_argument("--name", help="database name")
    sp_create.add_argument("--description", help="database description")
    sp_create.add_argument(
        "--image", help="database docker image, tag included (e.g. postgres:16)",
    )
    sp_create.add_argument("--instant-deploy", dest="instant_deploy", action="store_true")
    sp_create.add_argument("--destination", help="destination UUID")
    sp_create.add_argument(
        "--set", dest="set_string", action="append", metavar="KEY=VALUE",
        help="body field sent as a JSON string, unvalidated; repeatable",
    )
    sp_create.add_argument(
        "--set-json", dest="set_json", action="append", metavar="KEY=JSON",
        help="body field sent as parsed JSON, unvalidated; repeatable",
    )
    sp_create.add_argument(
        "--set-stdin", dest="set_stdin", action="append", metavar="KEY",
        help="body field whose value is read from standard input; once",
    )
    sp_create.add_argument(
        "--set-file", dest="set_file", action="append", metavar="KEY=PATH",
        help="body field whose value is read from a file; repeatable",
    )
    sp_create.add_argument(
        "--set-env", dest="set_env", action="append", metavar="KEY=ENV_KEY",
        help="body field whose value is read from an env key; repeatable",
    )
    _add_reveal(sp_create)

    sp = sub.add_parser("env", help="manage application/service environment variables")
    env_sub = sp.add_subparsers(dest="env_cmd", required=True)

    sp_list = env_sub.add_parser("list", help="list environment variables")
    sp_list.add_argument("uuid")
    sp_list.add_argument("--type", dest="rtype", default="application",
                        choices=["application", "service"])
    _add_reveal(sp_list)

    sp_set = env_sub.add_parser("set", help="set environment variable")
    sp_set.add_argument("uuid")
    sp_set.add_argument("key")
    sp_set.add_argument("value", nargs="?", default=None,
                        help="deprecated: puts the value on argv")
    value_source = sp_set.add_mutually_exclusive_group()
    value_source.add_argument("--value-stdin", dest="value_stdin", action="store_true")
    value_source.add_argument("--value-file", dest="value_file", default=None)
    value_source.add_argument("--value-env", dest="value_env", default=None)
    sp_set.add_argument("--type", dest="rtype", default="application",
                        choices=["application", "service"])

    sp_rm = env_sub.add_parser("rm", help="remove environment variable")
    sp_rm.add_argument("uuid")
    sp_rm.add_argument("key")
    sp_rm.add_argument("--type", dest="rtype", default="application",
                        choices=["application", "service"])

    sp_bulk = env_sub.add_parser("bulk", help="bulk update environment variables")
    sp_bulk.add_argument("uuid")
    sp_bulk.add_argument("--type", dest="rtype", default="application",
                        choices=["application", "service"])

    args = p.parse_args()
    if args.cmd == "help":
        sys.stdout.write((__doc__ or "").lstrip("\n")); return
    if args.cmd == "doctor":
        cmd_doctor(args); return
    if args.cmd == "connect":
        cmd_connect(args); return

    reveal = bool(getattr(args, "reveal", False))
    _reveal_gate(reveal)
    projects_call = (_projects_call(args.operands, args.name)
                     if args.cmd == "projects" else None)
    env_value = None
    if args.cmd == "env" and args.env_cmd == "set":
        env_value = _env_set_value(args)

    conn = _resolve_conn(args)

    # Determine the exact subcommand's policy. Read siblings under a mutating
    # command family (notably `env list`) must remain usable on read-only
    # connections.
    is_write = (
        args.cmd in {"deploy", "start", "stop", "restart", "app", "service",
                     "database"}
        or (projects_call is not None and projects_call[0] in {"create", "delete"})
        or (args.cmd == "env" and args.env_cmd != "list")
    )

    if is_write:
        _write_gate(conn["id"], conn["allow_write"], args.cmd)

    def out(value) -> None:
        _emit_domain(value, reveal)

    with _client(conn) as c:
        if args.cmd == "resources":
            out(_slim_list(_request(c, "GET", "/resources")))
        elif args.cmd == "sources":
            out(cmd_sources(c))
        elif args.cmd == "projects":
            action, uuid, name = projects_call
            if action == "create":
                out(cmd_projects_create(c, name, args.description))
            elif action == "delete":
                out(cmd_delete(c, "projects", uuid, args))
            else:
                out(cmd_collection(c, args.cmd, uuid))
        elif args.cmd in ("applications", "services", "databases",
                          "servers", "deployments"):
            out(cmd_collection(c, args.cmd, args.uuid))
        elif args.cmd == "logs":
            out(cmd_logs(c, args.uuid, args.lines))
        elif args.cmd == "deploy":
            out(cmd_deploy(c, args.uuid, args.force, args.tag))
        elif args.cmd == "wait":
            out(cmd_wait(c, args.uuid, args.deployment, args.timeout))
        elif args.cmd in ("start", "stop", "restart"):
            out(cmd_lifecycle(c, args.cmd, args.uuid, args.rtype))
        elif args.cmd == "app":
            if args.app_cmd == "delete":
                out(cmd_delete(c, "applications", args.uuid, args))
            elif args.app_cmd == "create":
                out(cmd_app_create(c, args))
            elif args.app_cmd == "update":
                out(cmd_app_update(c, args))
            else:
                _die(6, "unknown_command", f"no handler for app {args.app_cmd!r}")
        elif args.cmd == "service":
            if args.service_cmd == "delete":
                out(cmd_delete(c, "services", args.uuid, args))
            elif args.service_cmd == "create":
                out(cmd_service_create(c, args))
            else:
                _die(6, "unknown_command", f"no handler for service {args.service_cmd!r}")
        elif args.cmd == "database":
            if args.database_cmd == "delete":
                out(cmd_delete(c, "databases", args.uuid, args))
            elif args.database_cmd == "create":
                out(cmd_database_create(c, args))
            else:
                _die(6, "unknown_command",
                     f"no handler for database {args.database_cmd!r}")
        elif args.cmd == "env":
            if args.env_cmd == "list":
                out(cmd_env_list_typed(c, args.uuid, args.rtype))
            elif args.env_cmd == "set":
                out(cmd_env_set_typed(c, args.uuid, args.key, env_value, args.rtype))
            elif args.env_cmd == "rm":
                out(cmd_env_rm_typed(c, args.uuid, args.key, args.rtype))
            elif args.env_cmd == "bulk":
                env_data = sys.stdin.read()
                out(cmd_env_bulk(c, args.uuid, env_data, args.rtype))
            else:
                _die(6, "unknown_command", f"no handler for env {args.env_cmd!r}")
        else:
            _die(6, "unknown_command", f"no handler for {args.cmd!r}")


if __name__ == "__main__":
    main()
