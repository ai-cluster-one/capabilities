             "target": "{agent_home}/.local/state/capabilities/projects"},
            {"name": "claude_state", "kind": "shared",
             "target": "{agent_home}/.claude"},
            {"name": "codex_state", "kind": "shared",
             "target": "{agent_home}/.codex"},
        ],
        "restart": "unless-stopped",
        "doctor": ["automations", "service", "doctor"],
    },
}

_CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
