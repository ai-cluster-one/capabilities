#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "capabilities-contract>=0.12,<1",
#     "callva-harness-runner==0.10.1",
# ]
# ///
"""automations — project-local scheduler and subprocess runner.

Automations keeps each automation as a definition in the capabilities store,
scheduled where the project's automations service is placed or on the one
node it names, runs the same way on a developer machine
and in an agent container, and records its runs in the same store.

Configuration:
  capabilities/automations/service/config.toml holds the scheduler's own
  [engine] settings and the [agents] profiles. The automations are not in it.
  For an agent whose records moved into the store (`capabilities migrate`)
  no file holds them: the [engine] settings and agents.default are rows of
  its `automations` settings document (`automations settings`), and each
  profile of [agents.workers] is a harness profile `automations-<name>` in
  harness_profiles, at the agent's scope.

Definitions:
  An automation is a row of automations_definitions in the store the project
  resolves (Run ledger), kept as versions: a change saves a new version and
  the old one stays as history, so a run names the exact version it ran and
  the version names who saved it. Its fields are: the slug that names it; a
  description; the script, as exactly one of a path relative to the project
  root (`script_path`, a file on the node that runs it) or the script itself
  (`script_body`, which reads no file beside itself and starts with a #! line);
  arguments; a five-field numeric cron `schedule` read in its `timezone`
  (default UTC), or none for manual only; the `node` it is pinned to, or
  none to follow the service; `enabled`; `timeout_seconds` (default 300); and `retries` (default 0).
  One run of an automation is active at a time across every node, and a
  firing that finds one is recorded skipped.

  A node schedules the enabled definitions that name it, by the node id its
  service runs under (the id the machine resolves for itself, `capabilities
  node id`; AGENT_NODE_ID overrides it). A definition that names no node
  follows the service: the nodes the project's automations service is placed
  on (`capabilities place automations --node <node>`, `capabilities service
  start|stop automations`), as the store's placement rows say, schedule it,
  and every running daemon does where the store records no placement. A
  definition naming a node the service is not placed on follows the service
  too, since no daemon of the project runs there: moving the service carries
  the automations of the node it left, and a pin holds only to a node the
  service is on. A running daemon reads the placement again within 30
  seconds; where several nodes schedule one automation, each firing is one
  run, taken by whichever claims it first. The stored node is left as saved,
  so a pin takes hold again once the service is placed back on its node.
  Every definition
  saved is announced on the store, so a running daemon on any machine takes
  the change up within a second without a reload, and moving an automation to
  another node touches no file of either. A row the store holds that does
  not validate is skipped and named by `list` and `doctor`, and the others
  run.

  While config.toml still declares [[automations]], every command that reads
  the declaration refuses with exit 6 `definitions_not_imported`, naming the
  import; `import`, `agents` and `agent` still answer.

Scripts:
  A path script is a file in the project; Python files may be ordinary scripts
  or executable PEP-723/shebang scripts. A body is written to a file of its own
  under the state root for the one run and removed after it, and runs through
  its #! line. Either runs in the project root, inherits the daemon
  environment and receives AUTOMATION_ID, AUTOMATION_RUN_ID,
  AUTOMATION_ATTEMPT, AUTOMATION_TRIGGER, AUTOMATION_ENVIRONMENT,
  AUTOMATION_NAMESPACE, AUTOMATION_PROJECT_ROOT, and AUTOMATION_STATE_DIR.

  AUTOMATION_STATE_DIR is a folder on the node that runs the job. State a
  later run needs on any node is recorded with `automations result`: each run
  also receives AUTOMATION_LAST_RESULT, the result the latest started run of
  the same automation recorded, on whichever node it ran, and none when no
  run of it has recorded one.

Commands:
  automations help
  automations doctor [--repair]
      Validate config, definitions, scripts, state storage, and daemon
      status. Fails with `invalid_definitions` naming each stored definition
      that does not validate, and with `missing_scripts` for a script path
      missing on this node. Fails with `config_stale` when the running daemon
      loaded a declaration that has changed since and it has not taken up.
      Fails with `node_idle` when the running daemon's node schedules none
      of the enabled automations - none names it, and none follows the
      service onto it - so a daemon that is alive and scheduling nothing stops
      reading as healthy; `node_idle.placed_on` is where the service is
      placed, null where the store records no placement. `daemon_node` is the node that daemon
      published, null when it published none; `node` is this invocation's.
      Exits 6 `store_not_configured` when the machine has no store to keep
      the definitions and runs in, and 5 when the store cannot be reached.
      `--repair` is accepted and repairs nothing: the tables are created whole
      by their own migration.
  automations list
      The project's automations as their active versions say, each with
      `id`, `version`, `description`, `enabled`, `node`, `follows_service`
      (whether it runs where the service is placed rather than on `node`),
      `scheduled_here` (whether this invocation's node schedules it),
      `script` (its path, or
      null for a body), `body` (whether it is one), `arguments`, `schedule`,
      `timezone`, `timeout_seconds`, `retries`, `created_at` and `created_by`;
      `placed_on`, the nodes the service is placed on (null where the store
      records no placement); and `invalid_definitions` when a row is skipped.
  automations set <automation> [--description TEXT] [--enabled true|false]
                  [--node NODE] [--schedule CRON] [--timezone ZONE]
                  [--timeout SEC] [--retries N] [--script PATH | --body FILE|-]
                  [--arguments JSON] [--base VERSION]
      Save a new version of the automation with the named fields changed, or
      create it when it has no active version and --script or --body is given
      (exit 3 otherwise). At least one field is required; `--flag=VALUE` also
      works. --script makes the script that path and --body the content of
      FILE, or of stdin for `-`, each clearing the other. An empty --node,
      --schedule or --description clears it. --arguments takes a JSON array of
      strings. --description is single-line text of at most 500 characters.
      --base names the version the writer read, refused with exit 6
      `conflict` when another is active now. The whole definition is judged
      before anything is saved (exit 6 `invalid_definition`), and a request
      that changes nothing saves no version. Saving requires an explicit
      project enable, as `service init` does (exit 4 otherwise), and the
      read-only switch refuses it. The answer is
      {"automation", "version", "created", "changed": [fields that moved],
       "item": <as `list` reports it>}.
  automations remove <automation> [--base VERSION]
      Clear the active version, leaving the automation's history and no
      successor. Exit 3 when it has no active version. Gated as `set` is.
  automations history <automation>
      Every version of the automation, oldest first, each whole with
      `version`, `active`, `created_at` and `created_by`.
  automations import [--apply] [--node ENVIRONMENT=NODE ...]
      Move config.toml's [[automations]] into the store, all or none, each as
      a definition whose script stays the file it was. `id` becomes the slug,
      `name` and `description` the description, `every_seconds` the cron that
      fires at that rate (a whole number of minutes under an hour, of hours
      under a day, or one day; anything else is refused), [engine] timezone
      the definition's timezone, and `environments` the one node: the
      environment in force here (AUTOMATIONS_ENVIRONMENT, else
      engine.environment, else development) is this machine's node, and
      --node maps another; an empty node leaves it on none. An enabled
      automation whose environments reach no node, or two, refuses the import
      (exit 6 `definitions_not_importable`), as does an automation the store
      already holds differently (`definition_differs`). `max_parallel`,
      `max_pending` and `overlap` are dropped: one run at a time is fixed. With
      --apply the definitions are saved and the [[automations]] tables and
      engine.timezone are removed from the file, every other byte kept; without
      it nothing is written. Answers {"applied", "node", "environment",
      "config", "automations": [{"automation", "outcome", "node", "schedule",
      "script", "version"?}], "config_rewritten"?}. --apply is gated as `set`
      is.
  automations run <automation-id>
      Enqueue one manual run, for the node the automation is pinned to, or,
      for one that follows the service, for this machine where the service is
      placed here or nowhere recorded, else the first node it is placed on.
      The daemon of that node dispatches it.
  automations runs [--limit N] [--status STATUS]
      List recent run records from the run ledger.
  automations show <run-id>
      Show one run record.
  automations logs <run-id> [--tail N]
      Read the captured stdout/stderr for one run.
  automations cancel <run-id>
      Cancel a pending run or request termination of a running process.
  automations retry <run-id>
      Enqueue a new attempt for a completed run, as `run` places it.
  automations result <text|->
      From inside a job: record a result on the job's own run (AUTOMATION_RUN_ID),
      handed to the next run of the automation as AUTOMATION_LAST_RESULT. `-`
      reads it from stdin, kept exactly as given. It is non-empty text of at
      most 65536 bytes (exit 6 `invalid_result`); recording again replaces
      it. Exit 6 `not_in_a_run` outside a job and `run_not_active` when the
      run is no longer starting or running; refused by the read-only switch.
      Answers {"recorded", "run_id", "automation", "bytes"}; `show` and
      `runs` carry it as `result`.
  automations agents
      List agent profiles and which one is the default.
  automations agent <prompt|-> [--profile NAME] [--schema PATH] [--timeout SEC]
      Run one agent turn in this project and return its answer as JSON. `-`
      reads the prompt from stdin. --schema names a JSON Schema file and makes
      `answer` a parsed object instead of prose.
  automations service init [--force]
      Create project-local config and an example script; the example is
      defined in the store with `set`.
  automations service doctor|run|start|stop|status|logs
      Manage the bundled scheduler service. `run` stays in the foreground for
      Docker Compose; `start` is the local background convenience. `run` and
      `start` refuse with exit 6 `store_not_configured` while the project
      resolves no store (Run ledger), and `status` names the store in force:
      `store`, the level that answered (`project`, `environment` or
      `machine`), `store_sources`, the files or variables it came from, and
      `schema`; or `store` null with `store_error`.
  automations service reload [--timeout SEC]
      Publish an edited config.toml to the daemon already running, without
      stopping the jobs it is running; definitions saved in the store need no
      reload. The configuration is validated first, and a daemon that rejects
      it keeps the one it has. Returns once the daemon publishes the new
      declaration as loaded, so a success is demonstrated rather than assumed.
      Changing the state root or the records backend still needs a real
      restart.
  automations service pause [--reason TEXT]
      Hold this project: its scheduler registers no firing and starts no run
      until resumed, in either mode, and running jobs finish; a manual run
      enqueued meanwhile waits. The pause is paused.json in the project's state
      root, so it outlives a restart, and `service status` reports it as
      `paused`. Answers {"paused", "pause": {"reason", "at", "by"}, "pause_file"}.
  automations service resume
      Lift the pause. Answers {"resumed", "pause_file"}, `resumed` false when
      the project was not paused.
  automations service join
      Put this project on the machine service's opt-in list; see Machine mode.
  automations service leave
      Take this project off it.

Machine mode:
  The same scheduler also runs once per machine, serving every project that
  joined it, so the projects on one machine share one process, one store
  connection per distinct store and an optional cap on the jobs they run at
  once. A project that
  does not join keeps its own daemon exactly as above.

  automations service init --machine [--force]
      Write the machine settings from the template.
  automations service run --machine
      The machine process in the foreground, for a supervisor.
  automations service start --machine [--detached]
      Start the machine process: through the launchd job that supervises it
      when there is one, else detached; --detached starts a copy by hand even
      then.
  automations service status --machine
      The process, its cap and stores, and every project on the list with its
      state.
  automations service doctor --machine
      The supervision probe; a project's own trouble is reported and fails
      nothing.
  automations service reload --machine [--timeout 20]
      Hand it the machine settings on disk, and each project its own
      declaration.
  automations service stop --machine [--timeout 30] [--force]
      Stop it; every project's running jobs are interrupted within that
      project's shutdown grace, as a stop of its own daemon interrupts them.
  automations service logs --machine [--project <id-or-slug>] [--tail 100]
      The machine log, or one project's lines in it.
  automations service leave --machine --project <id-or-slug>
      Take any project off the list from anywhere, one whose folder is gone
      included.
  automations service launch -- <command...>
      What the machine process starts each job through, in the job's project;
      not for direct use.
  automations service declaration
      The project's declaration as the scheduler loads it - its settings and
      its agent profiles - as JSON; what the daemon of an agent whose settings
      are in the store reads at start and on every reload. Not for direct use.

  A project opts in by an act of its own: `automations service join`, run in a
  project that enables automations for itself (`capabilities enable
  automations --project`), puts it on the opt-in list
  $XDG_CONFIG_HOME/automations/service/projects.toml, keyed by its durable id,
  with its root, its slug and when and by whom it joined; `leave` takes it off.
  Only these verbs write the list, atomically and under a lock in the machine
  state root. `join` refuses with exit 6 a project with no durable id it may
  write under (`no_project_identity`) and one whose slug another joined
  project has (`slug_taken`), since the two
  would share a state root. It answers {"joined", "project": {"id", "slug",
  "root"}, "list"}, `joined` false when already on the list, and starts
  nothing.

  Exactly one machine process runs per machine, by the lock in its state root
  $XDG_STATE_HOME/capabilities/machine/automations/, which is also its working
  directory and holds its pid, its status daemon.json and its log. Each
  project it serves keeps its runs in the store resolved for that project's
  root (Run ledger), resolved as it is admitted; a project that resolves none
  is refused with the reason and asked again. It holds one store connection
  for each distinct store, shared by every project on it, reconnects a lost
  one every pass while the projects on other stores go on, and lists them in
  `status --machine` as `stores`. It follows the list without a reload: a
  project that joins is
  served from the first pass at which it can be. For each project it serves it
  holds the project's own daemon.lock and writes the project's daemon.pid and
  daemon.fingerprint, so `service status`, `doctor`, `reload`, `logs`,
  `pause`, `resume` and `inventory` in a joined project work as before and
  speak of the machine process. It loads no project's environment, and its own
  environment supplies no project's AUTOMATIONS_* selectors: each project's
  configuration and selectors are read inside that project's own resolution,
  from its own files, and its definitions from its store, on the link it
  holds for that store. Each job starts through `service launch`, which puts
  the project's .env and .env.local under the job in the job's own process,
  with the project as its working directory and the same variables a project
  daemon hands it. Before every tick for a project it checks again that the
  project is on the list and enables automations for itself. Every run lands
  in the one automations_runs table under the project's id and this node.

  A project the machine process cannot serve is reported with the reason and
  the others are served. `refused`: it does not enable automations for itself,
  its id or slug moved since it joined, or a project-mode daemon holds its lock
  ("a project-mode daemon, pid N, serves this project; stop it there"); asked
  again every second. `error`: its folder is gone, or its declaration does not
  load, which holds the lock and serves nothing until `service reload` there,
  or `reload --machine`, takes one. `paused` while it is paused, `served`
  otherwise. In a joined project `service start` and `run` exit 4
  `joined_to_machine_service`, naming `service leave`, and `service stop`
  exits 4 while the machine process serves it, naming `service pause` and
  `service stop --machine`; a project-mode daemon still serving a project that
  joined may be stopped as ever, and the machine process takes the project at
  its next pass. A project that leaves has its running jobs interrupted, as a
  stop of its own daemon would, and is let go once they have ended.

  The machine settings are $XDG_CONFIG_HOME/automations/service/config.toml,
  written by `init --machine`:

    version = 1
    max_parallel = 8   # jobs running at once across every joined project;
                       # absent, only each project's own limits apply

  Any other key is refused, and no file is no cap. Their fingerprint is what
  `reload --machine` and `doctor --machine` compare; the list is not part of
  it. Under the cap, projects with work are dealt one start each in turn, from
  the project after the last one dealt, each start chosen by that project's
  own queue and limits, so with a cap of one starts go round the projects.

  Every line the service writes, in either mode, reads `<moment> automations
  service [<project-slug>]: <what happened>`. The machine process tags its own
  lines `[machine]`, writes every line to its log, and writes a project's
  lines to that project's daemon.log too. `status --machine` answers `mode`,
  `running`, `pid`, `started_at`, `published_at`, `fingerprint` and
  `current`, `projects_file` (its path and how many joined), `cap`
  (`max_parallel`, `running`, `binding`), `stores` while it runs (for each
  store its projects resolve: `store`, `schema`, `connected`, `error`), and
  `projects`: for every project on the list its slug as `project`,
  `project_id`, `root`, `joined_at`, `joined_by`,
  `present`, `enabled_explicitly`, `state` (`served`, `paused`, `refused`,
  `error`, or null with no machine process) and `reason`, and while it is held
  its `node`, `environment`, `fingerprint`, `reload_error`, `automations`,
  `running` and `pause`. `service status` in a joined project answers `mode` "machine"
  and the machine's word on it under `machine`. `doctor --machine` exits 0
  while the process holds its lock, published its status within twice its
  publish interval, runs the machine settings on disk and holds a connection
  to at least one of the stores it opened; a store that is not connected
  while another is, and a project in `error` or `refused`, fail it not, since
  restarting the process cannot repair a project.

  Under launchd, the machine process writes the job launchd started it as
  into `launchd.json` in its state root: the label XPC_SERVICE_NAME names,
  when launchd reports that job's pid as the process, its parent or its
  process group. While launchd still has that job loaded, `start --machine`
  hands the start to it with `launchctl kickstart` and spawns nothing,
  answering `"started_by": "launchd"` and the `label`, so the process that
  runs is the supervised one; `start --machine --detached` starts a copy by
  hand even then. Where no such job is loaded, `start --machine` starts a
  detached copy. `status --machine` carries `supervisor` (`launchd`, `pid`,
  `last_exit_code`, or null) and, while no machine process runs, a `hint`
  naming how to start it, which `doctor --machine` repeats. `stop --machine`
  stops whichever process runs, and launchd restarts none that exits cleanly,
  so a stopped service stays stopped until it is started again.

  The machine verbs are the one operational use of automations that resolves
  no project and reads no policy row: the process checks each project's own
  explicit enable itself. `join` needs automations enabled for the project
  itself, like `init`, `start` and `run`, and the read-only switch refuses
  `join`, `leave`, `pause` and `resume` as it refuses `init`, `start`, `run`
  and `reload`.

Environment:
  AGENT_NODE_ID            The node this machine schedules for, overriding the id
                           it resolves for itself (`capabilities node id`),
                           matched against each definition's node.
  AUTOMATIONS_ENVIRONMENT  Handed to every job as AUTOMATION_ENVIRONMENT, and the
                           environment `import` maps to this node (default:
                           development).
  AUTOMATIONS_NAMESPACE    Handed to every job as AUTOMATION_NAMESPACE (default:
                           project directory name).
  AUTOMATIONS_CONFIG       Optional config path override; ignored, with a
                           notice, for an agent whose records moved into the
                           store.
  AUTOMATIONS_STATE_DIR    Optional state root override. By default project runtime
                           state lives under $XDG_STATE_HOME/capabilities/projects/
                           <project-slug>/automations.
  AUTOMATIONS_BIN          Absolute path of this CLI, exported into every job so
                           a script can call `automations agent` without
                           resolving anything itself.
  AUTOMATIONS_ENVIRONMENT, AUTOMATIONS_NAMESPACE, AUTOMATIONS_CONFIG and
  AUTOMATIONS_STATE_DIR are read from the process environment first and then from
  the project's .env and .env.local (.local wins), so a project declares one for
  every invocation made in it, `service status` included, without a shell export.

Run ledger:
  Definitions live in the table automations_definitions, and runs, the queue
  and their history in automations_runs, of the PostgreSQL the shared
  capabilities-contract library resolves for the project: the AGENTKIT_DB_*
  keys in its .env.local / .env, then the same keys in the process
  environment, then the machine's store setting file that `capabilities store
  set` writes; the first level that answers is used whole. Each run carries
  its project's id, the node it belongs to, the definition version it was
  queued and run under, and the host that started it; its log stays a file
  on that host. A daemon recovers, claims and counts only its own node's runs,
  and signals a pid only where its host recorded it. A run of another node
  still active past its automation's timeout and the shutdown grace is marked
  interrupted when the automation next fires, so a node that went away holds
  nothing.

Scheduling:
  Each definition carries a numeric five-field cron `schedule` read in its
  timezone, or none (manual only). The ticker only registers due runs and
  dispatches subprocesses; job logic never runs inside the ticker. A firing
  that finds a run of the automation active on any node is recorded skipped.

Agents:
  A script that needs judgement rather than computation runs one agent turn
  through `automations agent`. Profiles live in config.toml under [agents]
  (harness profiles `automations-<name>` once the agent moved, see
  Configuration);
  `sonnet`, `opus` and `haiku` ship with the capability and a project adds its
  own, including codex profiles, under [agents.workers.<name>]. A profile names
  engine, model, effort, mode and timeout_seconds. `mode = "read"` fences the
  turn to reading the project; `mode = "write"` lets it change files; `mode =
  "act"` drops the sandbox entirely, for a worker whose job is to operate tools
  that reach the network and write outside the project. Neither of the last two
  is a shipped default: a scheduled job runs unattended, so the authority it
  holds is declared per profile and read at a glance.

I/O contract:
  Success is JSON on stdout. Failure is {"error": {"code", "message", "hint"?}}
  on stderr with a non-zero exit code.

Contract commands:
  automations stub
  automations manifest --json
  automations connections
  automations guide [<topic>]
  automations ids list|get|set|rm
  automations refs
  automations inventory [--network]
  automations migrate [status]

Inventory:
  `automations inventory` reports one item per automation, by slug, read from
  the store, with where the service is placed. `name` is the slug; `state`
  is disabled | active | other node | enabled, judged by the running daemon's
  node, else
  this invocation's, and `enabled` when a running daemon published none;
  `detail` is the schedule as display text, or `manual`. The facts a program
  reads are `attributes`, by these fixed labels, in this order:
    id              the slug
    description     the description; absent when empty
    schedule_kind   cron | manual
    schedule_value  the cron expression; absent for manual
    timezone        the zone the cron is read in; absent for manual
    script          the script path, or `stored body`
    node            the node it is pinned to; absent when it names none
  Its `service` carries `ok` and, when false, `problem`: the findings
  `doctor` makes of the declaration and the daemon - missing_scripts,
  invalid_definitions, config_stale, node_idle - or why the definitions did
  not load, and none of the run ledger's.

Exit codes:
  0 success · 3 not found · 4 disabled by project policy · 5 runtime failure ·
  6 malformed input, invalid config, or missing project setup
"""

from __future__ import annotations

import argparse
import contextlib
import copy
import hashlib
import importlib.util
import io
import json
import os
import signal
import shutil
import socket
import stat
import tempfile
import subprocess
import sys
import time
import tomllib
import unicodedata
from pathlib import Path
from typing import Any, NoReturn


NAME = "automations"
SUMMARY = (
    "Project-local scheduler and subprocess runner with versioned config, "
    "store-backed run history, concurrency, retries, timeouts, and cancellation."
)
SCOPE = "project"
CRED_KEYS: list = []

# Where this capability's settings live, and the keys it declares; `settings` reads and writes them.
SETTINGS = {'homes': [{'scope': 'project',
            'path': 'service/config.toml',
            'format': 'toml',
            'seed': {'version': 1}},
           {'scope': 'machine',
            'path': 'service/config.toml',
            'format': 'toml',
            'seed': {'version': 1}}],
 'keys': [{'key': 'engine.tick_seconds',
           'label': 'Tick',
           'help': 'Seconds between scheduler ticks.',
           'type': 'number',
           'default': 1.0,
           'scope': 'project',
           'apply': 'reload'},
          {'key': 'engine.max_parallel',
           'label': 'Parallel jobs',
           'help': 'Jobs running at once in this project.',
           'type': 'integer',
           'default': 4,
           'minimum': 1,
           'scope': 'project',
           'apply': 'reload'},
          {'key': 'engine.shutdown_grace_seconds',
           'label': 'Shutdown grace',
           'help': 'Seconds a stop waits for running jobs.',
           'type': 'integer',
           'default': 15,
           'minimum': 0,
           'scope': 'project',
           'apply': 'reload'},
          {'key': 'engine.recovery',
           'label': 'Recovery',
           'help': 'What becomes of a run a restart interrupted.',
           'type': 'enum',
           'choices': ['fail', 'retry'],
           'default': 'fail',
           'scope': 'project',
           'apply': 'reload'},
          {'key': 'max_parallel',
           'label': 'Machine parallel jobs',
           'help': 'Jobs running at once across every joined project; no cap when '
                   'empty.',
           'type': 'integer',
           'minimum': 1,
           'scope': 'machine',
           'apply': 'reload'}]}
WRITE_VERBS: set = set()
WRITE_DEFAULT = False
DOCS_BASE = (
    "https://raw.githubusercontent.com/ai-cluster-one/capabilities/"
    "main/capabilities/automations/guides/"
)
STATE = True
TABLES = True       # automations_* tables in the project's store, built by _tables()
