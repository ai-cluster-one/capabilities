    "Project-local scheduler and subprocess runner with versioned config, "
    "store-backed run history, concurrency, retries, timeouts, and cancellation."
)
SCOPE = "project"
CRED_KEYS: list = []
WRITE_VERBS: set = set()
WRITE_DEFAULT = False
DOCS_BASE = (
    "https://raw.githubusercontent.com/ai-cluster-one/capabilities/"
    "main/capabilities/automations/guides/"
)
STATE = True
POST_INSTALL: list = []
SERVICE = {
    "name": "scheduler",
    "summary": "Project-local scheduler, store-backed queue, and subprocess workers.",
    "verbs": ["init", "doctor", "run", "start", "stop", "status", "logs"],
    "config": "capabilities/automations/service/config.toml",
    "state": "$XDG_STATE_HOME/capabilities/projects/<project-slug>/automations",
    "deploy": {
        "schema": "capabilities.service.deploy.v1",
        "default_policy": "auto",
        "command": ["automations", "service", "run"],
        "environment": {
            "required": [],
            "optional": [
                {"key": "AUTOMATIONS_ENVIRONMENT", "default": "production"},
                {"key": "AUTOMATIONS_NAMESPACE"},
            ],
        },
        "mounts": [
