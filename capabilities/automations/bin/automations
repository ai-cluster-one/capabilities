def _log(message: str) -> None:
    sys.stderr.write(message + "\n")
    sys.stderr.flush()


# >>> contract: capability core (generated — edit contract/preamble.py, run `capabilities sync-contract`) >>>

# --- Error reporting ---------------------------------------------------------

def _die(exit_code: int, code: str, message: str,
         hint: str | None = None, status: int | None = None) -> NoReturn:
    err: dict = {"code": code, "message": message}
    if hint:
        err["hint"] = hint
    if status is not None:
        err["status"] = status
    sys.stderr.write(json.dumps({"error": err}, ensure_ascii=False) + "\n")
    sys.exit(exit_code)


def _emit(value) -> None:
    if isinstance(value, str):
        sys.stdout.write(value)
        if value and not value.endswith("\n"):
            sys.stdout.write("\n")
    else:
        sys.stdout.write(json.dumps(value, ensure_ascii=False, indent=2) + "\n")


# --- Project / file plumbing -------------------------------------------------

def _parse_env_file(path: Path) -> dict:
    """Parse a KEY=VALUE env/dotenv file. Missing/unreadable file -> {}."""
    out: dict = {}
    try:
        text = path.read_text()
    except OSError:
        return out
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        k = k.strip()
        if k.startswith("export "):
            k = k[len("export "):].strip()
        out[k] = v.strip().strip('"').strip("'")
    return out


def _home_dirs() -> set[Path]:
    """Every directory that is a home directory of the account running this.

    $HOME answers for the process and moves wherever a caller points it; the
    password database answers for the account and cannot be pointed anywhere.
    A caller that redirects $HOME - a dev lane, a service under a supervisor, a
    sandbox - would otherwise carry the guard onto the home it invented and stop
    excluding the account's own, which is the one the machine registry sits in.
    """
    import pwd

    homes: set[Path] = set()
    candidates = [Path.home()]
    try:
        account = pwd.getpwuid(os.getuid()).pw_dir
    except (KeyError, OSError):
        account = ""
    # The account's field counts only when it is absolute. An empty or relative
    # one names no directory of its own: it resolves against the cwd, an empty
    # one to the cwd itself, so taken as a home it would stop the walk wherever
    # the process stands. Some service accounts carry an empty field.
    if os.path.isabs(account):
        candidates.append(Path(account))
    for candidate in candidates:
        try:
            homes.add(candidate.resolve())
        except OSError:
            continue
    return homes


def _is_machine_registry(path: Path) -> bool:
    """Whether this `.capabilities/` is a machine registry, not a legacy envelope.

    The two share the name, and only the registry carries `.manager/`. The
    registry $CAPABILITIES_HOME points at names itself even without it.
    """
    registry = Path(os.environ.get("CAPABILITIES_HOME") or (Path.home() / ".capabilities"))
    try:
        if path.resolve() == registry.resolve():
            return True
    except OSError:
        return False
    return (path / ".manager").is_dir()


def _project_root() -> Path | None:
    """Nearest project root, walking up from $CLAUDE_PROJECT_DIR (else cwd):
    the first directory holding capabilities/, legacy .capabilities/,
    .contextkit/config.toml, .env(.local), or .git.
    Markers are read from the filesystem alone: the root is what the envelope
    location is resolved against, so resolving one cannot depend on the other.
    A home directory is never a project root (the machine registry lives in
    one), and a `.capabilities/` that is a machine registry names that registry
    rather than a legacy envelope."""
    start = os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
    here = Path(start).resolve()
    homes = _home_dirs()
    for d in (here, *here.parents):
        if d in homes:
            return None
        legacy = d / ".capabilities"
        # Either marker names a project. `settings.json` is the gate and
        # `project.json` the identity; either one alone is enough.
        if ((d / "capabilities" / "settings.json").is_file()
                or (d / "capabilities" / "project.json").is_file()
                or (d / ".contextkit" / "config.toml").is_file()
                or (legacy.is_dir() and not _is_machine_registry(legacy))
                or (d / ".env").exists()
                or (d / ".env.local").exists() or (d / ".git").is_dir()):
            return d
    return None


_ENVELOPE_HOME: dict = {}


def _validated_project_envelope(root: Path, raw, provider: str) -> Path:
    """Validate the manager/context-owner answer without selecting a fallback."""
    value = str(raw or "").strip()
    if not value:
        _die(6, "project_envelope_empty",
             f"{provider} returned an empty capabilities envelope path")
    candidate = Path(value).expanduser()
    if not candidate.is_absolute():
        _die(6, "project_envelope_relative",
             f"{provider} returned a relative capabilities envelope path: {value!r}")
    try:
        resolved = candidate.resolve()
        resolved.relative_to(root.resolve())
    except (OSError, ValueError):
        _die(6, "project_envelope_outside_project",
             f"{provider} returned a capabilities envelope outside the project: {candidate}")
    return resolved


def _handed_off_envelope(root: Path) -> str:
    """The handoff meant for THIS project root, or "" when there is none.

    `CAPABILITIES_PROJECT_ENVELOPE` is inherited by every descendant process, and
    a descendant does not always stand in the project its parent stood in: a peer
    spawned in another project, or a worker whose cwd sits under a different root,
    must resolve its own envelope. `CAPABILITIES_PROJECT_ENVELOPE_ROOT` names the
    root the handed value answers for, so a handoff that crossed a project
    boundary is passed over instead of being applied to the wrong project. A
    handoff supplied without that companion belongs to whoever launched the
    process and is honored as given, which is how a context owner hands its answer
    over in advance.
    """
    override = os.environ.get("CAPABILITIES_PROJECT_ENVELOPE", "").strip()
    if not override:
        return ""
    scope = os.environ.get("CAPABILITIES_PROJECT_ENVELOPE_ROOT", "").strip()
    if not scope:
        return override
    try:
        if Path(scope).expanduser().resolve() != root.resolve():
            return ""
    except OSError:
        return ""
    return override


ENVELOPE_CACHE_VERSION = 1
IDENTITY_CACHE_VERSION = 1


def _record_file(kind: str, key: str) -> Path:
    """Where the manager records one kind of answer for one absolute project root.

    The file name only buckets roots apart; the entry's own `root` field is what
    proves identity, so two roots landing in one bucket cost a miss rather than
    a wrong answer.
    """
    import zlib

    base = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache"))
    return (base / "capabilities" / kind
            / f"{format(zlib.crc32(key.encode()), '08x')}.json")


def _envelope_witness(path) -> dict:
    """One input a recorded answer rests on, as that input stands right now."""
    try:
        seen = os.stat(path)
    except OSError:
        return {"path": str(path), "present": False}
    return {"path": str(path), "present": True,
            "size": seen.st_size, "mtime_ns": seen.st_mtime_ns}


def _cached_record(kind: str, version: int, root: Path):
    """The recorded entry for this root while every input it rests on holds.

    The manager writes the record and names the inputs its answer consulted; a
    reader re-observes each of them and compares it whole. Anything at all in
    doubt — an unreadable file, an unexpected shape, an input that moved, an
    expiry already behind the clock or a write ahead of it — returns None and
    costs a full resolution, so the failure mode is slow and never wrong.
    """
    import time

    key = str(root.resolve())
    try:
        entry = json.loads(_record_file(kind, key).read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(entry, dict):
        return None
    if entry.get("version") != version or entry.get("root") != key:
        return None
    written, expires = entry.get("written_at"), entry.get("expires_at")
    if not isinstance(written, (int, float)) or not isinstance(expires, (int, float)):
        return None
    now = time.time()
    if now < written or now >= expires:
        return None
    witness = entry.get("witness")
    if not isinstance(witness, list):
        return None
    for observed in witness:
        if (not isinstance(observed, dict)
                or _envelope_witness(observed.get("path")) != observed):
            return None
    return entry


def _cached_envelope(root: Path):
    """The recorded envelope for this root, while its record stands."""
    entry = _cached_record("envelope", ENVELOPE_CACHE_VERSION, root)
    if entry is None:
        return None
    envelope = Path(str(entry.get("envelope") or ""))
    if not envelope.is_absolute():
        return None
    try:
        envelope.resolve().relative_to(entry["root"])
    except (OSError, ValueError):
        return None
    return envelope


def _ask_manager(root: Path, *flags: str) -> tuple:
    """`capabilities path --json` for this root: (answer, None) or (None, error).

    The error carries the exit code the caller should use and the manager's own
    code, message and hint where it gave them."""
    import subprocess

    env = dict(os.environ)
    env["CLAUDE_PROJECT_DIR"] = str(root)
    # Asked at all, the manager answers from ContextKit: a live id hand-down for
    # this root is used before asking, so any in the environment is this
    # process's own and must not come back as the answer.
    env.pop("CAPABILITIES_PROJECT_ID", None)
    env.pop("CAPABILITIES_PROJECT_ID_ROOT", None)
    manager = os.environ.get("CAPABILITIES_MANAGER_BIN", "").strip()
    if not manager:
        source_manager = Path(__file__).resolve().parents[3] / "bin" / "capabilities"
        manager = str(source_manager) if source_manager.is_file() else "capabilities"
    try:
        proc = subprocess.run(
            [manager, "path", "--json", *flags], cwd=root, env=env,
            capture_output=True, text=True, timeout=10)
    except FileNotFoundError:
        return None, {"exit": 6, "code": "capabilities_manager_unavailable",
                      "message": "the capabilities manager is required to resolve the project",
                      "hint": "install or repair the `capabilities` command"}
    except subprocess.TimeoutExpired:
        return None, {"exit": 6, "code": "capabilities_path_timeout",
                      "message": "the capabilities manager did not resolve the project within 10 seconds"}
    except OSError as exc:
        return None, {"exit": 6, "code": "capabilities_manager_unavailable",
                      "message": f"could not run the capabilities manager: {exc}"}
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip()
        try:
            error = json.loads(detail).get("error", {})
        except (AttributeError, ValueError):
            error = {}
        return None, {"exit": proc.returncode if proc.returncode in (3, 4, 5, 6) else 6,
                      "code": str(error.get("code") or "capabilities_path_failed"),
                      "message": str(error.get("message") or "the capabilities manager could not resolve the project"),
                      "hint": str(error.get("hint") or detail or "run `capabilities path --json` for details")}
    try:
        answer = json.loads(proc.stdout)
    except ValueError as exc:
        return None, {"exit": 6, "code": "capabilities_path_malformed",
                      "message": f"the capabilities manager returned invalid JSON: {exc}"}
    if not isinstance(answer, dict):
        return None, {"exit": 6, "code": "capabilities_path_malformed",
                      "message": "the capabilities manager path answer must be a JSON object"}
    manager_root = Path(str(answer.get("project_root") or ""))
    if not manager_root.is_absolute() or manager_root.resolve() != root.resolve():
        return None, {"exit": 6, "code": "capabilities_project_mismatch",
                      "message": "the capabilities manager resolved a different project root"}
    return answer, None


def _manager_project_envelope(root: Path) -> Path:
    """Consume the capabilities manager's one authoritative project answer."""
    override = _handed_off_envelope(root)
    if override:
        return _validated_project_envelope(root, override, "environment handoff")
    answer, error = _ask_manager(root)
    if error:
        _die(error["exit"], error["code"], error["message"], error.get("hint"))
    provider = str(answer.get("provider") or "capabilities manager")
    return _validated_project_envelope(
        root, answer.get("project_envelope"), provider)


def _envelope_home(root: Path) -> Path:
    """The project's envelope root, resolved once per invocation.

    The capabilities manager owns project-envelope discovery, including any
    delegation to ContextKit. Capability CLIs consume that answer and never
    duplicate context-owner detection.

    The answer is then handed to this process's descendants, scoped to the root
    it answers for. Asking for it costs two interpreter starts — the manager and
    the context owner it delegates to — so a worker, a peer, or a nested
    capability call that would otherwise repeat the whole chain under whatever
    load the machine is under by then reads it instead.

    A fresh top-level call has no such handoff, and reads the manager's recorded
    answer for this root instead, which stands only while every input that answer
    rests on is unchanged. A live handoff outranks the record, and any doubt about
    the record asks the manager again.
    """
    cached = _ENVELOPE_HOME.get(root)
    if cached is not None:
        return cached
    home = None if _handed_off_envelope(root) else _cached_envelope(root)
    if home is None:
        home = _manager_project_envelope(root)
    _ENVELOPE_HOME[root] = home
    os.environ["CAPABILITIES_PROJECT_ENVELOPE"] = str(home)
    os.environ["CAPABILITIES_PROJECT_ENVELOPE_ROOT"] = str(root)
    # The id travels with the envelope: resolved at read level, handed down
    # only where a write may stamp it, and never a reason to refuse here.
    try:
        _project_id_state_at(root)
    except Exception:
        pass
    return home


def _project_capabilities_dir(root: Path) -> Path:
    """The active project envelope root.

    The resolved envelope is canonical. A legacy `.capabilities/` remains
    readable until `capabilities init` migrates it. If both exist, the canonical
    tree wins once it carries either the legacy file gate or the project identity;
    otherwise the legacy configured tree remains active so merely creating an
    empty visible directory loses no gate.
    """
    current = _envelope_home(root)
    legacy = root / ".capabilities"
    if ((current / "settings.json").is_file()
            or (current / "project.json").is_file()
            or not legacy.is_dir()):
        return current
    return legacy


_CONTEXT_IDENTITY: dict = {}


def _context_identity(root: Path) -> dict:
    """Whether a context owner binds this project, and the id it holds for it.

    The capabilities manager owns the answer, as it owns the envelope's: this
    reads the manager's record while every input it rests on stands, and asks
    the manager otherwise. `{"bound", "id"}`, or `{"error"}` when the manager
    cannot answer, which leaves reads on project.json and refuses writes."""
    root = root.resolve()
    known = _CONTEXT_IDENTITY.get(root)
    if known is not None:
        return known
    if not (root / ".contextkit" / "config.toml").is_file():
        # The binding the manager asks ContextKit about is absent, so the
        # manager's answer is already known: unbound, with no id of its own.
        _CONTEXT_IDENTITY[root] = {"bound": False, "id": None}
        return _CONTEXT_IDENTITY[root]
    entry = _cached_record("identity", IDENTITY_CACHE_VERSION, root)
    if (entry is not None and isinstance(entry.get("bound"), bool)
            and (entry.get("id") is None or isinstance(entry.get("id"), str))):
        answer = {"bound": entry["bound"], "id": entry.get("id")}
    else:
        reply, error = _ask_manager(root, "--identity")
        state = (reply or {}).get("project_identity")
        if error or not isinstance(state, dict) or not isinstance(state.get("bound"), bool):
            answer = {"error": error or {
                "code": "capabilities_path_malformed",
                "message": "the capabilities manager returned no project identity"}}
        else:
            answer = {"bound": state["bound"], "id": state.get("contextkit_id") or None}
    _CONTEXT_IDENTITY[root] = answer
    return answer


def _identity_verdict(bound: bool, contextkit_id, cached_id) -> dict:
    """Which id a project answers to, from the three facts that decide it.

    Unbound, the project's own project.json is the source. Bound, ContextKit's
    id is authoritative and project.json holds at most its copy; until
    ContextKit has an id, the copy is the id it will adopt."""
    if not bound:
        return {"state": "unbound", "id": cached_id}
    if contextkit_id is None:
        return {"state": "pending", "id": cached_id}
    if cached_id is not None and cached_id != contextkit_id:
        return {"state": "mismatch", "id": contextkit_id}
    return {"state": "adopted", "id": contextkit_id}


def _identity_refusal(state: dict):
    """Why a write may not stamp this project's id, or None when it may.

    An unbound project without an id is left to the caller, whose refusal
    already names `capabilities init`."""
    if state["state"] == "unresolved":
        return state["error"]
    if state["state"] == "mismatch":
        return {"code": "project_id_mismatch",
                "message": f"project.json holds project id {state['project_json_id']}, "
                           f"but ContextKit answers {state['contextkit_id']}",
                "hint": "reconcile the two by hand: ContextKit's id is the "
                        "project's, and project.json keeps only its copy"}
    if state["state"] == "pending" and not state["id"]:
        return {"code": "project_id_unassigned",
                "message": "this project's ContextKit identity has no id yet",
                "hint": "run `contextkit identity adopt` in the project"}
    return None


def _handed_off_project_id(root: Path) -> str:
    """The project id handed down for THIS root, or "" when there is none.

    A process that resolved an id a write may stamp hands it to its descendants
    beside the envelope, as `CAPABILITIES_PROJECT_ID`, scoped by
    `CAPABILITIES_PROJECT_ID_ROOT` the way the envelope handoff is scoped: one
    that crossed a project boundary is passed over, and one supplied without the
    companion belongs to whoever launched the process and is honored as given.
    """
    handed = os.environ.get("CAPABILITIES_PROJECT_ID", "").strip()
    if not handed:
        return ""
    scope = os.environ.get("CAPABILITIES_PROJECT_ID_ROOT", "").strip()
    if not scope:
        return handed
    try:
        if Path(scope).expanduser().resolve() != root.resolve():
            return ""
    except OSError:
        return ""
    return handed


_PROJECT_ID_HANDED: dict = {}


def _project_id_state():
    """The id of the project this command stands in, where it came from, and
    whether a write may stamp it; None outside a project.

    A live handoff for this root outranks ContextKit, as the envelope handoff
    outranks the record: the process that handed it verified it. Otherwise the
    manager's answer decides. An id a write may stamp is handed on to this
    process's descendants. Reading it asks no records backend: the id is what
    selects a project's records, so it is read before any of them."""
    root = _project_root()
    if root is None:
        return None
    return _project_id_state_at(root)


def _project_id_state_at(root: Path) -> dict:
    """`_project_id_state` for a known project root."""
    try:
        declared = json.loads((_project_capabilities_dir(root) / "project.json").read_text())
    except (OSError, ValueError):
        declared = None
    cached = (str(declared.get("id") or "").strip() or None
              if isinstance(declared, dict) else None)
    handed = _handed_off_project_id(root)
    if handed and _PROJECT_ID_HANDED.get(str(root)) == handed:
        handed = ""  # this process's own hand-down, not its launcher's
    if handed:
        state = _identity_verdict(True, handed, cached)
        if state["state"] != "mismatch":
            state["state"] = "handed"
        state.update(bound=None, contextkit_id=handed)
    else:
        context = _context_identity(root)
        if "error" in context:
            state = {"state": "unresolved", "id": cached, "bound": True,
                     "contextkit_id": None, "error": context["error"]}
        else:
            state = _identity_verdict(context["bound"], context["id"], cached)
            state.update(bound=context["bound"], contextkit_id=context["id"])
    state["project_json_id"] = cached
    if not handed and state["id"] and _identity_refusal(state) is None:
        os.environ["CAPABILITIES_PROJECT_ID"] = state["id"]
        os.environ["CAPABILITIES_PROJECT_ID_ROOT"] = str(root)
        _PROJECT_ID_HANDED[str(root)] = state["id"]
    return state


def _project_id(write: bool = False, refuse: bool = True):
    """The project id this command stands in, or None where there is none.

    A read takes the id in every state. A write that stamps it takes it only
    once it is verified for this invocation, and otherwise exits 6 naming what
    to settle, or, with `refuse=False`, answers None so a read path that would
    stamp the id can leave that step out instead of refusing. An unbound project
    that declares no id is still None, left to the caller's own refusal."""
    state = _project_id_state()
    if state is None:
        return None
    if write:
        refusal = _identity_refusal(state)
        if refusal:
            if not refuse:
                return None
            _die(6, refusal["code"], refusal["message"], refusal.get("hint"))
    return state["id"]


def _project_env() -> dict:
    """Project .env(.local) at the project root. .env.local overrides .env."""
    root = _project_root()
    if root is None:
        return {}
    merged = _parse_env_file(root / ".env")
    merged.update(_parse_env_file(root / ".env.local"))  # .local wins
    return merged


def _auth_context() -> dict | None:
    """Optional runtime authority envelope passed by an ingress/service.

    Absence means the ordinary project gate is the whole policy. Presence means
    a request-scoped authority layer exists and must fail closed before any
    credential or network work happens.
    """
    raw = os.environ.get("CAPABILITIES_AUTH_CONTEXT")
    if not raw:
        return None
    try:
        if raw.lstrip().startswith("{"):
            data = json.loads(raw)
        else:
            data = json.loads(Path(raw).read_text())
    except (OSError, ValueError) as e:
        _die(4, "auth_context_unreadable",
             "runtime authority context could not be read",
             f"{raw}: {e}")
    if not isinstance(data, dict):
        _die(4, "auth_context_invalid",
             "runtime authority context is not an object")
    return data


def _auth_capability_allowed(rule) -> bool:
    if rule is True or rule == "*":
        return True
    if rule in (False, None):
        return False
    if isinstance(rule, list):
        return True
    if isinstance(rule, dict):
        if rule.get("deny") is True:
            return False
        if rule.get("enabled") is False or rule.get("allow") is False:
            return False
        return True
    return False


# Verbs a rule's verb list never withholds: they say what the capability is and
# how it is configured, which is what an agent should reach for before acting.
_AUTH_CONTRACT_VERBS = frozenset(
    {"help", "guide", "ids", "connections", "refs", "stub", "manifest"})


def _auth_rule_verbs(rule) -> list | None:
    """The verbs a capability rule limits its grant to, or None when it grants
    the whole capability. A bare list is shorthand for {"verbs": [...]}."""
    if isinstance(rule, list):
        verbs = rule
    elif isinstance(rule, dict) and "verbs" in rule:
        verbs = rule["verbs"]
    else:
        return None
    if not isinstance(verbs, list) or not all(isinstance(v, str) for v in verbs):
        _die(4, "auth_context_invalid",
             f"runtime authority context has invalid verbs for {NAME}",
             "verbs must be a list of verb names")
    return verbs


def _auth_gate() -> None:
    ctx = _auth_context()
    if ctx is None:
        return
    allowed = ctx.get("allowed_capabilities")
    if allowed is None:
        return
    if allowed is True or allowed == "*":
        return
    source = ctx.get("source") or "runtime"
    role = ctx.get("sender_role") or ctx.get("role") or "unknown"
    chat = ctx.get("chat_id") or "unknown"
    if isinstance(allowed, list):
        if NAME in allowed or "*" in allowed:
            return
    elif isinstance(allowed, dict):
        rule = allowed.get(NAME, allowed.get("*"))
        if _auth_capability_allowed(rule):
            verbs = _auth_rule_verbs(rule)
            verb = sys.argv[1] if len(sys.argv) > 1 else "help"
            if verbs is None or verb in verbs or verb in _AUTH_CONTRACT_VERBS:
                return
            _die(4, "verb_not_authorized",
                 f"verb refused: `{NAME} {verb}` is not among the verbs this "
                 f"{source} request may run ({', '.join(verbs) or 'none'})",
                 f"role={role}; chat_id={chat}; adjust runtime authority policy instead of bypassing the gate")
    else:
        _die(4, "auth_context_invalid",
             "runtime authority context has invalid allowed_capabilities")
    _die(4, "capability_not_authorized",
         f"{NAME} is not authorized for this {source} request",
         f"role={role}; chat_id={chat}; adjust runtime authority policy instead of bypassing the gate")


def _policy_row():
    """The effective policy row from the same records adapter as everything else."""
    try:
        row = _records().resolve("capabilities", "policy").get(NAME)
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)
    if row is None:
        return None
    entry = row.get("value")
    if (not isinstance(entry, dict) or set(entry) != {"enabled"}
            or not isinstance(entry.get("enabled"), bool)):
        _die(6, "bad_policy",
             f"invalid {NAME} policy entry in {_records().source}",
             'expected {"enabled": true|false}')
    return row


def _project_enabled_explicitly() -> bool:
    """True only for an explicit project enabled entry; global inheritance is
    deliberately insufficient for project-owned service activation."""
    row = _policy_row()
    return bool(row and row.get("scope") == "project"
                and row["value"].get("enabled") is True)


def _require_project_enabled_for_service() -> Path:
    root = _project_root()
    if root is None or not _project_enabled_explicitly():
        _die(4, "project_enable_required",
             f"{NAME} service activation requires an explicit project enable",
             f"ask the user, then run `capabilities enable {NAME} --project` "
             "before service init/start/run")
    return root


def _read_only_gate(action: str) -> None:
    """Refuse `action` when this process runs under the read-only switch.

    The switch is decided by the store tier's `read_only_switch`; this is the
    one refusal every writer that consults it gives, so a caller branches on one
    code, and that code is distinct from a connection's own read-only grant."""
    if read_only_switch():
        _die(4, "read_only_switch",
             f"{action} is refused: {READ_ONLY_ENV} is set, so {NAME} may read "
             "but change nothing in this process",
             "Do not lift the switch yourself — ask the user; the change has to "
             f"run in a process without {READ_ONLY_ENV}.")


_MACHINE_SCHEMA = "capabilities.machine.v1"


def _machine_state() -> str:
    """This machine's ceiling for this capability: `allowed` or `quarantined`.

    The manager alone writes `$XDG_CONFIG_HOME/capabilities/machine.json`. A
    capability with no entry, and every capability while the file is absent,
    is allowed, so the ceiling only ever closes what the two scopes open."""
    path = _CONFIG_HOME / "capabilities" / "machine.json"
    try:
        data = json.loads(path.read_text())
    except FileNotFoundError:
        return "allowed"
    except (OSError, ValueError) as e:
        _die(6, "bad_machine_state", f"cannot read the machine ceiling {path}: {e}",
             "the manager alone writes it; `capabilities list` reports each "
             "capability's machine state")
    entries = data.get("capabilities") if isinstance(data, dict) else None
    if (not isinstance(data, dict) or data.get("schema") != _MACHINE_SCHEMA
            or not isinstance(entries, dict)):
        _die(6, "bad_machine_state", f"{path} is not a machine ceiling",
             f'expected {{"schema": "{_MACHINE_SCHEMA}", "capabilities": {{...}}}}')
    entry = entries.get(NAME)
    if entry is None:
        return "allowed"
    state = entry.get("state") if isinstance(entry, dict) else None
    if state not in ("allowed", "quarantined"):
        _die(6, "bad_machine_state", f"invalid {NAME} entry in {path}",
             'expected {"state": "allowed"|"quarantined", "at": ..., "by": ...}')
    return state


def _machine_gate() -> None:
    """The ceiling above both scopes: quarantined is disabled everywhere."""
    if _machine_state() == "quarantined":
        _die(4, "quarantined",
             f"{NAME} is quarantined on this machine, so no project and no "
             "machine service may use it, whatever project or global policy says",
             f"ask the user whether to allow {NAME} on this machine; if yes, they "
             f"run `capabilities allow {NAME}` - an agent never lifts a "
             "quarantine itself")


def _gate() -> None:
    """Project policy overrides global policy; absence inherits, and absence at
    both scopes is default deny. Safe local discovery verbs remain available so
    a disabled capability can be understood and configured before use.

    If an ingress supplied CAPABILITIES_AUTH_CONTEXT, that request-scoped gate
    is stricter and runs first, before credentials or network calls. The
    machine ceiling runs next: a capability quarantined on this machine is
    refused before any project or policy row is resolved.

    Under the read-only switch a bundled service is neither set up nor started
    nor handed a new declaration.

    A service that declares `machine` takes `--machine` on its service verbs;
    such a call resolves no project and reads no policy row, because the
    machine service checks each opted-in project's own policy before every
    action it takes for that project. `join` is a project act and always takes
    the ordinary path.

    `migrate` of a capability that declares `TABLES` acts on the machine's
    store rather than for a project, so it too reads no policy row: it answers
    to the machine ceiling, and `migrate` (not `migrate status`) to the
    read-only switch.
    """
    _auth_gate()
    verb = sys.argv[1] if len(sys.argv) > 1 else "help"
    safe = verb in {"help", "stub", "manifest", "connections"}
    if not safe:
        _machine_gate()
    service_action = sys.argv[2] if len(sys.argv) > 2 else None
    if verb == "migrate" and _tables_declared():
        if service_action != "status":
            _read_only_gate(f"`{NAME} migrate`")
        return
    service_contract = globals().get("SERVICE")
    service_call = isinstance(service_contract, dict) and verb == "service"
    machine_service = service_call and isinstance(service_contract.get("machine"), dict)
    if service_call and (service_action in {"init", "start", "run", "reload"}
                         or (machine_service and service_action in {"join", "leave"})):
        _read_only_gate(f"`{NAME} service {service_action}`")
    if machine_service and service_action != "join" and "--machine" in sys.argv[3:]:
        return
    if service_call and (service_action in {"init", "start", "run"}
                         or (machine_service and service_action == "join")):
        _require_project_enabled_for_service()
    if safe:
        return
    row = _policy_row()
    entry = row.get("value") if row else None
    scope = row.get("scope") if row else None
    if isinstance(entry, dict) and entry.get("enabled") is True:
        return
    if isinstance(entry, dict) and entry.get("enabled") is False and scope == "project":
        _die(4, "disabled",
             f"{NAME} is disabled in this project ({_records().source})",
             f"ask the user whether to enable {NAME} for this project; if yes, "
             f"run `capabilities enable {NAME} --project`")
    if isinstance(entry, dict) and entry.get("enabled") is False:
        message = f"{NAME} is disabled globally ({_records().source})"
    else:
        message = f"{NAME} is not enabled by project or global policy"
    _die(4, "not_enabled", message,
         f"ask the user whether to enable {NAME} only for this project or "
         f"globally for every project; then run `capabilities enable {NAME} "
         "--project` or `--global` exactly as requested")


def _invoked_verb() -> str | None:
    """The verb this process was invoked with: its first argument once the
    contract's own `--connection <id>` selection is lifted out of the way."""
    argv = sys.argv[1:]
    i = 0
    while i < len(argv):
        if argv[i] == "--connection":
            i += 2
        elif argv[i].startswith("--connection="):
            i += 1
        else:
            return argv[i]
    return None


def _machine_read(verb: str | None = None) -> bool:
    """Whether `verb`, else the invoked one, is a machine read here.

    Outside any project there is no scope a grant could have been written in,
    so a verb the capability declares in `MACHINE_READS` uses the machine's own
    connections instead, read-only. Inside a project the grant model alone
    decides, and a capability that declares nothing has no machine reads."""
    declared = globals().get("MACHINE_READS")
    if not declared or not isinstance(declared, tuple):
        return False
    if _project_root() is not None:
        return False
    return (verb if verb is not None else _invoked_verb()) in declared


def _policy_state() -> dict:
    """This capability's effective policy, in the words `capabilities list`
    uses: `effective` enabled or disabled, the `source` that decided it -
    `machine` (the ceiling), `project`, `global` or `default` - and the
    `machine` ceiling itself. A record that cannot be read is reported as the
    refusal the gate would give, so the report around it still answers."""
    import contextlib
    import io
    errors = io.StringIO()
    try:
        with contextlib.redirect_stderr(errors):
            machine = _machine_state()
            row = None if machine == "quarantined" else _policy_row()
    except SystemExit:
        lines = errors.getvalue().strip().splitlines()
        try:
            return {"error": json.loads(lines[-1])["error"]}
        except (IndexError, ValueError, KeyError, TypeError):
            return {"error": {"code": "policy_unreadable",
                              "message": errors.getvalue().strip()}}
    if machine == "quarantined":
        return {"effective": "disabled", "source": "machine", "machine": machine}
    if row is None:
        return {"effective": "disabled", "source": "default", "machine": machine}
    return {"effective": "enabled" if row["value"]["enabled"] else "disabled",
            "source": row.get("scope"), "machine": machine}


def _env_dir() -> Path | None:
    """The capability's envelope dir in the project's active capabilities/."""
    root = _project_root()
    return (_project_capabilities_dir(root) / NAME) if root is not None else None


_RECORDS = None


def _records():
    """The adapter this project's records are read and written through: the
    project's envelope, then the user's config home. Everything below asks it
    for a collection, never for a path."""
    global _RECORDS
    if _RECORDS is None:
        root = _project_root()
        envelope = (_project_capabilities_dir(root) if root is not None
                    else _CONFIG_HOME / "no-project")
        try:
            project_only = os.environ.get("CAPABILITIES_RECORDS_PROJECT_ONLY", "") \
                .strip().lower() in ("1", "true", "yes", "on")
            _RECORDS = open_records(
                envelope, _CONFIG_HOME, project_only=project_only)
        except StoreError as e:
            _die(6, e.slug, e.message, e.hint)
    return _RECORDS


def _project_identity() -> dict:
    root = _project_root()
    if root is None:
        _die(6, "no_project", "no project here to resolve records for")
    identity_file = _project_capabilities_dir(root) / "project.json"
    try:
        identity = json.loads(identity_file.read_text())
    except (OSError, ValueError) as e:
        _die(6, "no_project_identity", f"cannot read {identity_file}: {e}",
             "run `capabilities init` in the project")
    if not identity.get("slug"):
        _die(6, "no_project_identity", f"{identity_file} declares no slug")
    return identity


def _state_dir() -> Path:
    """State follows the scope of the credentials that minted it; project state
    lands inside the envelope only where capabilities/ already exists."""
    if SCOPE == "project":
        root = _project_root()
        if root is not None:
            envelope = _project_capabilities_dir(root)
            if ((envelope / "project.json").is_file()
                    or (envelope / "settings.json").is_file()):
                return envelope / NAME / "state"
    return _STATE_HOME / NAME


# --- Capability contract — the declaration surface --------------------------

def _docs_base() -> str:
    key = f"{NAME.upper()}_DOCS_BASE"
    return (_project_env().get(key)
            or _parse_env_file(CREDENTIALS_ENV).get(key)
            or os.environ.get(key)
            or DOCS_BASE)


def _guide_dir() -> Path:
    executable = Path(__file__).resolve()
    bundle = (executable.parent.parent
              if executable.parent.name == "bin" else executable.parent)
    return bundle / "guides"


def _guide_menu() -> list[dict[str, str]]:
    menu = []
    guide_dir = _guide_dir()
    files = sorted(guide_dir.glob("*.md")) if guide_dir.is_dir() else []
    for path in files:
        lines = path.read_text().splitlines()
        title = ""
        title_index = -1
        for index, line in enumerate(lines):
            if line.startswith("# "):
                title = line[2:].strip()
                title_index = index
                break
        paragraph = []
        for line in lines[title_index + 1:]:
            stripped = line.strip()
            if not stripped:
                if paragraph:
                    break
                continue
            if stripped.startswith("#"):
                break
            paragraph.append(stripped)
        topic = path.stem
        menu.append({
            "topic": topic,
            "title": title,
            "preview": " ".join(paragraph),
            "command": f"{NAME} guide {topic}",
        })
    return menu


def _cmd_guide(argv: list[str]) -> None:
    menu = _guide_menu()
    if not argv:
        _emit(menu); return
    topic = argv[0]
    topics = {entry["topic"] for entry in menu}
    if topic not in topics:
        _die(3, "not_found", f"no guide topic {topic!r}",
             f"run `{NAME} guide` to list available guides")
    import urllib.error as _ue
    import urllib.request as _ur
    url = _docs_base().rstrip("/") + "/" + topic + ".md"
    cache_dir = _STATE_HOME / NAME / "guides"
    cache, etag_f = cache_dir / f"{topic}.md", cache_dir / f"{topic}.etag"
    headers = {}
    if cache.exists() and etag_f.exists():
        headers["If-None-Match"] = etag_f.read_text().strip()
    try:
        req = _ur.Request(url, headers=headers)
        with _ur.urlopen(req, timeout=10.0) as resp:
            text = resp.read().decode(resp.headers.get_content_charset() or "utf-8")
            cache_dir.mkdir(parents=True, exist_ok=True)
            cache.write_text(text)
            if resp.headers.get("etag"):
                etag_f.write_text(resp.headers["etag"])
            _emit(text); return
    except _ue.HTTPError as e:
        if e.code == 304 and cache.exists():
            _emit(cache.read_text()); return
        if e.code == 404:
            _die(3, "not_found", f"guide {topic!r} missing upstream", url)
        err = f"upstream returned {e.code}"
    except _ue.URLError as e:
        err = str(e.reason)
    except OSError as e:
        err = str(e)
    if cache.exists():
        sys.stderr.write(json.dumps(
            {"warning": f"upstream unreachable; serving cached copy ({err})"},
            ensure_ascii=False) + "\n")
        _emit(cache.read_text()); return
    _die(5, "network_error", f"could not fetch guide {topic!r}; no cache exists", url)


def _render_ids_markdown(data: dict) -> str:
    """Render the {label: {value, note}} envelope as the labelled markdown
    list the manager's `capabilities ids <NAME>` also produces — one shared
    format across the ids surface and the identifiers section of `help`."""
    lines: list[str] = []
    for label, entry in sorted(data.items()):
        entry = entry if isinstance(entry, dict) else {"value": entry}
        v = entry.get("value")
        vs = f"`{v}`" if isinstance(v, str) else "`" + json.dumps(v, ensure_ascii=False) + "`"
        line = f"- **{label}**: {vs}"
        note = entry.get("note")
        if note:
            line += f" — {note}"
        lines.append(line)
    return "\n".join(lines)


def _identifiers_load() -> dict:
    """The identifiers envelope, resolved through the records adapter, in one
    shape — `{label: {value, note}}` — for the help section, the report and
    `ids get`."""
    try:
        resolved = _records().resolve(NAME, "identifier")
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)
    return {label: {"note": row["note"] or "", "value": row["value"]}
            for label, row in sorted(resolved.items())}


def _identifiers_write(label: str, value, note: str) -> None:
    """Rule 15: a capability is the sole writer of its own identifiers,
    addressed by (capability, collection) rather than by path."""
    kept = note or (_identifiers_load().get(label) or {}).get("note", "")
    try:
        _records().set(NAME, "identifier", label, value,
                       actor=f"{NAME} ids set", note=kept or None)
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)


def _identifiers_remove(label: str) -> None:
    try:
        _records().delete(NAME, "identifier", label)
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)


def _identifiers_section() -> str:
    """The Identifiers block appended to the bare top-level help — deterministic
    first-touch surfacing of `capabilities/<NAME>/identifiers.json` so an
    agent following the `<NAME> help` startup protocol loads the discovered
    labels/values/notes into context at once. Empty when no project envelope
    or nothing recorded (do not bloat help with an empty section)."""
    data = _identifiers_load()
    if not data:
        return ""
    header = (
        "\n═══ Identifiers ═════════════════════════════════════════════════════════════\n\n"
        f"Structural lookups discovered for `{NAME}` in this project. Fetch a single\n"
        f"raw value with `{NAME} ids get <label>`; the full envelope is also at\n"
        f"`capabilities ids {NAME}`.\n\n"
    )
    return header + _render_ids_markdown(data) + "\n"


def _cmd_help() -> None:
    """Bare top-level help: the CLI's HELP body (module-level `HELP` if
    defined, else the module docstring), then the project's Identifiers
    section. Only fires when no extra args follow — per-verb help stays
    untouched so `<NAME> help <subcommand>` is not intercepted."""
    g = globals()
    text = g.get("HELP") or g.get("__doc__") or ""
    if text.startswith("\n"):
        text = text.lstrip("\n")
    sys.stdout.write(text)
    if text and not text.endswith("\n"):
        sys.stdout.write("\n")
    section = _identifiers_section()
    if section:
        sys.stdout.write(section)


def _cmd_ids(argv: list[str]) -> None:
    sub = argv[0] if argv else "list"
    data = _identifiers_load()
    if sub == "list":
        _emit(data); return
    if sub == "get":
        if len(argv) < 2 or argv[1] not in data:
            _die(3, "not_found", "unknown identifier label",
                 f"`{NAME} ids list` shows the labels")
        _emit((data[argv[1]] or {}).get("value")); return
    if sub in ("set", "rm"):
        _read_only_gate(f"`{NAME} ids {sub}`")
    if sub == "set":
        if len(argv) < 3:
            _die(6, "input", f"usage: {NAME} ids set <label> <value> [--note <text>]")
        label, raw = argv[1], argv[2]
        try:
            value = json.loads(raw)
        except ValueError:
            value = raw
        note = ""
        if "--note" in argv:
            ni = argv.index("--note")
            if ni + 1 >= len(argv):
                _die(6, "input", "--note needs a value")
            note = argv[ni + 1]
        _identifiers_write(label, value, note)
        _emit({"set": label}); return
    if sub == "rm":
        if len(argv) < 2 or argv[1] not in data:
            _die(3, "not_found", "unknown identifier label",
                 f"`{NAME} ids list` shows the labels")
        _identifiers_remove(argv[1])
        _emit({"removed": argv[1]}); return
    _die(6, "input", f"unknown ids subcommand {sub!r}", f"{NAME} ids list|get|set|rm")


REFERENCE_PREFIX = "reference."


def _front_matter(body: str) -> tuple[str | None, str | None]:
    """`name` and `description` out of a reference's leading front matter."""
    lines = body.splitlines()
    if not lines or lines[0].strip() != "---":
        return None, None
    name = desc = None
    for line in lines[1:30]:
        if line.strip() == "---":
            break
        if line.startswith("name:"):
            name = line.split(":", 1)[1].strip()
        elif line.startswith("description:"):
            desc = line.split(":", 1)[1].strip()
    return name, desc


def _reference_bodies() -> dict[str, str]:
    """Every reference this project can see, keyed by its document key."""
    out: dict[str, str] = {}
    try:
        adapter = _records()
        for key in adapter.document_keys(NAME):
            if not key.startswith(REFERENCE_PREFIX):
                continue
            doc = adapter.document_read(NAME, key)
            if doc:
                out[key] = doc["body"]
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)
    return out


def _cmd_refs(argv: list[str] | None = None) -> None:
    """`refs` lists what this project can load; `refs show <name>` prints one.

    The listing carries each reference's path; `refs show` prints a body."""
    argv = argv or []
    bodies = _reference_bodies()
    adapter = _records()
    entries = []
    for key, body in sorted(bodies.items()):
        name, desc = _front_matter(body)
        if not name:
            continue
        entry = {"name": name, "description": desc or "", "key": key}
        # A path when there is one to open, a source when there is not. The
        # adapter answers that; the listing does not ask where it lives.
        path = adapter.document_path(NAME, key)
        if path is None:
            entry["source"] = adapter.source
        else:
            entry["path"] = str(path)
        entries.append((name, entry, body))

    if argv and argv[0] == "show":
        if len(argv) < 2:
            _die(6, "input", f"usage: {NAME} refs show <name>")
        wanted = argv[1]
        for name, entry, body in entries:
            if wanted in (name, entry["key"], entry["key"][len(REFERENCE_PREFIX):]):
                sys.stdout.write(body if body.endswith("\n") else body + "\n")
                return
        _die(3, "not_found", f"no reference named {wanted!r}",
             f"`{NAME} refs` lists them")
    if argv:
        _die(6, "input", f"unknown refs subcommand {argv[0]!r}", f"{NAME} refs [show <name>]")
    _emit([entry for _name, entry, _body in entries])


def _context_edit_files(key: str) -> tuple[Path, Path]:
    token = hashlib.sha256(f"{NAME}\0{key}".encode()).hexdigest()[:16]
    root = _state_dir() / "record-edits"
    return root / f"{token}.md", root / f"{token}.json"


def _cmd_context(argv: list[str]) -> None:
    """Read or edit project long text without exposing its backend."""
    sub = argv[0] if argv else "list"
    adapter = _records()
    if sub == "list":
        _emit({"documents": adapter.document_keys(NAME),
               "records": {"mode": adapter.mode, "source": adapter.source}})
        return
    if len(argv) < 2:
        _die(6, "input", f"usage: {NAME} context show|edit|put <key>")
    key = argv[1]
    if sub in ("edit", "put"):
        _read_only_gate(f"`{NAME} context {sub}`")
    if sub == "show":
        doc = adapter.document_read(NAME, key)
        if doc is None:
            _die(3, "not_found", f"no context document {key!r}",
                 f"`{NAME} context list` shows the keys")
        sys.stdout.write(doc["body"] if doc["body"].endswith("\n")
                         else doc["body"] + "\n")
        return
    work, meta = _context_edit_files(key)
    if sub == "edit":
        doc = adapter.document_read(NAME, key)
        direct = adapter.document_path(NAME, key)
        base = doc["hash"] if doc else None
        path = direct or work
        if direct is None:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(doc["body"] if doc else "")
        meta.parent.mkdir(parents=True, exist_ok=True)
        meta.write_text(json.dumps({"key": key, "path": str(path),
                                    "base": base, "direct": direct is not None},
                                   ensure_ascii=False, indent=2) + "\n")
        _emit({"key": key, "path": str(path), "base": base,
               "records": {"mode": adapter.mode, "source": adapter.source},
               "next": f"edit the path, then run `{NAME} context put {key}`"})
        return
    if sub == "put":
        try:
            checkout = json.loads(meta.read_text())
        except (OSError, ValueError) as exc:
            _die(6, "edit_not_started",
                 f"no valid edit checkout for {key!r}: {exc}",
                 f"run `{NAME} context edit {key}` first")
        if checkout.get("key") != key:
            _die(6, "edit_mismatch", f"edit checkout does not belong to {key!r}")
        path = Path(str(checkout.get("path") or ""))
        try:
            body = path.read_text()
            version = adapter.document_put(
                NAME, key, body, author=f"{NAME} context put",
                media_type="text/markdown", base=checkout.get("base"))
        except OSError as exc:
            _die(6, "edit_unreadable", f"cannot read edit path {path}: {exc}")
        except StoreError as exc:
            _die(6, exc.slug, exc.message, exc.hint)
        meta.unlink(missing_ok=True)
        if not checkout.get("direct"):
            path.unlink(missing_ok=True)
        _emit({"put": key, "version": version,
               "records": {"mode": adapter.mode, "source": adapter.source}})
        return
    _die(6, "input", f"unknown context subcommand {sub!r}",
         f"{NAME} context list|show|edit|put")


INVENTORY_NETWORK_MODES = ("none", "optional", "required")


def _inventory_declaration() -> dict | None:
    """The manifest's `inventory` block, derived from the INVENTORY constant.

    `None` says the capability has nothing of its own to report here, so a
    reader assembling a whole project knows before it asks; the verb still
    answers, with the empty envelope, so nothing branches on absence."""
    if not INVENTORY:
        return None
    network = INVENTORY.get("network", "none")
    return {"network": network if network in INVENTORY_NETWORK_MODES else "none"}


def _cmd_inventory(argv: list[str]) -> None:
    """What this capability holds in this project, in one shape for all of them.

    The read is local, secret-free, and leaves nothing changed behind it.
    `--network` is the caller's explicit consent to reach the remote system for
    detail a local read cannot supply; without it that detail is named in
    `deferred` rather than fetched, so assembling a whole project never waits
    on a network the caller did not choose. `--json` is accepted for
    explicitness; the output is always this JSON."""
    network = False
    for arg in argv:
        if arg == "--network":
            network = True
        elif arg != "--json":
            _die(6, "input", f"unknown inventory option {arg!r}",
                 f"{NAME} inventory [--network]")
    root = _project_root()
    report: dict = {"capability": NAME,
                    "project": str(root) if root is not None else None,
                    "network": network,
                    "metrics": [], "items": [], "service": None, "deferred": []}
    if INVENTORY:
        built = _inventory(network) or {}
        for field in ("metrics", "items", "deferred"):
            report[field] = list(built.get(field) or [])
        report["service"] = built.get("service")
    _emit(report)


# A store setting that cannot be used is a configuration fault; a store that
# cannot be reached, is busy, or refuses the migration is the environment's.
_STORE_SETTING_SLUGS = frozenset({
    "store_not_configured", "store_not_postgres", "store_setting_unreadable",
    "store_setting_too_new", "bad_store_setting", "sslmode_too_weak",
    "bad_schema_name", "driver_missing"})


def _tables_declared() -> bool:
    """Whether the capability keeps tables in the machine's store (`TABLES`)."""
    return bool(globals().get("TABLES"))


def _cmd_migrate(argv: list[str]) -> None:
    """`migrate` applies the capability's pending steps to its tables in the
    machine's store, through the shared database library and under its lock;
    `migrate status` reports where they stand, without a lock, changing nothing.
    The manager runs `migrate` when it installs or updates the payload, and a
    service runs it when it starts."""
    if argv not in ([], ["status"]):
        _die(6, "input", f"unknown migrate arguments {' '.join(argv)!r}",
             f"{NAME} migrate [status]")
    steps, major, minor = _tables()
    try:
        from capabilities_contract import db
    except ImportError:
        _die(6, "driver_missing",
             "the shared database library capabilities-contract is not installed",
             f"run {NAME} through its own script header, which pins it")
    conn = None
    try:
        conn = db.connect(application_name=NAME)
        if argv:
            found = db.status(conn, NAME, steps, major=major, minor=minor)
            stored = (None if found.stored_major is None
                      else {"major": found.stored_major, "minor": found.stored_minor})
            report = {"owner": found.owner, "schema": found.schema, "state": found.state,
                      "code": {"major": found.major, "minor": found.minor},
                      "store": stored, "applied": found.applied,
                      "pending": found.pending, "changed": found.changed,
                      "warnings": found.warnings}
        else:
            done = db.migrate(conn, NAME, steps, major=major, minor=minor)
            report = {"owner": done.owner, "schema": done.schema,
                      "applied": done.applied, "skipped": done.skipped,
                      "version": {"major": done.major, "minor": done.minor},
                      "warnings": done.warnings}
    except db.DbError as exc:
        _die(6 if exc.slug in _STORE_SETTING_SLUGS else 5, exc.slug, exc.message, exc.hint)
    finally:
        if conn is not None:
            conn.close()
    _emit(report)


MACHINE_READ_EFFECT = ("outside any project these verbs use the machine's own "
                       "connections, read-only; inside a project its grants "
                       "alone decide")


def _cmd_connections_reported() -> None:
    """The capability's own connections report, with what the contract knows
    beside it. The report stays the capability's: it is taken whole, and the
    capability's effective policy state is added to it. Under the read-only
    switch every connection in it is marked read-only and the switch is named
    beside it, so a reader sees why no connection may write; in a machine read
    each connection the machine lent is named as the machine's, read-only."""
    import contextlib
    import io
    captured = io.StringIO()
    try:
        with contextlib.redirect_stdout(captured):
            _cmd_connections()
    except SystemExit:
        sys.stdout.write(captured.getvalue())
        raise
    try:
        report = json.loads(captured.getvalue())
    except ValueError:
        report = None
    if not isinstance(report, dict):
        sys.stdout.write(captured.getvalue())
        return
    conns = report.get("connections")
    conns = conns if isinstance(conns, dict) else {}
    if read_only_switch():
        for entry in conns.values():
            if isinstance(entry, dict):
                entry["allow_write"] = False
        report["read_only_switch"] = {
            "variable": READ_ONLY_ENV, "on": True,
            "effect": READ_ONLY_EFFECT}
    lent = globals().get("_MACHINE_LENT") or {}
    if lent:
        for cid in lent:
            if isinstance(conns.get(cid), dict):
                conns[cid]["allow_write"] = False
        report["machine_reads"] = {
            "verbs": list(MACHINE_READS),
            "connections": {cid: {"scope": "machine", "source": source}
                            for cid, source in sorted(lent.items())},
            "effect": MACHINE_READ_EFFECT}
    report["policy"] = _policy_state()
    _emit(report)


def _contract(argv: list[str]) -> None:
    """Dispatch the contract verbs; domain verbs fall through to the CLI's own
    parser. Runs after _gate(), before any credential is resolved.

    `help` is a contract verb only when bare (no extra args) — the top-level
    dump plus the Identifiers section. `<NAME> help <subcommand>` falls
    through to the CLI so per-verb help stays clean."""
    cmd = argv[0] if argv else ""
    if cmd == "stub":
        _emit(f"{SUMMARY} Run `{NAME} help`.")
    elif cmd == "manifest":
        _emit({"name": NAME, "summary": SUMMARY,
               "credentials": {"scope": SCOPE, "keys": CRED_KEYS},
               "docs": {"base": DOCS_BASE,
                        "topics": [entry["topic"] for entry in _guide_menu()]},
               "state": STATE, "inventory": _inventory_declaration(),
               "post_install": POST_INSTALL, "tables": _tables_declared()})
    elif cmd == "migrate" and _tables_declared():
        _cmd_migrate(argv[1:])
    elif cmd == "guide":
        _cmd_guide(argv[1:])
    elif cmd == "ids":
        _cmd_ids(argv[1:])
    elif cmd == "refs":
        _cmd_refs(argv[1:])
    elif cmd == "context":
        _cmd_context(argv[1:])
    elif cmd == "connections":
        _cmd_connections_reported()
    elif cmd == "inventory":
        _cmd_inventory(argv[1:])
    elif cmd == "help" and len(argv) == 1:
        _cmd_help()
    else:
        return
    sys.exit(0)

# <<< contract: capability core <<<

# >>> contract: store (generated — edit contract/store.py, run `capabilities sync-contract`) >>>
# A region carries what it needs. Relying on the host file to have imported
# the right names is a coupling nothing checks and nothing reports: it works in
# whichever capability happened to import them and fails at import time in the
# rest. Re-importing a name the host already has costs nothing.
import json
import os
import hashlib
import re
# The capability core region reads the clock through `time` and imports nothing
# of its own, so this region keeps carrying it.
import time
from collections.abc import Sequence
from pathlib import Path
from typing import Any


# Two scopes and no more: a record either belongs to one project (the
# project's envelope) or to every project (the user's config home).
SCOPE_KINDS = ("global", "project")

FIRST = "first"
MERGE = "merge"
EXACT = "exact"

# The collection registry: how each resolves, and who is allowed to write it.
# Adding a collection here is the only place a new record class is declared.
#
# `connection` and `grant` are the same fact split along the seam that matters:
# an entry's identity — where the thing is and how to reach it — is a fact about
# the world, the same in every project forever. What a project may DO with that
# identity is a decision, different per project by definition. Glued together,
# the second cannot be overridden without restating the first; apart, a project
# that needs write access writes one grant and repeats no address, no host,
# no secret.
#
# An identity is atomic: it merges by entry, never by field, so no connection is
# ever assembled from two scopes. That is what rule 18's "never merged" was
# protecting, and it survives; what it gives up is refusing to let a project add
# to the global set at all.
COLLECTIONS: dict[str, dict[str, str]] = {
    "connection": {"resolve": MERGE, "writer": "human"},
    "grant": {"resolve": MERGE, "writer": "human"},
    "identifier": {"resolve": MERGE, "writer": "capability"},
    "setting": {"resolve": MERGE, "writer": "human"},
    "policy": {"resolve": MERGE, "writer": "manager"},
    "document": {"resolve": MERGE, "writer": "human"},
}

# Grant fields and what they mean when nothing declares them. `allow_write`
# falls back to the capability's own WRITE_DEFAULT rather than to a value here,
# because "does a write leave the system" is the capability's fact.
GRANT_FIELDS = ("enabled", "allow_write")

# A document version is named by the first twelve hex characters of its sha256.
# Forty-eight bits is far more than a project's worth of prose needs, and a name
# a person can read at a glance is worth more than headroom nobody will reach.
HASH_LENGTH = 12

# A key is a label a human chose, and for a mailbox that label is naturally an
# email address — so `@` and `+` belong here. What stays out is whitespace,
# separators and anything that would make a key ambiguous to address.
KEY_RE = re.compile(r"[a-z0-9][a-z0-9._@+-]{0,127}", re.IGNORECASE)
CAPABILITY_RE = re.compile(r"[a-z][a-z0-9-]{0,63}")


class StoreError(Exception):
    """Every failure this tier reports. Carries a slug the caller maps to an
    exit code, so the CLI's error envelope stays the capability's own."""

    def __init__(self, slug: str, message: str, hint: str | None = None):
        super().__init__(message)
        self.slug = slug
        self.message = message
        self.hint = hint


# The process-wide read-only switch. A caller hands a whole process tree to
# something that may read through the capabilities but change nothing through
# them by setting this one variable, which every descendant inherits. It is
# decided here and nowhere else, because this tier is the one every capability
# carries and the one the manager and the bundled services import. It only ever
# closes: nothing it says makes a connection writable, and unset, `0` or
# `false` leave every record and every gate exactly as declared.
READ_ONLY_ENV = "CAPABILITIES_READ_ONLY"
READ_ONLY_EFFECT = ("every connection resolves read-only whatever its grant or "
                    "WRITE_DEFAULT; write verbs, project-record writes and "
                    "service activation exit 4")


def read_only_switch() -> bool:
    """True when this process runs under the read-only switch: the variable
    holds `1` or `true`, in any case."""
    return os.environ.get(READ_ONLY_ENV, "").strip().lower() in ("1", "true")


def _refuse_record_write(capability: str, collection: str) -> None:
    """A project record is the human's or the manager's, so under the switch
    nothing writes one. Operational state (a capability's state directory and
    its tables in the database) is not a record and keeps working."""
    if read_only_switch():
        raise StoreError(
            "read_only_switch",
            f"writing {capability} {collection} records is refused: "
            f"{READ_ONLY_ENV} is set, so this process changes no project record",
            "Do not lift the switch yourself — ask the user; the change has to "
            f"run in a process without {READ_ONLY_ENV}.")


def _store_check(name: str, value: str, pattern: re.Pattern) -> str:
    if not isinstance(value, str) or not pattern.fullmatch(value):
        raise StoreError("bad_name", f"{name} {value!r} must match {pattern.pattern}")
    return value


def _semantics(collection: str) -> str:
    spec = COLLECTIONS.get(collection)
    if not spec:
        raise StoreError("bad_collection", f"unknown collection {collection!r}",
                         f"known: {', '.join(sorted(COLLECTIONS))}")
    return spec["resolve"]


def _grant_decisions(cid: str, rows: Sequence[dict[str, Any]]) -> tuple[dict, dict]:
    """One grant assembled field by field, highest scope first.

    This is the line COLLECTIONS already draws between the two records. An
    identity is a fact about the world, so it is atomic: taken whole from
    one scope, never assembled out of two. A grant is a decision, and a
    decision a lower scope made about one field stands until some higher
    scope decides that same field — so a machine-wide `allow_write: false`
    survives a project that only says `enabled: true`, and write permission
    is never acquired by saying something else.

    Returns the decided fields and, per field, the scope that decided it."""
    decided: dict[str, Any] = {}
    decided_at: dict[str, str] = {}
    for row in rows:
        value = row["value"]
        if not isinstance(value, dict):
            raise StoreError("bad_grant",
                             f"grant {cid!r} must be a table, got {type(value).__name__}")
        unknown = set(value) - set(GRANT_FIELDS)
        if unknown:
            raise StoreError("bad_grant",
                             f"grant {cid!r} has unknown field(s): {', '.join(sorted(unknown))}",
                             f"known: {', '.join(GRANT_FIELDS)}")
        for field, decision in value.items():
            if field not in decided:
                decided[field] = decision
                decided_at[field] = row["scope"]
    return decided, decided_at


# --- records: the files a project keeps its configuration in ------------------
#
# Runtime state is not on this axis: runs, queues and cursors a capability's
# processes share live in its tables in the database. What this answers is
# where CONFIGURATION is read and written. A capability calls the verbs below
# and never a path, so the layout is described in one place.

DOCUMENT_LOCATIONS: tuple[tuple[str | None, str, str], ...] = (
    ("reference", "{cap}/reference", ".md"),
    ("context", "{cap}/service/context", ".md"),
    ("script", "automations/scripts", ".py"),
    (None, "{cap}/service", ".md"),
)


def _document_key(prefix: str | None, stem: str) -> str:
    """The key a file answers to. Underscores fold to hyphens and case is lost,
    so the map from file to key is one-way — which is why finding a document
    searches rather than computes."""
    slug = stem.replace("_", "-").lower()
    return f"{prefix}.{slug}" if prefix else slug


class Records:
    """The surface a capability reads and writes its configuration through."""

    mode = "?"
    source = "?"

    def __enter__(self) -> "Records":
        return self

    def __exit__(self, *exc: object) -> None:
        self.close()

    def close(self) -> None:
        pass

    def resolve_scope(self, capability: str, collection: str,
                      scope: str) -> dict[str, dict[str, Any]]:
        """Resolve exactly one scope, without inheritance."""
        raise NotImplementedError


class FileRecords(Records):
    """Configuration kept as the files the envelope has always held.

    The layout is not invented here — it is the one the capabilities already
    read, described in one place instead of re-derived at each call site. Two
    directories with that layout make the scope chain: the project's envelope,
    then the user's config home."""

    mode = "files"

    def __init__(self, envelope: Path, global_dir: Path,
                 project_id: str | None = None, project: str | None = None,
                 include_global: bool = True):
        self.envelope, self.global_dir = Path(envelope), Path(global_dir)
        self.project_id, self.project = project_id, project
        self.include_global = bool(include_global)
        self.source = str(self.envelope)

    # -- where a record lives --------------------------------------------------

    def _chain(self) -> list[tuple[str, str | None, Path]]:
        chain = [("project", self.project_id, self.envelope)]
        if self.include_global:
            chain.append(("global", None, self.global_dir))
        return chain

    @staticmethod
    def _load(path: Path) -> Any:
        try:
            return json.loads(path.read_text())
        except FileNotFoundError:
            return None
        except (OSError, ValueError) as exc:
            raise StoreError("bad_config", f"cannot read {path}: {exc}") from None

    @staticmethod
    def _save(path: Path, body: Any, sort: bool = False) -> None:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(body, indent=2, ensure_ascii=False,
                                   sort_keys=sort) + "\n")

    def _policy_file(self, root: Path) -> Path:
        """The gate. A project keeps it at the envelope root; the config home
        keeps it under the manager's own name, which is the same rule seen from
        outside -- there, `capabilities` is a capability like any other."""
        return (root / "settings.json" if root == self.envelope
                else root / "capabilities" / "settings.json")

    def _file(self, root: Path, capability: str, collection: str,
              key: str | None = None) -> Path:
        if collection == "policy":
            return self._policy_file(root)
        if collection == "identifier":
            return root / capability / "identifiers.json"
        if collection in ("connection", "grant"):
            return root / capability / "connections.json"
        if collection == "setting":
            if key == "connection.default":
                return root / capability / "connections.json"
            return root / capability / "service" / "settings.json"
        raise StoreError("bad_collection",
                         f"collection {collection!r} is not kept in files")

    # -- reading ---------------------------------------------------------------

    def _entries(self, root: Path, capability: str, collection: str) -> dict[str, Any]:
        """Every entry of one collection held at one scope, keyed by the name a
        record answers to."""
        if collection == "policy":
            body = self._load(self._policy_file(root)) or {}
            return dict((body.get("capabilities") or {}))
        if collection == "identifier":
            body = self._load(root / capability / "identifiers.json") or {}
            raw = body.get("identifiers") if isinstance(body.get("identifiers"), dict) else body
            out = {}
            for label, entry in raw.items():
                out[label] = entry["value"] if isinstance(entry, dict) and "value" in entry else entry
            return out
        registry = self._load(root / capability / "connections.json") or {}
        if collection in ("connection", "grant"):
            declared = registry.get("connections")
            if not isinstance(declared, dict):
                return {}
            out = {}
            for cid, entry in declared.items():
                if not isinstance(entry, dict):
                    continue
                if collection == "connection":
                    out[cid] = {k: v for k, v in entry.items() if k not in GRANT_FIELDS}
                else:
                    grant = {k: entry[k] for k in GRANT_FIELDS if k in entry}
                    if grant:
                        out[cid] = grant
            return out
        if collection == "setting":
            out = {}
            if registry.get("default"):
                out["connection.default"] = registry["default"]
            service = self._load(root / capability / "service" / "settings.json")
            if isinstance(service, dict):
                out.update(service)
            return out
        raise StoreError("bad_collection", f"unknown collection {collection!r}",
                         f"known: {', '.join(sorted(COLLECTIONS))}")

    def _note(self, root: Path, capability: str, collection: str, key: str) -> str | None:
        if collection != "identifier":
            return None
        body = self._load(root / capability / "identifiers.json") or {}
        raw = body.get("identifiers") if isinstance(body.get("identifiers"), dict) else body
        entry = raw.get(key)
        return entry.get("note") if isinstance(entry, dict) else None

    def config_layers(self, capability: str, collection: str,
                      _scopes: Any = None) -> list[dict[str, dict[str, Any]]]:
        """Each scope's own entries, highest scope first, uncollapsed."""
        _store_check("capability", capability, CAPABILITY_RE)
        _semantics(collection)
        layers: list[dict[str, dict[str, Any]]] = []
        for scope, pid, root in self._chain():
            entries = self._entries(root, capability, collection)
            if not entries:
                continue
            layers.append({
                key: {"id": f"{scope}:{capability}/{collection}/{key}", "scope": scope,
                      "project_id": pid, "capability": capability,
                      "collection": collection, "key": key, "value": value,
                      "note": self._note(root, capability, collection, key),
                      "updated_at": None, "updated_by": None}
                for key, value in entries.items()
            })
        return layers

    def resolve(self, capability: str, collection: str) -> dict[str, dict[str, Any]]:
        semantics = _semantics(collection)
        out: dict[str, dict[str, Any]] = {}
        for rows in self.config_layers(capability, collection):
            if semantics == FIRST:
                return rows
            for key, row in rows.items():
                prior = out.get(key)
                if prior is None:
                    out[key] = row
                elif (collection == "connection" and not prior["value"]
                        and row["value"]):
                    # One file holds both records here, so an entry carrying
                    # only grant fields yields an identity with no fields. That
                    # is a decision about an inherited connection, never a
                    # replacement for it: it must not blank the identity the
                    # lower scope declared. Where nothing is inherited the
                    # fieldless identity stands, which is the only reading a
                    # glued file leaves for it.
                    out[key] = row
        return out

    def _scope_root(self, scope: str) -> tuple[Path, str | None]:
        """The directory one named scope keeps its records in, and the project
        it answers for. Named once so asking a scope for its rows and asking it
        for its file can never land in different trees."""
        if scope == "project":
            return self.envelope, self.project_id
        if scope == "global":
            return self.global_dir, None
        raise StoreError("bad_scope",
                         f"scope {scope!r} must be one of {', '.join(SCOPE_KINDS)}")

    def resolve_scope(self, capability: str, collection: str,
                      scope: str) -> dict[str, dict[str, Any]]:
        _store_check("capability", capability, CAPABILITY_RE)
        root, pid = self._scope_root(scope)
        return {
            key: {"id": f"{scope}:{capability}/{collection}/{key}",
                  "scope": scope, "project_id": pid,
                  "capability": capability, "collection": collection,
                  "key": key, "value": value,
                  "note": self._note(root, capability, collection, key),
                  "updated_at": None, "updated_by": None}
            for key, value in self._entries(root, capability, collection).items()
        }

    def get(self, capability: str, collection: str, key: str) -> Any:
        entry = self.resolve(capability, collection).get(key)
        return entry["value"] if entry else None

    def collection_source(self, capability: str, collection: str) -> str:
        """The file that answered, named exactly. A report that says only
        "files" makes the reader go and find out which one, and the scope a
        record resolved at is half of what they came to learn."""
        for _scope, _pid, root in self._chain():
            if self._entries(root, capability, collection):
                return str(self._file(root, capability, collection))
        return str(self._file(self.envelope, capability, collection))

    def scope_source(self, capability: str, collection: str, scope: str) -> str:
        """The file one named scope keeps this collection in. What a record
        resolved *to* is a question about that record, so the caller that knows
        which scope answered asks here rather than for the collection's own
        file: one file per scope, and the chain is not walked again."""
        _store_check("capability", capability, CAPABILITY_RE)
        root, _pid = self._scope_root(scope)
        return str(self._file(root, capability, collection))

    def connections(self, capability: str, write_default: bool = False,
                    include_disabled: bool = False,
                    machine_read: bool = False) -> dict[str, dict[str, Any]]:
        """Every connection this project may use, already carrying the decision
        made about it — the one read a capability needs before it acts.

        `machine_read` is the caller's word that this is one of the
        capability's declared machine reads outside any project: an identity
        the machine itself declares is then usable, read-only, unless its grant
        resolves to `enabled: false`."""
        identities = self.resolve(capability, "connection")
        layers = self.config_layers(capability, "grant")
        # Under the read-only switch every connection is a source, whatever its
        # grant or the capability's WRITE_DEFAULT says.
        writable = not read_only_switch()
        out: dict[str, dict[str, Any]] = {}
        for cid, entry in identities.items():
            rows = [layer[cid] for layer in layers if cid in layer]
            decided, decided_at = _grant_decisions(cid, rows)
            # Where the identity resolves decides whether it is this project's
            # to use at all. A project that declares an identity locally has
            # already said yes by declaring it; an identity inherited from the
            # global scope is withheld until a grant *resolving at project
            # scope* says `enabled: true`. A global `enabled: true` can never be
            # the blessing — one global line would otherwise hand every project
            # on the machine the same connection back.
            declared = decided.get("enabled")
            identity_is_project = entry["scope"] == "project"
            blessed_here = decided_at.get("enabled") == "project"
            if declared is None:
                enabled = identity_is_project
            else:
                enabled = bool(declared) and (identity_is_project or blessed_here)
            # A machine read lends the machine's own connection and nothing
            # more: never a write, and never one a grant switched off.
            lent = (machine_read and not enabled and entry["scope"] == "global"
                    and (declared is None or bool(declared)))
            if lent:
                enabled = True
            if not enabled and not include_disabled:
                continue
            grant = rows[0] if rows else None
            out[cid] = {
                "id": cid,
                "value": entry["value"],
                "scope": (entry["scope"], entry["project_id"]),
                "enabled": enabled,
                "allow_write": (writable and not lent
                                and bool(decided.get("allow_write", write_default))),
                "grant_scope": (grant["scope"], grant["project_id"]) if grant else None,
            }
            if lent:
                out[cid]["machine_read"] = True
        return out

    # -- writing ---------------------------------------------------------------

    def set(self, capability: str, collection: str, key: str, value: Any,
            actor: str | None = None, note: str | None = None,
            scope: str | None = None) -> None:
        _store_check("capability", capability, CAPABILITY_RE)
        _store_check("key", key, KEY_RE)
        _semantics(collection)
        _refuse_record_write(capability, collection)
        target_scope = scope or "project"
        if target_scope not in SCOPE_KINDS:
            raise StoreError("bad_scope",
                             f"scope {target_scope!r} must be one of {', '.join(SCOPE_KINDS)}")
        root = self.envelope if target_scope == "project" else self.global_dir
        if target_scope == "project" and not self.envelope.is_dir():
            raise StoreError("no_envelope", "no capabilities/ envelope in this project",
                             "run `capabilities init` first")
        path = self._file(root, capability, collection, key)
        body = self._load(path)
        body = body if isinstance(body, dict) else {}
        if collection == "policy":
            body.setdefault("capabilities", {})[key] = value
        elif collection == "identifier":
            # Flat at the top level, which is the shape the envelope has always
            # had and the shape `audit` holds this to. A file already carrying
            # the wrapper keeps it: reshaping someone's file on an unrelated
            # write is not this writer's business.
            holder = (body["identifiers"] if isinstance(body.get("identifiers"), dict)
                      else body)
            holder[key] = {"value": value, "note": note or ""}
        elif collection in ("connection", "grant"):
            entry = body.setdefault("connections", {}).setdefault(key, {})
            if collection == "connection":
                for field in list(entry):
                    if field not in GRANT_FIELDS:
                        entry.pop(field)
                entry.update(value if isinstance(value, dict) else {})
            else:
                entry.update({k: v for k, v in (value or {}).items() if k in GRANT_FIELDS})
        elif key == "connection.default":
            body["default"] = value
        else:
            body[key] = value
        self._save(path, body, sort=collection == "identifier")

    def delete(self, capability: str, collection: str, key: str,
               scope: str | None = None) -> bool:
        _refuse_record_write(capability, collection)
        target_scope = scope or "project"
        if target_scope not in SCOPE_KINDS:
            raise StoreError("bad_scope",
                             f"scope {target_scope!r} must be one of {', '.join(SCOPE_KINDS)}")
        root = self.envelope if target_scope == "project" else self.global_dir
        path = self._file(root, capability, collection, key)
        body = self._load(path)
        if not isinstance(body, dict):
            return False
        if collection == "policy":
            gone = (body.get("capabilities") or {}).pop(key, None) is not None
        elif collection == "identifier":
            holder = body.get("identifiers") if isinstance(body.get("identifiers"), dict) else body
            gone = holder.pop(key, None) is not None
        elif collection in ("connection", "grant"):
            entry = (body.get("connections") or {}).get(key)
            if not isinstance(entry, dict):
                return False
            if collection == "connection":
                gone = body["connections"].pop(key, None) is not None
            else:
                gone = any(entry.pop(field, None) is not None for field in GRANT_FIELDS)
        elif key == "connection.default":
            gone = body.pop("default", None) is not None
        else:
            gone = body.pop(key, None) is not None
        if gone:
            self._save(path, body, sort=collection == "identifier")
        return gone

    # -- documents -------------------------------------------------------------

    def _documents(self, root: Path, capability: str) -> dict[str, Path]:
        """Every long-text file this scope holds, by the key it answers to. The
        map is built by walking rather than by computing a path from a key,
        because the key loses case and underscores on the way in."""
        found: dict[str, Path] = {}
        for prefix, shape, suffix in DOCUMENT_LOCATIONS:
            if prefix == "script" and capability != "automations":
                continue
            folder = root / shape.format(cap=capability)
            if not folder.is_dir():
                continue
            for path in sorted(folder.glob(f"*{suffix}")):
                if path.is_file():
                    found.setdefault(_document_key(prefix, path.stem), path)
        return found

    def document_path(self, capability: str, key: str) -> Path | None:
        """The file this key names. It is the truth here, not a copy of it, so
        an edit to what this returns is the edit — which is why `put` validates
        rather than transports."""
        for _scope, _pid, root in self._chain():
            path = self._documents(root, capability).get(key)
            if path:
                return path
        return None

    def document_read(self, capability: str, key: str) -> dict[str, Any] | None:
        for scope, pid, root in self._chain():
            path = self._documents(root, capability).get(key)
            if not path:
                continue
            body = path.read_text()
            return {"id": str(path), "key": key,
                    "hash": hashlib.sha256(body.encode()).hexdigest()[:HASH_LENGTH],
                    "body": body, "media_type": None, "author": None,
                    "created_at": None, "scope": (scope, pid), "path": str(path)}
        return None

    def document_keys(self, capability: str) -> list[str]:
        keys: set[str] = set()
        for _scope, _pid, root in self._chain():
            keys.update(self._documents(root, capability))
        return sorted(keys)

    def document_put(self, capability: str, key: str, body: str,
                     author: str | None = None, media_type: str | None = None,
                     base: str | None = None) -> str:
        _refuse_record_write(capability, "document")
        path = self._documents(self.envelope, capability).get(key)
        if path is None:
            path = self._new_document_path(capability, key)
        if base is not None and path.is_file():
            current = path.read_text()
            live = hashlib.sha256(current.encode()).hexdigest()[:HASH_LENGTH]
            # In files mode `context edit` deliberately hands out the truth,
            # not a copy. By put-time the live hash is therefore expected to
            # differ from the checkout hash; equality of the submitted body and
            # the file proves the edit landed at the path the adapter named.
            if live != base and current != body:
                raise StoreError(
                    "stale_edit",
                    f"{path} is {live} now, not {base} as it was when the edit began",
                    "re-read it and apply the change again")
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(body)
        return hashlib.sha256(body.encode()).hexdigest()[:HASH_LENGTH]

    def _new_document_path(self, capability: str, key: str) -> Path:
        """Where a document this project does not have yet would go. The prefix
        chooses the folder; what follows it is the file."""
        for prefix, shape, suffix in DOCUMENT_LOCATIONS:
            if prefix and key.startswith(prefix + "."):
                return self.envelope / shape.format(cap=capability) / (key[len(prefix) + 1:] + suffix)
        prefix, shape, suffix = DOCUMENT_LOCATIONS[-1]
        return self.envelope / shape.format(cap=capability) / (key + suffix)

    # -- what a directory cannot answer ---------------------------------------

    def _refuse(self, what: str) -> None:
        raise StoreError("files_mode", f"{what} is not kept: records are files",
                         "their history is the repository's; read it with git")

    def revisions(self, *_a: Any, **_k: Any) -> list:
        self._refuse("a record's history")
        return []

    def document_versions(self, *_a: Any, **_k: Any) -> list:
        self._refuse("a document's earlier versions")
        return []


def open_records(envelope: Path | str, global_dir: Path | str,
                 project_only: bool = False) -> Records:
    """The adapter this project's configuration is read and written through:
    the project's envelope, then `global_dir` unless `project_only`.

    Records are files only. A `project.json` that declares a `store` other than
    `files` is refused rather than read as files, since the records it points
    at are not where it says."""
    envelope, global_dir = Path(envelope), Path(global_dir)
    identity_file = envelope / "project.json"
    try:
        identity = json.loads(identity_file.read_text())
    except (OSError, ValueError):
        identity = {}
    if not isinstance(identity, dict):
        identity = {}
    declared = identity.get("store", "files")
    if declared != "files":
        raise StoreError("bad_store_mode",
                         f"{identity_file} declares store {declared!r}; records are "
                         "kept only in files",
                         'remove "store" from project.json, or set it to "files"')
    return FileRecords(envelope, global_dir, identity.get("id"), identity.get("slug"),
                       include_global=not project_only)

# <<< contract: store <<<


def _context_edit_files(key: str) -> tuple[Path, Path]:
    """Keep automations' record-edit scratch beside its XDG runtime state."""
    token = hashlib.sha256(f"{NAME}\0{key}".encode()).hexdigest()[:16]
    project = _project_root()
    root = (_state_path(project) if project is not None else _STATE_HOME / NAME) / "record-edits"
    return root / f"{token}.md", root / f"{token}.json"


def _cmd_connections() -> None:
    _emit({"connections": {}})


def _judging_environment(runtime, config: dict, state: Path, running: bool) -> str | None:
    """The environment an automation's state is judged against: the running
    daemon's published one, else this invocation's; None when a running daemon
    published none."""
    if running:
        return runtime.read_daemon_environment(state)
    return config["engine"]["environment"]


def _inventory_item(runtime, item: dict, environment: str | None) -> dict:
    """One automation as an inventory item.

    The contract's item has no field for an id, a description or a schedule
    as data, so they ride in `attributes` under fixed labels (documented in
    `automations help`), and `detail` stays the schedule as display text."""
    attributes = [{"label": "id", "value": item["id"]}]
    if item["description"]:
        attributes.append({"label": "description", "value": item["description"]})
    if item["schedule"]:
        when = item["schedule"]
        attributes += [{"label": "schedule_kind", "value": "cron"},
                       {"label": "schedule_value", "value": item["schedule"]}]
    elif item["every_seconds"]:
        when = f"every {item['every_seconds']}s"
        attributes += [{"label": "schedule_kind", "value": "interval"},
                       {"label": "schedule_value", "value": item["every_seconds"]}]
    else:
        when = "manual"
        attributes.append({"label": "schedule_kind", "value": "manual"})
    attributes.append({"label": "script", "value": item["script"]})
    if item["environments"]:
        attributes.append({"label": "environments",
                           "value": ", ".join(item["environments"])})
    if not item["enabled"]:
        state_word = "disabled"
    elif environment is None:
        state_word = "enabled"
    elif runtime.applies(item, environment):
        state_word = "active"
    else:
        state_word = "other environment"
    return {
        "group": "automations",
        "name": item["name"] or item["id"],
        "state": state_word,
        "detail": when,
        "attributes": attributes,
    }


def _inventory(_network: bool) -> dict:
    """The automations this project declares, and whether the daemon is up.

    Everything here is already on this machine - the config file and the pid
    the daemon left beside its state - so the report never opens the store and
    never counts a run: a reader asking every capability at once must not pay
    a query for the asking.

    Whether an automation is active is the running daemon's question, not this
    invocation's: the daemon selects by the environment it was started under,
    which a terminal opened later does not share. So a running daemon's
    published environment is the one each automation is judged against, and
    this invocation's stands in only when no daemon is running. A running
    daemon that published none leaves the environment undecided, and the
    report says `enabled` rather than guessing which side of it each one is.

    The service's state is part of every answer, a project with no
    configuration included, because a reader assembling a project takes it
    from here and nowhere else. So is its verdict: the checks `doctor` makes
    from this machine alone, and none of the store's."""
    root = _project_root()
    if root is None:
        return {"metrics": [{"label": "automations", "value": 0,
                             "note": "not inside a project"}],
                "service": {"state": "not configured", "detail": "not inside a project",
                            "ok": False, "problem": "not inside a project"}}
    state = _state_path(root)
    pid = _read_pid(state / "daemon.pid")
    running = _pid_alive(pid)
    live = ({"state": "running", "detail": f"pid {pid}"} if running else None)
    if not _config_path(root).is_file():
        return {"metrics": [{"label": "automations", "value": 0,
                             "note": "no configuration in this project"}],
                "service": {**(live or {"state": "not initialized",
                                        "detail": "no configuration in this project"}),
                            "ok": False, "problem": "no configuration in this project"}}
    try:
        runtime, config = _load(root)
    except SystemExit:
        return {"metrics": [{"label": "automations", "value": 0,
                             "note": "configuration does not load"}],
                "service": {**(live or {"state": "stopped",
                                        "detail": "configuration does not load"}),
                            "ok": False, "problem": "configuration does not load"}}
    environment = _judging_environment(runtime, config, state, running)
    whose = "the running daemon's" if running else "no daemon running"
    declared = config["automations"]
    items = [_inventory_item(runtime, item, environment) for item in declared]
    active = sum(1 for item in items if item["state"] == "active")
    if environment is None:
        active_metric = {"label": "enabled",
                         "value": sum(1 for item in declared if item["enabled"]),
                         "note": "the running daemon published no environment"}
    else:
        active_metric = {"label": "active here", "value": active,
                         "note": f"environment: {environment} ({whose})"}
    return {
        "metrics": [
            {"label": "automations", "value": len(declared)},
            active_metric,
        ],
        "items": items,
        "service": {"state": "running" if running else "stopped",
                    "detail": (f"pid {pid}, environment {environment or 'unpublished'}"
                               if running else
                               f"environment: {environment}"),
                    **_service_verdict(_service_findings(
                        runtime, config, state, running,
                        environment if running else None))},
    }


def _service_verdict(found: dict[str, Any]) -> dict[str, Any]:
    """The inventory's verdict on the service: `doctor`'s local findings,
    the first of them named in one line."""
    if found["missing_scripts"]:
        return {"ok": False, "problem": "missing_scripts: "
                + ", ".join(map(str, found["missing_scripts"]))}
    for code in ("config_stale", "environment_idle"):
        if found[code] is not None:
            return {"ok": False, "problem": f"{code}: {found[code]['message']}"}
    return {"ok": True}


def _manifest_payload() -> dict[str, Any]:
    return {
        "name": NAME,
        "summary": SUMMARY,
        "credentials": {"scope": SCOPE, "keys": CRED_KEYS},
        "docs": {"base": DOCS_BASE, "topics": [entry["topic"] for entry in _guide_menu()]},
        "state": STATE,
        "inventory": _inventory_declaration(),
        "post_install": POST_INSTALL,
        "tables": _tables_declared(),
        "service": SERVICE,
    }


def _tables():
    """The steps and version of the run ledger's tables, for the contract's
    `migrate`."""
    runtime = _runtime_module()
    return runtime.LEDGER_STEPS, runtime.LEDGER_MAJOR, runtime.LEDGER_MINOR


def _bundle_dir() -> Path:
    here = Path(__file__).resolve()
    return here.parent.parent if here.parent.name == "bin" else here.parent


def _runtime_path() -> Path:
    return _bundle_dir() / "service" / "runtime.py"


def _template(name: str) -> Path:
    return _bundle_dir() / "service" / "templates" / name


def _root_required() -> Path:
    root = _project_root()
    if root is None:
        _die(6, "no_project", "not inside a project", "run from a project with a capabilities envelope")
    envelope = _project_capabilities_dir(root)
    if not ((envelope / "settings.json").is_file()
            or (envelope / "project.json").is_file()):
        _die(6, "no_envelope", "no capabilities envelope in this project", "run `capabilities init` first")
    return root


def _service_dir(root: Path) -> Path:
    return _project_capabilities_dir(root) / NAME / "service"


# The selectors of where and how a project's scheduler runs. Each is read from
# the process environment first and then from the project's .env and
# .env.local, and only these keys are read from those files, so resolving a
# project - as the machine service does for every project it serves - holds
# none of the project's other values.
_SELECTOR_KEYS = ("AUTOMATIONS_ENVIRONMENT", "AUTOMATIONS_NAMESPACE",
                  "AUTOMATIONS_CONFIG", "AUTOMATIONS_STATE_DIR")


def _env_file_entries(path: Path, keep: tuple[str, ...] = ()) -> dict:
    """Every name an env file sets, read the way `_parse_env_file` reads it,
    each with its value only where `keep` names it and None otherwise, so a
    caller asking what a file sets holds no value it did not ask for."""
    out: dict = {}
    try:
        text = path.read_text()
    except OSError:
        return out
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        if key.startswith("export "):
            key = key[len("export "):].strip()
        out[key] = value.strip().strip('"').strip("'") if key in keep else None
    return out


def _project_selectors() -> dict:
    """The project's own selectors from its .env and .env.local (.local wins)."""
    root = _project_root()
    if root is None:
        return {}
    merged: dict = {}
    for name in (".env", ".env.local"):
        merged.update({key: value for key, value in
                       _env_file_entries(root / name, _SELECTOR_KEYS).items()
                       if key in _SELECTOR_KEYS})
    return merged


def _config_path(root: Path) -> Path:
    override = os.environ.get("AUTOMATIONS_CONFIG") or _project_selectors().get("AUTOMATIONS_CONFIG")
    if override:
        path = Path(override).expanduser()
        return path if path.is_absolute() else root / path
    return _service_dir(root) / "config.toml"


def _state_override(root: Path) -> Path | None:
    override = os.environ.get("AUTOMATIONS_STATE_DIR") or _project_selectors().get("AUTOMATIONS_STATE_DIR")
    if override:
        path = Path(override).expanduser()
        return path if path.is_absolute() else root / path
    return None


def _state_project_key(root: Path) -> str:
    try:
        identity = json.loads((_project_capabilities_dir(root) / "project.json").read_text())
    except (OSError, ValueError):
        identity = {}
    slug = identity.get("slug") if isinstance(identity, dict) else None
    if isinstance(slug, str) and slug.strip():
        return slug.strip()
    digest = hashlib.sha256(str(root.resolve()).encode()).hexdigest()[:16]
    return f"path-{digest}"


STATE_RECORD = "state-root.json"


def _state_marker_path(root: Path) -> Path:
    """Where a starting daemon records the state root it is actually using.

    A supervisor's environment is not visible from a terminal opened afterwards,
    so an invocation that re-derives the root can only guess at a daemon started
    with an override. The record is written by the process that starts the
    daemon, from the same value it hands the daemon, so the two cannot disagree.

    The record is this project's operational state and names a path on one
    machine, so it lives in the capability's project state home, which the
    manager-owned guard keeps out of everything the project commits.
    """
    return _legacy_state_path(root) / STATE_RECORD


def _unguarded_marker_path(root: Path) -> Path:
    """The record's place beside the state home, where earlier releases wrote it.

    No guard reaches this file, so a project that commits its body commits it.
    It is still read, because a daemon an earlier release started is findable
    through nothing else, and it goes as soon as the record in the state home
    answers for a daemon, and with `stop`.
    """
    return _project_capabilities_dir(root) / NAME / STATE_RECORD


def _record_made_its_directory(path: Path) -> bool:
    try:
        record = json.loads(path.read_text())
    except (OSError, ValueError):
        return False
    return isinstance(record, dict) and record.get("created_directory") is True


def _record_state_root(root: Path, state: Path) -> str | None:
    """Record the root, or say why it could not be recorded. Never raise.

    An envelope that refuses the file - a read-only mount, foreign ownership -
    is an inability to write down a fact about a daemon that is starting
    regardless, and that cannot be a reason for the daemon not to exist. The
    failure is returned for the caller to surface rather than thrown, because
    unrecorded and unreported is the invisibility this record exists to remove.

    The state home is also where the envelope layout kept all of the service's
    state, and the upgrade from that layout takes the directory's existence for
    one. A record that has to create the directory says so, which lets the
    upgrade see past it and lets `stop` take the directory back with the record.
    """
    path = _state_marker_path(root)
    made = False
    try:
        made = not path.parent.exists()
        created = made or _record_made_its_directory(path)
        path.parent.mkdir(parents=True, exist_ok=True)
        record: dict[str, Any] = {"state_dir": str(state)}
        if created:
            record["created_directory"] = True
        path.write_text(json.dumps(record, indent=2) + "\n")
    except OSError as exc:
        if made:
            with contextlib.suppress(OSError):
                path.parent.rmdir()
        return (f"state root not recorded in {path}: {exc.strerror or exc}"
                " - an invocation that does not carry AUTOMATIONS_STATE_DIR will answer"
                " about the default root rather than about this daemon")
    return _forget_unguarded_record(root)


def _forget_unguarded_record(root: Path) -> str | None:
    path = _unguarded_marker_path(root)
    try:
        path.unlink(missing_ok=True)
    except OSError as exc:
        return (f"state root record not removed from {path}: {exc.strerror or exc}"
                " - it stays behind where the project commits it, and is ignored"
                " while no live daemon answers for it")
    return None


def _forget_state_root(root: Path) -> str | None:
    path = _state_marker_path(root)
    created = _record_made_its_directory(path)
    reasons: list[str] = []
    try:
        path.unlink(missing_ok=True)
    except OSError as exc:
        reasons.append(f"state root record not removed from {path}: {exc.strerror or exc}"
                       " - it stays behind, and is ignored while no live daemon answers for it")
    else:
        if created:
            # Only while it is empty: whatever else is in it is not the record's.
            with contextlib.suppress(OSError):
                path.parent.rmdir()
    unguarded = _forget_unguarded_record(root)
    if unguarded is not None:
        reasons.append(unguarded)
    return "; ".join(reasons) or None


def _state_record_unwritable(root: Path) -> str | None:
    """Why there is no record to read, when the answer is that there could not be one.

    An absent record has two unlike causes - no daemon ever wrote one, or the
    envelope refuses the file - and they look identical from the absence. Only
    the second is a fault, and it is the one that makes a `running: false`
    wrong. Probed rather than attempted, because the caller is `status`, which
    answers about the machine and never changes it.
    """
    path = _state_marker_path(root)
    existing = next((candidate for candidate in (path, *path.parents) if candidate.exists()), None)
    if existing is None or os.access(existing, os.W_OK):
        return None
    return (f"no state root record: {path} cannot be written"
            " - a daemon started here is not findable by an invocation that does"
            " not carry AUTOMATIONS_STATE_DIR")


def _recorded_state_roots(root: Path) -> list[Path]:
    """Every root a record names, the state home's record first."""
    roots: list[Path] = []
    for marker in (_state_marker_path(root), _unguarded_marker_path(root)):
        try:
            record = json.loads(marker.read_text())
        except (OSError, ValueError):
            continue
        raw = record.get("state_dir") if isinstance(record, dict) else None
        if not isinstance(raw, str) or not raw.strip():
            continue
        path = Path(raw.strip()).expanduser()
        roots.append(path if path.is_absolute() else root / path)
    return roots


def _state_resolution(root: Path) -> tuple[Path, str, list[str]]:
    """The state root this invocation acts on, and every root it looked at.

    An explicit override is an instruction and wins: a record left by a daemon
    does not get to overrule what the caller said. Otherwise a record with a live
    daemon behind it beats the derived default, because it is the fact and the
    default is only a derivation of one. A record no live daemon answers for is
    spent - it must not send a `start` somewhere else, nor make an answer be
    about a directory nobody is using - so it is reported and not followed.
    """
    default = _STATE_HOME / "capabilities" / "projects" / _state_project_key(root) / NAME
    override = _state_override(root)
    recorded = _recorded_state_roots(root)
    considered = [str(path) for path in
                  dict.fromkeys(path for path in (override, *recorded, default) if path is not None)]
    if override is not None:
        return override, "override", considered
    for path in recorded:
        if path != default and _pid_alive(_read_pid(path / "daemon.pid")):
            return path, "daemon_record", considered
    return default, "default", considered


def _state_path(root: Path) -> Path:
    return _state_resolution(root)[0]


def _legacy_state_path(root: Path) -> Path:
    return _project_capabilities_dir(root) / NAME / "state"


LEGACY_REGENERATED = {
    "automations.db", "automations.db-shm", "automations.db-wal",
    "daemon.lock", "daemon.pid", "daemon.fingerprint", "scripts",
}

# Files the service appends to rather than rebuilds. Their legacy content is
# real history and is carried across, but `service start` reopens the XDG copy
# in append mode, so the daemon's own output makes the two differ from the first
# line it writes. Seed such a file once and then leave it alone: a later
# divergence is the service running, not a conflict between two states.
LEGACY_APPENDED = {"daemon.log"}


def _copy_legacy_state(source: Path, destination: Path) -> int:
    if source.is_symlink():
        raise RuntimeError(f"legacy state contains a symlink: {source}")
    if source.is_dir():
        destination.mkdir(parents=True, exist_ok=True)
        return sum(_copy_legacy_state(child, destination / child.name)
                   for child in sorted(source.iterdir()))
    if not source.is_file():
        raise RuntimeError(f"legacy state contains an unsupported entry: {source}")
    if destination.exists():
        if not destination.is_file() or destination.read_bytes() != source.read_bytes():
            raise RuntimeError(f"legacy state conflicts with XDG state: {destination}")
        return 0
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source, destination)
    return 1


def _holds_only_its_own_record(legacy: Path) -> bool:
    """Whether the directory exists only because the daemon's record made it."""
    try:
        names = [entry.name for entry in legacy.iterdir()]
    except OSError:
        return False
    return names == [STATE_RECORD] and _record_made_its_directory(legacy / STATE_RECORD)


def _migrate_legacy_state(root: Path, runtime, config: dict[str, Any]) -> dict[str, Any] | None:
    """Copy durable envelope state once and repoint historical run logs.

    The source remains untouched. A consuming project may remove it only after
    proving the XDG copy and the restarted service, which keeps rollback safe.
    Explicit AUTOMATIONS_STATE_DIR overrides are deliberate and never trigger
    an implicit migration from the former default.

    The daemon's state root record lives in the same directory and is never part
    of the envelope layout: it is not copied, and a directory that holds nothing
    but a record that had to create it is not taken for that layout.
    """
    if _state_override(root) is not None:
        return None
    legacy = _legacy_state_path(root)
    target = _state_path(root)
    if not legacy.is_dir() or legacy.resolve() == target.resolve():
        return None
    if _holds_only_its_own_record(legacy):
        return None
    copied = 0
    try:
        for source in sorted(legacy.iterdir()):
            if source.name in LEGACY_REGENERATED or source.name == STATE_RECORD:
                continue
            destination = target / source.name
            if source.name in LEGACY_APPENDED and source.is_file():
                # Nothing to hand over from an empty log, and once the
                # destination exists it is the live file the service writes to.
                if source.stat().st_size == 0 or destination.exists():
                    continue
            copied += _copy_legacy_state(source, destination)
    except (OSError, RuntimeError) as exc:
        raise runtime.ConfigError(f"cannot migrate legacy automation state: {exc}") from exc

    repointed = 0
    with runtime.open_ledger(root, config) as ledger:
        legacy_resolved = legacy.resolve()
        for row in ledger._rows():
            old_log = Path(row["log_path"])
            try:
                relative = old_log.resolve().relative_to(legacy_resolved)
            except (OSError, ValueError):
                continue
            new_log = target / relative
            if old_log.is_file() and not new_log.is_file():
                raise runtime.ConfigError(
                    f"run log was not copied from {old_log} to {new_log}")
            if new_log.is_file() and str(new_log) != row["log_path"]:
                ledger.update(row["id"], log_path=str(new_log))
                repointed += 1
    return {
        "source": str(legacy), "target": str(target),
        "files_copied": copied, "run_logs_repointed": repointed,
        "source_preserved": True,
    }


def _prepare_service(root: Path):
    """Everything the daemon needs before it may take any work, the store first:
    the ledger is opened and migrated here, so a machine with no store, or one
    that cannot be reached, refuses before a daemon is started at all."""
    runtime, config = _load(root)
    try:
        runtime.open_ledger(root, config).close()
    except runtime.StoreUnavailable as exc:
        _store_refusal(exc)
    except runtime.ConfigError as exc:
        _die(6, "not_runnable", str(exc))
    try:
        migration = _migrate_legacy_state(root, runtime, config)
    except runtime.ConfigError as exc:
        _die(6, "state_migration_failed", str(exc),
             "resolve the conflicting XDG and legacy files, then start again")
    return runtime, config, migration


# A store setting that cannot be used is a configuration fault; a store that
# cannot be reached or refuses the migration is the environment's.
_STORE_CONFIG_SLUGS = frozenset({
    "store_not_configured", "store_not_postgres", "store_setting_unreadable",
    "bad_store_setting", "sslmode_too_weak", "bad_schema_name"})


def _store_refusal(exc) -> NoReturn:
    _die(6 if exc.slug in _STORE_CONFIG_SLUGS else 5, exc.slug, exc.message, exc.hint)


def _runtime_module():
    path = _runtime_path()
    if not path.is_file():
        _die(
            3,
            "service_bundle_missing",
            f"bundled automations runtime not found: {path}",
            "reinstall/update automations from a bundled source directory",
        )
    spec = importlib.util.spec_from_file_location("automations_runtime", path)
    if spec is None or spec.loader is None:
        _die(5, "runtime_load_failed", f"cannot load bundled runtime: {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    module.PROJECT_ID_FOR_WRITE = lambda strict=True: _project_id(write=True, refuse=strict)
    return module


def _load_config(runtime, root: Path) -> dict[str, Any]:
    """The declaration as the project's scheduler acts on it, in either mode.
    Raises the runtime's ConfigError."""
    config = runtime.load_effective_config(root, _config_path(root), _state_path(root))
    selectors = _project_selectors()
    config["engine"]["environment"] = (
        os.environ.get("AUTOMATIONS_ENVIRONMENT")
        or selectors.get("AUTOMATIONS_ENVIRONMENT")
        or config["engine"]["environment"]
    )
    config["engine"]["namespace"] = (
        os.environ.get("AUTOMATIONS_NAMESPACE")
        or selectors.get("AUTOMATIONS_NAMESPACE")
        or config["engine"]["namespace"]
    )
    return config


def _load(root: Path):
    runtime = _runtime_module()
    try:
        config = _load_config(runtime, root)
    except runtime.ConfigError as exc:
        _die(6, "invalid_config", str(exc), "run `automations service init` or repair config.toml")
    return runtime, config


def _read_pid(path: Path) -> int | None:
    try:
        return int(path.read_text().strip())
    except (OSError, ValueError):
        return None


def _pid_alive(pid: int | None) -> bool:
    if not pid or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def _service_env(root: Path) -> dict[str, str]:
    # Resolving the id a write may stamp hands it down in the environment the
    # daemon inherits, so the daemon registers under it without asking again.
    _project_id(write=True)
    env = dict(os.environ)
    env.update({key: str(value) for key, value in _project_env().items()})
    env.update(
        {
            "AUTOMATIONS_PROJECT_ROOT": str(root),
            "AUTOMATIONS_CONFIG": str(_config_path(root)),
            "AUTOMATIONS_STATE_DIR": str(_state_path(root)),
        }
    )
    return env


def cmd_service_init(force: bool) -> dict[str, Any]:
    root = _root_required()
    config_template = _template("config.toml")
    script_template = _template("example.py")
    missing = [str(path) for path in (config_template, script_template) if not path.is_file()]
    if missing:
        _die(3, "service_bundle_missing", "bundled automations templates are missing", ", ".join(missing))
    config_path = _service_dir(root) / "config.toml"
    script_path = _project_capabilities_dir(root) / NAME / "scripts" / "example.py"
    written: list[str] = []
    skipped: list[str] = []
    for source, target in ((config_template, config_path), (script_template, script_path)):
        target.parent.mkdir(parents=True, exist_ok=True)
        if target.exists() and not force:
            skipped.append(str(target))
            continue
        target.write_text(source.read_text())
        written.append(str(target))
    if script_path.exists():
        script_path.chmod(script_path.stat().st_mode | 0o755)
    return {
        "initialized": NAME,
        "project": str(root),
        "config": str(config_path),
        "written": written,
        "skipped": skipped,
        "next": [
            "edit config.toml and add project scripts",
            "run `automations doctor`",
            "run `automations service start` or `automations service run`",
        ],
    }


def service_status(root: Path) -> dict[str, Any]:
    state, state_source, considered = _state_resolution(root)
    record_error = None if _recorded_state_roots(root) \
        else _state_record_unwritable(root)
    pid_file = state / "daemon.pid"
    pid = _read_pid(pid_file)
    running = _pid_alive(pid)
    counts: dict[str, int] = {}
    counts_error: str | None = None
    runtime = _runtime_module()
    initialized = _config_path(root).is_file()
    # No runs counted and no store to count them in are different facts, and a
    # report that prints them the same way hides the second one. This swallowed
    # every exception into an empty map for long enough to hide a wrong call
    # here, so what it catches now, it says.
    if initialized and counts_error is None:
        try:
            counts = runtime.counts(root, _load(root)[1])
        except Exception as exc:
            counts_error = f"{type(exc).__name__}: {exc}"
    joined = _joined_here()
    return {
        "initialized": initialized,
        "running": running,
        "pid": pid if running else None,
        "stale_pid": bool(pid and not running),
        # Who serves this project: its own daemon, or the machine service it
        # joined, whose view of this project rides along under `machine`.
        "mode": "machine" if joined else "project",
        **({"machine": _machine_view(runtime, joined)} if joined else {}),
        "paused": runtime.read_pause(state),
        "project": str(root),
        "environment": os.environ.get("AUTOMATIONS_ENVIRONMENT")
        or _project_selectors().get("AUTOMATIONS_ENVIRONMENT")
        or "development",
        # The environment above is this invocation's, and a supervisor's is not
        # visible from a terminal opened later, so the two are ordinarily
        # different and a payload carrying only one lets a reader take it for
        # both. This is the daemon's own answer, published by the daemon; `null`
        # says there is no daemon, or that it is one too old to have published it.
        "daemon_environment": runtime.read_daemon_environment(state) if running else None,
        "config": str(_config_path(root)),
        "state_dir": str(state),
        # A `running: false` is a statement about one directory, and a reader who
        # cannot see which one has to believe it. These name the place the answer
        # came from and every place this invocation weighed, so the answer can be
        # checked against a directory instead.
        "state_dir_source": state_source,
        "state_dirs_considered": considered,
        # And a reader who finds no record behind a `false` is owed the reason
        # there is none, because an envelope that refuses the file makes that
        # `false` wrong in a way no directory listing explains.
        **({"state_record_error": record_error} if record_error else {}),
        **_store_named(runtime),
        "pid_file": str(pid_file),
        "log_file": str(state / "daemon.log"),
        "counts": counts,
        **({"counts_error": counts_error} if counts_error else {}),
    }


def _store_named(runtime) -> dict[str, Any]:
    """Which store the run ledger is kept in, named without reaching it."""
    try:
        return runtime.store_in_force()
    except runtime.StoreUnavailable as exc:
        error = {"code": exc.slug, "message": exc.message}
        if exc.hint:
            error["hint"] = exc.hint
        return {"store": None, "store_error": error}


def _service_findings(runtime, config: dict, state: Path, running: bool,
                      daemon_environment: str | None) -> dict[str, Any]:
    """What the service's health answer finds from this machine alone: the
    declared scripts, and whether a running daemon is current and selecting
    anything. Nothing here reaches the store, so `doctor` and `inventory`
    judge these by the same code and only `doctor` adds the store's checks."""
    missing_scripts = [
        item["script"] for item in config["automations"] if not item["script_path"].is_file()
    ]
    # A daemon that is alive is not thereby current: it loaded its declaration
    # once, at startup, and every edit since is something it has never seen.
    # Nothing else in the system can notice that, so the health answer does.
    config_stale = None
    if running:
        loaded = runtime.read_config_fingerprint(state)
        current = runtime.config_fingerprint(config)
        if loaded != current:
            config_stale = {
                "loaded": loaded,
                "current": current,
                "message": (
                    "the running daemon did not record which configuration it "
                    "loaded, so it cannot be shown to be running the current one"
                    if loaded is None else
                    "the running daemon loaded a configuration that has changed "
                    "since; the automations declared now are not the ones it "
                    "is scheduling"
                ),
                "hint": "restart the service so the daemon reloads its configuration",
            }
    # A daemon that is alive is not thereby working: it selects what to schedule
    # by the environment it was started under, which is its own and not this
    # invocation's, so a supervisor's selector can leave every declared
    # automation unselected. That daemon ticks, answers, and schedules nothing,
    # and counting the declarations rather than the selected ones reports it as
    # healthy. Selection here is by environment alone and not by `applies`,
    # because an automation switched off is off on purpose and a health answer
    # that failed over it would be wrong about a project that meant it.
    #
    # Only a project whose every automation names an environment can be left
    # idle this way: one that names none runs under all of them, so a daemon
    # with even one of those is scheduling regardless and is owed no finding.
    #
    # A daemon that published no environment is a different answer and not a
    # quieter version of this one. The finding is a positive fact - this daemon
    # holds an environment, and nothing declared here names it - while an
    # absent record is the absence of the fact that would decide, and inferring
    # idleness from it would fail every correctly running daemon started before
    # this payload, on the first health check after an upgrade. So it is said in
    # the payload instead of in the exit code: `environment_unknown` names what
    # this answer cannot speak to, and leaves `ok` to the things it can.
    environment_idle = None
    environment_unknown = None
    environment_scoped = config["automations"] and all(
        item["environments"] for item in config["automations"])
    if running and environment_scoped:
        declared = sorted({name for item in config["automations"]
                           for name in item["environments"]})
        selected = [item["id"] for item in config["automations"]
                    if daemon_environment in item["environments"]]
        if daemon_environment is None:
            environment_unknown = {
                "daemon_environment": None,
                "declared": declared,
                "message": (
                    "the running daemon did not record which environment it loaded, so this "
                    "answer cannot say which of the automations declared here it is "
                    "scheduling, or whether it is scheduling any; a daemon started before "
                    "this payload publishes no environment and keeps running across the "
                    "upgrade, and that is not itself a fault"
                ),
                "hint": "restart the service so the daemon publishes the environment it loads",
            }
        elif not selected:
            environment_idle = {
                "daemon_environment": daemon_environment,
                "declared": declared,
                "message": (
                    f"the running daemon loaded environment {daemon_environment!r}, and none "
                    f"of the {len(config['automations'])} automations declared here is "
                    "declared for it, so it is scheduling nothing"
                ),
                "hint": "start the service under a declared environment, or declare these "
                        "automations for the one it runs under",
            }
    return {"missing_scripts": missing_scripts, "config_stale": config_stale,
            "environment_idle": environment_idle,
            "environment_unknown": environment_unknown}


def cmd_doctor(repair: bool = False) -> dict[str, Any]:
    root = _root_required()
    runtime, config = _load(root)
    state = _state_path(root)
    state.mkdir(parents=True, exist_ok=True)
    try:
        runtime.open_ledger(root, config, strict=False).close()
    except runtime.StoreUnavailable as exc:
        _store_refusal(exc)
    except Exception as exc:
        _die(5, "state_unavailable", f"the store is unavailable: {exc}")
    status = service_status(root)
    daemon_environment = status["daemon_environment"]
    found = _service_findings(runtime, config, state, status["running"],
                              daemon_environment)
    missing_scripts = found["missing_scripts"]
    config_stale = found["config_stale"]
    environment_idle = found["environment_idle"]
    environment_unknown = found["environment_unknown"]
    result = {
        "ok": not missing_scripts and config_stale is None
        and environment_idle is None,
        "project": str(root),
        "environment": config["engine"]["environment"],
        # This invocation's environment is the one above; this is the running
        # daemon's, and only it decides what is actually being scheduled.
        "daemon_environment": daemon_environment,
        "namespace": config["engine"]["namespace"],
        "automations": len(config["automations"]),
        "missing_scripts": missing_scripts,
        "service": status,
    }
    if config_stale is not None:
        result["config_stale"] = config_stale
    if environment_idle is not None:
        result["environment_idle"] = environment_idle
    if environment_unknown is not None:
        result["environment_unknown"] = environment_unknown
    if repair:
        result["repaired"] = {
            "repaired": False,
            "reason": "the run ledger's table is created whole by its own migration",
        }
    return result


def cmd_list() -> dict[str, Any]:
    root = _root_required()
    runtime, config = _load(root)
    environment = config["engine"]["environment"]
    items = []
    for item in config["automations"]:
        items.append(
            {
                "id": item["id"],
                # Authored for whoever reads the listing rather than for the
                # engine, so this is the surface they exist to reach.
                "name": item["name"],
                "description": item["description"],
                "enabled": item["enabled"],
                "applies": runtime.applies(item, environment),
                "environments": item["environments"],
                "script": item["script"],
                "schedule": item["schedule"],
                "every_seconds": item["every_seconds"],
                "overlap": item["overlap"],
                "max_parallel": item["max_parallel"],
                "timeout_seconds": item["timeout_seconds"],
                "retries": item["retries"],
            }
        )
    return {"environment": environment, "automations": items}


# --- set: editing one entry of config.toml in place ---------------------------
#
# config.toml is a person's file: its comments carry why each automation exists.
# So `set` never round-trips it through a serializer. A small scanner locates the
# byte span of each value, the edit replaces that span (or inserts or removes
# the one key line), and the candidate is proven twice before it replaces the
# file: re-parsed to show that only the requested values moved, and loaded by
# the runtime exactly as the daemon loads it.

SET_TEXT_LIMITS = {"name": 80, "description": 500}
SET_FIELDS = ("name", "description", "enabled")
# Where a key the entry does not declare yet is inserted: after the nearest
# earlier key of this order that it does declare (`id` always exists).
_SET_KEY_ORDER = ("id", "name", "description", "enabled")
_SET_SEPARATORS = {" ", " "}


class _TomlScanError(ValueError):
    pass


def _toml_skip(text: str, i: int, newlines: bool = False) -> int:
    """Skip spaces and tabs; inside an array also newlines and comments."""
    while i < len(text):
        c = text[i]
        if c in " \t":
            i += 1
        elif newlines and c in "\r\n":
            i += 1
        elif newlines and c == "#":
            while i < len(text) and text[i] != "\n":
                i += 1
        else:
            break
    return i


def _toml_string_end(text: str, i: int) -> int:
    """Index just past the string starting at `i` (any of TOML's four kinds)."""
    for quote in ('"""', "'''"):
        if text.startswith(quote, i):
            j = i + 3
            while True:
                if j >= len(text):
                    raise _TomlScanError("unterminated multi-line string")
                if quote == '"""' and text[j] == "\\":
                    j += 2
                    continue
                if text.startswith(quote, j):
                    end = j + 3
                    # Up to two quotes may sit directly before the delimiter.
                    extra = 0
                    while extra < 2 and end < len(text) and text[end] == quote[0]:
                        end += 1
                        extra += 1
                    return end
                j += 1
    quote = text[i]
    j = i + 1
    while j < len(text) and text[j] != quote:
        if text[j] == "\n":
            raise _TomlScanError("newline in a single-line string")
        if quote == '"' and text[j] == "\\":
            j += 1
        j += 1
    if j >= len(text):
        raise _TomlScanError("unterminated string")
    return j + 1


def _toml_key_end(text: str, i: int, stop: str) -> int:
    """Index of `stop` ending a (possibly dotted, possibly quoted) key at `i`."""
    while i < len(text):
        c = text[i]
        if c in "\"'":
            i = _toml_string_end(text, i)
        elif c == stop:
            return i
        elif c in "\r\n":
            break
        else:
            i += 1
    raise _TomlScanError(f"expected {stop!r} after a key")


def _toml_value_end(text: str, i: int) -> int:
    """Index just past the value starting at `i`."""
    if i >= len(text):
        raise _TomlScanError("missing value")
    c = text[i]
    if c in "\"'":
        return _toml_string_end(text, i)
    if c == "[":
        j = i + 1
        while True:
            j = _toml_skip(text, j, newlines=True)
            if j >= len(text):
                raise _TomlScanError("unterminated array")
            if text[j] == "]":
                return j + 1
            j = _toml_skip(text, _toml_value_end(text, j), newlines=True)
            if j < len(text) and text[j] == ",":
                j += 1
    if c == "{":
        j = i + 1
        while True:
            j = _toml_skip(text, j)
            if j >= len(text):
                raise _TomlScanError("unterminated inline table")
            if text[j] == "}":
                return j + 1
            j = _toml_skip(text, _toml_key_end(text, j, "=") + 1)
            j = _toml_skip(text, _toml_value_end(text, j))
            if j < len(text) and text[j] == ",":
                j += 1
    j = i
    while j < len(text) and text[j] not in " \t\r\n#,]}":
        j += 1
    if j == i:
        raise _TomlScanError("missing value")
    return j


def _toml_key_path(key_text: str) -> tuple:
    """A dotted, possibly quoted key as the tuple of names TOML reads it as."""
    node = tomllib.loads(key_text + " = 0")
    path = []
    while isinstance(node, dict) and len(node) == 1:
        name = next(iter(node))
        path.append(name)
        node = node[name]
    return tuple(path)


def _toml_scan(text: str) -> list[dict]:
    """Every table header and key/value line of a document, with byte spans.

    Headers are {"kind": "table"|"array", "path", "start", "end"}; key/values
    are {"kind": "key", "path", "header" (index of the enclosing header or
    None), "start" (line start), "value": (start, end), "end" (past the line's
    newline)}. Positions are str indices into `text`."""
    rows: list[dict] = []
    header: int | None = None
    i = 0
    while i < len(text):
        line_start = i
        i = _toml_skip(text, i)
        if i >= len(text):
            break
        c = text[i]
        if c in "\r\n#":
            nl = text.find("\n", i)
            i = len(text) if nl < 0 else nl + 1
            continue
        if c == "[":
            array = text.startswith("[[", i)
            open_len = 2 if array else 1
            close = _toml_key_end(text, i + open_len, "]")
            path = _toml_key_path(text[i + open_len:close])
            nl = text.find("\n", close)
            end = len(text) if nl < 0 else nl + 1
            rows.append({"kind": "array" if array else "table", "path": path,
                         "start": line_start, "end": end})
            header = len(rows) - 1
            i = end
            continue
        eq = _toml_key_end(text, i, "=")
        path = _toml_key_path(text[i:eq])
        value_start = _toml_skip(text, eq + 1)
        value_end = _toml_value_end(text, value_start)
        nl = text.find("\n", value_end)
        end = len(text) if nl < 0 else nl + 1
        rows.append({"kind": "key", "path": path, "header": header,
                     "start": line_start, "value": (value_start, value_end),
                     "end": end})
        i = end
    return rows


def _toml_string(value: str) -> str:
    """A TOML basic string. Control characters are refused before this, so
    only the backslash and the quote need escaping."""
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def _set_text_value(field: str, raw: str) -> str | None:
    """The validated value for --name/--description; None means clear."""
    if raw == "":
        return None
    limit = SET_TEXT_LIMITS[field]
    for ch in raw:
        if unicodedata.category(ch) in {"Cc", "Cs"} or ch in _SET_SEPARATORS:
            _die(6, "invalid_text",
                 f"--{field} must be single-line text: control characters and "
                 f"line or paragraph separators are refused (found U+{ord(ch):04X})")
    if not raw.strip():
        _die(6, "invalid_text", f"--{field} must not be only whitespace",
             f"pass --{field} '' to clear it")
    if len(raw) > limit:
        _die(6, "too_long",
             f"--{field} is {len(raw)} characters; the limit is {limit}")
    return raw


def _parse_set_args(argv: list[str]) -> tuple[str, dict[str, Any]]:
    usage = "automations set <automation-id> [--name TEXT] [--description TEXT] [--enabled true|false]"
    automation_id: str | None = None
    raw: dict[str, str] = {}
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg.startswith("--"):
            flag, eq, value = arg[2:].partition("=")
            if flag not in SET_FIELDS:
                _die(6, "input", f"unknown set option {arg!r}", usage)
            if not eq:
                if i + 1 >= len(argv):
                    _die(6, "input", f"--{flag} needs a value", usage)
                i += 1
                value = argv[i]
            if flag in raw:
                _die(6, "input", f"--{flag} given more than once", usage)
            raw[flag] = value
        elif automation_id is None:
            automation_id = arg
        else:
            _die(6, "input", f"unexpected argument {arg!r}", usage)
        i += 1
    if automation_id is None:
        _die(6, "input", "set needs an automation id", usage)
    if not raw:
        _die(6, "input", "set needs at least one of --name, --description, --enabled", usage)
    changes: dict[str, Any] = {}
    for field in ("name", "description"):
        if field in raw:
            changes[field] = _set_text_value(field, raw[field])
    if "enabled" in raw:
        if raw["enabled"] not in {"true", "false"}:
            _die(6, "invalid_enabled",
                 f"--enabled takes exactly true or false, not {raw['enabled']!r}")
        changes["enabled"] = raw["enabled"] == "true"
    return automation_id, changes


def _edit_entry(text: str, index: int, entry: dict, changes: dict[str, Any]) -> tuple[str, list[str]]:
    """The document with `changes` applied to the index-th [[automations]]
    entry, touching only those values' spans; and the fields that changed."""
    rows = _toml_scan(text)
    headers = [n for n, row in enumerate(rows)
               if row["kind"] == "array" and row["path"] == ("automations",)]
    if len(headers) <= index:
        raise _TomlScanError("the entry is not written as an [[automations]] table")
    header = headers[index]
    keys = {row["path"][0]: row for row in rows
            if row["kind"] == "key" and row["header"] == header and len(row["path"]) == 1}
    newline = "\r\n" if "\r\n" in text else "\n"
    edits: list[tuple[int, int, str]] = []
    changed: list[str] = []
    for field in SET_FIELDS:
        if field not in changes:
            continue
        wanted = changes[field]
        current = entry.get(field)
        if field == "enabled":
            # An entry that omits `enabled` is enabled; saying so adds nothing.
            if (current if field in entry else True) == wanted:
                continue
            literal = "true" if wanted else "false"
        else:
            if current == wanted or (wanted is None and field not in entry):
                continue
            literal = None if wanted is None else _toml_string(wanted)
        changed.append(field)
        row = keys.get(field)
        if row is not None and literal is not None:
            edits.append((*row["value"], literal))
        elif row is not None:
            edits.append((row["start"], row["end"], ""))
        else:
            anchor = next(keys[k] for k in reversed(_SET_KEY_ORDER[:_SET_KEY_ORDER.index(field)])
                          if k in keys)
            line = text[anchor["start"]:anchor["end"]]
            indent = line[:len(line) - len(line.lstrip(" \t"))]
            lead = "" if line.endswith("\n") else newline
            edits.append((anchor["end"], anchor["end"],
                          f"{lead}{indent}{field} = {literal}{newline}"))
    # Applied from the end so earlier spans keep their positions; lines
    # inserted at one point are applied last-field-first to read in field order.
    for start, end, replacement in sorted(edits, key=lambda e: (e[0], edits.index(e)),
                                          reverse=True):
        text = text[:start] + replacement + text[end:]
    return text, changed


def _write_atomically(runtime, root: Path, target: Path, data: bytes) -> None:
    """Replace `target` with `data` only if the result loads as the daemon
    would load it; on any failure the file is left exactly as it was."""
    fd, tmp_name = tempfile.mkstemp(dir=str(target.parent), prefix=f".{target.name}.",
                                    suffix=".tmp")
    tmp = Path(tmp_name)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(tmp, stat.S_IMODE(target.stat().st_mode))
        try:
            runtime.load_config(root, tmp)
        except runtime.ConfigError as exc:
            _die(6, "invalid_config",
                 f"the edited configuration would not load: {exc}",
                 "nothing was written; repair config.toml and retry")
        os.replace(tmp, target)
    except OSError as exc:
        _die(5, "write_failed", f"cannot write {target}: {exc}",
             "nothing was written")
    finally:
        with contextlib.suppress(FileNotFoundError):
            tmp.unlink()


def cmd_set(argv: list[str], timeout: float = 20.0) -> dict[str, Any]:
    automation_id, changes = _parse_set_args(argv)
    root = _root_required()
    if not _project_enabled_explicitly():
        _die(4, "project_enable_required",
             f"`{NAME} set` writes the project's config.toml, which requires an "
             "explicit project enable",
             f"ask the user, then run `capabilities enable {NAME} --project`")
    runtime = _runtime_module()
    config_path = _config_path(root)
    target = config_path.resolve()
    try:
        original = target.read_bytes()
    except FileNotFoundError:
        _die(6, "invalid_config", f"config not found: {config_path}",
             "run `automations service init`")
    except OSError as exc:
        _die(5, "read_failed", f"cannot read {config_path}: {exc}")
    try:
        text = original.decode("utf-8")
        document = tomllib.loads(text)
    except (UnicodeDecodeError, tomllib.TOMLDecodeError) as exc:
        _die(6, "invalid_config", f"cannot read config {config_path}: {exc}",
             "nothing was written; repair config.toml and retry")
    entries = document.get("automations")
    entries = entries if isinstance(entries, list) else []
    index = next((n for n, entry in enumerate(entries)
                  if isinstance(entry, dict) and entry.get("id") == automation_id), None)
    if index is None:
        _die(3, "not_found", f"unknown automation {automation_id!r}",
             "run `automations list`")
    try:
        edited, changed = _edit_entry(text, index, entries[index], changes)
    except (_TomlScanError, tomllib.TOMLDecodeError, StopIteration) as exc:
        _die(6, "config_not_editable",
             f"cannot locate the entry for {automation_id!r} in {config_path}: {exc}",
             "nothing was written; edit config.toml by hand")
    # The scanner is proven on every write: the candidate must parse to exactly
    # the original document with the requested values changed.
    expected = copy.deepcopy(document)
    for field, value in changes.items():
        if value is None:
            expected["automations"][index].pop(field, None)
        elif field == "enabled" and "enabled" not in changed:
            continue
        else:
            expected["automations"][index][field] = value
    try:
        actual = tomllib.loads(edited)
    except tomllib.TOMLDecodeError:
        actual = None
    if actual != expected:
        _die(5, "edit_failed",
             f"the edit to {config_path} did not come out as requested",
             "nothing was written; edit config.toml by hand")
    if changed:
        _write_atomically(runtime, root, target, edited.encode("utf-8"))
    _, config = _load(root)
    state = _state_path(root)
    pid = _read_pid(state / "daemon.pid")
    running = _pid_alive(pid)
    if not running:
        daemon = {"running": False, "reloaded": False,
                  "reason": "no daemon is running; the file change stands and is "
                            "read when one starts"}
    elif not changed:
        daemon = {"running": True, "reloaded": False, "pid": pid,
                  "reason": "nothing changed"}
    else:
        try:
            daemon = _publish_reload(runtime, state, pid, config, timeout)
        except _ReloadFailed as exc:
            _die(exc.exit_code, exc.code,
                 f"config.toml was updated, but the running daemon did not take it "
                 f"up: {exc.message}",
                 "the file change stands; retry with `automations service reload`")
        daemon.pop("automations", None)
        running = _pid_alive(pid)
    item = runtime.automation_map(config)[automation_id]
    environment = _judging_environment(runtime, config, state, running)
    return {"item": _inventory_item(runtime, item, environment),
            "changed": changed, "config": str(config_path), "daemon": daemon}


def cmd_run(automation_id: str) -> dict[str, Any]:
    root = _root_required()
    runtime, config = _load(root)
    try:
        row = runtime.enqueue_manual(root, config, _state_path(root), automation_id)
    except KeyError:
        _die(3, "not_found", f"unknown automation {automation_id!r}", "run `automations list`")
    except runtime.ConfigError as exc:
        _die(6, "not_runnable", str(exc))
    return {"queued": True, "run": row, "service": service_status(root)}


def cmd_runs(limit: int, status: str | None) -> dict[str, Any]:
    root = _root_required()
    runtime, config = _load(root)
    if status and status not in {*runtime.ACTIVE_STATUSES, *runtime.FINAL_STATUSES}:
        _die(6, "invalid_status", f"unknown run status {status!r}")
    return {"runs": runtime.list_runs(root, config, limit=limit, status=status)}


def _run_required(root: Path, run_id: str):
    runtime, config = _load(root)
    row = runtime.get_run(root, config, run_id)
    if row is None:
        _die(3, "not_found", f"unknown run {run_id!r}", "run `automations runs`")
    return runtime, config, row


def cmd_show(run_id: str) -> dict[str, Any]:
    root = _root_required()
    _runtime, _config, row = _run_required(root, run_id)
    return row


def cmd_logs(run_id: str, tail: int) -> dict[str, Any]:
    root = _root_required()
    _runtime, _config, row = _run_required(root, run_id)
    path = Path(row["log_path"])
    if not path.exists():
        _die(3, "logs_not_found", f"run log does not exist yet: {path}")
    lines = path.read_text(errors="replace").splitlines()
    return {"run_id": run_id, "log_file": str(path), "lines": lines[-max(0, tail) :]}


def cmd_cancel(run_id: str) -> dict[str, Any]:
    root = _root_required()
    runtime, config = _load(root)
    row = runtime.request_cancel(root, config, run_id)
    if row is None:
        _die(3, "not_found", f"unknown run {run_id!r}")
    return {"cancel_requested": bool(row["cancel_requested"]), "run": row}


def cmd_retry(run_id: str) -> dict[str, Any]:
    root = _root_required()
    runtime, config = _load(root)
    try:
        row = runtime.retry_run(root, config, _state_path(root), run_id)
    except runtime.ConfigError as exc:
        _die(6, "not_retryable", str(exc))
    if row is None:
        _die(3, "not_found", f"unknown run {run_id!r}")
    return {"queued": True, "run": row}


def cmd_service_start() -> dict[str, Any]:
    root = _root_required()
    _joined_refusal("start")
    _runtime, _config, migration = _prepare_service(root)
    status = service_status(root)
    if status["running"]:
        status["already_running"] = True
        return status
    state = _state_path(root)
    state.mkdir(parents=True, exist_ok=True)
    log_path = state / "daemon.log"
    runtime_path = _runtime_path()
    with log_path.open("a", encoding="utf-8") as log:
        proc = subprocess.Popen(
            [sys.executable, str(runtime_path)],
            cwd=str(root),
            env=_service_env(root),
            stdout=log,
            stderr=subprocess.STDOUT,
            text=True,
            start_new_session=True,
        )
    # The daemon opens its ledger on the store before it writes its pid, and
    # the store is across a network, so this answers once the daemon has said
    # it is running or has exited, rather than after a guess at how long that takes.
    deadline = time.monotonic() + 15
    while proc.poll() is None and time.monotonic() < deadline \
            and _read_pid(state / "daemon.pid") != proc.pid:
        time.sleep(0.05)
    if proc.poll() is not None:
        tail = log_path.read_text(errors="replace").splitlines()[-8:]
        _die(5, "service_start_failed", f"automations daemon exited with {proc.returncode}", "\n".join(tail))
    record_error = _record_state_root(root, state)
    out = service_status(root)
    out["started"] = True
    # The daemon is up either way; the payload is where this command says so
    # when the fact about it could not be written down.
    if record_error is not None:
        out["state_record_error"] = record_error
    if migration is not None:
        out["state_migration"] = migration
    return out


def cmd_service_reload(timeout: float) -> dict[str, Any]:
    """Publish an edited declaration to the daemon already running.

    The declaration is loaded here first: asking a healthy daemon to take up a
    file that does not parse is a question worth refusing before it is asked.

    Only the daemon is signalled, never its process group, because its children
    are jobs in flight and reloading is precisely the operation that leaves them
    alone. Confirmation is the fingerprint the daemon publishes for the
    declaration it has loaded: when that reaches the one computed here, the swap
    demonstrably happened. A daemon that rejects the new declaration keeps the
    old one and its fingerprint with it, so this reports a timeout rather than a
    success it cannot show.
    """
    runtime = _runtime_module()
    root = _root_required()
    state = _state_path(root)
    pid = _read_pid(state / "daemon.pid")
    if not _pid_alive(pid):
        _die(5, "service_not_running", "no automations daemon is running",
             "start it with `automations service start`")
    try:
        config = runtime.load_effective_config(root, _config_path(root), state)
    except runtime.ConfigError as exc:
        _die(6, "invalid_config", str(exc),
             "the daemon keeps the declaration it has; repair config.toml and retry")
    try:
        return _publish_reload(runtime, state, pid, config, timeout)
    except _ReloadFailed as exc:
        _die(exc.exit_code, exc.code, exc.message, exc.hint)


class _ReloadFailed(Exception):
    def __init__(self, exit_code: int, code: str, message: str, hint: str | None = None):
        super().__init__(message)
        self.exit_code, self.code, self.message, self.hint = exit_code, code, message, hint


def _publish_reload(runtime, state: Path, pid: int, config: dict,
                    timeout: float) -> dict[str, Any]:
    """Signal the running daemon to take up `config` and wait until it
    publishes that declaration's fingerprint. Raises _ReloadFailed."""
    target = runtime.config_fingerprint(config)
    declared = len(runtime.automation_map(config))
    if runtime.read_config_fingerprint(state) == target:
        return {"reloaded": False, "running": True, "pid": pid,
                "automations": declared,
                "reason": "the daemon already runs this declaration"}
    try:
        os.kill(pid, signal.SIGHUP)
    except ProcessLookupError:
        raise _ReloadFailed(5, "service_not_running",
                            "automations daemon exited before the reload") from None
    except PermissionError as exc:
        raise _ReloadFailed(6, "service_reload_failed",
                            f"cannot signal daemon process {pid}: {exc}") from None

    deadline = time.time() + max(timeout, 0.0)
    while time.time() < deadline:
        if not _pid_alive(pid):
            raise _ReloadFailed(5, "service_reload_failed",
                                "automations daemon exited during the reload",
                                "inspect `automations service logs`")
        if runtime.read_config_fingerprint(state) == target:
            return {"reloaded": True, "running": True, "pid": pid,
                    "automations": declared}
        time.sleep(0.1)
    raise _ReloadFailed(5, "service_reload_failed",
                        f"the daemon did not publish the new declaration within {timeout:g}s",
                        "it may have rejected it; inspect `automations service logs`")


def cmd_service_stop(timeout: float, force: bool) -> dict[str, Any]:
    root = _root_required()
    state = _state_path(root)
    pid_file = state / "daemon.pid"
    pid = _read_pid(pid_file)
    # The record answers for a daemon that is running. Once this returns there is
    # none, so it goes with the pid file rather than outliving it as a claim
    # about a directory the next `start` may not even choose. A record that will
    # not go is reported in the payload and never raised: the daemon is stopped
    # either way, and that is what the caller asked for.
    def released(payload: dict[str, Any]) -> dict[str, Any]:
        # The pid file goes only while it still names the daemon this stop was
        # about: the moment that daemon lets go of the lock, the machine service
        # a joined project waits for may take it and write its own.
        current = _read_pid(pid_file)
        if current == pid or not _pid_alive(current):
            pid_file.unlink(missing_ok=True)
        reason = _forget_state_root(root)
        if reason is not None:
            payload["state_record_error"] = reason
        return payload

    if not _pid_alive(pid):
        return released({"stopped": False, "running": False, "pid": None})
    if pid == _machine_pid(_runtime_module()):
        _die(4, "joined_to_machine_service",
             f"the machine {NAME} service, pid {pid}, serves this project, so `{NAME} "
             "service stop` here is refused: it would stop the service of every project",
             f"`{NAME} service pause` holds this project alone; `{NAME} service leave` "
             f"takes it back to project mode; `{NAME} service stop --machine` stops the "
             "machine service for every project")

    def send(sig: signal.Signals) -> None:
        try:
            os.killpg(pid, sig)
        except ProcessLookupError:
            return
        except PermissionError:
            with contextlib.suppress(ProcessLookupError):
                os.kill(pid, sig)

    send(signal.SIGTERM)
    deadline = time.time() + max(timeout, 0.0)
    while time.time() < deadline:
        if not _pid_alive(pid):
            return released({"stopped": True, "running": False, "pid": pid})
        time.sleep(0.1)
    if force:
        send(signal.SIGKILL)
        return released({"stopped": True, "killed": True, "running": False, "pid": pid})
    _die(5, "service_stop_timeout", f"automations daemon did not stop within {timeout:g}s", "retry with `automations service stop --force`")


def cmd_service_logs(tail: int) -> dict[str, Any]:
    root = _root_required()
    path = _state_path(root) / "daemon.log"
    if not path.exists():
        _die(3, "logs_not_found", f"service log does not exist: {path}")
    lines = path.read_text(errors="replace").splitlines()
    return {"log_file": str(path), "lines": lines[-max(0, tail) :]}


def cmd_service_run() -> NoReturn:
    root = _root_required()
    _joined_refusal("run")
    _prepare_service(root)
    # This process becomes the daemon, so it has no payload to carry the news:
    # stderr is the surface a supervisor captures, and it is written before the
    # exec because after it there is nothing left of this program to write it.
    record_error = _record_state_root(root, _state_path(root))
    if record_error is not None:
        sys.stderr.write(json.dumps({"warning": record_error}, ensure_ascii=False) + "\n")
        sys.stderr.flush()
    runtime = _runtime_path()
    os.execvpe(sys.executable, [sys.executable, str(runtime)], _service_env(root))


# --- machine mode -------------------------------------------------------------

# What points a process at one project. The machine process stands in none, and
# a scope it opens for a project points at that project alone.
_PROJECT_POINTERS = ("CLAUDE_PROJECT_DIR", "CAPABILITIES_PROJECT_ID",
                     "CAPABILITIES_PROJECT_ID_ROOT", "CAPABILITIES_PROJECT_ENVELOPE",
                     "CAPABILITIES_PROJECT_ENVELOPE_ROOT", *_SELECTOR_KEYS)
# The run ledger is kept in the machine's store. A project whose own env files
# name a store would keep its runs there under its own daemon and in the
# machine's under the machine service, so it does not join.
_STORE_ENV_KEYS = ("CAPABILITIES_STORE_URL", "CAPABILITIES_STORE_PASSWORD")
_PROJECTS_HEADER = ("# Projects served by the machine automations service. Written by "
                    "`automations service join|leave`; do not edit by hand.")
_PROJECT_ENTRY_KEYS = ("root", "slug", "joined_at", "joined_by")
_MACHINE_KEYS = ("version", "max_parallel")
_NOT_ENABLED = (f"project_enable_required: {NAME} is not enabled explicitly for this "
                f"project, and the machine service acts only for one that enables it "
                f"(`capabilities enable {NAME} --project`)")


class _Refusal(Exception):
    def __init__(self, exit_code: int, code: str, message: str, hint: str | None = None):
        super().__init__(message)
        self.exit_code, self.code, self.message, self.hint = exit_code, code, message, hint


def _machine_service_dir() -> Path:
    return _CONFIG_HOME / NAME / "service"


def _machine_projects_path() -> Path:
    return _machine_service_dir() / "projects.toml"


def _machine_settings_path() -> Path:
    return _machine_service_dir() / "config.toml"


def _machine_state_dir() -> Path:
    return _STATE_HOME / "capabilities" / "machine" / NAME


def _default_project_state_dir(slug: str) -> Path:
    return _STATE_HOME / "capabilities" / "projects" / slug / NAME


def _actor() -> str:
    user = os.environ.get("USER") or os.environ.get("LOGNAME") or "unknown"
    return f"{user}@{socket.gethostname()}"


def _utc_moment(value) -> str:
    """A moment as the list writes it: UTC to the second, `Z`."""
    import datetime as _dt
    if isinstance(value, _dt.datetime):
        if value.tzinfo is not None:
            value = value.astimezone(_dt.timezone.utc)
        return value.strftime("%Y-%m-%dT%H:%M:%SZ")
    return str(value)


def _read_machine_projects(path: Path | None = None) -> dict:
    """The opt-in list, every project on it by its id: its root, slug and when
    and by whom it joined. No file is an empty list; a file that does not read
    as the list is a refusal saying what is wrong with it."""
    path = path or _machine_projects_path()

    def refuse(sentence: str) -> NoReturn:
        raise _Refusal(6, "projects_invalid", f"{path}: {sentence}",
                       f"`{NAME} service join` and `{NAME} service leave` write it; "
                       "repair it, or remove it and join the projects again")

    if not path.exists():
        return {}
    try:
        raw = tomllib.loads(path.read_text())
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError) as exc:
        refuse(f"it could not be read: {exc}")
    unknown = sorted(set(raw) - {"version", "projects"})
    if unknown:
        refuse(f"it names {', '.join(map(repr, unknown))}, which nothing reads")
    if isinstance(raw.get("version"), bool) or raw.get("version") != 1:
        refuse("its `version` is 1")
    projects = raw.get("projects", {})
    if not isinstance(projects, dict):
        refuse("its `projects` is one table per project, `[projects.<id>]`")
    listed = {}
    for project, entry in projects.items():
        if not isinstance(entry, dict):
            refuse(f"its `projects.{project}` is a table")
        extra = sorted(set(entry) - set(_PROJECT_ENTRY_KEYS))
        if extra:
            refuse(f"its `projects.{project}` names {', '.join(map(repr, extra))}, "
                   "which nothing reads")
        root, slug = entry.get("root"), entry.get("slug")
        if not isinstance(root, str) or not Path(root).is_absolute():
            refuse(f"its `projects.{project}.root` is an absolute path")
        if not isinstance(slug, str) or not slug.strip():
            refuse(f"its `projects.{project}.slug` is the project's slug")
        listed[str(project)] = {"root": root, "slug": slug,
                                "joined_at": _utc_moment(entry.get("joined_at")),
                                "joined_by": str(entry.get("joined_by") or "")}
    return listed


def _write_machine_projects(listed: dict, path: Path | None = None) -> None:
    """Write the opt-in list whole, under a spare name first, so a reader finds
    the list before the write or after it and never half of it. JSON's string
    escapes are TOML's for every character."""
    path = path or _machine_projects_path()
    text = lambda value: json.dumps(str(value), ensure_ascii=False)  # noqa: E731
    lines = [_PROJECTS_HEADER, "version = 1", ""]
    for project, entry in sorted(listed.items()):
        key = project if all(c.isalnum() or c in "_-" for c in project) else text(project)
        lines += [f"[projects.{key}]", f"root = {text(entry['root'])}",
                  f"slug = {text(entry['slug'])}", f"joined_at = {entry['joined_at']}",
                  f"joined_by = {text(entry['joined_by'])}", ""]
    path.parent.mkdir(parents=True, exist_ok=True)
    spare = path.with_name(f".{path.name}.{os.getpid()}")
    spare.write_text("\n".join(lines))
    os.replace(spare, path)


class _MachineListLock:
    """The lock `join` and `leave` write the list under, in the machine state
    root, so two of them never write over each other."""

    def __enter__(self):
        import fcntl

        state = _machine_state_dir()
        state.mkdir(parents=True, exist_ok=True)
        self._handle = (state / "projects.lock").open("a+")
        fcntl.flock(self._handle.fileno(), fcntl.LOCK_EX)
        return self

    def __exit__(self, *_exc) -> bool:
        self._handle.close()
        return False


def _listed_projects() -> dict:
    try:
        return _read_machine_projects()
    except _Refusal as refused:
        _die(refused.exit_code, refused.code, refused.message, refused.hint)


def _read_machine_settings(path: Path | None = None) -> dict:
    """The machine settings, whole and checked, or the refusal that says what is
    wrong with them. A missing file is the defaults: no cap."""
    path = path or _machine_settings_path()

    def refuse(sentence: str) -> NoReturn:
        raise _Refusal(6, "service_invalid", f"{path}: {sentence}",
                       f"`{NAME} help` states the machine settings; `{NAME} service init "
                       "--machine --force` writes the shipped template")

    settings: dict = {"version": 1, "max_parallel": None}
    if not path.is_file():
        return settings
    try:
        raw = tomllib.loads(path.read_text())
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError) as exc:
        refuse(f"it could not be read: {exc}")
    unknown = sorted(set(raw) - set(_MACHINE_KEYS))
    if unknown:
        refuse(f"it names {', '.join(map(repr, unknown))}, which nothing reads")
    if isinstance(raw.get("version"), bool) or raw.get("version") != 1:
        refuse("its `version` is 1")
    if "max_parallel" in raw:
        value = raw["max_parallel"]
        if isinstance(value, bool) or not isinstance(value, int) or value < 1:
            refuse("its `max_parallel` is a whole number of at least 1")
        settings["max_parallel"] = value
    return settings


def _machine_fingerprint() -> str:
    """Which machine settings the file holds right now. The opt-in list is not
    part of it: joining and leaving are taken up without a reload."""
    try:
        seen = hashlib.sha256(_machine_settings_path().read_bytes()).hexdigest()
    except OSError:
        seen = "absent"
    return hashlib.sha256(f"machine-settings:{seen}".encode()).hexdigest()[:12]


def _without_project_pointers() -> dict:
    return {key: value for key, value in os.environ.items() if key not in _PROJECT_POINTERS}


@contextlib.contextmanager
def _project_scope(root: Path):
    """Stand in one project for the length of a block: the process environment
    points at that project alone and its records adapter is opened afresh; on
    the way out both are put back exactly as they were. What runs inside reads
    the project's identity, policy, declaration and selectors, and no other
    value its env files hold."""
    global _RECORDS
    saved_env, saved_records = dict(os.environ), _RECORDS
    for key in _PROJECT_POINTERS:
        os.environ.pop(key, None)
    os.environ["CLAUDE_PROJECT_DIR"] = str(root)
    _RECORDS = None
    try:
        yield
    finally:
        os.environ.clear()
        os.environ.update(saved_env)
        _RECORDS = saved_records


def _ask_in_project(root: Path, question):
    """Answer `question` inside the project's scope. A refusal it would have
    exited with is raised as a _Refusal instead, so one project's answer never
    ends the process asking."""
    import io

    said = io.StringIO()
    try:
        with contextlib.redirect_stderr(said), _project_scope(root):
            return question()
    except SystemExit as stop:
        error: dict = {}
        for line in reversed(said.getvalue().strip().splitlines()):
            with contextlib.suppress(ValueError, AttributeError):
                error = json.loads(line).get("error") or {}
                break
        raise _Refusal(stop.code if isinstance(stop.code, int) else 6,
                       error.get("code") or "refused",
                       error.get("message") or "the check exited without saying why",
                       error.get("hint")) from None


def _project_store_set(root: Path) -> list[str]:
    """Which of the store's keys the project's own env files set, by name."""
    return [f"{root / name} sets {key}" for name in (".env", ".env.local")
            for key in _env_file_entries(root / name) if key in _STORE_ENV_KEYS]


def _servable_here() -> tuple[str, str]:
    """This project's id and slug, if the machine service may serve it, or the
    refusal that says why not: no durable id it may write under, or a store
    named in its own env files. Asked by `join`, and by the
    machine service before it serves a project."""
    root = _project_root()
    envelope = _project_capabilities_dir(root)
    project = _project_id(write=True, refuse=False)
    if not (envelope / "project.json").is_file() or not project:
        raise _Refusal(6, "no_project_identity",
                       f"this project has no durable id it may write under in "
                       f"{envelope / 'project.json'}, and the machine service's list "
                       "names a project by it", "run `capabilities init` in the project")
    found = _project_store_set(root)
    if found:
        raise _Refusal(6, "project_store_set",
                       f"{'; '.join(found)}, and the machine service keeps every project's "
                       "runs in the machine's store",
                       "remove it from the project's env files; the machine's store "
                       "setting names the store (`capabilities store show`)")
    return project, _state_project_key(root)


class _ProjectHost:
    """One joined project as the machine process sees it: where it stands, and
    the questions the machine asks of it, each answered inside the project's
    own resolution."""

    def __init__(self, runtime, entry: dict, root: Path, config_path: Path, state_dir: Path):
        self.runtime = runtime
        self.entry = entry
        self.root, self.config_path, self.state_dir = root, config_path, state_dir

    def load(self) -> dict[str, Any]:
        try:
            return _ask_in_project(self.root, lambda: _load_config(self.runtime, self.root))
        except _Refusal as refused:
            raise self.runtime.ConfigError(f"{refused.code}: {refused.message}") from None

    def check(self) -> tuple[str, str] | None:
        """Asked before every action for the project: its folder is there and it
        still enables automations for itself."""
        if not self.root.is_dir():
            return ("error", f"the project folder {self.root} is gone")
        try:
            enabled = _ask_in_project(self.root, _project_enabled_explicitly)
        except _Refusal as refused:
            return ("refused", f"{refused.code}: {refused.message}")
        except Exception as exc:
            return ("error", f"{type(exc).__name__}: {exc}")
        return None if enabled else ("refused", _NOT_ENABLED)

    def launcher(self, command: list[str]) -> list[str]:
        """How a job of this project starts: through `service launch`, which
        resolves the project's own environment in the job's process and execs
        the job, so the machine process never holds it."""
        return [sys.executable, str(Path(__file__).resolve()), "service", "launch", "--",
                *command]


class _MachineHost:
    """What the machine service asks of this executable about the machine: its
    list, its settings, and for each project on the list a host for it or why
    it cannot be served yet."""

    def __init__(self, runtime):
        self.runtime = runtime
        self.state_dir = _machine_state_dir()
        self.projects_file = _machine_projects_path()
        self.config_file = _machine_settings_path()

    def list_witness(self):
        try:
            seen = os.stat(self.projects_file)
        except OSError:
            return None
        return (seen.st_mtime_ns, seen.st_size, seen.st_ino)

    def read_list(self) -> dict:
        return _read_machine_projects(self.projects_file)

    def load_settings(self) -> dict:
        # Taken before the file is read, as a project's declaration is.
        fingerprint = _machine_fingerprint()
        return {**_read_machine_settings(self.config_file), "fingerprint": fingerprint}

    @staticmethod
    def project_state_dir(slug: str) -> Path:
        return _default_project_state_dir(slug)

    def admit(self, entry: dict):
        """(host, None) for a project on the list that can be served now, or
        (None, (state, reason)): `error` for a folder that is gone or a question
        that failed, `refused` for what the checks refuse and for a project whose
        id, slug or root moved since it joined."""
        root = Path(entry["root"])
        if not root.is_dir():
            return None, ("error", f"the project folder {root} is gone")

        def probe():
            here = _project_root()
            if here is None or here.resolve() != root.resolve():
                raise _Refusal(6, "not_a_project_root",
                               f"{root} no longer resolves as a project root")
            project, slug = _servable_here()
            if project != entry["id"]:
                raise _Refusal(6, "project_id_changed",
                               f"the project now declares id {project}, and it joined as "
                               f"{entry['id']}")
            if slug != entry["slug"]:
                raise _Refusal(6, "slug_changed",
                               f"the project now declares slug {slug} and joined as "
                               f"{entry['slug']}; `{NAME} service leave` and `{NAME} "
                               "service join` there take the new one")
            if not _project_enabled_explicitly():
                raise _Refusal(4, *_NOT_ENABLED.split(": ", 1))
            return _config_path(root), _state_path(root)

        try:
            config_path, state_dir = _ask_in_project(root, probe)
        except _Refusal as refused:
            return None, ("refused", f"{refused.code}: {refused.message}")
        except Exception as exc:
            return None, ("error", f"{type(exc).__name__}: {exc}")
        return _ProjectHost(self.runtime, entry, root, config_path, state_dir), None


def _machine_pid(runtime) -> int | None:
    """The machine process's pid while it runs, else None."""
    pid = runtime.read_pid(_machine_state_dir())
    return pid if runtime.pid_alive(pid) else None


def _joined_here() -> dict | None:
    """This project's entry on the machine service's opt-in list, or None: not
    on it, no id, outside a project, or a list that does not load."""
    if _project_root() is None:
        return None
    project = _project_id()
    if not project:
        return None
    try:
        entry = _read_machine_projects().get(project)
    except _Refusal:
        return None
    return {**entry, "id": project} if entry else None


def _joined_refusal(verb: str) -> None:
    """`start` and `run` in a joined project: the machine service serves it, and
    a project daemon would compete with it for the project's lock."""
    if _joined_here():
        _die(4, "joined_to_machine_service",
             f"this project is joined to the machine {NAME} service, which serves it, so "
             f"`{NAME} service {verb}` here is refused",
             f"`{NAME} service leave` takes it back to project mode first")


def _machine_view(runtime, joined: dict) -> dict:
    """What the machine service says of one joined project, while it runs."""
    pid = _machine_pid(runtime)
    published = (runtime.read_status(_machine_state_dir()) or {}) if pid else {}
    seen = next((row for row in published.get("projects") or []
                 if isinstance(row, dict) and row.get("project_id") == joined["id"]), {})
    return {"running": pid is not None, "pid": pid, "joined_at": joined.get("joined_at"),
            "state": seen.get("state"),
            "reason": seen.get("reason") if pid else "the machine service is not running"}


def _enabled_at(root: Path) -> bool:
    try:
        return bool(_ask_in_project(root, _project_enabled_explicitly))
    except Exception:
        return False


def _machine_status(runtime) -> dict:
    """The machine service as its status file and the list say: whether it
    runs, its settings, its cap and store, and every project on the list with
    what is true of it now. With no process running, every entry still answers
    `present` and `enabled_explicitly`."""
    state = _machine_state_dir()
    pid = runtime.read_pid(state)
    running = runtime.pid_alive(pid)
    published = (runtime.read_status(state) or {}) if running else {}
    try:
        listed, list_error = _read_machine_projects(), None
    except _Refusal as refused:
        listed, list_error = {}, refused.message
    try:
        settings, settings_error = _read_machine_settings(), None
    except _Refusal as refused:
        settings, settings_error = None, refused.message
    answer = {
        "mode": "machine", "running": running, "pid": pid if running else None,
        "stale_pid": bool(pid and not running),
        "started_at": published.get("started_at"),
        "published_at": published.get("published_at"),
        "fingerprint": published.get("fingerprint"),
        "current": (published.get("fingerprint") == _machine_fingerprint()) if running else None,
        "reload_error": published.get("reload_error"),
        "config": str(_machine_settings_path()),
        "initialized": _machine_settings_path().is_file(),
        "state_dir": str(state), "log_file": str(state / runtime.LOG_FILE),
        "projects_file": {"path": str(_machine_projects_path()), "joined": len(listed),
                          **({"error": list_error} if list_error else {})},
        "cap": published.get("cap") or {
            "max_parallel": (settings or {}).get("max_parallel"), "running": 0,
            "binding": False},
        **_store_named(runtime),
    }
    if running:
        answer["store_connection"] = published.get("store")
    if settings_error:
        answer["settings_error"] = settings_error
    rows = {row.get("project_id"): row for row in published.get("projects") or []
            if isinstance(row, dict)}
    projects = []
    for project, entry in sorted(listed.items(), key=lambda item: (item[1]["slug"], item[0])):
        root = Path(entry["root"])
        row = {"project": entry["slug"], "project_id": project, "root": entry["root"],
               "joined_at": entry["joined_at"], "joined_by": entry["joined_by"],
               "present": root.is_dir(),
               "enabled_explicitly": root.is_dir() and _enabled_at(root)}
        seen = rows.get(project)
        if seen:
            for key, value in seen.items():
                row.setdefault(key, value)
        else:
            row.update(state=None, reason=("the machine service is not running" if not running
                                           else "not yet taken up by the machine service"))
        projects.append(row)
    answer["projects"] = projects
    return answer


def _machine_lock_held() -> bool:
    """Whether a process holds the machine lock, asked with a shared lock taken
    and let go at once."""
    import fcntl

    try:
        handle = (_machine_state_dir() / "daemon.lock").open("a+")
    except OSError:
        return False
    try:
        fcntl.flock(handle.fileno(), fcntl.LOCK_SH | fcntl.LOCK_NB)
    except BlockingIOError:
        return True
    finally:
        handle.close()
    return False


def _project_answer(project: str, entry: dict) -> dict:
    return {"id": project, "slug": entry["slug"], "root": entry["root"]}


def cmd_service_join() -> dict[str, Any]:
    """Put this project on the machine service's opt-in list. It refuses a
    project the machine service may not serve, and a slug another joined
    project already has, since the two would share a state root. It operates
    no daemon."""
    root = _require_project_enabled_for_service()
    try:
        project, slug = _servable_here()
    except _Refusal as refused:
        _die(refused.exit_code, refused.code, refused.message, refused.hint)
    path = _machine_projects_path()
    with _MachineListLock():
        listed = _listed_projects()
        if project in listed:
            return {"joined": False, "reason": "already on the machine service's list",
                    "project": _project_answer(project, listed[project]), "list": str(path)}
        taken = sorted(other for other, found in listed.items() if found["slug"] == slug)
        if taken:
            _die(6, "slug_taken",
                 f"project {taken[0]} at {listed[taken[0]]['root']} is joined with slug "
                 f"{slug!r}, and two projects of one slug would share a state root",
                 "give one of them another slug in its project.json, or leave the other "
                 f"with `{NAME} service leave --machine --project {taken[0]}`")
        import datetime as _dt
        listed[project] = {"root": str(root), "slug": slug,
                           "joined_at": _utc_moment(_dt.datetime.now(_dt.timezone.utc)),
                           "joined_by": _actor()}
        _write_machine_projects(listed, path)
    runtime = _runtime_module()
    state = _state_path(root)
    if state.is_dir():
        runtime.append_line(state / runtime.LOG_FILE, runtime.log_line(
            slug, f"joined the machine service, by {listed[project]['joined_by']}"))
    answer = {"joined": True, "project": _project_answer(project, listed[project]),
              "list": str(path)}
    pid = _read_pid(state / "daemon.pid")
    if _pid_alive(pid) and pid != _machine_pid(runtime):
        answer["next"] = (f"a project-mode daemon, pid {pid}, still serves this project; "
                          f"`{NAME} service stop` here hands it to the machine service")
    return answer


def cmd_service_leave(machine: bool, named: str | None) -> dict[str, Any]:
    """Take a project off the opt-in list: this project, or with `--machine
    --project <id-or-slug>` any project from anywhere, a folder that is gone
    included."""
    path = _machine_projects_path()
    if machine:
        named = (named or "").strip()
        if not named:
            _die(6, "input", "leave --machine names the project it takes off the list",
                 f"`{NAME} service leave --machine --project <id-or-slug>`; "
                 f"`{NAME} service status --machine` lists them")
        here = None
    else:
        if named:
            _die(6, "input", "--project names a project to leave from anywhere, with --machine",
                 f"`{NAME} service leave` leaves this project")
        _root_required()
        here = _project_id()
        if not here:
            _die(6, "no_project_identity", "this project has no durable id, so it is on no list",
                 "run `capabilities init` in the project")
        named = here
    with _MachineListLock():
        listed = _listed_projects()
        found = [project for project, entry in listed.items()
                 if project == named or (here is None and entry["slug"] == named)]
        if not found:
            return {"left": False, "reason": "not on the machine service's list",
                    "project": {"id": here} if here else {"named": named}, "list": str(path)}
        project = found[0]
        entry = listed.pop(project)
        _write_machine_projects(listed, path)
    runtime = _runtime_module()
    state = _default_project_state_dir(entry["slug"])
    if state.is_dir():
        runtime.append_line(state / runtime.LOG_FILE, runtime.log_line(
            entry["slug"], f"left the machine service, by {_actor()}"))
    return {"left": True, "project": _project_answer(project, entry), "list": str(path)}


def cmd_service_pause(reason: str | None) -> dict[str, Any]:
    """Hold this project: its scheduler registers and starts nothing until
    resumed, in either mode, and running jobs finish."""
    root = _root_required()
    runtime = _runtime_module()
    state = _state_path(root)
    state.mkdir(parents=True, exist_ok=True)
    pause = {"reason": (reason or "").strip() or None, "at": runtime.iso(), "by": _actor()}
    runtime.write_atomic(state / runtime.PAUSE_FILE, json.dumps(pause, indent=2) + "\n")
    return {"paused": True, "pause": pause, "pause_file": str(state / runtime.PAUSE_FILE)}


def cmd_service_resume() -> dict[str, Any]:
    root = _root_required()
    runtime = _runtime_module()
    path = _state_path(root) / runtime.PAUSE_FILE
    held = path.exists()
    path.unlink(missing_ok=True)
    return {"resumed": held, "pause_file": str(path),
            **({} if held else {"reason": "this project was not paused"})}


def cmd_service_launch(command: list[str]) -> NoReturn:
    """One job of the machine service, started in its project: the project's
    own environment - its .env and .env.local, as its own daemon carries them -
    is put under the job here, in the job's process, and the job is exec'd in
    its place. The machine process never holds that environment."""
    if command[:1] == ["--"]:
        command = command[1:]
    if not command:
        _die(6, "input", f"`{NAME} service launch -- <command...>` names the job to start")
    root = _require_project_enabled_for_service()
    carried = {key: value for key, value in os.environ.items()
               if key.startswith("AUTOMATION_") or key == "AUTOMATIONS_BIN"}
    env = _service_env(root)
    env.update(carried)
    try:
        os.execvpe(command[0], command, env)
    except OSError as exc:
        _die(5, "launch_failed", f"cannot start {command[0]}: {exc}")


def cmd_service_init_machine(force: bool) -> dict[str, Any]:
    template = _template("machine.toml")
    if not template.is_file():
        _die(3, "service_bundle_missing",
             f"the shipped machine settings template is missing at {template}",
             "reinstall automations from a bundled source directory")
    target = _machine_settings_path()
    written, skipped = [], []
    if target.exists() and not force:
        skipped.append(str(target))
    else:
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(template.read_text())
        written.append(str(target))
    return {"initialized": NAME, "mode": "machine", "config": str(target),
            "written": written, "skipped": skipped,
            "next": [f"`{NAME} service join` in each project the machine service is to serve",
                     f"`{NAME} service start --machine`, or `{NAME} service run --machine` "
                     "under a supervisor"]}


def _machine_settings_or_die() -> None:
    try:
        _read_machine_settings()
    except _Refusal as refused:
        _die(refused.exit_code, refused.code, refused.message, refused.hint)


def cmd_service_run_machine() -> None:
    """The machine process in the foreground: what a supervisor runs. It stands
    in its own state root with nothing in its environment pointing at a
    project."""
    _machine_settings_or_die()
    state = _machine_state_dir()
    state.mkdir(parents=True, exist_ok=True)
    os.chdir(state)
    for key in _PROJECT_POINTERS:
        os.environ.pop(key, None)
    runtime = _runtime_module()
    try:
        runtime.MachineService(_MachineHost(runtime)).run()
    except RuntimeError as exc:
        _die(5, "service_running", str(exc),
             f"`{NAME} service status --machine` names the process that holds it")


def cmd_service_start_machine() -> dict[str, Any]:
    _machine_settings_or_die()
    runtime = _runtime_module()
    state = _machine_state_dir()
    state.mkdir(parents=True, exist_ok=True)
    if _machine_pid(runtime):
        answer = _machine_status(runtime)
        answer["already_running"] = True
        return answer
    try:
        runtime.StoreLink().open().close()
    except runtime.StoreUnavailable as exc:
        _store_refusal(exc)
    log_path = state / runtime.LOG_FILE
    with log_path.open("a", encoding="utf-8") as log:
        process = subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "service", "run", "--machine"],
            cwd=str(state), env=_without_project_pointers(), stdin=subprocess.DEVNULL,
            stdout=log, stderr=log, start_new_session=True)
    deadline = time.monotonic() + 30
    while True:
        if process.poll() is not None:
            tail = log_path.read_text(errors="replace").splitlines()[-8:]
            _die(5, "service_start_failed",
                 f"the machine process exited with {process.returncode}", "\n".join(tail))
        if runtime.read_pid(state) == process.pid and runtime.read_status(state):
            break
        if time.monotonic() > deadline:
            _die(5, "service_start_failed", "the machine process did not report itself "
                 "running within 30s", f"`{NAME} service logs --machine`")
        time.sleep(0.05)
    answer = _machine_status(runtime)
    answer["started"] = True
    return answer


def cmd_service_doctor_machine() -> dict[str, Any]:
    """The supervision probe: ok while the machine process holds its lock,
    published its status lately, runs the machine settings on disk and holds
    its store connection. A project in `error` or `refused` is reported and
    fails nothing: restarting the process cannot repair a project."""
    import datetime as _dt

    runtime = _runtime_module()
    status = _machine_status(runtime)
    problems = []
    if not status["running"]:
        problems.append(f"no machine process runs; `{NAME} service start --machine`, or "
                        f"`{NAME} service run --machine` under a supervisor")
    else:
        published = runtime.read_status(_machine_state_dir()) or {}
        limit = 2 * float(published.get("publish_seconds") or runtime.PUBLISH_SECONDS)
        try:
            at = _dt.datetime.fromisoformat(str(published.get("published_at")))
            age = (_dt.datetime.now(_dt.timezone.utc) - at).total_seconds()
        except (TypeError, ValueError):
            age = None
        if not _machine_lock_held():
            problems.append(f"pid {status['pid']} is alive but holds no machine lock in "
                            f"{_machine_state_dir()}; it is not the machine process")
        if published.get("pid") != status["pid"] or age is None or age > limit:
            problems.append(f"the machine process has not published its status within "
                            f"{limit:g}s; it may hang")
        if not status["current"]:
            problems.append("the machine process runs machine settings that have changed "
                            f"since; `{NAME} service reload --machine` hands it the file on disk")
        connection = status.get("store_connection") or {}
        if not connection.get("connected"):
            problems.append(f"the machine process holds no store connection: "
                            f"{connection.get('error') or 'reconnecting'}")
    if status.get("settings_error"):
        problems.append(status["settings_error"])
    answer = {"ok": not problems, "mode": "machine", "machine": status,
              "projects": [{key: row.get(key) for key in
                            ("project", "project_id", "present", "enabled_explicitly",
                             "state", "reason")} for row in status["projects"]]}
    if problems:
        answer["problems"] = problems
    return answer


def cmd_service_reload_machine(timeout: float) -> dict[str, Any]:
    """Hand the machine process the machine settings on disk, and every project
    its own declaration, and wait until it says it has."""
    runtime = _runtime_module()
    state = _machine_state_dir()
    pid = _machine_pid(runtime)
    if not pid:
        _die(5, "service_not_running", f"no machine {NAME} service is running",
             f"`{NAME} service start --machine` starts one")
    _machine_settings_or_die()
    target = _machine_fingerprint()
    fingerprint_file = state / runtime.DAEMON_FINGERPRINT_FILE

    def loaded() -> str | None:
        with contextlib.suppress(OSError):
            return fingerprint_file.read_text().strip()
        return None

    before = (runtime.read_status(state) or {}).get("reloads") or 0
    was = loaded()
    try:
        os.kill(pid, signal.SIGHUP)
    except ProcessLookupError:
        _die(5, "service_not_running", "the machine process exited before the reload")
    deadline = time.monotonic() + max(timeout, 0.0)
    while time.monotonic() < deadline:
        if not runtime.pid_alive(pid):
            _die(5, "service_reload_failed", "the machine process exited during the reload",
                 f"`{NAME} service logs --machine`")
        published = runtime.read_status(state) or {}
        if (published.get("reloads") or 0) > before and loaded() == target:
            return {"reloaded": True, "running": True, "pid": pid, "fingerprint": target,
                    "changed": was != target,
                    "projects": [{key: row.get(key) for key in
                                  ("project", "state", "reason", "reload_error")}
                                 for row in published.get("projects") or []]}
        time.sleep(0.1)
    _die(5, "service_reload_failed",
         f"the machine process did not publish the reload within {timeout:g}s",
         f"`{NAME} service logs --machine` says why")


def cmd_service_stop_machine(timeout: float, force: bool) -> dict[str, Any]:
    """Ask the machine process to stop and wait for it. Every project's running
    jobs are interrupted within that project's shutdown grace, as a stop of
    its own daemon interrupts them."""
    runtime = _runtime_module()
    state = _machine_state_dir()
    pid = runtime.read_pid(state)
    if not runtime.pid_alive(pid):
        (state / runtime.PID_FILE).unlink(missing_ok=True)
        return {"stopped": False, "running": False, "pid": None, "mode": "machine"}
    with contextlib.suppress(ProcessLookupError):
        os.kill(pid, signal.SIGTERM)
    started = time.monotonic()
    while time.monotonic() - started < timeout:
        if not runtime.pid_alive(pid):
            return {"stopped": True, "running": False, "pid": pid, "mode": "machine",
                    "waited_seconds": round(time.monotonic() - started, 1)}
        time.sleep(0.1)
    if not force:
        _die(5, "service_stop_timeout",
             f"the machine process did not stop within {timeout:g}s",
             f"retry with `{NAME} service stop --machine --force`")
    with contextlib.suppress(ProcessLookupError):
        os.kill(pid, signal.SIGKILL)
    for name in (runtime.PID_FILE, runtime.DAEMON_FINGERPRINT_FILE, runtime.STATUS_FILE):
        (state / name).unlink(missing_ok=True)
    return {"stopped": True, "killed": True, "running": False, "pid": pid, "mode": "machine"}


def cmd_service_logs_machine(tail: int, named: str | None) -> dict[str, Any]:
    runtime = _runtime_module()
    path = _machine_state_dir() / runtime.LOG_FILE
    if not path.is_file():
        _die(3, "logs_not_found", f"the machine service log does not exist yet: {path}",
             f"`{NAME} service start --machine` writes it")
    lines = path.read_text(errors="replace").splitlines()
    answer: dict = {"log_file": str(path)}
    named = (named or "").strip()
    if named:
        try:
            listed = _read_machine_projects()
        except _Refusal:
            listed = {}
        slug = listed[named]["slug"] if named in listed else named
        tag = f" {NAME} service [{slug}]: "
        lines = [line for line in lines if tag in line]
        answer["project"] = slug
    answer["lines"] = lines[-max(0, tail):]
    return answer


def _agent_prompt(raw: str) -> str:
    """`-` means the prompt arrives on stdin, which is how a script hands over a
    prompt too long or too quoted to survive argv."""
    text = sys.stdin.read() if raw == "-" else raw
    if not text.strip():
        _die(6, "empty_prompt", "the prompt is empty")
    return text


def _agent_command(profile: dict[str, Any], root: Path, schema: Path | None,
                   answer_file: Path) -> list[str]:
    engine = profile["engine"]
    if engine == "claude":
        command = [_engine_binary("claude"), "-p",
                   "--output-format", "json",
                   "--model", profile["model"]]
        if profile["effort"]:
            command += ["--effort", profile["effort"]]
        if profile["mode"] == "read":
            # --tools decides which built-in tools exist for the turn, so a read
            # profile has no Bash, Edit or Write in its schema and no settings
            # file on the machine running the job can hand them back.
            # --allowedTools only marks the listed tools as needing no prompt; it
            # removes nothing, so on its own a read profile kept a working shell
            # wherever user settings were permissive. It stays so the three
            # reading tools remain pre-approved, and plan mode stays as the
            # model-facing signal.
            command += ["--permission-mode", "plan",
                        "--tools", "Read,Glob,Grep",
                        "--allowedTools", "Read,Glob,Grep"]
        else:
            command += ["--permission-mode", "bypassPermissions"]
        if schema is not None:
            command += ["--json-schema", schema.read_text(encoding="utf-8")]
        return command
    command = [_engine_binary("codex"), "exec", "-",
               "-m", profile["model"],
               "-C", str(root),
               "--skip-git-repo-check",
               "--json",
               "-o", str(answer_file)]
    if profile["mode"] == "act":
        # A worker that operates tools rather than files needs the machine those
        # tools run on: a CLI reaches the network, writes a session file outside
        # the project, and warms a package cache in the user's home. Codex's
        # workspace sandbox permits none of that, and refuses silently enough
        # that the turn reports success having done nothing. So `act` drops the
        # sandbox, which is the authority the assistant's own daemons already
        # run with - and it is a separate mode precisely so that declaring
        # `write` for a file-editing job never hands out the machine by
        # accident.
        command += ["--dangerously-bypass-approvals-and-sandbox"]
    else:
        command += ["-s", "read-only" if profile["mode"] == "read" else "workspace-write"]
    if profile["effort"]:
        command += ["-c", f"model_reasoning_effort={profile['effort']}"]
    if profile["service_tier"]:
        command += ["-c", f"model_service_tier={profile['service_tier']}"]
    if schema is not None:
        command += ["--output-schema", str(schema)]
    return command


def _engine_binary(engine: str) -> str:
    """Engine CLIs are resolved for a daemon's environment rather than a login
    shell's: a node version manager keeps the real executable outside PATH's
    obvious places, and a per-shell shim path does not survive into a job."""
    found = shutil.which(engine)
    if found:
        return found
    candidates = [Path.home() / ".local" / "bin" / engine]
    fnm = Path.home() / ".local" / "share" / "fnm" / "node-versions"
    if fnm.is_dir():
        candidates += sorted(fnm.glob(f"*/installation/bin/{engine}"), reverse=True)
    for candidate in candidates:
        if candidate.exists() and os.access(candidate, os.X_OK):
            return str(candidate)
    _die(5, "engine_not_found", f"the {engine} CLI is not installed",
         f"install {engine} or point the profile at the other engine")


def _agent_env() -> dict[str, str]:
    env = dict(os.environ)
    extra = ["/opt/homebrew/bin", "/usr/local/bin",
             str(Path.home() / ".local" / "bin")]
    parts = [item for item in env.get("PATH", "").split(os.pathsep) if item]
    parts += [item for item in extra if item not in parts]
    env["PATH"] = os.pathsep.join(parts)
    return env


def _claude_answer(stdout: str, structured: bool) -> dict[str, Any]:
    try:
        payload = json.loads(stdout)
    except json.JSONDecodeError as exc:
        _die(5, "engine_output_unparseable", f"claude did not return JSON: {exc}")
    if payload.get("is_error"):
        _die(5, "agent_failed", str(payload.get("result") or "claude reported an error"))
    answer = payload.get("result")
    if structured:
        # A schema-constrained turn returns the object under `structured_output`
        # and leaves `result` empty. Falling back to prose when a schema was
        # demanded would hand a script the one shape it cannot branch on, so an
        # unsatisfied schema is an error rather than a surprise at the call site.
        structured_output = payload.get("structured_output")
        if isinstance(structured_output, (dict, list)):
            answer = structured_output
        elif isinstance(answer, str) and answer.strip():
            try:
                answer = json.loads(answer)
            except json.JSONDecodeError:
                _die(5, "schema_unsatisfied",
                     "the agent answered prose while a schema was required",
                     "loosen the schema, or say in the prompt that the answer "
                     "must be the structured object")
        else:
            _die(5, "schema_unsatisfied", "the agent returned no structured answer")
    usage = payload.get("usage") or {}
    return {
        "answer": answer,
        "cost_usd": payload.get("total_cost_usd"),
        "duration_ms": payload.get("duration_ms"),
        "num_turns": payload.get("num_turns"),
        "session_id": payload.get("session_id"),
        "tokens": {
            "input": usage.get("input_tokens"),
            "output": usage.get("output_tokens"),
            "cache_read": usage.get("cache_read_input_tokens"),
            "cache_creation": usage.get("cache_creation_input_tokens"),
        },
    }


def _codex_answer(answer_file: Path, stdout: str, structured: bool) -> dict[str, Any]:
    if not answer_file.is_file():
        _die(5, "agent_failed", "codex wrote no final message",
             (stdout or "")[-500:] or None)
    answer: Any = answer_file.read_text(encoding="utf-8").strip()
    if structured and isinstance(answer, str):
        with contextlib.suppress(json.JSONDecodeError):
            answer = json.loads(answer)
    tokens: dict[str, Any] = {}
    session_id = None
    for line in (stdout or "").splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        with contextlib.suppress(json.JSONDecodeError):
            event = json.loads(line)
            usage = (event.get("info") or {}).get("total_token_usage") or event.get("usage")
            if isinstance(usage, dict):
                tokens = {
                    "input": usage.get("input_tokens"),
                    "output": usage.get("output_tokens"),
                    "cache_read": usage.get("cached_input_tokens"),
                    "cache_creation": None,
                }
            session_id = event.get("session_id") or session_id
    return {"answer": answer, "cost_usd": None, "duration_ms": None,
            "num_turns": None, "session_id": session_id, "tokens": tokens}


def cmd_agents() -> dict[str, Any]:
    root = _root_required()
    _, config = _load(root)
    agents = config["agents"]
    return {"default": agents["default"],
            "workers": {name: dict(spec) for name, spec in sorted(agents["workers"].items())}}


def cmd_agent(profile_name: str | None, prompt_raw: str, schema_raw: str | None,
              timeout_override: float | None) -> dict[str, Any]:
    root = _root_required()
    _, config = _load(root)
    agents = config["agents"]
    name = profile_name or agents["default"]
    profile = agents["workers"].get(name)
    if profile is None:
        _die(3, "unknown_agent", f"unknown agent profile {name!r}",
             f"declared profiles: {', '.join(sorted(agents['workers']))}")
    if profile["mode"] != "read":
        # A read profile runs with the switch in its inherited environment; a
        # profile that may write exists to change the project, so it does not
        # run at all.
        _read_only_gate(f"`{NAME} agent` with the {profile['mode']} profile {name!r}")
    schema = None
    if schema_raw:
        schema = Path(schema_raw).expanduser()
        if not schema.is_absolute():
            schema = (root / schema).resolve()
        if not schema.is_file():
            _die(6, "schema_not_found", f"schema file not found: {schema}")
    prompt = _agent_prompt(prompt_raw)
    timeout = timeout_override or profile["timeout_seconds"]

    with tempfile.TemporaryDirectory(prefix="automations-agent-") as tmp:
        answer_file = Path(tmp) / "answer.txt"
        command = _agent_command(profile, root, schema, answer_file)
        started = time.monotonic()
        try:
            completed = subprocess.run(
                command, input=prompt, cwd=str(root), env=_agent_env(),
                capture_output=True, text=True, timeout=timeout)
        except subprocess.TimeoutExpired:
            _die(5, "agent_timeout",
                 f"the {profile['engine']} agent exceeded {timeout:g}s",
                 "raise timeout_seconds on the profile or pass --timeout")
        elapsed = int((time.monotonic() - started) * 1000)
        if completed.returncode != 0:
            _die(5, "agent_failed",
                 (completed.stderr or completed.stdout or "").strip()[-500:]
                 or f"{profile['engine']} exited {completed.returncode}")
        if profile["engine"] == "claude":
            result = _claude_answer(completed.stdout, schema is not None)
        else:
            result = _codex_answer(answer_file, completed.stdout, schema is not None)

    if result["duration_ms"] is None:
        result["duration_ms"] = elapsed
    return {"ok": True, "profile": name, "engine": profile["engine"],
            "model": profile["model"], "effort": profile["effort"],
            "mode": profile["mode"], **result}


def main() -> None:
    os.environ.setdefault("AUTOMATIONS_BIN", str(Path(__file__).resolve()))
    _gate()
    argv = sys.argv[1:]
    if argv[:1] == ["manifest"]:
        _emit(_manifest_payload())
        return
    _contract(argv)
    if argv[:1] == ["set"]:
        _read_only_gate(f"`{NAME} set`")
        # Parsed by hand so a value may start with a dash and every refusal
        # carries the error envelope and exit 6.
        _emit(cmd_set(argv[1:]))
        return

    parser = argparse.ArgumentParser(prog=NAME, add_help=False)
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("help", add_help=False)
    doctor_parser = sub.add_parser("doctor", add_help=False)
    doctor_parser.add_argument("--repair", action="store_true")
    sub.add_parser("list", add_help=False)
    run = sub.add_parser("run", add_help=False)
    run.add_argument("automation_id")
    runs = sub.add_parser("runs", add_help=False)
    runs.add_argument("--limit", type=int, default=50)
    runs.add_argument("--status")
    show = sub.add_parser("show", add_help=False)
    show.add_argument("run_id")
    logs = sub.add_parser("logs", add_help=False)
    logs.add_argument("run_id")
    logs.add_argument("--tail", type=int, default=100)
    cancel = sub.add_parser("cancel", add_help=False)
    cancel.add_argument("run_id")
    retry = sub.add_parser("retry", add_help=False)
    retry.add_argument("run_id")
    sub.add_parser("agents", add_help=False)
    agent = sub.add_parser("agent", add_help=False)
    agent.add_argument("prompt")
    agent.add_argument("--profile")
    agent.add_argument("--schema")
    agent.add_argument("--timeout", type=float)

    service = sub.add_parser("service", add_help=False)
    service_sub = service.add_subparsers(dest="service_cmd", required=True)
    init = service_sub.add_parser("init", add_help=False)
    init.add_argument("--force", action="store_true")
    machine_verbs = [init]
    machine_verbs.append(service_sub.add_parser("doctor", add_help=False))
    machine_verbs.append(service_sub.add_parser("run", add_help=False))
    machine_verbs.append(service_sub.add_parser("start", add_help=False))
    reload_parser = service_sub.add_parser("reload", add_help=False)
    reload_parser.add_argument("--timeout", type=float, default=20.0)
    stop = service_sub.add_parser("stop", add_help=False)
    stop.add_argument("--timeout", type=float)
    stop.add_argument("--force", action="store_true")
    machine_verbs.append(service_sub.add_parser("status", add_help=False))
    service_logs = service_sub.add_parser("logs", add_help=False)
    service_logs.add_argument("--tail", type=int, default=100)
    service_logs.add_argument("--project")
    pause = service_sub.add_parser("pause", add_help=False)
    pause.add_argument("--reason")
    service_sub.add_parser("resume", add_help=False)
    service_sub.add_parser("join", add_help=False)
    leave = service_sub.add_parser("leave", add_help=False)
    leave.add_argument("--project")
    launch = service_sub.add_parser("launch", add_help=False)
    launch.add_argument("command", nargs=argparse.REMAINDER)
    for verb in (*machine_verbs, reload_parser, stop, service_logs, leave):
        verb.add_argument("--machine", action="store_true")

    args = parser.parse_args(argv)
    if args.cmd in ("run", "cancel", "retry"):
        # Each starts or stops a job, which is the work the scheduler does.
        _read_only_gate(f"`{NAME} {args.cmd}`")
    if args.cmd == "help":
        _cmd_help()
    elif args.cmd == "doctor":
        result = cmd_doctor(repair=getattr(args, "repair", False))
        _emit(result)
        if not result["ok"]:
            raise SystemExit(6)
    elif args.cmd == "list":
        _emit(cmd_list())
    elif args.cmd == "run":
        _emit(cmd_run(args.automation_id))
    elif args.cmd == "runs":
        if args.limit < 1:
            _die(6, "invalid_limit", "--limit must be positive")
        _emit(cmd_runs(args.limit, args.status))
    elif args.cmd == "show":
        _emit(cmd_show(args.run_id))
    elif args.cmd == "logs":
        _emit(cmd_logs(args.run_id, args.tail))
    elif args.cmd == "cancel":
        _emit(cmd_cancel(args.run_id))
    elif args.cmd == "retry":
        _emit(cmd_retry(args.run_id))
    elif args.cmd == "agents":
        _emit(cmd_agents())
    elif args.cmd == "agent":
        if args.timeout is not None and args.timeout < 1:
            _die(6, "invalid_timeout", "--timeout must be at least 1 second")
        _emit(cmd_agent(args.profile, args.prompt, args.schema, args.timeout))
    elif args.cmd == "service" and getattr(args, "machine", False):
        # The machine verbs resolve no project: the gate let them through for
        # that reason, and the machine service checks each project itself.
        if args.service_cmd == "init":
            _emit(cmd_service_init_machine(args.force))
        elif args.service_cmd == "doctor":
            result = cmd_service_doctor_machine()
            _emit(result)
            if not result["ok"]:
                raise SystemExit(6)
        elif args.service_cmd == "run":
            cmd_service_run_machine()
        elif args.service_cmd == "start":
            _emit(cmd_service_start_machine())
        elif args.service_cmd == "reload":
            _emit(cmd_service_reload_machine(args.timeout))
        elif args.service_cmd == "stop":
            _emit(cmd_service_stop_machine(
                30.0 if args.timeout is None else args.timeout, args.force))
        elif args.service_cmd == "status":
            _emit(_machine_status(_runtime_module()))
        elif args.service_cmd == "logs":
            _emit(cmd_service_logs_machine(args.tail, args.project))
        elif args.service_cmd == "leave":
            _emit(cmd_service_leave(True, args.project))
    elif args.cmd == "service":
        if args.service_cmd == "init":
            _emit(cmd_service_init(args.force))
        elif args.service_cmd == "doctor":
            result = cmd_doctor()
            _emit(result)
            if not result["ok"]:
                raise SystemExit(6)
        elif args.service_cmd == "run":
            cmd_service_run()
        elif args.service_cmd == "start":
            _emit(cmd_service_start())
        elif args.service_cmd == "reload":
            _emit(cmd_service_reload(args.timeout))
        elif args.service_cmd == "stop":
            _emit(cmd_service_stop(15.0 if args.timeout is None else args.timeout, args.force))
        elif args.service_cmd == "status":
            _emit(service_status(_root_required()))
        elif args.service_cmd == "logs":
            if args.project:
                _die(6, "input", "--project filters the machine log, with --machine",
                     f"`{NAME} service logs` reads this project's log")
            _emit(cmd_service_logs(args.tail))
        elif args.service_cmd in ("pause", "resume"):
            _read_only_gate(f"`{NAME} service {args.service_cmd}`")
            _emit(cmd_service_pause(args.reason) if args.service_cmd == "pause"
                  else cmd_service_resume())
        elif args.service_cmd == "join":
            _emit(cmd_service_join())
        elif args.service_cmd == "leave":
            _emit(cmd_service_leave(False, args.project))
        elif args.service_cmd == "launch":
            cmd_service_launch(args.command)


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        # The runtime module is loaded afresh by each verb that needs it, so its
        # exception class is matched by name rather than by identity.
        if type(exc).__name__ != "StoreUnavailable":
            raise
        _store_refusal(exc)
