def _execute_tool(name: str, args: dict) -> dict:
    try:
        if name == "project_overview":
            return tool_project_overview(bool(args.get("include_readme", True)))
        if name == "list_project_files":
            return tool_list_project_files(str(args.get("pattern") or ""),
                                           int(args.get("max_results") or 80))
        if name == "search_project":
            return tool_search_project(str(args.get("query") or ""),
                                       str(args.get("glob") or ""),
                                       int(args.get("max_matches") or 60))
        if name == "read_project_file":
            return tool_read_project_file(str(args.get("path") or ""),
                                          int(args.get("start_line") or 1),
                                          int(args.get("max_lines") or 120))
        if name == "capability_read":
            return tool_capability_read(str(args.get("name") or ""),
                                        args.get("args") if isinstance(args.get("args"), list) else None)
        if name == "codex_task":
            return tool_codex_task(str(args.get("task") or ""),
                                   str(args.get("mode") or "read"),
                                   int(args.get("timeout") or 300))
        if name == "codex_portal":
            return tool_codex_portal(str(args.get("message") or ""))
        return {"ok": False, "error": f"unknown tool {name!r}"}
    except Exception as e:
        return {"ok": False, "error": f"{type(e).__name__}: {e}"}


# --- Prompt and Live config --------------------------------------------------

RUNTIME_SYSTEM_PROMPT = """You are running inside GeminiTalk.

Apply the ordered prompt files below. Files are presented in connection order;
when they conflict, an earlier file takes precedence over a later file. Runtime
tool permissions, connection policy, and safety gates always take precedence over
every prompt file.
"""


def _prompt_target(cfg: dict, raw_path: str) -> tuple[Path | None, Path, str]:
    prefix = "capability:"
    if raw_path.startswith(prefix):
        root = _capability_bundle_root()
        relative = raw_path[len(prefix):].lstrip("/")
        target = _within_root(root, relative)
        return target, root, raw_path
    root = Path(cfg["project_root"]).resolve()
    target = _within_root(root, raw_path)
    return target, root, raw_path


def _prompt_stack(cfg: dict) -> str:
    sections: list[str] = []
    remaining = MAX_PROMPT_STACK_CHARS
    prompt_files = cfg.get("prompt_files") or []
    for index, raw in enumerate(prompt_files, start=1):
        source = str(raw).strip()
        if not source or remaining <= 0:
            continue
        target, root, label = _prompt_target(cfg, source)
        if target is None:
            body = f"[prompt file skipped: {label!r} is outside its allowed root]"
        else:
            text, err = _read_text_limited(target, MAX_PROMPT_FILE_CHARS)
            if err:
                body = f"[prompt file skipped: {label!r}: {err}]"
            else:
                try:
                    display = target.relative_to(root)
                except ValueError:
                    display = target
                body = (text or "")[:MAX_PROMPT_FILE_CHARS]
                label = f"{label} ({display})"
        body = body[:remaining]
        remaining -= len(body)
        sections.append(
            f"\n--- Prompt file {index}: {label} ---\n{body}\n"
            f"--- End prompt file {index} ---\n"
        )
    if not sections:
        return "\n[No connection prompt files configured.]\n"
    if remaining <= 0:
        sections.append("\n[prompt stack truncated at the configured total limit]\n")
    return "".join(sections)


def _system_prompt(cfg: dict) -> str:
    _activate_cfg(cfg)
    overview = tool_project_overview(include_readme=True)
    snapshot = json.dumps(overview, ensure_ascii=False, indent=2)[:18_000]
    return (
        RUNTIME_SYSTEM_PROMPT
        + f"\nYour configured spoken name is {cfg.get('agent_name') or DEFAULT_AGENT_NAME}. "
          "Use that name consistently when introducing or referring to yourself.\n"
        + f"\nDefault conversation language hint: {cfg.get('language') or DEFAULT_LANGUAGE}.\n"
        + f"Capability domain commands allowed: {bool(cfg.get('allow_capability_domain_commands'))}.\n"
        + f"Codex task delegation allowed: {bool(cfg.get('allow_codex_tasks'))}.\n"
        + f"Maximum concurrent agent sessions: {cfg.get('max_agent_sessions') or DEFAULT_MAX_AGENT_SESSIONS}.\n"
        + "\nOrdered connection prompt stack:\n"
        + _prompt_stack(cfg)
        + f"Project snapshot at session start:\n{snapshot}\n"
    )


def _start_greeting_prompt(cfg: dict) -> str:
    name = str(cfg.get("agent_name") or DEFAULT_AGENT_NAME)[:80]
    return (
        "Start the voice conversation now. Speak first and briefly greet the user "
        f"in the conversation language. Introduce yourself as {json.dumps(name)} "
        "and as their voice project companion, then ask what they would like to discuss."
    )


def _live_config(cfg: dict, enable_tools: bool = True) -> dict:
    config = {
        "response_modalities": ["AUDIO"],
        "system_instruction": {"parts": [{"text": _system_prompt(cfg)}]},
        "speech_config": {
            "voice_config": {
                "prebuilt_voice_config": {"voice_name": cfg.get("voice") or DEFAULT_VOICE}
            }
        },
        "input_audio_transcription": {},
        "output_audio_transcription": {},
    }
    if enable_tools and cfg.get("allow_tools", True):
        config["tools"] = [{"function_declarations": TOOL_DECLARATIONS}]
    return config


def _content_text(part) -> str | None:
    text = getattr(part, "text", None)
    return text if isinstance(text, str) and text else None


def _audio_chunks(response) -> list[bytes]:
    chunks: list[bytes] = []
    content = getattr(response, "server_content", None)
    turn = getattr(content, "model_turn", None) if content else None
    for part in (getattr(turn, "parts", None) or []):
        inline = getattr(part, "inline_data", None)
        data = getattr(inline, "data", None) if inline else None
        if data:
            chunks.append(data)
    return chunks


def _plain_text_parts(response) -> list[str]:
    out = []
    content = getattr(response, "server_content", None)
    turn = getattr(content, "model_turn", None) if content else None
    for part in (getattr(turn, "parts", None) or []):
        text = _content_text(part)
        if text:
            out.append(text)
    return out


def _transcription_texts(response) -> tuple[str | None, str | None, bool]:
    content = getattr(response, "server_content", None)
    if not content:
        return None, None, False
    input_tr = getattr(content, "input_transcription", None)
    output_tr = getattr(content, "output_transcription", None)
    # Gemini 3.1 Live may finish an audio response with generation_complete
    # without setting turn_complete. Either signal means the model is idle and
    # an accepted end_session request can now close the local runtime.
    turn_complete = bool(
        getattr(content, "turn_complete", False)
        or getattr(content, "generation_complete", False)
    )
    return (getattr(input_tr, "text", None) if input_tr else None,
            getattr(output_tr, "text", None) if output_tr else None,
            turn_complete)


async def _handle_tool_call(session, response, runtime: _LiveRuntime | None = None) -> None:
    tool_call = getattr(response, "tool_call", None)
    calls = getattr(tool_call, "function_calls", None) if tool_call else None
    if not calls:
        return
    from google.genai import types

    responses = []
    end_after_ack = False
    if runtime is not None:
        runtime.note_model_activity()
    for fc in calls:
        name = getattr(fc, "name", "")
        raw_args = getattr(fc, "args", {}) or {}
        args = dict(raw_args) if not isinstance(raw_args, dict) else raw_args
        sys.stderr.write(f"\n[geminitalk tool] {name} {json.dumps(args, ensure_ascii=False)}\n")
        if name == "codex_task" and runtime is not None:
            result = runtime.start_codex_job(args)
        elif name == "end_session":
            if runtime is None:
                result = {"ok": False, "error": "end_session is available only in talk mode"}
            else:
                result = runtime.request_end_session()
                end_after_ack = bool(result.get("ok"))
        else:
            # Other project and capability tools can block. Keep them off the
            # event loop so microphone streaming never pauses.
            result = await asyncio.to_thread(_execute_tool, name, args)
        responses.append(types.FunctionResponse(
            name=name,
            id=getattr(fc, "id", None),
            response={"result": result},
        ))
    if end_after_ack and runtime is not None:
        # Arm before awaiting the websocket send. This keeps the safety timeout
        # effective even if the SDK send blocks while the farewell is generated.
        runtime.arm_end_after_turn()
    await session.send_tool_response(function_responses=responses)


async def _run_text_session(cfg: dict, message: str, timeout: float) -> str:
    from google import genai

    client = genai.Client(api_key=cfg["api_key"])
    config = _live_config(cfg, enable_tools=True)
    transcript: list[str] = []
    text_parts: list[str] = []
    async with client.aio.live.connect(model=cfg["model"], config=config) as session:
        await session.send_realtime_input(text=message)
        async with asyncio.timeout(timeout):
            async for response in session.receive():
                await _handle_tool_call(session, response)
                _inp, out, done = _transcription_texts(response)
                if out:
                    transcript.append(out)
                text_parts.extend(_plain_text_parts(response))
                if done:
                    answer = "".join(transcript).strip() or "\n".join(text_parts).strip()
                    return answer
    return "".join(transcript).strip() or "\n".join(text_parts).strip()


def _drain_async_queue(q: asyncio.Queue) -> None:
    while True:
        try:
            q.get_nowait()
        except asyncio.QueueEmpty:
            return


async def _microphone_sender(session) -> None:
    from google.genai import types
    import sounddevice as sd

    loop = asyncio.get_running_loop()
    q: asyncio.Queue[bytes] = asyncio.Queue(maxsize=60)

    def push(data: bytes) -> None:
        if q.full():
            try:
                q.get_nowait()
            except asyncio.QueueEmpty:
                pass
        try:
            q.put_nowait(data)
        except asyncio.QueueFull:
            pass

    def callback(indata, frames, time_info, status) -> None:
        if status:
            sys.stderr.write(f"\n[geminitalk audio input] {status}\n")
        loop.call_soon_threadsafe(push, bytes(indata))

    with sd.RawInputStream(samplerate=INPUT_RATE, channels=1, dtype="int16",
                           blocksize=1600, callback=callback):
        while True:
            chunk = await q.get()
            await session.send_realtime_input(
                audio=types.Blob(data=chunk, mime_type=f"audio/pcm;rate={INPUT_RATE}")
            )


async def _speaker_player(q: asyncio.Queue[bytes | None]) -> None:
    import sounddevice as sd

    with sd.RawOutputStream(samplerate=OUTPUT_RATE, channels=1, dtype="int16",
                            blocksize=2400) as stream:
        while True:
            chunk = await q.get()
            if chunk is None:
                return
            await asyncio.to_thread(stream.write, chunk)


def _prepare_macos_voice_io() -> Path:
    executable = Path(__file__).resolve()
    candidates = [
        executable.with_name("geminitalk-audio.swift"),
        executable.parent / "bin" / "geminitalk-audio.swift",
    ]
    source = next((path for path in candidates if path.is_file()), None)
    if source is None:
        raise RuntimeError("macOS audio helper source is missing from the capability bundle")
    swiftc = shutil.which("swiftc")
    if not swiftc:
        raise RuntimeError("swiftc is required for macOS Voice Processing audio")

    cache_dir = _STATE_HOME / NAME
    cache_dir.mkdir(parents=True, exist_ok=True)
    binary = cache_dir / "geminitalk-audio"
    if not binary.is_file() or binary.stat().st_mtime_ns < source.stat().st_mtime_ns:
        temporary = binary.with_suffix(".new")
        result = subprocess.run(
            [swiftc, "-swift-version", "5", str(source), "-o", str(temporary)],
            capture_output=True,
            text=True,
        )
        if result.returncode:
            detail = (result.stderr or result.stdout).strip()
            raise RuntimeError(f"could not compile macOS audio helper: {detail}")
        os.replace(temporary, binary)
    return binary


async def _macos_microphone_sender(session, process: asyncio.subprocess.Process) -> None:
    from google.genai import types

    if process.stdout is None:
        raise RuntimeError("macOS audio helper has no capture stream")
    while True:
        chunk = await process.stdout.read(3200)
        if not chunk:
            code = await process.wait()
            raise RuntimeError(f"macOS audio helper stopped with exit code {code}")
        await session.send_realtime_input(
            audio=types.Blob(data=chunk, mime_type=f"audio/pcm;rate={INPUT_RATE}")
        )


async def _stdin_text_sender(session, runtime: _LiveRuntime | None = None) -> None:
    loop = asyncio.get_running_loop()
    lines: asyncio.Queue[str | None] = asyncio.Queue()
    fd = sys.stdin.fileno()

    def readable() -> None:
        line = sys.stdin.readline()
        lines.put_nowait(line if line else None)

    loop.add_reader(fd, readable)
    try:
        while True:
            line = await lines.get()
            if line is None:
                return
            message = line.strip()
            if not message:
                continue
            sys.stderr.write(f"\n[codex → geminitalk] {message}\n")
            if runtime is not None:
                runtime.record_user_text(message)
            await session.send_realtime_input(text=message)
    finally:
        loop.remove_reader(fd)


async def _macos_playback_command(process: asyncio.subprocess.Process,
                                  command: int, audio: bytes = b"") -> None:
    if process.stdin is None:
        raise RuntimeError("macOS audio helper has no playback stream")
    process.stdin.write(struct.pack(">BI", command, len(audio)) + audio)
    await process.stdin.drain()


async def _receiver(session, out_q: asyncio.Queue[bytes | None] | None = None,
                    voice_io: asyncio.subprocess.Process | None = None,
                    runtime: _LiveRuntime | None = None) -> None:
    while True:
        received = False
        async for response in session.receive():
            received = True
            inp, out, done = _transcription_texts(response)
            if inp:
                sys.stderr.write(f"\n[you] {inp}\n")
                if runtime is not None:
                    runtime.record_user_text(inp)
            if out:
                sys.stderr.write(f"\n[geminitalk] {out}\n")
                if runtime is not None:
                    runtime.note_model_activity()
            chunks = _audio_chunks(response)
            if chunks and runtime is not None:
                runtime.note_model_activity()
            await _handle_tool_call(session, response, runtime)
            content = getattr(response, "server_content", None)
            if bool(getattr(content, "interrupted", False)):
                if voice_io is not None:
                    await _macos_playback_command(voice_io, 1)
                elif out_q is not None:
                    _drain_async_queue(out_q)
            for chunk in chunks:
                if voice_io is not None:
                    # Stream each Gemini PCM packet straight to the audio
                    # engine. The microphone sender is a separate concurrent
                    # task and is never gated by playback.
                    await _macos_playback_command(voice_io, 0, chunk)
                elif out_q is not None:
                    await out_q.put(chunk)
            if done:
                sys.stderr.write("\n")
                if runtime is not None:
                    runtime.note_turn_complete()
        # The SDK ends each receive iterator at turn_complete. Open the next
        # iterator for another user/model turn; an empty iterator means the
        # underlying Live session has actually closed.
        if not received:
            return


async def _run_talk_session(cfg: dict, timeout: float | None, enable_tools: bool) -> None:
    from google import genai

    client = genai.Client(api_key=cfg["api_key"])
    config = _live_config(cfg, enable_tools=enable_tools)
    voice_io: asyncio.subprocess.Process | None = None
    if sys.platform == "darwin":
        binary = _prepare_macos_voice_io()
        voice_io = await asyncio.create_subprocess_exec(
            str(binary),
            stdin=asyncio.subprocess.PIPE,
            stdout=asyncio.subprocess.PIPE,
        )
    async with client.aio.live.connect(model=cfg["model"], config=config) as session:
        runtime = _LiveRuntime(session, cfg.get("max_agent_sessions") or DEFAULT_MAX_AGENT_SESSIONS)
        sys.stderr.write(
            f"geminitalk live session started: model={cfg['model']} voice={cfg['voice']} "
            f"project={cfg['project_root']}\nPress Ctrl-C to stop.\n"
        )
        if voice_io is not None:
            out_q = None
            tasks = [
                asyncio.create_task(_macos_microphone_sender(session, voice_io)),
                asyncio.create_task(_receiver(session, voice_io=voice_io, runtime=runtime)),
            ]
        else:
            out_q = asyncio.Queue(maxsize=120)
            tasks = [
                asyncio.create_task(_microphone_sender(session)),
                asyncio.create_task(_speaker_player(out_q)),
                asyncio.create_task(_receiver(session, out_q, runtime=runtime)),
            ]
        tasks.append(asyncio.create_task(runtime.completion_notifier()))
        tasks.append(asyncio.create_task(runtime.stop_requested.wait()))
        if sys.stdin.isatty():
            tasks.append(asyncio.create_task(_stdin_text_sender(session, runtime)))
        try:
            await session.send_realtime_input(text=_start_greeting_prompt(cfg))
            if timeout:
                await asyncio.wait(tasks, timeout=timeout, return_when=asyncio.FIRST_COMPLETED)
            else:
                await asyncio.wait(tasks, return_when=asyncio.FIRST_COMPLETED)
        finally:
            for task in tasks:
                task.cancel()
            if out_q is not None:
                await out_q.put(None)
            await asyncio.gather(*tasks, return_exceptions=True)
            await runtime.close()
            if voice_io is not None and voice_io.returncode is None:
                voice_io.terminate()
                await voice_io.wait()


# --- Doctor ------------------------------------------------------------------

def _probe_sdk() -> dict:
    try:
        import google.genai  # noqa: F401
    except Exception as e:
        return {"ok": False, "error": f"{type(e).__name__}: {e}"}
    return {"ok": True}


def _probe_model(cfg: dict) -> dict:
    model = str(cfg["model"]).removeprefix("models/")
    url = "https://generativelanguage.googleapis.com/v1beta/models/" + \
        urllib.parse.quote(model, safe="") + "?key=" + urllib.parse.quote(cfg["api_key"])
    try:
        with urllib.request.urlopen(url, timeout=DOCTOR_TIMEOUT) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return {"ok": True, "name": data.get("name"), "display_name": data.get("displayName")}
    except urllib.error.HTTPError as e:
        if e.code in (400, 401, 403):
            return {"ok": False, "category": 2,
                    "error": f"Google API rejected the key or request (HTTP {e.code})"}
        if e.code == 404:
            return {"ok": False, "category": 5,
                    "error": f"model {cfg['model']!r} was not found for this API key"}
        return {"ok": False, "category": 5, "error": f"Google API returned HTTP {e.code}"}
    except (OSError, ValueError) as e:
        return {"ok": False, "category": 5, "error": f"could not reach Google API: {e}"}


def _probe_audio(require: bool = False) -> dict:
    try:
        import sounddevice as sd
        devices = sd.query_devices()
        default = sd.default.device
    except Exception as e:
        return {"ok": not require, "required": require, "error": f"{type(e).__name__}: {e}"}
    return {"ok": True, "required": require, "default_device": list(default),
            "device_count": len(devices)}


def cmd_doctor(reg: dict | None, wanted: str | None, require_audio: bool) -> None:
    _doctor_gate(_connections_report(), wanted)
    if wanted is not None or reg is None:
        targets = [_select_connection(reg, wanted)]
    else:
        targets = list(reg["connections"].items())
    sdk = _probe_sdk()
    connections: dict = {}
    fail_exit = 0 if sdk.get("ok") else 5
    for cid, entry in targets:
        cfg, problem = _materialize_cfg(cid, entry)
        if problem:
            res = {"ok": False, "error": problem["message"]}
            category = problem["exit"]
        else:
            model = _probe_model(cfg)
            audio = _probe_audio(require_audio)
            ok = bool(model.get("ok")) and bool(audio.get("ok")) and bool(sdk.get("ok"))
            category = 0
            if not model.get("ok"):
                category = int(model.get("category") or 5)
            elif not audio.get("ok"):
                category = 5
            res = {
                "ok": ok,
                "model": model,
                "voice": cfg.get("voice"),
                "language": cfg.get("language"),
                "agent_name": cfg.get("agent_name"),
                "max_agent_sessions": cfg.get("max_agent_sessions"),
                "project_root": str(cfg.get("project_root")),
                "prompt_files": cfg.get("prompt_files"),
                "audio": audio,
                "sdk": sdk,
            }
        if category and not fail_exit:
            fail_exit = category
        connections[cid] = res
    _emit({"ok": fail_exit == 0, "connections": connections})
    if fail_exit:
        sys.exit(fail_exit)


# --- CLI ---------------------------------------------------------------------

def _strip_global_flags(argv: list[str]) -> tuple[list[str], str | None]:
    wanted_conn = None
    cleaned = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--connection" and i + 1 < len(argv):
            wanted_conn = argv[i + 1]
            i += 2
            continue
        if a.startswith("--connection="):
            wanted_conn = a.split("=", 1)[1]
            i += 1
            continue
        cleaned.append(a)
        i += 1
    return cleaned, wanted_conn


def cmd_voices(argv: list[str]) -> None:
    as_json = "--json" in argv
    bad = [a for a in argv if a != "--json"]
    if bad:
        _die(6, "input", f"unknown voices argument {bad[0]!r}",
             "usage: geminitalk voices [--json]")
    if as_json:
        _emit({"default": DEFAULT_VOICE, "voices": KNOWN_VOICES})
    else:
        lines = [f"default: {DEFAULT_VOICE}", ""]
        lines += [f"{v['name']}: {v['style']}" for v in KNOWN_VOICES]
        _emit("\n".join(lines))


def cmd_prompt(reg: dict | None, wanted: str | None) -> None:
    _cid, cfg = _selected_cfg(reg, wanted, require_key=False)
    _emit(_system_prompt(cfg))


def cmd_text(reg: dict | None, wanted: str | None, argv: list[str]) -> None:
    parser = argparse.ArgumentParser(prog="geminitalk text", add_help=False)
    parser.add_argument("--timeout", type=float, default=TEXT_TIMEOUT)
    parser.add_argument("message", nargs=argparse.REMAINDER)
    ns = parser.parse_args(argv)
    message = " ".join(ns.message).strip()
    if not message:
        _die(6, "input", "geminitalk text needs a message")
    _cid, cfg = _selected_cfg(reg, wanted)
    try:
        answer = asyncio.run(_run_text_session(cfg, message, ns.timeout))
    except TimeoutError:
        _die(5, "live_timeout", f"Live session timed out after {ns.timeout}s")
    except KeyboardInterrupt:
        return
    except Exception as e:
        _die(5, "live_error", f"{type(e).__name__}: {e}")
    _emit(answer or "")


def cmd_talk(reg: dict | None, wanted: str | None, argv: list[str]) -> None:
    parser = argparse.ArgumentParser(prog="geminitalk talk", add_help=False)
    parser.add_argument("--timeout", type=float, default=None)
    parser.add_argument("--no-tools", action="store_true")
    ns, extra = parser.parse_known_args(argv)
    if extra:
        _die(6, "input", f"unknown talk argument {extra[0]!r}",
             "usage: geminitalk talk [--connection <id>] [--timeout <seconds>] [--no-tools]")
    _cid, cfg = _selected_cfg(reg, wanted)
    try:
        asyncio.run(_run_talk_session(cfg, ns.timeout, not ns.no_tools))
    except KeyboardInterrupt:
        sys.stderr.write("\ngeminitalk live session stopped.\n")
    except Exception as e:
        _die(5, "live_error", f"{type(e).__name__}: {e}")


def main() -> None:
    _gate()
    argv, wanted_conn = _strip_global_flags(sys.argv[1:])
    _contract(argv)
    if not argv or argv[0] in {"help", "-h", "--help"}:
        _cmd_help()
        return

    cmd, rest = argv[0], argv[1:]
    if cmd == "init":
        if rest:
            _die(6, "input", "usage: geminitalk init")
        _emit(cmd_init())
        return
    reg, _ = _connections_registry()
    if cmd == "doctor":
        require_audio = False
        clean = []
        for a in rest:
            if a == "--audio":
                require_audio = True
            else:
                clean.append(a)
        if clean:
            _die(6, "input", f"unknown doctor argument {clean[0]!r}",
                 "usage: geminitalk doctor [--connection <id>] [--audio]")
        cmd_doctor(reg, wanted_conn, require_audio)
        return
    if cmd == "voices":
        cmd_voices(rest)
        return
    if cmd == "tools":
        if rest:
            _die(6, "input", "usage: geminitalk tools")
        _emit(TOOL_DECLARATIONS)
        return
    if cmd == "project":
        if rest:
            _die(6, "input", "usage: geminitalk project")
        _emit(tool_project_overview(True))
        return
    if cmd == "prompt":
        if rest:
            _die(6, "input", "usage: geminitalk prompt [--connection <id>]")
        cmd_prompt(reg, wanted_conn)
        return
    if cmd == "text":
        cmd_text(reg, wanted_conn, rest)
        return
    if cmd == "talk":
        cmd_talk(reg, wanted_conn, rest)
        return
    _die(6, "input", f"unknown command {cmd!r}", "run `geminitalk help`")


if __name__ == "__main__":
    main()
