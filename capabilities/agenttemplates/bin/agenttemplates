#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "capabilities-contract>=0.50,<1",
# ]
# ///
"""agenttemplates — the agent templates a new agent is made from.

The templates are files carried in this capability's own bundle, under
`templates/`: `context/` holds the starter context files the manager lays into
a new project, and `agents/<id>/` each agent template the manager creates a
ready agent from - its `template.toml`, its icon, and the files of its body
layers (`context/`, `assets/`, `routines/`). The manager reads them from here
when this capability is installed: `capabilities help` describes its init
from a template and its `templates` verb. Nothing is written: both verbs only
read the bundle. `agenttemplates help list` and `agenttemplates help show`
name the manager's verbs that read them.

USAGE
  agenttemplates <command> [options]

Commands
  doctor                      is the bundle's templates folder there, and what it holds
  list                        every starter file and agent template the bundle carries
  show <id|path>              one agent template by its id, or one file by its path

I/O
Success is JSON on stdout; failure is {"error": {"code", "message", "hint"?}}
on stderr.

Exit codes:
  0 success · 3 not found · 4 disabled by project policy · 6 input/validation
"""

import json
import os
import sys
from pathlib import Path
from typing import NoReturn

NAME = 'agenttemplates'
TITLE = "Agent Templates"
LUCIDE_ICON = "layout-template"
SUMMARY = ("The agent templates a new agent is made from - the starter context files and "
           "each agent template (its manifest, icon, context, routines) - carried as files "
           "in this capability's bundle; list them and show one, and the manager's "
           "`templates` and `init --template` read them from here.")
# The title and summary in Russian and Estonian; English stays the source
# and the fallback (SHEBANG.md, the manifest table).
TRANSLATIONS = {
    "ru": {"title": 'Шаблоны агентов',
           "description": ('Шаблоны, из которых создаётся новый агент, — стартовые файлы контекста'
                            ' и каждый шаблон агента (его манифест, значок, контекст, процедуры), '
                            'хранящиеся как файлы в пакете этого приложения; их можно перечислить и'
                            ' показать по одному, а `templates` и `init --template` менеджера '
                            'читают их отсюда.')},
    "et": {"title": 'Agendimallid',
           "description": ('Agendimallid, millest uus agent luuakse – algsed kontekstifailid ja '
                            'iga agendimall (selle manifest, ikoon, kontekst, rutiinid), mis on '
                            'failidena selle rakenduse komplektis; neid saab loetleda ja ükshaaval '
                            'näidata ning halduri `templates` ja `init --template` loevad neid '
                            'siit.')},
}
SCOPE = "project"
CRED_KEYS = []
WRITE_VERBS = set()
WRITE_DEFAULT = True
DOCS_BASE = ""
STATE = False
INVENTORY = None
POST_INSTALL: list[dict] = []
CONN_FIELDS: list[dict] = []

_CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
CREDENTIALS_ENV = _CONFIG_HOME / NAME / "credentials.env"
_STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state"))


# The shared capability code is the capabilities-contract library's, bound here
# into this script's namespace (SHEBANG.md, "The contract verbs").
from capabilities_contract.capability import bind as _contract_bind

_contract_bind(globals(), "core")

_contract_bind(globals(), "store")

TEMPLATE_MANIFEST = "template.toml"

# The verb pages `agenttemplates help <verb>` answers (SHEBANG.md, "Agent-first
# help is the surface"): each verb's whole contract, the module docstring being
# the menu. The contract library dispatches both and renders the contract
# verbs' own pages, which the entry here for doctor follows.
_HELP_BUNDLE = """
  The templates are files carried in this capability's own bundle, under
  `templates/`: `context/` holds the starter context files that `capabilities
  init --with-template` lays into a project, and `agents/<id>/` each agent
  template that `capabilities init --template <id>` creates a ready agent from -
  its `template.toml`, its icon, and the files of its body layers (`context/`,
  `assets/`, `routines/`). The manager reads them from here when this capability
  is installed: `capabilities help` describes `init --with-template`, `init
  --template` and `templates`. Nothing is written: both verbs only read the
  bundle.
"""
HELP_VERBS = {
    "doctor": """\
  agenttemplates has no connections, so its doctor takes no arguments (a
  --connection is refused, exit 6 input) and reaches no system: it reports whether the bundle's templates folder is
  there, with the number of starter files and agent templates it holds. No
  network, no mutation.

  Output: {ok: true, templates, starter, agents}, where `templates` is the
  folder, `starter` the number of starter files and `agents` the number of
  agent templates. Where the folder is missing: {ok: false, templates,
  problem, hint}, the hint naming `capabilities install agenttemplates`.

  Exit codes: 0 the folder is there; 1 it is missing; 4 disabled by project
  policy; 6 input for any argument.

  Example: agenttemplates doctor
""",
    "list": """\
agenttemplates list

  Every template the bundle carries. Takes no arguments; reads only the
  bundle.

  Output: {source, starter [{path, title, description}], agents [{id, name,
  description, path}]}. `source` is the templates folder; a starter `path`
  is relative to it, an agent `path` is its folder. Title and description
  come from each starter file's front matter and each agent template's
  `template.toml`; a starter file without a title is titled by its file
  name.

  Exit codes: 0 success; 4 disabled by project policy; 6 template_invalid
  when an agent template's `template.toml` cannot be read.

  Example: agenttemplates list
""" + _HELP_BUNDLE,
    "show": """\
agenttemplates show <id|path>

  An agent template by its id (`personal-agent`): {id, path, manifest,
  files}, where `manifest` is its `template.toml` as read and `files`
  every file it carries, relative to its folder. Or one file by its path
  relative to the templates folder (`context/identity/AGENT.md`,
  `agents/personal-agent/routines/onboarding.md`): {path, text}. A path
  holds a `/`, an id never does. Reads only the bundle.

  Exit codes: 0 success; 3 not_found, naming what there is, when neither
  names anything the bundle carries; 4 disabled by project policy; 6 input
  when the path names a file that is not text, template_invalid when the
  template's `template.toml` cannot be read.

  Examples:
    agenttemplates show personal-agent
    agenttemplates show context/identity/AGENT.md
""" + _HELP_BUNDLE,
}


def _cmd_connections() -> None:
    _emit({"default": None, "connections": {}})


def _templates_root() -> Path:
    """`templates/` beside the executable once installed, or beside `bin/` in
    the source bundle."""
    executable = Path(__file__).resolve()
    for candidate in (executable.parent, executable.parent.parent):
        if (candidate / "templates").is_dir():
            return candidate / "templates"
    return executable.parent / "templates"


def _starter_front_matter(text: str) -> dict:
    """The `key: value` lines of a leading `---` block."""
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return {}
    out: dict = {}
    for line in lines[1:]:
        if line.strip() == "---":
            return out
        key, sep, value = line.partition(":")
        if sep:
            out[key.strip()] = value.strip()
    return {}


def _starter_files(root: Path) -> list[Path]:
    base = root / "context"
    return sorted(path for path in base.rglob("*.md") if path.is_file()) if base.is_dir() else []


def _agent_dirs(root: Path) -> dict:
    base = root / "agents"
    if not base.is_dir():
        return {}
    return {path.name: path for path in sorted(base.iterdir())
            if path.is_dir() and (path / TEMPLATE_MANIFEST).is_file()}


def _manifest(path: Path) -> dict:
    import tomllib
    try:
        return tomllib.loads((path / TEMPLATE_MANIFEST).read_text())
    except (OSError, ValueError) as exc:
        _die(6, "template_invalid", f"cannot read {path / TEMPLATE_MANIFEST}: {exc}")


def cmd_doctor() -> None:
    root = _templates_root()
    if not root.is_dir():
        _emit({"ok": False, "templates": str(root),
               "problem": "the bundle's templates folder is missing",
               "hint": f"reinstall with `capabilities install {NAME}`"})
        sys.exit(1)
    _emit({"ok": True, "templates": str(root), "starter": len(_starter_files(root)),
           "agents": len(_agent_dirs(root))})


def cmd_list() -> None:
    root = _templates_root()
    starter = []
    for path in _starter_files(root):
        fm = _starter_front_matter(path.read_text())
        starter.append({"path": path.relative_to(root).as_posix(),
                        "title": fm.get("title", path.stem),
                        "description": fm.get("description", "")})
    agents = []
    for template_id, path in _agent_dirs(root).items():
        manifest = _manifest(path)
        agents.append({"id": template_id, "name": manifest.get("name"),
                       "description": manifest.get("description"), "path": str(path)})
    _emit({"source": str(root), "starter": starter, "agents": agents})


def cmd_show(target: str) -> None:
    root = _templates_root()
    agents = _agent_dirs(root)
    if "/" not in target and target in agents:
        path = agents[target]
        files = sorted(file.relative_to(path).as_posix() for file in path.rglob("*")
                       if file.is_file()
                       and not any(part.startswith(".") for part in file.relative_to(path).parts))
        _emit({"id": target, "path": str(path), "manifest": _manifest(path), "files": files})
        return
    if "/" in target:
        file = (root / target).resolve()
        if file.is_file() and file.is_relative_to(root.resolve()):
            try:
                text = file.read_text()
            except UnicodeDecodeError:
                _die(6, "input", f"{target} is not a text file",
                     "show names an agent template by its id, or a text file by its path")
            _emit({"path": file.relative_to(root.resolve()).as_posix(), "text": text})
            return
    _die(3, "not_found", f"no template or template file {target!r}; agent templates: "
         + (", ".join(agents) or "none"),
         f"run `{NAME} list` for the starter files and agent templates")


def main() -> None:
    _gate()
    argv = sys.argv[1:]
    _contract(argv)
    if argv == ["doctor"]:
        cmd_doctor()
        return
    if argv == ["list"]:
        cmd_list()
        return
    if len(argv) == 2 and argv[0] == "show" and not argv[1].startswith("-"):
        cmd_show(argv[1])
        return
    _die(6, "input", "unknown or incomplete command: " + " ".join(argv),
         f"run `{NAME} help` for the verbs and their arguments")


if __name__ == "__main__":
    main()
