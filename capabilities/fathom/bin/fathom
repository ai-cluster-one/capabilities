# --- Error reporting ---------------------------------------------------------

def _die(exit_code: int, code: str, message: str,
         hint: str | None = None, status: int | None = None) -> NoReturn:
    err: dict = {"code": code, "message": message}
    if hint:
        err["hint"] = hint
    if status is not None:
        err["status"] = status
    if _EVENTS_ON[0]:
        sys.stdout.write(json.dumps({"event": "error", "exit": exit_code, "error": err},
                                    ensure_ascii=False) + "\n")
        sys.stdout.flush()
    sys.stderr.write(json.dumps({"error": err}, ensure_ascii=False) + "\n")
    sys.exit(exit_code)


def _store_lost(kind, exc, trace) -> None:
    """A store connection lost where nothing caught it ends the command as the
    store being unreachable, exit 5, rather than with a traceback: the database
    library has already tried again everything it safely could."""
    driver = sys.modules.get("psycopg")
    if driver is None or not isinstance(exc, driver.OperationalError):
        _UNCAUGHT[0](kind, exc, trace)
        return
    try:
        _die(5, "store_unreachable",
             "the store stopped answering: " + " ".join(str(exc).split())[:300],
             "check the database setting with `capabilities store doctor`")
    except SystemExit:
        pass
    import atexit
    import os
    atexit._run_exitfuncs()
    sys.stdout.flush()
    sys.stderr.flush()
    os._exit(5)


_UNCAUGHT = [sys.excepthook]
sys.excepthook = _store_lost


def _emit(value) -> None:
    if _EVENTS_ON[0]:
        sys.stdout.write(json.dumps({"event": "done", "result": value},
                                    ensure_ascii=False, default=str) + "\n")
        sys.stdout.flush()
        return
    if isinstance(value, str):
        sys.stdout.write(value)
        if value and not value.endswith("\n"):
            sys.stdout.write("\n")
    else:
        sys.stdout.write(json.dumps(value, ensure_ascii=False, indent=2) + "\n")


# --- Project / file plumbing -------------------------------------------------

def _parse_env_file(path: Path) -> dict:
    """Parse a KEY=VALUE env/dotenv file. Missing/unreadable file -> {}."""
    out: dict = {}
    try:
        text = path.read_text()
    except OSError:
        return out
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        k = k.strip()
        if k.startswith("export "):
            k = k[len("export "):].strip()
        out[k] = v.strip().strip('"').strip("'")
    return out


def _home_dirs() -> set[Path]:
    """Every directory that is a home directory of the account running this.

    $HOME answers for the process and moves wherever a caller points it; the
    password database answers for the account and cannot be pointed anywhere.
    A caller that redirects $HOME - a dev lane, a service under a supervisor, a
    sandbox - would otherwise carry the guard onto the home it invented and stop
    excluding the account's own, which is the one the machine registry sits in.
    """
    import pwd

    homes: set[Path] = set()
    candidates = [Path.home()]
    try:
        account = pwd.getpwuid(os.getuid()).pw_dir
    except (KeyError, OSError):
        account = ""
    # The account's field counts only when it is absolute. An empty or relative
    # one names no directory of its own: it resolves against the cwd, an empty
    # one to the cwd itself, so taken as a home it would stop the walk wherever
    # the process stands. Some service accounts carry an empty field.
    if os.path.isabs(account):
        candidates.append(Path(account))
    for candidate in candidates:
        try:
            homes.add(candidate.resolve())
        except OSError:
            continue
    return homes


def _is_machine_registry(path: Path) -> bool:
    """Whether this `.capabilities/` is a machine registry, not a legacy envelope.

    The two share the name, and only the registry carries `.manager/`. The
    registry $CAPABILITIES_HOME points at names itself even without it.
    """
    registry = Path(os.environ.get("CAPABILITIES_HOME") or (Path.home() / ".capabilities"))
    try:
        if path.resolve() == registry.resolve():
            return True
    except OSError:
        return False
    return (path / ".manager").is_dir()


def _project_root() -> Path | None:
    """Nearest project root, walking up from $CLAUDE_PROJECT_DIR (else cwd):
    the first directory holding capabilities/, legacy .capabilities/,
    .contextkit/config.toml, .env(.local), or .git.
    Markers are read from the filesystem alone: the root is what the envelope
    location is resolved against, so resolving one cannot depend on the other.
    A home directory is never a project root (the machine registry lives in
    one), and a `.capabilities/` that is a machine registry names that registry
    rather than a legacy envelope."""
    start = os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
    here = Path(start).resolve()
    homes = _home_dirs()
    for d in (here, *here.parents):
        if d in homes:
            return None
        legacy = d / ".capabilities"
        # Either marker names a project. `settings.json` is the gate and
        # `project.json` the identity; either one alone is enough.
        if ((d / "capabilities" / "settings.json").is_file()
                or (d / "capabilities" / "project.json").is_file()
                or (d / ".contextkit" / "config.toml").is_file()
                or (legacy.is_dir() and not _is_machine_registry(legacy))
                or (d / ".env").exists()
                or (d / ".env.local").exists() or (d / ".git").is_dir()):
            return d
    return None


_ENVELOPE_HOME: dict = {}


def _validated_project_envelope(root: Path, raw, provider: str) -> Path:
    """Validate the manager/context-owner answer without selecting a fallback."""
    value = str(raw or "").strip()
    if not value:
        _die(6, "project_envelope_empty",
             f"{provider} returned an empty capabilities envelope path")
    candidate = Path(value).expanduser()
    if not candidate.is_absolute():
        _die(6, "project_envelope_relative",
             f"{provider} returned a relative capabilities envelope path: {value!r}")
    try:
        resolved = candidate.resolve()
        resolved.relative_to(root.resolve())
    except (OSError, ValueError):
        _die(6, "project_envelope_outside_project",
             f"{provider} returned a capabilities envelope outside the project: {candidate}")
    return resolved


def _handed_off_envelope(root: Path) -> str:
    """The handoff meant for THIS project root, or "" when there is none.

    `CAPABILITIES_PROJECT_ENVELOPE` is inherited by every descendant process, and
    a descendant does not always stand in the project its parent stood in: a peer
    spawned in another project, or a worker whose cwd sits under a different root,
    must resolve its own envelope. `CAPABILITIES_PROJECT_ENVELOPE_ROOT` names the
    root the handed value answers for, so a handoff that crossed a project
    boundary is passed over instead of being applied to the wrong project. A
    handoff supplied without that companion belongs to whoever launched the
    process and is honored as given, which is how a context owner hands its answer
    over in advance.
    """
    override = os.environ.get("CAPABILITIES_PROJECT_ENVELOPE", "").strip()
    if not override:
        return ""
    scope = os.environ.get("CAPABILITIES_PROJECT_ENVELOPE_ROOT", "").strip()
    if not scope:
        return override
    try:
        if Path(scope).expanduser().resolve() != root.resolve():
            return ""
    except OSError:
        return ""
    return override


ENVELOPE_CACHE_VERSION = 1


def _record_file(kind: str, key: str) -> Path:
    """Where the manager records one kind of answer for one absolute project root.

    The file name only buckets roots apart; the entry's own `root` field is what
    proves identity, so two roots landing in one bucket cost a miss rather than
    a wrong answer.
    """
    import zlib

    base = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache"))
    return (base / "capabilities" / kind
            / f"{format(zlib.crc32(key.encode()), '08x')}.json")


def _envelope_witness(path) -> dict:
    """One input a recorded answer rests on, as that input stands right now."""
    try:
        seen = os.stat(path)
    except OSError:
        return {"path": str(path), "present": False}
    return {"path": str(path), "present": True,
            "size": seen.st_size, "mtime_ns": seen.st_mtime_ns}


def _cached_record(kind: str, version: int, root: Path):
    """The recorded entry for this root while every input it rests on holds.

    The manager writes the record and names the inputs its answer consulted; a
    reader re-observes each of them and compares it whole. Anything at all in
    doubt — an unreadable file, an unexpected shape, an input that moved, an
    expiry already behind the clock or a write ahead of it — returns None and
    costs a full resolution, so the failure mode is slow and never wrong.
    """
    import time

    key = str(root.resolve())
    try:
        entry = json.loads(_record_file(kind, key).read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(entry, dict):
        return None
    if entry.get("version") != version or entry.get("root") != key:
        return None
    written, expires = entry.get("written_at"), entry.get("expires_at")
    if not isinstance(written, (int, float)) or not isinstance(expires, (int, float)):
        return None
    now = time.time()
    if now < written or now >= expires:
        return None
    witness = entry.get("witness")
    if not isinstance(witness, list):
        return None
    for observed in witness:
        if (not isinstance(observed, dict)
                or _envelope_witness(observed.get("path")) != observed):
            return None
    return entry


def _cached_envelope(root: Path):
    """The recorded envelope for this root, while its record stands."""
    entry = _cached_record("envelope", ENVELOPE_CACHE_VERSION, root)
    if entry is None:
        return None
    envelope = Path(str(entry.get("envelope") or ""))
    if not envelope.is_absolute():
        return None
    try:
        envelope.resolve().relative_to(entry["root"])
    except (OSError, ValueError):
        return None
    return envelope


def _ask_manager(root: Path, *flags: str) -> tuple:
    """`capabilities path --json` for this root: (answer, None) or (None, error).

    The error carries the exit code the caller should use and the manager's own
    code, message and hint where it gave them."""
    import subprocess

    env = dict(os.environ)
    env["CLAUDE_PROJECT_DIR"] = str(root)
    # Asked at all, the manager answers from the project itself: a live id
    # hand-down for this root is used before asking, so any in the environment
    # is this process's own and must not come back as the answer.
    env.pop("CAPABILITIES_PROJECT_ID", None)
    env.pop("CAPABILITIES_PROJECT_ID_ROOT", None)
    manager = os.environ.get("CAPABILITIES_MANAGER_BIN", "").strip()
    if not manager:
        source_manager = Path(__file__).resolve().parents[3] / "bin" / "capabilities"
        manager = str(source_manager) if source_manager.is_file() else "capabilities"
    try:
        proc = subprocess.run(
            [manager, "path", "--json", *flags], cwd=root, env=env,
            capture_output=True, text=True, timeout=10)
    except FileNotFoundError:
        return None, {"exit": 6, "code": "capabilities_manager_unavailable",
                      "message": "the capabilities manager is required to resolve the project",
                      "hint": "install or repair the `capabilities` command"}
    except subprocess.TimeoutExpired:
        return None, {"exit": 6, "code": "capabilities_path_timeout",
                      "message": "the capabilities manager did not resolve the project within 10 seconds"}
    except OSError as exc:
        return None, {"exit": 6, "code": "capabilities_manager_unavailable",
                      "message": f"could not run the capabilities manager: {exc}"}
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip()
        try:
            error = json.loads(detail).get("error", {})
        except (AttributeError, ValueError):
            error = {}
        return None, {"exit": proc.returncode if proc.returncode in (3, 4, 5, 6) else 6,
                      "code": str(error.get("code") or "capabilities_path_failed"),
                      "message": str(error.get("message") or "the capabilities manager could not resolve the project"),
                      "hint": str(error.get("hint") or detail or "run `capabilities path --json` for details")}
    try:
        answer = json.loads(proc.stdout)
    except ValueError as exc:
        return None, {"exit": 6, "code": "capabilities_path_malformed",
                      "message": f"the capabilities manager returned invalid JSON: {exc}"}
    if not isinstance(answer, dict):
        return None, {"exit": 6, "code": "capabilities_path_malformed",
                      "message": "the capabilities manager path answer must be a JSON object"}
    manager_root = Path(str(answer.get("project_root") or ""))
    if not manager_root.is_absolute() or manager_root.resolve() != root.resolve():
        return None, {"exit": 6, "code": "capabilities_project_mismatch",
                      "message": "the capabilities manager resolved a different project root"}
    return answer, None


def _manager_project_envelope(root: Path) -> Path:
    """Consume the capabilities manager's one authoritative project answer."""
    override = _handed_off_envelope(root)
    if override:
        return _validated_project_envelope(root, override, "environment handoff")
    answer, error = _ask_manager(root)
    if error:
        _die(error["exit"], error["code"], error["message"], error.get("hint"))
    provider = str(answer.get("provider") or "capabilities manager")
    return _validated_project_envelope(
        root, answer.get("project_envelope"), provider)


def _envelope_home(root: Path) -> Path:
    """The project's envelope root, resolved once per invocation.

    The capabilities manager owns project-envelope discovery, including any
    delegation to ContextKit. Capability CLIs consume that answer and never
    duplicate context-owner detection.

    The answer is then handed to this process's descendants, scoped to the root
    it answers for. Asking for it costs two interpreter starts — the manager and
    the context owner it delegates to — so a worker, a peer, or a nested
    capability call that would otherwise repeat the whole chain under whatever
    load the machine is under by then reads it instead.

    A fresh top-level call has no such handoff, and reads the manager's recorded
    answer for this root instead, which stands only while every input that answer
    rests on is unchanged. A live handoff outranks the record, and any doubt about
    the record asks the manager again.
    """
    cached = _ENVELOPE_HOME.get(root)
    if cached is not None:
        return cached
    home = None if _handed_off_envelope(root) else _cached_envelope(root)
    if home is None:
        home = _manager_project_envelope(root)
    _ENVELOPE_HOME[root] = home
    os.environ["CAPABILITIES_PROJECT_ENVELOPE"] = str(home)
    os.environ["CAPABILITIES_PROJECT_ENVELOPE_ROOT"] = str(root)
    # The id travels with the envelope: resolved at read level, handed down
    # only where a write may stamp it, and never a reason to refuse here.
    try:
        _project_id_state_at(root)
    except Exception:
        pass
    return home


def _project_capabilities_dir(root: Path) -> Path:
    """The active project envelope root.

    The resolved envelope is canonical. A legacy `.capabilities/` remains
    readable until `capabilities init` migrates it. If both exist, the canonical
    tree wins once it carries either the legacy file gate or the project identity;
    otherwise the legacy configured tree remains active so merely creating an
    empty visible directory loses no gate.
    """
    current = _envelope_home(root)
    legacy = root / ".capabilities"
    if ((current / "settings.json").is_file()
            or (current / "project.json").is_file()
            or not legacy.is_dir()):
        return current
    return legacy


def _manager_declared_id(root: Path) -> dict:
    """The id the capabilities manager answers for a project whose project.json
    declares none: it carries an id the project's ContextKit binding holds into
    project.json once and answers it. `{"id"}`, or `{"error"}` when the manager
    cannot answer."""
    reply, error = _ask_manager(root, "--identity")
    state = (reply or {}).get("project_identity")
    if error or not isinstance(state, dict):
        return {"error": error or {
            "code": "capabilities_path_malformed",
            "message": "the capabilities manager returned no project identity"}}
    ident = state.get("id")
    return {"id": ident.strip() if isinstance(ident, str) and ident.strip() else None}


def _identity_refusal(state: dict):
    """Why a write may not stamp this project's id, or None when it may.

    A project without an id is left to the caller, whose refusal already names
    `capabilities init`."""
    if state["state"] == "unresolved":
        return state["error"]
    if state["state"] == "mismatch":
        return {"code": "project_id_mismatch",
                "message": f"project.json holds project id {state['project_json_id']}, "
                           f"but the process that started this one handed down "
                           f"{state['handed_id']}",
                "hint": "start the command again from the project itself, so the id "
                        "is read from its project.json"}
    return None


def _handed_off_project_id(root: Path) -> str:
    """The project id handed down for THIS root, or "" when there is none.

    A process that resolved an id a write may stamp hands it to its descendants
    beside the envelope, as `CAPABILITIES_PROJECT_ID`, scoped by
    `CAPABILITIES_PROJECT_ID_ROOT` the way the envelope handoff is scoped: one
    that crossed a project boundary is passed over, and one supplied without the
    companion belongs to whoever launched the process and is honored as given.
    """
    handed = os.environ.get("CAPABILITIES_PROJECT_ID", "").strip()
    if not handed:
        return ""
    scope = os.environ.get("CAPABILITIES_PROJECT_ID_ROOT", "").strip()
    if not scope:
        return handed
    try:
        if Path(scope).expanduser().resolve() != root.resolve():
            return ""
    except OSError:
        return ""
    return handed


_PROJECT_ID_HANDED: dict = {}


def _project_id_state():
    """The id of the project this command stands in, where it came from, and
    whether a write may stamp it; None outside a project.

    `capabilities/project.json` is the id's one home. A live handoff for this
    root is that id as the launching process read it, so it is used as given
    unless project.json now declares another, which a write refuses. Where
    project.json declares none and the project carries a ContextKit binding,
    the manager is asked: it copies an id that binding holds into project.json
    once. An id a write may stamp is handed on to this process's descendants.
    Reading it asks no records backend: the id is what selects a project's
    records, so it is read before any of them."""
    root = _project_root()
    if root is None:
        return None
    return _project_id_state_at(root)


def _project_id_state_at(root: Path) -> dict:
    """`_project_id_state` for a known project root."""
    try:
        declared = json.loads((_project_capabilities_dir(root) / "project.json").read_text())
    except (OSError, ValueError):
        declared = None
    declared = (str(declared.get("id") or "").strip() or None
                if isinstance(declared, dict) else None)
    handed = _handed_off_project_id(root)
    if handed and _PROJECT_ID_HANDED.get(str(root)) == handed:
        handed = ""  # this process's own hand-down, not its launcher's
    if handed and declared and handed != declared:
        state = {"state": "mismatch", "id": declared, "handed_id": handed}
    elif handed:
        state = {"state": "handed", "id": handed}
    elif declared is None and (root / ".contextkit" / "config.toml").is_file():
        answer = _manager_declared_id(root)
        if "error" in answer:
            state = {"state": "unresolved", "id": None, "error": answer["error"]}
        else:
            declared = answer["id"]
            state = {"state": "declared" if declared else "undeclared", "id": declared}
    else:
        state = {"state": "declared" if declared else "undeclared", "id": declared}
    state["project_json_id"] = declared
    if not handed and state["id"] and _identity_refusal(state) is None:
        os.environ["CAPABILITIES_PROJECT_ID"] = state["id"]
        os.environ["CAPABILITIES_PROJECT_ID_ROOT"] = str(root)
        _PROJECT_ID_HANDED[str(root)] = state["id"]
    return state


def _project_id(write: bool = False, refuse: bool = True):
    """The project id this command stands in, or None where there is none.

    A read takes the id in every state. A write that stamps it takes it only
    once it is verified for this invocation, and otherwise exits 6 naming what
    to settle, or, with `refuse=False`, answers None so a read path that would
    stamp the id can leave that step out instead of refusing. A project that
    declares no id is still None, left to the caller's own refusal."""
    state = _project_id_state()
    if state is None:
        return None
    if write:
        refusal = _identity_refusal(state)
        if refusal:
            if not refuse:
                return None
            _die(6, refusal["code"], refusal["message"], refusal.get("hint"))
    return state["id"]


def _project_env() -> dict:
    """Project .env(.local) at the project root. .env.local overrides .env."""
    root = _project_root()
    if root is None:
        return {}
    merged = _parse_env_file(root / ".env")
    merged.update(_parse_env_file(root / ".env.local"))  # .local wins
    return merged


def _auth_context() -> dict | None:
    """Optional runtime authority envelope passed by an ingress/service.

    Absence means the ordinary project gate is the whole policy. Presence means
    a request-scoped authority layer exists and must fail closed before any
    credential or network work happens.
    """
    raw = os.environ.get("CAPABILITIES_AUTH_CONTEXT")
    if not raw:
        return None
    try:
        if raw.lstrip().startswith("{"):
            data = json.loads(raw)
        else:
            data = json.loads(Path(raw).read_text())
    except (OSError, ValueError) as e:
        _die(4, "auth_context_unreadable",
             "runtime authority context could not be read",
             f"{raw}: {e}")
    if not isinstance(data, dict):
        _die(4, "auth_context_invalid",
             "runtime authority context is not an object")
    return data


def _auth_capability_allowed(rule) -> bool:
    if rule is True or rule == "*":
        return True
    if rule in (False, None):
        return False
    if isinstance(rule, list):
        return True
    if isinstance(rule, dict):
        if rule.get("deny") is True:
            return False
        if rule.get("enabled") is False or rule.get("allow") is False:
            return False
        return True
    return False


# Verbs a rule's verb list never withholds: they say what the capability is and
# how it is configured, which is what an agent should reach for before acting.
_AUTH_CONTRACT_VERBS = frozenset(
    {"help", "guide", "ids", "connections", "refs", "stub", "manifest"})


def _auth_rule_verbs(rule) -> list | None:
    """The verbs a capability rule limits its grant to, or None when it grants
    the whole capability. A bare list is shorthand for {"verbs": [...]}."""
    if isinstance(rule, list):
        verbs = rule
    elif isinstance(rule, dict) and "verbs" in rule:
        verbs = rule["verbs"]
    else:
        return None
    if not isinstance(verbs, list) or not all(isinstance(v, str) for v in verbs):
        _die(4, "auth_context_invalid",
             f"runtime authority context has invalid verbs for {NAME}",
             "verbs must be a list of verb names")
    return verbs


def _auth_gate() -> None:
    ctx = _auth_context()
    if ctx is None:
        return
    allowed = ctx.get("allowed_capabilities")
    if allowed is None:
        return
    if allowed is True or allowed == "*":
        return
    source = ctx.get("source") or "runtime"
    role = ctx.get("sender_role") or ctx.get("role") or "unknown"
    chat = ctx.get("chat_id") or "unknown"
    if isinstance(allowed, list):
        if NAME in allowed or "*" in allowed:
            return
    elif isinstance(allowed, dict):
        rule = allowed.get(NAME, allowed.get("*"))
        if _auth_capability_allowed(rule):
            verbs = _auth_rule_verbs(rule)
            verb = sys.argv[1] if len(sys.argv) > 1 else "help"
            if verbs is None or verb in verbs or verb in _AUTH_CONTRACT_VERBS:
                return
            _die(4, "verb_not_authorized",
                 f"verb refused: `{NAME} {verb}` is not among the verbs this "
                 f"{source} request may run ({', '.join(verbs) or 'none'})",
                 f"role={role}; chat_id={chat}; adjust runtime authority policy instead of bypassing the gate")
    else:
        _die(4, "auth_context_invalid",
             "runtime authority context has invalid allowed_capabilities")
    _die(4, "capability_not_authorized",
         f"{NAME} is not authorized for this {source} request",
         f"role={role}; chat_id={chat}; adjust runtime authority policy instead of bypassing the gate")


def _policy_row():
    """The effective policy row from the same records adapter as everything else."""
    try:
        row = _records().resolve("capabilities", "policy").get(NAME)
    except StoreError as e:
        _die(5 if e.slug in STORE_ENVIRONMENT_SLUGS else 6, e.slug, e.message, e.hint)
    if row is None:
        return None
    entry = row.get("value")
    if (not isinstance(entry, dict) or set(entry) != {"enabled"}
            or not isinstance(entry.get("enabled"), bool)):
        _die(6, "bad_policy",
             f"invalid {NAME} policy entry in {_policy_source()}",
             'expected {"enabled": true|false}')
    return row


def _policy_source() -> str:
    """Where the gate is kept: the project's envelope, or the store's policy
    table in a project whose records are in the store."""
    records = _records()
    if records.mode_of("policy") != "store":
        return records.source
    try:
        return records.collection_source("capabilities", "policy")
    except StoreError:
        return "the store"


def _project_enabled_explicitly() -> bool:
    """True only for an explicit project enabled entry; global inheritance is
    deliberately insufficient for project-owned service activation."""
    row = _policy_row()
    return bool(row and row.get("scope") == "project"
                and row["value"].get("enabled") is True)


def _require_project_enabled_for_service() -> Path:
    root = _project_root()
    if root is None or not _project_enabled_explicitly():
        _die(4, "project_enable_required",
             f"{NAME} service activation requires an explicit project enable",
             f"ask the user, then run `capabilities enable {NAME} --project` "
             "before service init/start/run")
    return root


def _read_only_gate(action: str) -> None:
    """Refuse `action` when this process runs under the read-only switch.

    The switch is decided by the store tier's `read_only_switch`; this is the
    one refusal every writer that consults it gives, so a caller branches on one
    code, and that code is distinct from a connection's own read-only grant."""
    if read_only_switch():
        _die(4, "read_only_switch",
             f"{action} is refused: {READ_ONLY_ENV} is set, so {NAME} may read "
             "but change nothing in this process",
             "Do not lift the switch yourself — ask the user; the change has to "
             f"run in a process without {READ_ONLY_ENV}.")


_MACHINE_SCHEMA = "capabilities.machine.v1"


def _machine_state() -> str:
    """This machine's ceiling for this capability: `allowed` or `quarantined`.

    The manager alone writes `$XDG_CONFIG_HOME/capabilities/machine.json`. A
    capability with no entry, and every capability while the file is absent,
    is allowed, so the ceiling only ever closes what the two scopes open."""
    path = _CONFIG_HOME / "capabilities" / "machine.json"
    try:
        data = json.loads(path.read_text())
    except FileNotFoundError:
        return "allowed"
    except (OSError, ValueError) as e:
        _die(6, "bad_machine_state", f"cannot read the machine ceiling {path}: {e}",
             "the manager alone writes it; `capabilities list` reports each "
             "capability's machine state")
    entries = data.get("capabilities") if isinstance(data, dict) else None
    if (not isinstance(data, dict) or data.get("schema") != _MACHINE_SCHEMA
            or not isinstance(entries, dict)):
        _die(6, "bad_machine_state", f"{path} is not a machine ceiling",
             f'expected {{"schema": "{_MACHINE_SCHEMA}", "capabilities": {{...}}}}')
    entry = entries.get(NAME)
    if entry is None:
        return "allowed"
    state = entry.get("state") if isinstance(entry, dict) else None
    if state not in ("allowed", "quarantined"):
        _die(6, "bad_machine_state", f"invalid {NAME} entry in {path}",
             'expected {"state": "allowed"|"quarantined", "at": ..., "by": ...}')
    return state


def _machine_gate() -> None:
    """The ceiling above both scopes: quarantined is disabled everywhere."""
    if _machine_state() == "quarantined":
        _die(4, "quarantined",
             f"{NAME} is quarantined on this machine, so no project and no "
             "machine service may use it, whatever project or global policy says",
             f"ask the user whether to allow {NAME} on this machine; if yes, they "
             f"run `capabilities allow {NAME}` - an agent never lifts a "
             "quarantine itself")


def _gate() -> None:
    """Project policy overrides global policy; absence inherits, and absence at
    both scopes is default deny. Safe local discovery verbs remain available so
    a disabled capability can be understood and configured before use.

    If an ingress supplied CAPABILITIES_AUTH_CONTEXT, that request-scoped gate
    is stricter and runs first, before credentials or network calls. The
    machine ceiling runs next: a capability quarantined on this machine is
    refused before any project or policy row is resolved.

    Under the read-only switch a bundled service is neither set up nor started
    nor handed a new declaration.

    A service that declares `machine` takes `--machine` on its service verbs;
    such a call resolves no project and reads no policy row, because the
    machine service checks each opted-in project's own policy before every
    action it takes for that project. `join` is a project act and always takes
    the ordinary path.

    `migrate` of a capability that declares `TABLES` acts on the machine's
    store rather than for a project, so it too reads no policy row: it answers
    to the machine ceiling, and `migrate` (not `migrate status`) to the
    read-only switch. `migrate files` is the manager's `capabilities migrate`
    moving this capability's files of a project into the store, whether or not
    the project enabled it: it answers to the machine ceiling, and `migrate
    files write` to the read-only switch.

    Machine administration reads no policy row either: it answers to the
    machine ceiling, and its writes to the read-only switch
    (`_machine_administration`).
    """
    _auth_gate()
    verb = sys.argv[1] if len(sys.argv) > 1 else "help"
    safe = verb in {"help", "stub", "manifest", "connections"}
    if not safe:
        _machine_gate()
    service_action = sys.argv[2] if len(sys.argv) > 2 else None
    if verb == "migrate" and service_action == "files":
        if sys.argv[3:4] == ["write"]:
            _read_only_gate(f"`{NAME} migrate files write`")
        return
    if verb == "migrate" and _tables_declared():
        if service_action != "status":
            _read_only_gate(f"`{NAME} migrate`")
        return
    service_contract = globals().get("SERVICE")
    service_call = isinstance(service_contract, dict) and verb == "service"
    machine_service = service_call and isinstance(service_contract.get("machine"), dict)
    if service_call and (service_action in {"init", "start", "run", "reload"}
                         or (machine_service and service_action in {"join", "leave"})):
        _read_only_gate(f"`{NAME} service {service_action}`")
    if machine_service and service_action != "join" and "--machine" in sys.argv[3:]:
        return
    if not safe and _machine_administration():
        return
    if service_call and (service_action in {"init", "start", "run"}
                         or (machine_service and service_action == "join")):
        _require_project_enabled_for_service()
    if safe:
        return
    row = _policy_row()
    entry = row.get("value") if row else None
    scope = row.get("scope") if row else None
    if isinstance(entry, dict) and entry.get("enabled") is True:
        return
    if isinstance(entry, dict) and entry.get("enabled") is False and scope == "project":
        _die(4, "disabled",
             f"{NAME} is disabled in this project ({_policy_source()})",
             f"ask the user whether to enable {NAME} for this project; if yes, "
             f"run `capabilities enable {NAME} --project`")
    if isinstance(entry, dict) and entry.get("enabled") is False:
        message = f"{NAME} is disabled globally ({_policy_source()})"
    else:
        message = f"{NAME} is not enabled by project or global policy"
    _die(4, "not_enabled", message,
         f"ask the user whether to enable {NAME} only for this project or "
         f"globally for every project; then run `capabilities enable {NAME} "
         "--project` or `--global` exactly as requested")


def _invoked_verb() -> str | None:
    """The verb this process was invoked with: its first argument once the
    contract's own `--connection <id>` selection is lifted out of the way."""
    argv = sys.argv[1:]
    i = 0
    while i < len(argv):
        if argv[i] == "--connection":
            i += 2
        elif argv[i].startswith("--connection="):
            i += 1
        else:
            return argv[i]
    return None


def _link_verbs() -> tuple:
    """The verbs that link a connection: the one each `LINK_METHODS` ceremony
    runs, read from its argv."""
    verbs = []
    for method in globals().get("LINK_METHODS") or []:
        argv = method.get("argv") if isinstance(method, dict) else None
        if isinstance(argv, list) and len(argv) > 1 and argv[1] not in verbs:
            verbs.append(argv[1])
    return tuple(verbs)


def _machine_read(verb: str | None = None) -> bool:
    """Whether `verb`, else the invoked one, uses the machine's connections here.

    Outside any project there is no scope a grant could have been written in,
    so a verb the capability declares in `MACHINE_READS`, and a verb that links
    a connection, uses the machine's own connections instead, read-only: a
    connection is linked on the machine before any project is granted it.
    Inside a project the grant model alone decides, and a capability that
    declares neither has none."""
    declared = globals().get("MACHINE_READS")
    declared = declared if isinstance(declared, tuple) else ()
    declared = declared + _link_verbs()
    if not declared:
        return False
    if _project_root() is not None:
        return False
    return (verb if verb is not None else _invoked_verb()) in declared


def _machine_administration() -> bool:
    """Whether this call administers the machine rather than acting for a
    project, so it reads no policy row and answers to the machine ceiling
    alone, its writes to the read-only switch as well.

    Outside any project, a machine read - a verb declared in `MACHINE_READS`,
    a verb that links a connection, and `setup` reporting the machine's
    prerequisites - has no project whose policy it could answer to, and uses
    the machine's connections only read-only. A write to the machine's own
    configuration - `setup set|unset`, and `connection add|remove` at machine
    scope - is administration only when it says so with `--machine`, wherever
    it runs; it is never inferred from where the call runs."""
    verb = _invoked_verb()
    first = sys.argv[1] if len(sys.argv) > 1 else None
    rest = sys.argv[2:]
    if (verb == "setup" == first and "_cmd_setup" in globals()
            and globals().get("SETUP_FIELDS")):
        sub = rest[0] if rest and not rest[0].startswith("--") else "show"
        if sub in ("set", "unset"):
            return "--machine" in rest
        return _project_root() is None
    if (verb == "connection" == first and "_cmd_connection" in globals()
            and globals().get("CONN_FIELDS") is not None):
        return "--machine" in rest
    return _machine_read(verb)


def _policy_state() -> dict:
    """This capability's effective policy, in the words `capabilities list`
    uses: `effective` enabled or disabled, the `source` that decided it -
    `machine` (the ceiling), `project`, `global` or `default` - and the
    `machine` ceiling itself. A record that cannot be read is reported as the
    refusal the gate would give, so the report around it still answers."""
    import contextlib
    import io
    errors = io.StringIO()
    try:
        with contextlib.redirect_stderr(errors):
            machine = _machine_state()
            row = None if machine == "quarantined" else _policy_row()
    except SystemExit:
        lines = errors.getvalue().strip().splitlines()
        try:
            return {"error": json.loads(lines[-1])["error"]}
        except (IndexError, ValueError, KeyError, TypeError):
            return {"error": {"code": "policy_unreadable",
                              "message": errors.getvalue().strip()}}
    if machine == "quarantined":
        return {"effective": "disabled", "source": "machine", "machine": machine}
    if row is None:
        return {"effective": "disabled", "source": "default", "machine": machine}
    return {"effective": "enabled" if row["value"]["enabled"] else "disabled",
            "source": row.get("scope"), "machine": machine}


def _env_dir() -> Path | None:
    """The capability's envelope dir in the project's active capabilities/."""
    root = _project_root()
    return (_project_capabilities_dir(root) / NAME) if root is not None else None


_RECORDS = None
# Who this process writes records as, where it is not the person running it:
# `migrate` while `migrate files` moves the project's files into the store.
_RECORDS_ACTOR = None


def _records():
    """The adapter this project's records are read and written through: the
    project's envelope, then the user's config home; in a project whose
    connections are in store mode, its store for connections and grants, read
    for the project's id. Everything below asks it for a collection, never for
    a path."""
    global _RECORDS
    if _RECORDS is None:
        root = _project_root()
        envelope = (_project_capabilities_dir(root) if root is not None
                    else _CONFIG_HOME / "no-project")
        try:
            project_only = os.environ.get("CAPABILITIES_RECORDS_PROJECT_ONLY", "") \
                .strip().lower() in ("1", "true", "yes", "on")
            in_store = root is not None and connections_mode(envelope) == "store"
            _RECORDS = open_records(
                envelope, _CONFIG_HOME, project_only=project_only,
                project_root=root, project_id=_project_id() if in_store else None,
                application_name=NAME, actor=_RECORDS_ACTOR)
        except StoreError as e:
            _die(5 if e.slug in STORE_ENVIRONMENT_SLUGS else 6, e.slug, e.message, e.hint)
    return _RECORDS


def _project_identity() -> dict:
    root = _project_root()
    if root is None:
        _die(6, "no_project", "no project here to resolve records for")
    identity_file = _project_capabilities_dir(root) / "project.json"
    try:
        identity = json.loads(identity_file.read_text())
    except (OSError, ValueError) as e:
        _die(6, "no_project_identity", f"cannot read {identity_file}: {e}",
             "run `capabilities init` in the project")
    if not identity.get("slug"):
        _die(6, "no_project_identity", f"{identity_file} declares no slug")
    return identity


def _state_dir() -> Path:
    """State follows the scope of the credentials that minted it; project state
    lands inside the envelope only where capabilities/ already exists."""
    if SCOPE == "project":
        root = _project_root()
        if root is not None:
            envelope = _project_capabilities_dir(root)
            if ((envelope / "project.json").is_file()
                    or (envelope / "settings.json").is_file()):
                return envelope / NAME / "state"
    return _STATE_HOME / NAME


# --- Capability contract — the declaration surface --------------------------

def _docs_base() -> str:
    key = f"{NAME.upper()}_DOCS_BASE"
    return (_project_env().get(key)
            or _parse_env_file(CREDENTIALS_ENV).get(key)
            or os.environ.get(key)
            or DOCS_BASE)


def _guide_dir() -> Path:
    executable = Path(__file__).resolve()
    bundle = (executable.parent.parent
              if executable.parent.name == "bin" else executable.parent)
    return bundle / "guides"


def _guide_menu() -> list[dict[str, str]]:
    menu = []
    guide_dir = _guide_dir()
    files = sorted(guide_dir.glob("*.md")) if guide_dir.is_dir() else []
    for path in files:
        lines = path.read_text().splitlines()
        title = ""
        title_index = -1
        for index, line in enumerate(lines):
            if line.startswith("# "):
                title = line[2:].strip()
                title_index = index
                break
        paragraph = []
        for line in lines[title_index + 1:]:
            stripped = line.strip()
            if not stripped:
                if paragraph:
                    break
                continue
            if stripped.startswith("#"):
                break
            paragraph.append(stripped)
        topic = path.stem
        menu.append({
            "topic": topic,
            "title": title,
            "preview": " ".join(paragraph),
            "command": f"{NAME} guide {topic}",
        })
    return menu


def _cmd_guide(argv: list[str]) -> None:
    menu = _guide_menu()
    if not argv:
        _emit(menu); return
    topic = argv[0]
    topics = {entry["topic"] for entry in menu}
    if topic not in topics:
        _die(3, "not_found", f"no guide topic {topic!r}",
             f"run `{NAME} guide` to list available guides")
    import urllib.error as _ue
    import urllib.request as _ur
    url = _docs_base().rstrip("/") + "/" + topic + ".md"
    cache_dir = _STATE_HOME / NAME / "guides"
    cache, etag_f = cache_dir / f"{topic}.md", cache_dir / f"{topic}.etag"
    headers = {}
    if cache.exists() and etag_f.exists():
        headers["If-None-Match"] = etag_f.read_text().strip()
    try:
        req = _ur.Request(url, headers=headers)
        with _ur.urlopen(req, timeout=10.0) as resp:
            text = resp.read().decode(resp.headers.get_content_charset() or "utf-8")
            cache_dir.mkdir(parents=True, exist_ok=True)
            cache.write_text(text)
            if resp.headers.get("etag"):
                etag_f.write_text(resp.headers["etag"])
            _emit(text); return
    except _ue.HTTPError as e:
        if e.code == 304 and cache.exists():
            _emit(cache.read_text()); return
        if e.code == 404:
            _die(3, "not_found", f"guide {topic!r} missing upstream", url)
        err = f"upstream returned {e.code}"
    except _ue.URLError as e:
        err = str(e.reason)
    except OSError as e:
        err = str(e)
    if cache.exists():
        sys.stderr.write(json.dumps(
            {"warning": f"upstream unreachable; serving cached copy ({err})"},
            ensure_ascii=False) + "\n")
        _emit(cache.read_text()); return
    _die(5, "network_error", f"could not fetch guide {topic!r}; no cache exists", url)


def _render_ids_markdown(data: dict) -> str:
    """Render the {label: {value, note}} envelope as the labelled markdown
    list the manager's `capabilities ids <NAME>` also produces — one shared
    format across the ids surface and the identifiers section of `help`."""
    lines: list[str] = []
    for label, entry in sorted(data.items()):
        entry = entry if isinstance(entry, dict) else {"value": entry}
        v = entry.get("value")
        vs = f"`{v}`" if isinstance(v, str) else "`" + json.dumps(v, ensure_ascii=False) + "`"
        line = f"- **{label}**: {vs}"
        note = entry.get("note")
        if note:
            line += f" — {note}"
        lines.append(line)
    return "\n".join(lines)


def _identifiers_load() -> dict:
    """The identifiers envelope, resolved through the records adapter, in one
    shape — `{label: {value, note, scope}}` — for the help section, the report
    and `ids get`; `scope` names where the value came from, `project` or
    `global`."""
    try:
        resolved = _records().resolve(NAME, "identifier")
    except StoreError as e:
        _die(5 if e.slug in STORE_ENVIRONMENT_SLUGS else 6, e.slug, e.message, e.hint)
    return {label: {"note": row["note"] or "", "value": row["value"],
                    "scope": row["scope"]}
            for label, row in sorted(resolved.items())}


def _identifiers_scope(scope: str) -> dict:
    """The identifiers one scope holds itself, without inheritance."""
    try:
        return _records().resolve_scope(NAME, "identifier", scope)
    except StoreError as e:
        _die(5 if e.slug in STORE_ENVIRONMENT_SLUGS else 6, e.slug, e.message, e.hint)


def _identifiers_stamp(scope: str) -> None:
    """A project row in the store carries the project id as its agent, so it
    is written only once the id is verified for this invocation."""
    if scope == "project" and _records().mode_of("identifier") == "store":
        _project_id(write=True)


def _identifiers_write(label: str, value, note: str, scope: str = "project") -> None:
    """Rule 15: a capability is the sole writer of its own identifiers,
    addressed by (capability, collection) rather than by path."""
    _identifiers_stamp(scope)
    kept = note or ((_identifiers_scope(scope).get(label) or {}).get("note") or "")
    try:
        _records().set(NAME, "identifier", label, value,
                       actor=f"{NAME} ids set", note=kept or None, scope=scope)
    except StoreError as e:
        _die(5 if e.slug in STORE_ENVIRONMENT_SLUGS else 6, e.slug, e.message, e.hint)


def _identifiers_remove(label: str, scope: str = "project") -> None:
    _identifiers_stamp(scope)
    try:
        _records().delete(NAME, "identifier", label, scope=scope)
    except StoreError as e:
        _die(5 if e.slug in STORE_ENVIRONMENT_SLUGS else 6, e.slug, e.message, e.hint)


def _identifiers_section() -> str:
    """The Identifiers block appended to the bare top-level help — deterministic
    first-touch surfacing of `capabilities/<NAME>/identifiers.json` so an
    agent following the `<NAME> help` startup protocol loads the discovered
    labels/values/notes into context at once. Empty when no project envelope
    or nothing recorded (do not bloat help with an empty section)."""
    data = _identifiers_load()
    if not data:
        return ""
    header = (
        "\n═══ Identifiers ═════════════════════════════════════════════════════════════\n\n"
        f"Structural lookups discovered for `{NAME}` in this project. Fetch a single\n"
        f"raw value with `{NAME} ids get <label>`; the full envelope is also at\n"
        f"`capabilities ids {NAME}`.\n\n"
    )
    return header + _render_ids_markdown(data) + "\n"


def _connections_home_section() -> str:
    """Where the connections this help describes are kept, for the project it
    is run in - rendered from the project's connections mode, so help names
    the home the resolver reads rather than one it may not. Empty for a
    capability without the connections tier. Reads `project.json` only and
    never reaches the store, so help stays local."""
    if "_resolve_env_key" not in globals():
        return ""
    machine = _CONFIG_HOME / NAME / "connections.json"
    header = (
        "\n═══ Where connections live ══════════════════════════════════════════════════\n\n")
    reported = f"`{NAME} connections` names where each value resolves from.\n"
    root = _project_root()
    if root is None:
        return (header + "There is no project here, so connections are read from the "
                "machine's\n"
                f"  {machine}\n" + reported)
    envelope = _project_capabilities_dir(root)
    try:
        mode = connections_mode(envelope)
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)
    if mode == "store":
        return (header + "This project keeps its connections in its store, not in "
                "files: each\n"
                "connection is a row of the store's `capabilities_connections` table, "
                "and\n"
                "this project's grant on it a row of `capabilities_connection_grants`.\n"
                "No connections.json, the project's or the machine's, is read for this "
                "project.\n" + reported)
    return (header + "This project keeps its connections in files: its own\n"
            f"  {envelope / NAME / 'connections.json'}\n"
            "then, for a connection id the project does not declare itself, the "
            "machine's\n"
            f"  {machine}\n"
            "used here once this project grants it.\n" + reported)


def _cmd_help() -> None:
    """Bare top-level help: the CLI's HELP body (module-level `HELP` if
    defined, else the module docstring), then where this project keeps the
    capability's connections, then the project's Identifiers section. Only
    fires when no extra args follow — per-verb help stays untouched so
    `<NAME> help <subcommand>` is not intercepted."""
    g = globals()
    text = g.get("HELP") or g.get("__doc__") or ""
    if text.startswith("\n"):
        text = text.lstrip("\n")
    sys.stdout.write(text)
    if text and not text.endswith("\n"):
        sys.stdout.write("\n")
    home = _connections_home_section()
    if home:
        sys.stdout.write(home)
    declared = _declared_section()
    if declared:
        sys.stdout.write(declared)
    section = _identifiers_section()
    if section:
        sys.stdout.write(section)


def _field_line(field: dict, scoped: bool = False) -> str:
    """One declared field or setting as help prints it."""
    kind = field.get("type") or "string"
    if kind == "enum":
        kind = "|".join(field.get("choices") or [])
    traits = [kind, "required" if field.get("required") else "optional"]
    if field.get("secret"):
        traits.append("secret, stdin only" + (f", kept as {field['env']}" if field.get("env") else ""))
    if field.get("default") is not None:
        traits.append(f"default {json.dumps(field['default'])}")
    if scoped:
        traits = [kind]
        if field.get("default") is not None:
            traits.append(f"default {json.dumps(field['default'])}")
        traits.append({"reload": "a running service takes it on `service reload`",
                       "restart": "a running service takes it on a restart",
                       "next_call": "read on the next call"}.get(field.get("apply"), ""))
        return (f"    {field['key']} @{field.get('scope')} ({', '.join(t for t in traits if t)})"
                f" - {field.get('help', '')}\n")
    return f"    {field['key']} ({', '.join(traits)}) - {field.get('help', '')}\n"


def _declared_section() -> str:
    """The verbs the contract answers from this capability's declarations -
    `connection`, `setup`, `settings` and the linking methods - rendered from
    the declarations themselves, so help and behaviour cannot part."""
    conns = _connections_declaration()
    settings = _settings_declaration()
    out = ""
    if conns and conns.get("fields") is not None:
        out += (f"\n## Connections, written through the contract\n\n"
                f"  {NAME} connection add <id> [--project|--global|--machine] [--default] "
                "[--replace] [--field KEY=VALUE ...] [--env KEY=ENV_KEY ...] [--stdin]\n"
                "      Write one connection from the fields below. --project (the default)\n"
                "      writes this project's record, --global the machine's, and --machine\n"
                "      the machine's as administration of the machine: from anywhere, with\n"
                "      no project or global policy read. A secret field is\n"
                "      taken only from the JSON object on stdin (--stdin), never from argv, and\n"
                "      written to that scope's credentials file - the project's .env.local, or\n"
                f"      {CREDENTIALS_ENV} - under its own env key, which the\n"
                "      entry names. --env KEY=ENV_KEY instead names, for a secret field, a\n"
                "      key already set in the cascade, and writes no value for it (exit 6\n"
                "      env_key_unset where it resolves nowhere). A connection that exists\n"
                "      is refused (exit 6 connection_exists) unless --replace is given; it\n"
                "      then keeps every field not given, and null in the JSON object clears\n"
                "      one. --default\n"
                "      points the scope's default at it. Answers the fields as they now\n"
                "      resolve, secrets masked.\n"
                f"  {NAME} connection remove <id> [--project|--global|--machine]\n"
                "      Remove it, its default pointer, and the secret lines `connection add`\n"
                "      wrote for it; a key another connection names is kept. Refused (exit 6\n"
                "      connection_granted) while a project is granted it, naming each one.\n")
        out += "  Fields:\n" + ("".join(_field_line(f) for f in conns["fields"])
                                or "    none - an entry carries no fields of its own\n")
    if conns and conns.get("setup"):
        out += (f"\n## Machine setup, written through the contract\n\n"
                f"  {NAME} setup [show] | setup set [--machine] [--field KEY=VALUE ...] "
                "[--stdin] | setup unset [--machine] <KEY> ...\n"
                "      What this machine is given once, before any connection, kept in\n"
                f"      {CREDENTIALS_ENV}; `show` says where each resolves\n"
                "      from, secrets masked, and outside any project reads no policy. A secret\n"
                "      is taken only from the JSON object on stdin. --machine writes as\n"
                "      administration of the machine: from anywhere, with no policy read.\n")
        out += "".join(_field_line(f) for f in conns["setup"])
    if conns and conns.get("link"):
        out += ("\n## Linking a connection\n\n"
                "  Each method runs with --connection <id> added, speaks JSON lines on stdout -\n"
                "  one object per line naming its `event`: qr {payload, expires?, refreshed},\n"
                "  pairing_code {code, phone}, phone_needed, code_needed {phone, retry},\n"
                "  password_needed {hint, retry}, linked, progress, then done {result} or\n"
                "  error {exit, error} - and reads the answer to each *_needed event as one\n"
                "  line on stdin. The exit code is the one the method has without --events.\n")
        for method in conns["link"]:
            out += (f"  {' '.join(method.get('argv') or [])}\n"
                    f"      {method.get('label', '')}: {method.get('help', '')}\n")
    if settings:
        out += (f"\n## Settings, read and written through the contract\n\n"
                f"  {NAME} settings [show] [--scope S]\n"
                "      Every settings document, whole, with the declared keys below resolved.\n"
                f"  {NAME} settings get <key> | set <key> <value> | unset <key> [--scope S]\n"
                "      One key, dotted for a nested one; <value> is read as JSON, else as text.\n"
                f"  {NAME} settings put [--scope S] < document.json\n"
                "      Replace one scope's document whole.\n"
                "      A write is checked as the capability reads it before it replaces the file\n"
                "      (exit 6 settings_invalid otherwise); a TOML file is rewritten from its\n"
                "      content, so its comments are not kept. S is the scope a key is declared\n"
                "      at, else the only one; homes:\n")
        for home in settings["homes"]:
            base = ("<envelope>/" + NAME if home["scope"] == "project"
                    else str(_CONFIG_HOME / NAME))
            out += (f"    {home['scope']}: {base}/{home['path']} ({home['format']})"
                    + (f", inheriting {home['inherits']} key by key" if home.get("inherits") else "")
                    + "\n")
        if settings["keys"]:
            out += "  Declared keys:\n" + "".join(_field_line(k, scoped=True) for k in settings["keys"])
    return out


def _cmd_ids(argv: list[str]) -> None:
    sub = argv[0] if argv else "list"
    scope = "project"
    if sub in ("set", "rm") and "--global" in argv[1:]:
        argv = [a for a in argv if a != "--global"]
        scope = "global"
    data = _identifiers_load()
    if sub == "list":
        _emit(data); return
    if sub == "get":
        if len(argv) < 2 or argv[1] not in data:
            _die(3, "not_found", "unknown identifier label",
                 f"`{NAME} ids list` shows the labels")
        _emit((data[argv[1]] or {}).get("value")); return
    if sub in ("set", "rm"):
        _read_only_gate(f"`{NAME} ids {sub}`")
    if sub == "set":
        if len(argv) < 3:
            _die(6, "input", f"usage: {NAME} ids set <label> <value> [--note <text>] [--global]")
        label, raw = argv[1], argv[2]
        try:
            value = json.loads(raw)
        except ValueError:
            value = raw
        note = ""
        if "--note" in argv:
            ni = argv.index("--note")
            if ni + 1 >= len(argv):
                _die(6, "input", "--note needs a value")
            note = argv[ni + 1]
        _identifiers_write(label, value, note, scope)
        _emit({"set": label} if scope == "project" else {"set": label, "scope": scope})
        return
    if sub == "rm":
        held = data if scope == "project" else _identifiers_scope(scope)
        if len(argv) < 2 or argv[1] not in held:
            _die(3, "not_found", "unknown identifier label",
                 f"`{NAME} ids list` shows the labels")
        _identifiers_remove(argv[1], scope)
        _emit({"removed": argv[1]} if scope == "project"
              else {"removed": argv[1], "scope": scope})
        return
    _die(6, "input", f"unknown ids subcommand {sub!r}", f"{NAME} ids list|get|set|rm")


REFERENCE_PREFIX = "reference."


def _front_matter(body: str) -> tuple[str | None, str | None]:
    """`name` and `description` out of a reference's leading front matter."""
    lines = body.splitlines()
    if not lines or lines[0].strip() != "---":
        return None, None
    name = desc = None
    for line in lines[1:30]:
        if line.strip() == "---":
            break
        if line.startswith("name:"):
            name = line.split(":", 1)[1].strip()
        elif line.startswith("description:"):
            desc = line.split(":", 1)[1].strip()
    return name, desc


def _reference_bodies() -> dict[str, str]:
    """Every reference this project can see, keyed by its document key."""
    out: dict[str, str] = {}
    try:
        adapter = _records()
        for key in adapter.document_keys(NAME):
            if not key.startswith(REFERENCE_PREFIX):
                continue
            doc = adapter.document_read(NAME, key)
            if doc:
                out[key] = doc["body"]
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)
    return out


def _cmd_refs(argv: list[str] | None = None) -> None:
    """`refs` lists what this project can load; `refs show <name>` prints one.

    The listing carries each reference's path; `refs show` prints a body."""
    argv = argv or []
    bodies = _reference_bodies()
    adapter = _records()
    entries = []
    for key, body in sorted(bodies.items()):
        name, desc = _front_matter(body)
        if not name:
            continue
        entry = {"name": name, "description": desc or "", "key": key}
        # A path when there is one to open, a source when there is not. The
        # adapter answers that; the listing does not ask where it lives.
        path = adapter.document_path(NAME, key)
        if path is None:
            entry["source"] = adapter.source
        else:
            entry["path"] = str(path)
        entries.append((name, entry, body))

    if argv and argv[0] == "show":
        if len(argv) < 2:
            _die(6, "input", f"usage: {NAME} refs show <name>")
        wanted = argv[1]
        for name, entry, body in entries:
            if wanted in (name, entry["key"], entry["key"][len(REFERENCE_PREFIX):]):
                sys.stdout.write(body if body.endswith("\n") else body + "\n")
                return
        _die(3, "not_found", f"no reference named {wanted!r}",
             f"`{NAME} refs` lists them")
    if argv:
        _die(6, "input", f"unknown refs subcommand {argv[0]!r}", f"{NAME} refs [show <name>]")
    _emit([entry for _name, entry, _body in entries])


def _context_edit_files(key: str) -> tuple[Path, Path]:
    token = hashlib.sha256(f"{NAME}\0{key}".encode()).hexdigest()[:16]
    root = _state_dir() / "record-edits"
    return root / f"{token}.md", root / f"{token}.json"


def _cmd_context(argv: list[str]) -> None:
    """Read or edit project long text without exposing its backend."""
    sub = argv[0] if argv else "list"
    adapter = _records()
    if sub == "list":
        _emit({"documents": adapter.document_keys(NAME),
               "records": {"mode": adapter.mode, "source": adapter.source}})
        return
    if len(argv) < 2:
        _die(6, "input", f"usage: {NAME} context show|edit|put <key>")
    key = argv[1]
    if sub in ("edit", "put"):
        _read_only_gate(f"`{NAME} context {sub}`")
    if sub == "show":
        doc = adapter.document_read(NAME, key)
        if doc is None:
            _die(3, "not_found", f"no context document {key!r}",
                 f"`{NAME} context list` shows the keys")
        sys.stdout.write(doc["body"] if doc["body"].endswith("\n")
                         else doc["body"] + "\n")
        return
    work, meta = _context_edit_files(key)
    if sub == "edit":
        doc = adapter.document_read(NAME, key)
        direct = adapter.document_path(NAME, key)
        base = doc["hash"] if doc else None
        path = direct or work
        if direct is None:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(doc["body"] if doc else "")
        meta.parent.mkdir(parents=True, exist_ok=True)
        meta.write_text(json.dumps({"key": key, "path": str(path),
                                    "base": base, "direct": direct is not None},
                                   ensure_ascii=False, indent=2) + "\n")
        _emit({"key": key, "path": str(path), "base": base,
               "records": {"mode": adapter.mode, "source": adapter.source},
               "next": f"edit the path, then run `{NAME} context put {key}`"})
        return
    if sub == "put":
        try:
            checkout = json.loads(meta.read_text())
        except (OSError, ValueError) as exc:
            _die(6, "edit_not_started",
                 f"no valid edit checkout for {key!r}: {exc}",
                 f"run `{NAME} context edit {key}` first")
        if checkout.get("key") != key:
            _die(6, "edit_mismatch", f"edit checkout does not belong to {key!r}")
        path = Path(str(checkout.get("path") or ""))
        try:
            body = path.read_text()
            version = adapter.document_put(
                NAME, key, body, author=f"{NAME} context put",
                media_type="text/markdown", base=checkout.get("base"))
        except OSError as exc:
            _die(6, "edit_unreadable", f"cannot read edit path {path}: {exc}")
        except StoreError as exc:
            _die(6, exc.slug, exc.message, exc.hint)
        meta.unlink(missing_ok=True)
        if not checkout.get("direct"):
            path.unlink(missing_ok=True)
        _emit({"put": key, "version": version,
               "records": {"mode": adapter.mode, "source": adapter.source}})
        return
    _die(6, "input", f"unknown context subcommand {sub!r}",
         f"{NAME} context list|show|edit|put")


INVENTORY_NETWORK_MODES = ("none", "optional", "required")


def _inventory_declaration() -> dict | None:
    """The manifest's `inventory` block, derived from the INVENTORY constant.

    `None` says the capability has nothing of its own to report here, so a
    reader assembling a whole project knows before it asks; the verb still
    answers, with the empty envelope, so nothing branches on absence."""
    if not INVENTORY:
        return None
    network = INVENTORY.get("network", "none")
    return {"network": network if network in INVENTORY_NETWORK_MODES else "none"}


def _cmd_inventory(argv: list[str]) -> None:
    """What this capability holds in this project, in one shape for all of them.

    The read is local, secret-free, and leaves nothing changed behind it.
    `--network` is the caller's explicit consent to reach the remote system for
    detail a local read cannot supply; without it that detail is named in
    `deferred` rather than fetched, so assembling a whole project never waits
    on a network the caller did not choose. `--json` is accepted for
    explicitness; the output is always this JSON."""
    network = False
    for arg in argv:
        if arg == "--network":
            network = True
        elif arg != "--json":
            _die(6, "input", f"unknown inventory option {arg!r}",
                 f"{NAME} inventory [--network]")
    root = _project_root()
    report: dict = {"capability": NAME,
                    "project": str(root) if root is not None else None,
                    "network": network,
                    "metrics": [], "items": [], "service": None, "deferred": []}
    if INVENTORY:
        built = _inventory(network) or {}
        for field in ("metrics", "items", "deferred"):
            report[field] = list(built.get(field) or [])
        report["service"] = built.get("service")
    _emit(report)


# A store setting that cannot be used is a configuration fault; a store that
# cannot be reached, is busy, or refuses the migration is the environment's.
_STORE_SETTING_SLUGS = frozenset({
    "store_not_configured", "store_not_postgres", "store_setting_unreadable",
    "store_setting_too_new", "bad_store_setting", "sslmode_too_weak",
    "bad_schema_name", "driver_missing"})


def _tables_declared() -> bool:
    """Whether the capability keeps tables in the machine's store (`TABLES`)."""
    return bool(globals().get("TABLES"))


def _cmd_migrate(argv: list[str]) -> None:
    """`migrate` applies the capability's pending steps to its tables in the
    machine's store, through the shared database library and under its lock;
    `migrate status` reports where they stand, without a lock, changing nothing.
    The manager runs `migrate` when it installs or updates the payload, and a
    service runs it when it starts."""
    if argv not in ([], ["status"]):
        _die(6, "input", f"unknown migrate arguments {' '.join(argv)!r}",
             f"{NAME} migrate [status]")
    steps, major, minor = _tables()
    try:
        from capabilities_contract import db
    except ImportError:
        _die(6, "driver_missing",
             "the shared database library capabilities-contract is not installed",
             f"run {NAME} through its own script header, which pins it")
    conn = None
    try:
        conn = db.connect(application_name=NAME, transaction=True)
        if argv:
            found = db.status(conn, NAME, steps, major=major, minor=minor)
            stored = (None if found.stored_major is None
                      else {"major": found.stored_major, "minor": found.stored_minor})
            report = {"owner": found.owner, "schema": found.schema, "state": found.state,
                      "code": {"major": found.major, "minor": found.minor},
                      "store": stored, "applied": found.applied,
                      "pending": found.pending, "changed": found.changed,
                      "warnings": found.warnings}
        else:
            done = db.migrate(conn, NAME, steps, major=major, minor=minor)
            report = {"owner": done.owner, "schema": done.schema,
                      "applied": done.applied, "skipped": done.skipped,
                      "version": {"major": done.major, "minor": done.minor},
                      "warnings": done.warnings}
    except db.DbError as exc:
        _die(6 if exc.slug in _STORE_SETTING_SLUGS else 5, exc.slug, exc.message, exc.hint)
    finally:
        if conn is not None:
            conn.close()
    _emit(report)


# What `migrate files plan` reads its tables through: one connection per
# database, held in one transaction that is never committed, in which the
# steps of any table a migration would make or bring forward are run, so the
# capability reads the store as an upgrade would leave it, and the transaction
# is rolled back when the plan ends. The steps it ran, by owner.
_PLAN_LINKS: dict = {}
_PLAN_RAN: set = set()
_PLAN_PENDING: dict = {}


class _PlanConnection:
    """A connection of a plan: the database's one plan link, where a commit
    keeps what the caller did for the rest of the plan and a rollback or a
    close undoes what it did since, and nothing ever reaches the store."""

    _OWN = ("_real", "_setting", "_closed", "row_factory")

    def __init__(self, real, setting):
        object.__setattr__(self, "_real", real)
        object.__setattr__(self, "_setting", setting)
        object.__setattr__(self, "_closed", False)
        object.__setattr__(self, "row_factory", None)

    def __getattr__(self, name: str):
        return getattr(self._real, name)

    def __setattr__(self, name: str, value) -> None:
        if name in self._OWN:
            object.__setattr__(self, name, value)
        elif name != "autocommit":
            setattr(self._real, name, value)

    @property
    def autocommit(self) -> bool:
        return False

    @property
    def closed(self) -> bool:
        return self._closed or self._real.closed

    def cursor(self, *args, **kwargs):
        if self.row_factory is not None:
            kwargs.setdefault("row_factory", self.row_factory)
        return self._real.cursor(*args, **kwargs)

    def execute(self, query, params = None, **kwargs):
        return self.cursor().execute(query, params, **kwargs)

    def transaction(self, *args, **kwargs):
        return self._real.transaction(*args, **kwargs)

    def commit(self) -> None:
        self._real.execute("RELEASE SAVEPOINT capabilities_plan")
        self._real.execute("SAVEPOINT capabilities_plan")

    def rollback(self) -> None:
        if not self._real.closed:
            self._real.execute("ROLLBACK TO SAVEPOINT capabilities_plan")

    def close(self) -> None:
        if not self._closed:
            self.rollback()
        object.__setattr__(self, "_closed", True)

    def __enter__(self) -> "_PlanConnection":
        return self

    def __exit__(self, kind, *exc) -> None:
        if not self._closed:
            if kind is None:
                self.commit()
            self.close()


def _plan_store() -> None:
    """Make every connection this process opens through the shared database
    layer a plan connection, and every migration on one a step run inside the
    plan's transaction and recorded under its owner, never committed: a plan
    creates and upgrades nothing, whatever tables the capability reaches."""
    try:
        from capabilities_contract import db
    except ImportError:
        return
    real_connect, real_migrate, real_status = db.connect, db.migrate, db.status

    def plan_connect(*, application_name: str, project_root = None,
                     setting = None, **kwargs):
        # A plan holds one transaction open on its link for the whole run, so
        # the link is a session connection whichever kind the caller asked for.
        kwargs.pop("transaction", None)
        setting = setting if setting is not None else db.resolve_setting(project_root)
        key = (repr(sorted(setting.connect_kwargs().items())), setting.schema)
        link = _PLAN_LINKS.get(key)
        if link is None or link.closed or link.broken:
            link = real_connect(application_name=application_name, setting=setting, **kwargs)
            link.execute("SET TRANSACTION READ WRITE")
            link.execute("SET LOCAL lock_timeout = '5s'")
            link.execute("SAVEPOINT capabilities_plan")
            _PLAN_LINKS[key] = link
        return _PlanConnection(link, setting)

    def held(conn, owner: str, steps, major: int, minor: int, schema):
        fresh = real_connect(application_name=NAME, setting=conn._setting)
        try:
            return real_status(fresh, owner, steps, major=major, minor=minor,
                               schema=schema or conn._setting.schema)
        finally:
            fresh.close()

    def plan_status(conn, owner: str, steps, *, major: int, minor: int,
                    schema = None):
        if not isinstance(conn, _PlanConnection):
            return real_status(conn, owner, steps, major=major, minor=minor, schema=schema)
        found = held(conn, owner, list(steps), major, minor, schema)
        found.pending = [s for s in found.pending if (id(conn._real), owner, s) not in _PLAN_RAN]
        if found.state == "pending" and not found.pending:
            found.state = "current"
        return found

    def plan_migrate(conn, owner: str, steps, *, major: int, minor: int,
                     schema = None):
        if not isinstance(conn, _PlanConnection):
            return real_migrate(conn, owner, steps, major=major, minor=minor, schema=schema)
        steps = list(steps)
        found = held(conn, owner, steps, major, minor, schema)
        if found.state in ("checksum_mismatch", "schema_too_new"):
            raise db.DbError(found.state, f"the store's {owner} tables cannot be brought to "
                             f"{major}.{minor}: {found.state}")
        if found.pending:
            _PLAN_PENDING[owner] = {
                "from": None if found.stored_major is None
                else f"{found.stored_major}.{found.stored_minor}",
                "to": f"{major}.{minor}", "steps": list(found.pending)}
        by_id = {}
        for step in steps:
            ident, text = (step.id, step.sql) if hasattr(step, "sql") else (step[0], step[1])
            by_id[ident] = text
        for ident in found.pending:
            if (id(conn._real), owner, ident) in _PLAN_RAN:
                continue
            try:
                with conn._real.transaction():
                    conn._real.execute(by_id[ident])
            except Exception as exc:
                raise db.DbError("step_failed", f"step {ident} of {owner} could not be "
                                 f"planned: {exc}") from None
            _PLAN_RAN.add((id(conn._real), owner, ident))
        # What the steps made stays for the rest of the plan, whichever
        # connection of it rolls back later.
        conn._real.execute("RELEASE SAVEPOINT capabilities_plan")
        conn._real.execute("SAVEPOINT capabilities_plan")
        return db.MigrateResult(owner=owner, schema=schema or conn._setting.schema,
                                skipped=list(found.applied), major=major, minor=minor)

    db.connect, db.migrate, db.status = plan_connect, plan_migrate, plan_status
    here = globals()
    here["_HOLD_RECORDS_CONNECTION"] = True
    for name, value in list(here.items()):
        for real, planned in ((real_connect, plan_connect), (real_migrate, plan_migrate),
                              (real_status, plan_status)):
            if value is real:
                here[name] = planned


MIGRATE_FILES_ACTIONS = ("plan", "write", "verify")


def _cmd_migrate_files(argv: list[str]) -> None:
    """`migrate files plan|write|verify [--answers FILE]` moves this
    capability's own configuration files of the project into the store, for
    the manager's `capabilities migrate`, which runs it on the agent's master
    and owns the order: `plan` says what would be written and every question
    code cannot answer, writing nothing; `write` writes it, leaving the files
    for the manager to archive and remove; `verify` reads it back and says
    whether the store now holds what the files said. The capability's own
    `_migrate_files_mover(action, answers, all_answers)`, outside the fences,
    does the moving and returns its report: `items`, `questions`, `files` (the
    ones it consumed), `verified` and whatever else it names; a capability
    without one moves nothing here. `--answers` is the person's recorded
    answers as JSON, keyed by capability. Every record or setting written here
    is the migration's own (`migrate@<node>`). `plan` changes nothing in the
    store, tables included: a table it would make or bring forward is made or
    brought forward only inside a transaction that is rolled back, and its
    steps are named under `tables_to_upgrade` by owner."""
    global _RECORDS_ACTOR
    action = argv[0] if argv else ""
    rest = argv[1:]
    answers: dict = {}
    if rest[:1] == ["--answers"] and len(rest) == 2:
        try:
            answers = json.loads(Path(rest[1]).read_text())
        except (OSError, ValueError) as e:
            _die(6, "input", f"cannot read the answers file {rest[1]}: {e}")
        if not isinstance(answers, dict):
            _die(6, "input", f"the answers file {rest[1]} must hold a JSON object")
    elif rest:
        _die(6, "input", f"unknown migrate files arguments {' '.join(rest)!r}",
             f"{NAME} migrate files plan|write|verify [--answers FILE]")
    if action not in MIGRATE_FILES_ACTIONS:
        _die(6, "input", f"migrate files needs one of {', '.join(MIGRATE_FILES_ACTIONS)}",
             f"{NAME} migrate files plan|write|verify [--answers FILE]")
    if _project_root() is None:
        _die(6, "no_project", "migrate files moves a project's files, and this is not one",
             "run it in the project; `capabilities migrate` does")
    _RECORDS_ACTOR = "migrate"
    if action == "plan":
        # A plan writes nothing, the capability's tables included: it reads
        # them as an upgrade would leave them and names the steps instead.
        _plan_store()
    mover = globals().get("_migrate_files_mover")
    report = {"capability": NAME, "action": action, "mover": callable(mover),
              "items": [], "questions": [], "files": [], "warnings": []}
    if callable(mover):
        mine = answers.get(NAME) if isinstance(answers.get(NAME), dict) else {}
        report.update(mover(action, mine, answers) or {})
    if _PLAN_PENDING:
        report["tables_to_upgrade"] = dict(_PLAN_PENDING)
    if action == "verify":
        report.setdefault("verified", True)
    _emit(report)


MACHINE_READ_EFFECT = ("outside any project these verbs use the machine's own "
                       "connections, read-only; inside a project its grants "
                       "alone decide")


def _cmd_connections_reported() -> None:
    """The capability's own connections report, with what the contract knows
    beside it. The report stays the capability's: it is taken whole, and the
    capability's effective policy state is added to it. Under the read-only
    switch every connection in it is marked read-only and the switch is named
    beside it, so a reader sees why no connection may write; in a machine read
    each connection the machine lent is named as the machine's, read-only."""
    import contextlib
    import io
    captured = io.StringIO()
    try:
        with contextlib.redirect_stdout(captured):
            _cmd_connections()
    except SystemExit:
        sys.stdout.write(captured.getvalue())
        raise
    try:
        report = json.loads(captured.getvalue())
    except ValueError:
        report = None
    if not isinstance(report, dict):
        sys.stdout.write(captured.getvalue())
        return
    conns = report.get("connections")
    conns = conns if isinstance(conns, dict) else {}
    if read_only_switch():
        for entry in conns.values():
            if isinstance(entry, dict):
                entry["allow_write"] = False
        report["read_only_switch"] = {
            "variable": READ_ONLY_ENV, "on": True,
            "effect": READ_ONLY_EFFECT}
    lent = globals().get("_MACHINE_LENT") or {}
    if lent:
        for cid in lent:
            if isinstance(conns.get(cid), dict):
                conns[cid]["allow_write"] = False
        report["machine_reads"] = {
            "verbs": list(MACHINE_READS),
            "connections": {cid: {"scope": "machine", "source": source}
                            for cid, source in sorted(lent.items())},
            "effect": MACHINE_READ_EFFECT}
    report["policy"] = _policy_state()
    _emit(report)


# --- Declared connection fields, setup, linking and settings -----------------
#
# What a person is asked for is declared once, at the top of the script, so any
# reader - `manifest`, an agent, a control panel - renders it without knowing
# the capability. Each declaration is optional and read with `globals().get`,
# so a script that declares none still runs:
#   CONN_FIELDS   a connection entry's own fields, one dict per field
#   SETUP_FIELDS  what the machine is given once, before any connection
#   LINK_METHODS  the interactive ceremonies that link a connection
#   SETTINGS      where the capability's settings live, and the keys it declares

FIELD_TYPES = ("string", "integer", "number", "boolean", "url", "email",
               "phone", "path", "enum", "list", "object")
SETTING_SCOPES = ("project", "global", "machine")
SETTING_APPLY = ("next_call", "reload", "restart")
SETTING_FORMATS = ("json", "toml")
LINK_EVENTS = ("qr", "pairing_code", "phone_needed", "code_needed",
               "password_needed", "progress", "linked", "done", "error")


def _connections_declaration() -> dict | None:
    """The `connections` manifest entry: null for a capability without the
    connections tier; `fields` null where the capability declares none yet."""
    if "_resolve_env_key" not in globals():
        return None
    fields = globals().get("CONN_FIELDS")
    return {"fields": [dict(f) for f in fields] if fields is not None else None,
            "setup": [dict(f) for f in (globals().get("SETUP_FIELDS") or [])],
            "link": [dict(m) for m in (globals().get("LINK_METHODS") or [])]}


def _settings_declaration() -> dict | None:
    """The `settings` manifest entry: null when the capability keeps none."""
    declared = globals().get("SETTINGS")
    if not declared:
        return None
    return {"homes": [dict(h) for h in (declared.get("homes") or [])],
            "keys": [dict(k) for k in (declared.get("keys") or [])]}


def _manifest_core() -> dict:
    """The declaration every capability's manifest carries. A capability that
    adds to its manifest - a service, a contribution - starts from this, so the
    shared part has one home."""
    return {"name": NAME, "summary": SUMMARY,
            "credentials": {"scope": SCOPE, "keys": CRED_KEYS},
            "docs": {"base": DOCS_BASE,
                     "topics": [entry["topic"] for entry in _guide_menu()]},
            "state": STATE, "inventory": _inventory_declaration(),
            "post_install": POST_INSTALL, "tables": _tables_declared(),
            "connections": _connections_declaration(),
            "settings": _settings_declaration(),
            "migrate_files": callable(globals().get("_migrate_files_mover"))}


def _field_value(field: dict, raw, from_argv: bool = False):
    """One declared field's value, checked against its type. A value given on
    argv arrives as text and is read as the type would write it; a value from
    a JSON document arrives typed. Raises ValueError naming what is wrong."""
    import re as _re
    kind = field.get("type") or "string"
    key = field.get("key")
    if kind in ("string", "url", "email", "phone", "path", "enum"):
        if not isinstance(raw, str) or (field.get("required") and not raw.strip()):
            raise ValueError(f"{key} is text")
        value = raw.strip()
        if kind == "url" and not _re.match(r"https?://[^/\s]+", value):
            raise ValueError(f"{key} is an http(s) URL")
        if kind == "email" and not _re.fullmatch(r"[^@\s]+@[^@\s]+", value):
            raise ValueError(f"{key} is an email address")
        if kind == "phone" and not _re.fullmatch(r"\+?[0-9][0-9 ()-]{4,}", value):
            raise ValueError(f"{key} is a phone number, digits with an optional +")
        if kind == "enum" and value not in (field.get("choices") or []):
            raise ValueError(f"{key} is one of: {', '.join(field.get('choices') or [])}")
        return value
    if kind in ("integer", "number"):
        value = raw
        if from_argv and isinstance(raw, str):
            try:
                value = int(raw) if kind == "integer" else float(raw)
            except ValueError:
                raise ValueError(f"{key} is a {'whole ' if kind == 'integer' else ''}number") from None
        if isinstance(value, bool) or not isinstance(
                value, int if kind == "integer" else (int, float)):
            raise ValueError(f"{key} is a {'whole ' if kind == 'integer' else ''}number")
        if field.get("minimum") is not None and value < field["minimum"]:
            raise ValueError(f"{key} is at least {field['minimum']}")
        if field.get("maximum") is not None and value > field["maximum"]:
            raise ValueError(f"{key} is at most {field['maximum']}")
        return value
    if kind == "boolean":
        if from_argv and isinstance(raw, str):
            lowered = raw.strip().lower()
            if lowered in ("true", "yes", "on", "1"):
                return True
            if lowered in ("false", "no", "off", "0"):
                return False
        if not isinstance(raw, bool):
            raise ValueError(f"{key} is true or false")
        return raw
    if kind in ("list", "object"):
        value = raw
        if from_argv and isinstance(raw, str):
            try:
                value = json.loads(raw)
            except ValueError:
                if kind == "object":
                    raise ValueError(f"{key} is a JSON object") from None
                value = [part.strip() for part in raw.split(",") if part.strip()]
        if kind == "list" and not isinstance(value, list):
            raise ValueError(f"{key} is a list")
        if kind == "object" and not isinstance(value, dict):
            raise ValueError(f"{key} is a JSON object")
        return value
    raise ValueError(f"{key} declares an unknown type {kind!r}")


def _stdin_document(what: str) -> dict:
    """One JSON object read whole from standard input."""
    text = sys.stdin.read()
    try:
        document = json.loads(text) if text.strip() else {}
    except ValueError as e:
        _die(6, "input", f"{what} on stdin is not JSON: {e}")
    if not isinstance(document, dict):
        _die(6, "input", f"{what} on stdin is a JSON object")
    return document


# --- Linking events ----------------------------------------------------------
#
# A verb that links a connection interactively takes `--events`, and then
# speaks JSON lines on stdout, one object per line naming its `event`, and
# reads each answer it asks for as one line on stdin - so a program with no
# terminal can drive it. `_emit` then writes the result as the `done` event and
# `_die` writes an `error` event before its usual envelope on stderr.

_EVENTS_ON = [False]


def _events_begin() -> None:
    """Turn this process's output into the linking event stream."""
    _EVENTS_ON[0] = True


def _event(name: str, **fields) -> None:
    if not _EVENTS_ON[0]:
        return
    sys.stdout.write(json.dumps({"event": name, **fields}, ensure_ascii=False,
                                default=str) + "\n")
    sys.stdout.flush()


def _event_answer(name: str, **fields) -> str:
    """Ask for one value with a `*_needed` event and read its line from stdin."""
    _event(name, **fields)
    line = sys.stdin.readline()
    if not line:
        _die(6, "input_closed", f"standard input closed while {name} waited for an answer",
             "write one line on stdin for every *_needed event")
    return line.rstrip("\r\n")


# --- Settings ----------------------------------------------------------------

def _settings_homes(scope: str | None = None) -> list[dict]:
    homes = list(((globals().get("SETTINGS") or {}).get("homes")) or [])
    return [h for h in homes if scope is None or h.get("scope") == scope]


def _settings_home_path(home: dict) -> Path | None:
    """Where one home's document sits: under the capability's folder in the
    project envelope for `project`, under its config home otherwise."""
    if home.get("scope") == "project":
        root = _project_root()
        if root is None:
            return None
        return _project_capabilities_dir(root) / NAME / home["path"]
    return _CONFIG_HOME / NAME / home["path"]


def _settings_in_rows(home: dict) -> bool:
    """Whether one home's document is rows of the store: a project or global
    home of an agent whose records moved there. A machine home stays a file."""
    if home.get("scope") not in ("project", "global") or _project_root() is None:
        return False
    try:
        return _records().settings_kept() == "store"
    except StoreError as e:
        _die(5 if e.slug in STORE_ENVIRONMENT_SLUGS else 6, e.slug, e.message, e.hint)


def _settings_read(home: dict) -> tuple:
    """One home's document: where it is kept, the document (None where there
    is none yet) and what keeps it from being read. Where the home is rows,
    `where` names the store's table rather than a file."""
    if _settings_in_rows(home):
        try:
            records = _records()
            return (records.collection_source(NAME, "setting"),
                    records.setting_document(NAME, home["scope"]), None)
        except StoreError as e:
            _die(5 if e.slug in STORE_ENVIRONMENT_SLUGS else 6, e.slug, e.message, e.hint)
    path = _settings_home_path(home)
    if path is None or not path.is_file():
        return path, None, None
    try:
        text = path.read_text()
        if home.get("format") == "toml":
            import tomllib
            document = tomllib.loads(text)
        else:
            document = json.loads(text) if text.strip() else {}
    except Exception as e:
        return path, None, f"cannot read {path}: {e}"
    if not isinstance(document, dict):
        return path, None, f"{path} does not hold an object"
    return path, document, None


def _settings_parts(key) -> list:
    """A settings key as the keys from the document root: a dotted path, or a
    JSON array of keys for a path whose keys contain dots."""
    if isinstance(key, (list, tuple)):
        return [str(part) for part in key]
    if key.startswith("["):
        try:
            parts = json.loads(key)
        except ValueError:
            parts = None
        if isinstance(parts, list) and parts and all(
                isinstance(part, str) and part for part in parts):
            return parts
    return key.split(".")


def _settings_dig(document, key):
    """The value at a key, and whether it is there."""
    here = document
    for part in _settings_parts(key):
        if not isinstance(here, dict) or part not in here:
            return None, False
        here = here[part]
    return here, True


def _settings_put(document: dict, key, value) -> None:
    parts = _settings_parts(key)
    here = document
    for part in parts[:-1]:
        if not isinstance(here.get(part), dict):
            here[part] = {}
        here = here[part]
    here[parts[-1]] = value


def _settings_drop(document: dict, key) -> bool:
    parts = _settings_parts(key)
    here = document
    for part in parts[:-1]:
        here = here.get(part) if isinstance(here, dict) else None
        if not isinstance(here, dict):
            return False
    return here.pop(parts[-1], None) is not None if isinstance(here, dict) else False


def _toml_scalar(value) -> str:
    import datetime as _dt
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return repr(value)
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False)
    if isinstance(value, (_dt.datetime, _dt.date, _dt.time)):
        return value.isoformat()
    if isinstance(value, list):
        return "[" + ", ".join(_toml_scalar(v) for v in value) + "]"
    if isinstance(value, dict):
        return "{ " + ", ".join(f"{_toml_name(k)} = {_toml_scalar(v)}"
                               for k, v in value.items()) + " }"
    raise ValueError(f"TOML holds no {type(value).__name__}")


def _toml_name(key: str) -> str:
    import re as _re
    return key if _re.fullmatch(r"[A-Za-z0-9_-]+", key) else json.dumps(key)


def _toml_dumps(document: dict, prefix: tuple = ()) -> str:
    """A document as TOML: scalars first, then each table, then each array of
    tables, which reads back as the same document. Comments are not kept."""
    lines, tables, arrays = [], [], []
    for key, value in document.items():
        if isinstance(value, dict):
            tables.append((key, value))
        elif isinstance(value, list) and value and all(isinstance(v, dict) for v in value):
            arrays.append((key, value))
        else:
            lines.append(f"{_toml_name(key)} = {_toml_scalar(value)}")
    out = "\n".join(lines) + ("\n" if lines else "")
    for key, value in tables:
        name = ".".join(_toml_name(k) for k in (*prefix, key))
        body = _toml_dumps(value, (*prefix, key))
        # A table holding only tables needs no header of its own.
        holds_tables_only = value and all(
            isinstance(v, dict) or (isinstance(v, list) and v and all(isinstance(i, dict) for i in v))
            for v in value.values())
        out += (body if holds_tables_only else f"\n[{name}]\n" + body)
    for key, items in arrays:
        name = ".".join(_toml_name(k) for k in (*prefix, key))
        for item in items:
            out += f"\n[[{name}]]\n" + _toml_dumps(item, (*prefix, key))
    return out


def _settings_write(home: dict, path: Path, document: dict) -> None:
    """Replace one home's document whole: checked by the capability where it
    checks its settings, written beside it, then renamed over it."""
    try:
        _records().guard_write(NAME, "setting", home.get("scope"))
    except StoreError as e:
        _die(5 if e.slug in STORE_ENVIRONMENT_SLUGS else 6, e.slug, e.message, e.hint)
    text = (_toml_dumps(document) if home.get("format") == "toml"
            else json.dumps(document, ensure_ascii=False, indent=2) + "\n")
    check = globals().get("_settings_check")
    problems = [str(p) for p in (check(home["scope"], document) or [])] if check else []
    if problems:
        _die(6, "settings_invalid",
             problems[0] if str(path) in problems[0] else f"{path}: {problems[0]}",
             f"`{NAME} settings` shows the document; `{NAME} help` states the keys")
    path.parent.mkdir(parents=True, exist_ok=True)
    spare = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    try:
        mode = path.stat().st_mode & 0o777 if path.exists() else 0o600
        fd = os.open(spare, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
        with os.fdopen(fd, "w") as handle:
            handle.write(text)
        os.replace(spare, path)
    finally:
        if spare.exists():
            spare.unlink()


def _settings_rows_write(home: dict, scope: str, change) -> dict:
    """Change one home's document where it is rows, in the store's one
    transaction: `change` takes the document and returns the new one, and the
    capability's check reads the whole result before anything is written."""
    check = globals().get("_settings_check")

    def checked(document: dict) -> list:
        return [str(p) for p in (check(scope, document) or [])] if check else []
    try:
        return _records().settings_write(NAME, scope, change, check=checked,
                                         seed=home.get("seed"))
    except StoreError as e:
        if e.slug == "not_found":
            _die(3, e.slug, e.message, e.hint)
        if e.slug == "settings_invalid":
            _die(6, e.slug, e.message,
                 f"`{NAME} settings` shows the document; `{NAME} help` states the keys")
        _die(5 if e.slug in STORE_ENVIRONMENT_SLUGS else 6, e.slug, e.message, e.hint)


def _records_in_store() -> bool:
    """Whether this project is an agent whose records and settings moved into
    the store (its registry row has `migrated_at`): every record and settings
    document it keeps is then rows, and no file of them is read or written."""
    if _project_root() is None:
        return False
    try:
        return _records().settings_kept() == "store"
    except StoreError as e:
        _die(5 if e.slug in STORE_ENVIRONMENT_SLUGS else 6, e.slug, e.message, e.hint)


def _env_override(*keys: str, value=None):
    """The first of `keys` the environment sets (or `value`, where the caller
    read it elsewhere), naming a file to read records or settings from; for an
    agent whose records moved into the store such a file is not read, so the
    override is ignored with a one-line notice on stderr, and None returned."""
    found = value if value is not None else next(
        (os.environ.get(k) for k in keys if os.environ.get(k)), None)
    if not found:
        return None
    if _records_in_store():
        named = next((k for k in keys if os.environ.get(k)), keys[0] if keys else "override")
        sys.stderr.write(f"{NAME}: {named} is ignored: this agent's records and settings "
                         "are in the store, and no file is read for them\n")
        return None
    return found


def _settings_diff(before: dict, after: dict) -> list:
    """What changes between two documents, path by path: `-` removed, `+`
    added, `~` changed."""
    def leaves(document, prefix=()):
        out = {}
        for key, value in (document or {}).items():
            if isinstance(value, dict) and value:
                out.update(leaves(value, (*prefix, key)))
            else:
                out[(*prefix, key)] = value
        return out

    def name(path):
        return (".".join(path) if all("." not in part for part in path)
                else json.dumps(list(path), ensure_ascii=False))

    def show(value):
        return json.dumps(value, ensure_ascii=False, sort_keys=True, default=str)
    old, new = leaves(before), leaves(after)
    lines = [f"- {name(p)}: {show(old[p])}" for p in sorted(set(old) - set(new))]
    for p in sorted(new):
        if p not in old:
            lines.append(f"+ {name(p)}: {show(new[p])}")
        elif show(old[p]) != show(new[p]):
            lines.append(f"~ {name(p)}: {show(old[p])} -> {show(new[p])}")
    return lines


def _settings_key_decl(key: str, scope: str | None = None) -> dict | None:
    """A key's declaration: at `scope` when one is named, else the first."""
    for decl in ((globals().get("SETTINGS") or {}).get("keys")) or []:
        if decl.get("key") == key and (scope is None or decl.get("scope") == scope):
            return decl
    return None


def _settings_value(decl: dict, documents: dict) -> tuple:
    """A declared key's value and the scope it came from: its own scope, then
    the scope that scope inherits from, by top-level key, else its default."""
    scope = decl.get("scope")
    top = decl["key"].split(".", 1)[0]
    seen: set = set()
    while scope and scope not in seen:
        seen.add(scope)
        document = documents.get(scope)
        if isinstance(document, dict) and top in document:
            value, found = _settings_dig(document, decl["key"])
            return (value, scope) if found else (decl.get("default"), "default")
        home = next(iter(_settings_homes(scope)), {})
        scope = home.get("inherits")
    return decl.get("default"), "default"


def _settings_report(scope: str | None) -> dict:
    homes, documents, in_rows = [], {}, False
    for home in _settings_homes(scope):
        path, document, error = _settings_read(home)
        documents[home["scope"]] = document
        rows = _settings_in_rows(home)
        in_rows = in_rows or rows
        row = {"scope": home["scope"], "format": home.get("format", "json"),
               "path": str(path) if path else None,
               "exists": (document is not None) if rows else bool(path and path.is_file()),
               "document": document}
        if home.get("inherits"):
            row["inherits"] = home["inherits"]
        if error:
            row["error"] = error
        homes.append(row)
    for home in _settings_homes():
        if home["scope"] not in documents:
            documents[home["scope"]] = _settings_read(home)[1]
    keys = []
    for decl in ((globals().get("SETTINGS") or {}).get("keys")) or []:
        if scope and decl.get("scope") != scope:
            continue
        value, source = _settings_value(decl, documents)
        keys.append({**decl, "value": value, "from": source})
    report = {"capability": NAME, "declared": bool(globals().get("SETTINGS")),
              "homes": homes, "keys": keys}
    if in_rows:
        # Which state of the store this was assembled from: a reader holding
        # these generations has read exactly what they name.
        try:
            report["generations"] = _records().setting_generations(NAME)
        except StoreError as e:
            _die(5 if e.slug in STORE_ENVIRONMENT_SLUGS else 6, e.slug, e.message, e.hint)
    return report


def _settings_checked_put(scope: str, document) -> dict:
    """A whole document given for `scope`, its declared keys checked."""
    if not isinstance(document, dict):
        _die(6, "input", "the settings document must be a JSON object")
    for each in ((globals().get("SETTINGS") or {}).get("keys")) or []:
        if each.get("scope") != scope:
            continue
        value, found = _settings_dig(document, each["key"])
        if found:
            try:
                _field_value(each, value)
            except ValueError as e:
                _die(6, "settings_invalid", str(e))
    return document


def _settings_edit(home: dict, scope: str, current: dict, yes: bool) -> dict:
    """The document after the person edited it in $VISUAL or $EDITOR, once
    they confirmed what changes; None where they changed nothing."""
    import shlex
    import subprocess
    import tempfile
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vi"
    fd, name = tempfile.mkstemp(prefix=f"{NAME}-settings-{scope}-", suffix=".json")
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write(json.dumps(current, ensure_ascii=False, indent=2) + "\n")
        try:
            ran = subprocess.run([*shlex.split(editor), name])
        except OSError as e:
            _die(6, "editor_failed", f"cannot run the editor {editor!r}: {e}",
                 "set VISUAL or EDITOR to an editor that waits until the file is closed")
        if ran.returncode != 0:
            _die(6, "editor_failed", f"the editor {editor!r} exited {ran.returncode}; "
                 "nothing was written")
        try:
            edited = json.loads(Path(name).read_text())
        except ValueError as e:
            _die(6, "input", f"the edited document is not JSON: {e}; nothing was written")
    finally:
        try:
            os.unlink(name)
        except OSError:
            pass
    edited = _settings_checked_put(scope, edited)
    diff = _settings_diff(current, edited)
    if not diff:
        return None
    sys.stderr.write("\n".join(diff) + "\n")
    if not yes:
        if not sys.stdin.isatty():
            _die(6, "confirm_required",
                 f"the edit changes {len(diff)} path(s) and was not written",
                 f"run `{NAME} settings edit` on a terminal to confirm, or pass --yes")
        sys.stderr.write("write these changes? [y/N] ")
        sys.stderr.flush()
        if sys.stdin.readline().strip().lower() not in ("y", "yes"):
            _die(6, "not_confirmed", "nothing was written")
    return edited


def _cmd_settings(argv: list[str]) -> None:
    """`settings` reads every settings document the capability keeps, wherever
    it lives, with its declared keys resolved; `get`, `set`, `unset`, `put`,
    `export` and `edit` read and write them through one surface. A key is a
    dotted path, or a JSON array of keys where a key contains dots."""
    usage = (f"{NAME} settings [show] [--scope S] | get <key> [--scope S] | "
             "set <key> <value> [--scope S] | unset <key> [--scope S] | "
             "put [--scope S] < document.json | export [--scope S] | "
             "edit [--scope S] [--yes]")
    scope = None
    yes = False
    rest = []
    i = 0
    while i < len(argv):
        if argv[i] == "--scope":
            if i + 1 >= len(argv) or argv[i + 1] not in SETTING_SCOPES:
                _die(6, "input", f"--scope is one of {', '.join(SETTING_SCOPES)}", usage)
            scope = argv[i + 1]
            i += 2
        elif argv[i] == "--json":
            i += 1
        elif argv[i] == "--yes":
            yes = True
            i += 1
        else:
            rest.append(argv[i])
            i += 1
    sub = rest[0] if rest else "show"
    if sub == "show" and len(rest) <= 1:
        _emit(_settings_report(scope)); return
    if sub not in ("get", "set", "unset", "put", "export", "edit"):
        _die(6, "input", f"unknown settings subcommand {sub!r}", usage)
    if not globals().get("SETTINGS"):
        _die(6, "settings_undeclared", f"{NAME} declares no settings",
             f"`{NAME} manifest` carries `settings: null`")
    key = rest[1] if len(rest) > 1 and sub not in ("export", "edit") else None
    if sub in ("get", "set", "unset") and not key:
        _die(6, "input", f"settings {sub} needs a key", usage)
    decl_key = ".".join(_settings_parts(key)) if key else None
    decl = _settings_key_decl(decl_key, scope) if key else None
    if scope is None:
        if decl and decl.get("scope"):
            scope = decl["scope"]
        elif len(_settings_homes()) == 1:
            scope = _settings_homes()[0]["scope"]
        else:
            _die(6, "scope_required", f"{NAME} keeps settings at more than one scope",
                 f"pass --scope {'|'.join(h['scope'] for h in _settings_homes())}")
    homes = _settings_homes(scope)
    if not homes:
        _die(6, "unknown_scope", f"{NAME} keeps no settings at scope {scope!r}",
             f"scopes: {', '.join(h['scope'] for h in _settings_homes())}")
    home = homes[0]
    rows = _settings_in_rows(home)
    path, document, error = _settings_read(home)
    if error:
        _die(6, "settings_unreadable", error)
    if document is None and sub != "put":
        # A document not written yet starts as the document its home declares.
        document = json.loads(json.dumps(home.get("seed") or {}))
    if path is None:
        _die(6, "no_project", f"the {scope} settings live in a project and there is no "
             "project here", "run it inside the project")
    if sub == "get":
        value, found = _settings_dig(document or {}, key)
        if not found:
            if decl is None:
                _die(3, "not_found", f"{key} is not set at scope {scope}")
            value = decl.get("default")
        _emit(value if not isinstance(value, str) else json.dumps(value)); return
    if sub == "export":
        _emit(document or {}); return
    _read_only_gate(f"`{NAME} settings {sub}`")
    document = dict(document or {})
    previous = None
    if sub == "edit":
        edited = _settings_edit(home, scope, document, yes)
        if edited is None:
            _emit({"ok": True, "scope": scope, "path": str(path), "action": sub,
                   "changed": False}); return
        new_document = edited
    elif sub == "put":
        new_document = _settings_checked_put(scope, _stdin_document("the settings document"))
    elif sub == "set":
        if len(rest) < 3:
            _die(6, "input", "settings set needs a key and a value", usage)
        try:
            value = json.loads(rest[2])
        except ValueError:
            value = rest[2]
        if decl is not None:
            # A textual key takes the word as written, so "123" stays text.
            textual = (decl.get("type") or "string") in (
                "string", "enum", "url", "email", "phone", "path")
            try:
                value = _field_value(decl, rest[2] if textual else value,
                                     from_argv=True)
            except ValueError as e:
                _die(6, "settings_invalid", str(e))
    out = {"ok": True, "scope": scope, "path": str(path), "action": sub}
    if rows:
        def change(target: dict) -> dict:
            if sub in ("put", "edit"):
                return new_document
            if sub == "set":
                _settings_put(target, key, value)
                return target
            if not _settings_dig(target, key)[1]:
                raise StoreError("not_found", f"{key} is not set at scope {scope}")
            _settings_drop(target, key)
            return target
        written = _settings_rows_write(home, scope, change)
        out["path"] = written["source"]
        if key:
            out.update({"key": key, "previous": _settings_dig(written["before"], key)[0]})
            if sub == "set":
                out["value"] = _settings_dig(written["after"], key)[0]
        if sub == "edit":
            out["changed"] = True
        out["generation"] = written["generation"]
        if written.get("node"):
            out["node"] = written["node"]
    else:
        if sub in ("put", "edit"):
            document = new_document
        elif sub == "set":
            previous, _ = _settings_dig(document, key)
            _settings_put(document, key, value)
        else:
            previous, found = _settings_dig(document, key)
            if not found:
                _die(3, "not_found", f"{key} is not set at scope {scope}")
            _settings_drop(document, key)
        _settings_write(home, path, document)
        if key:
            out.update({"key": key, "previous": previous})
            if sub == "set":
                out["value"] = _settings_dig(document, key)[0]
        if sub == "edit":
            out["changed"] = True
    applies = (decl or {}).get("apply") or home.get("apply")
    if applies:
        out["apply"] = applies
        if applies == "reload":
            out["hint"] = f"`{NAME} service reload` adopts it in a running service"
        elif applies == "restart":
            out["hint"] = f"a running service adopts it only after `{NAME} service stop` and `start`"
    _emit(out)


def _contract(argv: list[str]) -> None:
    """Dispatch the contract verbs; domain verbs fall through to the CLI's own
    parser. Runs after _gate(), before any credential is resolved.

    `help` is a contract verb only when bare (no extra args) — the top-level
    dump plus the Identifiers section. `<NAME> help <subcommand>` falls
    through to the CLI so per-verb help stays clean."""
    cmd = argv[0] if argv else ""
    if cmd == "stub":
        _emit(f"{SUMMARY} Run `{NAME} help`.")
    elif cmd == "manifest":
        _emit(_manifest_core())
    elif cmd == "migrate" and argv[1:2] == ["files"]:
        _cmd_migrate_files(argv[2:])
    elif cmd == "migrate" and _tables_declared():
        _cmd_migrate(argv[1:])
    elif cmd == "guide":
        _cmd_guide(argv[1:])
    elif cmd == "ids":
        _cmd_ids(argv[1:])
    elif cmd == "refs":
        _cmd_refs(argv[1:])
    elif cmd == "context":
        _cmd_context(argv[1:])
    elif cmd == "connections":
        _cmd_connections_reported()
    elif cmd == "inventory":
        _cmd_inventory(argv[1:])
    elif cmd == "settings" and globals().get("SETTINGS") is not None:
        _cmd_settings(argv[1:])
    elif cmd == "connection" and "_cmd_connection" in globals() \
            and globals().get("CONN_FIELDS") is not None:
        _cmd_connection(argv[1:])
    elif cmd == "setup" and "_cmd_setup" in globals() and globals().get("SETUP_FIELDS"):
        _cmd_setup(argv[1:])
    elif cmd == "help" and len(argv) == 1:
        _cmd_help()
    else:
        return
    sys.exit(0)

# <<< contract: capability core <<<

# >>> contract: store (generated — edit contract/store.py, run `capabilities sync-contract`) >>>
# A region carries what it needs. Relying on the host file to have imported
# the right names is a coupling nothing checks and nothing reports: it works in
# whichever capability happened to import them and fails at import time in the
# rest. Re-importing a name the host already has costs nothing.
import json
import os
import hashlib
import re
import socket
# The capability core region reads the clock through `time` and imports nothing
# of its own, so this region keeps carrying it.
import time
from collections.abc import Sequence
from pathlib import Path
from typing import Any


# Two scopes and no more: a record either belongs to one project (the
# project's envelope) or to every project (the user's config home).
SCOPE_KINDS = ("global", "project")

FIRST = "first"
MERGE = "merge"
EXACT = "exact"

# The collection registry: how each resolves, and who is allowed to write it.
# Adding a collection here is the only place a new record class is declared.
#
# `connection` and `grant` are the same fact split along the seam that matters:
# an entry's identity — where the thing is and how to reach it — is a fact about
# the world, the same in every project forever. What a project may DO with that
# identity is a decision, different per project by definition. Glued together,
# the second cannot be overridden without restating the first; apart, a project
# that needs write access writes one grant and repeats no address, no host,
# no secret.
#
# An identity is atomic: it merges by entry, never by field, so no connection is
# ever assembled from two scopes. That is what rule 18's "never merged" was
# protecting, and it survives; what it gives up is refusing to let a project add
# to the global set at all.
COLLECTIONS: dict[str, dict[str, str]] = {
    "connection": {"resolve": MERGE, "writer": "human"},
    "grant": {"resolve": MERGE, "writer": "human"},
    "identifier": {"resolve": MERGE, "writer": "capability"},
    "setting": {"resolve": MERGE, "writer": "human"},
    "policy": {"resolve": MERGE, "writer": "manager"},
    "document": {"resolve": MERGE, "writer": "human"},
}

# Grant fields and what they mean when nothing declares them. `allow_write`
# falls back to the capability's own WRITE_DEFAULT rather than to a value here,
# because "does a write leave the system" is the capability's fact.
GRANT_FIELDS = ("enabled", "allow_write")

# A document version is named by the first twelve hex characters of its sha256.
# Forty-eight bits is far more than a project's worth of prose needs, and a name
# a person can read at a glance is worth more than headroom nobody will reach.
HASH_LENGTH = 12

# A key is a label a human chose, and for a mailbox that label is naturally an
# email address — so `@` and `+` belong here. What stays out is whitespace,
# separators and anything that would make a key ambiguous to address.
KEY_RE = re.compile(r"[a-z0-9][a-z0-9._@+-]{0,127}", re.IGNORECASE)
CAPABILITY_RE = re.compile(r"[a-z][a-z0-9-]{0,63}")


class StoreError(Exception):
    """Every failure this tier reports. Carries a slug the caller maps to an
    exit code, so the CLI's error envelope stays the capability's own."""

    def __init__(self, slug: str, message: str, hint: str | None = None):
        super().__init__(message)
        self.slug = slug
        self.message = message
        self.hint = hint


# The process-wide read-only switch. A caller hands a whole process tree to
# something that may read through the capabilities but change nothing through
# them by setting this one variable, which every descendant inherits. It is
# decided here and nowhere else, because this tier is the one every capability
# carries and the one the manager and the bundled services import. It only ever
# closes: nothing it says makes a connection writable, and unset, `0` or
# `false` leave every record and every gate exactly as declared.
READ_ONLY_ENV = "CAPABILITIES_READ_ONLY"
READ_ONLY_EFFECT = ("every connection resolves read-only whatever its grant or "
                    "WRITE_DEFAULT; write verbs, project-record writes and "
                    "service activation exit 4")


def read_only_switch() -> bool:
    """True when this process runs under the read-only switch: the variable
    holds `1` or `true`, in any case."""
    return os.environ.get(READ_ONLY_ENV, "").strip().lower() in ("1", "true")


# The name a machine declares for itself as a node. A container's host name is
# its container id and changes on every redeploy, so a node that declares one
# keeps the same name in the store across them.
NODE_NAME_ENV = "AGENT_NODE_NAME"


def node_name() -> str:
    """The node this process runs on, by the one name the package gives it: a
    store-mode grant naming a node is matched against it, and a service that
    records which node holds its work records it. It is the name the machine
    declares in AGENT_NODE_NAME, and the host name where it declares none."""
    return os.environ.get(NODE_NAME_ENV, "").strip() or socket.gethostname()


def _node_check(node: Any) -> str | None:
    """A node a policy row is written for: a name, stripped, or None for every
    node."""
    if node is None:
        return None
    if not isinstance(node, str) or not node.strip():
        raise StoreError("bad_node", f"node {node!r} must name a node, or be null "
                         "for every node")
    return node.strip()


# Where a project keeps its records: files (the default) or the store, which
# then holds its connections, grants, identifiers and policy together. The
# manager alone writes this key into `project.json`, when it imports a
# project's files into the store; nothing infers it from a configured store.
RECORDS_MODE_KEY = "records"
RECORDS_MODES = ("files", "store")

# The key a project that moved only its connections and grants to the store
# carries. It keeps meaning exactly that: such a project reads its identifiers
# and its gate from files until it is imported again.
CONNECTIONS_MODE_KEY = "connections"
CONNECTIONS_MODES = ("files", "store")

# The contract's own tables in the store, migrated under the contract's own
# ledger owner, and the schema version this code writes them at.
STORE_OWNER = "capabilities"
STORE_CONNECTIONS_TABLE = "capabilities_connections"
STORE_GRANTS_TABLE = "capabilities_connection_grants"
STORE_IDENTIFIERS_TABLE = "capabilities_identifiers"
STORE_POLICY_TABLE = "capabilities_policy"
# The kernel's own tables, migrated in the same ledger: the agent registry, the
# agent's nodes and the one row of facts about the store as a whole. The
# manager alone writes them.
STORE_AGENTS_TABLE = "capabilities_agents"
STORE_AGENT_NODES_TABLE = "capabilities_agent_nodes"
STORE_GLOBAL_TABLE = "capabilities_global"
# Settings of an agent whose records moved into the store: one row per leaf,
# the documents that exist, and the append-only trail of every change.
STORE_SETTINGS_TABLE = "capabilities_settings"
STORE_SETTINGS_DOCUMENTS_TABLE = "capabilities_settings_documents"
STORE_SETTINGS_CHANGES_TABLE = "capabilities_settings_changes"
STORE_TABLES_VERSION = (1, 3)

# Which collections each store mode keeps in the store. The default pointer is
# a setting kept with the grants in both.
STORE_COLLECTIONS = {
    CONNECTIONS_MODE_KEY: frozenset({"connection", "grant"}),
    RECORDS_MODE_KEY: frozenset({"connection", "grant", "identifier", "policy"}),
}
STORE_TABLES = {
    "connection": STORE_CONNECTIONS_TABLE,
    "grant": STORE_GRANTS_TABLE,
    "identifier": STORE_IDENTIFIERS_TABLE,
    "policy": STORE_POLICY_TABLE,
    "setting": STORE_SETTINGS_TABLE,
}

# A store that cannot be reached or is busy is the environment's fault, not
# the configuration's: a capability maps these to its network exit code.
STORE_ENVIRONMENT_SLUGS = frozenset({"store_unreachable", "store_busy"})

# How long one process reuses what it read from the store, and a refusal to
# connect: long enough that one command asks once, short enough that a
# long-running service sees a changed grant, or a store that came back, at once.
STORE_READ_SECONDS = 2.0

# Whether an adapter keeps its connection between operations. Only a migration
# plan sets it: the plan's one link holds a transaction open for the whole run,
# and closing it after an operation would undo what the plan did so far.
_HOLD_RECORDS_CONNECTION = False


def record_table_steps() -> list[tuple[str, str]]:
    """The migration steps of the contract's tables. `enabled` and
    `allow_write` left null decide nothing, as a field absent from a file's
    grant does; `node` null is the grant, or the policy row, for every node;
    `agent_id` null is an identifier or a policy row for every project."""
    return [
        ("0001-connections",
         "CREATE TABLE capabilities_connections ("
         " capability text NOT NULL,"
         " name text NOT NULL,"
         " spec jsonb NOT NULL,"
         " PRIMARY KEY (capability, name),"
         " CHECK (jsonb_typeof(spec) = 'object'))"),
        ("0002-connection-grants",
         "CREATE TABLE capabilities_connection_grants ("
         " agent_id text NOT NULL,"
         " capability text NOT NULL,"
         " connection text NOT NULL,"
         " node text CHECK (node <> ''),"
         " enabled boolean,"
         " allow_write boolean,"
         " is_default boolean NOT NULL DEFAULT false,"
         " FOREIGN KEY (capability, connection)"
         "  REFERENCES capabilities_connections (capability, name)"
         "  ON DELETE CASCADE ON UPDATE CASCADE)"),
        ("0003-connection-grants-key",
         "CREATE UNIQUE INDEX capabilities_connection_grants_key"
         " ON capabilities_connection_grants"
         " (agent_id, capability, connection, (coalesce(node, '')))"),
        ("0004-connection-grants-default",
         "CREATE UNIQUE INDEX capabilities_connection_grants_default"
         " ON capabilities_connection_grants"
         " (agent_id, capability, (coalesce(node, ''))) WHERE is_default"),
        ("0005-identifiers",
         "CREATE TABLE capabilities_identifiers ("
         " agent_id text CHECK (agent_id <> ''),"
         " capability text NOT NULL,"
         " label text NOT NULL,"
         " value jsonb NOT NULL,"
         " note text NOT NULL DEFAULT '',"
         " updated_at timestamptz NOT NULL DEFAULT now())"),
        ("0006-identifiers-key",
         "CREATE UNIQUE INDEX capabilities_identifiers_key"
         " ON capabilities_identifiers"
         " ((coalesce(agent_id, '')), capability, label)"),
        ("0007-policy",
         "CREATE TABLE capabilities_policy ("
         " agent_id text CHECK (agent_id <> ''),"
         " capability text NOT NULL,"
         " node text CHECK (node <> ''),"
         " enabled boolean NOT NULL,"
         " updated_at timestamptz NOT NULL DEFAULT now())"),
        ("0008-policy-key",
         "CREATE UNIQUE INDEX capabilities_policy_key"
         " ON capabilities_policy"
         " ((coalesce(agent_id, '')), capability, (coalesce(node, '')))"),
        # The agent registry. `id` is the project id `project.json` declares;
        # the registry never mints or changes one. An icon and its SHA-256 are
        # present together or absent together.
        ("0009-agents",
         "CREATE TABLE capabilities_agents ("
         " id text PRIMARY KEY CHECK (id <> ''),"
         " name text CHECK (name <> ''),"
         " description text CHECK (description <> ''),"
         " icon bytea,"
         " icon_sha text CHECK (icon_sha ~ '^[0-9a-f]{64}$'),"
         " onboarding_status text CHECK (onboarding_status IN ('pending', 'complete')),"
         " onboarding_routine text CHECK (onboarding_routine <> ''),"
         " migrating_since timestamptz,"
         " migrated_at timestamptz,"
         " created_at timestamptz NOT NULL DEFAULT now(),"
         " updated_at timestamptz NOT NULL DEFAULT now(),"
         " CHECK ((icon IS NULL) = (icon_sha IS NULL)));"
         " COMMENT ON TABLE capabilities_agents IS"
         " 'The agent registry: one row per agent, keyed by the project id its"
         " capabilities/project.json declares. Written by the capabilities manager alone.';"
         " COMMENT ON COLUMN capabilities_agents.id IS"
         " 'The project id from capabilities/project.json (prj_<12 hex>, or an older UUID).';"
         " COMMENT ON COLUMN capabilities_agents.name IS"
         " 'Display name; null while the agent has none of its own.';"
         " COMMENT ON COLUMN capabilities_agents.icon IS"
         " 'The agent''s icon as PNG bytes; null with icon_sha when it has none.';"
         " COMMENT ON COLUMN capabilities_agents.icon_sha IS"
         " 'Lowercase hex SHA-256 of icon.';"
         " COMMENT ON COLUMN capabilities_agents.onboarding_status IS"
         " 'pending while the agent still runs its onboarding routine, complete once"
         " it finished; null when no onboarding is tracked.';"
         " COMMENT ON COLUMN capabilities_agents.onboarding_routine IS"
         " 'The routine the agent runs while onboarding is pending.';"
         " COMMENT ON COLUMN capabilities_agents.migrating_since IS"
         " 'Set while a move of this agent''s records from files into the store is open.';"
         " COMMENT ON COLUMN capabilities_agents.migrated_at IS"
         " 'When this agent''s records and settings moved into the store; null while"
         " they are still read from files.'"),
        # ContextKit's registry rows, taken over once where that table exists in
        # the same schema. An empty name or description meant none there.
        ("0010-agents-from-contextkit",
         "DO $copy$ BEGIN"
         " IF to_regclass('contextkit_agents') IS NOT NULL THEN"
         "  INSERT INTO capabilities_agents"
         "   (id, name, description, icon, icon_sha, created_at, updated_at)"
         "  SELECT id, nullif(name, ''), nullif(description, ''),"
         "   CASE WHEN icon IS NOT NULL AND icon_sha ~ '^[0-9a-f]{64}$' THEN icon END,"
         "   CASE WHEN icon IS NOT NULL AND icon_sha ~ '^[0-9a-f]{64}$' THEN icon_sha END,"
         "   created_at, updated_at"
         "  FROM contextkit_agents WHERE id <> ''"
         "  ON CONFLICT (id) DO NOTHING;"
         " END IF;"
         " END $copy$"),
        # The machines an agent runs on. Exactly one may be its master, which
        # the partial index below enforces; a node is removed with its agent.
        ("0011-agent-nodes",
         "CREATE TABLE capabilities_agent_nodes ("
         " agent_id text NOT NULL REFERENCES capabilities_agents (id)"
         "  ON DELETE CASCADE ON UPDATE CASCADE,"
         " node text NOT NULL CHECK (node <> ''),"
         " kind text NOT NULL CHECK (kind IN ('mac', 'server')),"
         " address text CHECK (address <> ''),"
         " is_master boolean NOT NULL DEFAULT false,"
         " may_write boolean NOT NULL DEFAULT false,"
         " target text CHECK (target <> ''),"
         " last_seen_at timestamptz,"
         " PRIMARY KEY (agent_id, node));"
         " COMMENT ON TABLE capabilities_agent_nodes IS"
         " 'The nodes an agent runs on, one row per (agent, node). Written by the"
         " capabilities manager alone. agent_id references capabilities_agents"
         " because a node exists only as a node of a registered agent.';"
         " COMMENT ON COLUMN capabilities_agent_nodes.node IS"
         " 'The name the node gives itself in AGENT_NODE_NAME.';"
         " COMMENT ON COLUMN capabilities_agent_nodes.address IS"
         " 'Host name or IP address the node is reached at, where it is fixed.';"
         " COMMENT ON COLUMN capabilities_agent_nodes.is_master IS"
         " 'The node that writes the rows every node of the agent inherits; at"
         " most one per agent.';"
         " COMMENT ON COLUMN capabilities_agent_nodes.may_write IS"
         " 'Whether a node that is not the master may write rows of its own, marked"
         " with its node.';"
         " COMMENT ON COLUMN capabilities_agent_nodes.target IS"
         " 'The deployment target this node is deployed by; null for a node that"
         " is not deployed, such as a Mac.';"
         " COMMENT ON COLUMN capabilities_agent_nodes.last_seen_at IS"
         " 'When the node last reported itself.'"),
        ("0012-agent-nodes-master",
         "CREATE UNIQUE INDEX capabilities_agent_nodes_master"
         " ON capabilities_agent_nodes (agent_id) WHERE is_master"),
        # Facts about the store as a whole, in its one row.
        ("0013-global",
         "CREATE TABLE capabilities_global ("
         " singleton boolean PRIMARY KEY DEFAULT true CHECK (singleton),"
         " global_migrated_at timestamptz);"
         " INSERT INTO capabilities_global DEFAULT VALUES;"
         " COMMENT ON TABLE capabilities_global IS"
         " 'One row of facts about this store as a whole.';"
         " COMMENT ON COLUMN capabilities_global.singleton IS"
         " 'Always true; keeps the table at one row.';"
         " COMMENT ON COLUMN capabilities_global.global_migrated_at IS"
         " 'When the global records were written into the store; null until then.'"),
        # A grant for every agent: `agent_id` null, beneath each agent's own
        # grant, and a default pointer for every agent the same way. The keys
        # of 0003 and 0004 stay as they are, so code that names them in its
        # ON CONFLICT keeps writing an agent's grants; the keys below coalesce
        # the agent as well, so two global rows can never stand for one grant.
        ("0014-connection-grants-global",
         "ALTER TABLE capabilities_connection_grants ALTER COLUMN agent_id DROP NOT NULL;"
         " ALTER TABLE capabilities_connection_grants"
         "  ADD CONSTRAINT capabilities_connection_grants_agent_id_check"
         "  CHECK (agent_id <> '');"
         " CREATE UNIQUE INDEX capabilities_connection_grants_scope_key"
         "  ON capabilities_connection_grants"
         "  ((coalesce(agent_id, '')), capability, connection, (coalesce(node, '')));"
         " CREATE UNIQUE INDEX capabilities_connection_grants_scope_default"
         "  ON capabilities_connection_grants"
         "  ((coalesce(agent_id, '')), capability, (coalesce(node, ''))) WHERE is_default;"
         " COMMENT ON TABLE capabilities_connection_grants IS"
         " 'What an agent may do with a connection: one row per (agent, capability,"
         " connection, node). A row whose agent_id is null is the grant for every"
         " agent, beneath each agent''s own; it never enables a connection by itself.';"
         " COMMENT ON COLUMN capabilities_connection_grants.agent_id IS"
         " 'The agent the grant is for; null for the grant every agent inherits.';"
         " COMMENT ON COLUMN capabilities_connection_grants.node IS"
         " 'The node the grant is for; null for every node. A node row is read before"
         " the row for every node.';"
         " COMMENT ON COLUMN capabilities_connection_grants.is_default IS"
         " 'Whether this connection is the default pointer at this grant''s scope and"
         " node; at most one per scope and node.'"),
        # An identifier for one node, read before the row for every node.
        ("0015-identifiers-node",
         "ALTER TABLE capabilities_identifiers ADD COLUMN node text CHECK (node <> '');"
         " DROP INDEX capabilities_identifiers_key;"
         " CREATE UNIQUE INDEX capabilities_identifiers_key ON capabilities_identifiers"
         "  ((coalesce(agent_id, '')), capability, label, (coalesce(node, '')));"
         " COMMENT ON TABLE capabilities_identifiers IS"
         " 'Durable non-secret lookups a capability discovered, one row per (agent,"
         " capability, label, node); agent_id null for every agent.';"
         " COMMENT ON COLUMN capabilities_identifiers.node IS"
         " 'The node the identifier is for; null for every node. A node row is read"
         " before the row for every node.'"),
        # Settings: one row per leaf of a capability's settings document, for
        # one agent (or every agent, agent_id null) and one node (or every
        # node). A writer takes, for the whole transaction, the advisory lock
        #   pg_advisory_xact_lock(hashtext(concat_ws(chr(31), schema,
        #     coalesce(agent_id, ''), capability, coalesce(node, ''))))
        # of the document it writes, so two writers of one document queue.
        # agent_id keeps the name the contract's other tables give it.
        ("0016-settings",
         "CREATE TABLE capabilities_settings ("
         " agent_id text CHECK (agent_id <> ''),"
         " capability text NOT NULL CHECK (capability <> ''),"
         " node text CHECK (node <> ''),"
         " path text[] NOT NULL"
         "  CHECK (cardinality(path) > 0 AND array_position(path, NULL) IS NULL),"
         " value jsonb NOT NULL,"
         " updated_at timestamptz NOT NULL DEFAULT now(),"
         " updated_by text NOT NULL CHECK (updated_by <> ''));"
         " CREATE UNIQUE INDEX capabilities_settings_key ON capabilities_settings"
         "  ((coalesce(agent_id, '')), capability, (coalesce(node, '')), path);"
         " CREATE FUNCTION capabilities_settings_guard() RETURNS trigger"
         "  LANGUAGE plpgsql SET search_path FROM CURRENT AS $guard$"
         " BEGIN"
         "  IF jsonb_typeof(NEW.value) = 'object' AND NEW.value <> '{}'::jsonb THEN"
         "   RAISE EXCEPTION 'setting % holds an object with keys; a row holds a scalar,"
         " an array or {}', array_to_string(NEW.path, '.')"
         "    USING ERRCODE = 'check_violation';"
         "  END IF;"
         "  IF EXISTS (SELECT 1 FROM capabilities_settings s"
         "   WHERE coalesce(s.agent_id, '') = coalesce(NEW.agent_id, '')"
         "   AND s.capability = NEW.capability"
         "   AND coalesce(s.node, '') = coalesce(NEW.node, '')"
         "   AND s.path <> NEW.path"
         "   AND (s.path[1:cardinality(NEW.path)] = NEW.path"
         "    OR NEW.path[1:cardinality(s.path)] = s.path)) THEN"
         "   RAISE EXCEPTION 'setting % overlaps another row of its document: a path"
         " never prefixes another', array_to_string(NEW.path, '.')"
         "    USING ERRCODE = 'check_violation';"
         "  END IF;"
         "  RETURN NEW;"
         " END $guard$;"
         " CREATE TRIGGER capabilities_settings_guard"
         "  BEFORE INSERT OR UPDATE ON capabilities_settings"
         "  FOR EACH ROW EXECUTE FUNCTION capabilities_settings_guard();"
         " COMMENT ON TABLE capabilities_settings IS"
         " 'Capability settings, one row per leaf path of a document. A document is"
         " (agent_id, capability, node); agent_id null is every agent''s, node null"
         " every node''s. Writers lock the document with pg_advisory_xact_lock(hashtext("
         "concat_ws(chr(31), schema, coalesce(agent_id, ''''), capability,"
         " coalesce(node, ''''))));"
         " a trigger refuses an object with keys as a value and a path that prefixes"
         " or is prefixed by another row of the same document.';"
         " COMMENT ON COLUMN capabilities_settings.agent_id IS"
         " 'The agent the setting is for; null for the setting every agent inherits.';"
         " COMMENT ON COLUMN capabilities_settings.node IS"
         " 'The node the setting is for; null for every node. A node row is read over"
         " the row for every node.';"
         " COMMENT ON COLUMN capabilities_settings.path IS"
         " 'The keys from the document root to this leaf; a key may contain dots.';"
         " COMMENT ON COLUMN capabilities_settings.value IS"
         " 'The leaf: a JSON scalar (null included), a whole array, or {} for an"
         " object left empty.';"
         " COMMENT ON COLUMN capabilities_settings.updated_by IS"
         " 'Who wrote the row: user@node, migrate@node or <capability>-service@node.'"),
        ("0017-settings-documents",
         "CREATE TABLE capabilities_settings_documents ("
         " agent_id text CHECK (agent_id <> ''),"
         " capability text NOT NULL CHECK (capability <> ''),"
         " node text CHECK (node <> ''),"
         " generation bigint NOT NULL,"
         " created_at timestamptz NOT NULL DEFAULT now());"
         " CREATE UNIQUE INDEX capabilities_settings_documents_key"
         "  ON capabilities_settings_documents"
         "  ((coalesce(agent_id, '')), capability, (coalesce(node, '')));"
         " COMMENT ON TABLE capabilities_settings_documents IS"
         " 'The settings documents that exist: a document without a row here reads as"
         " the capability''s seed; one with a row reads from its rows, even none.';"
         " COMMENT ON COLUMN capabilities_settings_documents.generation IS"
         " 'The id of the last capabilities_settings_changes row applied to the"
         " document; 0 before any.'"),
        ("0018-settings-changes",
         "CREATE TABLE capabilities_settings_changes ("
         " id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,"
         " agent_id text CHECK (agent_id <> ''),"
         " capability text NOT NULL CHECK (capability <> ''),"
         " node text CHECK (node <> ''),"
         " action text NOT NULL CHECK (action IN ('set', 'unset')),"
         " path text[] NOT NULL CHECK (cardinality(path) > 0),"
         " old_value jsonb,"
         " new_value jsonb,"
         " changed_at timestamptz NOT NULL DEFAULT now(),"
         " changed_by text NOT NULL CHECK (changed_by <> ''));"
         " CREATE FUNCTION capabilities_settings_changes_append_only() RETURNS trigger"
         "  LANGUAGE plpgsql AS $trail$"
         " BEGIN"
         "  RAISE EXCEPTION 'capabilities_settings_changes is append-only'"
         "   USING ERRCODE = 'restrict_violation';"
         " END $trail$;"
         " CREATE TRIGGER capabilities_settings_changes_append_only"
         "  BEFORE UPDATE OR DELETE ON capabilities_settings_changes"
         "  FOR EACH ROW EXECUTE FUNCTION capabilities_settings_changes_append_only();"
         " CREATE TRIGGER capabilities_settings_changes_no_truncate"
         "  BEFORE TRUNCATE ON capabilities_settings_changes"
         "  FOR EACH STATEMENT EXECUTE FUNCTION capabilities_settings_changes_append_only();"
         " COMMENT ON TABLE capabilities_settings_changes IS"
         " 'The append-only trail of settings: one row per path a write set or unset."
         " A document''s generation is the id of its last row here.';"
         " COMMENT ON COLUMN capabilities_settings_changes.action IS"
         " 'set: the path took new_value (old_value null where it was absent);"
         " unset: the path was removed (new_value null).';"
         " COMMENT ON COLUMN capabilities_settings_changes.changed_by IS"
         " 'Who wrote it: user@node, migrate@node or <capability>-service@node.'"),
    ]


def _refuse_record_write(capability: str, collection: str) -> None:
    """A project record is the human's or the manager's, so under the switch
    nothing writes one. Operational state (a capability's state directory and
    its tables in the database) is not a record and keeps working."""
    if read_only_switch():
        raise StoreError(
            "read_only_switch",
            f"writing {capability} {collection} records is refused: "
            f"{READ_ONLY_ENV} is set, so this process changes no project record",
            "Do not lift the switch yourself — ask the user; the change has to "
            f"run in a process without {READ_ONLY_ENV}.")


def _store_check(name: str, value: str, pattern: re.Pattern) -> str:
    if not isinstance(value, str) or not pattern.fullmatch(value):
        raise StoreError("bad_name", f"{name} {value!r} must match {pattern.pattern}")
    return value


def _semantics(collection: str) -> str:
    spec = COLLECTIONS.get(collection)
    if not spec:
        raise StoreError("bad_collection", f"unknown collection {collection!r}",
                         f"known: {', '.join(sorted(COLLECTIONS))}")
    return spec["resolve"]


def _grant_decisions(cid: str, rows: Sequence[dict[str, Any]]) -> tuple[dict, dict]:
    """One grant assembled field by field, highest scope first.

    This is the line COLLECTIONS already draws between the two records. An
    identity is a fact about the world, so it is atomic: taken whole from
    one scope, never assembled out of two. A grant is a decision, and a
    decision a lower scope made about one field stands until some higher
    scope decides that same field — so a machine-wide `allow_write: false`
    survives a project that only says `enabled: true`, and write permission
    is never acquired by saying something else.

    Returns the decided fields and, per field, the scope that decided it."""
    decided: dict[str, Any] = {}
    decided_at: dict[str, str] = {}
    for row in rows:
        value = row["value"]
        if not isinstance(value, dict):
            raise StoreError("bad_grant",
                             f"grant {cid!r} must be a table, got {type(value).__name__}")
        unknown = set(value) - set(GRANT_FIELDS)
        if unknown:
            raise StoreError("bad_grant",
                             f"grant {cid!r} has unknown field(s): {', '.join(sorted(unknown))}",
                             f"known: {', '.join(GRANT_FIELDS)}")
        for field, decision in value.items():
            if field not in decided:
                decided[field] = decision
                decided_at[field] = row["scope"]
    return decided, decided_at


# --- records: the files a project keeps its configuration in ------------------
#
# Runtime state is not on this axis: runs, queues and cursors a capability's
# processes share live in its tables in the database. What this answers is
# where CONFIGURATION is read and written. A capability calls the verbs below
# and never a path, so the layout is described in one place.

DOCUMENT_LOCATIONS: tuple[tuple[str | None, str, str], ...] = (
    ("reference", "{cap}/reference", ".md"),
    ("context", "{cap}/service/context", ".md"),
    ("script", "automations/scripts", ".py"),
    (None, "{cap}/service", ".md"),
)


def _document_key(prefix: str | None, stem: str) -> str:
    """The key a file answers to. Underscores fold to hyphens and case is lost,
    so the map from file to key is one-way — which is why finding a document
    searches rather than computes."""
    slug = stem.replace("_", "-").lower()
    return f"{prefix}.{slug}" if prefix else slug


class Records:
    """The surface a capability reads and writes its configuration through."""

    mode = "?"
    source = "?"

    def mode_of(self, collection: str, key: str | None = None) -> str:
        """Where one collection is kept: `files`, or `store` for what a
        project in store mode keeps there."""
        return self.mode

    def __enter__(self) -> "Records":
        return self

    def __exit__(self, *exc: object) -> None:
        self.close()

    def close(self) -> None:
        pass

    def resolve_scope(self, capability: str, collection: str,
                      scope: str) -> dict[str, dict[str, Any]]:
        """Resolve exactly one scope, without inheritance."""
        raise NotImplementedError

    def grantees(self, capability: str, connection: str) -> list[str]:
        """Every project a grant enables this connection for, on any node.
        Only the store holds a connection more than one project is granted;
        files keep each project's grants in that project alone."""
        return []

    # Whether settings documents are rows of the store rather than files: true
    # only for an agent whose records moved into the store.
    settings_in_rows = False

    def settings_kept(self) -> str:
        """Where this adapter reads settings documents: `files` or `store`.
        Raises when it cannot tell."""
        return "store" if self.settings_in_rows else "files"

    def guard_write(self, capability: str, collection: str,
                    scope: str | None = None) -> None:
        """Refuse a write this process may not make now. A writer that does
        not go through `set`, such as the settings verb writing a file, asks
        here first."""
        _refuse_record_write(capability, collection)


# A policy record says which node its row names. Files carry no node, so every
# policy record read from them names none: it is the record for every node.
_FILE_NODE = {"policy": {"node": None}}


def _files_carry_no_node(node: Any) -> None:
    if node is not None:
        raise StoreError(
            "node_requires_store",
            "a policy row naming a node is kept only in the store: files carry no "
            "node, so a record written there is for every node",
            "import this project's records into its store with `capabilities "
            "connections import`, then write the row for the node")


class FileRecords(Records):
    """Configuration kept as the files the envelope has always held.

    The layout is not invented here — it is the one the capabilities already
    read, described in one place instead of re-derived at each call site. Two
    directories with that layout make the scope chain: the project's envelope,
    then the user's config home."""

    mode = "files"

    def __init__(self, envelope: Path, global_dir: Path,
                 project_id: str | None = None, project: str | None = None,
                 include_global: bool = True):
        self.envelope, self.global_dir = Path(envelope), Path(global_dir)
        self.project_id, self.project = project_id, project
        self.include_global = bool(include_global)
        self.source = str(self.envelope)
        # The agent whose registry row a project write is checked against, and
        # where its database resolves; set by `open_records` alone.
        self._guard_agent: str | None = None
        self._guard_root: Path | None = None
        self._guard_application = STORE_OWNER
        self.actor: str | None = None

    def _agent_now(self) -> dict | None:
        """This project's registry row as the store holds it now, or None
        where no database answers or it holds none: a project whose records
        are files then writes them as it always has."""
        if not self._guard_agent:
            return None
        try:
            conn, _schema = _store_connect(self._guard_root or self.envelope.parent,
                                           self._guard_application, _PROBE_TIMEOUT)
        except StoreError:
            return None
        try:
            return _agent_state(conn, self._guard_agent)
        except Exception:
            return None
        finally:
            try:
                conn.close()
            except Exception:
                pass

    def guard_write(self, capability: str, collection: str,
                    scope: str | None = None) -> None:
        """A project record is not written to files while its agent's records
        are moving into the store, nor once they moved."""
        _refuse_record_write(capability, collection)
        if (scope or "project") != "project":
            return
        _refuse_frozen(self._agent_now(), self._guard_agent, self.actor,
                       files=True)

    def setting_document(self, capability: str, scope: str) -> dict | None:
        """One scope's settings document as the adapter's setting collection
        keeps it, or None where there is none."""
        _store_check("capability", capability, CAPABILITY_RE)
        root, _pid = self._scope_root(scope)
        body = self._load(self._file(root, capability, "setting"))
        return body if isinstance(body, dict) else None

    # -- where a record lives --------------------------------------------------

    def _chain(self) -> list[tuple[str, str | None, Path]]:
        chain = [("project", self.project_id, self.envelope)]
        if self.include_global:
            chain.append(("global", None, self.global_dir))
        return chain

    @staticmethod
    def _load(path: Path) -> Any:
        try:
            return json.loads(path.read_text())
        except FileNotFoundError:
            return None
        except (OSError, ValueError) as exc:
            raise StoreError("bad_config", f"cannot read {path}: {exc}") from None

    @staticmethod
    def _save(path: Path, body: Any, sort: bool = False) -> None:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(body, indent=2, ensure_ascii=False,
                                   sort_keys=sort) + "\n")

    def _policy_file(self, root: Path) -> Path:
        """The gate. A project keeps it at the envelope root; the config home
        keeps it under the manager's own name, which is the same rule seen from
        outside -- there, `capabilities` is a capability like any other."""
        return (root / "settings.json" if root == self.envelope
                else root / "capabilities" / "settings.json")

    def _file(self, root: Path, capability: str, collection: str,
              key: str | None = None) -> Path:
        if collection == "policy":
            return self._policy_file(root)
        if collection == "identifier":
            return root / capability / "identifiers.json"
        if collection in ("connection", "grant"):
            return root / capability / "connections.json"
        if collection == "setting":
            if key == "connection.default":
                return root / capability / "connections.json"
            return root / capability / "service" / "settings.json"
        raise StoreError("bad_collection",
                         f"collection {collection!r} is not kept in files")

    # -- reading ---------------------------------------------------------------

    def _entries(self, root: Path, capability: str, collection: str) -> dict[str, Any]:
        """Every entry of one collection held at one scope, keyed by the name a
        record answers to."""
        if collection == "policy":
            body = self._load(self._policy_file(root)) or {}
            return dict((body.get("capabilities") or {}))
        if collection == "identifier":
            body = self._load(root / capability / "identifiers.json") or {}
            raw = body.get("identifiers") if isinstance(body.get("identifiers"), dict) else body
            out = {}
            for label, entry in raw.items():
                out[label] = entry["value"] if isinstance(entry, dict) and "value" in entry else entry
            return out
        registry = self._load(root / capability / "connections.json") or {}
        if collection in ("connection", "grant"):
            declared = registry.get("connections")
            if not isinstance(declared, dict):
                return {}
            out = {}
            for cid, entry in declared.items():
                if not isinstance(entry, dict):
                    continue
                if collection == "connection":
                    out[cid] = {k: v for k, v in entry.items() if k not in GRANT_FIELDS}
                else:
                    grant = {k: entry[k] for k in GRANT_FIELDS if k in entry}
                    if grant:
                        out[cid] = grant
            return out
        if collection == "setting":
            out = {}
            if registry.get("default"):
                out["connection.default"] = registry["default"]
            service = self._load(root / capability / "service" / "settings.json")
            if isinstance(service, dict):
                out.update(service)
            return out
        raise StoreError("bad_collection", f"unknown collection {collection!r}",
                         f"known: {', '.join(sorted(COLLECTIONS))}")

    def _note(self, root: Path, capability: str, collection: str, key: str) -> str | None:
        if collection != "identifier":
            return None
        body = self._load(root / capability / "identifiers.json") or {}
        raw = body.get("identifiers") if isinstance(body.get("identifiers"), dict) else body
        entry = raw.get(key)
        return entry.get("note") if isinstance(entry, dict) else None

    def config_layers(self, capability: str, collection: str,
                      _scopes: Any = None) -> list[dict[str, dict[str, Any]]]:
        """Each scope's own entries, highest scope first, uncollapsed."""
        _store_check("capability", capability, CAPABILITY_RE)
        _semantics(collection)
        layers: list[dict[str, dict[str, Any]]] = []
        for scope, pid, root in self._chain():
            entries = self._entries(root, capability, collection)
            if not entries:
                continue
            layers.append({
                key: {"id": f"{scope}:{capability}/{collection}/{key}", "scope": scope,
                      "project_id": pid, "capability": capability,
                      "collection": collection, "key": key, "value": value,
                      "note": self._note(root, capability, collection, key),
                      "updated_at": None, "updated_by": None,
                      **_FILE_NODE.get(collection, {})}
                for key, value in entries.items()
            })
        return layers

    def resolve(self, capability: str, collection: str) -> dict[str, dict[str, Any]]:
        semantics = _semantics(collection)
        out: dict[str, dict[str, Any]] = {}
        for rows in self.config_layers(capability, collection):
            if semantics == FIRST:
                return rows
            for key, row in rows.items():
                prior = out.get(key)
                if prior is None:
                    out[key] = row
                elif (collection == "connection" and not prior["value"]
                        and row["value"]):
                    # One file holds both records here, so an entry carrying
                    # only grant fields yields an identity with no fields. That
                    # is a decision about an inherited connection, never a
                    # replacement for it: it must not blank the identity the
                    # lower scope declared. Where nothing is inherited the
                    # fieldless identity stands, which is the only reading a
                    # glued file leaves for it.
                    out[key] = row
        return out

    def _scope_root(self, scope: str) -> tuple[Path, str | None]:
        """The directory one named scope keeps its records in, and the project
        it answers for. Named once so asking a scope for its rows and asking it
        for its file can never land in different trees."""
        if scope == "project":
            return self.envelope, self.project_id
        if scope == "global":
            return self.global_dir, None
        raise StoreError("bad_scope",
                         f"scope {scope!r} must be one of {', '.join(SCOPE_KINDS)}")

    def resolve_scope(self, capability: str, collection: str,
                      scope: str) -> dict[str, dict[str, Any]]:
        _store_check("capability", capability, CAPABILITY_RE)
        root, pid = self._scope_root(scope)
        return {
            key: {"id": f"{scope}:{capability}/{collection}/{key}",
                  "scope": scope, "project_id": pid,
                  "capability": capability, "collection": collection,
                  "key": key, "value": value,
                  "note": self._note(root, capability, collection, key),
                  "updated_at": None, "updated_by": None,
                  **_FILE_NODE.get(collection, {})}
            for key, value in self._entries(root, capability, collection).items()
        }

    def get(self, capability: str, collection: str, key: str) -> Any:
        entry = self.resolve(capability, collection).get(key)
        return entry["value"] if entry else None

    def collection_source(self, capability: str, collection: str) -> str:
        """The file that answered, named exactly. A report that says only
        "files" makes the reader go and find out which one, and the scope a
        record resolved at is half of what they came to learn."""
        for _scope, _pid, root in self._chain():
            if self._entries(root, capability, collection):
                return str(self._file(root, capability, collection))
        return str(self._file(self.envelope, capability, collection))

    def scope_source(self, capability: str, collection: str, scope: str) -> str:
        """The file one named scope keeps this collection in. What a record
        resolved *to* is a question about that record, so the caller that knows
        which scope answered asks here rather than for the collection's own
        file: one file per scope, and the chain is not walked again."""
        _store_check("capability", capability, CAPABILITY_RE)
        root, _pid = self._scope_root(scope)
        return str(self._file(root, capability, collection))

    def connections(self, capability: str, write_default: bool = False,
                    include_disabled: bool = False,
                    machine_read: bool = False) -> dict[str, dict[str, Any]]:
        """Every connection this project may use, already carrying the decision
        made about it — the one read a capability needs before it acts.

        `machine_read` is the caller's word that this is one of the
        capability's declared machine reads outside any project: an identity
        the machine itself declares is then usable, read-only, unless its grant
        resolves to `enabled: false`."""
        identities = self.resolve(capability, "connection")
        layers = self.config_layers(capability, "grant")
        # Under the read-only switch every connection is a source, whatever its
        # grant or the capability's WRITE_DEFAULT says.
        writable = not read_only_switch()
        out: dict[str, dict[str, Any]] = {}
        for cid, entry in identities.items():
            rows = [layer[cid] for layer in layers if cid in layer]
            decided, decided_at = _grant_decisions(cid, rows)
            # Where the identity resolves decides whether it is this project's
            # to use at all. A project that declares an identity locally has
            # already said yes by declaring it; an identity inherited from the
            # global scope is withheld until a grant *resolving at project
            # scope* says `enabled: true`. A global `enabled: true` can never be
            # the blessing — one global line would otherwise hand every project
            # on the machine the same connection back.
            declared = decided.get("enabled")
            identity_is_project = entry["scope"] == "project"
            blessed_here = decided_at.get("enabled") == "project"
            if declared is None:
                enabled = identity_is_project
            else:
                enabled = bool(declared) and (identity_is_project or blessed_here)
            # A machine read lends the machine's own connection and nothing
            # more: never a write, and never one a grant switched off.
            lent = (machine_read and not enabled and entry["scope"] == "global"
                    and (declared is None or bool(declared)))
            if lent:
                enabled = True
            if not enabled and not include_disabled:
                continue
            grant = rows[0] if rows else None
            out[cid] = {
                "id": cid,
                "value": entry["value"],
                "scope": (entry["scope"], entry["project_id"]),
                "enabled": enabled,
                "allow_write": (writable and not lent
                                and bool(decided.get("allow_write", write_default))),
                "grant_scope": (grant["scope"], grant["project_id"]) if grant else None,
            }
            if lent:
                out[cid]["machine_read"] = True
        return out

    # -- writing ---------------------------------------------------------------

    def set(self, capability: str, collection: str, key: str, value: Any,
            actor: str | None = None, note: str | None = None,
            scope: str | None = None, node: str | None = None) -> None:
        _store_check("capability", capability, CAPABILITY_RE)
        _store_check("key", key, KEY_RE)
        _semantics(collection)
        _files_carry_no_node(node)
        target_scope = scope or "project"
        if target_scope not in SCOPE_KINDS:
            _refuse_record_write(capability, collection)
            raise StoreError("bad_scope",
                             f"scope {target_scope!r} must be one of {', '.join(SCOPE_KINDS)}")
        self.guard_write(capability, collection, target_scope)
        root = self.envelope if target_scope == "project" else self.global_dir
        if target_scope == "project" and not self.envelope.is_dir():
            raise StoreError("no_envelope", "no capabilities/ envelope in this project",
                             "run `capabilities init` first")
        path = self._file(root, capability, collection, key)
        body = self._load(path)
        body = body if isinstance(body, dict) else {}
        if collection == "policy":
            body.setdefault("capabilities", {})[key] = value
        elif collection == "identifier":
            # Flat at the top level, which is the shape the envelope has always
            # had and the shape `audit` holds this to. A file already carrying
            # the wrapper keeps it: reshaping someone's file on an unrelated
            # write is not this writer's business.
            holder = (body["identifiers"] if isinstance(body.get("identifiers"), dict)
                      else body)
            holder[key] = {"value": value, "note": note or ""}
        elif collection in ("connection", "grant"):
            entry = body.setdefault("connections", {}).setdefault(key, {})
            if collection == "connection":
                for field in list(entry):
                    if field not in GRANT_FIELDS:
                        entry.pop(field)
                entry.update(value if isinstance(value, dict) else {})
            else:
                entry.update({k: v for k, v in (value or {}).items() if k in GRANT_FIELDS})
        elif key == "connection.default":
            body["default"] = value
        else:
            body[key] = value
        self._save(path, body, sort=collection == "identifier")

    def delete(self, capability: str, collection: str, key: str,
               scope: str | None = None, node: str | None = None) -> bool:
        _files_carry_no_node(node)
        target_scope = scope or "project"
        if target_scope not in SCOPE_KINDS:
            _refuse_record_write(capability, collection)
            raise StoreError("bad_scope",
                             f"scope {target_scope!r} must be one of {', '.join(SCOPE_KINDS)}")
        self.guard_write(capability, collection, target_scope)
        root = self.envelope if target_scope == "project" else self.global_dir
        path = self._file(root, capability, collection, key)
        body = self._load(path)
        if not isinstance(body, dict):
            return False
        if collection == "policy":
            gone = (body.get("capabilities") or {}).pop(key, None) is not None
        elif collection == "identifier":
            holder = body.get("identifiers") if isinstance(body.get("identifiers"), dict) else body
            gone = holder.pop(key, None) is not None
        elif collection in ("connection", "grant"):
            entry = (body.get("connections") or {}).get(key)
            if not isinstance(entry, dict):
                return False
            if collection == "connection":
                gone = body["connections"].pop(key, None) is not None
            else:
                gone = any(entry.pop(field, None) is not None for field in GRANT_FIELDS)
        elif key == "connection.default":
            gone = body.pop("default", None) is not None
        else:
            gone = body.pop(key, None) is not None
        if gone:
            self._save(path, body, sort=collection == "identifier")
        return gone

    # -- documents -------------------------------------------------------------

    def _documents(self, root: Path, capability: str) -> dict[str, Path]:
        """Every long-text file this scope holds, by the key it answers to. The
        map is built by walking rather than by computing a path from a key,
        because the key loses case and underscores on the way in."""
        found: dict[str, Path] = {}
        for prefix, shape, suffix in DOCUMENT_LOCATIONS:
            if prefix == "script" and capability != "automations":
                continue
            folder = root / shape.format(cap=capability)
            if not folder.is_dir():
                continue
            for path in sorted(folder.glob(f"*{suffix}")):
                if path.is_file():
                    found.setdefault(_document_key(prefix, path.stem), path)
        return found

    def document_path(self, capability: str, key: str) -> Path | None:
        """The file this key names. It is the truth here, not a copy of it, so
        an edit to what this returns is the edit — which is why `put` validates
        rather than transports."""
        for _scope, _pid, root in self._chain():
            path = self._documents(root, capability).get(key)
            if path:
                return path
        return None

    def document_read(self, capability: str, key: str) -> dict[str, Any] | None:
        for scope, pid, root in self._chain():
            path = self._documents(root, capability).get(key)
            if not path:
                continue
            body = path.read_text()
            return {"id": str(path), "key": key,
                    "hash": hashlib.sha256(body.encode()).hexdigest()[:HASH_LENGTH],
                    "body": body, "media_type": None, "author": None,
                    "created_at": None, "scope": (scope, pid), "path": str(path)}
        return None

    def document_keys(self, capability: str) -> list[str]:
        keys: set[str] = set()
        for _scope, _pid, root in self._chain():
            keys.update(self._documents(root, capability))
        return sorted(keys)

    def document_put(self, capability: str, key: str, body: str,
                     author: str | None = None, media_type: str | None = None,
                     base: str | None = None) -> str:
        self.guard_write(capability, "document")
        path = self._documents(self.envelope, capability).get(key)
        if path is None:
            path = self._new_document_path(capability, key)
        if base is not None and path.is_file():
            current = path.read_text()
            live = hashlib.sha256(current.encode()).hexdigest()[:HASH_LENGTH]
            # In files mode `context edit` deliberately hands out the truth,
            # not a copy. By put-time the live hash is therefore expected to
            # differ from the checkout hash; equality of the submitted body and
            # the file proves the edit landed at the path the adapter named.
            if live != base and current != body:
                raise StoreError(
                    "stale_edit",
                    f"{path} is {live} now, not {base} as it was when the edit began",
                    "re-read it and apply the change again")
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(body)
        return hashlib.sha256(body.encode()).hexdigest()[:HASH_LENGTH]

    def _new_document_path(self, capability: str, key: str) -> Path:
        """Where a document this project does not have yet would go. The prefix
        chooses the folder; what follows it is the file."""
        for prefix, shape, suffix in DOCUMENT_LOCATIONS:
            if prefix and key.startswith(prefix + "."):
                return self.envelope / shape.format(cap=capability) / (key[len(prefix) + 1:] + suffix)
        prefix, shape, suffix = DOCUMENT_LOCATIONS[-1]
        return self.envelope / shape.format(cap=capability) / (key + suffix)

    # -- what a directory cannot answer ---------------------------------------

    def _refuse(self, what: str) -> None:
        raise StoreError("files_mode", f"{what} is not kept: records are files",
                         "their history is the repository's; read it with git")

    def revisions(self, *_a: Any, **_k: Any) -> list:
        self._refuse("a record's history")
        return []

    def document_versions(self, *_a: Any, **_k: Any) -> list:
        self._refuse("a document's earlier versions")
        return []


class StoreRecords(FileRecords):
    """A project in store mode: its connections, its grants, its default
    pointer, its identifiers and its policy are read from and written to the
    contract's tables in the project's store, and every other record stays in
    the files `FileRecords` reads. A project that moved only its connections
    and grants (`held="connections"`) keeps its identifiers and policy in
    files. The two homes never compose: what the store holds is not read from
    the files at all.

    A connection row belongs to no project, so it resolves as an identity the
    project did not declare itself would: withheld until this project's grant
    enables it. This project's grants are the rows whose `agent_id` is its id,
    the row naming this node read before the row for every node, field by
    field. A row never holds a secret value: `spec` names each secret by its
    `*_env` key, which resolves on each node through that node's own cascade.

    An identifier or a policy row whose `agent_id` is null is global: it
    applies to every project reading this store, beneath the project's own
    row. Identifiers resolve label by label, the project's row over the global
    one. Policy resolves per capability, from the first of: the project's row
    for this node, its row for every node, the global row for this node, the
    global row for every node; none is default deny. A policy record carries
    `node`, the node the row that answered names (None for every node), and
    `set`/`delete` of a policy row take `node` to write or remove the row for
    one node.

    The store is reached through the shared database library, on first use
    only, so a call that reads nothing the store holds never connects, and
    each read or write borrows the process's working connection while it
    runs and gives it back after. A connection handed in belongs to the
    caller and stays open."""

    def __init__(self, envelope: Path, global_dir: Path,
                 project_id: str | None = None, project: str | None = None,
                 include_global: bool = True, project_root: Path | None = None,
                 application_name: str = STORE_OWNER, connection: Any = None,
                 schema: str | None = None, held: str = RECORDS_MODE_KEY):
        super().__init__(envelope, global_dir, project_id, project, include_global)
        if held not in STORE_COLLECTIONS:
            raise StoreError("bad_records_mode",
                             f"a store holds {', '.join(sorted(STORE_COLLECTIONS))}, "
                             f"not {held!r}")
        self.held = held
        self.collections = STORE_COLLECTIONS[held]
        self.project_root = (Path(project_root) if project_root is not None
                             else self.envelope.parent)
        self.application_name = application_name
        self.node = node_name()
        self._conn = connection
        self._owns_conn = connection is None
        # How many operations are running on the owned connection: it is closed
        # when the last of them ends.
        self._depth = 0
        self._schema = schema
        self._failure: StoreError | None = None
        self._failed_at = 0.0
        self._cache: dict[tuple[str, str], tuple[float, Any]] = {}
        # Why this adapter could not ask the store whether the agent's records
        # moved into it. Its settings are then not read from files, which
        # would be stale for an agent that did.
        self._settings_blocked: StoreError | None = None

    def settings_kept(self) -> str:
        if self._settings_blocked is not None:
            raise self._settings_blocked
        return super().settings_kept()

    def setting_document(self, capability: str, scope: str) -> dict | None:
        if self._settings_blocked is not None:
            raise self._settings_blocked
        return super().setting_document(capability, scope)

    def _agent_now(self) -> dict | None:
        # A connection handed in carries its caller's own transaction, which
        # the manager holds for a write of its own.
        if not self._guard_agent or not self._owns_conn:
            return None
        try:
            conn = self._begin()
        except StoreError:
            return None
        import psycopg
        try:
            return _agent_state(conn, self._guard_agent)
        except psycopg.OperationalError as exc:
            raise self._unreachable(exc) from None
        finally:
            if self._conn is not None and self._depth == 1:
                try:
                    self._conn.rollback()
                except Exception:
                    pass
            self._end()

    def _held(self, collection: str, key: str | None = None) -> bool:
        return (collection in self.collections
                or (collection == "setting" and key == "connection.default"))

    def mode_of(self, collection: str, key: str | None = None) -> str:
        return "store" if self._held(collection, key) else "files"

    def close(self) -> None:
        if self._owns_conn and self._conn is not None:
            try:
                self._conn.close()
            except Exception:
                pass
            self._conn = None

    # -- reaching the store ----------------------------------------------------

    def _fail(self, error: StoreError) -> StoreError:
        self._failure, self._failed_at = error, time.monotonic()
        return error

    def _unreachable(self, exc: Exception) -> StoreError:
        """A connection that broke is dropped, so the next use opens a new one."""
        if self._owns_conn and self._conn is not None:
            try:
                self._conn.close()
            except Exception:
                pass
            self._conn = None
        return self._fail(StoreError(
            "store_unreachable", f"cannot reach the store: {exc}",
            "check the database setting with `capabilities store doctor`"))

    def _fresh(self, key: tuple[str, str]) -> Any:
        held = self._cache.get(key)
        if held is not None and time.monotonic() - held[0] < STORE_READ_SECONDS:
            return held[1]
        return None

    def _begin(self) -> Any:
        """The connection for one operation, borrowed for it unless one is
        running; `_end` gives it back once the last operation on it ends."""
        self._depth += 1
        try:
            return self._db()
        except BaseException:
            self._end()
            raise

    def _end(self) -> None:
        self._depth = max(0, self._depth - 1)
        if self._depth == 0 and not _HOLD_RECORDS_CONNECTION:
            self.close()

    def _db(self) -> Any:
        """The connection, opened on first use. A refusal to connect stands for
        STORE_READ_SECONDS, so one command does not wait on it twice."""
        if self._failure is not None:
            if time.monotonic() - self._failed_at < STORE_READ_SECONDS:
                raise self._failure
            self._failure = None
        if self._conn is not None:
            return self._conn
        try:
            from capabilities_contract import db
        except ImportError:
            raise self._fail(StoreError(
                "driver_missing",
                "the shared database library capabilities-contract is not installed",
                "run the capability through its own script header, which pins it")) from None
        try:
            setting = db.resolve_setting(self.project_root)
            self._conn = db.connect(application_name=self.application_name,
                                    setting=setting, transaction=True)
        except db.DbError as exc:
            raise self._fail(StoreError(exc.slug, exc.message, exc.hint)) from None
        self._schema = setting.schema
        return self._conn

    def _read(self, query: str, params: Sequence[Any]) -> list[tuple]:
        conn = self._begin()
        try:
            return self._read_on(conn, query, params)
        finally:
            self._end()

    def _read_on(self, conn: Any, query: str, params: Sequence[Any]) -> list[tuple]:
        import psycopg
        try:
            rows = conn.execute(query, params).fetchall()
        except psycopg.errors.UndefinedTable:
            # A store nothing was ever imported into holds no connection.
            if self._owns_conn:
                conn.rollback()
            return []
        except psycopg.OperationalError as exc:
            raise self._unreachable(exc) from None
        except psycopg.Error as exc:
            if self._owns_conn:
                conn.rollback()
            raise StoreError("store_read_failed",
                             f"reading records from the store failed: {exc}") from None
        if self._owns_conn:
            conn.rollback()
        return rows

    def _read_many(self, statements: Sequence[tuple[str, Sequence[Any]]]) -> list[list]:
        """The rows of each of `statements`, independent reads, as `_read` gives
        them, sent to the store together on one connection. A table that is
        not there is read as `_read` reads it, one statement at a time."""
        import psycopg
        conn = self._begin()
        try:
            if not self._owns_conn:
                # A caller's transaction: read as `_read` reads in it.
                return [self._read_on(conn, query, params) for query, params in statements]
            try:
                found = _read_together(conn, statements)
            except psycopg.errors.UndefinedTable:
                conn.rollback()
                return [self._read_on(conn, query, params) for query, params in statements]
            except psycopg.OperationalError as exc:
                raise self._unreachable(exc) from None
            except psycopg.Error as exc:
                conn.rollback()
                raise StoreError("store_read_failed",
                                 f"reading records from the store failed: {exc}") from None
            conn.rollback()
            return found
        finally:
            self._end()

    def _write(self, work: Any) -> Any:
        """Run `work(conn)` in one transaction, the tables migrated first. A
        connection handed in belongs to a caller holding its own transaction,
        which this neither migrates nor commits. A write whose connection was
        lost before its commit was sent runs once more on a new one; one lost
        while committing is never written again."""
        conn = self._begin()
        import psycopg
        from capabilities_contract import db
        try:
            try:
                if not self._owns_conn:
                    return work(conn)
                major, minor = STORE_TABLES_VERSION
                for attempt in (0, 1):
                    committing = False
                    try:
                        db.migrate(conn, STORE_OWNER, record_table_steps(),
                                   major=major, minor=minor)
                        with conn.transaction():
                            done = work(conn)
                            committing = True
                        return done
                    except psycopg.OperationalError:
                        if attempt or committing or self._depth != 1 \
                                or not getattr(conn, "broken", False):
                            raise
                    self.close()
                    conn = self._db()
            except db.DbError as exc:
                raise StoreError(exc.slug, exc.message, exc.hint) from None
            except psycopg.OperationalError as exc:
                raise self._unreachable(exc) from None
            except psycopg.Error as exc:
                raise StoreError("store_write_failed",
                                 f"writing records to the store failed: {exc}") from None
        finally:
            self._cache.clear()
            self._end()

    def _table_source(self, collection: str) -> str:
        if self._schema is None:
            self._begin()
            self._end()
        return f"store:{self._schema}.{STORE_TABLES.get(collection, STORE_CONNECTIONS_TABLE)}"

    # -- reading ---------------------------------------------------------------

    def _connection_rows(self, capability: str) -> dict[str, dict[str, Any]]:
        key = ("connection", capability)
        held = self._fresh(key)
        if held is None:
            rows = self._read(
                "SELECT name, spec FROM capabilities_connections "
                "WHERE capability = %s ORDER BY name", (capability,))
            held = {name: spec if isinstance(spec, dict) else {} for name, spec in rows}
            self._cache[key] = (time.monotonic(), held)
        return held

    def _grant_rows(self, capability: str) -> dict[str, list[dict[str, Any]]]:
        """This project's grants on this node, per connection: the row naming
        this node first, then the row for every node."""
        key = ("grant", capability)
        held = self._fresh(key)
        if held is None:
            out: dict[str, list[dict[str, Any]]] = {}
            if self.project_id:
                rows = self._read(
                    "SELECT connection, node, enabled, allow_write, is_default "
                    "FROM capabilities_connection_grants "
                    "WHERE agent_id = %s AND capability = %s "
                    "AND (node IS NULL OR node = %s) "
                    "ORDER BY connection, node NULLS LAST",
                    (self.project_id, capability, self.node))
                for cid, node, enabled, allow_write, is_default in rows:
                    out.setdefault(cid, []).append({
                        "node": node, "enabled": enabled,
                        "allow_write": allow_write, "is_default": bool(is_default)})
            self._cache[key] = (time.monotonic(), out)
            held = out
        return held

    def grantees(self, capability: str, connection: str) -> list[str]:
        _store_check("capability", capability, CAPABILITY_RE)
        if "grant" not in self.collections:
            return []
        rows = self._read(
            "SELECT DISTINCT agent_id FROM capabilities_connection_grants "
            "WHERE capability = %s AND connection = %s AND enabled "
            "AND agent_id IS NOT NULL ORDER BY agent_id", (capability, connection))
        return [agent for (agent,) in rows]

    def _store_default(self, capability: str) -> str | None:
        """The default pointer: this node's, else the one for every node."""
        grants = self._grant_rows(capability)
        for node in (self.node, None):
            for cid in sorted(grants):
                if any(r["is_default"] and r["node"] == node for r in grants[cid]):
                    return cid
        return None

    def _identifier_rows(self, capability: str) -> dict[str, dict[str, tuple]]:
        """This capability's identifiers in the store, per scope: this
        project's rows and the global ones, each label to its value, note and
        time of writing."""
        key = ("identifier", capability)
        held = self._fresh(key)
        if held is None:
            held = {"project": {}, "global": {}}
            # A row for one node is an agent's whose records moved into the
            # store; this project reads the rows for every node. The node is
            # read through the row's JSON, so a store whose identifiers carry
            # no node yet is read the same way.
            rows = self._read(
                "SELECT agent_id, label, value, note, updated_at, "
                "to_jsonb(i) ->> 'node' "
                "FROM capabilities_identifiers i "
                "WHERE capability = %s AND (agent_id IS NULL OR agent_id = %s) "
                "ORDER BY label", (capability, self.project_id))
            for agent_id, label, value, note, updated_at, node in rows:
                if node is not None:
                    continue
                scope = "global" if agent_id is None else "project"
                held[scope][label] = (value, note or "", _stamp(updated_at))
            self._cache[key] = (time.monotonic(), held)
        return held

    def _policy_rows(self) -> list[tuple[str, str | None, dict[str, tuple]]]:
        """The policy rows that apply to this project on this node, as the
        layers they resolve in, highest first: (scope, node, rows by name)."""
        key = ("policy", "")
        held = self._fresh(key)
        if held is None:
            found: dict[tuple[str, str | None], dict[str, tuple]] = {}
            rows = self._read(
                "SELECT agent_id, capability, node, enabled, updated_at "
                "FROM capabilities_policy "
                "WHERE (agent_id IS NULL OR agent_id = %s) "
                "AND (node IS NULL OR node = %s) ORDER BY capability",
                (self.project_id, self.node))
            for agent_id, name, node, enabled, updated_at in rows:
                scope = "global" if agent_id is None else "project"
                found.setdefault((scope, node), {})[name] = (
                    {"enabled": bool(enabled)}, _stamp(updated_at))
            held = [(scope, node, found.get((scope, node), {}))
                    for scope in ("project", "global") for node in (self.node, None)]
            self._cache[key] = (time.monotonic(), held)
        return held

    def _record(self, scope: str, capability: str, collection: str, key: str,
                value: Any, ref: str, note: str | None = None,
                updated_at: str | None = None, node: str | None = None) -> dict[str, Any]:
        record = {"id": f"store:{capability}/{collection}/{ref}", "scope": scope,
                  "project_id": self.project_id if scope == "project" else None,
                  "capability": capability, "collection": collection, "key": key,
                  "value": value, "note": note, "updated_at": updated_at,
                  "updated_by": None}
        if collection == "policy":
            # Which node the row that answered names: this node's name, or None
            # for the row for every node.
            record["node"] = node
        return record

    def _scope_layers(self, capability: str, collection: str,
                      scope: str) -> list[dict[str, dict[str, Any]]]:
        """One scope's identifier or policy layers in the store, highest first:
        for policy, the row for this node before the row for every node."""
        if collection == "identifier":
            rows = self._identifier_rows(capability)[scope]
            return [{label: self._record(scope, capability, collection, label, value,
                                         f"{scope}/{label}", note=note,
                                         updated_at=updated_at)
                     for label, (value, note, updated_at) in rows.items()}]
        return [{name: self._record(scope, capability, collection, name, value,
                                    f"{scope}/{name}@{node or '*'}",
                                    updated_at=updated_at, node=node)
                 for name, (value, updated_at) in rows.items()}
                for at, node, rows in self._policy_rows() if at == scope]

    def _entries(self, root: Path, capability: str, collection: str) -> dict[str, Any]:
        if collection in self.collections:
            return {}
        if collection == "setting" and self._settings_blocked is not None:
            raise self._settings_blocked
        entries = super()._entries(root, capability, collection)
        if collection == "setting":
            entries.pop("connection.default", None)
        return entries

    def config_layers(self, capability: str, collection: str,
                      _scopes: Any = None) -> list[dict[str, dict[str, Any]]]:
        _store_check("capability", capability, CAPABILITY_RE)
        if collection == "connection":
            rows = self._connection_rows(capability)
            return [{name: self._record("store", capability, collection, name, spec, name)
                     for name, spec in rows.items()}] if rows else []
        if collection == "grant":
            layers: list[dict[str, dict[str, Any]]] = []
            for node in (self.node, None):
                layer = {}
                for cid, rows in self._grant_rows(capability).items():
                    for row in rows:
                        if row["node"] == node:
                            value = {f: row[f] for f in GRANT_FIELDS if row[f] is not None}
                            layer[cid] = self._record("project", capability, collection,
                                                      cid, value, f"{cid}@{node or '*'}")
                if layer:
                    layers.append(layer)
            return layers
        if collection in self.collections:
            scopes = ("project", "global") if self.include_global else ("project",)
            return [layer for scope in scopes
                    for layer in self._scope_layers(capability, collection, scope)
                    if layer]
        layers = super().config_layers(capability, collection)
        if collection == "setting":
            default = self._store_default(capability)
            if default is not None:
                layers.insert(0, {"connection.default": self._record(
                    "project", capability, collection, "connection.default", default,
                    "connection.default")})
        return layers

    def resolve_scope(self, capability: str, collection: str,
                      scope: str) -> dict[str, dict[str, Any]]:
        if collection in ("connection", "grant") and scope in ("project", "store"):
            return self.resolve(capability, collection)
        if collection in self.collections and collection in ("identifier", "policy"):
            _store_check("capability", capability, CAPABILITY_RE)
            self._scope_root(scope)
            out: dict[str, dict[str, Any]] = {}
            for layer in self._scope_layers(capability, collection, scope):
                for key, row in layer.items():
                    out.setdefault(key, row)
            return out
        return super().resolve_scope(capability, collection, scope)

    def get(self, capability: str, collection: str, key: str) -> Any:
        """A grant answers with the row that applies on this node, and says
        which node it names (null for every node) and whether it is the
        default pointer."""
        if collection == "grant":
            _store_check("capability", capability, CAPABILITY_RE)
            rows = self._grant_rows(capability).get(key)
            if not rows:
                return None
            row = rows[0]
            out = {f: row[f] for f in GRANT_FIELDS if row[f] is not None}
            out.update(node=row["node"], is_default=row["is_default"])
            return out
        return super().get(capability, collection, key)

    def collection_source(self, capability: str, collection: str) -> str:
        if collection in self.collections:
            return self._table_source(collection)
        return super().collection_source(capability, collection)

    def scope_source(self, capability: str, collection: str, scope: str) -> str:
        if collection in self.collections:
            return self._table_source(collection)
        return super().scope_source(capability, collection, scope)

    # -- writing ---------------------------------------------------------------

    def _grant_value(self, cid: str, value: Any) -> tuple[dict[str, Any], str | None]:
        if not isinstance(value, dict):
            raise StoreError("bad_grant",
                             f"grant {cid!r} must be a table, got {type(value).__name__}")
        known = (*GRANT_FIELDS, "node", "is_default")
        unknown = set(value) - set(known)
        if unknown:
            raise StoreError("bad_grant",
                             f"grant {cid!r} has unknown field(s): {', '.join(sorted(unknown))}",
                             f"known: {', '.join(known)}")
        for field in (*GRANT_FIELDS, "is_default"):
            if field in value and not isinstance(value[field], bool) \
                    and not (field in GRANT_FIELDS and value[field] is None):
                raise StoreError("bad_grant", f"grant {cid!r} {field} must be true or false")
        node = value.get("node")
        if node is not None and (not isinstance(node, str) or not node.strip()):
            raise StoreError("bad_grant",
                             f"grant {cid!r} node must name a node, or be null for every node")
        return {f: value[f] for f in (*GRANT_FIELDS, "is_default") if f in value}, node

    def _put_grant(self, conn: Any, capability: str, cid: str,
                   fields: dict[str, Any], node: str | None) -> None:
        if not self.project_id:
            raise StoreError("no_project_id",
                             "this project has no id a grant could name",
                             "run `capabilities init` in the project")
        known = conn.execute(
            "SELECT 1 FROM capabilities_connections WHERE capability = %s AND name = %s",
            (capability, cid)).fetchone()
        if known is None:
            raise StoreError("unknown_connection",
                             f"the store holds no {capability} connection {cid!r}",
                             f"declare it first: `capabilities set {capability} "
                             f"connection {cid} '{{...}}'`")
        if fields.get("is_default"):
            conn.execute(
                "UPDATE capabilities_connection_grants SET is_default = false "
                "WHERE agent_id = %s AND capability = %s AND connection <> %s "
                "AND coalesce(node, '') = coalesce(%s, '') AND is_default",
                (self.project_id, capability, cid, node))
        columns = ["agent_id", "capability", "connection", "node", *fields]
        values = [self.project_id, capability, cid, node, *fields.values()]
        updates = ", ".join(f"{field} = EXCLUDED.{field}" for field in fields)
        conn.execute(
            f"INSERT INTO capabilities_connection_grants ({', '.join(columns)}) "
            f"VALUES ({', '.join(['%s'] * len(values))}) "
            "ON CONFLICT (agent_id, capability, connection, (coalesce(node, ''))) "
            + (f"DO UPDATE SET {updates}" if updates else "DO NOTHING"),
            values)

    def _put_default(self, conn: Any, capability: str, cid: str | None,
                     node: str | None) -> None:
        if not self.project_id:
            raise StoreError("no_project_id",
                             "this project has no id a grant could name",
                             "run `capabilities init` in the project")
        conn.execute(
            "UPDATE capabilities_connection_grants SET is_default = false "
            "WHERE agent_id = %s AND capability = %s "
            "AND coalesce(node, '') = coalesce(%s, '') AND is_default",
            (self.project_id, capability, node))
        if cid is not None:
            self._put_grant(conn, capability, cid, {"is_default": True}, node)

    def _scoped(self, collection: str, key: str | None, scope: str | None) -> bool:
        """Whether a write at `scope` lands in the store. Identifiers and
        policy keep both scopes there; a global connection, grant or default
        pointer stays the config home's."""
        if not self._held(collection, key):
            return False
        return scope != "global" or collection in ("identifier", "policy")

    def _agent(self, scope: str | None) -> str | None:
        """The `agent_id` a row at `scope` carries: this project's id, or null
        for a global row."""
        if scope not in (None, "project", "global"):
            raise StoreError("bad_scope",
                             f"scope {scope!r} must be one of {', '.join(SCOPE_KINDS)}")
        if scope == "global":
            return None
        if not self.project_id:
            raise StoreError("no_project_id",
                             "this project has no id a store row could name",
                             "run `capabilities init` in the project")
        return self.project_id

    def _put_identifier(self, capability: str, label: str, value: Any,
                        note: str | None, scope: str | None) -> None:
        agent = self._agent(scope)
        self._write(lambda conn: conn.execute(
            "INSERT INTO capabilities_identifiers "
            "(agent_id, capability, label, value, note) "
            "VALUES (%s, %s, %s, %s::jsonb, %s) "
            "ON CONFLICT ((coalesce(agent_id, '')), capability, label, "
            "(coalesce(node, ''))) "
            "DO UPDATE SET value = EXCLUDED.value, note = EXCLUDED.note, "
            "updated_at = now()",
            (agent, capability, label, json.dumps(value, ensure_ascii=False),
             note or "")))

    def _put_policy(self, name: str, value: Any, scope: str | None,
                    node: str | None = None) -> None:
        if (not isinstance(value, dict) or set(value) != {"enabled"}
                or not isinstance(value["enabled"], bool)):
            raise StoreError("bad_policy", f"policy for {name!r} must be "
                             '{"enabled": true|false}')
        agent = self._agent(scope)
        node = _node_check(node)
        self._write(lambda conn: conn.execute(
            "INSERT INTO capabilities_policy (agent_id, capability, node, enabled) "
            "VALUES (%s, %s, %s, %s) "
            "ON CONFLICT ((coalesce(agent_id, '')), capability, (coalesce(node, ''))) "
            "DO UPDATE SET enabled = EXCLUDED.enabled, updated_at = now()",
            (agent, name, node, value["enabled"])))

    def set(self, capability: str, collection: str, key: str, value: Any,
            actor: str | None = None, note: str | None = None,
            scope: str | None = None, node: str | None = None) -> None:
        if not self._scoped(collection, key, scope):
            return super().set(capability, collection, key, value,
                               actor=actor, note=note, scope=scope, node=node)
        _store_check("capability", capability, CAPABILITY_RE)
        _store_check("key", key, KEY_RE)
        _only_policy_names_a_node(collection, node)
        self.guard_write(capability, collection, scope)
        if collection == "identifier":
            return self._put_identifier(capability, key, value, note, scope)
        if collection == "policy":
            return self._put_policy(key, value, scope, node)
        if scope not in (None, "project"):
            raise StoreError("bad_scope",
                             f"scope {scope!r} must be one of {', '.join(SCOPE_KINDS)}")
        if collection == "connection":
            if not isinstance(value, dict):
                raise StoreError("bad_connection",
                                 f"connection {key!r} must be a table, got "
                                 f"{type(value).__name__}")
            spec = {k: v for k, v in value.items() if k not in GRANT_FIELDS}
            grant = {k: value[k] for k in GRANT_FIELDS if k in value}

            def work(conn: Any) -> None:
                conn.execute(
                    "INSERT INTO capabilities_connections (capability, name, spec) "
                    "VALUES (%s, %s, %s::jsonb) ON CONFLICT (capability, name) "
                    "DO UPDATE SET spec = EXCLUDED.spec",
                    (capability, key, json.dumps(spec, ensure_ascii=False)))
                if grant:
                    fields, node = self._grant_value(key, grant)
                    self._put_grant(conn, capability, key, fields, node)
            self._write(work)
        elif collection == "grant":
            fields, node = self._grant_value(key, value)
            self._write(lambda conn: self._put_grant(conn, capability, key, fields, node))
        else:
            cid = value if isinstance(value, str) and value else None
            if value not in (None, "") and cid is None:
                raise StoreError("bad_default", "the default pointer names a connection id")
            self._write(lambda conn: self._put_default(conn, capability, cid, None))

    def delete(self, capability: str, collection: str, key: str,
               scope: str | None = None, node: str | None = None) -> bool:
        if not self._scoped(collection, key, scope):
            return super().delete(capability, collection, key, scope=scope, node=node)
        _only_policy_names_a_node(collection, node)
        self.guard_write(capability, collection, scope)
        if collection == "identifier":
            agent = self._agent(scope)

            def work(conn: Any) -> bool:
                return conn.execute(
                    "DELETE FROM capabilities_identifiers "
                    "WHERE coalesce(agent_id, '') = coalesce(%s, '') "
                    "AND capability = %s AND label = %s AND node IS NULL",
                    (agent, capability, key)).rowcount > 0
        elif collection == "policy":
            agent = self._agent(scope)
            node = _node_check(node)

            def work(conn: Any) -> bool:
                return conn.execute(
                    "DELETE FROM capabilities_policy "
                    "WHERE coalesce(agent_id, '') = coalesce(%s, '') "
                    "AND capability = %s AND coalesce(node, '') = coalesce(%s, '')",
                    (agent, key, node)).rowcount > 0
        elif collection == "connection":
            def work(conn: Any) -> bool:
                return conn.execute(
                    "DELETE FROM capabilities_connections "
                    "WHERE capability = %s AND name = %s", (capability, key)).rowcount > 0
        elif collection == "grant":
            def work(conn: Any) -> bool:
                return conn.execute(
                    "DELETE FROM capabilities_connection_grants WHERE agent_id = %s "
                    "AND capability = %s AND connection = %s AND node IS NULL",
                    (self.project_id, capability, key)).rowcount > 0
        else:
            def work(conn: Any) -> bool:
                return conn.execute(
                    "UPDATE capabilities_connection_grants SET is_default = false "
                    "WHERE agent_id = %s AND capability = %s AND node IS NULL "
                    "AND is_default", (self.project_id, capability)).rowcount > 0
        return bool(self._write(work))


# --- an agent whose records moved into the store --------------------------------

# How long asking the store whether an agent's records moved may take where the
# answer only decides whether its files are still the truth: a store that does
# not answer by then leaves a project whose records are files on its files.
_PROBE_TIMEOUT = 2

# The writers that name themselves: the migration, and a capability's service.
# Every other writer is the person running the command, `<user>@<node>`.
_ACTOR_RE = re.compile(r"migrate|[a-z][a-z0-9-]{0,62}-service")


def _store_connect(project_root: Path, application_name: str,
                   timeout: int | None = None) -> tuple[Any, str]:
    """A transaction connection to the database resolved for `project_root`,
    and its schema, for one operation the caller closes. Raises StoreError."""
    try:
        from capabilities_contract import db
    except ImportError:
        raise StoreError(
            "driver_missing",
            "the shared database library capabilities-contract is not installed",
            "run the capability through its own script header, which pins it") from None
    try:
        setting = db.resolve_setting(project_root)
        extra = {"connect_timeout": timeout} if timeout else {}
        conn = db.connect(application_name=application_name, setting=setting,
                          transaction=True, **extra)
    except db.DbError as exc:
        raise StoreError(exc.slug, exc.message, exc.hint) from None
    return conn, setting.schema


def _read_together(conn: Any, statements: Sequence[tuple[str, Sequence[Any]]]) -> list[list]:
    """The rows of each of `statements`, independent reads on `conn`, sent to the
    store together and answered in one round trip where the shared database
    library offers it (`db.batch`), else one after another."""
    from capabilities_contract import db
    together = getattr(db, "batch", None)
    if together is None:
        return [conn.execute(query, params).fetchall() for query, params in statements]
    return together(conn, list(statements))


def _agent_state(conn: Any, agent_id: str) -> dict | None:
    """The agent's registry row and its nodes, or None where the store holds
    no such row or no registry at all."""
    import psycopg
    from capabilities_contract import db
    agent = ("SELECT migrating_since, migrated_at FROM capabilities_agents WHERE id = %s",
             (agent_id,))
    nodes_of = ("SELECT node, is_master, may_write FROM capabilities_agent_nodes "
                "WHERE agent_id = %s ORDER BY node", (agent_id,))
    try:
        if getattr(db, "batch", None) is not None:
            # Both in one round trip; the nodes are read whether or not the
            # row is there, and count only where it is.
            rows, nodes = db.batch(conn, [agent, nodes_of])
            row = rows[0] if rows else None
        else:
            row = conn.execute(*agent).fetchone()
            nodes = conn.execute(*nodes_of).fetchall() if row else []
    except psycopg.errors.UndefinedTable:
        conn.rollback()
        return None
    if row is None:
        return None
    # Stamped here rather than through `_stamp`, a name a capability may also
    # define for itself: a moment that is not there stays None.
    since, moved = (None if moment is None else moment.isoformat() for moment in row)
    return {"id": agent_id, "migrating_since": since, "migrated_at": moved,
            "nodes": {node: {"is_master": bool(master), "may_write": bool(may_write)}
                      for node, master, may_write in nodes},
            "master": next((node for node, master, _w in nodes if master), None)}


def _master_hint(state: dict) -> str:
    master = state.get("master")
    if master:
        return (f"the agent's master node is {master}: register this node there with "
                "`capabilities node add <node> --kind mac|server`, and run here with "
                f"{NODE_NAME_ENV} set to that name")
    return ("the agent has no master node registered: register one with "
            "`capabilities node add <node> --kind mac|server --master` on the machine "
            f"that is its master, and run there with {NODE_NAME_ENV} set to that name")


def _refuse_frozen(state: dict | None, agent_id: str | None, role: str | None,
                   node: str | None = None, files: bool = False) -> None:
    """A write to an agent whose records are moving into the store comes from
    the migration on its master alone; a file write for an agent whose records
    already moved is never made."""
    if not state:
        return
    if files and state.get("migrated_at"):
        raise StoreError(
            "agent_migrated",
            f"agent {agent_id} keeps its records in the store since "
            f"{state['migrated_at']}, and this process opened them as files",
            "run the command again: a new process reads and writes them in the store")
    since = state.get("migrating_since")
    if not since:
        return
    here = node if node is not None else os.environ.get(NODE_NAME_ENV, "").strip()
    if role == "migrate" and here and here == state.get("master"):
        return
    raise StoreError(
        "agent_migrating",
        f"agent {agent_id}'s records are being moved into the store (since {since}); "
        f"until that finishes only the migration on its master "
        f"{state.get('master') or '(none registered)'} writes them",
        "wait for `capabilities migrate` to finish on the master, then run it again")


def _json_copy(value: Any) -> Any:
    try:
        return json.loads(json.dumps(value, ensure_ascii=False))
    except (TypeError, ValueError) as exc:
        raise StoreError("bad_setting", f"a setting holds JSON only: {exc}") from None


def _canonical(value: Any) -> str:
    return json.dumps(value, ensure_ascii=False, sort_keys=True)


def _tree_put(document: dict, path: Sequence[str], value: Any) -> None:
    """Put `value` at `path`, making each missing or non-object parent an
    object; an object given replaces the subtree there."""
    here = document
    for part in path[:-1]:
        if not isinstance(here.get(part), dict):
            here[part] = {}
        here = here[part]
    here[path[-1]] = _json_copy(value)


def settings_tree(rows: Sequence[tuple[Sequence[str], Any]]) -> dict:
    """A settings document assembled from its leaf rows."""
    document: dict = {}
    for path, value in sorted(rows, key=lambda row: list(row[0])):
        _tree_put(document, list(path), value)
    return document


def settings_leaves(document: dict, prefix: tuple = ()) -> dict[tuple, Any]:
    """A settings document as its leaf rows: every path to a scalar, an array
    or an empty object. A document's root is never a leaf."""
    out: dict[tuple, Any] = {}
    for key, value in document.items():
        if not isinstance(key, str):
            raise StoreError("bad_setting", f"a settings key is text, not {key!r}")
        path = (*prefix, key)
        if isinstance(value, dict) and value:
            out.update(settings_leaves(value, path))
        else:
            out[path] = value
    return out


class _Unchanged(Exception):
    """Raised by a settings change that finds nothing to do, so the write
    it runs in leaves the document as it was."""


def _user_name() -> str:
    name = os.environ.get("USER") or os.environ.get("LOGNAME")
    if not name:
        try:
            import getpass
            name = getpass.getuser()
        except Exception:
            name = "unknown"
    return name


class AgentRecords(StoreRecords):
    """An agent whose records moved into the store: its `capabilities_agents`
    row has `migrated_at`. Every record it keeps - connections, grants, the
    default pointer, identifiers, policy - and its settings documents are rows
    of the contract's tables; its files are not read. Documents stay files.

    Each record resolves the agent's own rows over the rows for every agent
    (`agent_id` null), and at each of those scopes the row for this node over
    the row for every node. This node is AGENT_NODE_NAME, registered among the
    agent's nodes; `open_records` refuses an agent that has moved without it.

    Who writes what: the agent's master writes the rows every node shares
    (node null); another node writes only where the master let it
    (`may_write`), and what it writes carries its own node. While the agent's
    `migrating_since` is set, only the migration on its master writes. A
    settings document is written in one transaction under its advisory lock:
    assembled, changed, checked whole, then stored as the paths that changed,
    removals first, each with a trail row, and its generation moved to the
    last of them."""

    settings_in_rows = True

    def __init__(self, envelope: Path, global_dir: Path, project_id: str,
                 project: str | None, *, agent: dict, node: str,
                 include_global: bool = True, project_root: Path | None = None,
                 application_name: str = STORE_OWNER, actor: str | None = None):
        super().__init__(envelope, global_dir, project_id, project,
                         include_global=include_global, project_root=project_root,
                         application_name=application_name, held=RECORDS_MODE_KEY)
        self.collections = frozenset({"connection", "grant", "identifier", "policy",
                                      "setting"})
        self.agent = agent
        self.node = node
        self.actor = actor
        self._guard_agent = project_id
        self._ledger_current = False
        self._txn = False

    def _held(self, collection: str, key: str | None = None) -> bool:
        return collection in self.collections

    def settings_kept(self) -> str:
        return "store"

    # -- reaching the store ----------------------------------------------------

    def _db(self) -> Any:
        """The connection, its tables brought to this code's version once."""
        conn = super()._db()
        if not self._ledger_current and self._owns_conn and not self._txn:
            import psycopg
            from capabilities_contract import db
            major, minor = STORE_TABLES_VERSION
            try:
                db.migrate(conn, STORE_OWNER, record_table_steps(), major=major, minor=minor)
            except db.DbError as exc:
                raise StoreError(exc.slug, exc.message, exc.hint) from None
            except psycopg.OperationalError as exc:
                raise self._unreachable(exc) from None
            self._ledger_current = True
        return conn

    def _role(self, actor: str | None) -> str | None:
        for named in (actor, self.actor):
            if isinstance(named, str) and _ACTOR_RE.fullmatch(named):
                return named
        return None

    def actor_name(self, actor: str | None = None) -> str:
        """Who a write is recorded as: `migrate@<node>`,
        `<capability>-service@<node>`, or the person, `<user>@<node>`."""
        return f"{self._role(actor) or _user_name()}@{self.node}"

    def _authority(self, conn: Any, scope: str | None, wanted: str | None,
                   actor: str | None) -> str | None:
        """The node a write lands on, decided from the registry as it stands
        in this transaction: the master writes the shared rows (or a row for
        the node it names); another node writes its own rows where it may, and
        nothing else."""
        state = _agent_state(conn, self.project_id) or {}
        if scope != "global":
            _refuse_frozen(state, self.project_id, self._role(actor), node=self.node)
        mine = (state.get("nodes") or {}).get(self.node)
        if mine is None:
            raise StoreError("node_unregistered",
                             f"node {self.node} is not a node of agent {self.project_id}",
                             _master_hint(state))
        if mine["is_master"]:
            return wanted
        if not mine["may_write"]:
            raise StoreError(
                "node_read_only",
                f"node {self.node} is not the master of agent {self.project_id} and "
                "writes nothing: the rows every node shares are written on the master "
                f"{state.get('master') or '(none registered)'}",
                "write it on the master, or let the master allow this node its own "
                f"rows with `capabilities node set {self.node} --may-write`")
        if wanted not in (None, self.node):
            raise StoreError(
                "node_read_only",
                f"node {self.node} is not the master of agent {self.project_id} and "
                f"writes only rows of its own, not rows for node {wanted}",
                f"write it on the master {state.get('master') or '(none registered)'}")
        return self.node

    def _write(self, work: Any) -> Any:
        """One transaction, as the store tier's own, during which reads made
        on the same connection (a settings check reading the other scope)
        stay inside it."""
        def inside(conn: Any) -> Any:
            self._txn = True
            try:
                return work(conn)
            finally:
                self._txn = False
        return super()._write(inside)

    def _read(self, query: str, params: Sequence[Any]) -> list[tuple]:
        if not self._txn:
            return super()._read(query, params)
        import psycopg
        try:
            return self._db().execute(query, params).fetchall()
        except psycopg.OperationalError as exc:
            raise self._unreachable(exc) from None
        except psycopg.Error as exc:
            raise StoreError("store_read_failed",
                             f"reading records from the store failed: {exc}") from None

    def _read_many(self, statements: Sequence[tuple[str, Sequence[Any]]]) -> list[list]:
        if not self._txn:
            return super()._read_many(statements)
        import psycopg
        try:
            return _read_together(self._db(), statements)
        except psycopg.OperationalError as exc:
            raise self._unreachable(exc) from None
        except psycopg.Error as exc:
            raise StoreError("store_read_failed",
                             f"reading records from the store failed: {exc}") from None

    def guard_write(self, capability: str, collection: str,
                    scope: str | None = None) -> None:
        _refuse_record_write(capability, collection)
        if (scope or "project") == "project" and collection == "document":
            state = self._agent_now()
            _refuse_frozen(state, self.project_id, self._role(None), node=self.node)

    # -- reading ---------------------------------------------------------------

    def _record(self, scope: str, capability: str, collection: str, key: str,
                value: Any, ref: str, note: str | None = None,
                updated_at: str | None = None, node: str | None = None) -> dict[str, Any]:
        record = super()._record(scope, capability, collection, key, value, ref,
                                 note=note, updated_at=updated_at, node=node)
        if collection in ("identifier", "grant"):
            record["node"] = node
        return record

    def _grant_rows(self, capability: str) -> dict[str, list[dict[str, Any]]]:
        """This agent's grants and the grants for every agent, per connection,
        in the order they decide: the agent's before every agent's, and at
        each the row naming this node before the row for every node."""
        key = ("grant", capability)
        held = self._fresh(key)
        if held is None:
            out: dict[str, list[dict[str, Any]]] = {}
            rows = self._read(
                "SELECT agent_id, connection, node, enabled, allow_write, is_default "
                "FROM capabilities_connection_grants "
                "WHERE capability = %s AND (agent_id = %s OR (agent_id IS NULL AND %s)) "
                "AND (node IS NULL OR node = %s) "
                "ORDER BY connection, agent_id NULLS LAST, node NULLS LAST",
                (capability, self.project_id, self.include_global, self.node))
            for agent_id, cid, node, enabled, allow_write, is_default in rows:
                out.setdefault(cid, []).append({
                    "scope": "global" if agent_id is None else "project",
                    "node": node, "enabled": enabled, "allow_write": allow_write,
                    "is_default": bool(is_default)})
            self._cache[key] = (time.monotonic(), out)
            held = out
        return held

    def _defaults(self, capability: str) -> dict[str, str]:
        """The default pointer at each scope: this node's, else every node's."""
        grants = self._grant_rows(capability)
        found: dict[str, str] = {}
        for scope in ("project", "global"):
            for node in (self.node, None):
                for cid in sorted(grants):
                    if scope not in found and any(
                            r["is_default"] and r["node"] == node and r["scope"] == scope
                            for r in grants[cid]):
                        found[scope] = cid
        return found

    def _store_default(self, capability: str) -> str | None:
        found = self._defaults(capability)
        return found.get("project") or found.get("global")

    def _identifier_rows(self, capability: str) -> dict:
        key = ("identifier", capability)
        held = self._fresh(key)
        if held is None:
            held = {(scope, node): {} for scope in ("project", "global")
                    for node in (self.node, None)}
            rows = self._read(
                "SELECT agent_id, node, label, value, note, updated_at "
                "FROM capabilities_identifiers "
                "WHERE capability = %s AND (agent_id IS NULL OR agent_id = %s) "
                "AND (node IS NULL OR node = %s) ORDER BY label",
                (capability, self.project_id, self.node))
            for agent_id, node, label, value, note, updated_at in rows:
                scope = "global" if agent_id is None else "project"
                held[(scope, node)][label] = (value, note or "", _stamp(updated_at))
            self._cache[key] = (time.monotonic(), held)
        return held

    def _scope_layers(self, capability: str, collection: str,
                      scope: str) -> list[dict[str, dict[str, Any]]]:
        if collection != "identifier":
            return super()._scope_layers(capability, collection, scope)
        rows = self._identifier_rows(capability)
        return [{label: self._record(scope, capability, collection, label, value,
                                     f"{scope}/{label}@{node or '*'}", note=note,
                                     updated_at=updated_at, node=node)
                 for label, (value, note, updated_at) in rows[(scope, node)].items()}
                for node in (self.node, None)]

    def _settings_rows(self, capability: str) -> tuple[dict, dict]:
        """The settings documents that exist for this agent and every agent,
        on this node and every node, with their generations, and their rows."""
        key = ("setting", capability)
        held = self._fresh(key)
        if held is None:
            docs: dict[tuple, int] = {}
            rows: dict[tuple, list] = {}
            where = (capability, self.project_id, self.node)
            documents, leaves = self._read_many([
                ("SELECT agent_id, node, generation FROM capabilities_settings_documents "
                 "WHERE capability = %s AND (agent_id IS NULL OR agent_id = %s) "
                 "AND (node IS NULL OR node = %s)", where),
                ("SELECT agent_id, node, path, value FROM capabilities_settings "
                 "WHERE capability = %s AND (agent_id IS NULL OR agent_id = %s) "
                 "AND (node IS NULL OR node = %s) ORDER BY path", where)])
            for agent_id, node, generation in documents:
                docs[("global" if agent_id is None else "project", node)] = int(generation)
            for agent_id, node, path, value in leaves:
                rows.setdefault(("global" if agent_id is None else "project", node),
                                []).append((list(path), value))
            held = (docs, rows)
            self._cache[key] = (time.monotonic(), held)
        return held

    def setting_document(self, capability: str, scope: str) -> dict | None:
        """One scope's settings document as this node reads it: the rows for
        every node with this node's rows over them. None where neither
        document exists, which a reader takes as the capability's seed."""
        _store_check("capability", capability, CAPABILITY_RE)
        self._scope_root(scope)
        docs, rows = self._settings_rows(capability)
        shared, mine = (scope, None), (scope, self.node)
        if not any(k in docs or k in rows for k in (shared, mine)):
            return None
        document = settings_tree(rows.get(shared, []))
        for path, value in rows.get(mine, []):
            _tree_put(document, path, value)
        return document

    def setting_generations(self, capability: str) -> dict[str, int | None]:
        """The generation each scope's document was assembled from: the
        latest of its shared and this node's documents, None where none
        exists."""
        docs, _rows = self._settings_rows(capability)
        out: dict[str, int | None] = {}
        for scope in ("project", "global"):
            found = [docs[(scope, node)] for node in (None, self.node) if (scope, node) in docs]
            out[scope] = max(found) if found else None
        return out

    def config_layers(self, capability: str, collection: str,
                      _scopes: Any = None) -> list[dict[str, dict[str, Any]]]:
        _store_check("capability", capability, CAPABILITY_RE)
        if collection == "grant":
            layers: list[dict[str, dict[str, Any]]] = []
            for scope in ("project", "global"):
                for node in (self.node, None):
                    layer = {}
                    for cid, rows in self._grant_rows(capability).items():
                        for row in rows:
                            if row["scope"] == scope and row["node"] == node:
                                value = {f: row[f] for f in GRANT_FIELDS if row[f] is not None}
                                layer[cid] = self._record(
                                    scope, capability, collection, cid, value,
                                    f"{scope}/{cid}@{node or '*'}", node=node)
                    if layer:
                        layers.append(layer)
            return layers
        if collection == "setting":
            scopes = ("project", "global") if self.include_global else ("project",)
            return [layer for layer in (self.resolve_scope(capability, "setting", scope)
                                        for scope in scopes) if layer]
        return super().config_layers(capability, collection)

    def resolve_scope(self, capability: str, collection: str,
                      scope: str) -> dict[str, dict[str, Any]]:
        if collection == "setting":
            _store_check("capability", capability, CAPABILITY_RE)
            self._scope_root(scope)
            out = {key: self._record(scope, capability, collection, key, value,
                                     f"{scope}/{key}")
                   for key, value in (self.setting_document(capability, scope) or {}).items()}
            default = self._defaults(capability).get(scope)
            if default is not None:
                out["connection.default"] = self._record(
                    scope, capability, collection, "connection.default", default,
                    f"{scope}/connection.default")
            return out
        if collection == "grant":
            if scope == "store":
                scope = "project"
            self._scope_root(scope)
            out = {}
            for layer in self.config_layers(capability, "grant"):
                for key, row in layer.items():
                    if row["scope"] == scope:
                        out.setdefault(key, row)
            return out
        if collection == "connection" and scope == "global":
            return {}
        return super().resolve_scope(capability, collection, scope)

    def get(self, capability: str, collection: str, key: str) -> Any:
        if collection == "grant":
            _store_check("capability", capability, CAPABILITY_RE)
            rows = self._grant_rows(capability).get(key)
            if not rows:
                return None
            row = rows[0]
            out = {f: row[f] for f in GRANT_FIELDS if row[f] is not None}
            out.update(node=row["node"], is_default=row["is_default"], scope=row["scope"])
            return out
        return super().get(capability, collection, key)

    # -- writing ---------------------------------------------------------------

    def _lock_document(self, conn: Any, agent: str | None, capability: str,
                       node: str | None) -> None:
        conn.execute(
            "SELECT pg_advisory_xact_lock(hashtext(concat_ws(chr(31), %s::text, "
            "coalesce(%s::text, ''), %s::text, coalesce(%s::text, ''))))",
            (self._schema, agent, capability, node))

    def _document_rows(self, conn: Any, agent: str | None, capability: str,
                       node: str | None) -> tuple[dict[tuple, Any], int | None]:
        rows, documents = _read_together(conn, [
            ("SELECT path, value FROM capabilities_settings "
             "WHERE coalesce(agent_id, '') = coalesce(%s::text, '') AND capability = %s "
             "AND coalesce(node, '') = coalesce(%s::text, '')", (agent, capability, node)),
            ("SELECT generation FROM capabilities_settings_documents "
             "WHERE coalesce(agent_id, '') = coalesce(%s::text, '') AND capability = %s "
             "AND coalesce(node, '') = coalesce(%s::text, '')", (agent, capability, node))])
        found = documents[0] if documents else None
        return ({tuple(path): value for path, value in rows},
                int(found[0]) if found else None)

    def settings_write(self, capability: str, scope: str, change: Any,
                       check: Any = None, seed: dict | None = None,
                       actor: str | None = None) -> dict[str, Any]:
        """Change one scope's settings document in one transaction: lock it,
        assemble it (the seed where no document exists yet), apply `change`
        (a function from the document to the new one), check the result as
        this node will read it with `check` (a function returning problems),
        then write the paths that differ, removals first, one trail row each,
        and move the document's generation to the last of them. A refused
        write changes nothing."""
        _store_check("capability", capability, CAPABILITY_RE)
        _refuse_record_write(capability, "setting")
        agent = self._agent(scope)
        who = self.actor_name(actor)

        def work(conn: Any) -> dict[str, Any]:
            node = self._authority(conn, scope, None, actor)
            self._lock_document(conn, agent, capability, node)
            old, generation = self._document_rows(conn, agent, capability, node)
            exists = generation is not None or bool(old)
            current = (settings_tree(list(old.items())) if exists
                       else _json_copy(seed or {}) if node is None else {})
            before = _json_copy(current)
            after = change(_json_copy(current))
            if not isinstance(after, dict):
                raise StoreError("bad_setting", "a settings document is an object")
            after = _json_copy(after)
            if check is not None:
                problems = check(self._as_read(conn, agent, capability, node, after,
                                               seed)) or []
                if problems:
                    raise StoreError("settings_invalid", str(problems[0]))
            new = settings_leaves(after)
            changed = 0

            def trail(action: str, path: tuple, was: Any, now: Any) -> int:
                return conn.execute(
                    "INSERT INTO capabilities_settings_changes "
                    "(agent_id, capability, node, action, path, old_value, new_value, "
                    "changed_by) VALUES (%s, %s, %s, %s, %s, %s::jsonb, %s::jsonb, %s) "
                    "RETURNING id",
                    (agent, capability, node, action, list(path),
                     None if action == "set" and path not in old else _canonical(was),
                     None if action == "unset" else _canonical(now), who)).fetchone()[0]

            for path in sorted(set(old) - set(new)):
                conn.execute(
                    "DELETE FROM capabilities_settings "
                    "WHERE coalesce(agent_id, '') = coalesce(%s::text, '') "
                    "AND capability = %s AND coalesce(node, '') = coalesce(%s::text, '') "
                    "AND path = %s", (agent, capability, node, list(path)))
                generation = trail("unset", path, old[path], None)
                changed += 1
            for path in sorted(new):
                if path in old and _canonical(old[path]) == _canonical(new[path]):
                    continue
                if path in old:
                    conn.execute(
                        "UPDATE capabilities_settings SET value = %s::jsonb, "
                        "updated_at = now(), updated_by = %s "
                        "WHERE coalesce(agent_id, '') = coalesce(%s::text, '') "
                        "AND capability = %s AND coalesce(node, '') = coalesce(%s::text, '') "
                        "AND path = %s",
                        (_canonical(new[path]), who, agent, capability, node, list(path)))
                else:
                    conn.execute(
                        "INSERT INTO capabilities_settings "
                        "(agent_id, capability, node, path, value, updated_by) "
                        "VALUES (%s, %s, %s, %s, %s::jsonb, %s)",
                        (agent, capability, node, list(path), _canonical(new[path]), who))
                generation = trail("set", path, old.get(path), new[path])
                changed += 1
            conn.execute(
                "INSERT INTO capabilities_settings_documents "
                "(agent_id, capability, node, generation) VALUES (%s, %s, %s, %s) "
                "ON CONFLICT ((coalesce(agent_id, '')), capability, (coalesce(node, ''))) "
                "DO UPDATE SET generation = EXCLUDED.generation",
                (agent, capability, node, generation or 0))
            return {"before": before, "after": after, "generation": generation or 0,
                    "changed": changed, "node": node, "actor": who,
                    "source": self._table_source("setting")}
        return self._write(work)

    def _as_read(self, conn: Any, agent: str | None, capability: str,
                 node: str | None, document: dict, seed: dict | None) -> dict:
        """`document`, written for `node`, as this node will read its scope:
        the shared document with this node's rows over it."""
        if node is None:
            mine, _gen = self._document_rows(conn, agent, capability, self.node)
            composed = _json_copy(document)
        else:
            shared, generation = self._document_rows(conn, agent, capability, None)
            composed = (settings_tree(list(shared.items()))
                        if shared or generation is not None else _json_copy(seed or {}))
            mine = settings_leaves(document)
        for path, value in sorted(mine.items()):
            _tree_put(composed, list(path), value)
        return composed

    def _put_grant_at(self, conn: Any, capability: str, cid: str,
                      fields: dict[str, Any], agent: str | None, node: str | None) -> None:
        known = conn.execute(
            "SELECT 1 FROM capabilities_connections WHERE capability = %s AND name = %s",
            (capability, cid)).fetchone()
        if known is None:
            raise StoreError("unknown_connection",
                             f"the store holds no {capability} connection {cid!r}",
                             f"declare it first: `capabilities set {capability} "
                             f"connection {cid} '{{...}}'`")
        if fields.get("is_default"):
            conn.execute(
                "UPDATE capabilities_connection_grants SET is_default = false "
                "WHERE coalesce(agent_id, '') = coalesce(%s::text, '') AND capability = %s "
                "AND connection <> %s AND coalesce(node, '') = coalesce(%s::text, '') "
                "AND is_default", (agent, capability, cid, node))
        columns = ["agent_id", "capability", "connection", "node", *fields]
        values = [agent, capability, cid, node, *fields.values()]
        updates = ", ".join(f"{field} = EXCLUDED.{field}" for field in fields)
        conn.execute(
            f"INSERT INTO capabilities_connection_grants ({', '.join(columns)}) "
            f"VALUES ({', '.join(['%s'] * len(values))}) "
            "ON CONFLICT ((coalesce(agent_id, '')), capability, connection, "
            "(coalesce(node, ''))) "
            + (f"DO UPDATE SET {updates}" if updates else "DO NOTHING"),
            values)

    def _put_default_at(self, conn: Any, capability: str, cid: str | None,
                        agent: str | None, node: str | None) -> bool:
        cleared = conn.execute(
            "UPDATE capabilities_connection_grants SET is_default = false "
            "WHERE coalesce(agent_id, '') = coalesce(%s::text, '') AND capability = %s "
            "AND coalesce(node, '') = coalesce(%s::text, '') AND is_default",
            (agent, capability, node)).rowcount
        if cid is not None:
            self._put_grant_at(conn, capability, cid, {"is_default": True}, agent, node)
        return cleared > 0

    def set(self, capability: str, collection: str, key: str, value: Any,
            actor: str | None = None, note: str | None = None,
            scope: str | None = None, node: str | None = None) -> None:
        if collection not in self.collections:
            return FileRecords.set(self, capability, collection, key, value,
                                   actor=actor, note=note, scope=scope, node=node)
        _store_check("capability", capability, CAPABILITY_RE)
        _store_check("key", key, KEY_RE)
        _only_policy_names_a_node(collection, node)
        _refuse_record_write(capability, collection)
        agent = self._agent(scope)
        if collection == "setting" and key != "connection.default":
            def put(document: dict) -> dict:
                document[key] = value
                return document
            self.settings_write(capability, scope or "project", put, actor=actor)
            return None
        if collection == "setting":
            cid = value if isinstance(value, str) and value else None
            if value not in (None, "") and cid is None:
                raise StoreError("bad_default", "the default pointer names a connection id")
            self._write(lambda conn: self._put_default_at(
                conn, capability, cid, agent, self._authority(conn, scope, None, actor)))
            return None
        if collection == "identifier":
            def work(conn: Any) -> None:
                at = self._authority(conn, scope, None, actor)
                conn.execute(
                    "INSERT INTO capabilities_identifiers "
                    "(agent_id, capability, node, label, value, note) "
                    "VALUES (%s, %s, %s, %s, %s::jsonb, %s) "
                    "ON CONFLICT ((coalesce(agent_id, '')), capability, label, "
                    "(coalesce(node, ''))) "
                    "DO UPDATE SET value = EXCLUDED.value, note = EXCLUDED.note, "
                    "updated_at = now()",
                    (agent, capability, at, key, json.dumps(value, ensure_ascii=False),
                     note or ""))
            self._write(work)
            return None
        if collection == "policy":
            if (not isinstance(value, dict) or set(value) != {"enabled"}
                    or not isinstance(value["enabled"], bool)):
                raise StoreError("bad_policy", f"policy for {key!r} must be "
                                 '{"enabled": true|false}')
            wanted = _node_check(node)
            self._write(lambda conn: conn.execute(
                "INSERT INTO capabilities_policy (agent_id, capability, node, enabled) "
                "VALUES (%s, %s, %s, %s) "
                "ON CONFLICT ((coalesce(agent_id, '')), capability, (coalesce(node, ''))) "
                "DO UPDATE SET enabled = EXCLUDED.enabled, updated_at = now()",
                (agent, key, self._authority(conn, scope, wanted, actor), value["enabled"])))
            return None
        if collection == "connection":
            if not isinstance(value, dict):
                raise StoreError("bad_connection",
                                 f"connection {key!r} must be a table, got "
                                 f"{type(value).__name__}")
            spec = {k: v for k, v in value.items() if k not in GRANT_FIELDS}
            grant = {k: value[k] for k in GRANT_FIELDS if k in value}

            def work(conn: Any) -> None:
                at = self._authority(conn, scope, None, actor)
                if at is None:
                    conn.execute(
                        "INSERT INTO capabilities_connections (capability, name, spec) "
                        "VALUES (%s, %s, %s::jsonb) ON CONFLICT (capability, name) "
                        "DO UPDATE SET spec = EXCLUDED.spec",
                        (capability, key, json.dumps(spec, ensure_ascii=False)))
                else:
                    # A connection is one row for every agent and node, so a
                    # node that writes only its own rows may add one, never
                    # change one another node may use.
                    added = conn.execute(
                        "INSERT INTO capabilities_connections (capability, name, spec) "
                        "VALUES (%s, %s, %s::jsonb) ON CONFLICT (capability, name) "
                        "DO NOTHING", (capability, key,
                                       json.dumps(spec, ensure_ascii=False))).rowcount
                    if not added:
                        raise StoreError(
                            "node_read_only",
                            f"node {self.node} may add a connection but not change "
                            f"{capability} connection {key!r}, which every node shares",
                            f"change it on the master {self.agent.get('master')}")
                if grant:
                    fields, wanted = self._grant_value(key, grant)
                    self._put_grant_at(conn, capability, key, fields, agent,
                                       wanted if at is None else at)
            self._write(work)
            return None
        fields, wanted = self._grant_value(key, value)
        self._write(lambda conn: self._put_grant_at(
            conn, capability, key, fields, agent,
            self._authority(conn, scope, wanted, actor)))
        return None

    def delete(self, capability: str, collection: str, key: str,
               scope: str | None = None, node: str | None = None) -> bool:
        if collection not in self.collections:
            return FileRecords.delete(self, capability, collection, key,
                                      scope=scope, node=node)
        _only_policy_names_a_node(collection, node)
        _refuse_record_write(capability, collection)
        agent = self._agent(scope)
        if collection == "setting" and key != "connection.default":
            def drop(document: dict) -> dict:
                if key not in document:
                    # Nothing to remove leaves the document as it was, even
                    # one that does not exist yet.
                    raise _Unchanged()
                document.pop(key)
                return document
            try:
                self.settings_write(capability, scope or "project", drop)
            except _Unchanged:
                return False
            return True
        if collection == "setting":
            return bool(self._write(lambda conn: self._put_default_at(
                conn, capability, None, agent, self._authority(conn, scope, None, None))))
        wanted = _node_check(node) if collection == "policy" else None
        if collection == "identifier":
            sql = ("DELETE FROM capabilities_identifiers "
                   "WHERE coalesce(agent_id, '') = coalesce(%s::text, '') AND capability = %s "
                   "AND label = %s AND coalesce(node, '') = coalesce(%s::text, '')")
            target = (agent, capability, key)
        elif collection == "policy":
            sql = ("DELETE FROM capabilities_policy "
                   "WHERE coalesce(agent_id, '') = coalesce(%s::text, '') AND capability = %s "
                   "AND coalesce(node, '') = coalesce(%s::text, '')")
            target = (agent, key)
        elif collection == "grant":
            sql = ("DELETE FROM capabilities_connection_grants "
                   "WHERE coalesce(agent_id, '') = coalesce(%s::text, '') AND capability = %s "
                   "AND connection = %s AND coalesce(node, '') = coalesce(%s::text, '')")
            target = (agent, capability, key)
        else:
            def work(conn: Any) -> bool:
                if self._authority(conn, scope, None, None) is not None:
                    raise StoreError(
                        "node_read_only",
                        f"node {self.node} may not remove {capability} connection "
                        f"{key!r}, which every node shares",
                        f"remove it on the master {self.agent.get('master')}")
                return conn.execute(
                    "DELETE FROM capabilities_connections WHERE capability = %s "
                    "AND name = %s", (capability, key)).rowcount > 0
            return bool(self._write(work))
        return bool(self._write(lambda conn: conn.execute(
            sql, (*target, self._authority(conn, scope, wanted, None))).rowcount > 0))


def _only_policy_names_a_node(collection: str, node: Any) -> None:
    """A grant names its node inside its value; a policy row is the one record
    written for a node through `node`."""
    if node is not None and collection != "policy":
        raise StoreError("bad_node", f"a {collection} record is not written for a "
                         "node this way; only a policy row is")


def _stamp(moment: Any) -> str | None:
    """A row's time of writing as the text a report carries."""
    return moment.isoformat() if hasattr(moment, "isoformat") else moment


def _identity_record(envelope: Path) -> dict[str, Any]:
    try:
        identity = json.loads((Path(envelope) / "project.json").read_text())
    except (OSError, ValueError):
        return {}
    return identity if isinstance(identity, dict) else {}


def records_mode(envelope: Path | str) -> str:
    """Where this project keeps its records: `files`, unless its
    `project.json` says `"records": "store"`. Only that record decides it."""
    identity_file = Path(envelope) / "project.json"
    declared = _identity_record(Path(envelope)).get(RECORDS_MODE_KEY, "files")
    if declared not in RECORDS_MODES:
        raise StoreError("bad_records_mode",
                         f"{identity_file} declares records {declared!r}",
                         f"one of: {', '.join(RECORDS_MODES)}; the manager writes it")
    return declared


def connections_mode(envelope: Path | str) -> str:
    """Where this project keeps its connections and grants: `store` when its
    records are in the store or its `project.json` says `"connections":
    "store"`, `files` otherwise. Only that record decides it."""
    if records_mode(envelope) == "store":
        return "store"
    identity_file = Path(envelope) / "project.json"
    declared = _identity_record(Path(envelope)).get(CONNECTIONS_MODE_KEY, "files")
    if declared not in CONNECTIONS_MODES:
        raise StoreError("bad_connections_mode",
                         f"{identity_file} declares connections {declared!r}",
                         f"one of: {', '.join(CONNECTIONS_MODES)}; the manager writes it")
    return declared


def open_records(envelope: Path | str, global_dir: Path | str,
                 project_only: bool = False, project_root: Path | str | None = None,
                 project_id: str | None = None,
                 application_name: str = STORE_OWNER,
                 actor: str | None = None) -> Records:
    """The adapter this project's configuration is read and written through:
    the project's envelope, then `global_dir` unless `project_only`; in store
    mode a project's connections, grants, identifiers and policy come from its
    store instead (only its connections and grants where it moved only those),
    for the project id given (else project.json's), its database resolved for
    `project_root` (else the envelope's parent).

    Where a database resolves, the agent's registry row decides first: an
    agent whose `migrated_at` is set reads and writes all its records and its
    settings in the store (`AgentRecords`), whatever `project.json` says, and
    only on a node it has registered, named by AGENT_NODE_NAME. Every other
    project is read as above. Asking cannot fail a project whose records are
    files: a store that does not answer within `_PROBE_TIMEOUT` leaves it on
    its files. A project in store mode whose store does not answer keeps the
    refusal for its settings, rather than reading files that may be stale.
    `actor` names a writer that is not the person running the command:
    `migrate` or `<capability>-service`.

    A `project.json` that declares a `store` other than `files` is refused
    rather than read as files, since the records it points at are not where it
    says."""
    envelope, global_dir = Path(envelope), Path(global_dir)
    identity_file = envelope / "project.json"
    identity = _identity_record(envelope)
    declared = identity.get("store", "files")
    if declared != "files":
        raise StoreError("bad_store_mode",
                         f"{identity_file} declares store {declared!r}; records are "
                         "kept only in files",
                         'remove "store" from project.json, or set it to "files"')
    root = Path(project_root) if project_root else None
    in_store = connections_mode(envelope) == "store"
    agent_id = project_id or identity.get("id")
    if in_store:
        held = (RECORDS_MODE_KEY if records_mode(envelope) == "store"
                else CONNECTIONS_MODE_KEY)
        legacy: Records = StoreRecords(
            envelope, global_dir, agent_id, identity.get("slug"),
            include_global=not project_only, project_root=root,
            application_name=application_name, held=held)
    else:
        legacy = FileRecords(envelope, global_dir, identity.get("id"), identity.get("slug"),
                             include_global=not project_only)
    legacy._guard_agent = agent_id if isinstance(agent_id, str) and agent_id else None
    legacy._guard_root = root
    legacy._guard_application = application_name
    legacy.actor = actor
    if legacy._guard_agent is None:
        return legacy
    try:
        conn, schema = _store_connect(root or envelope.parent, application_name,
                                      None if in_store else _PROBE_TIMEOUT)
    except StoreError as exc:
        if in_store and exc.slug != "store_not_configured":
            legacy._settings_blocked = exc
        return legacy
    import psycopg
    try:
        state = _agent_state(conn, agent_id)
        conn.rollback()
    except psycopg.Error as exc:
        try:
            conn.close()
        except Exception:
            pass
        if in_store:
            legacy._settings_blocked = StoreError(
                "store_unreachable", f"cannot read the agent registry: {exc}",
                "check the database setting with `capabilities store doctor`")
        return legacy
    conn.close()
    if not state or not state.get("migrated_at"):
        if in_store:
            legacy._schema = schema
        return legacy
    node = os.environ.get(NODE_NAME_ENV, "").strip()
    if not node or node not in state["nodes"]:
        if not node:
            raise StoreError(
                "node_unnamed",
                f"agent {agent_id} keeps its records in the store, read per node, and "
                f"this process names no node: {NODE_NAME_ENV} is not set",
                _master_hint(state))
        raise StoreError(
            "node_unregistered",
            f"agent {agent_id} keeps its records in the store, and node {node} is "
            "not one of its nodes", _master_hint(state))
    adapter = AgentRecords(envelope, global_dir, agent_id, identity.get("slug"),
                           agent=state, node=node, include_global=not project_only,
                           project_root=root, application_name=application_name,
                           actor=actor)
    adapter._guard_root = root
    adapter._guard_application = application_name
    adapter._schema = schema
    return adapter

# <<< contract: store <<<


# >>> contract: connections (generated — edit contract/preamble.py, run `capabilities sync-contract`) >>>

def _resolve_env_key(key: str) -> tuple[str | None, str | None, Path | None]:
    """Resolve one env key through cascade tiers 2-4: project .env(.local) →
    user credentials.env → process env. Returns (value, tier, source)."""
    root = _project_root()
    if root is not None:
        for fname in (".env.local", ".env"):
            val = _parse_env_file(root / fname).get(key)
            if val:
                return val, "project", root / fname
    val = _parse_env_file(CREDENTIALS_ENV).get(key)
    if val:
        return val, "user", CREDENTIALS_ENV
    val = os.environ.get(key)
    if val:
        return val, "env", None
    return None, None, None


def _mask(value: str) -> str:
    return ("…" + value[-4:]) if len(value) >= 8 else "****"


def _grant_hint(cid: str) -> str:
    """One wording for the one way a project grants an inherited connection.

    Same shape as `_write_gate`'s: the gate is the human's to lift, never the
    agent's, and the hint carries the exact command rather than a description
    of one. Where no project resolves there is no scope to grant in, so the
    hint names the command that makes one and then the grant, in the order they
    have to happen."""
    grant = f"`capabilities set {NAME} grant {cid} '{{\"enabled\": true}}'`"
    if _project_root() is None:
        return ("Do not lift the gate yourself — ask the user; run "
                f"`capabilities init` in the project that should use {NAME}, "
                f"then {grant} there.")
    return ("Do not lift the gate yourself — ask the user; granting is "
            f"{grant} run inside this project.")


# The connections the machine lent this process for a machine read, by id, each
# with the file it was declared in; empty in every other process.
_MACHINE_LENT: dict = {}


def _grant_gate(reg: dict, cid: str) -> None:
    """Refuse a connection this project may not use, for read as for write.

    A connection declared outside the project is not the project's to use until
    the project itself says so, and one the project switched off is off;
    nothing in the cascade lifts either. Outside a project there is no scope in
    which anything could have said so, which is a different situation and says
    so rather than asserting a project that is not there."""
    entry = (reg.get("withheld") or {}).get(cid)
    if entry is None:
        return
    if entry.get("scope") == "project":
        message = f"connection {cid!r} is disabled in this project"
    elif _machine_read():
        message = (f"connection {cid!r} is switched off on this machine by "
                   f"its grant")
    elif _project_root() is None:
        message = (f"connection {cid!r} is declared globally and there is no "
                   f"project here to grant it in")
    else:
        message = (f"connection {cid!r} is declared outside this project and "
                   f"this project has not granted it")
    _die(4, "connection_not_granted", message, _grant_hint(cid))


def _connections_composed() -> dict:
    """The connections envelope shape, composed out of resolved records.

    Deliberately reconstituted rather than returned in some store-shaped form:
    selection, the write gate and the `connections` report all read the envelope
    shape, and they should not learn where the rows came from. What changes here
    is the source, never the shape.

    The permission a project was granted is folded back onto the entry as
    `allow_write`, which is where the rest of the contract looks for it.

    A connection this project may not use is kept apart under `withheld`, not
    dropped: `connections` holds exactly what may be acted on — which is what
    every capability's own report iterates — while selection still has the name
    it needs to explain a refusal instead of pretending the connection was
    never declared.

    `sources` names, per connection, the file its identity was read out of. An
    identity is taken whole from one scope, so each connection has exactly one
    origin, and a project that merely granted an inherited connection is not
    where that connection's values are written. It is kept beside the entries
    rather than folded into them because it describes a record rather than
    configuring one: nothing resolves through it, and its one reader is each
    capability's own report, naming the origin of its `connection`-tier keys."""
    adapter = _records()
    machine = _machine_read()
    _MACHINE_LENT.clear()
    try:
        effective = adapter.connections(NAME, write_default=WRITE_DEFAULT,
                                        include_disabled=True,
                                        machine_read=machine)
        default = adapter.get(NAME, "setting", "connection.default")
        source = adapter.collection_source(NAME, "connection")
    except StoreError as e:
        _die(5 if e.slug in STORE_ENVIRONMENT_SLUGS else 6, e.slug, e.message, e.hint)
    if not effective:
        _die(6, "connections_required",
             f"{NAME} requires an explicit connections registry and "
             f"{source} holds none",
             'expected {"default": "<id>", "connections": {"<id>": { ... }}}')
    usable = {cid: e for cid, e in effective.items() if e["enabled"]}
    withheld = {cid: e for cid, e in effective.items() if not e["enabled"]}
    if not usable:
        named = ", ".join(sorted(withheld))
        if machine:
            refusal = (f"every {NAME} connection this machine declares is "
                       f"switched off by its grant: {named}")
        elif _project_root() is None:
            refusal = (f"there is no project here to use a {NAME} connection in, "
                       f"so every connection declared globally stays "
                       f"withheld: {named}")
        else:
            refusal = (f"no {NAME} connection is usable in this project; every "
                       f"one it can see is withheld: {named}")
        _die(4, "connection_not_granted", refusal, _grant_hint("<id>"))
    sources = {cid: adapter.scope_source(NAME, "connection", entry["scope"][0])
               for cid, entry in usable.items()}
    _MACHINE_LENT.update({cid: sources[cid] for cid, entry in usable.items()
                          if entry.get("machine_read")})
    return {
        "default": default,
        "connections": {cid: {**entry["value"], "allow_write": entry["allow_write"]}
                        for cid, entry in usable.items()},
        "sources": sources,
        "withheld": {cid: {"scope": entry["scope"][0]}
                     for cid, entry in withheld.items()},
    }


def _inventory_connections(machine_read: bool | None = None) -> dict:
    """Every connection this project declares, granted or not.

    An inventory reports where selection refuses, so this is deliberately the
    one connection read that never dies: no registry is zero connections, and
    a connection the project may not act on is still a connection worth
    showing. `granted` carries which is which. `machine_read` asks as one of
    the capability's machine reads would, else as the invoked verb does."""
    machine = _machine_read() if machine_read is None else bool(machine_read)
    try:
        adapter = _records()
        effective = adapter.connections(NAME, write_default=WRITE_DEFAULT,
                                        include_disabled=True,
                                        machine_read=machine) or {}
        default = adapter.get(NAME, "setting", "connection.default")
    except StoreError:
        return {"default": None, "connections": {}}
    return {"default": default,
            "connections": {
                cid: {**entry["value"], "allow_write": entry["allow_write"],
                      "granted": bool(entry["enabled"])}
                for cid, entry in effective.items()}}


def _connections_registry() -> tuple[dict | None, Path | str | None]:
    """The connections envelope and where it came from.

    Composed from the two records a connection is kept as -- who it is, and
    what this project may do with it -- and handed on in the shape the rest of
    the contract already reads, so selection, the write gate and the report
    never learn which source answered.

    The path returned beside it answers for the collection -- where this project
    reads connections from. Where one connection's own values came from is a
    question about that connection, and `reg["sources"][cid]` is what answers
    it."""
    return _connections_composed(), _records().collection_source(NAME, "connection")


def _select_connection(reg: dict | None, wanted: str | None) -> tuple[str, dict | None]:
    """flag → default pointer → sole entry → die 6. A connection's own
    `address` field selects it too (used where a
    connection carries a human-recognizable address; absent fields never match).

    A connection the project was never granted is refused here rather than
    reported missing, so the one enforcement point every capability already
    routes through is also the one that answers "why not"."""
    if reg is None:
        _die(6, "connections_required",
             f"{NAME} requires an explicit connections registry")
    conns = reg["connections"]
    if wanted:
        if wanted in conns:
            return wanted, conns[wanted]
        for cid, entry in conns.items():
            if (entry or {}).get("address", "").lower() == wanted.lower():
                return cid, entry
        _grant_gate(reg, wanted)
        _die(6, "unknown_connection", f"no connection matches {wanted!r}",
             f"known: {', '.join(conns)}")
    default = reg.get("default")
    if default:
        if default not in conns:
            _grant_gate(reg, default)
            _die(6, "bad_default", f"default points to unknown connection {default!r}",
                 f"known: {', '.join(conns)}")
        return default, conns[default]
    if len(conns) == 1:
        cid = next(iter(conns))
        return cid, conns[cid]
    _die(6, "ambiguous_connection",
         f"registry defines {len(conns)} connections and no default; "
         f"pass --connection <id>",
         f"known: {', '.join(conns)}")


def _write_gate(conn_id: str, allow_write: bool, verb: str) -> None:
    """Policy from the committed registry; nothing in the cascade lifts it.
    The read-only switch closes it for every connection and names itself."""
    if verb in WRITE_VERBS:
        _read_only_gate(f"write verb {verb!r} on connection {conn_id!r}")
    if verb in WRITE_VERBS and not allow_write and conn_id in _MACHINE_LENT:
        _die(4, "read_only",
             f"connection {conn_id!r} is the machine's, lent read-only to a "
             f"machine read outside any project",
             "Do not lift the gate yourself — ask the user; a write runs "
             "inside a project that grants this connection.")
    if verb in WRITE_VERBS and not allow_write:
        _die(4, "read_only",
             f"connection {conn_id!r} does not allow writes",
             "Do not lift the gate yourself — ask the user; granting is "
             f"`capabilities set {NAME} grant {conn_id} '{{\"allow_write\": true}}'` "
             "run inside this project.")


def _key_report(key: str, secret: bool, required: bool,
                value: str | None, tier: str | None, source) -> dict:
    return {"key": key, "secret": secret, "required": required,
            "set": bool(value), "tier": tier if value else None,
            "source": str(source) if (value and source) else None,
            "value": (_mask(value) if secret else value) if value else None}


def _missing_required(keys: list) -> list:
    """Required report rows (from _key_report) that did not resolve through the
    cascade — empty ⇒ credentials present. The primitive behind doctor's
    network-free readiness gate, read from the same per-key resolution
    `connections` reports, so the gate and the report can never disagree."""
    return [k["key"] for k in keys if k["required"] and not k["set"]]


def _doctor_gate(report: dict, wanted: str | None) -> None:
    """doctor's network-free readiness gate. Refuse with exit 2 — naming the
    unresolved required keys, before any round-trip — when a connection under
    test cannot resolve its required config through the cascade, so readiness is
    judged by the same resolution `connections` reports, never a parallel check.
    Checks the selected connection, else every connection in the report."""
    conns = report.get("connections") or {}
    targets = [wanted] if (wanted and wanted in conns) else list(conns)
    problems: dict = {}
    for cid in targets:
        miss = _missing_required((conns.get(cid) or {}).get("keys") or [])
        if miss:
            problems[cid] = miss
    if problems:
        detail = "; ".join(f"{c}: {', '.join(ks)}" for c, ks in sorted(problems.items()))
        _die(2, "credentials_missing",
             f"unresolved required config — {detail}",
             f"set each in the project .env/.env.local, the user credentials.env, "
             f"or process env; `{NAME} connections` shows where every value resolves")


# --- Writing connections and the machine's setup -----------------------------
#
# `connection add|remove` and `setup` are the one way every capability takes a
# connection or a machine prerequisite from a person: the fields are the ones
# the script declares (CONN_FIELDS, SETUP_FIELDS), a secret arrives on standard
# input and never on argv, and it is written to the credentials file of the
# scope the record lands in - the project's .env.local, or the capability's
# credentials.env in the user's config home - never into a record.

def _env_file_key(line: str) -> str | None:
    stripped = line.strip()
    if not stripped or stripped.startswith("#") or "=" not in stripped:
        return None
    key = stripped.split("=", 1)[0].strip()
    if key.startswith("export "):
        key = key[len("export "):].strip()
    return key


def _env_file_write(path: Path, values: dict) -> None:
    """Set or drop keys in an env file, keeping every other line as it was.

    A value of None drops its key. Values are written single-quoted, which the
    contract's parser reads back whole, the file is replaced atomically at mode
    0600, and every write is proven by reading it back through that parser."""
    for key, value in values.items():
        if value is not None and ("'" in value or "\n" in value or "\r" in value):
            _die(6, "input", f"the value for {key} holds a quote or a line break, "
                 "which an env file cannot carry")
    lines = path.read_text().splitlines() if path.exists() else []
    out, done = [], set()
    for line in lines:
        key = _env_file_key(line)
        if key in values:
            if key not in done and values[key] is not None:
                out.append(f"{key}='{values[key]}'")
            done.add(key)
            continue
        out.append(line)
    for key, value in values.items():
        if key not in done and value is not None:
            out.append(f"{key}='{value}'")
    path.parent.mkdir(parents=True, exist_ok=True)
    spare = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    fd = os.open(spare, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write("\n".join(out) + ("\n" if out else ""))
        os.chmod(spare, 0o600)
        os.replace(spare, path)
    finally:
        if spare.exists():
            spare.unlink()
    os.chmod(path, 0o600)
    held = _parse_env_file(path)
    for key, value in values.items():
        if held.get(key) != value and not (value is None and key not in held):
            _die(5, "credentials_write_failed",
                 f"{path} does not read back what was written for {key}")


def _field_args(argv: list[str], usage: str) -> tuple[dict, list[str], bool]:
    """`--field KEY=VALUE` pairs, the remaining words, and whether `--stdin`
    was asked for."""
    fields, words, stdin = {}, [], False
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--field":
            if i + 1 >= len(argv) or "=" not in argv[i + 1]:
                _die(6, "input", "--field takes KEY=VALUE", usage)
            key, value = argv[i + 1].split("=", 1)
            fields[key.strip()] = value
            i += 2
        elif arg.startswith("--field="):
            pair = arg[len("--field="):]
            if "=" not in pair:
                _die(6, "input", "--field takes KEY=VALUE", usage)
            key, value = pair.split("=", 1)
            fields[key.strip()] = value
            i += 1
        elif arg == "--stdin":
            stdin = True
            i += 1
        else:
            words.append(arg)
            i += 1
    return fields, words, stdin


def _declared_values(declared: list, argv_values: dict, stdin: bool,
                     what: str) -> dict:
    """The values a person gave, each checked against its declared field: argv
    carries no secret, stdin carries a JSON object, and null clears a field."""
    by_key = {f["key"]: f for f in declared}
    given: dict = {}
    for key, raw in argv_values.items():
        field = by_key.get(key)
        if field is None:
            _die(6, "unknown_field", f"{NAME} declares no {what} field {key!r}",
                 f"fields: {', '.join(by_key) or 'none'}")
        if field.get("secret"):
            _die(6, "secret_on_argv", f"{key} is a secret and is never taken on argv",
                 "pass it in the JSON object on stdin with --stdin")
        try:
            given[key] = _field_value(field, raw, from_argv=True)
        except ValueError as e:
            _die(6, "bad_field", str(e))
    if stdin:
        for key, raw in _stdin_document(f"the {what} fields").items():
            field = by_key.get(key)
            if field is None:
                _die(6, "unknown_field", f"{NAME} declares no {what} field {key!r}",
                     f"fields: {', '.join(by_key) or 'none'}")
            if raw is None:
                given[key] = None
                continue
            try:
                given[key] = _field_value(field, raw)
            except ValueError as e:
                _die(6, "bad_field", str(e))
    return given


def _connection_env_name(field: dict, cid: str) -> str:
    """The env key a secret field's value is written under for one connection."""
    import re as _re
    ident = _re.sub(r"[^A-Z0-9]", "_", cid.upper())
    template = field.get("env") or (
        f"{_re.sub(r'[^A-Z0-9]', '_', NAME.upper())}_{{ID}}_"
        f"{_re.sub(r'[^A-Z0-9]', '_', field['key'].upper().removesuffix('_ENV'))}")
    return template.replace("{ID}", ident)


def _connection_scope(words: list[str], usage: str) -> tuple[str, list[str]]:
    """The scope a connection is written at. `--machine` is the machine's
    scope, `--global`'s, named as administration of the machine
    (`_machine_administration`), so it cannot be asked of a project."""
    scope = "project"
    rest = []
    for word in words:
        if word in ("--project", "--global", "--machine"):
            scope = word[2:]
        else:
            rest.append(word)
    if "--machine" in words and "--project" in words:
        _die(6, "input", "--machine writes the machine's connection, --project this "
             "project's; pass one", usage)
    return ("global" if scope == "machine" else scope), rest


def _connection_grantees(adapter, cid: str, scope: str, root) -> list:
    """The projects a connection removed at `scope` is granted to and would be
    taken from: every project the store holds an enabling grant for, for a
    connection kept in the store; the project the call runs in, for a
    connection of the machine it grants and does not declare itself. A
    project's own connection in its files is granted to no other project."""
    if scope == "global":
        if root is None or adapter.mode_of("grant") != "files":
            return []
        grant = (adapter.resolve_scope(NAME, "grant", "project").get(cid) or {}).get("value")
        own = (adapter.resolve_scope(NAME, "connection", "project").get(cid) or {}).get("value")
        if isinstance(grant, dict) and grant.get("enabled") is True and not own:
            return [str(root)]
        return []
    if adapter.mode_of("connection") == "store":
        return adapter.grantees(NAME, cid)
    return []


def _scope_credentials(scope: str) -> Path:
    if scope == "global":
        return CREDENTIALS_ENV
    return _project_root() / ".env.local"


def _cmd_connection(argv: list[str]) -> None:
    """`connection add <id>` writes one connection from its declared fields,
    its secrets into the scope's credentials file; `connection remove <id>`
    takes it out again with the secrets it wrote."""
    usage = (f"{NAME} connection add <id> [--project|--global|--machine] [--default] "
             "[--replace] [--field KEY=VALUE ...] [--env KEY=ENV_KEY ...] [--stdin] | "
             f"{NAME} connection remove <id> [--project|--global|--machine]")
    import re as _re
    sub = argv[0] if argv else ""
    if sub not in ("add", "remove"):
        _die(6, "input", f"unknown connection subcommand {sub!r}", usage)
    # `--env KEY=ENV_KEY` names, for a secret field, an env key already set,
    # so the entry points at it and no value is copied.
    named: dict = {}
    rest_argv: list = []
    i = 1
    while i < len(argv):
        arg = argv[i]
        if arg == "--env" or arg.startswith("--env="):
            pair = arg[len("--env="):] if arg.startswith("--env=") else (
                argv[i + 1] if i + 1 < len(argv) else "")
            if "=" not in pair:
                _die(6, "input", "--env takes KEY=ENV_KEY", usage)
            key, env_key = pair.split("=", 1)
            named[key.strip()] = env_key.strip()
            i += 1 if arg.startswith("--env=") else 2
        else:
            rest_argv.append(arg)
            i += 1
    if named and sub != "add":
        _die(6, "input", "--env is an option of connection add", usage)
    argv_values, words, stdin = _field_args(rest_argv, usage)
    default = "--default" in words
    replace = "--replace" in words
    if replace and sub != "add":
        _die(6, "input", "--replace is an option of connection add", usage)
    words = [w for w in words if w not in ("--default", "--replace")]
    scope, rest = _connection_scope(words, usage)
    flags = [w for w in rest if w.startswith("--")]
    if flags:
        _die(6, "input", f"unknown connection option {flags[0]!r}", usage)
    if len(rest) != 1:
        _die(6, "input", f"connection {sub} names one connection id", usage)
    cid = rest[0]
    if not _re.fullmatch(r"[a-z0-9][a-z0-9._@+-]{0,127}", cid, _re.IGNORECASE):
        _die(6, "input", f"connection id {cid!r} is letters, digits and . _ @ + -")
    _read_only_gate(f"`{NAME} connection {sub}`")
    declared = globals().get("CONN_FIELDS")
    if declared is None:
        _die(6, "connection_fields_undeclared",
             f"{NAME} does not declare its connection fields",
             f"`{NAME} help` says how its connections are written")
    root = _project_root()
    if scope == "project":
        if root is None:
            _die(6, "no_project", f"--project writes this project's {NAME} connection "
                 "and there is no project here", "run it inside the project, or pass --global")
        if not _project_capabilities_dir(root).is_dir():
            _die(6, "no_envelope", "no capabilities/ envelope in this project",
                 "run `capabilities init` first")
    adapter = _records()
    try:
        held = adapter.resolve_scope(NAME, "connection", scope).get(cid)
    except StoreError as e:
        _die(5 if e.slug in STORE_ENVIRONMENT_SLUGS else 6, e.slug, e.message, e.hint)
    existing = dict((held or {}).get("value") or {})
    credentials = _scope_credentials(scope)

    if sub == "remove":
        if held is None:
            _die(3, "unknown_connection", f"no {scope} connection {cid!r}",
                 f"`{NAME} connections` lists them")
        try:
            grantees = _connection_grantees(adapter, cid, scope, root)
        except StoreError as e:
            _die(5 if e.slug in STORE_ENVIRONMENT_SLUGS else 6, e.slug, e.message, e.hint)
        if grantees:
            _die(6, "connection_granted",
                 f"connection {cid!r} is granted to {len(grantees)} project(s), so "
                 f"removing it would take it from them: {', '.join(grantees)}",
                 "ask the user; each project switches its grant off first, with "
                 f"`capabilities set {NAME} grant {cid} '{{\"enabled\": false}}'` "
                 "run in that project")
        others = {}
        try:
            for other, row in adapter.resolve_scope(NAME, "connection", scope).items():
                if other != cid:
                    others[other] = row.get("value") or {}
            pointer = adapter.resolve_scope(NAME, "setting", scope).get("connection.default")
            adapter.delete(NAME, "connection", cid, scope=scope)
            was_default = bool(pointer and pointer.get("value") == cid)
            if was_default:
                adapter.delete(NAME, "setting", "connection.default", scope=scope)
            source = adapter.scope_source(NAME, "connection", scope)
        except StoreError as e:
            _die(5 if e.slug in STORE_ENVIRONMENT_SLUGS else 6, e.slug, e.message, e.hint)
        removed, kept = [], []
        for field in declared:
            env_key = existing.get(field["key"]) if field.get("secret") else None
            if not isinstance(env_key, str) or not env_key:
                continue
            shared = any(entry.get(field["key"]) == env_key for entry in others.values())
            if env_key == _connection_env_name(field, cid) and not shared \
                    and env_key in _parse_env_file(credentials):
                removed.append(env_key)
            else:
                kept.append(env_key)
        if removed:
            _env_file_write(credentials, {key: None for key in removed})
        _emit({"ok": True, "action": "remove", "connection": cid, "scope": scope,
               "registry": source, "default_cleared": was_default,
               "credentials": str(credentials) if removed else None,
               "secrets_removed": removed, "secrets_kept": kept})
        return

    if held is not None and not replace:
        _die(6, "connection_exists",
             f"a {scope} connection {cid!r} already exists, and connection add "
             "writes over it only when asked to",
             f"pass --replace to change it, keeping every field not given; "
             f"`{NAME} connections` shows it as it resolves")
    given = _declared_values(declared, argv_values, stdin, "connection")
    by_key = {f["key"]: f for f in declared}
    for key, env_key in named.items():
        if key not in by_key:
            _die(6, "unknown_field", f"{NAME} declares no connection field {key!r}",
                 f"fields: {', '.join(by_key) or 'none'}")
        if not by_key[key].get("secret"):
            _die(6, "input", f"--env names the env key of a secret field, and {key} is "
                 "not one", f"give {key} with --field {key}=VALUE")
        if key in given:
            _die(6, "input", f"{key} is given both as a value and as an env key name",
                 "pass one")
        # The name is not echoed: a secret given here by mistake stays off the output.
        if not _re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", env_key):
            _die(6, "bad_field", f"--env {key} takes the name of an env key")
        if not _resolve_env_key(env_key)[0]:
            _die(6, "env_key_unset",
                 f"the env key --env names for {key} is set in none of the project's "
                 f".env.local or .env, {CREDENTIALS_ENV}, or the environment",
                 "set it there first, or give the secret itself in the JSON object "
                 "on stdin")
    entry = dict(existing)
    secrets: dict = {}
    for field in declared:
        key = field["key"]
        if key in named:
            entry[key] = named[key]
        elif key in given:
            value = given[key]
            if value is None:
                entry.pop(key, None)
            elif field.get("secret"):
                # Always this connection's own key: a key the entry named
                # before may be shared with another connection.
                env_key = _connection_env_name(field, cid)
                secrets[env_key] = value
                entry[key] = env_key
            else:
                entry[key] = value
        elif key not in entry and field.get("secret") and field.get("required"):
            env_key = _connection_env_name(field, cid)
            if _resolve_env_key(env_key)[0]:
                entry[key] = env_key
        elif key not in entry and field.get("default") is not None and field.get("required"):
            entry[key] = field["default"]
    missing = [f["key"] for f in declared if f.get("required") and entry.get(f["key"]) in (None, "")]
    if missing:
        _die(6, "fields_required", f"connection {cid!r} needs: {', '.join(missing)}",
             f"`{NAME} manifest` lists the fields; secrets go in the JSON object on stdin")
    if secrets:
        _env_file_write(credentials, secrets)
    try:
        adapter.set(NAME, "connection", cid, entry, scope=scope)
        if default:
            adapter.set(NAME, "setting", "connection.default", cid, scope=scope)
        source = adapter.scope_source(NAME, "connection", scope)
    except StoreError as e:
        _die(5 if e.slug in STORE_ENVIRONMENT_SLUGS else 6, e.slug, e.message, e.hint)
    report = []
    for field in declared:
        value = entry.get(field["key"])
        row = {"key": field["key"], "secret": bool(field.get("secret")),
               "set": value not in (None, "")}
        if field.get("secret") and isinstance(value, str) and value:
            resolved, tier, where = _resolve_env_key(value)
            row.update({"env": value, "set": bool(resolved), "tier": tier,
                        "source": str(where) if where else None,
                        "value": _mask(resolved) if resolved else None})
        else:
            row["value"] = value
        report.append(row)
    out = {"ok": True, "action": "add" if held is None else "update",
           "connection": cid, "scope": scope, "registry": source,
           "credentials": str(credentials) if secrets else None,
           "default": default, "fields": report,
           "next": f"`{NAME} doctor --connection {cid}` proves it"}
    methods = globals().get("LINK_METHODS") or []
    if methods:
        out["link"] = [m.get("id") for m in methods]
        out["next"] = (f"link it with one of `{NAME} manifest`'s connections.link "
                       f"methods, adding --connection {cid}")
    if scope == "global" and root is not None:
        out["hint"] = _grant_hint(cid)
    _emit(out)


def _cmd_setup(argv: list[str]) -> None:
    """`setup` reports the machine prerequisites the capability declares and
    where each resolves from; `setup set` writes them to the capability's
    credentials.env, secrets from stdin; `setup unset` takes them out.
    `--machine` names a write as administration of the machine
    (`_machine_administration`)."""
    usage = (f"{NAME} setup [show] | setup set [--machine] [--field KEY=VALUE ...] "
             "[--stdin] | setup unset [--machine] <KEY> ...")
    declared = list(globals().get("SETUP_FIELDS") or [])
    sub = argv[0] if argv and not argv[0].startswith("--") else "show"
    rest = argv[1:] if argv and argv[0] == sub else argv
    if sub not in ("show", "set", "unset"):
        _die(6, "input", f"unknown setup subcommand {sub!r}", usage)
    if sub != "show":
        rest = [w for w in rest if w != "--machine"]
    changed: list = []
    if sub == "set":
        argv_values, words, stdin = _field_args(rest, usage)
        if words:
            _die(6, "input", f"unexpected {words[0]!r}", usage)
        _read_only_gate(f"`{NAME} setup set`")
        given = _declared_values(declared, argv_values, stdin, "setup")
        if not given:
            _die(6, "input", "setup set was given nothing to set", usage)
        _env_file_write(CREDENTIALS_ENV, {
            key: (None if value is None else
                  ("true" if value is True else "false" if value is False else
                   json.dumps(value) if isinstance(value, (list, dict)) else str(value)))
            for key, value in given.items()})
        changed = sorted(given)
    elif sub == "unset":
        keys = [w for w in rest if not w.startswith("--")]
        known = {f["key"] for f in declared}
        unknown = [k for k in keys if k not in known]
        if not keys or unknown:
            _die(6, "unknown_field" if unknown else "input",
                 f"{NAME} declares no setup field {unknown[0]!r}" if unknown
                 else "setup unset names the keys to remove", usage)
        _read_only_gate(f"`{NAME} setup unset`")
        _env_file_write(CREDENTIALS_ENV, {key: None for key in keys})
        changed = sorted(keys)
    fields = []
    for field in declared:
        value, tier, source = _resolve_env_key(field["key"])
        secret = bool(field.get("secret"))
        fields.append({**field, "set": bool(value), "tier": tier if value else None,
                       "source": str(source) if (value and source) else None,
                       "value": (_mask(value) if secret else value) if value else None})
    out = {"capability": NAME, "credentials": str(CREDENTIALS_ENV),
           "ready": all(f["set"] for f in fields if f.get("required")),
           "fields": fields}
    if sub != "show":
        out.update({"ok": True, "action": sub, "changed": changed})
    _emit(out)

# <<< contract: connections <<<


# ── I/O envelope ────────────────────────────────────────────────────────────────


# ── Cascade & gate ──────────────────────────────────────────────────────────────


# ── Connections ─────────────────────────────────────────────────────────────────

# Each connection bundles two secrets (the Fathom API key and the DB password)
# and four non-secret DB fields. See deviations.md — the standard's single
# `secret_env` becomes a named pair, fathom_key_env + db_password_env.

DB_FIELDS = (   # (entry field, env key for an override-free entry, default, required)
    ("db_host", "FATHOM_DB_HOST", None, True),
    ("db_port", "FATHOM_DB_PORT", "5432", False),
    ("db_user", "FATHOM_DB_USER", "postgres", False),
    ("db_name", "FATHOM_DB_NAME", "postgres", False),
    ("db_sslmode", "FATHOM_DB_SSLMODE", "require", False),
)


def _build_conn(cid: str, entry: dict | None) -> tuple[dict | None, dict | None]:
    """Materialize one connection. Returns (conn, problem) — problem is an error
    dict ({"exit","code","message","hint"?}) instead of a die, so doctor can
    report every connection rather than stopping at the first."""
    if entry is None:   # declared entry without overrides — use the flat-key cascade
        fathom_key, _, _ = _resolve_env_key("FATHOM_API_KEY")
        db_password, _, _ = _resolve_env_key("FATHOM_DB_PASSWORD")
        db = {}
        for field, env_key, default, _required in DB_FIELDS:
            val, _, _ = _resolve_env_key(env_key)
            db[field] = val or default
        missing = []
        if not fathom_key:
            missing.append("FATHOM_API_KEY")
        if not db_password:
            missing.append("FATHOM_DB_PASSWORD")
        if not db["db_host"]:
            missing.append("FATHOM_DB_HOST")
        if missing:
            return None, {
                "exit": 2, "code": "missing_credentials",
                "message": f"unset: {', '.join(missing)}",
                "hint": f"set them in the project .env(.local), {CREDENTIALS_ENV}, "
                        f"or the environment — or declare a connections registry "
                        f"(~/.config/{NAME}/connections.json). Full runbook: "
                        f"`{NAME} guide setup`"}
        return {"id": cid, "allow_write": WRITE_DEFAULT, "fathom_key": fathom_key,
                "db_password": db_password, **db}, None
    # registry entry — non-secret DB fields literal, secrets by env-key indirection
    fathom_env = entry.get("fathom_key_env")
    db_pw_env = entry.get("db_password_env")
    if not fathom_env or not db_pw_env:
        miss = [k for k in ("fathom_key_env", "db_password_env") if not entry.get(k)]
        return None, {"exit": 6, "code": "no_secret_env",
                      "message": f"connection {cid!r} is missing: {', '.join(miss)}"}
    fathom_key, _, _ = _resolve_env_key(fathom_env)
    db_password, _, _ = _resolve_env_key(db_pw_env)
    unset = [e for e, v in ((fathom_env, fathom_key), (db_pw_env, db_password)) if not v]
    if unset:
        return None, {
            "exit": 2, "code": "missing_secret",
            "message": f"env var(s) {', '.join(unset)} (for connection {cid!r}) unset",
            "hint": f"set them in the project's .env / .env.local, "
                    f"{CREDENTIALS_ENV}, or the environment"}
    db = {}
    for field, _env_key, default, required in DB_FIELDS:
        val = entry.get(field) or default
        if required and not val:
            return None, {"exit": 6, "code": "incomplete_connection",
                          "message": f"connection {cid!r} missing: {field}"}
        db[field] = str(val) if val is not None else None
    return {"id": cid, "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT)),
            "fathom_key": fathom_key, "db_password": db_password, **db}, None


def _resolve_conn(args) -> dict:
    reg, _ = _connections_registry()
    cid, entry = _select_connection(reg, getattr(args, "connection", None))
    conn, problem = _build_conn(cid, entry)
    if problem:
        _die(problem["exit"], problem["code"], problem["message"], problem.get("hint"))
    return conn


def _connections_report() -> dict:
    """The resolution report — every connection, every value, its winning tier
    and source, secrets masked. Local only: no network, no login attempt."""
    reg, _ = _connections_registry()
    report: dict = {"default": None, "connections": {}}
    if reg is None:
        keys = []
        for k in CRED_KEYS:
            value, tier, source = _resolve_env_key(k["key"])
            keys.append(_key_report(k["key"], k["secret"], k["required"],
                                    value, tier, source))
        report["default"] = "default"
        report["connections"]["default"] = {"allow_write": WRITE_DEFAULT, "keys": keys}
        return report
    conns = reg["connections"]
    report["default"] = reg.get("default") or \
        (next(iter(conns)) if len(conns) == 1 else None)
    for cid, entry in conns.items():
        entry = entry if isinstance(entry, dict) else {}
        origin = reg["sources"][cid]
        keys = []
        for field, _env_key, _default, required in DB_FIELDS:
            value = entry.get(field)
            keys.append(_key_report(field, False, required,
                                    str(value) if value is not None else None,
                                    "connection", origin))
        for env_field in ("fathom_key_env", "db_password_env"):
            secret_env = entry.get(env_field)
            if secret_env:
                value, tier, source = _resolve_env_key(secret_env)
                keys.append(_key_report(secret_env, True, True, value, tier, source))
            else:
                keys.append(_key_report(env_field, False, True, None, None, None))
        report["connections"][cid] = {
            "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT)),
            "keys": keys}
    return report


def _cmd_connections() -> None:
    _emit(_connections_report())


# ── Contract verbs ──────────────────────────────────────────────────────────────


# ── Fathom API ──────────────────────────────────────────────────────────────────


def _fathom_get(client: httpx.Client, path: str, params: dict | None = None) -> dict:
    """GET the Fathom API with bounded, backed-off retries. 4xx maps to the
    exit taxonomy; 429/5xx retry then die 5."""
    for attempt in range(1, MAX_RETRIES + 1):
        try:
            resp = client.get(path, params=params)
        except httpx.TimeoutException:
            if attempt < MAX_RETRIES:
                time.sleep(attempt * 1.5); continue
            _die(5, "timeout", f"request timed out: GET {path}", "Fathom was unresponsive")
        except httpx.RequestError as e:
            _die(5, "network_error", f"network error: {e}", "check connectivity")
        if resp.status_code == 429:
            retry_after = float(resp.headers.get("Retry-After")
                                or resp.headers.get("RateLimit-Reset")
                                or attempt * 1.5)
            if attempt < MAX_RETRIES:
                time.sleep(retry_after + 1); continue
            _die(5, "rate_limited", "rate-limited by Fathom", status=429)
        if resp.status_code >= 500:
            if attempt < MAX_RETRIES:
                time.sleep(attempt * 1.5); continue
            _die(5, "server_error", f"Fathom returned {resp.status_code}",
                 status=resp.status_code)
        if resp.status_code in (401, 403):
            _die(2, "auth", "Fathom rejected the API key",
                 "check FATHOM_API_KEY", status=resp.status_code)
        if resp.status_code == 404:
            _die(3, "not_found", f"Fathom: {path} not found", status=404)
        if resp.status_code >= 400:
            _die(6, "bad_request", f"Fathom returned {resp.status_code}: {resp.text[:300]}",
                 status=resp.status_code)
        try:
            return resp.json() if resp.text else {}
        except ValueError as e:
            _die(5, "bad_response", f"invalid JSON from Fathom: {e}")
    _die(5, "exhausted", f"GET {path} failed after {MAX_RETRIES} attempts")


def _fathom_client(conn: dict) -> httpx.Client:
    return httpx.Client(base_url=BASE_URL, headers={"X-Api-Key": conn["fathom_key"]},
                        timeout=TIMEOUT, follow_redirects=True)


# ── Database ────────────────────────────────────────────────────────────────────


def _db_connect(conn: dict):
    try:
        return psycopg2.connect(
            host=conn["db_host"], port=conn["db_port"], dbname=conn["db_name"],
            user=conn["db_user"], password=conn["db_password"],
            sslmode=conn["db_sslmode"], connect_timeout=15,
        )
    except psycopg2.OperationalError as e:
        msg = str(e).lower()
        if "password" in msg or "authentication" in msg or "role" in msg:
            _die(2, "db_auth", f"database authentication failed: {e}".strip(),
                 f"check FATHOM_DB_USER / FATHOM_DB_PASSWORD for connection {conn['id']!r} "
                 f"— `{NAME} guide setup`")
        _die(5, "db_unreachable", f"cannot reach database: {e}".strip(),
             f"check FATHOM_DB_HOST / FATHOM_DB_PORT / FATHOM_DB_SSLMODE for "
             f"connection {conn['id']!r} — `{NAME} guide setup`")


# ── Domain logic (ported) ────────────────────────────────────────────────────────


def _iso(dt) -> str | None:
    return dt.isoformat() if dt else None


def compute_duration_minutes(start, end):
    try:
        s = datetime.fromisoformat(start.replace("Z", "+00:00"))
        e = datetime.fromisoformat(end.replace("Z", "+00:00"))
        return int((e - s).total_seconds() / 60)
    except (ValueError, TypeError, AttributeError):
        return None


def load_vocabulary(cur):
    cur.execute("SELECT correct_term, variants FROM vocabulary WHERE variants IS NOT NULL")
    return [(row[0], row[1]) for row in cur.fetchall()]


def apply_vocabulary_corrections(text, vocabulary):
    if not vocabulary or not text:
        return text, []
    corrections_applied = []
    for correct_term, variants in vocabulary:
        for variant in (variants or []):
            pattern = re.compile(re.escape(variant), re.IGNORECASE)
            count = len(pattern.findall(text))
            if count > 0:
                text = pattern.sub(correct_term, text)
                corrections_applied.append({"wrong": variant, "right": correct_term, "count": count})
    return text, corrections_applied


def merge_transcript_turns(entries):
    if not entries:
        return []
    merged = []
    current_speaker = None
    current_texts: list = []
    current_timestamp = None
    for entry in entries:
        speaker = entry["speaker"]["display_name"]
        text = entry["text"]
        timestamp = entry["timestamp"]
        if speaker == current_speaker:
            current_texts.append(text)
        else:
            if current_speaker is not None:
                merged.append({"speaker": current_speaker, "timestamp": current_timestamp,
                               "text": " ".join(current_texts)})
            current_speaker = speaker
            current_texts = [text]
            current_timestamp = timestamp
    if current_speaker is not None:
        merged.append({"speaker": current_speaker, "timestamp": current_timestamp,
                       "text": " ".join(current_texts)})
    return merged


def extract_speakers(transcript_entries):
    seen: dict = {}
    for entry in transcript_entries:
        speaker = entry.get("speaker", {})
        name = speaker.get("display_name", "")
        email = speaker.get("matched_calendar_invitee_email") or ""
        if name and name not in seen:
            seen[name] = email
    return [{"name": n, "email": e} for n, e in seen.items()]


def merge_participants(calendar_invitees, transcript_speakers):
    participants: dict = {}
    for inv in (calendar_invitees or []):
        name = inv.get("name", inv.get("email", ""))
        email = inv.get("email", "")
        if name:
            participants[name.lower()] = {"name": name, "email": email}
    for speaker in (transcript_speakers or []):
        name = speaker.get("name", "")
        email = speaker.get("email", "")
        key = name.lower()
        if key not in participants:
            email_match = False
            if email:
                for p in participants.values():
                    if p["email"] and p["email"].lower() == email.lower():
                        email_match = True
                        break
            if not email_match:
                participants[key] = {"name": name, "email": email}
    return list(participants.values())


def format_transcript_text(merged_turns):
    lines = []
    for turn in merged_turns:
        lines.append(f"[{turn['timestamp']}] **{turn['speaker']}:** {turn['text']}")
        lines.append("")
    return "\n".join(lines)


def process_meeting_metadata(meeting):
    invitees = meeting.get("calendar_invitees", [])
    participants = []
    for inv in invitees:
        p = {"name": inv.get("name", inv.get("email", ""))}
        if inv.get("email"):
            p["email"] = inv["email"]
        participants.append(p)
    invitee_domains = list(set(
        inv.get("email_domain", "") for inv in invitees if inv.get("email_domain")))
    recording_start = meeting.get("recording_start_time", "")
    recording_end = meeting.get("recording_end_time", "")
    duration = compute_duration_minutes(recording_start, recording_end)
    metadata = {
        "participants": participants,
        "invitee_domains": invitee_domains,
        "share_url": meeting.get("share_url", ""),
    }
    if duration:
        metadata["duration_minutes"] = duration
    return recording_start, recording_end, metadata


def process_inline_transcript(meeting, vocabulary, existing_metadata):
    entries = meeting.get("transcript", [])
    if not entries:
        return None, {}
    transcript_speakers = extract_speakers(entries)
    existing_participants = (existing_metadata or {}).get("participants", [])
    merged_participants = merge_participants(existing_participants, transcript_speakers)
    merged_turns = merge_transcript_turns(entries)
    transcript_text = format_transcript_text(merged_turns)
    corrections_applied = []
    if vocabulary:
        transcript_text, corrections_applied = apply_vocabulary_corrections(transcript_text, vocabulary)
    metadata_updates = {"participants": merged_participants}
    if corrections_applied:
        metadata_updates["corrections_applied"] = corrections_applied
    return transcript_text, metadata_updates


# ── Domain commands ──────────────────────────────────────────────────────────────


def cmd_sync(args, conn):
    db = _db_connect(conn)
    cur = db.cursor()
    vocabulary = load_vocabulary(cur)

    params = {"calendar_invitees_domains_type": "all", "include_transcript": "true"}
    if args.created_after:
        params["created_after"] = args.created_after

    fetched = new = updated = transcripts = 0
    cursor = None
    with _fathom_client(conn) as client:
        while True:
            req_params = dict(params)
            if cursor:
                req_params["cursor"] = cursor
            result = _fathom_get(client, "/meetings", req_params)
            items = result.get("items", [])
            next_cursor = result.get("next_cursor", "")

            for meeting in items:
                recording_id = meeting["recording_id"]
                fetched += 1
                recording_start, recording_end, metadata = process_meeting_metadata(meeting)

                cur.execute("SELECT id, transcript IS NOT NULL FROM fathom WHERE id = %s",
                            (recording_id,))
                existing = cur.fetchone()
                has_transcript = existing[1] if existing else False

                transcript_text = None
                if not has_transcript or args.force:
                    transcript_text, transcript_meta = process_inline_transcript(
                        meeting, vocabulary, metadata)
                    if transcript_meta:
                        metadata.update(transcript_meta)
                    if transcript_text:
                        transcripts += 1

                if existing:
                    if transcript_text:
                        cur.execute(
                            """UPDATE fathom SET title=%s, recording_start=%s,
                                recording_end=%s, language=%s, transcript=%s,
                                metadata = metadata || %s, synced_at = now()
                               WHERE id=%s""",
                            (meeting.get("title", ""), recording_start or None,
                             recording_end or None, meeting.get("transcript_language", ""),
                             transcript_text, Json(metadata), recording_id))
                    else:
                        cur.execute(
                            """UPDATE fathom SET title=%s, recording_start=%s,
                                recording_end=%s, language=%s,
                                metadata = metadata || %s, synced_at = now()
                               WHERE id=%s""",
                            (meeting.get("title", ""), recording_start or None,
                             recording_end or None, meeting.get("transcript_language", ""),
                             Json(metadata), recording_id))
                    updated += 1
                else:
                    cur.execute(
                        """INSERT INTO fathom (id, title, recording_start, recording_end,
                            language, transcript, metadata, synced_at)
                           VALUES (%s,%s,%s,%s,%s,%s,%s, now())""",
                        (recording_id, meeting.get("title", ""), recording_start or None,
                         recording_end or None, meeting.get("transcript_language", ""),
                         transcript_text, Json(metadata)))
                    new += 1

            db.commit()
            if not next_cursor:
                break
            cursor = next_cursor
            sys.stderr.write(f"  ... fetched {fetched} meetings so far\n")

    cur.execute("SELECT count(*), count(transcript) FROM fathom")
    total_meetings, total_transcripts = cur.fetchone()
    cur.close()
    db.close()
    _emit({"fetched": fetched, "new": new, "updated": updated,
           "new_transcripts": transcripts, "total_meetings": total_meetings,
           "total_transcripts": total_transcripts})


def cmd_list(args, conn):
    db = _db_connect(conn)
    cur = db.cursor()
    conditions, params = [], []
    if args.language:
        conditions.append("language = %s"); params.append(args.language)
    if args.has_transcript is not None:
        conditions.append("transcript IS NOT NULL" if args.has_transcript
                          else "transcript IS NULL")
    if args.participant:
        conditions.append("metadata::text ILIKE %s"); params.append(f"%{args.participant}%")
    where = "WHERE " + " AND ".join(conditions) if conditions else ""
    cur.execute(
        f"""SELECT id, title, recording_start, recording_end, language, summary,
                   transcript IS NOT NULL, metadata
            FROM fathom {where} ORDER BY recording_start DESC""", params)
    rows = cur.fetchall()
    meetings = []
    for rid, title, rec_start, rec_end, lang, summary, has_transcript, metadata in rows:
        md = metadata or {}
        meetings.append({
            "id": rid, "title": title, "recording_start": _iso(rec_start),
            "language": lang, "duration_minutes": md.get("duration_minutes"),
            "participants": [p.get("name", "") for p in md.get("participants", [])],
            "has_summary": bool(summary), "has_transcript": has_transcript})
    cur.execute("SELECT count(*), count(transcript) FROM fathom")
    total, with_transcript = cur.fetchone()
    cur.close(); db.close()
    _emit({"count": len(meetings), "total": total, "with_transcripts": with_transcript,
           "meetings": meetings})


def cmd_read(args, conn):
    rid = _parse_id(args.id)
    db = _db_connect(conn)
    cur = db.cursor()
    cur.execute(
        """SELECT id, title, recording_start, recording_end, language, project,
                  summary, transcript, metadata FROM fathom WHERE id = %s""", (rid,))
    row = cur.fetchone()
    cur.close(); db.close()
    if not row:
        _die(3, "not_found", f"recording {rid} not in the database",
             f"`{NAME} sync` to populate, or `{NAME} transcript {rid}` to fetch one")
    _id, title, rec_start, rec_end, language, project, summary, transcript, metadata = row
    md = metadata or {}
    _emit({
        "id": _id, "title": title, "recording_start": _iso(rec_start),
        "recording_end": _iso(rec_end), "language": language, "project": project,
        "duration_minutes": md.get("duration_minutes"),
        "participants": md.get("participants", []),
        "share_url": md.get("share_url"), "summary": summary,
        "has_transcript": bool(transcript), "transcript": transcript, "metadata": md})


def cmd_update(args, conn):
    rid = _parse_id(args.id)
    updates, params, changed = [], [], []
    if args.summary is not None:
        updates += ["summary = %s", "enriched_at = now()"]; params.append(args.summary)
        changed.append("summary")
    if args.project is not None:
        updates.append("project = %s"); params.append(args.project or None)
        changed.append("project")
    if args.metadata_json:
        try:
            extra = json.loads(args.metadata_json)
        except json.JSONDecodeError as e:
            _die(6, "bad_json", f"invalid JSON for --metadata: {e}")
        updates.append("metadata = metadata || %s"); params.append(Json(extra))
        changed.append("metadata")
    if not updates:
        _die(6, "nothing_to_update", "nothing to update",
             "pass --summary, --project, or --metadata")
    db = _db_connect(conn)
    cur = db.cursor()
    cur.execute("SELECT id FROM fathom WHERE id = %s", (rid,))
    if not cur.fetchone():
        cur.close(); db.close()
        _die(3, "not_found", f"recording {rid} not in the database")
    params.append(rid)
    cur.execute(f"UPDATE fathom SET {', '.join(updates)} WHERE id = %s", params)
    db.commit()
    cur.close(); db.close()
    out = {"id": rid, "updated": changed}
    if args.summary is not None:
        out["summary"] = args.summary
    if args.project is not None:
        out["project"] = args.project or None
    _emit(out)


def cmd_transcript(args, conn):
    rid = _parse_id(args.id)
    db = _db_connect(conn)
    cur = db.cursor()
    cur.execute(
        "SELECT title, recording_start, recording_end, language, metadata FROM fathom WHERE id = %s",
        (rid,))
    row = cur.fetchone()

    with _fathom_client(conn) as client:
        result = _fathom_get(client, f"/recordings/{rid}/transcript")
        entries = result.get("transcript", [])
        if not entries:
            cur.close(); db.close()
            _die(3, "not_found", f"no transcript found for recording {rid}")
        if not row:
            meeting_data = _fathom_get(client, f"/recordings/{rid}")
            title = args.title or meeting_data.get("title", "Untitled Meeting")
            recording_start = meeting_data.get("recording_start_time")
            recording_end = meeting_data.get("recording_end_time")
            language = meeting_data.get("transcript_language", "")
            invitees = meeting_data.get("calendar_invitees", [])
            participants = []
            for inv in invitees:
                p = {"name": inv.get("name", inv.get("email", ""))}
                if inv.get("email"):
                    p["email"] = inv["email"]
                participants.append(p)
            metadata = {
                "participants": participants,
                "invitee_domains": list(set(
                    inv.get("email_domain", "") for inv in invitees if inv.get("email_domain"))),
                "share_url": meeting_data.get("share_url", ""),
            }
            duration = compute_duration_minutes(recording_start or "", recording_end or "")
            if duration:
                metadata["duration_minutes"] = duration
        else:
            title = args.title or row[0] or "Untitled Meeting"
            recording_start, recording_end, language = row[1], row[2], row[3]
            metadata = row[4] or {}

    transcript_speakers = extract_speakers(entries)
    metadata["participants"] = merge_participants(
        metadata.get("participants", []), transcript_speakers)
    merged_turns = merge_transcript_turns(entries)
    transcript_text = format_transcript_text(merged_turns)
    vocabulary = load_vocabulary(cur)
    corrections_applied = []
    if vocabulary:
        transcript_text, corrections_applied = apply_vocabulary_corrections(transcript_text, vocabulary)
        if corrections_applied:
            metadata["corrections_applied"] = corrections_applied

    if row:
        cur.execute(
            "UPDATE fathom SET title=%s, transcript=%s, metadata=%s, synced_at=now() WHERE id=%s",
            (title, transcript_text, Json(metadata), rid))
    else:
        cur.execute(
            """INSERT INTO fathom (id, title, recording_start, recording_end,
                language, transcript, metadata, synced_at)
               VALUES (%s,%s,%s,%s,%s,%s,%s, now())""",
            (rid, title, recording_start, recording_end, language,
             transcript_text, Json(metadata)))
    db.commit()
    cur.close(); db.close()
    _emit({"id": rid, "title": title, "language": language,
           "raw_utterances": len(entries), "merged_turns": len(merged_turns),
           "speakers": [s["name"] for s in transcript_speakers],
           "corrections_applied": corrections_applied})


def cmd_search(args, conn):
    db = _db_connect(conn)
    cur = db.cursor()
    q = args.query
    cur.execute(
        """SELECT id, title, recording_start, summary FROM fathom
           WHERE title ILIKE %s OR summary ILIKE %s OR metadata::text ILIKE %s
           ORDER BY recording_start DESC""", (f"%{q}%", f"%{q}%", f"%{q}%"))
    rows = cur.fetchall()
    cur.close(); db.close()
    meetings = [{"id": rid, "title": title, "recording_start": _iso(rec_start),
                 "summary": summary} for rid, title, rec_start, summary in rows]
    _emit({"query": q, "count": len(meetings), "meetings": meetings})


def cmd_scan(args, conn):
    db = _db_connect(conn)
    cur = db.cursor()
    q = args.query
    cur.execute(
        """SELECT id, title, recording_start, summary FROM fathom
           WHERE summary ILIKE %s ORDER BY recording_start DESC""", (f"%{q}%",))
    rows = cur.fetchall()
    cur.close(); db.close()
    matches = []
    for rid, title, rec_start, summary in rows:
        lower = (summary or "").lower()
        pos = lower.find(q.lower())
        if pos >= 0:
            start = max(0, pos - 40)
            end = min(len(summary), pos + len(q) + 40)
            snippet = summary[start:end].replace("\n", " ")
            if start > 0:
                snippet = "..." + snippet
            if end < len(summary):
                snippet = snippet + "..."
        else:
            snippet = (summary or "")[:80].replace("\n", " ")
        matches.append({"id": rid, "title": title,
                        "recording_start": _iso(rec_start), "snippet": snippet})
    _emit({"query": q, "count": len(matches), "matches": matches})


def cmd_grep(args, conn):
    db = _db_connect(conn)
    cur = db.cursor()
    q = args.query
    cur.execute(
        """SELECT id, title, recording_start, transcript FROM fathom
           WHERE transcript ILIKE %s ORDER BY recording_start DESC""", (f"%{q}%",))
    rows = cur.fetchall()
    cur.close(); db.close()
    results = []
    for rid, title, rec_start, transcript in rows:
        lines = [ln.strip() for ln in transcript.split("\n") if q.lower() in ln.lower()]
        shown = lines[:args.max_matches]
        results.append({"id": rid, "title": title, "recording_start": _iso(rec_start),
                        "matches": shown, "more": max(0, len(lines) - len(shown))})
    _emit({"query": q, "meetings_with_matches": len(results), "results": results})


def cmd_vocab_list(args, conn):
    db = _db_connect(conn)
    cur = db.cursor()
    cur.execute("SELECT correct_term, variants FROM vocabulary ORDER BY correct_term")
    rows = cur.fetchall()
    cur.close(); db.close()
    _emit({"count": len(rows),
           "terms": [{"correct_term": t, "variants": v or []} for t, v in rows]})


def cmd_vocab_add(args, conn):
    db = _db_connect(conn)
    cur = db.cursor()
    variants = [v.strip() for v in args.variants.split(",") if v.strip()] if args.variants else None
    cur.execute("SELECT 1 FROM vocabulary WHERE correct_term = %s", (args.term,))
    existed = cur.fetchone() is not None
    cur.execute(
        """INSERT INTO vocabulary (correct_term, variants) VALUES (%s, %s)
           ON CONFLICT (correct_term) DO UPDATE SET variants = %s""",
        (args.term, variants, variants))
    db.commit()
    cur.close(); db.close()
    _emit({"term": args.term, "variants": variants or [],
           "action": "updated" if existed else "added"})


def cmd_vocab_remove(args, conn):
    db = _db_connect(conn)
    cur = db.cursor()
    cur.execute("DELETE FROM vocabulary WHERE correct_term = %s", (args.term,))
    removed = bool(cur.rowcount)
    db.commit()
    cur.close(); db.close()
    _emit({"term": args.term, "removed": removed})


def cmd_schema(args, conn):
    db = _db_connect(conn)
    cur = db.cursor()
    cur.execute("""
        CREATE TABLE IF NOT EXISTS fathom (
            id              bigint PRIMARY KEY,
            title           text,
            recording_start timestamptz,
            recording_end   timestamptz,
            language        text,
            project         text,
            summary         text,
            transcript      text,
            metadata        jsonb NOT NULL DEFAULT '{}'::jsonb,
            synced_at       timestamptz,
            enriched_at     timestamptz
        );
        CREATE TABLE IF NOT EXISTS vocabulary (
            id           serial PRIMARY KEY,
            correct_term text UNIQUE NOT NULL,
            variants     text[]
        );
    """)
    db.commit()
    cur.close(); db.close()
    _emit({"ok": True, "tables": ["fathom", "vocabulary"]})


# ── doctor ──────────────────────────────────────────────────────────────────────


def _check_connection(conn: dict) -> dict:
    out: dict = {"db_host": conn["db_host"], "db_name": conn["db_name"]}
    # Fathom API — cheapest authenticated round-trip (first page, no transcripts)
    try:
        with _fathom_client(conn) as client:
            resp = client.get("/meetings", params={"include_transcript": "false"})
        if resp.status_code in (401, 403):
            return out | {"ok": False, "category": 2,
                          "error": "Fathom rejected the API key (check FATHOM_API_KEY)"}
        if resp.status_code >= 400:
            return out | {"ok": False, "category": 5,
                          "error": f"Fathom /meetings returned {resp.status_code}"}
        out["fathom_api"] = "reachable"
    except httpx.RequestError as e:
        return out | {"ok": False, "category": 5, "error": f"Fathom unreachable: {e}"}
    # Database — credentials + schema presence
    try:
        db = psycopg2.connect(
            host=conn["db_host"], port=conn["db_port"], dbname=conn["db_name"],
            user=conn["db_user"], password=conn["db_password"],
            sslmode=conn["db_sslmode"], connect_timeout=15)
    except psycopg2.OperationalError as e:
        msg = str(e).lower()
        cat = 2 if ("password" in msg or "authentication" in msg or "role" in msg) else 5
        return out | {"ok": False, "category": cat, "error": f"database: {str(e).strip()}"}
    try:
        cur = db.cursor()
        try:
            cur.execute("SELECT count(*), count(transcript) FROM fathom")
            meetings, transcripts = cur.fetchone()
            out["meetings"], out["transcripts"] = meetings, transcripts
            out["schema"] = "present"
        except psycopg2.errors.UndefinedTable:
            return out | {"ok": False, "category": 3, "schema": "missing",
                          "error": "the fathom table does not exist",
                          "hint": f"run `{NAME} schema` to create it "
                                  f"(`{NAME} guide setup` for the full runbook)"}
        finally:
            cur.close()
            db.close()
    except psycopg2.Error as e:
        return out | {"ok": False, "category": 5, "error": f"database error: {str(e).strip()}"}
    return out | {"ok": True}


def cmd_doctor(args) -> None:
    _doctor_gate(_connections_report(), getattr(args, "connection", None))
    reg, _ = _connections_registry()
    if getattr(args, "connection", None) is not None or reg is None:
        targets = [_select_connection(reg, getattr(args, "connection", None))]
    else:
        targets = list(reg["connections"].items())
    connections: dict = {}
    fail_exit = 0
    for cid, entry in targets:
        conn, problem = _build_conn(cid, entry)
        if problem:
            res = {"ok": False, "category": problem["exit"], "error": problem["message"]}
            if problem.get("hint"):
                res["hint"] = problem["hint"]
        else:
            res = _check_connection(conn)
        if not res.get("ok") and not fail_exit:
            fail_exit = res.get("category") or 5
        res.pop("category", None)
        connections[cid] = res
    _emit({"ok": fail_exit == 0, "connections": connections})
    if fail_exit:
        sys.exit(fail_exit)


# ── main ────────────────────────────────────────────────────────────────────────


def _parse_id(value: str) -> int:
    try:
        return int(value)
    except (ValueError, TypeError):
        _die(6, "bad_id", f"recording id must be an integer, got {value!r}")


def main() -> None:
    _gate()                      # every verb passes the effective policy gate first
    _contract(sys.argv[1:])      # contract verbs; help/doctor/domain fall through

    p = argparse.ArgumentParser(
        prog=NAME, description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--connection", default=None,
                   help="connection id (optional with a default pointer or a sole connection)")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("help")
    d = sub.add_parser("doctor")
    d.add_argument("--connection", default=None)

    s = sub.add_parser("sync")
    s.add_argument("--created-after", dest="created_after")
    s.add_argument("--force", action="store_true")

    ls = sub.add_parser("list")
    ls.add_argument("--language")
    ls.add_argument("--has-transcript", dest="has_transcript",
                    type=lambda v: v.lower() in ("true", "1", "yes"), default=None)
    ls.add_argument("--participant")

    rd = sub.add_parser("read"); rd.add_argument("id")

    up = sub.add_parser("update")
    up.add_argument("id")
    up.add_argument("--summary")
    up.add_argument("--project")
    up.add_argument("--metadata", dest="metadata_json")

    tr = sub.add_parser("transcript")
    tr.add_argument("id")
    tr.add_argument("--title")

    sr = sub.add_parser("search"); sr.add_argument("query")
    sc = sub.add_parser("scan"); sc.add_argument("query")
    gr = sub.add_parser("grep")
    gr.add_argument("query")
    gr.add_argument("--max-matches", dest="max_matches", type=int, default=5)

    vp = sub.add_parser("vocab")
    vsub = vp.add_subparsers(dest="vocab_command", required=True)
    vsub.add_parser("list")
    va = vsub.add_parser("add"); va.add_argument("term"); va.add_argument("--variants")
    vr = vsub.add_parser("remove"); vr.add_argument("term")

    sub.add_parser("schema")

    args = p.parse_args()

    if args.cmd == "help":
        sys.stdout.write((__doc__ or "").lstrip("\n")); return
    if args.cmd == "doctor":
        cmd_doctor(args); return

    conn = _resolve_conn(args)
    verb = f"vocab-{args.vocab_command}" if args.cmd == "vocab" else args.cmd
    _write_gate(conn["id"], conn["allow_write"], verb)

    dispatch = {
        "sync": cmd_sync, "list": cmd_list, "read": cmd_read, "update": cmd_update,
        "transcript": cmd_transcript, "search": cmd_search, "scan": cmd_scan,
        "grep": cmd_grep, "schema": cmd_schema,
    }
    vocab_dispatch = {"list": cmd_vocab_list, "add": cmd_vocab_add, "remove": cmd_vocab_remove}

    try:
        if args.cmd == "vocab":
            vocab_dispatch[args.vocab_command](args, conn)
        else:
            dispatch[args.cmd](args, conn)
    except psycopg2.errors.UndefinedTable as e:
        _die(3, "schema_missing", f"a required table is missing: {str(e).strip()}",
             f"run `{NAME} schema` to create the fathom and vocabulary tables")
    except psycopg2.OperationalError as e:
        _die(5, "db_error", f"database connection error: {str(e).strip()}")
    except psycopg2.Error as e:
        _die(5, "db_error", f"database error: {str(e).strip()}")


if __name__ == "__main__":
    main()
