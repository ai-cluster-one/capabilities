#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "capabilities-contract>=0.37,<1",
#     "psycopg[binary]>=3.2",
# ]
# ///
"""context — an agent's doctrine as versioned documents in the project's store.

A document is one doctrine file: a name, which is its path inside the context
folder without `.md` (`identity/MISSION`), and its versions. A version holds
the front matter's title, description, load and order and the body, with who
saved it, when, and why. One version of a document is active; a save adds a
new version and never changes an old one, and retiring a document deletes
nothing, so every edit stays readable and diffable.
Agent-invoked: reads answer plain text by default and JSON with --json;
writes answer JSON.

A document belongs to the project the command runs in, by the project's
durable id. --global addresses the global documents instead, which belong to
no project and reach one only once it enables them (GLOBAL DOCUMENTS below);
every reading and writing verb takes it.

Documents live in the PostgreSQL the project resolves (STORE). Without a
store there are none: every verb that reads or writes them exits 6
`store_not_configured`.

THE FILE FORM
  A document is read from and written as the file a context folder holds:

    ---
    title: <one line>
    description: <one line>
    load: inline|stub
    order: <integer>
    ---
    <body>

  The four keys, each once, in this order, each `key: value` on one line;
  the body is every byte after the closing `---` line, kept exactly. Input
  that does not read back byte for byte in this form is refused (exit 6
  `not_canonical`, naming the line), so a document exported is the file
  imported. Values are taken as written: a quoted value keeps its quotes.

READING  (plain text by default; --json gives the structured answer)
  context list [--global] [--json]
      Every document of the project with its active version: name, load,
      order, title - and every global document it has enabled, marked global
      with its author, unless a document of its own has the same name: that
      one is listed instead, marked as shadowing it. --json gives each its
      `origin`, `own` or `global`. With --global, every global document with
      its author; run in a project, --json marks each `enabled` or not for it.
  context show <name> [--version ID] [--global] [--json]
      The active version, or the version ID names, in the file form. --json
      adds the version id, who saved it, when, and its note; the version id
      is what `save --base` names.
  context history <name> [--global] [--json]
      Every version, newest first: id, when, by whom, the note, and which one
      is active.
  context diff <name> [A] [B] [--global]
      A unified diff of two versions in the file form. Bare: the active
      version against the one saved before it (against nothing when it is the
      only one). With A alone: A against the active version.

  ID, A and B are a version's whole id or a prefix of six or more characters
  that names one version of the document.

WRITING  (exit 4 `read_only_switch` under CAPABILITIES_READ_ONLY, and exit 4
  `system_agent` in a system agent, whose doctrine no edit changes)
  context save <name> --from FILE|- [--base ID] [--note TEXT] [--global]
      Save the file form read from FILE, or stdin with `-`, as the document's
      new active version; a name not in use starts a new document. --base
      names the version the edit was made from: the save is refused (exit 7
      `stale_base`, naming the active version) when it is no longer the
      active one, because another save came first. Without --base the active
      version at the time of the save is the base. --note says why. Safe to
      repeat: content equal to the active version's adds no version and
      answers `"changed": false`.
  context retire <name> [--global]
      Retire the document: it leaves list, show and export, its versions
      stay in the store, and its name is free for a new document. Not
      idempotent: a repeat finds no document of that name and exits 3.
  context import [DIR] [--global]
      Read every `*.md` file under DIR into the store, each as the document
      its path names: a new document with one version, a new version where
      the document's active version differs, nothing where it is equal. DIR
      defaults to the project's context layer, as `capabilities path --json`
      names it under layers.context; with --global, DIR is required. Every
      file is read and checked before anything is written, and all of it is
      written in one transaction; any file that does not read refuses the
      whole import, naming each one. Other files are reported as skipped.
      Documents in the store with no file in DIR are left as they are. Safe
      to repeat.

GLOBAL DOCUMENTS
  A global document belongs to no project: it is written once for every
  agent in the store, and reaches a project only once that project enables
  it. The project that first saves it with --global is its author, and only
  the current author saves or imports a new version of it, retires it, or
  hands it on; any other project is refused (exit 4 `not_author`). A global
  document saved before documents had authors has none until a project
  writes it, which makes that project its author. Writing a global document
  needs a project, its author; reading one needs none. A project that
  enables one composes its active version into the context the manager
  builds, and a document of its own with the same name shadows it.

  Every agent that enables a global document reads it, so a --global save
  or import refuses text that looks like a secret - a private key, a
  provider's key or token, a JSON web token, a password in a URL, or a
  password, secret, token or key assigned a value - naming the line and the
  kind, never the value (exit 6 `secret_like_text`). Personal data is not
  detected: keeping it out stays with the author.

  context transfer <name> --to PROJECT_ID
      Make the project PROJECT_ID the global document's author. Run by its
      current author alone; the receiver cannot take it.
  context enable <name>
  context disable <name>
      Switch the global document of that name on or off for this agent.
      Enabled, it is in `list` and in the context `capabilities build`
      composes, at its active version, unless a document of the agent's own
      has the same name; recorded with who enabled it and when, and
      disabling removes the record. Answers `enabled`, the author, and
      `shadowed_by_project_document` where a document of its own shadows
      it. Safe to repeat: answers `"changed": false`.

  transfer, enable and disable are writes (exit 4 `read_only_switch` under
  CAPABILITIES_READ_ONLY).

EXPORTING
  context export [DIR] [--global]
      Write each document's active version into DIR as <name>.md in the file
      form, creating folders as needed; a file already equal is left alone.
      DIR defaults as for import; with --global, DIR is required. Files in
      DIR that hold no document are reported and left alone. Export reads
      the store and writes only DIR.

  Every write and export reports each document's outcome.

STORE
  The tables are context_documents (one row per document: project, or none
  and its author project for a global one, name, created, retired),
  context_versions (one row per version) and context_enablements (one row
  per global document a project has enabled), in the schema the project's
  store setting names, migrated under the `context` ledger: the
  AGENTKIT_DB_* keys in the project's .env.local and .env, then the same keys
  in the environment, then the machine's store setting that `capabilities
  store set` writes. One version per document is active, which the store
  enforces; it refuses any change to a version other than clearing `active`,
  and any delete.

CONTRACT VERBS
  context help                  this text
  context doctor                the store, the tables, and this project's identity
  context connections           none: context reaches no system of its own
  context stub                  the one-line awareness text
  context manifest --json       the declaration
  context guide [<topic>]       how-to guides (none ship)
  context ids list|get|set|rm   this project's identifiers
  context refs                  this project's references
  context inventory [--network] empty: the documents are the store's (`context list`)
  context migrate [status]      bring the tables up to this version / report

I/O
  Success is plain text or JSON on stdout; failure is
  {"error": {"code", "message", "hint"?}} on stderr.

EXIT CODES
  0 success
  3 not found - no document of that name, no version of that id
  4 policy - context not enabled, the read-only switch, a change to a global
    document by a project that is not its author
  5 store - unreachable or busy
  6 input - a malformed argument or file, no store configured, no project or
    project identity, a folder that does not resolve, text that looks like a
    secret in a global document
  7 stale - the base a save names is no longer the active version
"""

import argparse
import contextlib
import difflib
import json
import os
import re
import sys
from pathlib import Path
from typing import NoReturn

NAME = "context"
SUMMARY = ("An agent's doctrine as versioned documents in the project's PostgreSQL store - "
           "list, show, save with a base, history, diff and retire, and import and export "
           "the context folder byte for byte.")
SCOPE = "project"
CRED_KEYS: list = []
# Every verb that changes the store's documents; each is refused under the
# read-only switch. `export` reads the store and writes only the folder named.
WRITE_VERBS = {"save", "retire", "import", "transfer", "enable", "disable"}
WRITE_DEFAULT = True
DOCS_BASE = ("https://raw.githubusercontent.com/ai-cluster-one/capabilities/"
             "main/capabilities/context/guides/")
STATE = False
TABLES = True       # context_* tables in the project's store, built by _tables()
INVENTORY = None
POST_INSTALL: list[dict] = []

_CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
CREDENTIALS_ENV = _CONFIG_HOME / NAME / "credentials.env"
_STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state"))

# The shared capability code is the capabilities-contract library's, bound here
# into this script's namespace (SHEBANG.md, "The contract verbs").
from capabilities_contract.capability import bind as _contract_bind

_contract_bind(globals(), "core")

_contract_bind(globals(), "store")


def _cmd_connections() -> None:
    """context reaches no system of its own: the store is the project's,
    resolved through the shared library, so there is nothing to resolve here."""
    _emit({"default": None, "connections": {}})


# ── the tables ──────────────────────────────────────────────────────────────

# A document is a head row holding what never changes, and its versions. The
# versions reference their document by a foreign key: both tables are this
# capability's own and a document is retired rather than deleted, so the key
# never blocks a write and refuses only a version of no document.
LEDGER_MAJOR, LEDGER_MINOR = 1, 1
_NAME_PATTERN = r"^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
LEDGER_STEPS = [
    ("0001-documents", f"""
    CREATE TABLE context_documents (
        id          uuid PRIMARY KEY DEFAULT gen_random_uuid(),
        project_id  text CHECK (project_id <> ''),
        name        text NOT NULL CHECK (name ~ '{_NAME_PATTERN}' AND name !~ '[.]md$'),
        created_at  timestamptz NOT NULL DEFAULT now(),
        created_by  text NOT NULL CHECK (created_by <> ''),
        retired_at  timestamptz
    );
    CREATE UNIQUE INDEX context_documents_name ON context_documents
        ((coalesce(project_id, '')), name) WHERE retired_at IS NULL;
    COMMENT ON TABLE context_documents IS
        'One doctrine document of an agent: what never changes about it. Its content is in context_versions.';
    COMMENT ON COLUMN context_documents.project_id IS
        'The project''s declared id; NULL for a global document, which belongs to no project.';
    COMMENT ON COLUMN context_documents.name IS
        'The document''s path inside the context folder without .md, e.g. identity/MISSION; unique per project among unretired documents.';
    COMMENT ON COLUMN context_documents.retired_at IS
        'When the document was retired; a retired document keeps its versions and frees its name.';
    """),
    ("0002-versions", """
    CREATE TABLE context_versions (
        id           uuid PRIMARY KEY DEFAULT gen_random_uuid(),
        document_id  uuid NOT NULL REFERENCES context_documents (id),
        title        text NOT NULL CHECK (title <> ''),
        description  text NOT NULL CHECK (description <> ''),
        load         text NOT NULL CHECK (load IN ('inline', 'stub')),
        position     integer NOT NULL,
        body         text NOT NULL,
        active       boolean NOT NULL DEFAULT true,
        created_at   timestamptz NOT NULL DEFAULT now(),
        created_by   text NOT NULL CHECK (created_by <> ''),
        note         text
    );
    CREATE UNIQUE INDEX context_versions_active ON context_versions (document_id)
        WHERE active;
    CREATE INDEX context_versions_document ON context_versions (document_id, created_at DESC);
    COMMENT ON TABLE context_versions IS
        'Every version of a context document; immutable but for active, which one save clears as it adds the next.';
    COMMENT ON COLUMN context_versions.load IS
        'The front matter''s load: inline puts the body into every session, stub only the title and description.';
    COMMENT ON COLUMN context_versions.position IS
        'The front matter''s order: where the document is composed among the others.';
    COMMENT ON COLUMN context_versions.body IS
        'Every byte after the closing front-matter line, kept exactly.';
    COMMENT ON COLUMN context_versions.active IS
        'The version in force; at most one per document.';
    COMMENT ON COLUMN context_versions.created_by IS
        'Who saved the version: user@node.';
    COMMENT ON COLUMN context_versions.note IS
        'Why the version was saved.';
    """),
    ("0003-versions-guard", """
    CREATE FUNCTION context_versions_guard() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        IF tg_op IN ('DELETE', 'TRUNCATE') THEN
            RAISE EXCEPTION 'context versions are never deleted: retire the document instead'
                USING ERRCODE = 'check_violation';
        END IF;
        IF (to_jsonb(new) - 'active') IS DISTINCT FROM (to_jsonb(old) - 'active') THEN
            RAISE EXCEPTION 'a context version is immutable: save a new version'
                USING ERRCODE = 'check_violation';
        END IF;
        IF new.active AND NOT old.active THEN
            RAISE EXCEPTION 'a context version is not made active again: save its content as a new version'
                USING ERRCODE = 'check_violation';
        END IF;
        RETURN new;
    END $$;
    CREATE TRIGGER context_versions_guard BEFORE UPDATE OR DELETE ON context_versions
        FOR EACH ROW EXECUTE FUNCTION context_versions_guard();
    CREATE TRIGGER context_versions_truncate BEFORE TRUNCATE ON context_versions
        FOR EACH STATEMENT EXECUTE FUNCTION context_versions_guard();
    """),
    # A global document's author is the one project that saves, retires and
    # hands it on, as a global routine's is. One saved before this step has
    # none until a project writes it, so the step adds a column and refuses
    # no row a store already holds.
    ("0004-global", """
    ALTER TABLE context_documents ADD COLUMN author_project_id text
        CHECK (author_project_id <> '');
    ALTER TABLE context_documents ADD CONSTRAINT context_documents_project_author
        CHECK (project_id IS NULL OR author_project_id IS NULL);
    COMMENT ON COLUMN context_documents.project_id IS
        'The project''s declared id; NULL for a global document, which belongs to no project and reaches one only once that project enables it.';
    COMMENT ON COLUMN context_documents.author_project_id IS
        'For a global document, the project that alone saves its versions, retires it and hands authorship on; NULL for a project document, and for a global one saved before documents had authors until a project writes it.';
    """),
    # A project takes a global document up by enabling it, and composes its
    # active version. Disabling deletes the row. The row names the global
    # document itself, so one retired and saved again under its name is a new
    # document that each project enables again.
    ("0005-enablements", """
    CREATE TABLE context_enablements (
        project_id   text NOT NULL CHECK (project_id <> ''),
        document_id  uuid NOT NULL REFERENCES context_documents (id),
        enabled_at   timestamptz NOT NULL DEFAULT now(),
        enabled_by   text NOT NULL CHECK (enabled_by <> ''),
        PRIMARY KEY (project_id, document_id)
    );
    COMMENT ON TABLE context_enablements IS
        'A global document a project has enabled: the project lists it and composes its active version unless a document of its own has the same name. Disabling deletes the row.';
    COMMENT ON COLUMN context_enablements.project_id IS
        'The declared id of the project that enabled the document.';
    COMMENT ON COLUMN context_enablements.document_id IS
        'The global document enabled: a context_documents row with no project.';
    COMMENT ON COLUMN context_enablements.enabled_by IS
        'Who enabled it: user@node.';
    """),
]


def _tables():
    """The steps and version of context's tables, for the contract's `migrate`."""
    return LEDGER_STEPS, LEDGER_MAJOR, LEDGER_MINOR


# ── the file form ───────────────────────────────────────────────────────────

FRONT_KEYS = ("title", "description", "load", "order")
LOADS = ("inline", "stub")
_NAME_RE = re.compile(_NAME_PATTERN)
_ORDER_RE = re.compile(r"-?[0-9]+")


class Unreadable(Exception):
    """A file or input that does not read as the file form."""


def render(version: dict) -> str:
    """A version in the file form: the front matter, then the body as kept."""
    return (f"---\ntitle: {version['title']}\ndescription: {version['description']}\n"
            f"load: {version['load']}\norder: {version['position']}\n---\n{version['body']}")


def parse(text: str) -> dict:
    """The fields of the file form, refused unless they render back to `text`
    byte for byte."""
    if "\x00" in text:
        raise Unreadable("it holds a NUL character")
    if not text.startswith("---\n"):
        raise Unreadable("line 1 is not `---`: the file opens with its front matter")
    end = text.find("\n---\n", 3)
    if end < 0:
        raise Unreadable("the front matter has no closing `---` line")
    fields: dict = {}
    for number, line in enumerate(text[4:end].split("\n") if end > 3 else [], start=2):
        key, sep, value = line.partition(": ")
        if not sep or key not in FRONT_KEYS:
            raise Unreadable(f"line {number} is not one of `{': ...`, `'.join(FRONT_KEYS)}: ...`")
        if key in fields:
            raise Unreadable(f"line {number} repeats `{key}`")
        if value != value.strip():
            raise Unreadable(f"line {number}: the value of `{key}` starts or ends with a space")
        fields[key] = value
    missing = [key for key in FRONT_KEYS if key not in fields]
    if missing:
        raise Unreadable(f"the front matter has no {', '.join(missing)}")
    for key in ("title", "description"):
        if not fields[key].strip():
            raise Unreadable(f"`{key}` is empty")
    if fields["load"] not in LOADS:
        raise Unreadable(f"`load` is {fields['load']!r}, not inline or stub")
    if not _ORDER_RE.fullmatch(fields["order"]):
        raise Unreadable(f"`order` is {fields['order']!r}, not an integer")
    version = {"title": fields["title"], "description": fields["description"],
               "load": fields["load"], "position": int(fields["order"]),
               "body": text[end + 5:]}
    canonical = render(version)
    if canonical != text:
        for number, (got, want) in enumerate(zip(text.split("\n"), canonical.split("\n")),
                                             start=1):
            if got != want:
                raise Unreadable(f"line {number} reads {got!r} where the file form writes "
                                 f"{want!r}")
        raise Unreadable("it does not read back as the file form")
    return version


def _same(a: dict, b: dict) -> bool:
    return all(a[key] == b[key] for key in ("title", "description", "load", "position", "body"))


def _check_name(name: str) -> str:
    if not _NAME_RE.fullmatch(name) or name.endswith(".md"):
        _die(6, "input", f"{name!r} is no document name",
             "a name is the file's path inside the context folder without .md, such as "
             "identity/MISSION: letters, digits, '.', '_' and '-', folders split by '/'")
    return name


def _read_text(path: Path) -> str:
    data = path.read_bytes()
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise Unreadable(f"it is not UTF-8 ({exc.reason} at byte {exc.start})") from None


# ── the project, the scope, the store ───────────────────────────────────────

_SETTING_SLUGS = frozenset({
    "store_not_configured", "store_not_postgres", "store_setting_unreadable",
    "store_setting_too_new", "bad_store_setting", "sslmode_too_weak",
    "bad_schema_name", "driver_missing", "transaction_pooler"})
_STORE_HINT = ("set AGENTKIT_DB_URL (or AGENTKIT_DB_HOST, AGENTKIT_DB_NAME, AGENTKIT_DB_USER, "
               "AGENTKIT_DB_PASSWORD) in the project's .env.local or the environment, or run "
               "`capabilities store set`")


def _scope(is_global: bool, write: bool) -> str | None:
    """The project id the documents belong to, or None for the global ones."""
    if is_global:
        return None
    return _here(write)


def _here(write: bool) -> str:
    """The project the command runs in: the documents' owner, or the author
    of a global one."""
    if _project_root() is None:
        _die(6, "no_project", f"{NAME} keeps a project's documents; run it inside a project",
             "cd into the project, set CLAUDE_PROJECT_DIR, or pass --global")
    project = _project_id(write=write)
    if not project:
        _die(6, "no_project_identity", "this project has no durable id",
             "run `capabilities init` in the project")
    return str(project)


def _reader() -> str | None:
    """The project a global read runs in, where there is one: none is needed
    to read a global document."""
    if _project_root() is None or not _project_id(write=False):
        return None
    return _here(write=False)


def _scope_label(project: str | None) -> str:
    return "global" if project is None else "project"


def _actor() -> str:
    user = os.environ.get("USER") or os.environ.get("LOGNAME")
    if not user:
        with contextlib.suppress(Exception):
            import pwd
            user = pwd.getpwuid(os.getuid()).pw_name
    return f"{user or 'unknown'}@{node_name()}"


def _db():
    try:
        from capabilities_contract import db
    except ImportError:
        _die(6, "driver_missing",
             "the shared database library capabilities-contract is not installed",
             f"run {NAME} through its own script header, which pins it")
    return db


def _db_refused(exc) -> NoReturn:
    if exc.slug == "store_not_configured":
        _die(6, "store_not_configured",
             f"{NAME} keeps documents in a store, and none is configured here", _STORE_HINT)
    _die(6 if exc.slug in _SETTING_SLUGS else 5, exc.slug, exc.message, exc.hint)


def _open():
    """The working connection to the project's store, its tables migrated."""
    db = _db()
    conn = None
    try:
        setting = db.resolve_setting(_project_root())
        conn = db.connect(application_name=NAME, setting=setting, transaction=True)
        db.migrate(conn, NAME, LEDGER_STEPS, major=LEDGER_MAJOR, minor=LEDGER_MINOR)
        conn.autocommit = True
    except db.DbError as exc:
        if conn is not None:
            with contextlib.suppress(Exception):
                conn.close()
        _db_refused(exc)
    return conn


@contextlib.contextmanager
def _store():
    """A connection for one command; a lost store or a store refusal becomes
    the error envelope."""
    import psycopg
    conn = _open()
    try:
        yield conn
    except (psycopg.OperationalError, psycopg.InterfaceError) as exc:
        _die(5, "store_unreachable", f"the store stopped answering: {exc}",
             f"`{NAME} doctor` proves the store")
    except psycopg.errors.UniqueViolation:
        _die(7, "stale_base", "another save changed this document at the same moment",
             f"read it again with `{NAME} show` and save with its version as --base")
    except psycopg.errors.CheckViolation as exc:
        _die(6, "refused_by_store", str(exc).splitlines()[0])
    finally:
        with contextlib.suppress(Exception):
            conn.close()


def _rows(conn, sql: str, params=()) -> list[dict]:
    from psycopg.rows import dict_row
    with conn.cursor(row_factory=dict_row) as cur:
        cur.execute(sql, params)
        return list(cur.fetchall()) if cur.description else []


def _one(conn, sql: str, params=()) -> dict | None:
    rows = _rows(conn, sql, params)
    return rows[0] if rows else None


_VERSION_COLUMNS = ("v.id, v.document_id, v.title, v.description, v.load, v.position, v.body, "
                    "v.active, v.created_at, v.created_by, v.note")


def _document(conn, project: str | None, name: str, lock: bool = False) -> dict | None:
    return _one(conn, "SELECT id, project_id, name, created_at, created_by, author_project_id "
                "FROM context_documents "
                "WHERE coalesce(project_id, '') = %s AND name = %s AND retired_at IS NULL"
                + (" FOR UPDATE" if lock else ""), (project or "", name))


def _need_document(conn, project: str | None, name: str, lock: bool = False) -> dict:
    found = _document(conn, project, name, lock)
    if found is None:
        where = "global" if project is None else "this project's"
        _die(3, "not_found", f"no {where} document {name!r}",
             f"`{NAME} list{' --global' if project is None else ''}` shows the documents")
    return found


def _authored(document: dict, project: str) -> None:
    """Refuse a change to a global document by any project but its author; one
    with no author yet is changed by the project that writes it."""
    if document["author_project_id"] not in (None, project):
        _die(4, "not_author", f"the global document {document['name']!r} is authored by "
             f"{document['author_project_id']}, not by this project ({project})",
             "only its author project saves it, retires it or hands it on with "
             f"`{NAME} transfer`")


# What a global document must not hold, since every agent that enables it
# reads it: each kind is named, never the value. A value that starts as a
# placeholder (`$`, `<`, `{`, `*`) is not one.
_SECRET_KINDS = [
    ("a private key", re.compile(r"-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY-----")),
    ("a cloud access key", re.compile(r"(?<![A-Z0-9])(?:AKIA|ASIA)[0-9A-Z]{16}(?![A-Z0-9])")),
    ("a code host token",
     re.compile(r"(?<![A-Za-z0-9])(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{40,})")),
    ("a chat workspace token", re.compile(r"(?<![A-Za-z0-9])xox[abposr]-[A-Za-z0-9-]{10,}")),
    ("an API key", re.compile(r"(?<![A-Za-z0-9])sk-(?:ant-|proj-)?[A-Za-z0-9_-]{20,}")),
    ("a cloud API key", re.compile(r"(?<![A-Za-z0-9])AIza[0-9A-Za-z_-]{35}")),
    ("a JSON web token",
     re.compile(r"(?<![A-Za-z0-9])eyJ[A-Za-z0-9_-]{8,}\.eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}")),
    ("a password in a URL",
     re.compile(r"[A-Za-z][A-Za-z0-9+.-]*://[^\s/:@]+:(?![$<{*])[^\s/@]+@")),
    ("a credential assigned a value",
     re.compile(r"(?i)(?<![A-Za-z0-9])(?:password|passwd|secret|token|api[_-]?key|access[_-]?key)"
                r"(?![A-Za-z0-9])[\"']?\s*[:=]\s*[\"']?"
                r"(?=[A-Za-z0-9_/+=.-]*[0-9])(?=[A-Za-z0-9_/+=.-]*[A-Za-z])[A-Za-z0-9_/+=.-]{12,}")),
]


def _secret_like(text: str) -> str | None:
    """Where `text` looks like it holds a secret, as `line N looks like <kind>`;
    None where it does not."""
    for number, line in enumerate(text.split("\n"), start=1):
        for kind, pattern in _SECRET_KINDS:
            if pattern.search(line):
                return f"line {number} looks like {kind}"
    return None


def _active(conn, document_id) -> dict | None:
    return _one(conn, f"SELECT {_VERSION_COLUMNS} FROM context_versions v "
                "WHERE v.document_id = %s AND v.active", (document_id,))


def _version(conn, document: dict, ref: str) -> dict:
    """One version of the document by its whole id or a prefix of six or more."""
    ref = ref.strip().lower()
    if len(ref) < 6 or not re.fullmatch(r"[0-9a-f-]+", ref):
        _die(6, "input", f"{ref!r} names no version",
             "a version id is its whole id or a prefix of six or more characters")
    found = _rows(conn, f"SELECT {_VERSION_COLUMNS} FROM context_versions v "
                  "WHERE v.document_id = %s AND v.id::text LIKE %s ORDER BY v.created_at",
                  (document["id"], ref + "%"))
    if not found:
        _die(3, "not_found", f"{document['name']!r} has no version {ref!r}",
             f"`{NAME} history {document['name']}` lists its versions")
    if len(found) > 1:
        _die(6, "ambiguous_version", f"{ref!r} names {len(found)} versions of "
             f"{document['name']!r}", "give more of the id")
    return found[0]


def _moment(moment) -> str:
    return moment.astimezone().strftime("%Y-%m-%dT%H:%M:%S%z") if moment else None


def _version_view(version: dict, with_body: bool = True) -> dict:
    view = {"version": str(version["id"]), "active": version["active"],
            "title": version["title"], "description": version["description"],
            "load": version["load"], "order": version["position"],
            "created_at": _moment(version["created_at"]), "created_by": version["created_by"],
            "note": version["note"]}
    if with_body:
        view["body"] = version["body"]
        view["rendered"] = render(version)
    return view


# ── reading ─────────────────────────────────────────────────────────────────

# A global document a project has enabled and holds no document of its own
# name for: the documents it sees are its own and these. The manager's build
# composes by the same rule.
_ENABLED_GLOBAL = ("d.project_id IS NULL AND EXISTS (SELECT 1 FROM context_enablements e "
                   "WHERE e.document_id = d.id AND e.project_id = %(project)s) "
                   "AND NOT EXISTS (SELECT 1 FROM context_documents o "
                   "WHERE o.project_id = %(project)s AND o.name = d.name "
                   "AND o.retired_at IS NULL)")


def cmd_list(args) -> None:
    if args.is_global:
        scope, project = None, _reader()
        where = "d.project_id IS NULL"
    else:
        scope = project = _scope(False, write=False)
        where = f"(d.project_id = %(project)s OR ({_ENABLED_GLOBAL}))"
    with _store() as conn:
        rows = _rows(conn, "SELECT d.name, d.project_id IS NULL AS global, d.author_project_id, "
                     "v.id, v.title, v.load, v.position, v.created_at, "
                     "EXISTS (SELECT 1 FROM context_enablements e WHERE e.document_id = d.id "
                     "AND e.project_id = %(project)s) AS enabled, "
                     "(d.project_id IS NOT NULL AND EXISTS (SELECT 1 FROM context_documents g "
                     "JOIN context_enablements e ON e.document_id = g.id "
                     "AND e.project_id = d.project_id WHERE g.project_id IS NULL "
                     "AND g.name = d.name AND g.retired_at IS NULL)) AS shadows_global "
                     "FROM context_documents d JOIN context_versions v "
                     "ON v.document_id = d.id AND v.active "
                     f"WHERE d.retired_at IS NULL AND {where} ORDER BY d.name",
                     {"project": project or ""})
    if args.json:
        listed = []
        for r in rows:
            item = {"name": r["name"], "version": str(r["id"]), "title": r["title"],
                    "load": r["load"], "order": r["position"],
                    "saved_at": _moment(r["created_at"]),
                    "origin": "global" if r["global"] else "own"}
            if r["global"]:
                item["author"] = r["author_project_id"]
                if project is not None:
                    item["enabled"] = r["enabled"]
            elif r["shadows_global"]:
                item["shadows_global"] = True
            listed.append(item)
        _emit({"scope": _scope_label(scope), "project": project, "count": len(rows),
               "documents": listed})
        return
    if not rows:
        _emit(f"no {_scope_label(scope)} documents")
        return
    width = max(len(r["name"]) for r in rows)
    _emit("\n".join(f"{r['name']:<{width}}  {r['load']:<6} {r['position']:>5}  {r['title']}"
                    + (f"  (global, by {r['author_project_id'] or 'no author'})"
                       if r["global"] else "")
                    + ("  (shadows a global document)" if r["shadows_global"] else "")
                    + ("  (enabled)" if args.is_global and project and r["enabled"] else "")
                    for r in rows))


def cmd_show(args) -> None:
    name = _check_name(args.name)
    project = _scope(args.is_global, write=False)
    with _store() as conn:
        document = _need_document(conn, project, name)
        version = (_version(conn, document, args.version) if args.version
                   else _active(conn, document["id"]))
    if args.json:
        _emit({"name": name, "scope": _scope_label(project), "project": project,
               **_version_view(version)})
        return
    sys.stdout.write(render(version))


def cmd_history(args) -> None:
    name = _check_name(args.name)
    project = _scope(args.is_global, write=False)
    with _store() as conn:
        document = _need_document(conn, project, name)
        versions = _rows(conn, f"SELECT {_VERSION_COLUMNS} FROM context_versions v "
                         "WHERE v.document_id = %s ORDER BY v.created_at DESC, v.id",
                         (document["id"],))
    if args.json:
        _emit({"name": name, "scope": _scope_label(project), "project": project,
               "count": len(versions),
               "versions": [_version_view(v, with_body=False) for v in versions]})
        return
    _emit("\n".join(
        f"{v['id']} {_moment(v['created_at'])} {v['created_by']}"
        + (" (active)" if v["active"] else "") + (f" - {v['note']}" if v["note"] else "")
        for v in versions))


def cmd_diff(args) -> None:
    name = _check_name(args.name)
    project = _scope(args.is_global, write=False)
    with _store() as conn:
        document = _need_document(conn, project, name)
        active = _active(conn, document["id"])
        if args.a and args.b:
            old, new = _version(conn, document, args.a), _version(conn, document, args.b)
        elif args.a:
            old, new = _version(conn, document, args.a), active
        else:
            new = active
            old = _one(conn, f"SELECT {_VERSION_COLUMNS} FROM context_versions v "
                       "WHERE v.document_id = %s AND v.id <> %s AND v.created_at <= %s "
                       "ORDER BY v.created_at DESC, v.id LIMIT 1",
                       (document["id"], active["id"], active["created_at"]))
    label = f"{name}.md"
    lines = difflib.unified_diff(
        render(old).splitlines(keepends=True) if old else [],
        render(new).splitlines(keepends=True),
        fromfile=f"{label}@{str(old['id'])[:8]}" if old else "/dev/null",
        tofile=f"{label}@{str(new['id'])[:8]}")
    out = "".join(line if line.endswith("\n") else line + "\n\\ No newline at end of file\n"
                  for line in lines)
    if not out:
        _emit(f"no difference between {str(old['id'])[:8]} and {str(new['id'])[:8]}")
        return
    sys.stdout.write(out)


# ── writing ─────────────────────────────────────────────────────────────────

def _save_version(conn, project: str | None, name: str, fields: dict, base: str | None,
                  note: str | None, by: str, author: str | None = None) -> dict:
    """Add `fields` as the document's active version inside the caller's
    transaction, the head row locked so saves of one document run one at a
    time. A global document, `project` None, is saved by its `author` project
    alone, a new one is authored by it, and one with no author yet becomes
    its. The outcome is created, versioned or unchanged."""
    document = _document(conn, project, name, lock=True)
    if document is not None and project is None:
        _authored(document, author)
        if document["author_project_id"] is None:
            _rows(conn, "UPDATE context_documents SET author_project_id = %s WHERE id = %s",
                  (author, document["id"]))
    if document is None:
        if base is not None:
            _die(7, "stale_base", f"--base names a version of {name!r}, which is no longer a "
                 "document", f"`{NAME} list` shows the documents; save without --base to "
                 "start it again")
        document = _one(conn, "INSERT INTO context_documents (project_id, name, created_by, "
                        "author_project_id) VALUES (%s, %s, %s, %s) RETURNING id, name",
                        (project, name, by, author if project is None else None))
        active = None
    else:
        active = _active(conn, document["id"])
        if base is not None:
            based = _version(conn, document, base)
            if active is None or based["id"] != active["id"]:
                _die(7, "stale_base", f"--base {base} is not the active version of {name!r}: "
                     f"{active['id'] if active else 'none'} was saved after it",
                     f"`{NAME} diff {name} {base}` shows what changed since; save again "
                     "with --base naming the active version")
        if active is not None and _same(active, fields):
            return {"name": name, "outcome": "unchanged", "version": str(active["id"])}
        if active is not None:
            _rows(conn, "UPDATE context_versions SET active = false WHERE id = %s AND active",
                  (active["id"],))
    created = _one(conn, "INSERT INTO context_versions (document_id, title, description, load, "
                   "position, body, created_by, note) VALUES (%s, %s, %s, %s, %s, %s, %s, %s) "
                   "RETURNING id",
                   (document["id"], fields["title"], fields["description"], fields["load"],
                    fields["position"], fields["body"], by, note))
    return {"name": name, "outcome": "created" if active is None else "versioned",
            "version": str(created["id"]),
            "base": str(active["id"]) if active is not None else None}


def _refuse_secret(where: str, found: str) -> NoReturn:
    _die(6, "secret_like_text", f"{where}: {found}; a global document is read by every "
         "agent that enables it", "take the value out and name where it is kept instead - "
         "a connection or the vault; personal data stays out by the author's care")


def cmd_save(args) -> None:
    name = _check_name(args.name)
    project = _scope(args.is_global, write=True)
    author = _here(write=True) if args.is_global else None
    try:
        text = (sys.stdin.read() if args.source == "-"
                else _read_text(Path(args.source)))
        fields = parse(text)
    except OSError as exc:
        _die(6, "input", f"--from {args.source}: {exc.strerror or exc}")
    except Unreadable as exc:
        _die(6, "not_canonical", f"--from {args.source} is not the file form: {exc}",
             f"`{NAME} help` shows the file form; `{NAME} show {name}` prints one")
    if args.is_global:
        found = _secret_like(text)
        if found:
            _refuse_secret(f"--from {args.source}", found)
    note = args.note.strip() if args.note and args.note.strip() else None
    with _store() as conn:
        with conn.transaction():
            outcome = _save_version(conn, project, name, fields, args.base, note, _actor(),
                                    author=author)
    if args.is_global:
        outcome["author"] = author
    _emit({"scope": _scope_label(project), "project": project,
           "changed": outcome["outcome"] != "unchanged", **outcome})


def cmd_retire(args) -> None:
    name = _check_name(args.name)
    project = _scope(args.is_global, write=True)
    author = _here(write=True) if args.is_global else None
    with _store() as conn:
        with conn.transaction():
            document = _need_document(conn, project, name, lock=True)
            if args.is_global:
                _authored(document, author)
            _rows(conn, "UPDATE context_documents SET retired_at = now() WHERE id = %s",
                  (document["id"],))
    _emit({"name": name, "scope": _scope_label(project), "project": project,
           "retired": True, "document": str(document["id"])})


_PROJECT_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")


def cmd_transfer(args) -> None:
    name = _check_name(args.name)
    project = _here(write=True)
    to = args.to.strip()
    if not _PROJECT_ID_RE.fullmatch(to):
        _die(6, "input", f"--to {args.to!r} is no project id",
             "name the receiving project by its declared id, as `capabilities path --json` "
             "shows it")
    with _store() as conn:
        with conn.transaction():
            document = _need_document(conn, None, name, lock=True)
            _authored(document, project)
            changed = document["author_project_id"] != to
            if changed:
                _rows(conn, "UPDATE context_documents SET author_project_id = %s WHERE id = %s",
                      (to, document["id"]))
    _emit({"name": name, "scope": "global", "from": project, "author": to, "changed": changed})


def cmd_enable(args) -> None:
    name = _check_name(args.name)
    project = _here(write=True)
    with _store() as conn:
        with conn.transaction():
            document = _need_document(conn, None, name)
            added = _one(conn, "INSERT INTO context_enablements (project_id, document_id, "
                         "enabled_by) VALUES (%s, %s, %s) ON CONFLICT DO NOTHING "
                         "RETURNING enabled_at", (project, document["id"], _actor()))
            shadowed = _document(conn, project, name) is not None
    found = {"name": name, "scope": "global", "project": project, "enabled": True,
             "changed": added is not None, "author": document["author_project_id"]}
    if shadowed:
        found["shadowed_by_project_document"] = True
    _emit(found)


def cmd_disable(args) -> None:
    name = _check_name(args.name)
    project = _here(write=True)
    with _store() as conn:
        with conn.transaction():
            document = _need_document(conn, None, name)
            gone = _rows(conn, "DELETE FROM context_enablements WHERE project_id = %s "
                         "AND document_id = %s RETURNING document_id", (project, document["id"]))
    _emit({"name": name, "scope": "global", "project": project, "enabled": False,
           "changed": bool(gone), "author": document["author_project_id"]})


def _folder(given: str | None, is_global: bool) -> Path:
    """The folder import and export work on: the one named, else the project's
    context layer as the manager resolves it."""
    if given:
        return Path(given).expanduser().resolve()
    if is_global:
        _die(6, "input", "the global documents have no default folder",
             f"name it: `{NAME} import DIR --global` or `{NAME} export DIR --global`")
    root = _project_root()
    answer, error = _ask_manager(root)
    if error:
        _die(error["exit"], error["code"], error["message"], error.get("hint"))
    layer = (answer.get("layers") or {}).get("context")
    if isinstance(layer, dict):
        # A layer the store holds: the folder its import and export default to.
        layer = layer.get("folder")
    if not layer:
        _die(6, "no_context_layer", "the capabilities manager names no context layer here",
             "name the folder: DIR")
    return Path(layer)


def _files(folder: Path) -> tuple[list, list]:
    """The markdown files under `folder` by document name, and every other
    file as skipped."""
    found, skipped = [], []
    for path in sorted(folder.rglob("*")):
        if not path.is_file():
            continue
        rel = path.relative_to(folder).as_posix()
        if path.suffix != ".md":
            skipped.append({"path": rel, "outcome": "skipped", "reason": "not a .md file"})
            continue
        found.append((rel[:-3], path, rel))
    return found, skipped


def cmd_import(args) -> None:
    project = _scope(args.is_global, write=True)
    author = _here(write=True) if args.is_global else None
    folder = _folder(args.dir, args.is_global)
    if not folder.is_dir():
        _die(6, "input", f"{folder} is not a folder")
    files, skipped = _files(folder)
    read, refused, secret = [], [], []
    for name, path, rel in files:
        if not _NAME_RE.fullmatch(name) or name.endswith(".md"):
            refused.append({"path": rel, "reason": "its path makes no document name"})
            continue
        try:
            text = _read_text(path)
            read.append((name, parse(text)))
        except (OSError, Unreadable) as exc:
            refused.append({"path": rel, "reason": str(exc)})
            continue
        found = _secret_like(text) if args.is_global else None
        if found:
            secret.append(f"{rel}: {found}")
    if secret and not refused:
        _refuse_secret(f"{len(secret)} of {len(files)} files under {folder}, so nothing was "
                       "imported", "; ".join(secret))
    if refused:
        sys.stderr.write(json.dumps({"refused": refused}, ensure_ascii=False) + "\n")
        _die(6, "not_canonical", f"{len(refused)} of {len(files)} files under {folder} do not "
             "read as the file form; nothing was imported: "
             + "; ".join(f"{r['path']}: {r['reason']}" for r in refused),
             f"`{NAME} help` shows the file form")
    by = _actor()
    outcomes = []
    with _store() as conn:
        with conn.transaction():
            for name, fields in read:
                outcomes.append(_save_version(conn, project, name, fields, None,
                                              f"imported from {name}.md", by, author=author))
    counts: dict = {}
    for item in outcomes + skipped:
        counts[item["outcome"]] = counts.get(item["outcome"], 0) + 1
    _emit({"scope": _scope_label(project), "project": project, "folder": str(folder),
           "counts": counts, "documents": outcomes, "skipped": skipped})


def cmd_export(args) -> None:
    project = _scope(args.is_global, write=False)
    folder = _folder(args.dir, args.is_global)
    with _store() as conn:
        rows = _rows(conn, f"SELECT d.name, {_VERSION_COLUMNS} FROM context_documents d "
                     "JOIN context_versions v ON v.document_id = d.id AND v.active "
                     "WHERE coalesce(d.project_id, '') = %s AND d.retired_at IS NULL "
                     "ORDER BY d.name", (project or "",))
    outcomes, names = [], set()
    for row in rows:
        names.add(row["name"])
        path = folder / f"{row['name']}.md"
        data = render(row).encode("utf-8")
        item = {"name": row["name"], "path": str(path), "version": str(row["id"])}
        try:
            if path.is_file() and path.read_bytes() == data:
                item["outcome"] = "unchanged"
            else:
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_bytes(data)
                item["outcome"] = "written"
        except OSError as exc:
            item.update(outcome="error", error=str(exc))
        outcomes.append(item)
    others, _skipped = _files(folder) if folder.is_dir() else ([], [])
    counts: dict = {}
    for item in outcomes:
        counts[item["outcome"]] = counts.get(item["outcome"], 0) + 1
    _emit({"scope": _scope_label(project), "project": project, "folder": str(folder),
           "counts": counts, "documents": outcomes,
           "not_in_store": [rel for name, _path, rel in others if name not in names]})
    if counts.get("error"):
        sys.exit(6)


# ── doctor ──────────────────────────────────────────────────────────────────

def cmd_doctor() -> None:
    db = _db()
    report: dict = {"ok": False}
    root = _project_root()
    project = None
    if root is not None:
        state = _project_id_state()
        project = state.get("id") if state else None
    report["project"] = {"root": str(root) if root else None, "id": project}
    conn = None
    try:
        setting = db.resolve_setting(root)
        report["store"] = {"level": setting.level, "schema": setting.schema}
        conn = db.connect(application_name=NAME, setting=setting, transaction=True)
        found = db.status(conn, NAME, LEDGER_STEPS, major=LEDGER_MAJOR, minor=LEDGER_MINOR)
        report["tables"] = {"state": found.state, "pending": found.pending,
                            "changed": found.changed, "warnings": found.warnings}
        if found.state == "current":
            conn.autocommit = True
            counts = _one(conn, "SELECT count(*) FILTER (WHERE project_id IS NULL) AS global, "
                          "count(*) FILTER (WHERE project_id = %s) AS project "
                          "FROM context_documents WHERE retired_at IS NULL", (project or "",))
            report["documents"] = {"project": counts["project"] if project else None,
                                   "global": counts["global"]}
    except db.DbError as exc:
        report["store"] = {**report.get("store", {}), "error": {"code": exc.slug,
                                                                "message": exc.message}}
        _emit(report)
        sys.exit(6 if exc.slug in _SETTING_SLUGS else 5)
    finally:
        if conn is not None:
            with contextlib.suppress(Exception):
                conn.close()
    state = report["tables"]["state"]
    report["ok"] = state in ("current", "pending")
    if state == "pending":
        report["hint"] = f"`{NAME} migrate` brings the tables to this version; any call does too"
    elif state != "current":
        report["hint"] = (f"the store's {NAME} tables do not match this version ({state}); "
                          f"`{NAME} migrate status` says how")
    _emit(report)
    if not report["ok"]:
        sys.exit(7)


# ── the command line ────────────────────────────────────────────────────────

def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=NAME, add_help=False, allow_abbrev=False)
    sub = parser.add_subparsers(dest="cmd", required=True)

    def verb(name: str) -> argparse.ArgumentParser:
        one = sub.add_parser(name, add_help=False, allow_abbrev=False)
        one.add_argument("--global", dest="is_global", action="store_true")
        return one

    sub.add_parser("help", add_help=False, allow_abbrev=False).add_argument("topic", nargs="*")
    sub.add_parser("doctor", add_help=False, allow_abbrev=False)
    verb("list").add_argument("--json", action="store_true")
    show = verb("show")
    show.add_argument("name")
    show.add_argument("--version")
    show.add_argument("--json", action="store_true")
    history = verb("history")
    history.add_argument("name")
    history.add_argument("--json", action="store_true")
    diff = verb("diff")
    diff.add_argument("name")
    diff.add_argument("a", nargs="?")
    diff.add_argument("b", nargs="?")
    save = verb("save")
    save.add_argument("name")
    save.add_argument("--from", dest="source", required=True)
    save.add_argument("--base")
    save.add_argument("--note")
    verb("retire").add_argument("name")
    transfer = sub.add_parser("transfer", add_help=False, allow_abbrev=False)
    transfer.add_argument("name")
    transfer.add_argument("--to", required=True)
    for switch in ("enable", "disable"):
        verb(switch).add_argument("name")
    verb("import").add_argument("dir", nargs="?")
    verb("export").add_argument("dir", nargs="?")
    return parser


def _parse(argv: list[str]):
    parser = _parser()

    def refuse(message: str) -> NoReturn:
        _die(6, "input", message, f"`{NAME} help` shows every verb and its arguments")
    parser.error = refuse
    for action in parser._subparsers._group_actions:
        for one in action.choices.values():
            one.error = refuse
    return parser.parse_args(argv)


def main() -> None:
    _gate()
    argv = sys.argv[1:]
    _contract(argv)
    if not argv:
        _cmd_help()
        return
    args = _parse(argv)
    if args.cmd == "help":
        _cmd_help()
        return
    if args.cmd in WRITE_VERBS:
        _read_only_gate(f"`{NAME} {args.cmd}`")
        _system_agent_gate(f"`{NAME} {args.cmd}`")
    if args.cmd == "doctor":
        cmd_doctor()
        return
    {"list": cmd_list, "show": cmd_show, "history": cmd_history, "diff": cmd_diff,
     "save": cmd_save, "retire": cmd_retire, "import": cmd_import,
     "export": cmd_export, "transfer": cmd_transfer, "enable": cmd_enable,
     "disable": cmd_disable}[args.cmd](args)


if __name__ == "__main__":
    main()
