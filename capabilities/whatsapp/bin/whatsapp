DEFAULT_SESSION = "default"

# --- Capability declaration — one home for every contract fact ---------------

NAME = "whatsapp"
SUMMARY = ("WhatsApp CLI carrying its own engine — link a device, keep the "
           "account's chats and messages in a local store, read and deepen them "
           "on demand, transcribe voice notes, and export a chat to JSON.")
SCOPE = "user"      # credential scope: "project" | "user"
CRED_KEYS = [       # the flat keys the cascade resolves for every connection
    {"key": "DEEPGRAM_API_KEY", "secret": True, "required": False,
     "note": "voice-note transcription (`whatsapp transcribe`)"},
]
WRITE_VERBS = ["send"]   # domain verbs that mutate the remote system
WRITE_DEFAULT = False    # a WhatsApp send leaves the system — granted per connection, explicitly
DOCS_BASE = ("https://raw.githubusercontent.com/ai-cluster-one/capabilities/"
             "main/capabilities/whatsapp/guides/")
STATE = True        # True when the capability writes session/cache state
POST_INSTALL: list = []

_CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
CREDENTIALS_ENV = _CONFIG_HOME / "whatsapp" / "credentials.env"
_STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state"))


# >>> contract: capability core (generated — edit contract/preamble.py, run `capabilities sync-contract`) >>>

# --- Error reporting ---------------------------------------------------------

def _die(exit_code: int, code: str, message: str,
         hint: str | None = None, status: int | None = None) -> NoReturn:
    err: dict = {"code": code, "message": message}
    if hint:
        err["hint"] = hint
    if status is not None:
        err["status"] = status
    sys.stderr.write(json.dumps({"error": err}, ensure_ascii=False) + "\n")
    sys.exit(exit_code)


def _emit(value) -> None:
    if isinstance(value, str):
        sys.stdout.write(value)
        if value and not value.endswith("\n"):
            sys.stdout.write("\n")
    else:
        sys.stdout.write(json.dumps(value, ensure_ascii=False, indent=2) + "\n")


# --- Project / file plumbing -------------------------------------------------

def _parse_env_file(path: Path) -> dict:
    """Parse a KEY=VALUE env/dotenv file. Missing/unreadable file -> {}."""
    out: dict = {}
    try:
        text = path.read_text()
    except OSError:
        return out
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        k = k.strip()
        if k.startswith("export "):
            k = k[len("export "):].strip()
        out[k] = v.strip().strip('"').strip("'")
    return out


def _project_root() -> Path | None:
    """Nearest project root, walking up from $CLAUDE_PROJECT_DIR (else cwd):
    the first directory holding capabilities/, legacy .capabilities/,
    .contextkit/config.toml, .env(.local), or .git.
    Markers are read from the filesystem alone: the root is what the envelope
    location is resolved against, so resolving one cannot depend on the other.
    $HOME is never a project root (the machine registry lives there)."""
    start = os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
    here = Path(start).resolve()
    home = Path.home().resolve()
    for d in (here, *here.parents):
        if d == home:
            return None
        # Either marker names a project. `settings.json` is the gate and
        # `project.json` the identity; a project keeping its records in the
        # store needs the second and may eventually stop carrying the first,
        # so neither is required while both worlds are in use.
        if ((d / "capabilities" / "settings.json").is_file()
                or (d / "capabilities" / "project.json").is_file()
                or (d / ".contextkit" / "config.toml").is_file()
                or (d / ".capabilities").is_dir()
                or (d / ".env").exists()
                or (d / ".env.local").exists() or (d / ".git").is_dir()):
            return d
    return None


_ENVELOPE_HOME: dict = {}


def _validated_project_envelope(root: Path, raw, provider: str) -> Path:
    """Validate the manager/context-owner answer without selecting a fallback."""
    value = str(raw or "").strip()
    if not value:
        _die(6, "project_envelope_empty",
             f"{provider} returned an empty capabilities envelope path")
    candidate = Path(value).expanduser()
    if not candidate.is_absolute():
        _die(6, "project_envelope_relative",
             f"{provider} returned a relative capabilities envelope path: {value!r}")
    try:
        resolved = candidate.resolve()
        resolved.relative_to(root.resolve())
    except (OSError, ValueError):
        _die(6, "project_envelope_outside_project",
             f"{provider} returned a capabilities envelope outside the project: {candidate}")
    return resolved


def _manager_project_envelope(root: Path) -> Path:
    """Consume the capabilities manager's one authoritative project answer."""
    override = os.environ.get("CAPABILITIES_PROJECT_ENVELOPE", "").strip()
    if override:
        return _validated_project_envelope(root, override, "environment handoff")

    import subprocess

    env = dict(os.environ)
    env["CLAUDE_PROJECT_DIR"] = str(root)
    manager = os.environ.get("CAPABILITIES_MANAGER_BIN", "").strip()
    if not manager:
        source_manager = Path(__file__).resolve().parents[3] / "bin" / "capabilities"
        manager = str(source_manager) if source_manager.is_file() else "capabilities"
    try:
        proc = subprocess.run(
            [manager, "path", "--json"], cwd=root, env=env,
            capture_output=True, text=True, timeout=10)
    except FileNotFoundError:
        _die(6, "capabilities_manager_unavailable",
             "the capabilities manager is required to resolve the project envelope",
             "install or repair the `capabilities` command")
    except subprocess.TimeoutExpired:
        _die(6, "capabilities_path_timeout",
             "the capabilities manager did not resolve the project envelope within 10 seconds")
    except OSError as exc:
        _die(6, "capabilities_manager_unavailable",
             f"could not run the capabilities manager: {exc}")
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip()
        try:
            error = json.loads(detail).get("error", {})
        except (AttributeError, ValueError):
            error = {}
        _die(proc.returncode if proc.returncode in (3, 4, 5, 6) else 6,
             str(error.get("code") or "capabilities_path_failed"),
             str(error.get("message") or "the capabilities manager could not resolve the project envelope"),
             str(error.get("hint") or detail or "run `capabilities path --json` for details"))
    try:
        answer = json.loads(proc.stdout)
    except ValueError as exc:
        _die(6, "capabilities_path_malformed",
             f"the capabilities manager returned invalid JSON: {exc}")
    if not isinstance(answer, dict):
        _die(6, "capabilities_path_malformed",
             "the capabilities manager path answer must be a JSON object")
    manager_root = Path(str(answer.get("project_root") or ""))
    if not manager_root.is_absolute() or manager_root.resolve() != root.resolve():
        _die(6, "capabilities_project_mismatch",
             "the capabilities manager resolved a different project root")
    provider = str(answer.get("provider") or "capabilities manager")
    return _validated_project_envelope(
        root, answer.get("project_envelope"), provider)


def _envelope_home(root: Path) -> Path:
    """The project's envelope root, resolved once per invocation.

    The capabilities manager owns project-envelope discovery, including any
    delegation to ContextKit. Capability CLIs consume that answer and never
    duplicate context-owner detection.
    """
    cached = _ENVELOPE_HOME.get(root)
    if cached is not None:
        return cached
    home = _manager_project_envelope(root)
    _ENVELOPE_HOME[root] = home
    return home


def _project_capabilities_dir(root: Path) -> Path:
    """The active project envelope root.

    The resolved envelope is canonical. A legacy `.capabilities/` remains
    readable until `capabilities init` migrates it. If both exist, the canonical
    tree wins once it carries either the legacy file gate or the project identity;
    otherwise the legacy configured tree remains active so merely creating an
    empty visible directory loses no gate.
    """
    current = _envelope_home(root)
    legacy = root / ".capabilities"
    if ((current / "settings.json").is_file()
            or (current / "project.json").is_file()
            or not legacy.is_dir()):
        return current
    return legacy


def _project_env() -> dict:
    """Project .env(.local) at the project root. .env.local overrides .env."""
    root = _project_root()
    if root is None:
        return {}
    merged = _parse_env_file(root / ".env")
    merged.update(_parse_env_file(root / ".env.local"))  # .local wins
    return merged


def _auth_context() -> dict | None:
    """Optional runtime authority envelope passed by an ingress/service.

    Absence means the ordinary project gate is the whole policy. Presence means
    a request-scoped authority layer exists and must fail closed before any
    credential or network work happens.
    """
    raw = os.environ.get("CAPABILITIES_AUTH_CONTEXT")
    if not raw:
        return None
    try:
        if raw.lstrip().startswith("{"):
            data = json.loads(raw)
        else:
            data = json.loads(Path(raw).read_text())
    except (OSError, ValueError) as e:
        _die(4, "auth_context_unreadable",
             "runtime authority context could not be read",
             f"{raw}: {e}")
    if not isinstance(data, dict):
        _die(4, "auth_context_invalid",
             "runtime authority context is not an object")
    return data


def _auth_capability_allowed(rule) -> bool:
    if rule is True or rule == "*":
        return True
    if rule in (False, None):
        return False
    if isinstance(rule, dict):
        if rule.get("deny") is True:
            return False
        if rule.get("enabled") is False or rule.get("allow") is False:
            return False
        return True
    return False


def _auth_gate() -> None:
    ctx = _auth_context()
    if ctx is None:
        return
    allowed = ctx.get("allowed_capabilities")
    if allowed is None:
        return
    if allowed is True or allowed == "*":
        return
    if isinstance(allowed, list):
        if NAME in allowed or "*" in allowed:
            return
    elif isinstance(allowed, dict):
        if _auth_capability_allowed(allowed.get(NAME, allowed.get("*"))):
            return
    else:
        _die(4, "auth_context_invalid",
             "runtime authority context has invalid allowed_capabilities")
    source = ctx.get("source") or "runtime"
    role = ctx.get("sender_role") or ctx.get("role") or "unknown"
    chat = ctx.get("chat_id") or "unknown"
    _die(4, "capability_not_authorized",
         f"{NAME} is not authorized for this {source} request",
         f"role={role}; chat_id={chat}; adjust runtime authority policy instead of bypassing the gate")


def _policy_row():
    """The effective policy row from the same records adapter as everything else."""
    try:
        row = _records().resolve("capabilities", "policy").get(NAME)
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)
    if row is None:
        return None
    entry = row.get("value")
    if (not isinstance(entry, dict) or set(entry) != {"enabled"}
            or not isinstance(entry.get("enabled"), bool)):
        _die(6, "bad_policy",
             f"invalid {NAME} policy entry in {_records().source}",
             'expected {"enabled": true|false}')
    return row


def _project_enabled_explicitly() -> bool:
    """True only for an explicit project enabled entry; global inheritance is
    deliberately insufficient for project-owned service activation."""
    row = _policy_row()
    return bool(row and row.get("scope") == "project"
                and row["value"].get("enabled") is True)


def _require_project_enabled_for_service() -> Path:
    root = _project_root()
    if root is None or not _project_enabled_explicitly():
        _die(4, "project_enable_required",
             f"{NAME} service activation requires an explicit project enable",
             f"ask the user, then run `capabilities enable {NAME} --project` "
             "before service init/start/run")
    return root


def _gate() -> None:
    """Project policy overrides global policy; absence inherits, and absence at
    both scopes is default deny. Safe local discovery verbs remain available so
    a disabled capability can be understood and configured before use.

    If an ingress supplied CAPABILITIES_AUTH_CONTEXT, that request-scoped gate
    is stricter and runs first, before credentials or network calls.
    """
    _auth_gate()
    verb = sys.argv[1] if len(sys.argv) > 1 else "help"
    service_action = sys.argv[2] if len(sys.argv) > 2 else None
    service_contract = globals().get("SERVICE")
    if isinstance(service_contract, dict) and verb == "service" \
            and service_action in {"init", "start", "run"}:
        _require_project_enabled_for_service()
    if verb in {"help", "stub", "manifest", "connections"}:
        return
    row = _policy_row()
    entry = row.get("value") if row else None
    scope = row.get("scope") if row else None
    if isinstance(entry, dict) and entry.get("enabled") is True:
        return
    if isinstance(entry, dict) and entry.get("enabled") is False and scope == "project":
        _die(4, "disabled",
             f"{NAME} is disabled in this project ({_records().source})",
             f"ask the user whether to enable {NAME} for this project; if yes, "
             f"run `capabilities enable {NAME} --project`")
    if isinstance(entry, dict) and entry.get("enabled") is False:
        message = f"{NAME} is disabled globally ({_records().source})"
    else:
        message = f"{NAME} is not enabled by project or global policy"
    _die(4, "not_enabled", message,
         f"ask the user whether to enable {NAME} only for this project or "
         f"globally for every project; then run `capabilities enable {NAME} "
         "--project` or `--global` exactly as requested")


def _env_dir() -> Path | None:
    """The capability's envelope dir in the project's active capabilities/."""
    root = _project_root()
    return (_project_capabilities_dir(root) / NAME) if root is not None else None


_RECORDS = None


def _store_source_label() -> str:
    """A credential-free label for the store that answered.

    Core-only capabilities need this just as much as connection-bearing ones,
    so it belongs with the records adapter rather than in the connections tier.
    """
    url = os.environ.get("CAPABILITIES_STORE_URL") or "?"
    if "://" not in url:
        return f"store(sqlite:{url})"
    scheme, rest = url.split("://", 1)
    if "@" in rest:
        rest = rest.split("@", 1)[1]
    return f"store({scheme}://{rest.split('?', 1)[0]})"


def _records():
    """The adapter this project's records are read and written through.

    Everything below takes what this returns and none of it can tell which it
    got. That is the whole of the arrangement: a call site that can tell where
    a record lives is a call site that will eventually decide for itself, and
    then there are two answers to a question that has one."""
    global _RECORDS
    if _RECORDS is None:
        root = _project_root()
        envelope = (_project_capabilities_dir(root) if root is not None
                    else _CONFIG_HOME / "no-project")
        try:
            project_only = os.environ.get("CAPABILITIES_RECORDS_PROJECT_ONLY", "") \
                .strip().lower() in ("1", "true", "yes", "on")
            _RECORDS = open_records(
                envelope, _CONFIG_HOME, project_only=project_only)
        except StoreError as e:
            _die(6, e.slug, e.message, e.hint)
        if _RECORDS.mode == "db":
            _RECORDS.source = _store_source_label()
    return _RECORDS


def _store_mode() -> tuple[str, str]:
    """Where this project keeps its records, as a report rather than a fork.

    Nothing branches on this any more; it is here because a status surface may
    still want to say which source answered. One project may be moved without moving any other, so the answer is
    per project and lives beside the project's identity — it has to be readable
    before the store is reachable.

    The declaration itself is read in one place, `records_mode`, and acted on
    in one place, `open_records`."""
    adapter = _records()
    return (adapter.mode, adapter.source)


def _project_identity() -> dict:
    root = _project_root()
    if root is None:
        _die(6, "no_project", "no project here to resolve records for")
    identity_file = _project_capabilities_dir(root) / "project.json"
    try:
        identity = json.loads(identity_file.read_text())
    except (OSError, ValueError) as e:
        _die(6, "no_project_identity", f"cannot read {identity_file}: {e}",
             "run `capabilities init` in the project")
    if not identity.get("slug"):
        _die(6, "no_project_identity", f"{identity_file} declares no slug")
    return identity


def _state_dir() -> Path:
    """State follows the scope of the credentials that minted it; project state
    lands inside the envelope only where capabilities/ already exists."""
    if SCOPE == "project":
        root = _project_root()
        if root is not None:
            envelope = _project_capabilities_dir(root)
            if ((envelope / "project.json").is_file()
                    or (envelope / "settings.json").is_file()):
                return envelope / NAME / "state"
    return _STATE_HOME / NAME


# --- Capability contract — the declaration surface --------------------------

def _docs_base() -> str:
    key = f"{NAME.upper()}_DOCS_BASE"
    return (_project_env().get(key)
            or _parse_env_file(CREDENTIALS_ENV).get(key)
            or os.environ.get(key)
            or DOCS_BASE)


def _guide_dir() -> Path:
    executable = Path(__file__).resolve()
    bundle = (executable.parent.parent
              if executable.parent.name == "bin" else executable.parent)
    return bundle / "guides"


def _guide_menu() -> list[dict[str, str]]:
    menu = []
    guide_dir = _guide_dir()
    files = sorted(guide_dir.glob("*.md")) if guide_dir.is_dir() else []
    for path in files:
        lines = path.read_text().splitlines()
        title = ""
        title_index = -1
        for index, line in enumerate(lines):
            if line.startswith("# "):
                title = line[2:].strip()
                title_index = index
                break
        paragraph = []
        for line in lines[title_index + 1:]:
            stripped = line.strip()
            if not stripped:
                if paragraph:
                    break
                continue
            if stripped.startswith("#"):
                break
            paragraph.append(stripped)
        topic = path.stem
        menu.append({
            "topic": topic,
            "title": title,
            "preview": " ".join(paragraph),
            "command": f"{NAME} guide {topic}",
        })
    return menu


def _cmd_guide(argv: list[str]) -> None:
    menu = _guide_menu()
    if not argv:
        _emit(menu); return
    topic = argv[0]
    topics = {entry["topic"] for entry in menu}
    if topic not in topics:
        _die(3, "not_found", f"no guide topic {topic!r}",
             f"run `{NAME} guide` to list available guides")
    import urllib.error as _ue
    import urllib.request as _ur
    url = _docs_base().rstrip("/") + "/" + topic + ".md"
    cache_dir = _STATE_HOME / NAME / "guides"
    cache, etag_f = cache_dir / f"{topic}.md", cache_dir / f"{topic}.etag"
    headers = {}
    if cache.exists() and etag_f.exists():
        headers["If-None-Match"] = etag_f.read_text().strip()
    try:
        req = _ur.Request(url, headers=headers)
        with _ur.urlopen(req, timeout=10.0) as resp:
            text = resp.read().decode(resp.headers.get_content_charset() or "utf-8")
            cache_dir.mkdir(parents=True, exist_ok=True)
            cache.write_text(text)
            if resp.headers.get("etag"):
                etag_f.write_text(resp.headers["etag"])
            _emit(text); return
    except _ue.HTTPError as e:
        if e.code == 304 and cache.exists():
            _emit(cache.read_text()); return
        if e.code == 404:
            _die(3, "not_found", f"guide {topic!r} missing upstream", url)
        err = f"upstream returned {e.code}"
    except _ue.URLError as e:
        err = str(e.reason)
    except OSError as e:
        err = str(e)
    if cache.exists():
        sys.stderr.write(json.dumps(
            {"warning": f"upstream unreachable; serving cached copy ({err})"},
            ensure_ascii=False) + "\n")
        _emit(cache.read_text()); return
    _die(5, "network_error", f"could not fetch guide {topic!r}; no cache exists", url)


def _render_ids_markdown(data: dict) -> str:
    """Render the {label: {value, note}} envelope as the labelled markdown
    list the manager's `capabilities ids <NAME>` also produces — one shared
    format across the ids surface and the identifiers section of `help`."""
    lines: list[str] = []
    for label, entry in sorted(data.items()):
        entry = entry if isinstance(entry, dict) else {"value": entry}
        v = entry.get("value")
        vs = f"`{v}`" if isinstance(v, str) else "`" + json.dumps(v, ensure_ascii=False) + "`"
        line = f"- **{label}**: {vs}"
        note = entry.get("note")
        if note:
            line += f" — {note}"
        lines.append(line)
    return "\n".join(lines)


def _identifiers_scopes() -> "Scopes":
    identity = _project_identity()
    return Scopes(project=identity["slug"])


def _identifiers_load() -> dict:
    """The identifiers envelope, from wherever this project keeps its records.

    The shape is the same either way — `{label: {value, note}}` — so the help
    section, the report and `ids get` never learn which answered."""
    try:
        resolved = _records().resolve(NAME, "identifier")
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)
    return {label: {"note": row["note"] or "", "value": row["value"]}
            for label, row in sorted(resolved.items())}


def _identifiers_write(label: str, value, note: str) -> None:
    """Rule 15 holds either way: a capability is the sole writer of its own
    identifiers, addressed by (capability, collection) rather than by path."""
    kept = note or (_identifiers_load().get(label) or {}).get("note", "")
    try:
        _records().set(NAME, "identifier", label, value,
                       actor=f"{NAME} ids set", note=kept or None)
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)


def _identifiers_remove(label: str) -> None:
    try:
        _records().delete(NAME, "identifier", label)
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)


def _identifiers_section() -> str:
    """The Identifiers block appended to the bare top-level help — deterministic
    first-touch surfacing of `capabilities/<NAME>/identifiers.json` so an
    agent following the `<NAME> help` startup protocol loads the discovered
    labels/values/notes into context at once. Empty when no project envelope
    or nothing recorded (do not bloat help with an empty section)."""
    data = _identifiers_load()
    if not data:
        return ""
    header = (
        "\n═══ Identifiers ═════════════════════════════════════════════════════════════\n\n"
        f"Structural lookups discovered for `{NAME}` in this project. Fetch a single\n"
        f"raw value with `{NAME} ids get <label>`; the full envelope is also at\n"
        f"`capabilities ids {NAME}`.\n\n"
    )
    return header + _render_ids_markdown(data) + "\n"


def _cmd_help() -> None:
    """Bare top-level help: the CLI's HELP body (module-level `HELP` if
    defined, else the module docstring), then the project's Identifiers
    section. Only fires when no extra args follow — per-verb help stays
    untouched so `<NAME> help <subcommand>` is not intercepted."""
    g = globals()
    text = g.get("HELP") or g.get("__doc__") or ""
    if text.startswith("\n"):
        text = text.lstrip("\n")
    sys.stdout.write(text)
    if text and not text.endswith("\n"):
        sys.stdout.write("\n")
    section = _identifiers_section()
    if section:
        sys.stdout.write(section)


def _cmd_ids(argv: list[str]) -> None:
    sub = argv[0] if argv else "list"
    data = _identifiers_load()
    if sub == "list":
        _emit(data); return
    if sub == "get":
        if len(argv) < 2 or argv[1] not in data:
            _die(3, "not_found", "unknown identifier label",
                 f"`{NAME} ids list` shows the labels")
        _emit((data[argv[1]] or {}).get("value")); return
    if sub == "set":
        if len(argv) < 3:
            _die(6, "input", f"usage: {NAME} ids set <label> <value> [--note <text>]")
        label, raw = argv[1], argv[2]
        try:
            value = json.loads(raw)
        except ValueError:
            value = raw
        note = ""
        if "--note" in argv:
            ni = argv.index("--note")
            if ni + 1 >= len(argv):
                _die(6, "input", "--note needs a value")
            note = argv[ni + 1]
        _identifiers_write(label, value, note)
        _emit({"set": label}); return
    if sub == "rm":
        if len(argv) < 2 or argv[1] not in data:
            _die(3, "not_found", "unknown identifier label",
                 f"`{NAME} ids list` shows the labels")
        _identifiers_remove(argv[1])
        _emit({"removed": argv[1]}); return
    _die(6, "input", f"unknown ids subcommand {sub!r}", f"{NAME} ids list|get|set|rm")


REFERENCE_PREFIX = "reference."


def _front_matter(body: str) -> tuple[str | None, str | None]:
    """`name` and `description` out of a reference's leading front matter."""
    lines = body.splitlines()
    if not lines or lines[0].strip() != "---":
        return None, None
    name = desc = None
    for line in lines[1:30]:
        if line.strip() == "---":
            break
        if line.startswith("name:"):
            name = line.split(":", 1)[1].strip()
        elif line.startswith("description:"):
            desc = line.split(":", 1)[1].strip()
    return name, desc


def _reference_bodies() -> dict[str, str]:
    """Every reference this project can see, keyed by its document key.

    In the store a reference is a pinned document like any other long text, so
    an edit reaches every host at once and an unpinned draft reaches none."""
    out: dict[str, str] = {}
    try:
        adapter = _records()
        for key in adapter.document_keys(NAME):
            if not key.startswith(REFERENCE_PREFIX):
                continue
            doc = adapter.document_read(NAME, key)
            if doc:
                out[key] = doc["body"]
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)
    return out


def _cmd_refs(argv: list[str] | None = None) -> None:
    """`refs` lists what this project can load; `refs show <name>` prints one.

    The listing carries a `source` rather than a path, because a reference kept
    in the store has no path to open — `refs show` is the one way to read a
    body that works whichever source answered."""
    argv = argv or []
    bodies = _reference_bodies()
    adapter = _records()
    entries = []
    for key, body in sorted(bodies.items()):
        name, desc = _front_matter(body)
        if not name:
            continue
        entry = {"name": name, "description": desc or "", "key": key}
        # A path when there is one to open, a source when there is not. The
        # adapter answers that; the listing does not ask where it lives.
        path = adapter.document_path(NAME, key)
        if path is None:
            entry["source"] = adapter.source
        else:
            entry["path"] = str(path)
        entries.append((name, entry, body))

    if argv and argv[0] == "show":
        if len(argv) < 2:
            _die(6, "input", f"usage: {NAME} refs show <name>")
        wanted = argv[1]
        for name, entry, body in entries:
            if wanted in (name, entry["key"], entry["key"][len(REFERENCE_PREFIX):]):
                sys.stdout.write(body if body.endswith("\n") else body + "\n")
                return
        _die(3, "not_found", f"no reference named {wanted!r}",
             f"`{NAME} refs` lists them")
    if argv:
        _die(6, "input", f"unknown refs subcommand {argv[0]!r}", f"{NAME} refs [show <name>]")
    _emit([entry for _name, entry, _body in entries])


def _context_edit_files(key: str) -> tuple[Path, Path]:
    token = hashlib.sha256(f"{NAME}\0{key}".encode()).hexdigest()[:16]
    root = _state_dir() / "record-edits"
    return root / f"{token}.md", root / f"{token}.json"


def _cmd_context(argv: list[str]) -> None:
    """Read or edit project long text without exposing its backend."""
    sub = argv[0] if argv else "list"
    adapter = _records()
    if sub == "list":
        _emit({"documents": adapter.document_keys(NAME),
               "records": {"mode": adapter.mode, "source": adapter.source}})
        return
    if len(argv) < 2:
        _die(6, "input", f"usage: {NAME} context show|edit|put <key>")
    key = argv[1]
    if sub == "show":
        doc = adapter.document_read(NAME, key)
        if doc is None:
            _die(3, "not_found", f"no context document {key!r}",
                 f"`{NAME} context list` shows the keys")
        sys.stdout.write(doc["body"] if doc["body"].endswith("\n")
                         else doc["body"] + "\n")
        return
    work, meta = _context_edit_files(key)
    if sub == "edit":
        doc = adapter.document_read(NAME, key)
        direct = adapter.document_path(NAME, key)
        base = doc["hash"] if doc else None
        path = direct or work
        if direct is None:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(doc["body"] if doc else "")
        meta.parent.mkdir(parents=True, exist_ok=True)
        meta.write_text(json.dumps({"key": key, "path": str(path),
                                    "base": base, "direct": direct is not None},
                                   ensure_ascii=False, indent=2) + "\n")
        _emit({"key": key, "path": str(path), "base": base,
               "records": {"mode": adapter.mode, "source": adapter.source},
               "next": f"edit the path, then run `{NAME} context put {key}`"})
        return
    if sub == "put":
        try:
            checkout = json.loads(meta.read_text())
        except (OSError, ValueError) as exc:
            _die(6, "edit_not_started",
                 f"no valid edit checkout for {key!r}: {exc}",
                 f"run `{NAME} context edit {key}` first")
        if checkout.get("key") != key:
            _die(6, "edit_mismatch", f"edit checkout does not belong to {key!r}")
        path = Path(str(checkout.get("path") or ""))
        try:
            body = path.read_text()
            version = adapter.document_put(
                NAME, key, body, author=f"{NAME} context put",
                media_type="text/markdown", base=checkout.get("base"))
        except OSError as exc:
            _die(6, "edit_unreadable", f"cannot read edit path {path}: {exc}")
        except StoreError as exc:
            _die(6, exc.slug, exc.message, exc.hint)
        meta.unlink(missing_ok=True)
        if not checkout.get("direct"):
            path.unlink(missing_ok=True)
        _emit({"put": key, "version": version,
               "records": {"mode": adapter.mode, "source": adapter.source}})
        return
    _die(6, "input", f"unknown context subcommand {sub!r}",
         f"{NAME} context list|show|edit|put")


def _contract(argv: list[str]) -> None:
    """Dispatch the contract verbs; domain verbs fall through to the CLI's own
    parser. Runs after _gate(), before any credential is resolved.

    `help` is a contract verb only when bare (no extra args) — the top-level
    dump plus the Identifiers section. `<NAME> help <subcommand>` falls
    through to the CLI so per-verb help stays clean."""
    cmd = argv[0] if argv else ""
    if cmd == "stub":
        _emit(f"{SUMMARY} Run `{NAME} help`.")
    elif cmd == "manifest":
        _emit({"name": NAME, "summary": SUMMARY,
               "credentials": {"scope": SCOPE, "keys": CRED_KEYS},
               "docs": {"base": DOCS_BASE,
                        "topics": [entry["topic"] for entry in _guide_menu()]},
               "state": STATE, "post_install": POST_INSTALL})
    elif cmd == "guide":
        _cmd_guide(argv[1:])
    elif cmd == "ids":
        _cmd_ids(argv[1:])
    elif cmd == "refs":
        _cmd_refs(argv[1:])
    elif cmd == "context":
        _cmd_context(argv[1:])
    elif cmd == "connections":
        _cmd_connections()
    elif cmd == "help" and len(argv) == 1:
        _cmd_help()
    else:
        return
    sys.exit(0)

# <<< contract: capability core <<<

# >>> contract: store (generated — edit contract/store.py, run `capabilities sync-contract`) >>>
# A region carries what it needs. Relying on the host file to have imported
# the right names is a coupling nothing checks and nothing reports: it works in
# whichever capability happened to import them and fails at import time in the
# rest. Re-importing a name the host already has costs nothing.
import json
import os
import hashlib
import re
import sqlite3
import time
from collections.abc import Iterator, Sequence
from contextlib import contextmanager
from datetime import datetime as _store_datetime
from datetime import timedelta as _store_timedelta
from datetime import timezone as _store_timezone
from pathlib import Path
from typing import Any
from urllib.parse import urlparse
from uuid import uuid4


SCHEMA_VERSION = 4

# Two scopes and no more: a record either belongs to one project or to
# every project. `project_id` is null in the second case, which is what
# "global" means and the only thing it means.
SCOPE_KINDS = ("global", "project")

FIRST = "first"
MERGE = "merge"
EXACT = "exact"

# The collection registry: how each resolves, and who is allowed to write it.
# Adding a collection here is the only place a new record class is declared.
#
# `connection` and `grant` are the same fact split along the seam that matters:
# an entry's identity — where the thing is and how to reach it — is a fact about
# the world, the same in every project forever. What a project may DO with that
# identity is a decision, different per project by definition. Glued together,
# the second cannot be overridden without restating the first; apart, a project
# that needs write access writes one grant row and repeats no address, no host,
# no secret.
#
# An identity is atomic: it merges by entry, never by field, so no connection is
# ever assembled from two scopes. That is what rule 18's "never merged" was
# protecting, and it survives; what it gives up is refusing to let a project add
# to the global set at all.
COLLECTIONS: dict[str, dict[str, str]] = {
    "connection": {"resolve": MERGE, "writer": "human"},
    "grant": {"resolve": MERGE, "writer": "human"},
    "identifier": {"resolve": MERGE, "writer": "capability"},
    "setting": {"resolve": MERGE, "writer": "human"},
    "policy": {"resolve": MERGE, "writer": "manager"},
    # A document row holds no text — it holds the hash of the version currently
    # in force. Keeping the pin here rather than in the documents table is what
    # makes it scoped and merged like everything else, so a project may run a
    # different version of a globally declared prompt without copying it.
    "document": {"resolve": MERGE, "writer": "human"},
}

# Grant fields and what they mean when nothing declares them. `allow_write`
# falls back to the capability's own WRITE_DEFAULT rather than to a value here,
# because "does a write leave the system" is the capability's fact.
GRANT_FIELDS = ("enabled", "allow_write")

# A document version is named by the first twelve hex characters of its sha256.
# Forty-eight bits is far more than a project's worth of prose needs, and a name
# a person can read at a glance is worth more than headroom nobody will reach.
# What makes the truncation safe is not the arithmetic but `document_put`, which
# refuses a hash that already names different text rather than keeping the older
# body and serving it under the newer name.
HASH_LENGTH = 12

# A key is a label a human chose, and for a mailbox that label is naturally an
# email address — so `@` and `+` belong here. What stays out is whitespace,
# separators and anything that would make a key ambiguous to address.
KEY_RE = re.compile(r"[a-z0-9][a-z0-9._@+-]{0,127}", re.IGNORECASE)
CAPABILITY_RE = re.compile(r"[a-z][a-z0-9-]{0,63}")


class StoreError(Exception):
    """Every failure this tier reports. Carries a slug the caller maps to an
    exit code, so the CLI's error envelope stays the capability's own."""

    def __init__(self, slug: str, message: str, hint: str | None = None):
        super().__init__(message)
        self.slug = slug
        self.message = message
        self.hint = hint


def _now() -> str:
    return _store_datetime.now(_store_timezone.utc).isoformat(timespec="seconds")


def _now_exact() -> str:
    """Microsecond resolution, for the one place order matters. A revision log
    read newest-first used to break ties on a monotonic integer id; a uuid does
    not order, so the timestamp has to carry the ordering itself."""
    return _store_datetime.now(_store_timezone.utc).isoformat(timespec="microseconds")


def _store_check(name: str, value: str, pattern: re.Pattern) -> str:
    if not isinstance(value, str) or not pattern.fullmatch(value):
        raise StoreError("bad_name", f"{name} {value!r} must match {pattern.pattern}")
    return value


def _check_scope(kind: str, name: str) -> tuple[str, str]:
    if kind not in SCOPE_KINDS:
        raise StoreError("bad_scope", f"scope kind {kind!r} must be one of {', '.join(SCOPE_KINDS)}")
    if kind == "global":
        if name:
            raise StoreError("bad_scope", "the global scope takes no name")
        return kind, ""
    if not name:
        raise StoreError("bad_scope", f"the {kind} scope requires a name")
    return kind, name


class Scopes:
    """Which scopes a capability resolves against, highest precedence first.

    Carries the project's SLUG, because that is the handle a person and a
    project file both use. The store turns it into the project's id once and
    everything downstream joins on that: the name is the way in, the id is what
    rows hold."""

    def __init__(self, project: str | None = None, include_global: bool = True):
        self.project = project or None
        self.include_global = bool(include_global)

    @classmethod
    def from_env(cls, project: str | None = None,
                 include_global: bool = True) -> "Scopes":
        return cls(project=project or os.environ.get("CAPABILITIES_PROJECT") or None,
                   include_global=include_global)

    def write_target(self, scope: str | None) -> tuple[str, str | None]:
        """Where a write lands, as (scope, project slug). A write never guesses
        a scope it was given no name for."""
        kind = scope or "project"
        if kind == "global":
            return ("global", None)
        if kind == "project":
            if not self.project:
                raise StoreError("no_project_scope", "no project scope is in effect",
                                 "set CAPABILITIES_PROJECT or pass --scope global")
            return ("project", self.project)
        raise StoreError("bad_scope", f"scope {kind!r} must be one of {', '.join(SCOPE_KINDS)}")

    def __repr__(self) -> str:
        return (f"Scopes(project={self.project!r}, "
                f"include_global={self.include_global!r})")



# --- Schema ------------------------------------------------------------------

# Portable DDL. `{json}` and `{now}` are the only dialect substitutions; every
# other construct below is common to SQLite >= 3.35 and PostgreSQL >= 12.
_DDL = [
    """
    CREATE TABLE IF NOT EXISTS store_meta (
        namespace   TEXT PRIMARY KEY,
        version     INTEGER NOT NULL,
        updated_at  TEXT NOT NULL
    )
    """,
    # A project is looked up by the slug it declares for itself; everything
    # else refers to it by id. The slug is the handle a person types, the id is
    # what a row holds, and neither has to do the other's job.
    """
    CREATE TABLE IF NOT EXISTS projects (
        id          TEXT PRIMARY KEY,
        slug        TEXT NOT NULL UNIQUE,
        name        TEXT,
        created_at  TEXT NOT NULL
    )
    """,
    # Where a project sits is a fact about a machine, not about the project.
    """
    CREATE TABLE IF NOT EXISTS project_paths (
        id          TEXT PRIMARY KEY,
        project_id  TEXT NOT NULL REFERENCES projects(id),
        instance    TEXT NOT NULL,
        path        TEXT NOT NULL,
        updated_at  TEXT NOT NULL,
        UNIQUE (project_id, instance)
    )
    """,
    """
    CREATE TABLE IF NOT EXISTS config (
        id          TEXT PRIMARY KEY,
        scope       TEXT NOT NULL,
        project_id  TEXT REFERENCES projects(id),
        capability  TEXT NOT NULL,
        collection  TEXT NOT NULL,
        key         TEXT NOT NULL,
        value       {json} NOT NULL,
        note        TEXT,
        updated_at  TEXT NOT NULL,
        updated_by  TEXT
    )
    """,
    # NULL compares unequal to NULL in a UNIQUE constraint, in both engines, so
    # a global row would not collide with another global row. The COALESCE makes
    # the absence of a project a value like any other.
    """
    CREATE UNIQUE INDEX IF NOT EXISTS config_identity_idx ON config (
        scope, COALESCE(project_id, ''), capability, collection, key
    )
    """,
    """
    CREATE INDEX IF NOT EXISTS config_lookup_idx
        ON config (capability, collection, scope, project_id)
    """,
    """
    CREATE TABLE IF NOT EXISTS state (
        id          TEXT PRIMARY KEY,
        scope       TEXT NOT NULL,
        project_id  TEXT REFERENCES projects(id),
        capability  TEXT NOT NULL,
        key         TEXT NOT NULL,
        value       {json} NOT NULL,
        updated_at  TEXT NOT NULL,
        expires_at  TEXT
    )
    """,
    """
    CREATE UNIQUE INDEX IF NOT EXISTS state_identity_idx ON state (
        scope, COALESCE(project_id, ''), capability, key
    )
    """,
    """
    CREATE INDEX IF NOT EXISTS state_expiry_idx ON state (expires_at)
    """,
    """
    CREATE TABLE IF NOT EXISTS revisions (
        id          TEXT PRIMARY KEY,
        scope       TEXT NOT NULL,
        project_id  TEXT REFERENCES projects(id),
        capability  TEXT NOT NULL,
        collection  TEXT NOT NULL,
        key         TEXT NOT NULL,
        old_value   {json},
        new_value   {json},
        actor       TEXT,
        written_at  TEXT NOT NULL
    )
    """,
    """
    CREATE INDEX IF NOT EXISTS revisions_target_idx
        ON revisions (capability, collection, key, written_at)
    """,
    # Long text of any kind — a prompt, a reference, an automation's script.
    # Versions accumulate and are named by the hash of their own content; which
    # one is in force is the `active` flag on the row itself, so the answer sits
    # in the table anyone would look in rather than in a pin somewhere else.
    """
    CREATE TABLE IF NOT EXISTS context (
        id          TEXT PRIMARY KEY,
        scope       TEXT NOT NULL,
        project_id  TEXT REFERENCES projects(id),
        capability  TEXT NOT NULL,
        key         TEXT NOT NULL,
        hash        TEXT NOT NULL,
        body        TEXT NOT NULL,
        media_type  TEXT,
        active      INTEGER NOT NULL DEFAULT 0,
        author      TEXT,
        created_at  TEXT NOT NULL
    )
    """,
    """
    CREATE UNIQUE INDEX IF NOT EXISTS context_version_idx ON context (
        scope, COALESCE(project_id, ''), capability, key, hash
    )
    """,
    # At most one version of one item is in force in one scope, and the database
    # is what says so — not a convention the writers are trusted to keep.
    """
    CREATE UNIQUE INDEX IF NOT EXISTS context_one_active_idx ON context (
        scope, COALESCE(project_id, ''), capability, key
    ) WHERE active = 1
    """,
    """
    CREATE INDEX IF NOT EXISTS context_history_idx
        ON context (capability, key, created_at)
    """,
]


def _uuid() -> str:
    return str(uuid4())


# --- The repository ----------------------------------------------------------

class Store:
    """The persistence interface every capability sees. Two adapters implement
    it; no capability ever writes SQL, which is the single discipline that keeps
    both backends honest."""

    dialect = "abstract"

    # -- lifecycle ------------------------------------------------------------

    def __init__(self, conn: Any):
        self._conn = conn

    @property
    def connection(self) -> Any:
        return self._conn

    def close(self) -> None:
        self._conn.close()

    def __enter__(self) -> "Store":
        return self

    def __exit__(self, *exc: object) -> None:
        self.close()

    # -- dialect hooks --------------------------------------------------------

    def _sql(self, sql: str) -> str:
        raise NotImplementedError

    def _encode(self, value: Any) -> Any:
        raise NotImplementedError

    def _decode(self, raw: Any) -> Any:
        raise NotImplementedError

    def _execute(self, sql: str, params: Sequence[Any] = ()) -> Any:
        cur = self._conn.cursor()
        cur.execute(self._sql(sql), tuple(params))
        return cur

    @contextmanager
    def transaction(self) -> Iterator[None]:
        try:
            yield
        except Exception:
            self._conn.rollback()
            raise
        self._conn.commit()

    # -- schema ---------------------------------------------------------------

    def migrate(self, namespace: str = "core", version: int = SCHEMA_VERSION,
                steps: Sequence[str] | None = None) -> int:
        """Bring `namespace` up to `version`. The core namespace owns the tables
        above; a capability passes its own namespace and additive steps.

        Refuses a step that drops or narrows, because two hosts on different
        capability versions share this database and the older one must survive
        the newer one's migration."""
        _store_check("namespace", namespace, CAPABILITY_RE)
        with self.transaction():
            self._execute(_DDL[0].format(**self._ddl_subs()))
            cur = self._execute("SELECT version FROM store_meta WHERE namespace = ?", (namespace,))
            row = cur.fetchone()
            have = int(row[0]) if row else 0
            if have >= version:
                return have
            body = list(_DDL[1:]) if namespace == "core" and steps is None else list(steps or [])
            for step in body:
                self._guard_additive(step)
                self._execute(step.format(**self._ddl_subs()))
            if row:
                self._execute("UPDATE store_meta SET version = ?, updated_at = ? WHERE namespace = ?",
                              (version, _now(), namespace))
            else:
                self._execute("INSERT INTO store_meta (namespace, version, updated_at) VALUES (?, ?, ?)",
                              (namespace, version, _now()))
        return version

    @staticmethod
    def _guard_additive(step: str) -> None:
        head = " ".join(step.split()).upper()
        for banned in ("DROP TABLE", "DROP COLUMN", "ALTER COLUMN", "DROP INDEX", "RENAME "):
            if banned in head:
                raise StoreError(
                    "destructive_migration",
                    f"migration step contains {banned.strip()!r}",
                    "expand in one release and contract in a later one; a host "
                    "running the previous version still reads this database",
                )

    def _ddl_subs(self) -> dict[str, str]:
        raise NotImplementedError

    def schema_version(self, namespace: str = "core") -> int:
        cur = self._execute("SELECT version FROM store_meta WHERE namespace = ?", (namespace,))
        row = cur.fetchone()
        return int(row[0]) if row else 0

    def health(self) -> dict[str, Any]:
        """What `doctor` reports: reachable, which dialect, which versions."""
        started = time.monotonic()
        self._execute("SELECT 1").fetchone()
        rtt = round((time.monotonic() - started) * 1000, 1)
        cur = self._execute("SELECT namespace, version FROM store_meta ORDER BY namespace")
        return {
            "dialect": self.dialect,
            "roundtrip_ms": rtt,
            "namespaces": {n: int(v) for n, v in cur.fetchall()},
        }

    # -- scope resolution ------------------------------------------------------

    def _project_id(self, slug: str | None) -> str | None:
        """A slug in, an id out. Looked up once and remembered, because every
        query in a session asks the same question about the same project."""
        if not slug:
            return None
        cache = getattr(self, "_project_ids", None)
        if cache is None:
            cache = self._project_ids = {}
        if slug not in cache:
            cur = self._execute("SELECT id FROM projects WHERE slug = ?", (slug,))
            row = cur.fetchone()
            cache[slug] = row[0] if row else None
        return cache[slug]

    def _chain(self, scopes: Scopes) -> list[tuple[str, str | None]]:
        """The scopes to read, highest first. A project nobody registered
        contributes nothing rather than matching everything."""
        project_id = self._project_id(scopes.project)
        out: list[tuple[str, str | None]] = []
        if project_id:
            out.append(("project", project_id))
        if scopes.include_global:
            out.append(("global", None))
        return out

    def _target(self, scope: tuple) -> tuple[str, str | None]:
        """A write target as (scope, project id), from a scope and a slug."""
        kind, slug = (list(scope) + [None])[:2]
        if kind not in SCOPE_KINDS:
            raise StoreError("bad_scope",
                             f"scope {kind!r} must be one of {', '.join(SCOPE_KINDS)}")
        if kind == "global":
            if slug:
                raise StoreError("bad_scope", "the global scope takes no project")
            return ("global", None)
        project_id = self._project_id(slug)
        if not project_id:
            raise StoreError("unknown_project", f"no project registered as {slug!r}",
                             "register it before writing records scoped to it")
        return ("project", project_id)

    @staticmethod
    def _chain_clause(chain: list) -> tuple[str, list]:
        if not chain:
            return "0", []
        clause = " OR ".join(["(scope = ? AND COALESCE(project_id,'') = ?)"] * len(chain))
        params: list[Any] = []
        for kind, pid in chain:
            params += [kind, pid or ""]
        return clause, params

    # -- config: read ---------------------------------------------------------

    def config_get(self, capability: str, collection: str, key: str,
                   scopes: Scopes) -> Any:
        """One resolved value, or None. Follows the collection's semantics."""
        entry = self.config_resolve(capability, collection, scopes).get(key)
        return entry["value"] if entry else None

    def config_layers(self, capability: str, collection: str,
                      scopes: Scopes) -> list[dict[str, dict[str, Any]]]:
        """Each scope's own rows, highest scope first, uncollapsed.

        `config_resolve` answers what this project sees; this answers what each
        scope said. A record whose *fields* are decided one at a time needs the
        second question, and asking it here keeps one query behind both."""
        _store_check("capability", capability, CAPABILITY_RE)
        if self._semantics(collection) == EXACT:
            raise StoreError("bad_collection",
                             f"collection {collection!r} is state, not config",
                             "read it with state_get")
        chain = self._chain(scopes)
        clause, params = self._chain_clause(chain)
        cur = self._execute(
            "SELECT id, scope, project_id, capability, collection, key, value, "
            f"note, updated_at, updated_by FROM config WHERE capability = ? AND collection = ? "
            f"AND ({clause})", [capability, collection] + params)
        rows = [self._row(r) for r in cur.fetchall()]
        by_scope: dict[tuple, dict[str, dict[str, Any]]] = {}
        for row in rows:
            by_scope.setdefault(
                (row["scope"], row["project_id"] or ""), {}
            )[row["key"]] = row
        return [by_scope[(kind, pid or "")] for kind, pid in chain
                if by_scope.get((kind, pid or ""))]

    def config_resolve(self, capability: str, collection: str,
                       scopes: Scopes) -> dict[str, dict[str, Any]]:
        """The whole collection as the capability should see it, each entry
        carrying the scope it came from so `connections` can report resolution
        without a second query."""
        semantics = self._semantics(collection)
        out: dict[str, dict[str, Any]] = {}
        for entries in self.config_layers(capability, collection, scopes):
            if semantics == FIRST:
                return entries
            for key, row in entries.items():
                out.setdefault(key, row)
        return out

    def config_origin(self, capability: str, collection: str, key: str,
                      scopes: Scopes) -> tuple[str, str | None] | None:
        entry = self.config_resolve(capability, collection, scopes).get(key)
        return (entry["scope"], entry["project_id"]) if entry else None

    def config_list(self, capability: str, collection: str,
                    scope: tuple | None = None) -> list[dict[str, Any]]:
        """Every stored row, unresolved — the view for editing rather than use."""
        _store_check("capability", capability, CAPABILITY_RE)
        self._semantics(collection)
        sql = ("SELECT id, scope, project_id, capability, collection, key, value, "
               "note, updated_at, updated_by FROM config WHERE capability = ? AND collection = ?")
        params: list[Any] = [capability, collection]
        if scope:
            kind, pid = self._target(scope)
            sql += " AND scope = ? AND COALESCE(project_id,'') = ?"
            params += [kind, pid or ""]
        cur = self._execute(sql + " ORDER BY scope, key", params)
        return [self._row(r) for r in cur.fetchall()]

    def _row(self, r: Sequence[Any]) -> dict[str, Any]:
        return {
            "id": r[0], "scope": r[1], "project_id": r[2],
            "capability": r[3], "collection": r[4], "key": r[5],
            "value": self._decode(r[6]), "note": r[7],
            "updated_at": r[8], "updated_by": r[9],
        }

    @staticmethod
    def _semantics(collection: str) -> str:
        spec = COLLECTIONS.get(collection)
        if not spec:
            raise StoreError("bad_collection", f"unknown collection {collection!r}",
                             f"known: {', '.join(sorted(COLLECTIONS))}")
        return spec["resolve"]

    # -- config: write --------------------------------------------------------

    def config_set(self, capability: str, collection: str, key: str, value: Any,
                   scope: tuple, actor: str | None = None,
                   note: str | None = None) -> str:
        """Write one entry at one scope and record the revision. Returns the
        row's id. A write always names its scope; nothing infers one."""
        _store_check("capability", capability, CAPABILITY_RE)
        _store_check("key", key, KEY_RE)
        self._semantics(collection)
        kind, pid = self._target(scope)
        with self.transaction():
            cur = self._execute(
                "SELECT id, value FROM config WHERE scope = ? AND COALESCE(project_id,'') = ? "
                "AND capability = ? AND collection = ? AND key = ?",
                (kind, pid or "", capability, collection, key))
            existing = cur.fetchone()
            before = self._decode(existing[1]) if existing else None
            if existing:
                row_id = existing[0]
                self._execute(
                    "UPDATE config SET value = ?, note = ?, updated_at = ?, updated_by = ? "
                    "WHERE id = ?",
                    (self._encode(value), note, _now(), actor, row_id))
            else:
                row_id = _uuid()
                self._execute(
                    "INSERT INTO config (id, scope, project_id, capability, "
                    "collection, key, value, note, updated_at, updated_by) "
                    "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
                    (row_id, kind, pid, capability, collection, key,
                     self._encode(value), note, _now(), actor))
            self._revise(kind, pid, capability, collection, key, before, value, actor)
        return row_id

    def config_delete(self, capability: str, collection: str, key: str,
                      scope: tuple, actor: str | None = None) -> bool:
        _store_check("capability", capability, CAPABILITY_RE)
        self._semantics(collection)
        kind, pid = self._target(scope)
        with self.transaction():
            cur = self._execute(
                "SELECT id, value FROM config WHERE scope = ? AND COALESCE(project_id,'') = ? "
                "AND capability = ? AND collection = ? AND key = ?",
                (kind, pid or "", capability, collection, key))
            existing = cur.fetchone()
            if not existing:
                return False
            self._execute("DELETE FROM config WHERE id = ?", (existing[0],))
            self._revise(kind, pid, capability, collection, key,
                         self._decode(existing[1]), None, actor)
        return True

    def _revise(self, scope: str, project_id: str | None, capability: str, collection: str, key: str,
                old: Any, new: Any, actor: str | None) -> None:
        self._execute(
            "INSERT INTO revisions (id, scope, project_id, capability, collection, "
            "key, old_value, new_value, actor, written_at) "
            "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
            (_uuid(), scope, project_id, capability, collection, key,
             self._encode(old), self._encode(new), actor, _now_exact()))

    def revisions(self, capability: str, collection: str | None = None,
                  key: str | None = None, limit: int = 50) -> list[dict[str, Any]]:
        """What the repository's history used to answer: who changed this, when,
        and what it was before."""
        sql = ("SELECT scope, project_id, collection, key, old_value, new_value, "
               "actor, written_at FROM revisions WHERE capability = ?")
        params: list[Any] = [capability]
        if collection:
            sql += " AND collection = ?"
            params.append(collection)
        if key:
            sql += " AND key = ?"
            params.append(key)
        cur = self._execute(sql + " ORDER BY written_at DESC LIMIT ?", params + [limit])
        return [{"scope": r[0], "project_id": r[1], "collection": r[2],
                 "key": r[3], "old_value": self._decode(r[4]),
                 "new_value": self._decode(r[5]), "actor": r[6], "written_at": r[7]}
                for r in cur.fetchall()]

    # -- connections, with their grants applied --------------------------------

    def connections_effective(self, capability: str, scopes: Scopes,
                              write_default: bool = False,
                              include_disabled: bool = False) -> dict[str, dict[str, Any]]:
        """Every connection this project may use, already carrying the decision
        made about it — the one read a capability needs before it acts."""
        identities = self.config_resolve(capability, "connection", scopes)
        layers = self.config_layers(capability, "grant", scopes)
        out: dict[str, dict[str, Any]] = {}
        for cid, entry in identities.items():
            rows = [layer[cid] for layer in layers if cid in layer]
            # Named through the class: this method also runs with a
            # FileRecords `self`, which carries no store internals.
            decided, decided_at = Store._grant_decisions(cid, rows)
            # Where the identity resolves decides whether it is this project's
            # to use at all. A project that declares an identity locally has
            # already said yes by declaring it; an identity inherited from the
            # global scope is withheld until a grant *resolving at project
            # scope* says `enabled: true`. A global `enabled: true` can never be
            # the blessing — one global line would otherwise hand every project
            # on the machine the same connection back.
            declared = decided.get("enabled")
            identity_is_project = entry["scope"] == "project"
            blessed_here = decided_at.get("enabled") == "project"
            if declared is None:
                enabled = identity_is_project
            else:
                enabled = bool(declared) and (identity_is_project or blessed_here)
            if not enabled and not include_disabled:
                continue
            grant = rows[0] if rows else None
            out[cid] = {
                "id": cid,
                "value": entry["value"],
                "scope": (entry["scope"], entry["project_id"]),
                "enabled": enabled,
                "allow_write": bool(decided.get("allow_write", write_default)),
                "grant_scope": (grant["scope"], grant["project_id"]) if grant else None,
            }
        return out

    @staticmethod
    def _grant_decisions(cid: str, rows: Sequence[dict[str, Any]]) -> tuple[dict, dict]:
        """One grant assembled field by field, highest scope first.

        This is the line COLLECTIONS already draws between the two records. An
        identity is a fact about the world, so it is atomic: taken whole from
        one scope, never assembled out of two. A grant is a decision, and a
        decision a lower scope made about one field stands until some higher
        scope decides that same field — so a machine-wide `allow_write: false`
        survives a project that only says `enabled: true`, and write permission
        is never acquired by saying something else.

        Returns the decided fields and, per field, the scope that decided it."""
        decided: dict[str, Any] = {}
        decided_at: dict[str, str] = {}
        for row in rows:
            value = row["value"]
            if not isinstance(value, dict):
                raise StoreError("bad_grant",
                                 f"grant {cid!r} must be a table, got {type(value).__name__}")
            unknown = set(value) - set(GRANT_FIELDS)
            if unknown:
                raise StoreError("bad_grant",
                                 f"grant {cid!r} has unknown field(s): {', '.join(sorted(unknown))}",
                                 f"known: {', '.join(GRANT_FIELDS)}")
            for field, decision in value.items():
                if field not in decided:
                    decided[field] = decision
                    decided_at[field] = row["scope"]
        return decided, decided_at

    def grant_orphans(self, capability: str, scopes: Scopes) -> list[dict[str, Any]]:
        """Grants naming a connection that does not resolve. A grant is the only
        record that refers to another, so it is the only one that can be aimed at
        nothing, and dropping it quietly would read exactly like permission
        deliberately withheld."""
        identities = self.config_resolve(capability, "connection", scopes)
        grants = self.config_resolve(capability, "grant", scopes)
        return [{"key": key, "scope": (row["scope"], row["project_id"]),
                 "value": row["value"]}
                for key, row in sorted(grants.items()) if key not in identities]

    # -- context: long text, versioned by content, one version in force --------

    def context_put(self, capability: str, key: str, body: str, scope: tuple,
                    author: str | None = None, media_type: str | None = None,
                    activate: bool = False) -> str:
        """Record a version and return its hash. Saving is not deploying: this
        changes nothing that runs unless `activate` says so, or until
        `context_activate` names the hash later."""
        _store_check("capability", capability, CAPABILITY_RE)
        _store_check("key", key, KEY_RE)
        kind, pid = self._target(scope)
        if not isinstance(body, str):
            raise StoreError("bad_context", "a context body must be text")
        digest = hashlib.sha256(body.encode("utf-8")).hexdigest()[:HASH_LENGTH]
        with self.transaction():
            cur = self._execute(
                "SELECT id, body FROM context WHERE scope = ? AND COALESCE(project_id,'') = ? "
                "AND capability = ? AND key = ? AND hash = ?",
                (kind, pid or "", capability, key, digest))
            existing = cur.fetchone()
            if existing and existing[1] != body:
                raise StoreError(
                    "hash_collision",
                    f"version {digest} of {capability}/{key} already names different text",
                    "this is what the truncated hash is checked for; report it")
            if not existing:
                self._execute(
                    "INSERT INTO context (id, scope, project_id, capability, key, "
                    "hash, body, media_type, active, author, created_at) "
                    "VALUES (?, ?, ?, ?, ?, ?, ?, ?, 0, ?, ?)",
                    (_uuid(), kind, pid, capability, key, digest, body,
                     media_type, author, _now()))
            if activate:
                self._activate(kind, pid, capability, key, digest, author)
        return digest

    def context_activate(self, capability: str, key: str, digest: str, scope: tuple,
                         actor: str | None = None) -> None:
        """Put one version in force — the deploy step. At most one version of one
        item is active in one scope, and the unique index is what says so rather
        than a convention the writers are trusted to keep."""
        kind, pid = self._target(scope)
        with self.transaction():
            self._activate(kind, pid, capability, key, digest, actor)

    def _activate(self, kind: str, pid: str | None, capability: str, key: str, digest: str, actor: str | None) -> None:
        cur = self._execute(
            "SELECT id, hash FROM context WHERE scope = ? AND COALESCE(project_id,'') = ? "
            "AND capability = ? AND key = ? AND active = 1",
            (kind, pid or "", capability, key))
        current = cur.fetchone()
        target = self._execute(
            "SELECT id FROM context WHERE scope = ? AND COALESCE(project_id,'') = ? "
            "AND capability = ? AND key = ? AND hash = ?",
            (kind, pid or "", capability, key, digest)).fetchone()
        if not target:
            raise StoreError("unknown_version",
                             f"no recorded version {digest} of {capability}/{key} in this scope",
                             "record it with context_put first")
        if current and current[0] == target[0]:
            return
        # Clear first: the partial unique index would otherwise refuse the second
        # active row before the old one is stood down.
        if current:
            self._execute("UPDATE context SET active = 0 WHERE id = ?", (current[0],))
        self._execute("UPDATE context SET active = 1 WHERE id = ?", (target[0],))
        self._revise(kind, pid, capability, "context", key,
                     current[1] if current else None, digest, actor)

    def context_read(self, capability: str, key: str,
                     scopes: Scopes) -> dict[str, Any] | None:
        """The version in force here, found at the highest scope that has one."""
        for kind, pid in self._chain(scopes):
            cur = self._execute(
                "SELECT id, hash, body, media_type, author, created_at, scope, project_id "
                "FROM context WHERE scope = ? AND COALESCE(project_id,'') = ? "
                "AND capability = ? AND key = ? AND active = 1",
                (kind, pid or "", capability, key))
            row = cur.fetchone()
            if row:
                return {"id": row[0], "key": key, "hash": row[1], "body": row[2],
                        "media_type": row[3], "author": row[4], "created_at": row[5],
                        "scope": (row[6], row[7])}
        return None

    def context_versions(self, capability: str, key: str,
                         scopes: Scopes) -> list[dict[str, Any]]:
        """Every version this project can see, newest first — its own chain and
        nothing else. Bodies are omitted; a listing should not carry the whole of
        what it lists."""
        clause, params = self._chain_clause(self._chain(scopes))
        cur = self._execute(
            "SELECT id, hash, media_type, author, created_at, length(body), active, scope "
            f"FROM context WHERE capability = ? AND key = ? AND ({clause}) "
            "ORDER BY created_at DESC, hash", [capability, key] + params)
        return [{"id": r[0], "hash": r[1], "media_type": r[2], "author": r[3],
                 "created_at": r[4], "bytes": r[5], "active": bool(r[6]), "scope": r[7]}
                for r in cur.fetchall()]

    def context_keys(self, capability: str, scopes: Scopes) -> list[str]:
        clause, params = self._chain_clause(self._chain(scopes))
        cur = self._execute(
            f"SELECT DISTINCT key FROM context WHERE capability = ? AND ({clause}) ORDER BY key",
            [capability] + params)
        return [r[0] for r in cur.fetchall()]

    # -- the project registry --------------------------------------------------

    def project_register(self, project_id: str, slug: str, name: str | None = None) -> None:
        """Claim a slug for a project id. Re-registering the same id is how a
        second machine joins a project it already belongs to. A slug held by a
        different id is refused: that is another project, and taking its label
        would take its rows."""
        _store_check("slug", slug, CAPABILITY_RE)
        if not isinstance(project_id, str) or not project_id.strip():
            raise StoreError("bad_project_id", "a project id is required",
                             "generate one once and keep it in the project's own config")
        with self.transaction():
            holder = self._execute("SELECT id FROM projects WHERE slug = ?", (slug,)).fetchone()
            if holder and holder[0] != project_id:
                raise StoreError(
                    "slug_taken", f"the label {slug!r} belongs to project {holder[0]}",
                    "pick another label; this is a different project, and sharing "
                    "the label would share its rows")
            existing = self._execute(
                "SELECT slug FROM projects WHERE id = ?", (project_id,)).fetchone()
            if existing and existing[0] != slug:
                raise StoreError(
                    "slug_immutable",
                    f"project {project_id} is already labelled {existing[0]!r}",
                    "rows are scoped by the id, but the label is how it is found, "
                    "so renaming one is a migration rather than an edit")
            if existing:
                self._execute("UPDATE projects SET name = ? WHERE id = ?", (name, project_id))
            else:
                self._execute(
                    "INSERT INTO projects (id, slug, name, created_at) VALUES (?, ?, ?, ?)",
                    (project_id, slug, name, _now()))
        getattr(self, "_project_ids", {}).pop(slug, None)

    def project_get(self, slug: str) -> dict[str, Any] | None:
        row = self._execute(
            "SELECT id, slug, name, created_at FROM projects WHERE slug = ?", (slug,)).fetchone()
        return {"id": row[0], "slug": row[1], "name": row[2], "created_at": row[3]} if row else None

    def project_by_id(self, project_id: str) -> dict[str, Any] | None:
        row = self._execute(
            "SELECT id, slug, name, created_at FROM projects WHERE id = ?",
            (project_id,)).fetchone()
        return {"id": row[0], "slug": row[1], "name": row[2], "created_at": row[3]} if row else None

    def project_list(self) -> list[dict[str, Any]]:
        cur = self._execute("SELECT id, slug, name, created_at FROM projects ORDER BY slug")
        return [{"id": r[0], "slug": r[1], "name": r[2], "created_at": r[3]}
                for r in cur.fetchall()]

    def project_bind_path(self, slug: str, instance: str, path: str) -> None:
        """Record where this project sits on this machine."""
        project_id = self._project_id(slug)
        if not project_id:
            raise StoreError("unknown_project", f"no project registered as {slug!r}",
                             "register it first")
        with self.transaction():
            existing = self._execute(
                "SELECT id FROM project_paths WHERE project_id = ? AND instance = ?",
                (project_id, instance)).fetchone()
            if existing:
                self._execute("UPDATE project_paths SET path = ?, updated_at = ? WHERE id = ?",
                              (path, _now(), existing[0]))
            else:
                self._execute(
                    "INSERT INTO project_paths (id, project_id, instance, path, updated_at) "
                    "VALUES (?, ?, ?, ?, ?)", (_uuid(), project_id, instance, path, _now()))

    def project_path(self, slug: str, instance: str) -> str | None:
        project_id = self._project_id(slug)
        if not project_id:
            return None
        row = self._execute(
            "SELECT path FROM project_paths WHERE project_id = ? AND instance = ?",
            (project_id, instance)).fetchone()
        return row[0] if row else None

    # -- state ----------------------------------------------------------------

    def state_get(self, capability: str, key: str, scope: tuple) -> Any:
        """Rule 16: state is read at exactly the scope that minted it. A
        project's state is not a fallback for an instance's, so no cascade."""
        _store_check("capability", capability, CAPABILITY_RE)
        kind, pid = self._target(scope)
        row = self._execute(
            "SELECT value, expires_at FROM state WHERE scope = ? AND COALESCE(project_id,'') = ? "
            "AND capability = ? AND key = ?",
            (kind, pid or "", capability, key)).fetchone()
        if not row or (row[1] and row[1] <= _now()):
            return None
        return self._decode(row[0])

    def state_set(self, capability: str, key: str, value: Any, scope: tuple,
                  ttl_seconds: int | None = None) -> None:
        _store_check("capability", capability, CAPABILITY_RE)
        _store_check("key", key, KEY_RE)
        kind, pid = self._target(scope)
        expires = None
        if ttl_seconds is not None:
            expires = (_store_datetime.now(_store_timezone.utc)
                       + _store_timedelta(seconds=ttl_seconds)).isoformat(timespec="seconds")
        with self.transaction():
            existing = self._execute(
                "SELECT id FROM state WHERE scope = ? AND COALESCE(project_id,'') = ? "
                "AND capability = ? AND key = ?",
                (kind, pid or "", capability, key)).fetchone()
            if existing:
                self._execute(
                    "UPDATE state SET value = ?, updated_at = ?, expires_at = ? WHERE id = ?",
                    (self._encode(value), _now(), expires, existing[0]))
            else:
                self._execute(
                    "INSERT INTO state (id, scope, project_id, capability, key, "
                    "value, updated_at, expires_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
                    (_uuid(), kind, pid, capability, key,
                     self._encode(value), _now(), expires))

    def state_delete(self, capability: str, key: str, scope: tuple) -> bool:
        kind, pid = self._target(scope)
        with self.transaction():
            cur = self._execute(
                "DELETE FROM state WHERE scope = ? AND COALESCE(project_id,'') = ? "
                "AND capability = ? AND key = ?",
                (kind, pid or "", capability, key))
        return bool(cur.rowcount)

    def state_sweep(self) -> int:
        """Drop what has expired. Cheap enough to call on a daemon tick."""
        with self.transaction():
            cur = self._execute(
                "DELETE FROM state WHERE expires_at IS NOT NULL AND expires_at <= ?", (_now(),))
        return cur.rowcount or 0


# --- Adapters ----------------------------------------------------------------

class SQLiteStore(Store):
    """The single-user local floor. Honest about being that: one writer, no
    `SKIP LOCKED`, JSON stored as text and unindexed. A project that never
    leaves one machine needs nothing more."""

    dialect = "sqlite"

    @classmethod
    def open(cls, path: str) -> "SQLiteStore":
        conn = sqlite3.connect(path, isolation_level=None, timeout=15.0)
        conn.execute("PRAGMA journal_mode=WAL")
        conn.execute("PRAGMA foreign_keys=ON")
        conn.execute("PRAGMA busy_timeout=15000")
        return cls(conn)

    def _sql(self, sql: str) -> str:
        return sql

    def _encode(self, value: Any) -> Any:
        return None if value is None else json.dumps(value, ensure_ascii=False, sort_keys=True)

    def _decode(self, raw: Any) -> Any:
        return None if raw is None else json.loads(raw)

    def _ddl_subs(self) -> dict[str, str]:
        return {"json": "TEXT", "serial": "INTEGER PRIMARY KEY AUTOINCREMENT"}

    @contextmanager
    def transaction(self) -> Iterator[None]:
        # BEGIN IMMEDIATE is SQLite's stand-in for the row locks Postgres gives
        # us: it takes the write lock up front rather than discovering the
        # conflict at commit.
        self._conn.execute("BEGIN IMMEDIATE")
        try:
            yield
        except Exception:
            self._conn.execute("ROLLBACK")
            raise
        self._conn.execute("COMMIT")


class PostgresStore(Store):
    """The shared backend. Everything the local floor cannot do — concurrent
    writers, real jsonb, `SKIP LOCKED` for the run queue that lands next — is
    here, and one host's outage is every host's outage, which is the trade."""

    dialect = "postgres"
    _PLACEHOLDER = re.compile(r"\?")

    @classmethod
    def open(cls, url: str) -> "PostgresStore":
        try:
            import psycopg2  # imported lazily: a SQLite-only host never pays
        except ImportError as exc:  # pragma: no cover - depends on host wheels
            raise StoreError("driver_missing", "psycopg2 is not installed",
                             "add psycopg2-binary to the capability's script "
                             "dependencies") from exc
        try:
            conn = psycopg2.connect(url, connect_timeout=10)
        except psycopg2.OperationalError as exc:
            raise StoreError("store_unreachable", f"cannot reach the store: {exc}",
                             "the daemon holds rather than fires while the store "
                             "is unreachable") from exc
        conn.autocommit = False
        return cls(conn)

    def _sql(self, sql: str) -> str:
        return self._PLACEHOLDER.sub("%s", sql)

    def _encode(self, value: Any) -> Any:
        from psycopg2.extras import Json
        return None if value is None else Json(value)

    def _decode(self, raw: Any) -> Any:
        # psycopg2 already adapts jsonb into Python objects.
        return raw

    def _ddl_subs(self) -> dict[str, str]:
        return {"json": "JSONB", "serial": "BIGSERIAL PRIMARY KEY"}


# --- Resolution --------------------------------------------------------------

def default_store_path() -> str:
    """Where records live when nothing says otherwise.

    A store is not optional the way a config source is. A queue, a ledger, a
    cursor have to go somewhere, and letting each capability invent its own
    database for them is how they came to be scattered in the first place. So
    there is always one, and the first caller to ask for it creates it.

    The fenced body cannot ask the manager where that is — it may not import a
    sibling, and a subprocess per open would be absurd — so both compute the
    same XDG convention independently. That is one convention arrived at twice,
    not one value stored twice, but the two must agree: `capabilities path
    store` is the authority, and anything that overrides the location does it
    through `CAPABILITIES_STORE_URL`, which both read first."""
    home = os.environ.get("XDG_STATE_HOME") or os.path.join(
        os.path.expanduser("~"), ".local", "state")
    return os.path.join(home, "capabilities", "store.db")


def open_store(url: str | None = None) -> "Store":
    """The one entry point. `CAPABILITIES_STORE_URL` is the root pointer that
    cannot itself live in the store, which is why it is an environment variable
    beside the secrets the cascade already resolves that way.

    Absent, the local floor is opened at the default path, and created there if
    nothing has created it yet."""
    url = url or os.environ.get("CAPABILITIES_STORE_URL") or default_store_path()
    scheme = urlparse(url).scheme
    if scheme in ("", "sqlite"):
        path = urlparse(url).path if scheme == "sqlite" else url
        if path and path != ":memory:":
            os.makedirs(os.path.dirname(os.path.abspath(path)) or ".", exist_ok=True)
    if scheme in ("postgres", "postgresql"):
        return PostgresStore.open(url)
    if scheme == "sqlite":
        return SQLiteStore.open(urlparse(url).path or ":memory:")
    if not scheme:
        return SQLiteStore.open(url)
    raise StoreError("unknown_store", f"unsupported store scheme {scheme!r}",
                     "expected sqlite:// or postgresql://")


# --- records: the two places a project may keep its configuration ------------
#
# Tracking is not on this axis. Runs, queues and cursors live in the store
# always, because a ledger with a files mode is a ledger nothing can query.
# What a project chooses is where its CONFIGURATION is read and written, and
# these two answer that. A capability calls the same verbs either way and is
# never told which answered, which is the whole point: a call site that can
# tell is a call site that will eventually decide.

DOCUMENT_LOCATIONS: tuple[tuple[str | None, str, str], ...] = (
    ("reference", "{cap}/reference", ".md"),
    ("context", "{cap}/service/context", ".md"),
    ("script", "automations/scripts", ".py"),
    (None, "{cap}/service", ".md"),
)


def _document_key(prefix: str | None, stem: str) -> str:
    """The key a file answers to. Underscores fold to hyphens and case is lost,
    so the map from file to key is one-way — which is why finding a document
    searches rather than computes."""
    slug = stem.replace("_", "-").lower()
    return f"{prefix}.{slug}" if prefix else slug


class Records:
    """The surface a capability reads and writes its configuration through.

    Every verb here is answered by both a directory of files and a database.
    Neither is asked which it is."""

    mode = "?"
    source = "?"

    def __enter__(self) -> "Records":
        return self

    def __exit__(self, *exc: object) -> None:
        self.close()

    def close(self) -> None:
        pass

    def resolve_scope(self, capability: str, collection: str,
                      scope: str) -> dict[str, dict[str, Any]]:
        """Resolve exactly one scope, without inheritance."""
        raise NotImplementedError


class StoreRecords(Records):
    """Configuration kept as rows. Thin, because the store already does this —
    what this adds is a fixed project, so no call site carries a scope it could
    forget."""

    mode = "db"

    def __init__(self, store: "Store", scopes: "Scopes", write_scope: tuple):
        self.store, self.scopes, self.write_scope = store, scopes, write_scope
        self.source = getattr(store, "label", "store")

    def close(self) -> None:
        self.store.close()

    def resolve(self, capability: str, collection: str) -> dict[str, dict[str, Any]]:
        return self.store.config_resolve(capability, collection, self.scopes)

    def resolve_scope(self, capability: str, collection: str,
                      scope: str) -> dict[str, dict[str, Any]]:
        if scope == "project":
            scopes = Scopes(project=self.scopes.project, include_global=False)
        elif scope == "global":
            scopes = Scopes(project=None, include_global=True)
        else:
            raise StoreError("bad_scope",
                             f"scope {scope!r} must be one of {', '.join(SCOPE_KINDS)}")
        return self.store.config_resolve(capability, collection, scopes)

    def get(self, capability: str, collection: str, key: str) -> Any:
        return self.store.config_get(capability, collection, key, self.scopes)

    def set(self, capability: str, collection: str, key: str, value: Any,
            actor: str | None = None, note: str | None = None,
            scope: str | None = None) -> None:
        target = self.write_scope if scope is None else (
            ("global", "") if scope == "global"
            else ("project", self.scopes.project) if scope == "project"
            else None)
        if target is None:
            raise StoreError("bad_scope",
                             f"scope {scope!r} must be one of {', '.join(SCOPE_KINDS)}")
        self.store.config_set(capability, collection, key, value,
                              target, actor=actor, note=note)

    def delete(self, capability: str, collection: str, key: str,
               scope: str | None = None) -> bool:
        target = self.write_scope if scope is None else (
            ("global", "") if scope == "global"
            else ("project", self.scopes.project) if scope == "project"
            else None)
        if target is None:
            raise StoreError("bad_scope",
                             f"scope {scope!r} must be one of {', '.join(SCOPE_KINDS)}")
        return self.store.config_delete(capability, collection, key, target)

    def connections(self, capability: str, write_default: bool = False,
                    include_disabled: bool = False) -> dict[str, dict[str, Any]]:
        return self.store.connections_effective(
            capability, self.scopes, write_default=write_default,
            include_disabled=include_disabled)

    def document_read(self, capability: str, key: str) -> dict[str, Any] | None:
        return self.store.context_read(capability, key, self.scopes)

    def document_keys(self, capability: str) -> list[str]:
        return self.store.context_keys(capability, self.scopes)

    def collection_source(self, capability: str, collection: str) -> str:
        """What answered. A row has no path, so the store says so as itself."""
        return self.source

    def document_path(self, capability: str, key: str) -> Path | None:
        """Nothing to open: a version in the store is not a file anywhere. The
        working copy an edit needs is the caller's to make, and `put` is what
        makes it land."""
        return None

    def document_put(self, capability: str, key: str, body: str,
                     author: str | None = None, media_type: str | None = None,
                     base: str | None = None) -> str:
        if base is not None:
            current = self.store.context_read(capability, key, self.scopes)
            live = current["hash"] if current else None
            if live != base:
                raise StoreError(
                    "stale_edit",
                    f"{capability}/{key} was {live or 'absent'} when this landed, "
                    f"not {base} as it was when the edit began",
                    "re-read it and apply the change again")
        return self.store.context_put(capability, key, body, self.write_scope,
                                      author=author, media_type=media_type,
                                      activate=True)


class FileRecords(Records):
    """Configuration kept as the files the envelope has always held.

    The layout is not invented here — it is the one the capabilities already
    read, described in one place instead of re-derived at each call site. Two
    directories with that layout make the scope chain: the project's envelope,
    then the user's config home."""

    mode = "files"

    def __init__(self, envelope: Path, global_dir: Path,
                 project_id: str | None = None, project: str | None = None,
                 include_global: bool = True):
        self.envelope, self.global_dir = Path(envelope), Path(global_dir)
        self.project_id, self.project = project_id, project
        self.include_global = bool(include_global)
        self.source = str(self.envelope)

    # -- where a record lives --------------------------------------------------

    def _chain(self) -> list[tuple[str, str | None, Path]]:
        chain = [("project", self.project_id, self.envelope)]
        if self.include_global:
            chain.append(("global", None, self.global_dir))
        return chain

    @staticmethod
    def _load(path: Path) -> Any:
        try:
            return json.loads(path.read_text())
        except FileNotFoundError:
            return None
        except (OSError, ValueError) as exc:
            raise StoreError("bad_config", f"cannot read {path}: {exc}") from None

    @staticmethod
    def _save(path: Path, body: Any, sort: bool = False) -> None:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(body, indent=2, ensure_ascii=False,
                                   sort_keys=sort) + "\n")

    def _policy_file(self, root: Path) -> Path:
        """The gate. A project keeps it at the envelope root; the config home
        keeps it under the manager's own name, which is the same rule seen from
        outside -- there, `capabilities` is a capability like any other."""
        return (root / "settings.json" if root == self.envelope
                else root / "capabilities" / "settings.json")

    def _file(self, root: Path, capability: str, collection: str,
              key: str | None = None) -> Path:
        if collection == "policy":
            return self._policy_file(root)
        if collection == "identifier":
            return root / capability / "identifiers.json"
        if collection in ("connection", "grant"):
            return root / capability / "connections.json"
        if collection == "setting":
            if key == "connection.default":
                return root / capability / "connections.json"
            return root / capability / "service" / "settings.json"
        raise StoreError("bad_collection",
                         f"collection {collection!r} is not kept in files",
                         "it exists only where the project keeps records in the store")

    # -- reading ---------------------------------------------------------------

    def _entries(self, root: Path, capability: str, collection: str) -> dict[str, Any]:
        """Every entry of one collection held at one scope, keyed as the store
        keys them, so the two agree on what a record is called."""
        if collection == "policy":
            body = self._load(self._policy_file(root)) or {}
            return dict((body.get("capabilities") or {}))
        if collection == "identifier":
            body = self._load(root / capability / "identifiers.json") or {}
            raw = body.get("identifiers") if isinstance(body.get("identifiers"), dict) else body
            out = {}
            for label, entry in raw.items():
                out[label] = entry["value"] if isinstance(entry, dict) and "value" in entry else entry
            return out
        registry = self._load(root / capability / "connections.json") or {}
        if collection in ("connection", "grant"):
            declared = registry.get("connections")
            if not isinstance(declared, dict):
                return {}
            out = {}
            for cid, entry in declared.items():
                if not isinstance(entry, dict):
                    continue
                if collection == "connection":
                    out[cid] = {k: v for k, v in entry.items() if k not in GRANT_FIELDS}
                else:
                    grant = {k: entry[k] for k in GRANT_FIELDS if k in entry}
                    if grant:
                        out[cid] = grant
            return out
        if collection == "setting":
            out = {}
            if registry.get("default"):
                out["connection.default"] = registry["default"]
            service = self._load(root / capability / "service" / "settings.json")
            if isinstance(service, dict):
                out.update(service)
            return out
        raise StoreError("bad_collection", f"unknown collection {collection!r}",
                         f"known: {', '.join(sorted(COLLECTIONS))}")

    def _note(self, root: Path, capability: str, collection: str, key: str) -> str | None:
        if collection != "identifier":
            return None
        body = self._load(root / capability / "identifiers.json") or {}
        raw = body.get("identifiers") if isinstance(body.get("identifiers"), dict) else body
        entry = raw.get(key)
        return entry.get("note") if isinstance(entry, dict) else None

    def config_layers(self, capability: str, collection: str,
                      _scopes: Any = None) -> list[dict[str, dict[str, Any]]]:
        """Each scope's own rows, highest scope first, uncollapsed — the same
        question `Store.config_layers` answers, asked of the two directories."""
        _store_check("capability", capability, CAPABILITY_RE)
        Store._semantics(collection)
        layers: list[dict[str, dict[str, Any]]] = []
        for scope, pid, root in self._chain():
            entries = self._entries(root, capability, collection)
            if not entries:
                continue
            layers.append({
                key: {"id": f"{scope}:{capability}/{collection}/{key}", "scope": scope,
                      "project_id": pid, "capability": capability,
                      "collection": collection, "key": key, "value": value,
                      "note": self._note(root, capability, collection, key),
                      "updated_at": None, "updated_by": None}
                for key, value in entries.items()
            })
        return layers

    def resolve(self, capability: str, collection: str) -> dict[str, dict[str, Any]]:
        semantics = Store._semantics(collection)
        out: dict[str, dict[str, Any]] = {}
        for rows in self.config_layers(capability, collection):
            if semantics == FIRST:
                return rows
            for key, row in rows.items():
                prior = out.get(key)
                if prior is None:
                    out[key] = row
                elif (collection == "connection" and not prior["value"]
                        and row["value"]):
                    # One file holds both records here, so an entry carrying
                    # only grant fields yields an identity with no fields. That
                    # is a decision about an inherited connection, never a
                    # replacement for it: it must not blank the identity the
                    # lower scope declared. Where nothing is inherited the
                    # fieldless identity stands, which is the only reading a
                    # glued file leaves for it.
                    out[key] = row
        return out

    def resolve_scope(self, capability: str, collection: str,
                      scope: str) -> dict[str, dict[str, Any]]:
        _store_check("capability", capability, CAPABILITY_RE)
        if scope == "project":
            root, pid = self.envelope, self.project_id
        elif scope == "global":
            root, pid = self.global_dir, None
        else:
            raise StoreError("bad_scope",
                             f"scope {scope!r} must be one of {', '.join(SCOPE_KINDS)}")
        return {
            key: {"id": f"{scope}:{capability}/{collection}/{key}",
                  "scope": scope, "project_id": pid,
                  "capability": capability, "collection": collection,
                  "key": key, "value": value,
                  "note": self._note(root, capability, collection, key),
                  "updated_at": None, "updated_by": None}
            for key, value in self._entries(root, capability, collection).items()
        }

    def get(self, capability: str, collection: str, key: str) -> Any:
        entry = self.resolve(capability, collection).get(key)
        return entry["value"] if entry else None

    def collection_source(self, capability: str, collection: str) -> str:
        """The file that answered, named exactly. A report that says only
        "files" makes the reader go and find out which one, and the scope a
        record resolved at is half of what they came to learn."""
        for _scope, _pid, root in self._chain():
            if self._entries(root, capability, collection):
                return str(self._file(root, capability, collection))
        return str(self._file(self.envelope, capability, collection))

    def connections(self, capability: str, write_default: bool = False,
                    include_disabled: bool = False) -> dict[str, dict[str, Any]]:
        """Assembled exactly as the store assembles it, from the same two
        collections, so a project changing where it keeps records does not
        change which connection answers."""
        return Store.connections_effective(
            self, capability, None, write_default=write_default,
            include_disabled=include_disabled)

    def config_resolve(self, capability: str, collection: str, _scopes: Any) -> dict:
        """`connections_effective` reaches for this name; the scopes it passes
        are already fixed here."""
        return self.resolve(capability, collection)

    # -- writing ---------------------------------------------------------------

    def set(self, capability: str, collection: str, key: str, value: Any,
            actor: str | None = None, note: str | None = None,
            scope: str | None = None) -> None:
        _store_check("capability", capability, CAPABILITY_RE)
        _store_check("key", key, KEY_RE)
        Store._semantics(collection)
        target_scope = scope or "project"
        if target_scope not in SCOPE_KINDS:
            raise StoreError("bad_scope",
                             f"scope {target_scope!r} must be one of {', '.join(SCOPE_KINDS)}")
        root = self.envelope if target_scope == "project" else self.global_dir
        if target_scope == "project" and not self.envelope.is_dir():
            raise StoreError("no_envelope", "no capabilities/ envelope in this project",
                             "run `capabilities init` first")
        path = self._file(root, capability, collection, key)
        body = self._load(path)
        body = body if isinstance(body, dict) else {}
        if collection == "policy":
            body.setdefault("capabilities", {})[key] = value
        elif collection == "identifier":
            # Flat at the top level, which is the shape the envelope has always
            # had and the shape `audit` holds this to. A file already carrying
            # the wrapper keeps it: reshaping someone's file on an unrelated
            # write is not this writer's business.
            holder = (body["identifiers"] if isinstance(body.get("identifiers"), dict)
                      else body)
            holder[key] = {"value": value, "note": note or ""}
        elif collection in ("connection", "grant"):
            entry = body.setdefault("connections", {}).setdefault(key, {})
            if collection == "connection":
                for field in list(entry):
                    if field not in GRANT_FIELDS:
                        entry.pop(field)
                entry.update(value if isinstance(value, dict) else {})
            else:
                entry.update({k: v for k, v in (value or {}).items() if k in GRANT_FIELDS})
        elif key == "connection.default":
            body["default"] = value
        else:
            body[key] = value
        self._save(path, body, sort=collection == "identifier")

    def delete(self, capability: str, collection: str, key: str,
               scope: str | None = None) -> bool:
        target_scope = scope or "project"
        if target_scope not in SCOPE_KINDS:
            raise StoreError("bad_scope",
                             f"scope {target_scope!r} must be one of {', '.join(SCOPE_KINDS)}")
        root = self.envelope if target_scope == "project" else self.global_dir
        path = self._file(root, capability, collection, key)
        body = self._load(path)
        if not isinstance(body, dict):
            return False
        if collection == "policy":
            gone = (body.get("capabilities") or {}).pop(key, None) is not None
        elif collection == "identifier":
            holder = body.get("identifiers") if isinstance(body.get("identifiers"), dict) else body
            gone = holder.pop(key, None) is not None
        elif collection in ("connection", "grant"):
            entry = (body.get("connections") or {}).get(key)
            if not isinstance(entry, dict):
                return False
            if collection == "connection":
                gone = body["connections"].pop(key, None) is not None
            else:
                gone = any(entry.pop(field, None) is not None for field in GRANT_FIELDS)
        elif key == "connection.default":
            gone = body.pop("default", None) is not None
        else:
            gone = body.pop(key, None) is not None
        if gone:
            self._save(path, body, sort=collection == "identifier")
        return gone

    # -- documents -------------------------------------------------------------

    def _documents(self, root: Path, capability: str) -> dict[str, Path]:
        """Every long-text file this scope holds, by the key it answers to. The
        map is built by walking rather than by computing a path from a key,
        because the key loses case and underscores on the way in."""
        found: dict[str, Path] = {}
        for prefix, shape, suffix in DOCUMENT_LOCATIONS:
            if prefix == "script" and capability != "automations":
                continue
            folder = root / shape.format(cap=capability)
            if not folder.is_dir():
                continue
            for path in sorted(folder.glob(f"*{suffix}")):
                if path.is_file():
                    found.setdefault(_document_key(prefix, path.stem), path)
        return found

    def document_path(self, capability: str, key: str) -> Path | None:
        """The file this key names. It is the truth here, not a copy of it, so
        an edit to what this returns is the edit — which is why `put` validates
        rather than transports."""
        for _scope, _pid, root in self._chain():
            path = self._documents(root, capability).get(key)
            if path:
                return path
        return None

    def document_read(self, capability: str, key: str) -> dict[str, Any] | None:
        for scope, pid, root in self._chain():
            path = self._documents(root, capability).get(key)
            if not path:
                continue
            body = path.read_text()
            return {"id": str(path), "key": key,
                    "hash": hashlib.sha256(body.encode()).hexdigest()[:HASH_LENGTH],
                    "body": body, "media_type": None, "author": None,
                    "created_at": None, "scope": (scope, pid), "path": str(path)}
        return None

    def document_keys(self, capability: str) -> list[str]:
        keys: set[str] = set()
        for _scope, _pid, root in self._chain():
            keys.update(self._documents(root, capability))
        return sorted(keys)

    def document_put(self, capability: str, key: str, body: str,
                     author: str | None = None, media_type: str | None = None,
                     base: str | None = None) -> str:
        path = self._documents(self.envelope, capability).get(key)
        if path is None:
            path = self._new_document_path(capability, key)
        if base is not None and path.is_file():
            current = path.read_text()
            live = hashlib.sha256(current.encode()).hexdigest()[:HASH_LENGTH]
            # In files mode `context edit` deliberately hands out the truth,
            # not a copy. By put-time the live hash is therefore expected to
            # differ from the checkout hash; equality of the submitted body and
            # the file proves the edit landed at the path the adapter named.
            if live != base and current != body:
                raise StoreError(
                    "stale_edit",
                    f"{path} is {live} now, not {base} as it was when the edit began",
                    "re-read it and apply the change again")
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(body)
        return hashlib.sha256(body.encode()).hexdigest()[:HASH_LENGTH]

    def _new_document_path(self, capability: str, key: str) -> Path:
        """Where a document this project does not have yet would go. The prefix
        chooses the folder; what follows it is the file."""
        for prefix, shape, suffix in DOCUMENT_LOCATIONS:
            if prefix and key.startswith(prefix + "."):
                return self.envelope / shape.format(cap=capability) / (key[len(prefix) + 1:] + suffix)
        prefix, shape, suffix = DOCUMENT_LOCATIONS[-1]
        return self.envelope / shape.format(cap=capability) / (key + suffix)

    # -- what a directory cannot answer ---------------------------------------

    def _refuse(self, what: str) -> None:
        raise StoreError("files_mode", f"{what} needs records kept in the store",
                         "this project keeps them in files, where there is no history")

    def revisions(self, *_a: Any, **_k: Any) -> list:
        self._refuse("a record's history")
        return []

    def document_versions(self, *_a: Any, **_k: Any) -> list:
        self._refuse("a document's earlier versions")
        return []


def records_mode(envelope: Path | str) -> tuple[str, str]:
    """Where this project keeps its configuration, and what said so.

    This is the only place the choice is read. Everything downstream takes an
    adapter and cannot tell which it got, because a call site that can tell is
    a call site that will eventually decide for itself."""
    override = os.environ.get("CAPABILITIES_STORE_MODE")
    if override:
        if override not in ("files", "db"):
            raise StoreError("bad_store_mode",
                             f"CAPABILITIES_STORE_MODE must be files or db, got {override!r}")
        return (override, "CAPABILITIES_STORE_MODE")
    identity_file = Path(envelope) / "project.json"
    try:
        identity = json.loads(identity_file.read_text())
    except (OSError, ValueError):
        return ("files", "no project identity")
    mode = identity.get("store", "files")
    if mode not in ("files", "db"):
        raise StoreError("bad_store_mode", f"{identity_file} declares store {mode!r}",
                         'expected "files" or "db"')
    return (mode, str(identity_file))


def open_records(envelope: Path | str, global_dir: Path | str,
                 url: str | None = None, project_only: bool = False) -> Records:
    """The adapter this project's configuration is read and written through."""
    envelope, global_dir = Path(envelope), Path(global_dir)
    mode, source = records_mode(envelope)
    identity = {}
    try:
        identity = json.loads((envelope / "project.json").read_text())
    except (OSError, ValueError):
        pass
    slug, project_id = identity.get("slug"), identity.get("id")
    if mode == "files":
        adapter = FileRecords(envelope, global_dir, project_id, slug,
                              include_global=not project_only)
        adapter.source = source if source == "CAPABILITIES_STORE_MODE" else str(envelope)
        return adapter
    if not slug:
        raise StoreError("no_project_identity",
                         f"{envelope / 'project.json'} keeps this project's records "
                         "in the store but declares no slug to read them under",
                         "run `capabilities init` in the project")
    store = open_store(url)
    return StoreRecords(store, Scopes(project=slug, include_global=not project_only),
                        ("project", slug))

# <<< contract: store <<<


# >>> contract: connections (generated — edit contract/preamble.py, run `capabilities sync-contract`) >>>

def _resolve_env_key(key: str) -> tuple[str | None, str | None, Path | None]:
    """Resolve one env key through cascade tiers 2-4: project .env(.local) →
    user credentials.env → process env. Returns (value, tier, source)."""
    root = _project_root()
    if root is not None:
        for fname in (".env.local", ".env"):
            val = _parse_env_file(root / fname).get(key)
            if val:
                return val, "project", root / fname
    val = _parse_env_file(CREDENTIALS_ENV).get(key)
    if val:
        return val, "user", CREDENTIALS_ENV
    val = os.environ.get(key)
    if val:
        return val, "env", None
    return None, None, None


def _mask(value: str) -> str:
    return ("…" + value[-4:]) if len(value) >= 8 else "****"


def _grant_hint(cid: str) -> str:
    """One wording for the one way a project grants an inherited connection.

    Same shape as `_write_gate`'s: the gate is the human's to lift, never the
    agent's, and the hint carries the exact command rather than a description
    of one. Where no project resolves there is no scope to grant in, so the
    hint names the command that makes one and then the grant, in the order they
    have to happen."""
    grant = f"`capabilities set {NAME} grant {cid} '{{\"enabled\": true}}'`"
    if _project_root() is None:
        return ("Do not lift the gate yourself — ask the user; run "
                f"`capabilities init` in the project that should use {NAME}, "
                f"then {grant} there.")
    return ("Do not lift the gate yourself — ask the user; granting is "
            f"{grant} run inside this project.")


def _grant_gate(reg: dict, cid: str) -> None:
    """Refuse a connection this project may not use, for read as for write.

    A connection declared outside the project is not the project's to use until
    the project itself says so, and one the project switched off is off;
    nothing in the cascade lifts either. Outside a project there is no scope in
    which anything could have said so, which is a different situation and says
    so rather than asserting a project that is not there."""
    entry = (reg.get("withheld") or {}).get(cid)
    if entry is None:
        return
    if entry.get("scope") == "project":
        message = f"connection {cid!r} is disabled in this project"
    elif _project_root() is None:
        message = (f"connection {cid!r} is declared globally and there is no "
                   f"project here to grant it in")
    else:
        message = (f"connection {cid!r} is declared outside this project and "
                   f"this project has not granted it")
    _die(4, "connection_not_granted", message, _grant_hint(cid))


def _connections_composed() -> dict:
    """The connections envelope shape, composed out of resolved records.

    Deliberately reconstituted rather than returned in some store-shaped form:
    selection, the write gate and the `connections` report all read the envelope
    shape, and they should not learn where the rows came from. What changes here
    is the source, never the shape.

    The permission a project was granted is folded back onto the entry as
    `allow_write`, which is where the rest of the contract looks for it.

    A connection this project may not use is kept apart under `withheld`, not
    dropped: `connections` holds exactly what may be acted on — which is what
    every capability's own report iterates — while selection still has the name
    it needs to explain a refusal instead of pretending the connection was
    never declared."""
    adapter = _records()
    try:
        effective = adapter.connections(NAME, write_default=WRITE_DEFAULT,
                                        include_disabled=True)
        default = adapter.get(NAME, "setting", "connection.default")
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)
    if not effective:
        _die(6, "connections_required",
             f"{NAME} requires an explicit connections registry and "
             f"{adapter.source} holds none",
             'expected {"default": "<id>", "connections": {"<id>": { ... }}}')
    usable = {cid: e for cid, e in effective.items() if e["enabled"]}
    withheld = {cid: e for cid, e in effective.items() if not e["enabled"]}
    if not usable:
        named = ", ".join(sorted(withheld))
        if _project_root() is None:
            refusal = (f"there is no project here to use a {NAME} connection in, "
                       f"so every connection declared globally stays "
                       f"withheld: {named}")
        else:
            refusal = (f"no {NAME} connection is usable in this project; every "
                       f"one it can see is withheld: {named}")
        _die(4, "connection_not_granted", refusal, _grant_hint("<id>"))
    return {
        "default": default,
        "connections": {cid: {**entry["value"], "allow_write": entry["allow_write"]}
                        for cid, entry in usable.items()},
        "withheld": {cid: {"scope": entry["scope"][0]}
                     for cid, entry in withheld.items()},
    }


def _connections_registry() -> tuple[dict | None, Path | str | None]:
    """The connections envelope and where it came from.

    Composed from the two records a connection is kept as -- who it is, and
    what this project may do with it -- and handed on in the shape the rest of
    the contract already reads, so selection, the write gate and the report
    never learn which source answered."""
    return _connections_composed(), _records().collection_source(NAME, "connection")


def _select_connection(reg: dict | None, wanted: str | None) -> tuple[str, dict | None]:
    """flag → default pointer → sole entry → die 6. A connection's own
    `address` field selects it too (used where a
    connection carries a human-recognizable address; absent fields never match).

    A connection the project was never granted is refused here rather than
    reported missing, so the one enforcement point every capability already
    routes through is also the one that answers "why not"."""
    if reg is None:
        _die(6, "connections_required",
             f"{NAME} requires an explicit connections registry")
    conns = reg["connections"]
    if wanted:
        if wanted in conns:
            return wanted, conns[wanted]
        for cid, entry in conns.items():
            if (entry or {}).get("address", "").lower() == wanted.lower():
                return cid, entry
        _grant_gate(reg, wanted)
        _die(6, "unknown_connection", f"no connection matches {wanted!r}",
             f"known: {', '.join(conns)}")
    default = reg.get("default")
    if default:
        if default not in conns:
            _grant_gate(reg, default)
            _die(6, "bad_default", f"default points to unknown connection {default!r}",
                 f"known: {', '.join(conns)}")
        return default, conns[default]
    if len(conns) == 1:
        cid = next(iter(conns))
        return cid, conns[cid]
    _die(6, "ambiguous_connection",
         f"registry defines {len(conns)} connections and no default; "
         f"pass --connection <id>",
         f"known: {', '.join(conns)}")


def _write_gate(conn_id: str, allow_write: bool, verb: str) -> None:
    """Policy from the committed registry; nothing in the cascade lifts it."""
    if verb in WRITE_VERBS and not allow_write:
        _die(4, "read_only",
             f"connection {conn_id!r} does not allow writes",
             "Do not lift the gate yourself — ask the user; granting is "
             "`allow_write: true` on this connection in connections.json.")


def _key_report(key: str, secret: bool, required: bool,
                value: str | None, tier: str | None, source) -> dict:
    return {"key": key, "secret": secret, "required": required,
            "set": bool(value), "tier": tier if value else None,
            "source": str(source) if (value and source) else None,
            "value": (_mask(value) if secret else value) if value else None}


def _missing_required(keys: list) -> list:
    """Required report rows (from _key_report) that did not resolve through the
    cascade — empty ⇒ credentials present. The primitive behind doctor's
    network-free readiness gate, read from the same per-key resolution
    `connections` reports, so the gate and the report can never disagree."""
    return [k["key"] for k in keys if k["required"] and not k["set"]]


def _doctor_gate(report: dict, wanted: str | None) -> None:
    """doctor's network-free readiness gate. Refuse with exit 2 — naming the
    unresolved required keys, before any round-trip — when a connection under
    test cannot resolve its required config through the cascade, so readiness is
    judged by the same resolution `connections` reports, never a parallel check.
    Checks the selected connection, else every connection in the report."""
    conns = report.get("connections") or {}
    targets = [wanted] if (wanted and wanted in conns) else list(conns)
    problems: dict = {}
    for cid in targets:
        miss = _missing_required((conns.get(cid) or {}).get("keys") or [])
        if miss:
            problems[cid] = miss
    if problems:
        detail = "; ".join(f"{c}: {', '.join(ks)}" for c, ks in sorted(problems.items()))
        _die(2, "credentials_missing",
             f"unresolved required config — {detail}",
             f"set each in the project .env/.env.local, the user credentials.env, "
             f"or process env; `{NAME} connections` shows where every value resolves")

# <<< contract: connections <<<


class _Refusal(Exception):
    """A handled failure, raised rather than exited.

    Every path still ends as the one error envelope and its exit code — `_run`
    performs that at the edge. Raising it first is what lets a caller answering
    for several connections fold one connection's refusal into its report
    instead of ending the run at the first."""

    def __init__(self, exit_code: int, code: str, message: str,
                 hint: str | None = None):
        super().__init__(message)
        self.exit_code = exit_code
        self.code = code
        self.message = message
        self.hint = hint

    def as_result(self) -> dict:
        out = {"ok": False, "category": self.exit_code, "error": self.message}
        if self.hint:
            out["hint"] = self.hint
        return out


def _refuse(exit_code: int, code: str, message: str,
            hint: str | None = None, status: int | None = None) -> NoReturn:
    """Refuse the way `_die` does, at one remove, so a caller may catch it."""
    if status is not None:
        message = f"{message} (status {status})"
    raise _Refusal(exit_code, code, message, hint)


def _log(message: str) -> None:
    """Progress / diagnostics to stderr, keeping stdout clean for the result."""
    sys.stderr.write(message + "\n")


def _write_json(path: Path, payload) -> None:
    """Replace a file in one step.

    An export and its transcriptions are the only copy of work that took
    minutes and, for media past its retention, cannot be produced again. A
    write interrupted part-way through would leave that copy truncated, so the
    new content is completed beside it and moved into place."""
    body = json.dumps(payload, ensure_ascii=False, indent=2)
    temporary = path.with_name(path.name + ".writing")
    try:
        temporary.write_text(body)
        os.replace(temporary, path)
    except BaseException:
        temporary.unlink(missing_ok=True)
        raise


# --- Connections (capability-specific) --------------------------------------

# The engine a connection is driven by. The in-house one carries whatsmeow
# inside the installed wheel and needs no server; the bridge one speaks to a
# self-hosted WAHA instance over HTTP.
ENGINE_INHOUSE = "whatsmeow"
ENGINE_WAHA = "waha"
# WAHA names its own engines. An entry naming one selects the bridge and pins
# the mode that bridge must be running in.
_WAHA_ENGINE_NAMES = {"GOWS", "WEBJS", "NOWEB", "VENOM"}
DEFAULT_SYNC_DAYS = 30
DEFAULT_ROUNDS = 10
HISTORY_PAGE = 50
PAIR_HOLD_DEFAULT = 180


def _entry_engine(entry: dict) -> tuple[str, str | None, bool]:
    """(engine, waha_engine, stated) for one connection entry.

    An entry that names its engine is taken at its word. An entry that does not
    is read from what it carries: `base_url` is an address, and only the bridge
    has one to address, so an entry holding it is a bridge entry whether or not
    it ever said so. Silence with nothing to address is the engine this CLI
    carries. `stated` says which of the two answered, so the resolution report
    can show a value the entry does not contain without claiming the entry
    contains it."""
    entry = entry if isinstance(entry, dict) else {}
    raw = str(entry.get("engine") or "").strip()
    if not raw:
        if entry.get("base_url"):
            return ENGINE_WAHA, str(entry.get("waha_engine") or "GOWS").upper(), False
        return ENGINE_INHOUSE, None, False
    if raw.upper() in _WAHA_ENGINE_NAMES:
        return ENGINE_WAHA, raw.upper(), True
    low = raw.lower()
    if low == ENGINE_WAHA:
        return ENGINE_WAHA, str(entry.get("waha_engine") or "GOWS").upper(), True
    if low == ENGINE_INHOUSE:
        return ENGINE_INHOUSE, None, True
    return low, None, True    # unknown — refused by name in _build_cfg


def _digits(value) -> str | None:
    d = re.sub(r"\D", "", str(value or ""))
    return d or None


def _messages_dir_for(entry: dict) -> str | None:
    """The export root: the entry's `messages_dir`, else <envelope>/messages.
    Relative paths resolve against the project envelope's capability folder."""
    envdir = _env_dir()
    md = (entry or {}).get("messages_dir")
    if md:
        p = Path(str(md)).expanduser()
        if p.is_absolute():
            return str(p)
        return str((envdir / p)) if envdir is not None else None
    return str(envdir / "messages") if envdir is not None else None


def _build_cfg(cid: str, entry: dict | None,
               session_flag: str | None = None) -> tuple[dict | None, dict | None]:
    """Materialize one connection into the config dict every command consumes.
    Returns (cfg, problem) — problem is an error dict ({"exit", "code",
    "message", "hint"?}) instead of a die, so doctor can report every connection
    rather than stopping at the first."""
    entry = entry if isinstance(entry, dict) else {}
    engine, waha_engine, _stated = _entry_engine(entry)
    allow_write = bool(entry.get("allow_write", WRITE_DEFAULT))
    cfg = {
        "id": cid,
        "profile": cid,
        "engine": engine,
        "allow_write": allow_write,
        "mode": "send" if allow_write else "read",
        "number": _digits(entry.get("number")),
        "expected_account_id": _digits(entry.get("expected_account_id")),
        "messages_dir": _messages_dir_for(entry),
    }

    if engine == ENGINE_INHOUSE:
        if entry.get("base_url"):
            return None, {
                "exit": 6, "code": "engine_mismatch",
                "message": f"connection {cid!r} declares the in-house engine, "
                           f"which addresses no server, and carries a base_url",
                "hint": 'change "engine" to "waha" to drive that bridge, or drop '
                        "base_url to run the engine this CLI carries"}
        try:
            days = int(entry.get("initial_sync_days") or DEFAULT_SYNC_DAYS)
        except (TypeError, ValueError):
            return None, {"exit": 6, "code": "bad_sync_days",
                          "message": f"connection {cid!r}: initial_sync_days must "
                                     f"be a whole number of days"}
        if days < 1:
            return None, {"exit": 6, "code": "bad_sync_days",
                          "message": f"connection {cid!r}: initial_sync_days must be >= 1"}
        key = cfg["expected_account_id"] or cfg["number"]
        if not key:
            return None, {
                "exit": 6, "code": "no_account_identity",
                "message": f"connection {cid!r} names no account, and this "
                           f"engine keeps a capture under the account's own "
                           f"identity rather than under the connection's name",
                "hint": "add the account's phone number as `number` (digits "
                        "with country code), or pin it as expected_account_id"}
        cfg.update({
            "account_key": key,
            "home": str(_account_home(key, cid)),
            "device_name": entry.get("device_name") or None,
            "initial_sync_days": days,
        })
        return cfg, None

    if engine == ENGINE_WAHA:
        base_url = entry.get("base_url")
        if not base_url:
            return None, {"exit": 6, "code": "missing_base_url",
                          "message": f"connection {cid!r} has no base_url",
                          "hint": "add the WAHA instance URL as base_url in connections.json"}
        secret_env = entry.get("secret_env")
        api_key = _resolve_env_key(secret_env)[0] if secret_env else None
        user_env = entry.get("dashboard_user_env")
        pass_env = entry.get("dashboard_pass_env")
        username = _resolve_env_key(user_env)[0] if user_env else None
        password = _resolve_env_key(pass_env)[0] if pass_env else None
        if not api_key and not (username and password):
            return None, {
                "exit": 2, "code": "missing_secret",
                "message": f"connection {cid!r}: no credentials resolved",
                "hint": f"set the env var named by secret_env "
                        f"({secret_env or 'unset'}) in the project .env(.local), "
                        f"{CREDENTIALS_ENV}, or the environment"}
        cfg.update({
            "api_key": api_key,
            "username": username,
            "password": password,
            "base_url": str(base_url).rstrip("/"),
            "session": session_flag or entry.get("session") or DEFAULT_SESSION,
            "expected_engine": waha_engine or "GOWS",
            "expected_tier": entry.get("tier"),
        })
        return cfg, None

    return None, {"exit": 6, "code": "unknown_engine",
                  "message": f"connection {cid!r} declares engine {engine!r}",
                  "hint": f'engine is "{ENGINE_INHOUSE}" (the default) or "{ENGINE_WAHA}"'}


def get_config(args=None):
    """Resolve the active connection into the config dict the commands consume."""
    reg, _ = _connections_registry()
    cid, entry = _select_connection(reg, getattr(args, "connection", None))
    cfg, problem = _build_cfg(cid, entry, getattr(args, "session", None))
    if problem:
        _refuse(problem["exit"], problem["code"], problem["message"], problem.get("hint"))
    return cfg


def _connections_report() -> dict:
    """The resolution report — every connection, every value, its winning tier
    and source, secrets masked. Local only: no network, no session opened."""
    reg, reg_path = _connections_registry()
    report: dict = {"default": None, "connections": {}}
    conns = reg["connections"]
    report["default"] = reg.get("default") or \
        (next(iter(conns)) if len(conns) == 1 else None)
    for cid, entry in conns.items():
        entry = entry if isinstance(entry, dict) else {}
        engine, waha_engine, stated = _entry_engine(entry)
        keys = [_key_report("engine", False, False, engine,
                            "connection" if stated else "derived",
                            reg_path if stated else None)]
        if engine == ENGINE_WAHA:
            fields = [("base_url", True), ("session", False), ("number", False),
                      ("waha_engine", False), ("tier", False), ("messages_dir", False)]
            for field, required in fields:
                value = waha_engine if field == "waha_engine" else entry.get(field)
                keys.append(_key_report(
                    field, False, required,
                    str(value) if value is not None else None, "connection", reg_path))
            secret_env = entry.get("secret_env")
            if secret_env:
                value, tier, source = _resolve_env_key(secret_env)
                keys.append(_key_report(secret_env, True, True, value, tier, source))
            else:
                keys.append(_key_report("secret_env", False, True, None, None, None))
            for fld, env_key in (("dashboard_user_env", entry.get("dashboard_user_env")),
                                 ("dashboard_pass_env", entry.get("dashboard_pass_env"))):
                if env_key:
                    value, tier, source = _resolve_env_key(env_key)
                    keys.append(_key_report(env_key, fld.endswith("pass_env"),
                                            False, value, tier, source))
        else:
            # The in-house engine configures no secret: the credential is the
            # linked-device session, minted by `pair` into the state home. Every
            # value here is chosen, non-secret, and optional.
            for field in ("number", "expected_account_id", "device_name",
                          "initial_sync_days", "messages_dir"):
                value = entry.get(field)
                keys.append(_key_report(
                    field, False, False,
                    str(value) if value is not None else None, "connection", reg_path))
        for spec in CRED_KEYS:
            value, tier, source = _resolve_env_key(spec["key"])
            keys.append(_key_report(spec["key"], spec["secret"], spec["required"],
                                    value, tier, source))
        report["connections"][cid] = {
            "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT)),
            "keys": keys}
    return report


def _cmd_connections() -> None:
    _emit(_connections_report())


def _auth_headers(config) -> dict:
    headers: dict = {}
    if config.get("api_key"):
        headers["X-Api-Key"] = config["api_key"]
    if config.get("username") and config.get("password"):
        credentials = f"{config['username']}:{config['password']}"
        b64 = base64.b64encode(credentials.encode()).decode()
        headers["Authorization"] = f"Basic {b64}"
    return headers


# ── Resilient HTTP ────────────────────────────────────────────────────────────


TIMEOUT = httpx.Timeout(60.0)
MAX_RETRIES = 3
_CLIENT: httpx.Client | None = None


class HttpFailure(Exception):
    """A handled request failure, carrying the _die taxonomy. Raised by
    `_request` so a caller decides whether to die (hard) or recover (soft)."""

    def __init__(self, exit_code, code, message, hint=None, status=None):
        super().__init__(message)
        self.exit_code = exit_code
        self.code = code
        self.message = message
        self.hint = hint
        self.status = status


def _client() -> httpx.Client:
    global _CLIENT
    if _CLIENT is None:
        _CLIENT = httpx.Client(timeout=TIMEOUT, follow_redirects=True)
    return _CLIENT


def _http_error_message(resp: httpx.Response) -> str:
    try:
        body = resp.json()
        if isinstance(body, dict):
            return body.get("message") or body.get("error") or resp.text
    except Exception:
        pass
    return resp.text or f"HTTP {resp.status_code}"


def _request(method: str, url: str, *, headers: dict | None = None,
             json_body=None, content: bytes | None = None,
             timeout: float | None = None, raw: bool = False,
             service: str = "WAHA"):
    """One request through the shared client with bounded, backed-off retries.

    429 honours Retry-After; timeouts and 5xx back off attempt*1.5s. After
    MAX_RETRIES a transient failure raises HttpFailure(5, …). A 4xx is not
    retried — it raises HttpFailure 2 (auth), 3 (not found), or 6 (validation).
    2xx returns parsed JSON, or raw bytes when raw=True. The caller (make_request)
    turns HttpFailure into _die when hard, or None when soft.
    """
    client = _client()
    to = httpx.Timeout(timeout) if timeout is not None else TIMEOUT
    for attempt in range(1, MAX_RETRIES + 1):
        try:
            resp = client.request(method, url, headers=headers,
                                  json=json_body, content=content, timeout=to)
        except httpx.TimeoutException:
            if attempt < MAX_RETRIES:
                time.sleep(attempt * 1.5)
                continue
            raise HttpFailure(5, "timeout", f"request timed out: {method} {url}",
                              f"{service} was unresponsive")
        except httpx.RequestError as e:
            if attempt < MAX_RETRIES:
                time.sleep(attempt * 1.5)
                continue
            raise HttpFailure(5, "network_error",
                              f"network error reaching {service}: {e}",
                              "check the base_url and connectivity")

        if resp.status_code == 429:
            if attempt < MAX_RETRIES:
                time.sleep(float(resp.headers.get("Retry-After", attempt * 1.5)))
                continue
            raise HttpFailure(5, "rate_limited",
                              f"{service} rate-limited the request", status=429)
        if resp.status_code >= 500:
            if attempt < MAX_RETRIES:
                time.sleep(attempt * 1.5)
                continue
            raise HttpFailure(5, "server_error",
                              f"{service} returned {resp.status_code}",
                              status=resp.status_code)
        if resp.status_code >= 400:
            msg = _http_error_message(resp)
            if resp.status_code in (401, 403):
                raise HttpFailure(2, "auth_rejected",
                                  f"{service} rejected the request: {msg}",
                                  "check the API key / dashboard credentials",
                                  status=resp.status_code)
            if resp.status_code == 404:
                raise HttpFailure(3, "not_found", f"{service}: {msg}", status=404)
            raise HttpFailure(6, "bad_request",
                              f"{service} rejected the request: {msg}",
                              status=resp.status_code)

        if raw:
            return resp.content
        text = resp.text
        if not text:
            return {}
        try:
            return resp.json()
        except Exception:
            return {}
    # Unreachable: every branch above returns, continues, or raises.
    raise HttpFailure(5, "unreachable",
                      f"{service} request exhausted retries: {method} {url}")


def api_request(method, path, config=None, *, json_body=None, timeout=60, soft=False):
    """A WAHA API call on the active instance through the resilient layer. Hard by
    default — a handled failure becomes _die. soft=True returns None instead, for
    best-effort calls whose failure the caller recovers from (a missing contact
    name, an unreachable page, an absent session)."""
    if config is None:
        config = get_config()
    url = f"{config['base_url']}{path}"
    try:
        return _request(method, url, headers=_auth_headers(config),
                        json_body=json_body, timeout=timeout)
    except HttpFailure as e:
        if soft:
            return None
        _refuse(e.exit_code, e.code, e.message, e.hint, e.status)


def make_request(path, config=None, timeout=60, soft=False):
    """GET path on the active WAHA instance (see api_request)."""
    return api_request("GET", path, config, timeout=timeout, soft=soft)


def download_media(media_url, config, dest_path, timeout=120):
    """Fetch a WAHA media file. Translates the container-internal localhost
    URL back to the public base_url and writes to dest_path. Raises HttpFailure
    on a request failure — `export` catches it per-message and records it."""
    parsed = urllib.parse.urlparse(media_url)
    public_url = f"{config['base_url']}{parsed.path}"
    if parsed.query:
        public_url += f"?{parsed.query}"
    data = _request("GET", public_url, headers=_auth_headers(config),
                    timeout=timeout, raw=True)
    dest_path.write_bytes(data)


def ts_to_dt(ts):
    if not ts:
        return None
    return datetime.datetime.fromtimestamp(ts)


def format_dt(ts):
    dt = ts_to_dt(ts)
    return dt.strftime("%Y-%m-%d %H:%M") if dt else "—"


def parse_date(date_str):
    try:
        dt = datetime.datetime.strptime(date_str, "%Y-%m-%d")
        return int(dt.timestamp())
    except ValueError:
        _refuse(6, "bad_date", f"invalid date format '{date_str}'", "use YYYY-MM-DD")


# ── Commands ────────────────────────────────────────────────────────────────



# ── The engine this CLI carries ─────────────────────────────────────────────
#
# whatsmeow, compiled into the neonize wheel and driven in-process. Nothing here
# runs between invocations: a verb opens the session, works, and closes it. What
# the server held for the device while nothing was connected arrives on connect,
# which is why draining is a property of connecting rather than a verb of its own.


def _quiet_bot_tag() -> None:
    """Stop the engine from labelling every direct message as bot traffic.

    The library attaches a `<bot biz_bot="1"/>` node to any message addressed to
    a person rather than a group, and WhatsApp renders that as an "AI" badge on
    the message. Being open about what this is belongs in what the assistant
    writes, in words the reader can answer; the protocol flag says the same
    thing worse, and it also marks the account's traffic as automated on an
    account that carries real correspondence.

    The Go runtime reads its environment when the shared library loads, so this
    has to be set before the import below and not merely before a send.
    `setdefault` leaves an operator who exported the variable in charge of it."""
    os.environ.setdefault("NEONIZE_BOT_TAG", "off")


def _install_magic_shim() -> None:
    """neonize imports `magic` (libmagic) at module scope and reaches for it only
    to sniff the mime type of outbound media. Binding a system library for that
    would make a C library a prerequisite of reading a chat, so a puremagic-backed
    stand-in is installed before the import."""
    if "magic" in sys.modules:
        return
    import puremagic

    def _from_buffer(buf, mime=False):
        if isinstance(buf, str):
            buf = buf.encode()
        try:
            matches = puremagic.magic_string(buf)
        except Exception:
            matches = []
        if not matches:
            return "application/octet-stream" if mime else "data"
        best = matches[0]
        if mime:
            return best.mime_type or "application/octet-stream"
        return best.name or "data"

    shim = types.ModuleType("magic")
    shim.from_buffer = _from_buffer
    shim.from_file = lambda path, mime=False: _from_buffer(
        Path(path).read_bytes()[:4096], mime=mime)
    sys.modules["magic"] = shim


_ENGINE: dict | None = None


def _engine():
    """Import the engine lazily and once. Declaration and contract verbs never
    pay for it; every verb that touches an account does."""
    global _ENGINE
    if _ENGINE is not None:
        return _ENGINE
    _quiet_bot_tag()
    _install_magic_shim()
    try:
        import logging
        from neonize.client import NewClient
        from neonize import events as nev
        from neonize.utils.jid import build_jid, Jid2String
        from neonize.utils.enum import MediaType
        from neonize.proto.Neonize_pb2 import JID
        from neonize.proto.waCompanionReg import (
            WAWebProtobufsCompanionReg_pb2 as companion)
        from neonize.proto.waHistorySync import (
            WAWebProtobufsHistorySync_pb2 as history_proto)
    except Exception as exc:      # the wheel is absent, or its library will not load
        _refuse(5, "engine_unavailable",
                f"the WhatsApp engine failed to load: {type(exc).__name__}: {exc}",
                "the engine is a compiled library shipped inside the wheel this "
                "script declares, and it is built per platform: a host it was "
                "not built for cannot run this capability. Reads of an existing "
                "store need no engine; anything reaching the account does.")
    # The engine narrates its protocol on the root logger. That belongs on
    # stderr with the rest of the progress chatter, never mixed into a result.
    logging.getLogger("whatsmeow").setLevel(logging.WARNING)
    logging.getLogger("Whatsmeow.Database").setLevel(logging.WARNING)
    for handler in logging.getLogger().handlers:
        handler.setStream(sys.stderr) if hasattr(handler, "setStream") else None
    _ENGINE = {
        "NewClient": NewClient, "events": nev, "build_jid": build_jid,
        "Jid2String": Jid2String, "MediaType": MediaType, "JID": JID,
        "companion": companion, "history_proto": history_proto,
    }
    return _ENGINE


def _host_description() -> str:
    """A short, human-recognisable name for the machine holding this session.
    Linked Devices is where a person sees what is attached to their account, so
    the entry should say which of their machines it is."""
    system = platform.system()
    if system == "Darwin":
        try:
            out = subprocess.run(["system_profiler", "SPHardwareDataType"],
                                 capture_output=True, text=True, timeout=8).stdout
            for line in out.splitlines():
                if "Model Name:" in line:
                    return line.split(":", 1)[1].strip()
        except Exception:
            pass
        return "Mac"
    if system == "Linux":
        try:
            for line in Path("/etc/os-release").read_text().splitlines():
                if line.startswith("PRETTY_NAME="):
                    return line.split("=", 1)[1].strip().strip('"')
        except Exception:
            pass
        return "Linux"
    return system or "Unknown"


def _device_name(cfg: dict) -> str:
    return cfg.get("device_name") or f"Capability ({_host_description()})"


def _device_props(cfg: dict, days: int, full: bool):
    """What the account's Linked Devices list shows, and how deep the one-time
    pairing burst reaches. `os` is the displayed name and `platformType` picks
    the icon — an unset platform renders as "Other device"."""
    companion = _engine()["companion"]
    props = companion.DeviceProps
    return props(
        os=_device_name(cfg),
        platformType=props.DESKTOP,
        requireFullSync=bool(full),
        historySyncConfig=props.HistorySyncConfig(
            fullSyncDaysLimit=days,
            fullSyncSizeMbLimit=2048,
            storageQuotaMb=4096,
            recentSyncDaysLimit=days,
            supportCallLogHistory=True,
            supportCagReactionsAndPolls=True,
            supportBotUserAgentChatHistory=True,
            supportHostedGroupMsg=True,
            supportMessageAssociation=True,
        ),
    )


# ── Identities ──────────────────────────────────────────────────────────────
#
# A sender arrives either as a phone JID (15551234567@s.whatsapp.net) or as a
# LID (<opaque>@lid), and group participants in particular arrive as
# LIDs. A LID says nothing to a reader, so both forms are kept and the mapping
# stays reversible.

def _jid_str(jid) -> str | None:
    """The canonical string form of an engine JID, or None for an empty one."""
    try:
        if not jid or (not jid.User and not jid.Server):
            return None
        return _engine()["Jid2String"](jid)
    except Exception:
        return None


def _bare_jid(value: str | None) -> str | None:
    """Drop the device suffix: 15551234567:12@s.whatsapp.net → …@s.whatsapp.net."""
    if not value:
        return None
    user, _, server = str(value).partition("@")
    if not server:
        return None
    return f"{user.split(':', 1)[0].split('.', 1)[0]}@{server}"


def _normalize_chat_id(raw: str) -> str:
    """Accept a bare number, the <number>@c.us form, or a full JID."""
    value = str(raw or "").strip()
    if not value:
        _refuse(6, "bad_chat_id", "a chat id is required",
             "pass <number>@s.whatsapp.net, <group-id>@g.us, <opaque>@lid, "
             "or a bare number")
    if "@" not in value:
        digits = _digits(value)
        if not digits:
            _refuse(6, "bad_chat_id", f"{raw!r} is not a chat id or a phone number")
        return f"{digits}@s.whatsapp.net"
    user, _, server = value.partition("@")
    server = server.lower()
    if server in ("c.us", "s.whatsapp.net"):
        server = "s.whatsapp.net"
    return f"{user}@{server}"


def _require_text(args) -> str:
    """A message with nothing in it is a mistake, not an empty message."""
    text = getattr(args, "text", None)
    if text is None or not str(text).strip():
        _refuse(6, "empty_message", "a message needs text",
             "pass the text as the second argument, quoted")
    return str(text)


def _is_group(chat_id: str) -> bool:
    return str(chat_id or "").endswith("@g.us")


# ── The store ───────────────────────────────────────────────────────────────
#
# The engine is transport: whatsmeow's own SQLite holds the device, its keys,
# contacts and the LID map, and no messages at all. What arrives is ours to keep.
# Raw chunks land on disk before anything parses them, so a parser fault costs a
# re-ingest and never the data.

STORE_SCHEMA = """
CREATE TABLE IF NOT EXISTS meta (
  key TEXT PRIMARY KEY, value TEXT);
CREATE TABLE IF NOT EXISTS chats (
  id TEXT PRIMARY KEY, name TEXT, is_group INTEGER DEFAULT 0,
  last_ts INTEGER, unread INTEGER DEFAULT 0, archived INTEGER DEFAULT 0,
  end_of_history INTEGER DEFAULT 0, updated_at TEXT);
CREATE TABLE IF NOT EXISTS messages (
  chat_id TEXT NOT NULL, id TEXT NOT NULL,
  sender TEXT, sender_lid TEXT, from_me INTEGER DEFAULT 0, ts INTEGER,
  kind TEXT, text TEXT, push_name TEXT, quoted_id TEXT,
  mimetype TEXT, seconds INTEGER, is_voice INTEGER DEFAULT 0,
  file_name TEXT, file_length INTEGER, direct_path TEXT,
  media_key BLOB, file_enc_sha256 BLOB, file_sha256 BLOB,
  sync_type TEXT, captured_at TEXT,
  PRIMARY KEY (chat_id, id));
CREATE INDEX IF NOT EXISTS messages_by_time ON messages(chat_id, ts);
CREATE TABLE IF NOT EXISTS enrichment (
  chat_id TEXT NOT NULL, id TEXT NOT NULL,
  media_path TEXT, media_state TEXT, media_error TEXT,
  transcript TEXT, transcript_language TEXT, transcript_confidence REAL,
  transcript_model TEXT, transcript_provider TEXT, transcript_at TEXT,
  transcript_error TEXT, effective_text TEXT, updated_at TEXT,
  PRIMARY KEY (chat_id, id));
CREATE TABLE IF NOT EXISTS identities (
  jid TEXT PRIMARY KEY, lid TEXT, name TEXT, push_name TEXT, updated_at TEXT);
CREATE INDEX IF NOT EXISTS identities_by_lid ON identities(lid);
CREATE TABLE IF NOT EXISTS chunks (
  n INTEGER PRIMARY KEY AUTOINCREMENT, sync_type TEXT, conversations INTEGER,
  messages INTEGER, progress INTEGER, at TEXT, raw_file TEXT);
"""

# The parser version the rows were built by. Raise it whenever a change to
# `_describe` or `_ingest_history` would produce different rows from the same
# chunk: the next store opened at an older version rebuilds itself from `raw/`.
STORE_VERSION = "1"

# The one meaning of `endOfHistoryTransferType` that says the phone holds
# nothing older. Every other value ends a transfer with more still on the
# primary device, so treating the boolean alone as a floor would silence
# reach-back for exactly the chats that have depth.
NO_MORE_ON_PRIMARY = 1


class _Store(sqlite3.Connection):
    """One store connection, shared by the caller's thread and the engine's.

    The engine dispatches events on its own thread, so two threads write here.
    They share one connection deliberately — a second connection would take a
    second SQLite write lock and deadlock against the first — and every write
    goes through `_writing`, which serialises them and makes each one whole.

    Reads are not serialised. SQLite's own connection-level locking is what
    makes that safe, and it holds only while the driver is compiled for full
    thread safety — a property of the runtime, not of this code, so it is
    checked at open rather than assumed."""

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.write_lock = threading.RLock()
        self.write_depth = 0


@contextlib.contextmanager
def _writing(db):
    """One store write, whole.

    A chunk's message rows and the record of that chunk are one fact, so a
    write from the caller's thread must never commit half of one raised by the
    handler thread. Nested writes join the transaction their caller opened."""
    with db.write_lock:
        outermost = db.write_depth == 0
        if outermost:
            db.execute("BEGIN IMMEDIATE")
        db.write_depth += 1
        try:
            yield
        except BaseException:
            db.write_depth -= 1
            if outermost:
                db.execute("ROLLBACK")
            raise
        db.write_depth -= 1
        if outermost:
            db.execute("COMMIT")


def _home_account(home: Path) -> str | None:
    """Which account a state home already holds, asked of the files themselves.

    The store records the account it was first written for, and the engine's
    own session records the linked device, so a home populated by either says
    whose it is without a connection being opened."""
    store = home / "messages.db"
    if store.exists():
        try:
            with contextlib.closing(
                    sqlite3.connect(f"file:{store}?mode=ro", uri=True)) as db:
                row = db.execute(
                    "SELECT value FROM meta WHERE key = 'account_id'").fetchone()
            if row and row[0]:
                return _digits(row[0])
        except sqlite3.Error:
            pass
    session = home / "session.db"
    if session.exists():
        try:
            with contextlib.closing(
                    sqlite3.connect(f"file:{session}?mode=ro", uri=True)) as db:
                row = db.execute(
                    "SELECT jid FROM whatsmeow_device LIMIT 1").fetchone()
            if row and row[0]:
                return _digits(str(row[0]).split("@", 1)[0])
        except sqlite3.Error:
            pass
    return None


def _account_home(key: str, cid: str) -> Path:
    """Where one account's capture lives: under the account's own identity.

    A connection id is an alias the consuming project chooses and may rename,
    while the session and the store belong to the account. Naming the home
    after the alias made a rename read as an account that had never paired,
    orphaned the capture under the old name, and let two aliases for one
    account build two captures of it. Naming it after the account means the
    alias moves freely, and two aliases for one account arrive at one home —
    which is what lets several projects share one capture instead of each
    building its own.

    A home still sitting under an old alias is adopted the first time that
    alias resolves, and only when it holds this account or holds none at all.
    One holding somebody else is left exactly where it is: two accounts are
    never merged into a single file to make a path resolve."""
    root = _state_dir()
    home = root / key
    if home.exists():
        return home
    legacy = root / cid
    if legacy != home and legacy.is_dir() \
            and _home_account(legacy) in (None, key):
        with contextlib.suppress(OSError):
            legacy.rename(home)
    return home


def _connection_home(cfg: dict) -> Path:
    home = Path(cfg["home"]).expanduser()
    home.mkdir(parents=True, exist_ok=True, mode=0o700)
    (home / "raw").mkdir(exist_ok=True)
    (home / "media").mkdir(exist_ok=True)
    return home


def _open_store(cfg: dict) -> "_Store":
    """The store for one connection, brought up to the shipping parser version.

    A store written by an older parser is rebuilt from the chunks it kept, which
    is the whole reason they are kept."""
    home = _connection_home(cfg)
    db = None
    try:
        if sqlite3.threadsafety < 3:
            _refuse(5, "sqlite_not_serialized",
                    "this Python's SQLite is not built for full thread safety "
                    f"(threadsafety={sqlite3.threadsafety}), and the engine "
                    "dispatches its events on a second thread",
                    "run the capability on a Python whose sqlite3 reports "
                    "threadsafety 3")
        db = sqlite3.connect(home / "messages.db", check_same_thread=False,
                             timeout=30, factory=_Store, isolation_level=None)
        db.row_factory = sqlite3.Row
        db.executescript(STORE_SCHEMA)
        held = db.execute("SELECT value FROM meta WHERE key = 'schema'").fetchone()
        version = held["value"] if held else None
    except sqlite3.Error as exc:
        if db is not None:
            db.close()
        _refuse(5, "store_unreadable",
             f"the store for connection {cfg['id']!r} could not be opened: {exc}",
             f"the store is {home / 'messages.db'}; the history chunks beside it "
             f"in {home / 'raw'} can rebuild it once it is moved aside")
    if version is None:
        # No version and no rows is a store that has just been created. No
        # version with rows in it is one written before the parser was
        # versioned at all, which is exactly the case a rebuild is for.
        existing = db.execute("SELECT COUNT(*) FROM messages").fetchone()[0]
        if existing:
            _reingest_raw(db, home, from_version="unversioned")
        else:
            with _writing(db):
                db.execute("INSERT OR REPLACE INTO meta (key, value) VALUES "
                           "('schema', ?)", (STORE_VERSION,))
    elif version != STORE_VERSION:
        _reingest_raw(db, home, from_version=version)
    return db


def _raw_sync_type(path: Path) -> str:
    """The sync type a raw chunk was received as, recorded in its file name."""
    return path.stem.rsplit("-", 1)[-1] or "UNKNOWN"


def _reingest_raw(db, home: Path, *, from_version: str) -> dict:
    """Rebuild the parsed rows from the chunks exactly as they arrived.

    The raw protobuf is written before anything parses it, so a corrected parser
    costs a re-ingest and never the data. It runs when the store's recorded
    parser version differs from the one shipping, which is precisely when the
    parsed rows may have been built wrong; enrichment lives in its own table and
    is untouched."""
    chunks = sorted((home / "raw").glob("*.pb"))
    _log(f"store written by parser {from_version}, shipping {STORE_VERSION}: "
         f"rebuilding from {len(chunks)} history chunk(s)")
    # Parsing a chunk needs the engine's own message definitions, so a rebuild
    # is one of the things a host without the engine cannot do. It refuses
    # through the same guarded import every other engine use goes through,
    # rather than raising a platform error out of a local read.
    history_proto = _engine()["history_proto"]
    rebuilt = failed = 0
    for path in chunks:
        data = history_proto.HistorySync()
        try:
            data.ParseFromString(path.read_bytes())
        except Exception as exc:
            failed += 1
            _log(f"  chunk {path.name} could not be parsed: "
                 f"{type(exc).__name__}: {exc}")
            continue
        _ingest_history(db, data, home, _raw_sync_type(path),
                        record=False, authoritative=True)
        rebuilt += 1
    _log(f"rebuilt {rebuilt} chunk(s)" + (f", {failed} unreadable" if failed else ""))
    with _writing(db):
        if failed:
            # The version is what says the rows were built by the shipping
            # parser. Stamping it over a rebuild that did not finish would
            # assert that, retire the retry, and leave stale rows behind with
            # nothing to notice them. The note is carried where `health` and
            # `doctor` both read it.
            db.execute(
                "INSERT OR REPLACE INTO meta (key, value) VALUES "
                "('rebuild_incomplete', ?)",
                (f"{failed} of {len(chunks)} chunk(s) unreadable at {_iso_now()}; "
                 f"rows from them were built by parser {from_version}",))
            _log("the unreadable chunks are still on disk and nothing was "
                 "discarded; the rebuild will be attempted again on the next "
                 "invocation")
        else:
            db.execute("DELETE FROM meta WHERE key = 'rebuild_incomplete'")
            db.execute("INSERT OR REPLACE INTO meta (key, value) VALUES "
                       "('schema', ?)", (STORE_VERSION,))
    return {"rebuilt": rebuilt, "failed": failed}


def _session_db(cfg: dict) -> Path:
    return _connection_home(cfg) / "session.db"


def _session_exists(cfg: dict) -> bool:
    """A linked device is a row in the engine's own device table. Absence is a
    real state — never paired here, or unlinked from the phone — and it is what
    exit 7 reports."""
    path = _session_db(cfg)
    if not path.exists():
        return False
    try:
        with contextlib.closing(sqlite3.connect(f"file:{path}?mode=ro", uri=True)) as db:
            row = db.execute(
                "SELECT jid FROM whatsmeow_device LIMIT 1").fetchone()
            return bool(row and row[0])
    except sqlite3.Error:
        return False


def _session_account(cfg: dict) -> tuple[str | None, str | None, str | None]:
    """(account id, jid, push name) as the engine's own store records them,
    read without opening a connection."""
    path = _session_db(cfg)
    if not path.exists():
        return None, None, None
    try:
        with contextlib.closing(sqlite3.connect(f"file:{path}?mode=ro", uri=True)) as db:
            row = db.execute(
                "SELECT jid, push_name FROM whatsmeow_device LIMIT 1").fetchone()
    except sqlite3.Error:
        return None, None, None
    if not row or not row[0]:
        return None, None, None
    jid = _bare_jid(row[0])
    return _digits(str(jid).split("@", 1)[0]), jid, row[1]


@contextlib.contextmanager
def _session_lock(cfg: dict):
    """One invocation drives one linked device at a time. Two clients on one
    device desync the account and can log it out, so contention is refused
    rather than queued."""
    path = _connection_home(cfg) / "lock"
    handle = path.open("a+")
    try:
        path.chmod(0o600)
    except OSError:
        pass
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        handle.close()
        _refuse(8, "session_busy",
             f"another invocation holds the session for connection {cfg['id']!r}",
             "wait for it to finish and retry; never work around the lock — two "
             "clients on one linked device desync the account")
    try:
        yield
    finally:
        try:
            fcntl.flock(handle, fcntl.LOCK_UN)
        finally:
            handle.close()



# ── Reading a protocol message ──────────────────────────────────────────────

# A payload can be wrapped several layers deep before the message itself.
_WRAPPERS = ("ephemeralMessage", "viewOnceMessage", "viewOnceMessageV2",
             "viewOnceMessageV2Extension", "deviceSentMessage",
             "documentWithCaptionMessage", "editedMessage")
# Present on nearly every message and never the message itself.
_NOT_CONTENT = {"messageContextInfo", "senderKeyDistributionMessage"}
_MEDIA_FIELDS = ("imageMessage", "audioMessage", "videoMessage",
                 "documentMessage", "stickerMessage")
# The store keeps the protocol's own field name; a reader gets the canonical
# type through this map, which is the vocabulary the export contract publishes.
_KIND_TO_TYPE = {
    "conversation": "text", "extendedTextMessage": "text",
    "imageMessage": "image", "videoMessage": "video",
    "documentMessage": "document", "stickerMessage": "sticker",
    "locationMessage": "location", "liveLocationMessage": "location",
    "contactMessage": "vcard", "contactsArrayMessage": "vcard",
    "reactionMessage": "reaction", "protocolMessage": "protocol",
    "pollCreationMessage": "poll", "pollCreationMessageV2": "poll",
    "pollCreationMessageV3": "poll", "pollUpdateMessage": "poll",
    "listMessage": "list", "buttonsMessage": "buttons",
    "templateMessage": "template", "groupInviteMessage": "group_invite",
    "empty": "empty", "placeholderMessage": "undecryptable",
}
# The two the CLI treats as voice for transcription.
VOICE_TYPES = {"ptt", "audio"}
SCHEMA_VERSION = 2
PAGE_SIZE_DEFAULT = 100

_SYNC_TYPES = {0: "INITIAL_BOOTSTRAP", 1: "INITIAL_STATUS_V3", 2: "FULL",
               3: "RECENT", 4: "PUSH_NAME", 5: "NON_BLOCKING_DATA",
               6: "ON_DEMAND"}


def _ts_seconds(value) -> int | None:
    """One normaliser for every timestamp the protocol hands over.

    History-sync protobufs carry seconds and live message events carry
    milliseconds. Reading one as the other silently misplaces every message by
    five decades, so the unit is decided here, once, from the magnitude: no
    plausible WhatsApp second-timestamp reaches 10^11, and no millisecond one
    falls below it."""
    try:
        ts = int(value or 0)
    except (TypeError, ValueError):
        return None
    if ts <= 0:
        return None
    if ts > 100_000_000_000:
        ts //= 1000
    return ts


def _unwrap(message):
    for _ in range(6):
        for name in _WRAPPERS:
            try:
                if message.HasField(name):
                    message = getattr(message, name).message
                    break
            except (ValueError, AttributeError):
                continue
        else:
            break
    return message


def _describe(message) -> dict:
    """Everything a stored row needs from one protocol message, including the
    material a later download depends on: `download_media_with_path` fetches
    from the direct path plus the media key and both digests, so a row without
    them can never be fetched again from the store alone."""
    inner = _unwrap(message)
    present = [f.name for f, _ in inner.ListFields() if f.name not in _NOT_CONTENT]
    kind = present[0] if present else "empty"
    out = {"kind": kind, "text": None, "quoted_id": None, "mimetype": None,
           "seconds": None, "is_voice": 0, "file_name": None, "file_length": None,
           "direct_path": None, "media_key": None, "file_enc_sha256": None,
           "file_sha256": None}
    if kind == "conversation":
        out["text"] = inner.conversation or None
    elif kind == "extendedTextMessage":
        out["text"] = inner.extendedTextMessage.text or None
    elif kind == "reactionMessage":
        out["text"] = inner.reactionMessage.text or None
    if kind in _MEDIA_FIELDS:
        media = getattr(inner, kind)
        out.update(
            mimetype=getattr(media, "mimetype", None) or None,
            file_length=getattr(media, "fileLength", None) or None,
            direct_path=getattr(media, "directPath", None) or None,
            text=getattr(media, "caption", None) or None,
            file_name=getattr(media, "fileName", None) or None,
            media_key=bytes(getattr(media, "mediaKey", b"")) or None,
            file_enc_sha256=bytes(getattr(media, "fileEncSHA256", b"")) or None,
            file_sha256=bytes(getattr(media, "fileSHA256", b"")) or None,
        )
        if kind in ("audioMessage", "videoMessage"):
            out["seconds"] = getattr(media, "seconds", None) or None
        if kind == "audioMessage":
            out["is_voice"] = 1 if getattr(media, "PTT", False) else 0
    try:
        content = getattr(inner, kind) if kind != "conversation" else None
        context = getattr(content, "contextInfo", None) if content is not None else None
        if context is not None and context.stanzaID:
            out["quoted_id"] = context.stanzaID
    except (AttributeError, ValueError):
        pass
    return out


def _canonical_type(kind: str | None, is_voice: int | None) -> str:
    if kind == "audioMessage":
        return "ptt" if is_voice else "audio"
    if not kind:
        return "text"
    mapped = _KIND_TO_TYPE.get(kind)
    if mapped:
        return mapped
    return re.sub(r"Message$", "", kind).lower() or "text"


# ── Writing what arrives ────────────────────────────────────────────────────


def _remember_identity(db, jid: str | None, lid: str | None = None,
                       name: str | None = None, push_name: str | None = None) -> None:
    if not jid and not lid:
        return
    key = jid or lid
    db.execute(
        """INSERT INTO identities (jid, lid, name, push_name, updated_at)
           VALUES (?,?,?,?,?)
           ON CONFLICT(jid) DO UPDATE SET
             lid = COALESCE(excluded.lid, identities.lid),
             name = COALESCE(NULLIF(excluded.name,''), identities.name),
             push_name = COALESCE(NULLIF(excluded.push_name,''), identities.push_name),
             updated_at = excluded.updated_at""",
        (key, lid, name, push_name, _iso_now()))


def _iso_now() -> str:
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")


def _upsert_chat(db, chat_id: str, name: str | None, last_ts: int | None,
                 unread: int | None = None, archived: int | None = None,
                 end_of_history: int = 0) -> None:
    db.execute(
        """INSERT INTO chats (id, name, is_group, last_ts, unread, archived,
                              end_of_history, updated_at)
           VALUES (?,?,?,?,?,?,?,?)
           ON CONFLICT(id) DO UPDATE SET
             name = COALESCE(NULLIF(excluded.name,''), chats.name),
             last_ts = MAX(COALESCE(chats.last_ts,0), COALESCE(excluded.last_ts,0)),
             unread = COALESCE(excluded.unread, chats.unread),
             archived = COALESCE(excluded.archived, chats.archived),
             end_of_history = MAX(chats.end_of_history, excluded.end_of_history),
             updated_at = excluded.updated_at""",
        (chat_id, name or None, 1 if _is_group(chat_id) else 0, last_ts,
         unread, archived, end_of_history, _iso_now()))


_MESSAGE_COLUMNS = ("chat_id", "id", "sender", "sender_lid", "from_me", "ts",
                    "kind", "text", "push_name", "quoted_id", "mimetype",
                    "seconds", "is_voice", "file_name", "file_length",
                    "direct_path", "media_key", "file_enc_sha256",
                    "file_sha256", "sync_type", "captured_at")


_FILL_COLUMNS = tuple(c for c in _MESSAGE_COLUMNS
                      if c not in ("chat_id", "id", "captured_at"))


def _upsert_message(db, row: dict, *, authoritative: bool = False) -> bool:
    """Write one message, and say whether the store had never seen it.

    Backfill pages backwards over ground already covered, so the same message
    arrives repeatedly. Later news never erases what an earlier capture held: a
    field is filled in where it was empty and left alone where it was not.

    A re-ingest is the exception. It replays the chunk that produced the row, so
    it is authoritative over whatever an earlier parser made of the same bytes —
    filling gaps there would preserve the very values it exists to correct."""
    inserted = db.execute(
        f"""INSERT OR IGNORE INTO messages ({', '.join(_MESSAGE_COLUMNS)})
            VALUES ({', '.join('?' * len(_MESSAGE_COLUMNS))})""",
        [row.get(col) for col in _MESSAGE_COLUMNS]).rowcount
    if inserted:
        return True
    assignment = "{c} = ?" if authoritative else "{c} = COALESCE({c}, ?)"
    db.execute(
        f"""UPDATE messages
               SET {', '.join(assignment.format(c=c) for c in _FILL_COLUMNS)}
             WHERE chat_id = ? AND id = ?""",
        [row.get(col) for col in _FILL_COLUMNS] + [row["chat_id"], row["id"]])
    return False


def _ingest_history(db, data, home: Path, sync_type: str, *,
                    record: bool = True,
                    authoritative: bool = False) -> tuple[int, int, int]:
    """Write one history chunk down.

    The protobuf lands on disk before it is parsed, so a parser fault costs a
    re-ingest and never the data. Its file name carries its own identity rather
    than a sequence read from the store: the engine delivers events on its own
    thread with nothing serialising them, and two deliveries computing the same
    next number would have one overwrite the other's bytes."""
    if record:
        raw_name = (f"{time.strftime('%Y%m%dT%H%M%S')}-{uuid.uuid4().hex[:8]}"
                    f"-{sync_type}.pb")
        (home / "raw" / raw_name).write_bytes(data.SerializeToString())

    conversations = messages = new = 0
    with _writing(db):
        for mapping in getattr(data, "phoneNumberToLidMappings", []):
            _remember_identity(db, _bare_jid(mapping.pnJID), _bare_jid(mapping.lidJID))
        for pushname in getattr(data, "pushnames", []):
            _remember_identity(db, _bare_jid(pushname.ID),
                               push_name=pushname.pushname or None)
        for conv in data.conversations:
            conversations += 1
            # The boolean only says the transfer ended. Whether anything is left
            # on the phone is the sibling field's answer, and only one of its
            # values means there is not.
            floor = (conv.endOfHistoryTransfer
                     and conv.endOfHistoryTransferType == NO_MORE_ON_PRIMARY)
            _upsert_chat(db, conv.ID, conv.name or None,
                         _ts_seconds(conv.lastMsgTimestamp)
                         or _ts_seconds(conv.conversationTimestamp),
                         unread=conv.unreadCount or 0,
                         archived=1 if conv.archived else 0,
                         end_of_history=1 if floor else 0)
            if conv.lidJID or conv.pnJID:
                _remember_identity(db, _bare_jid(conv.pnJID) or conv.ID,
                                   _bare_jid(conv.lidJID), name=conv.name or None)
            for held in conv.messages:
                info = held.message
                described = _describe(info.message)
                sender = _bare_jid(info.key.participant) or _bare_jid(info.participant)
                sender_lid = sender if (sender or "").endswith("@lid") else None
                if sender_lid:
                    sender = None
                row = {
                    "chat_id": conv.ID, "id": info.key.ID,
                    "sender": sender, "sender_lid": sender_lid,
                    "from_me": 1 if info.key.fromMe else 0,
                    "ts": _ts_seconds(info.messageTimestamp),
                    "push_name": info.pushName or None,
                    "sync_type": sync_type, "captured_at": _iso_now(),
                    **{k: described[k] for k in
                       ("kind", "text", "quoted_id", "mimetype", "seconds", "is_voice",
                        "file_name", "file_length", "direct_path", "media_key",
                        "file_enc_sha256", "file_sha256")},
                }
                if _upsert_message(db, row, authoritative=authoritative):
                    new += 1
                messages += 1
                if row["push_name"] and (sender or sender_lid):
                    _remember_identity(db, sender or sender_lid, sender_lid,
                                       push_name=row["push_name"])
        if record:
            db.execute(
                "INSERT INTO chunks (sync_type, conversations, messages, progress,"
                " at, raw_file) VALUES (?,?,?,?,?,?)",
                (sync_type, conversations, messages,
                 getattr(data, "progress", None) or None, _iso_now(), raw_name))
    return conversations, messages, new


def _ingest_live(db, event) -> int:
    """One message as it arrives. Its timestamp is milliseconds where a history
    chunk's is seconds; `_ts_seconds` is the single place that knows."""
    source = event.Info.MessageSource
    chat_id = _jid_str(source.Chat)
    if not chat_id:
        return 0
    sender = _jid_str(source.Sender)
    sender_alt = _jid_str(getattr(source, "SenderAlt", None))
    sender_bare = _bare_jid(sender)
    alt_bare = _bare_jid(sender_alt)
    if (sender_bare or "").endswith("@lid"):
        sender_lid, sender_pn = sender_bare, alt_bare
    else:
        sender_pn, sender_lid = sender_bare, (
            alt_bare if (alt_bare or "").endswith("@lid") else None)
    described = _describe(event.Message)
    push_name = getattr(event.Info, "Pushname", None) or None
    row = {
        "chat_id": chat_id, "id": event.Info.ID,
        "sender": sender_pn, "sender_lid": sender_lid,
        "from_me": 1 if source.IsFromMe else 0,
        "ts": _ts_seconds(event.Info.Timestamp),
        "push_name": push_name, "sync_type": "LIVE", "captured_at": _iso_now(),
        **{k: described[k] for k in
           ("kind", "text", "quoted_id", "mimetype", "seconds", "is_voice",
            "file_name", "file_length", "direct_path", "media_key",
            "file_enc_sha256", "file_sha256")},
    }
    with _writing(db):
        _upsert_chat(db, chat_id, None, _ts_seconds(event.Info.Timestamp))
        added = 1 if _upsert_message(db, row) else 0
        if sender_pn or sender_lid:
            _remember_identity(db, sender_pn or sender_lid, sender_lid,
                               push_name=push_name)
    return added



# ── One connected session ───────────────────────────────────────────────────

CONNECT_TIMEOUT = 60          # authenticate, or say the connection failed
ENGINE_STOP_TIMEOUT = 20      # the engine's blocking call, given time to return
DRAIN_TIMEOUT = 30            # wait for the offline queue's own completion event
CHUNK_SETTLE = 4.0            # quiet time after the last chunk before moving on
DRAIN_CEILING = 60            # an ordinary verb's connection, at its longest
ANSWER_TIMEOUT = 45           # one on-demand history request, answered by the phone
SEND_SETTLE = 3.0             # after a send, long enough for the account's own copy to arrive back
LINK_TIMEOUT = 600            # the phone's own pace, from code shown to link done
QR_SCAN_WINDOW = 180          # one QR reference, from minted to expired
QR_REF_GRACE = 60             # a refreshed reference, given its own window again


class Session:
    """A connection to the account, held open only as long as a verb needs it.

    Two things it must never do quietly. An exception inside an event handler
    dies at the ctypes callback boundary and is indistinguishable from "the
    server sent nothing", so every handler is wrapped and every failure is
    reported. And the burst that pairing hands over arrives once, so what
    arrives is written down before it is counted."""

    def __init__(self, cfg: dict, *, props=None):
        self.cfg = cfg
        self.props = props
        self.home = _connection_home(cfg)
        self.db = _open_store(cfg)
        self.errors: list[str] = []
        self.chunks: list[dict] = []
        self.live_messages = 0
        self.offline_count: int | None = None
        self.pair_code: str | None = None
        self.qr_payload: str | None = None
        self._connected = threading.Event()
        self._paired = threading.Event()
        self._logged_out = threading.Event()
        self._drained = threading.Event()
        self._last_chunk = 0.0
        self._on_demand = threading.Event()
        self._on_demand_new = 0
        self._on_demand_seen = 0
        self._client = None
        self._thread = None
        self.stalled = False

    # -- lifecycle ---------------------------------------------------------

    def _guard(self, fn):
        """A handler that dies quietly looks exactly like an idle server. It is
        recorded, printed, and surfaced by whatever verb is running."""
        def wrapper(_client, event):
            try:
                fn(event)
            except Exception:
                detail = traceback.format_exc()
                self.errors.append(detail.strip().splitlines()[-1])
                _log("engine handler failed — this is a failure, not an empty "
                     "server:\n" + detail)
        return wrapper

    def _register(self, client) -> None:
        engine = _engine()
        ev = engine["events"]

        @client.qr
        def _on_qr(_client, data):
            try:
                self.qr_payload = data.decode() if isinstance(data, bytes) else str(data)
            except Exception:
                self.errors.append("qr payload could not be decoded")

        client.event(ev.ConnectedEv)(self._guard(lambda e: self._connected.set()))
        client.event(ev.PairStatusEv)(self._guard(lambda e: self._paired.set()))
        client.event(ev.LoggedOutEv)(self._guard(lambda e: self._logged_out.set()))
        client.event(ev.OfflineSyncCompletedEv)(self._guard(self._on_offline))
        client.event(ev.OfflineSyncPreviewEv)(self._guard(self._on_preview))
        client.event(ev.MessageEv)(self._guard(self._on_message))
        client.event(ev.HistorySyncEv)(self._guard(self._on_history))

    def _on_preview(self, event) -> None:
        _log(f"  queued for this device: {event.Total} item(s), "
             f"{event.Message} message(s)")

    def _on_offline(self, event) -> None:
        self.offline_count = int(getattr(event, "Count", 0) or 0)
        self._drained.set()

    def _on_message(self, event) -> None:
        self.live_messages += _ingest_live(self.db, event)

    def _on_history(self, event) -> None:
        sync_type = _SYNC_TYPES.get(event.Data.syncType, str(event.Data.syncType))
        conversations, messages, new = _ingest_history(
            self.db, event.Data, self.home, sync_type)
        self.chunks.append({"sync_type": sync_type, "chats": conversations,
                            "messages": messages, "new": new})
        self._last_chunk = time.monotonic()
        if sync_type == "ON_DEMAND":
            self._on_demand_new += new
            self._on_demand_seen += messages
            self._on_demand.set()
        _log(f"  chunk {sync_type}: {conversations} chat(s), {messages} message(s), "
             f"{new} new")

    def open(self, *, expect_session: bool = True) -> "Session":
        if expect_session and not _session_exists(self.cfg):
            _refuse(7, "not_linked",
                 f"connection {self.cfg['id']!r} has no linked WhatsApp device",
                 f"run `{NAME} pair --connection {self.cfg['id']}` and enter the "
                 "code on the phone")
        engine = _engine()
        self._client = engine["NewClient"](str(_session_db(self.cfg)),
                                           props=self.props)
        self._register(self._client)
        self._thread = threading.Thread(target=self._client.connect, daemon=True)
        self._thread.start()
        return self

    def wait_connected(self, timeout: float = CONNECT_TIMEOUT) -> bool:
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            if self._connected.wait(0.5):
                return True
            if self._logged_out.is_set():
                return False
        return False

    def wait_linked(self, timeout: float = LINK_TIMEOUT, *,
                    echo_qr: bool = False) -> bool:
        """Wait for the phone to finish linking this device, without leaving.

        A link completes over the socket that minted the code: the phone hands
        the scan to the server, and the server hands the pairing back to the
        client still waiting on it. A client that emits its code and exits
        leaves the phone with nothing to complete against, and the phone
        reports that as an account that cannot link new devices rather than as
        a code that is already dead. Staying here is the whole method.

        A QR reference also expires and is replaced, and a caller can only
        render what it has been told, so every new reference is announced as it
        arrives and is given a fresh window of its own. A pairing code needs no
        echo: it stays valid for as long as the phone will accept it."""
        deadline = time.monotonic() + (QR_SCAN_WINDOW if echo_qr else timeout)
        ceiling = time.monotonic() + timeout
        seen = self.qr_payload
        while time.monotonic() < min(deadline, ceiling):
            if self._connected.wait(0.5):
                return True
            if self._logged_out.is_set():
                return False
            if echo_qr and self.qr_payload and self.qr_payload != seen:
                seen = self.qr_payload
                _log_qr(seen, refreshed=True)
                deadline = time.monotonic() + QR_REF_GRACE
        return False

    def require_connected(self) -> None:
        if self.wait_connected():
            return
        if self._logged_out.is_set():
            _refuse(7, "logged_out",
                 f"the device for connection {self.cfg['id']!r} is no longer linked "
                 "to this WhatsApp account",
                 f"someone removed it under Linked Devices; run "
                 f"`{NAME} pair --connection {self.cfg['id']} --recreate --yes`")
        _refuse(5, "connect_failed",
             f"the engine did not reach WhatsApp within {CONNECT_TIMEOUT}s "
             f"for connection {self.cfg['id']!r}",
             "check connectivity and retry")

    def drain(self, *, timeout: float = DRAIN_TIMEOUT,
              settle: float = CHUNK_SETTLE,
              ceiling: float = DRAIN_CEILING) -> None:
        """Take whatever the server held for this device while nothing was
        connected. The queue drains by the act of connecting, so every verb that
        opens a session collects it; waiting is only about not leaving early.

        The ceiling is the caller's, because what it bounds differs by caller: a
        read wants to answer promptly, while pairing is receiving a burst that
        arrives once and is never offered again."""
        self._drained.wait(timeout)
        self._settle(settle, ceiling=ceiling)

    def _settle(self, quiet: float, *, ceiling: float) -> None:
        deadline = time.monotonic() + ceiling
        self._last_chunk = self._last_chunk or time.monotonic()
        while time.monotonic() < deadline:
            if time.monotonic() - self._last_chunk >= quiet:
                return
            time.sleep(0.5)

    def account(self) -> dict:
        me = self._client.get_me()
        jid = _bare_jid(_jid_str(me.JID))
        return {"jid": jid,
                "id": _digits(str(jid).split("@", 1)[0]) if jid else None,
                "lid": _bare_jid(_jid_str(getattr(me, "LID", None))),
                "name": getattr(me, "PushName", None) or None}

    def require_account(self) -> dict:
        """The session must belong to the account this connection holds.

        A personal messaging identity is pinned deliberately, never inferred
        from whichever session happens to sit in the state home. The connection
        pins it when it declares `expected_account_id`; the store pins it in any
        case, from the first account it was written for, so a re-link to a
        different number cannot interleave two people's histories in one file."""
        account = self.account()
        expected = self.cfg.get("expected_account_id")
        if expected and account["id"] and account["id"] != expected:
            _refuse(2, "account_identity_mismatch",
                 f"session for connection {self.cfg['id']!r} authorises as "
                 f"{account['id']}, not the bound {expected}",
                 "use the session owned by the configured account, or correct "
                 "expected_account_id in connections.json")
        held = self.db.execute(
            "SELECT value FROM meta WHERE key = 'account_id'").fetchone()
        if held and held["value"] and account["id"] \
                and held["value"] != account["id"]:
            _refuse(2, "store_account_mismatch",
                 f"the store for connection {self.cfg['id']!r} holds the history "
                 f"of {held['value']}, and this session authorises as "
                 f"{account['id']}",
                 f"correct the account this connection names, or move "
                 f"{Path(self.cfg['home']) / 'messages.db'} aside — a home is "
                 f"named for one account and a store holds one account")
        if account["id"] and not (held and held["value"]):
            with _writing(self.db):
                self.db.execute(
                    "INSERT OR REPLACE INTO meta (key, value) VALUES "
                    "('account_id', ?)", (account["id"],))
        return account

    def refresh_identities(self, *, max_age: int = 6 * 3600) -> int:
        """Copy the engine's own contact store into ours, so a LID resolves to a
        name rather than to an opaque number. Contacts change slowly and there
        are thousands of them, so the copy is not repeated on every connect."""
        last = self.db.execute(
            "SELECT value FROM meta WHERE key = 'contacts_copied_at'").fetchone()
        if last and (time.time() - float(last["value"] or 0)) < max_age:
            return 0
        try:
            contacts = self._client.contact.get_all_contacts()
        except Exception as exc:
            self.errors.append(f"contact store unreadable: {exc}")
            return 0
        written = 0
        with _writing(self.db):
            for contact in contacts:
                jid = _bare_jid(_jid_str(contact.JID))
                if not jid:
                    continue
                info = getattr(contact, "Info", None)
                name = None
                push = None
                for source in (info, contact):
                    if source is None:
                        continue
                    name = name or (getattr(source, "FullName", None)
                                    or getattr(source, "FirstName", None)
                                    or getattr(source, "BusinessName", None) or None)
                    push = push or getattr(source, "PushName", None) or None
                _remember_identity(self.db, jid, None, name=name, push_name=push)
                written += 1
            self.db.execute("INSERT OR REPLACE INTO meta (key, value) VALUES "
                            "('contacts_copied_at', ?)", (str(time.time()),))
        return written

    def resolve_lid(self, lid: str) -> str | None:
        """A LID's phone form, asked of the engine once and remembered."""
        row = self.db.execute(
            "SELECT jid FROM identities WHERE lid = ? AND jid NOT LIKE '%@lid'",
            (lid,)).fetchone()
        if row:
            return row["jid"]
        engine = _engine()
        user, _, _ = lid.partition("@")
        try:
            answer = self._client.get_pn_from_lid(engine["build_jid"](user, "lid"))
        except Exception:
            return None
        jid = _bare_jid(_jid_str(answer))
        if jid and not jid.endswith("@lid"):
            with _writing(self.db):
                _remember_identity(self.db, jid, lid)
            return jid
        return None

    # -- reaching back -----------------------------------------------------

    def request_older(self, chat_id: str, count: int = HISTORY_PAGE) -> dict:
        """Ask the phone for the page of messages preceding the oldest one held.

        The answer does not come back from the call: it arrives later as an
        on-demand history chunk, so a verb that returned when the request was
        merely sent would be lying. The phone must be online to answer, and its
        absence is reported as itself rather than as an empty chat."""
        anchor = self.db.execute(
            "SELECT id, ts, from_me FROM messages WHERE chat_id = ? AND ts > 0"
            " ORDER BY ts ASC LIMIT 1", (chat_id,)).fetchone()
        if anchor is None:
            return {"ok": False, "reason": "no_anchor", "new": 0}
        engine = _engine()
        user, _, server = chat_id.partition("@")
        self._on_demand.clear()
        self._on_demand_new = 0
        self._on_demand_seen = 0
        try:
            self._client.request_history_sync(
                engine["build_jid"](user, server), anchor["id"],
                bool(anchor["from_me"]), int(anchor["ts"]), count)
        except Exception as exc:
            return {"ok": False, "reason": "request_failed",
                    "detail": f"{type(exc).__name__}: {exc}", "new": 0}
        answered = self._on_demand.wait(ANSWER_TIMEOUT)
        if not answered:
            return {"ok": False, "reason": "phone_unreachable", "new": 0, "seen": 0}
        self._settle(2.0, ceiling=ANSWER_TIMEOUT)
        # `seen` and `new` answer different questions. An answer carrying no
        # messages at all is the phone saying it holds nothing older; an answer
        # carrying only messages already held says the page did not move, which
        # is a reason to stop asking but not a fact about the phone.
        return {"ok": True, "new": self._on_demand_new,
                "seen": self._on_demand_seen}

    # -- media -------------------------------------------------------------

    def fetch_media(self, row) -> dict:
        """Fetch one message's attachment from the media store.

        WhatsApp's CDN drops the ciphertext while the keys stay valid, so an
        old message answers 403 or 410 and is gone for good. That is a real loss
        and it is recorded as one rather than retried forever."""
        engine = _engine()
        kinds = {"imageMessage": "MediaImage", "stickerMessage": "MediaImage",
                 "videoMessage": "MediaVideo", "audioMessage": "MediaAudio",
                 "documentMessage": "MediaDocument"}
        media_type_name = kinds.get(row["kind"])
        if not media_type_name:
            return {"state": "absent"}
        if not (row["direct_path"] and row["media_key"]
                and row["file_enc_sha256"] and row["file_sha256"]):
            return {"state": "unfetchable",
                    "error": "the capture holds no decryption material for this "
                             "message"}
        media_type = getattr(engine["MediaType"], media_type_name)
        try:
            data = self._client.download_media_with_path(
                row["direct_path"], bytes(row["file_enc_sha256"]),
                bytes(row["file_sha256"]), bytes(row["media_key"]),
                int(row["file_length"] or 0), media_type, media_type.to_mms())
        except Exception as exc:
            text = f"{type(exc).__name__}: {exc}"
            # A refusal from the media store is final; anything else may be
            # transient and is left retryable.
            gone = any(f"status code {code}" in text for code in ("403", "404", "410"))
            return {"state": "expired" if gone else "error", "error": text[:300]}
        return {"state": "fetched", "data": data}

    # -- teardown ----------------------------------------------------------

    def close(self) -> None:
        """Give the process back.

        Closing the websocket is not the same as ending the client: the engine
        runs its blocking call on a thread it does not mark daemon, and only
        cancelling the engine's own context makes that call return. Skipping
        that leaves a connected client alive in a process that can never exit —
        and a client that outlives this invocation outlives the lock this
        invocation released, which is exactly the two-clients-on-one-device
        state the lock exists to prevent."""
        if self._client is not None:
            for step in (self._client.disconnect, self._client.stop):
                try:
                    step()
                except Exception:
                    pass
        if self._thread is not None:
            self._thread.join(timeout=ENGINE_STOP_TIMEOUT)
            if self._thread.is_alive():
                self.stalled = True
                _log(f"the engine did not release the process within "
                     f"{ENGINE_STOP_TIMEOUT}s; this invocation will terminate "
                     f"rather than linger as a second client on the device")
        if self.stalled:
            # A live engine thread may still be dispatching into this store.
            # Closing it now would raise inside a handler, after the verb had
            # already answered — a loss reported nowhere. The process is about
            # to leave; every write is already committed.
            return
        try:
            self.db.close()
        except sqlite3.Error:
            pass

    def report_handler_errors(self) -> None:
        if self.errors:
            _refuse(5, "engine_handler_failed",
                 f"{len(self.errors)} engine handler(s) failed during this "
                 f"invocation: {self.errors[0]}",
                 "the result of this run is incomplete; the traceback is on "
                 "stderr above")


@contextlib.contextmanager
def _session(cfg: dict, *, props=None, expect_session: bool = True,
             connect: bool = True, identity: bool = True,
             report_errors: bool = True):
    """Open a session under the lock, connect, drain, and always close it.

    A handler fault is raised here, on the way out, for every verb that opens a
    session. A fault swallowed at the callback boundary is indistinguishable
    from an idle server, so a verb that answered anyway would be reporting an
    absence it never established. `report_errors=False` is for a caller that
    collects the fault into its own report instead — `doctor` answers for every
    connection and must not stop at the first."""
    with _session_lock(cfg):
        session = Session(cfg, props=props)
        try:
            session.open(expect_session=expect_session)
            if connect:
                session.require_connected()
                if identity:
                    session.require_account()
                session.drain()
                session.refresh_identities()
            yield session
            if report_errors:
                session.report_handler_errors()
        finally:
            session.close()



# ── Reading what the store holds ────────────────────────────────────────────

_MESSAGE_SELECT = """
SELECT m.*, e.media_path, e.media_state, e.media_error, e.transcript,
       e.transcript_language, e.transcript_confidence, e.transcript_model,
       e.transcript_provider, e.transcript_at, e.transcript_error
  FROM messages m
  LEFT JOIN enrichment e ON e.chat_id = m.chat_id AND e.id = m.id
"""


def _batched(values, size: int = 400):
    """SQLite binds a bounded number of parameters per statement, and a chat's
    message count is not bounded. Nothing here should fail because a
    conversation grew."""
    values = list(values)
    for start in range(0, len(values), size):
        yield values[start:start + size]


def _identity_index(db, ids) -> dict:
    """What the store knows about a set of identities, in one query.

    Both forms of an identity are kept, so an entry answers under either key and
    carries the phone form alongside the display name: a reader that only ever
    saw the LID would be shown an opaque number for someone the store can name
    and address."""
    wanted = {i for i in ids if i}
    if not wanted:
        return {}
    rows = []
    for batch in _batched(sorted(wanted), size=400):
        marks = ",".join("?" * len(batch))
        rows += db.execute(
            f"SELECT jid, lid, name, push_name FROM identities "
            f"WHERE jid IN ({marks}) OR lid IN ({marks})",
            list(batch) * 2).fetchall()
    index: dict = {}
    for row in rows:
        phone = row["jid"] if not (row["jid"] or "").endswith("@lid") else None
        entry = {"name": row["name"] or row["push_name"] or None, "jid": phone}
        for key in (row["jid"], row["lid"]):
            if key not in wanted:
                continue
            held = index.setdefault(key, {"name": None, "jid": None})
            held["name"] = held["name"] or entry["name"]
            held["jid"] = held["jid"] or entry["jid"]
    return index


def _chat_display_name(db, chat_id: str, stored_name: str | None) -> str:
    if stored_name:
        return stored_name
    known = _identity_index(db, {chat_id}).get(chat_id) or {}
    if known.get("name"):
        return known["name"]
    user, _, server = chat_id.partition("@")
    if server == "s.whatsapp.net":
        return f"+{user}"
    return chat_id


def _sender_label(row, chat_name: str | None, is_group: bool,
                  index: dict) -> str | None:
    if row["from_me"]:
        return "You"
    if row["push_name"]:
        return row["push_name"]
    for key in (row["sender"], row["sender_lid"]):
        known = index.get(key) or {}
        if key and known.get("name"):
            return known["name"]
    if not is_group and chat_name:
        return chat_name
    identity = row["sender"] or row["sender_lid"]
    if identity:
        user, _, server = identity.partition("@")
        return f"+{user}" if server == "s.whatsapp.net" else identity
    return None


def _sender_id(row, index: dict, is_group: bool) -> str | None:
    """The addressable form of a sender.

    A LID identifies a person without naming them, so the phone form is
    preferred wherever the store holds one. A direct message carries no
    participant at all — the chat is the other party — so the chat answers for
    an incoming one rather than leaving the sender blank."""
    if row["from_me"]:
        return None
    if row["sender"] and not row["sender"].endswith("@lid"):
        return row["sender"]
    for key in (row["sender_lid"], row["sender"]):
        known = index.get(key) or {}
        if known.get("jid"):
            return known["jid"]
    return row["sender"] or row["sender_lid"] or (None if is_group else row["chat_id"])


def _envelope(row, chat_name: str | None, is_group: bool, index: dict) -> dict:
    """One message in the shape every consumer reads — the same envelope in
    `messages --json` and in an export's "messages" array."""
    ts = row["ts"] or 0
    kind = _canonical_type(row["kind"], row["is_voice"])
    entry = {
        "id": row["id"],
        "timestamp": ts,
        "date": (datetime.datetime.fromtimestamp(ts).isoformat() if ts else None),
        "from": {
            "id": _sender_id(row, index, is_group),
            "lid": row["sender_lid"],
            "name": _sender_label(row, chat_name, is_group, index),
            "from_me": bool(row["from_me"]),
        },
        "type": kind,
        "text": row["text"] or None,
        "reply_to": row["quoted_id"],
        "media": None,
        "transcription": None,
    }
    if row["kind"] in _MEDIA_FIELDS:
        media = {"filename": row["file_name"], "mimetype": row["mimetype"]}
        if row["seconds"]:
            media["seconds"] = row["seconds"]
        if row["is_voice"]:
            media["voice"] = True
        if row["media_path"]:
            media["file_path"] = row["media_path"]
        if row["media_state"]:
            media["state"] = row["media_state"]
        if row["media_error"]:
            media["error"] = row["media_error"]
        entry["media"] = media
    if row["transcript"]:
        entry["transcription"] = {
            "text": row["transcript"],
            "language": row["transcript_language"],
            "confidence": row["transcript_confidence"],
            "model": row["transcript_model"],
            "provider": row["transcript_provider"],
            "transcribed_at": row["transcript_at"],
        }
    elif row["transcript_error"]:
        entry["transcription"] = {"error": row["transcript_error"]}
    return entry


def _chat_row(db, chat_id: str):
    return db.execute("SELECT * FROM chats WHERE id = ?", (chat_id,)).fetchone()


def _read_messages(db, chat_id: str, *, limit: int | None,
                   from_ts: int | None, to_ts: int | None) -> list[dict]:
    """The window a caller asked for, oldest-first, out of the store."""
    where = ["m.chat_id = ?"]
    params: list = [chat_id]
    if from_ts:
        where.append("m.ts >= ?")
        params.append(from_ts)
    if to_ts:
        where.append("m.ts < ?")
        params.append(to_ts)
    sql = f"{_MESSAGE_SELECT} WHERE {' AND '.join(where)} ORDER BY m.ts DESC, m.id DESC"
    if limit:
        sql += " LIMIT ?"
        params.append(limit)
    rows = list(db.execute(sql, params))
    rows.reverse()
    chat = _chat_row(db, chat_id)
    chat_name = _chat_display_name(db, chat_id, chat["name"] if chat else None)
    is_group = _is_group(chat_id)
    index = _identity_index(
        db, {r["sender"] for r in rows} | {r["sender_lid"] for r in rows})
    return [_envelope(r, chat_name, is_group, index) for r in rows]


def _coverage(db, chat_id: str, *, limit: int | None,
              from_ts: int | None, to_ts: int | None = None) -> dict:
    """Whether the store can already answer the window that was asked for.

    Counted inside that window, because a chat holding hundreds of recent
    messages says nothing about whether it holds the fifty before a date the
    caller named."""
    where = ["chat_id = ?"]
    params: list = [chat_id]
    if from_ts:
        where.append("ts >= ?")
        params.append(from_ts)
    if to_ts:
        where.append("ts < ?")
        params.append(to_ts)
    window = db.execute(
        f"SELECT COUNT(*) AS n, MIN(NULLIF(ts,0)) AS oldest, MAX(ts) AS newest"
        f"  FROM messages WHERE {' AND '.join(where)}", params).fetchone()
    whole = db.execute(
        "SELECT COUNT(*) AS n, MIN(NULLIF(ts,0)) AS oldest FROM messages"
        "  WHERE chat_id = ?", (chat_id,)).fetchone()
    chat = _chat_row(db, chat_id)
    held = window["n"] or 0
    if chat is not None and chat["end_of_history"]:
        covered = True          # the phone itself said it holds nothing older
    elif from_ts:
        covered = bool(whole["oldest"]) and whole["oldest"] <= from_ts
    elif limit:
        covered = held >= limit
    else:
        covered = held > 0
    return {"held": held, "held_overall": whole["n"] or 0,
            "oldest": window["oldest"], "oldest_overall": whole["oldest"],
            "newest": window["newest"], "covered": covered}


def _oldest_held(db, chat_id: str) -> int | None:
    row = db.execute(
        "SELECT MIN(NULLIF(ts,0)) AS oldest FROM messages WHERE chat_id = ?",
        (chat_id,)).fetchone()
    return row["oldest"]


def _reach_back(session: "Session", chat_id: str, *, limit: int | None,
                from_ts: int | None, to_ts: int | None, rounds: int) -> dict:
    """Deepen the store until it can answer, or until the phone has no more.

    Every request is anchored on the oldest message held, so the anchor moving
    is the only evidence that a round achieved anything: an answer that brings
    nothing older than the anchor is the phone saying it holds nothing older,
    and the next request would repeat the last one.

    That conclusion is drawn per invocation and never written down. Only the
    protocol's own statement — a transfer that ended with nothing left on the
    primary device — marks a chat closed in the store, because a flag inferred
    from one page would silence the chat for good if the page was wrong, and
    nothing would ever clear it. Re-deriving it costs one request."""
    reach = {"rounds": 0, "new": 0, "ok": True}
    for _ in range(max(0, rounds)):
        if _coverage(session.db, chat_id, limit=limit, from_ts=from_ts,
                     to_ts=to_ts)["covered"]:
            break
        anchor_before = _oldest_held(session.db, chat_id)
        _log(f"  reaching back for {HISTORY_PAGE} older message(s) …")
        answer = session.request_older(chat_id)
        reach["rounds"] += 1
        if not answer["ok"]:
            reach["ok"] = False
            reach["reason"] = answer["reason"]
            if answer.get("detail"):
                reach["detail"] = answer["detail"]
            break
        reach["new"] += answer["new"]
        anchor_after = _oldest_held(session.db, chat_id)
        if answer["seen"] == 0:
            # The phone answered and sent nothing at all: it holds nothing older.
            reach["floor"] = True
            _log("  the phone returned nothing older; this chat is at its floor")
            break
        if anchor_after is None or anchor_after == anchor_before:
            # It sent something, but nothing preceding the anchor, so the next
            # request would repeat this one. Stopping is right; calling it a
            # floor is not — that is a claim about the phone this does not
            # establish, and it would hide a short window behind a clean exit.
            reach["stalled"] = True
            _log("  the answer moved nothing older into the store; stopping")
            break
    return reach


def _reach_verdict(reach: dict | None, produced: int, chat_id: str,
                   coverage: dict, *, from_ts: int | None) -> None:
    """A window the caller asked for and did not get must not read as a window
    that was answered.

    Backfill is served by the phone, so its silence is a distinct state, and a
    round cap is a distinct state again. Left unsaid, either one returns a
    truncated window at exit zero — the same silent-absence failure a swallowed
    handler fault produces. A chat at its floor is neither: everything that
    exists is held, so the answer is complete."""
    if reach is None or coverage.get("covered") or reach.get("floor"):
        return
    if not reach.get("ok"):
        reason = reach.get("reason")
        if reason == "no_anchor":
            return          # the caller checks for an unknown chat itself
        hint = ("backfill is served by the phone, not by WhatsApp's servers: the "
                "phone must be online and connected. Retry when it is"
                if reason == "phone_unreachable"
                else reach.get("detail") or "retry")
        _refuse(5, reason or "reach_failed",
             f"the phone did not complete the history request for {chat_id}, so "
             f"the window asked for is not covered (the store holds "
             f"{coverage.get('held', 0)} message(s) of it)",
             f"{hint}. To read what is held without asking the phone, re-run "
             f"with --rounds 0")
    if from_ts is not None:
        # A --limit is a cap the caller set. A --from is a boundary the caller
        # named, and stopping short of it is a shortfall, not an answer.
        reached = format_dt(coverage.get("oldest_overall") or 0)
        if reach.get("stalled"):
            _refuse(5, "reach_stalled",
                    f"the phone stopped providing messages older than "
                    f"{reached} for {chat_id}, short of the date asked for; "
                    f"the store holds {coverage.get('held', 0)} message(s) of "
                    f"the window",
                    "it may hold no more, or it may be mid-sync — retry later. "
                    "To read what is held without asking again, re-run with "
                    "--rounds 0")
        _refuse(5, "window_incomplete",
                f"the round cap was reached before {chat_id} was covered back "
                f"to the date asked for; the store reaches back to {reached} "
                f"and holds {coverage.get('held', 0)} message(s) of the window",
                f"re-run with a larger --rounds to keep reaching (each round "
                f"asks the phone for {HISTORY_PAGE} more and takes a few "
                f"seconds), or with --rounds 0 to read what is held")


# ── The in-house engine's commands ──────────────────────────────────────────


def _store_facts(cfg: dict) -> dict:
    db = _open_store(cfg)
    try:
        counts = db.execute(
            "SELECT (SELECT COUNT(*) FROM chats) AS chats,"
            "       (SELECT COUNT(*) FROM messages) AS messages,"
            "       (SELECT MIN(NULLIF(ts,0)) FROM messages) AS oldest,"
            "       (SELECT MAX(ts) FROM messages) AS newest,"
            "       (SELECT COUNT(*) FROM messages WHERE is_voice = 1) AS voice_notes,"
            "       (SELECT COUNT(*) FROM messages WHERE direct_path IS NOT NULL) AS with_media,"
            "       (SELECT COUNT(*) FROM messages WHERE kind = 'placeholderMessage'"
            "          OR kind = 'empty') AS unreadable,"
            "       (SELECT COUNT(*) FROM enrichment WHERE media_state = 'fetched') AS media_fetched,"
            "       (SELECT COUNT(*) FROM enrichment WHERE media_state IN ('expired','error','unfetchable')) AS media_lost,"
            "       (SELECT COUNT(*) FROM enrichment WHERE transcript IS NOT NULL) AS transcribed,"
            "       (SELECT COUNT(*) FROM chunks) AS chunks,"
            "       (SELECT MAX(at) FROM chunks) AS last_capture,"
            "       (SELECT value FROM meta WHERE key = 'rebuild_incomplete')"
            "         AS rebuild_incomplete"
        ).fetchone()
        facts = dict(counts)
    finally:
        db.close()
    facts["path"] = str(Path(cfg["home"]) / "messages.db")
    for key in ("oldest", "newest"):
        ts = facts.get(key)
        facts[key] = datetime.datetime.fromtimestamp(ts).isoformat() if ts else None
    return facts


def _wm_check_connection(cfg: dict) -> dict:
    """One connection's readiness, reported and never raised.

    `doctor` answers for every connection, so a refusal here is folded into this
    connection's entry rather than ending the run — a device unlinked from one
    account must not silence the report on the others."""
    try:
        return _wm_probe_connection(cfg)
    except _Refusal as refusal:
        result = refusal.as_result()
        result.setdefault("engine", cfg["engine"])
        result["linked"] = _session_exists(cfg)
        return result


def _wm_probe_connection(cfg: dict) -> dict:
    """One connection's whole readiness chain: the engine loads, a session
    exists, it authorises, and the account is the one the connection is bound
    to. It connects, so the server's queue for the device drains here too."""
    account_id, account_jid, push_name = _session_account(cfg)
    if not _session_exists(cfg):
        return {"ok": False, "category": 7, "engine": cfg["engine"],
                "linked": False,
                "error": f"connection {cfg['id']!r} has no linked WhatsApp device",
                "hint": f"run `{NAME} pair --connection {cfg['id']}`"}
    expected = cfg.get("expected_account_id")
    result: dict = {"ok": False, "engine": cfg["engine"], "linked": True,
                    "account": {"id": account_id, "jid": account_jid,
                                "name": push_name},
                    "expected_account_id": expected}
    if expected and account_id and account_id != expected:
        result.update(category=2, error=(
            f"the stored session belongs to {account_id}, not the bound {expected}"),
            hint="use the session owned by the configured account, or correct "
                 "expected_account_id in connections.json")
        return result
    with _session(cfg, identity=False, report_errors=False) as session:
        account = session.require_account()
        result["account"] = account
        result["drained"] = session.offline_count
        result["captured"] = {"chunks": len(session.chunks),
                              "live_messages": session.live_messages}
        if session.errors:
            result.update(category=5, error=session.errors[0],
                          hint="an engine handler failed; the traceback is on stderr")
            return result
    result["store"] = _store_facts(cfg)
    warning = _export_root_warning(cfg)
    if warning:
        result["warnings"] = [warning]
    if not expected and account.get("id"):
        result["identity_binding"] = {
            "connection": cfg["id"], "expected_account_id": account["id"],
            "instruction": "set expected_account_id on this connection so a "
                           "session belonging to another account is refused"}
    result["ok"] = True
    return result


def _export_root_warning(cfg: dict) -> str | None:
    """An export holds personal history and media, minted by the linked-device
    session, so it never belongs in a commit. The manager-owned guard covers the
    default location only, so a relocated root is checked where it actually is."""
    root = cfg.get("messages_dir")
    project = _project_root()
    if not root or project is None:
        return None
    target = Path(root)
    try:
        target.relative_to(project)
    except ValueError:
        return None      # outside the repository: nothing to ignore it in
    probe = target / ".probe"
    try:
        ignored = subprocess.run(
            ["git", "check-ignore", "-q", str(probe)],
            cwd=project, capture_output=True, timeout=10).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return None
    if ignored:
        return None
    return (f"the export root {target} is inside {project} and is not git-ignored; "
            "exported conversations and media are personal data and must not commit")


def _require_linked(cfg: dict) -> None:
    """An empty answer from an unlinked connection is a lie by omission: there is
    nothing to read because no device is linked, and that is what to say."""
    if _session_exists(cfg):
        return
    _refuse(7, "not_linked",
         f"connection {cfg['id']!r} has no linked WhatsApp device, so its store "
         "is empty",
         f"run `{NAME} pair --connection {cfg['id']}` and enter the code on the phone")


def _wm_status(cfg: dict) -> str:
    account_id, account_jid, push_name = _session_account(cfg)
    facts = _store_facts(cfg)
    lines = [
        f"Profile:  {cfg['id']} (mode: {cfg['mode']}, engine: {cfg['engine']})",
        f"Linked:   {'yes' if _session_exists(cfg) else 'no'}",
        f"Account:  {push_name or '—'} ({account_jid or '—'})",
        f"Bound to: {cfg.get('expected_account_id') or '— (unbound)'}",
        f"Store:    {facts['chats']} chats, {facts['messages']} messages",
        f"Span:     {(facts['oldest'] or '—')[:10]} … {(facts['newest'] or '—')[:10]}",
        f"Capture:  {facts['chunks']} chunk(s), last {facts['last_capture'] or '—'}",
        f"Path:     {facts['path']}",
    ]
    return "\n".join(lines)


def _wm_health(cfg: dict) -> None:
    """What the capture holds and what is missing from it.

    Local only: whether there is anything here to consume is the store's
    question, and whether the account still answers is `doctor`'s. An empty
    store is a fact about the capture, not a fault in it, so it is reported as
    one and does not colour the exit."""
    linked = _session_exists(cfg)
    account_id, account_jid, push_name = _session_account(cfg)
    facts = _store_facts(cfg)
    expected = cfg.get("expected_account_id")
    bound = bool(expected) and account_id == expected
    mismatch = bool(expected) and bool(account_id) and account_id != expected
    checks = [
        {"item": "session", "ok": linked,
         "detail": "a device is linked" if linked
                   else f"no linked device — run `{NAME} pair`"},
        {"item": "binding", "ok": not mismatch,
         "detail": (f"{account_id} matches expected_account_id" if bound
                    else f"expected_account_id is {expected}, session is "
                         f"{account_id or 'absent'}" if mismatch
                    else "unbound — set expected_account_id on this connection "
                         "so a session belonging to another account is refused")},
        {"item": "store", "ok": bool(facts["messages"]),
         "detail": f"{facts['messages']} message(s) across {facts['chats']} chat(s)"},
        {"item": "capture", "ok": bool(facts["chunks"]),
         "detail": f"{facts['chunks']} chunk(s), last {facts['last_capture'] or 'never'}"},
        {"item": "media", "ok": True,
         "detail": (f"{facts['media_fetched']} fetched, {facts['media_lost']} beyond "
                    f"the retention window, {facts['with_media']} carrying media")},
        {"item": "readability", "ok": True,
         "detail": f"{facts['unreadable']} message(s) arrived empty or undecryptable"},
        {"item": "rebuild", "ok": not facts["rebuild_incomplete"],
         "detail": facts["rebuild_incomplete"]
                   or "the store's rows were built by the shipping parser"},
    ]
    ready = all(c["ok"] for c in checks)
    out = {"ready": ready, "profile": cfg["id"], "mode": cfg["mode"],
           "engine": cfg["engine"],
           "account": {"id": account_id, "jid": account_jid, "name": push_name},
           "store": facts, "checks": checks}
    if not linked:
        _emit(out)
        _refuse(7, "not_linked",
             f"connection {cfg['id']!r} has no linked WhatsApp device",
             f"run `{NAME} pair --connection {cfg['id']}` and enter the code on "
             f"the phone")
    if mismatch:
        _emit(out)
        _refuse(2, "account_identity_mismatch",
             f"the stored session belongs to {account_id}, not the bound {expected}",
             "use the session owned by the configured account, or correct "
             "expected_account_id in connections.json")
    if not facts["messages"]:
        out["hint"] = (f"the store is empty; run `{NAME} chats --fresh` to drain "
                       f"what the server holds, or `{NAME} messages <chat>` to "
                       f"reach back for a conversation")
    _emit(out)


def _log_qr(payload: str, *, refreshed: bool = False) -> None:
    """Announce one QR reference on the progress stream, greppably.

    The result on stdout cannot carry it: the code has to be rendered and
    scanned while this invocation still holds the socket, so it is reported as
    progress and read as the run proceeds."""
    _log(f"\n  QR: {payload}\n"
         + ("  The previous reference expired \u2014 render and scan this one.\n"
            if refreshed else
            "  Render that value as a QR code and scan it on the phone:\n"
            "  WhatsApp \u2192 Settings \u2192 Linked Devices \u2192 Link a Device.\n"
            "  This invocation stays connected until the link completes.\n"))


def _wm_pair(cfg: dict, args) -> None:
    """Link this machine as a companion device and hold the connection open for
    the history burst.

    The burst arrives once, at pairing, and a reconnect delivers none of it, so
    what is not captured here is only recoverable by reaching back chat by chat.
    Depth is nonetheless separable from reach: a shallow window here does not
    cap how far `messages` can later go."""
    _connection_home(cfg)
    if _session_exists(cfg):
        if not args.recreate:
            account_id, account_jid, _ = _session_account(cfg)
            _refuse(6, "already_paired",
                 f"connection {cfg['id']!r} already has a linked device ({account_jid})",
                 f"nothing to do — run `{NAME} doctor`; pass --recreate --yes to "
                 "link a new one")
        if not args.yes:
            held = _open_store(cfg)
            try:
                row = held.execute(
                    "SELECT value FROM meta WHERE key = 'account_id'").fetchone()
            finally:
                held.close()
            owner = row["value"] if row else None
            _refuse(6, "confirm_recreate",
                 f"--recreate discards the linked session for {cfg['id']!r} and "
                 f"links a new device"
                 + (f"; the store beside it holds the history of {owner}, and a "
                    f"link to any other account is refused" if owner else ""),
                 "re-run with --yes to confirm; then remove the stale entry from "
                 "Linked Devices on the phone")
        for suffix in ("", "-wal", "-shm", "-journal"):
            Path(str(_session_db(cfg)) + suffix).unlink(missing_ok=True)
        _log(f"Discarded the previous session for {cfg['id']!r}.")

    args.hold = args.hold or PAIR_HOLD_DEFAULT
    days = args.days if args.days else cfg["initial_sync_days"]
    full = bool(args.full)
    number = _digits(args.number or cfg.get("number"))
    if not number and not args.qr:
        _refuse(6, "no_number",
             "pairing by code needs the account's phone number",
             "pass --number with the full international number (digits only), "
             "set `number` on the connection, or use --qr")
    props = _device_props(cfg, days, full)
    _log(f"Device name:  {_device_name(cfg)} (desktop)")
    _log(f"Sync window:  {'everything the phone holds' if full else f'{days} day(s)'}")

    with _session_lock(cfg):
        session = Session(cfg, props=props)
        try:
            session.open(expect_session=False)
            if not session.wait_connected(15):
                if args.qr:
                    deadline = time.monotonic() + 30
                    while not session.qr_payload and time.monotonic() < deadline:
                        time.sleep(0.5)
                    if not session.qr_payload:
                        _refuse(5, "no_qr", "the engine produced no QR payload",
                             "retry, or pair with a phone-number code instead")
                    _log_qr(session.qr_payload)
                else:
                    try:
                        code = session._client.PairPhone(number, True)
                    except Exception as exc:
                        _refuse(5, "pair_code_failed",
                             f"the pairing code could not be requested: "
                             f"{type(exc).__name__}: {exc}",
                             "retry, or use --qr")
                    session.pair_code = code
                    _log(f"\n  Pairing code for +{number}:  {code}\n"
                         "  On that phone: WhatsApp → Settings → Linked Devices → Link a "
                         "Device → 'Link with phone number instead' → enter this code.\n")
            if not session.wait_linked(echo_qr=bool(args.qr)):
                _refuse(7, "never_linked",
                     "the device was not linked before the request expired",
                     f"re-run `{NAME} pair --connection {cfg['id']}` to get a new code")
            account = session.require_account()
            _log(f"Linked as {account['jid']}. Holding up to {args.hold}s for the "
                 "history burst — it arrives once and is not repeated on "
                 "reconnect.")
            session.drain(timeout=args.hold, settle=CHUNK_SETTLE,
                          ceiling=args.hold)
            session.refresh_identities()
            errors = list(session.errors)
        finally:
            session.close()

    facts = _store_facts(cfg)
    result = {"ok": not errors, "connection": cfg["id"],
              "method": "qr" if args.qr else "pairing_code",
              "account": account,
              "sync_window": "full" if full else f"{days}d",
              "captured": {"chunks": len(session.chunks),
                           "chats": facts["chats"], "messages": facts["messages"]},
              "store": facts["path"]}
    if not cfg.get("expected_account_id") and account.get("id"):
        result["identity_binding"] = {
            "connection": cfg["id"], "expected_account_id": account["id"],
            "instruction": "set expected_account_id on this connection so a "
                           "session belonging to another account is refused"}
    if errors:
        result["handler_errors"] = errors
    _emit(result)
    if errors:
        _refuse(5, "engine_handler_failed",
             f"{len(errors)} engine handler(s) failed while capturing the burst: "
             f"{errors[0]}",
             "the capture is incomplete; the tracebacks are on stderr above")


def _wm_chats(cfg: dict, args):
    if getattr(args, "fresh", False):
        with _session(cfg) as session:
            _log(f"  drained {session.offline_count or 0} queued item(s)")
    db = _open_store(cfg)
    try:
        rows = list(db.execute(
            """SELECT c.id, c.name, c.is_group, c.unread,
                      COALESCE(MAX(m.ts), c.last_ts, 0) AS last_activity,
                      COUNT(m.id) AS messages,
                      MIN(NULLIF(m.ts,0)) AS oldest
                 FROM chats c LEFT JOIN messages m ON m.chat_id = c.id
                GROUP BY c.id
                ORDER BY last_activity DESC"""))
        search = (args.search or "").lower()
        results = []
        for row in rows:
            name = _chat_display_name(db, row["id"], row["name"])
            if search and search not in name.lower() and search not in row["id"].lower():
                continue
            results.append({
                "id": row["id"], "name": name, "group": bool(row["is_group"]),
                "unread": row["unread"] or 0,
                "last_activity": row["last_activity"] or 0,
                "messages": row["messages"] or 0,
                "oldest": row["oldest"] or None,
            })
    finally:
        db.close()
    if not results:
        # An empty answer from an unlinked connection is an absence we never
        # established, so the state is reported before the emptiness is — and
        # for a caller passing --json as much as for one reading a table.
        _require_linked(cfg)
    if args.limit:
        results = results[:args.limit]
    if getattr(args, "json", False):
        return results
    if not results:
        return ("No chats in the store."
                + (f" (search: '{args.search}')" if args.search else "")
                + f"  Run `{NAME} chats --fresh` to drain what the server holds.")
    lines = ["| # | Name | ID | Group | Unread | Messages | Since | Last Activity |",
             "|---|------|-----|-------|--------|----------|-------|---------------|"]
    for i, r in enumerate(results, 1):
        lines.append(
            f"| {i} | {r['name']} | `{r['id']}` | {'Yes' if r['group'] else '—'} "
            f"| {r['unread'] or '—'} | {r['messages']} "
            f"| {format_dt(r['oldest'])[:10] if r['oldest'] else '—'} "
            f"| {format_dt(r['last_activity'])} |")
    suffix = f" (filtered by '{args.search}')" if args.search else ""
    lines.append(f"\n{len(results)} chat(s) shown{suffix}")
    return "\n".join(lines)


def _wm_messages(cfg: dict, args):
    chat_id = _normalize_chat_id(args.chat_id)
    from_ts = parse_date(args.from_date) if args.from_date else None
    to_ts = parse_date(args.to_date) + 86400 if args.to_date else None
    rounds = DEFAULT_ROUNDS if args.rounds is None else max(0, args.rounds)
    limit = args.limit
    reach: dict | None = None

    db = _open_store(cfg)
    try:
        coverage = _coverage(db, chat_id, limit=limit, from_ts=from_ts, to_ts=to_ts)
        known = _chat_row(db, chat_id) is not None
    finally:
        db.close()
    # An unknown chat is answered before anything is asked of the network: the
    # store has no message to anchor a request on, so reaching would be a
    # request that cannot be made rather than a chat that is empty.
    if not known and coverage["held_overall"] == 0:
        _require_linked(cfg)
        _refuse(3, "unknown_chat", f"the store holds no chat {chat_id}",
             f"run `{NAME} chats` to see what is captured, or "
             f"`{NAME} chats --fresh` to drain what the server holds")
    needs_reach = rounds > 0 and not coverage["covered"]

    if needs_reach or getattr(args, "fresh", False):
        with _session(cfg) as session:
            if needs_reach:
                reach = _reach_back(session, chat_id, limit=limit,
                                    from_ts=from_ts, to_ts=to_ts, rounds=rounds)

    db = _open_store(cfg)
    try:
        messages = _read_messages(db, chat_id, limit=limit,
                                  from_ts=from_ts, to_ts=to_ts)
        chat = _chat_row(db, chat_id)
        chat_name = _chat_display_name(db, chat_id, chat["name"] if chat else None)
        coverage = _coverage(db, chat_id, limit=limit, from_ts=from_ts, to_ts=to_ts)
    finally:
        db.close()
    if reach is not None:
        _log(f"  reached back {reach['rounds']} round(s), {reach['new']} new message(s)"
             + ("" if reach.get("ok") else f" — {reach.get('reason')}"))
        _reach_verdict(reach, len(messages), chat_id, coverage,
                       from_ts=from_ts)

    if getattr(args, "json", False):
        return messages
    if not messages:
        return ("No messages found." if not (args.from_date or args.to_date)
                else "No messages in the specified date range.")
    if args.format == "table":
        return _render_envelope_table(messages)
    return _render_envelope_conversation(messages, chat_name)


def _render_envelope_conversation(messages, chat_name=None):
    current_date = None
    lines = []
    for m in messages:
        ts = m.get("timestamp") or 0
        dt = ts_to_dt(ts)
        date_str = dt.strftime("%Y-%m-%d") if dt else "—"
        time_str = dt.strftime("%H:%M") if dt else "—"
        if date_str != current_date:
            current_date = date_str
            lines.append(f"\n── {date_str} ──\n")
        sender = (m.get("from") or {}).get("name") or "(unknown)"
        body = (m.get("text") or "").strip()
        transcription = m.get("transcription") or {}
        if not body and transcription.get("text"):
            body = transcription["text"]
        if not body:
            body = {
                "image": "[Image]", "video": "[Video]", "audio": "[Voice message]",
                "ptt": "[Voice message]", "document": "[Document]",
                "sticker": "[Sticker]", "location": "[Location]",
                "vcard": "[Contact card]", "undecryptable": "[Undecryptable]",
                "empty": "[Empty]",
            }.get(m.get("type"), f"[{m.get('type')}]")
        body_lines = body.split("\n")
        if len(body_lines) > 1:
            indent = " " * (len(time_str) + 2 + len(sender) + 2)
            body = body_lines[0] + "\n" + "\n".join(indent + ln for ln in body_lines[1:])
        lines.append(f"[{time_str}] {sender}: {body}")
    lines.append(f"\n--- {len(messages)} message(s) ---")
    return "\n".join(lines)


def _render_envelope_table(messages):
    lines = ["| # | Time | Sender | Type | Message |",
             "|---|------|--------|------|---------|"]
    for i, m in enumerate(messages, 1):
        sender = (m.get("from") or {}).get("name") or "(unknown)"
        body = ((m.get("text") or (m.get("transcription") or {}).get("text") or "")
                [:120].replace("\n", " ").replace("|", "\\|"))
        if not body:
            body = f"[{m.get('type')}]"
        lines.append(f"| {i} | {format_dt(m.get('timestamp') or 0)} | {sender} "
                     f"| {m.get('type')} | {body} |")
    lines.append(f"\n{len(messages)} message(s)")
    return "\n".join(lines)


def _wm_contact(cfg: dict, args):
    contact_id = _normalize_chat_id(args.contact_id)
    if getattr(args, "fresh", False):
        with _session(cfg) as session:
            if contact_id.endswith("@lid"):
                session.resolve_lid(contact_id)
    db = _open_store(cfg)
    try:
        row = db.execute(
            "SELECT jid, lid, name, push_name FROM identities WHERE jid = ? OR lid = ?",
            (contact_id, contact_id)).fetchone()
        chat = _chat_row(db, contact_id)
        counts = db.execute(
            "SELECT COUNT(*) AS n, MAX(ts) AS newest FROM messages WHERE chat_id = ?",
            (contact_id,)).fetchone()
    finally:
        db.close()
    if row is None and chat is None:
        _require_linked(cfg)
        _refuse(3, "unknown_contact",
             f"the store holds nothing for {contact_id}",
             f"run `{NAME} contact {args.contact_id} --fresh` to ask the engine, "
             f"or `{NAME} chats` to see what is captured")
    jid = (row["jid"] if row else None) or (chat["id"] if chat else contact_id)
    lid = row["lid"] if row else None
    name = ((row["name"] or row["push_name"]) if row else None) or (
        chat["name"] if chat else None)
    number = jid.split("@", 1)[0] if jid and jid.endswith("@s.whatsapp.net") else None
    payload = {
        "id": jid, "lid": lid, "name": name, "number": number,
        "group": _is_group(jid),
        "messages": counts["n"] or 0,
        "last_activity": counts["newest"] or None,
    }
    if getattr(args, "json", False):
        return payload
    return "\n".join([
        f"Name:      {name or '—'}",
        f"Number:    {number or '—'}",
        f"ID:        {jid}",
        f"LID:       {lid or '—'}",
        f"Group:     {'Yes' if payload['group'] else 'No'}",
        f"Messages:  {payload['messages']}",
        f"Last seen: {format_dt(payload['last_activity']) if payload['last_activity'] else '—'}",
    ])



# ── Export ──────────────────────────────────────────────────────────────────


def _export_paths(cfg: dict, args, chat_id: str, chat_name: str) -> tuple[Path, Path]:
    if args.out:
        out = Path(args.out).expanduser().resolve()
    elif cfg.get("messages_dir"):
        slug = _slugify(chat_name) or _slugify(chat_id) or "chat"
        out = Path(cfg["messages_dir"]).expanduser().resolve() / slug / "messages.json"
    else:
        _refuse(6, "no_output_path",
             "no --out given and no messages_dir resolved",
             "pass --out PATH, or set messages_dir on this connection so the "
             "default store applies")
    out.parent.mkdir(parents=True, exist_ok=True)
    media_dir = (Path(args.media_dir).expanduser().resolve()
                 if args.media_dir else out.parent / "media")
    media_dir.mkdir(parents=True, exist_ok=True)
    return out, media_dir


def _download_kinds(args) -> set:
    kinds = set(VOICE_TYPES)
    if not args.no_photos:
        kinds.add("image")
    if not args.no_stickers:
        kinds.add("sticker")
    if args.videos:
        kinds.add("video")
    if args.documents:
        kinds.add("document")
    return kinds


def _record_media(db, chat_id: str, message_id: str, *, path: str | None,
                  state: str, error: str | None = None) -> None:
    with _writing(db):
        db.execute(
            """INSERT INTO enrichment (chat_id, id, media_path, media_state,
                                       media_error, updated_at)
               VALUES (?,?,?,?,?,?)
               ON CONFLICT(chat_id, id) DO UPDATE SET
                 media_path = excluded.media_path,
                 media_state = excluded.media_state,
                 media_error = excluded.media_error,
                 updated_at = excluded.updated_at""",
            (chat_id, message_id, path, state, error, _iso_now()))


def _record_transcript(db, chat_id: str, message_id: str, result: dict) -> None:
    with _writing(db):
        db.execute(
            """INSERT INTO enrichment (chat_id, id, transcript, transcript_language,
                                       transcript_confidence, transcript_model,
                                       transcript_provider, transcript_at,
                                       transcript_error, effective_text, updated_at)
               VALUES (?,?,?,?,?,?,?,?,?,?,?)
               ON CONFLICT(chat_id, id) DO UPDATE SET
                 transcript = excluded.transcript,
                 transcript_language = excluded.transcript_language,
                 transcript_confidence = excluded.transcript_confidence,
                 transcript_model = excluded.transcript_model,
                 transcript_provider = excluded.transcript_provider,
                 transcript_at = excluded.transcript_at,
                 transcript_error = excluded.transcript_error,
                 effective_text = excluded.effective_text,
                 updated_at = excluded.updated_at""",
            (chat_id, message_id, result.get("text"), result.get("language"),
             result.get("confidence"), result.get("model"), result.get("provider"),
             result.get("transcribed_at"), result.get("error"), result.get("text"),
             _iso_now()))


def _pending_media(db, chat_id: str, wanted_kinds: set,
                   messages: list[dict]) -> list[str]:
    """Message ids whose attachment is still worth trying: the kind is wanted,
    the store carries the decryption material, and no earlier attempt already
    fetched it or established that it is gone."""
    ids = [m["id"] for m in messages
           if m.get("type") in wanted_kinds and (m.get("media") or {})]
    rows = []
    for batch in _batched(ids):
        marks = ",".join("?" * len(batch))
        rows += db.execute(
            f"""SELECT m.id, m.direct_path, m.media_key, e.media_state, e.media_path
                  FROM messages m LEFT JOIN enrichment e
                    ON e.chat_id = m.chat_id AND e.id = m.id
                 WHERE m.chat_id = ? AND m.id IN ({marks})""",
            [chat_id, *batch]).fetchall()
    pending = []
    for row in rows:
        if row["media_state"] in ("expired", "unfetchable"):
            continue
        if row["media_state"] == "fetched" and row["media_path"] \
                and Path(row["media_path"]).exists():
            continue
        if not (row["direct_path"] and row["media_key"]):
            continue
        pending.append(row["id"])
    return pending


def _fetch_media(session: "Session", chat_id: str, pending: list[str]) -> dict:
    """Fetch what can still be fetched, and record what cannot as the loss it
    is. Media leaves WhatsApp's CDN while the keys stay valid, so age — not a
    broken capture — is the usual reason for a refusal."""
    counts = {"fetched": 0, "expired": 0, "failed": 0}
    cache = _connection_home(session.cfg) / "media"
    rows = []
    for batch in _batched(pending):
        marks = ",".join("?" * len(batch))
        rows += list(session.db.execute(
            f"SELECT * FROM messages WHERE chat_id = ? AND id IN ({marks})",
            [chat_id, *batch]))
    for n, row in enumerate(rows, 1):
        _log(f"  media [{n}/{len(rows)}] {row['id']} …")
        answer = session.fetch_media(row)
        state = answer["state"]
        if state == "fetched":
            ext = _media_ext(row["mimetype"], row["file_name"])
            dest = cache / f"{_safe_id_for_filename(row['id'])}{ext}"
            dest.write_bytes(answer["data"])
            _record_media(session.db, chat_id, row["id"],
                          path=str(dest), state="fetched")
            counts["fetched"] += 1
        else:
            _record_media(session.db, chat_id, row["id"], path=None,
                          state=state, error=answer.get("error"))
            counts["expired" if state == "expired" else "failed"] += 1
            _log(f"       → {state}: {answer.get('error') or 'no material'}")
    return counts


# The media states an export publishes. `expired` is final — the ciphertext has
# left WhatsApp's content network — while `error` may still be transient.
_MEDIA_GONE_MARKERS = ("403", "404", "410", "gone", "expired")


def _as_current_envelope(message: dict) -> dict:
    """Carry a message written by an earlier export into the shape this one
    publishes.

    An export names one schema version, so every message in it answers to that
    version. A message carried forward from a file written under an older one
    would otherwise leave a consumer reading the current keys and finding
    nothing on exactly the messages it did not fetch again."""
    entry = dict(message)
    sender = dict(entry.get("from") or {})
    sender.setdefault("id", None)
    sender.setdefault("lid", None)
    sender.setdefault("name", None)
    sender["from_me"] = bool(sender.get("from_me"))
    entry["from"] = sender
    for key in ("text", "reply_to", "media", "transcription"):
        entry.setdefault(key, None)
    entry.setdefault("type", "text")
    entry.setdefault("timestamp", 0)
    entry.setdefault("date", None)
    media = entry.get("media")
    if isinstance(media, dict):
        media = dict(media)
        failure = media.pop("fetch_error", None) or media.pop("download_error", None)
        if failure and not media.get("error"):
            media["error"] = failure
        if not media.get("state"):
            if media.get("file_path"):
                media["state"] = "fetched"
            elif media.get("error"):
                lowered = str(media["error"]).lower()
                media["state"] = ("expired"
                                  if any(m in lowered for m in _MEDIA_GONE_MARKERS)
                                  else "error")
            else:
                media["state"] = "absent"
        media.setdefault("filename", None)
        media.setdefault("mimetype", None)
        entry["media"] = media
    return entry


def _adopt_prior_transcriptions(db, chat_id: str, prior: dict) -> int:
    """A prior export's transcriptions are work already paid for. They are
    adopted into the store so re-exports carry them without redoing it."""
    adopted = 0
    for message in prior.get("messages", []):
        message_id = message.get("id") if isinstance(message, dict) else None
        transcription = (message or {}).get("transcription")
        if not message_id:
            continue
        if not (isinstance(transcription, dict) and transcription.get("text")):
            continue
        held = db.execute(
            "SELECT transcript FROM enrichment WHERE chat_id = ? AND id = ?",
            (chat_id, message_id)).fetchone()
        if held and held["transcript"]:
            continue
        _record_transcript(db, chat_id, message_id, transcription)
        adopted += 1
    return adopted


def _wm_export(cfg: dict, args):
    chat_id = _normalize_chat_id(args.chat_id)
    from_ts = parse_date(args.from_date) if args.from_date else None
    to_ts = parse_date(args.to_date) + 86400 if args.to_date else None
    rounds = DEFAULT_ROUNDS if args.rounds is None else max(0, args.rounds)
    limit = args.limit
    wanted = _download_kinds(args)

    db = _open_store(cfg)
    try:
        chat = _chat_row(db, chat_id)
        chat_name = _chat_display_name(db, chat_id, chat["name"] if chat else None)
        coverage = _coverage(db, chat_id, limit=limit, from_ts=from_ts, to_ts=to_ts)
    finally:
        db.close()
    # Refused before anything is created. Reaching back anchors on a message
    # already held, so a chat the store has never seen cannot be deepened into
    # existence — and writing a folder and an empty messages.json for it would
    # fabricate a conversation rather than report a missing one.
    if chat is None and coverage["held_overall"] == 0:
        _require_linked(cfg)
        _refuse(3, "unknown_chat", f"the store holds no chat {chat_id}",
             f"run `{NAME} chats --fresh` to see what is captured")

    out, media_dir = _export_paths(cfg, args, chat_id, chat_name)
    _log(f"Exporting:    {chat_name}  ({chat_id})")
    _log(f"Output:       {out}")
    _log(f"Media dir:    {media_dir}")
    _log(f"Downloading:  {sorted(wanted)}")

    prior_by_id: dict = {}
    prior: dict | None = None
    if out.exists():
        try:
            loaded = json.loads(out.read_text())
            if not isinstance(loaded, dict):
                raise ValueError("the top level is not an export object")
            prior = loaded
            for message in prior.get("messages") or []:
                if isinstance(message, dict) and message.get("id"):
                    prior_by_id[message["id"]] = message
        except Exception as exc:
            # Anything unreadable is replaced, not raised on: the store is the
            # authority and the file is a rendering of it.
            _log(f"Prior export unreadable ({type(exc).__name__}: {exc}); "
                 "it will be replaced.")
    if prior is not None:
        # Kept out of the tolerant block above: a store that cannot be opened is
        # a real failure, not a reason to overwrite an export.
        db = _open_store(cfg)
        try:
            adopted = _adopt_prior_transcriptions(db, chat_id, prior)
        finally:
            db.close()
        _log(f"Prior export: {len(prior_by_id)} message(s), "
             f"{adopted} transcription(s) adopted into the store")

    def _read(store):
        return _read_messages(store, chat_id, limit=limit,
                              from_ts=from_ts, to_ts=to_ts)

    db = _open_store(cfg)
    try:
        messages = _read(db)
        pending = _pending_media(db, chat_id, wanted, messages)
    finally:
        db.close()

    # Deepening and fetching attachments both go to the network, so they share
    # one connection rather than paying to open the session twice.
    reach = None
    media_counts = {"fetched": 0, "expired": 0, "failed": 0}
    needs_reach = rounds > 0 and not coverage["covered"]
    if needs_reach or pending:
        with _session(cfg) as session:
            if needs_reach:
                reach = _reach_back(session, chat_id, limit=limit,
                                    from_ts=from_ts, to_ts=to_ts, rounds=rounds)
                _log(f"  reached back {reach['rounds']} round(s), "
                     f"{reach['new']} new message(s)")
                messages = _read(session.db)
                pending = _pending_media(session.db, chat_id, wanted, messages)
            if pending:
                _log(f"Fetching {len(pending)} attachment(s) …")
                media_counts = _fetch_media(session, chat_id, pending)
                messages = _read(session.db)
    if reach is not None:
        db = _open_store(cfg)
        try:
            coverage = _coverage(db, chat_id, limit=limit, from_ts=from_ts,
                                 to_ts=to_ts)
        finally:
            db.close()
        _reach_verdict(reach, len(messages), chat_id, coverage,
                       from_ts=from_ts)

    # The export folder is self-contained: a cached attachment is copied beside
    # the JSON, and the path a consumer reads points there.
    for message in messages:
        media = message.get("media")
        if not media or not media.get("file_path"):
            continue
        source = Path(media["file_path"])
        if not source.exists():
            media.pop("file_path", None)
            media["state"] = "missing"
            continue
        dest = media_dir / source.name
        if not dest.exists() or dest.stat().st_size != source.stat().st_size:
            dest.write_bytes(source.read_bytes())
        media["file_path"] = str(dest)

    exported_ids = {m["id"] for m in messages}
    carried_over = 0
    for message_id, message in prior_by_id.items():
        if message_id not in exported_ids:
            messages.append(_as_current_envelope(message))
            carried_over += 1
    if carried_over:
        messages.sort(key=lambda m: m.get("timestamp") or 0)
        _log(f"Carried over {carried_over} message(s) held only by the prior export.")

    payload = {
        "chat": {"id": chat_id, "name": chat_name,
                 "type": "group" if _is_group(chat_id) else "dm"},
        "connection": cfg["id"],
        "exported_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "exported_via": f"whatsapp ({cfg['engine']})",
        "message_count": len(messages),
        "media_dir": str(media_dir),
        "media_policy": {
            "voice_audio": True,
            "photos": not args.no_photos,
            "stickers": not args.no_stickers,
            "videos": args.videos,
            "documents": args.documents,
        },
        "schema_version": SCHEMA_VERSION,
        "messages": messages,
    }
    _write_json(out, payload)
    _log(f"Done. {len(messages)} message(s) written.")
    result = {
        "ok": True,
        "chat": payload["chat"],
        "out": str(out),
        "media_dir": str(media_dir),
        "message_count": len(messages),
        "carried_over": carried_over,
        "media": media_counts,
    }
    if reach is not None:
        result["reach"] = reach
    return result



# ── The WAHA bridge ─────────────────────────────────────────────────────────
#
# A connection declaring `"engine": "waha"` is driven through a self-hosted
# WAHA instance over HTTP. The verb surface is identical; only what answers it
# differs.


def _session_facts(config):
    """The cheapest authenticated round-trip: the session object + engine."""
    session = config["session"]
    result = make_request(f"/api/sessions/{session}", config)
    me = result.get("me") or {}
    # GOWS doesn't carry the engine in the session object; it's at server/version.
    engine = _engine_str(result)
    if not engine:
        version = make_request("/api/server/version", config, soft=True)
        engine = _engine_str(version) if isinstance(version, dict) else None
    return {
        "session": session,
        "status": result.get("status", "UNKNOWN"),
        "me_id": me.get("id"),
        "me_name": me.get("pushName"),
        "engine": engine,
    }


# WAHA reports a linked, ready session as WORKING (the only "ready" status);
# a connected account shows up as a non-null `me`.
SESSION_READY = "WORKING"



def _waha_status(cfg, args=None):
    config = cfg
    facts = _session_facts(config)
    lines = []
    if config.get("profile"):
        lines.append(f"Profile:  {config['profile']} (mode: {config.get('mode')})")
    lines.append(f"Session:  {facts['session']}")
    lines.append(f"Status:   {facts['status']}")
    lines.append(f"Account:  {facts['me_name'] or '—'} ({facts['me_id'] or '—'})")
    lines.append(f"Engine:   {facts['engine'] or '—'}")
    return "\n".join(lines)


def _engine_str(version):
    """Pull the engine name from /api/server/version, tolerating the bare-string
    and nested {engine:{engine}} shapes WAHA has used."""
    eng = version.get("engine")
    if isinstance(eng, str):
        return eng
    if isinstance(eng, dict):
        return eng.get("engine")
    return None


def _waha_health(cfg, args=None):
    """Infrastructure-level readiness: is the WAHA instance operational and in the
    expected mode (engine, tier), with the active session linked to an account?
    A per-check report (windmill-style), all on the existing X-Api-Key."""
    config = cfg
    session = config["session"]

    # Hard gate: can we reach + authenticate to the instance at all? This maps
    # creds/unreachable to _refuse(2/5) before any per-check reporting.
    version = make_request("/api/server/version", config)
    version = version if isinstance(version, dict) else {}
    live_engine = _engine_str(version)
    tier = version.get("tier")
    expected_engine = config.get("expected_engine") or "GOWS"
    expected_tier = config.get("expected_tier")

    status_obj = make_request("/api/server/status", config, soft=True)
    uptime_ms = status_obj.get("uptime") if isinstance(status_obj, dict) else None

    # Active session: soft, so an absent/unlinked session is a failed check, not a die.
    sess = make_request(f"/api/sessions/{session}", config, soft=True)
    if isinstance(sess, dict):
        sess_status = sess.get("status", "UNKNOWN")
        me = sess.get("me") or {}
    else:
        sess_status = "ABSENT"
        me = {}
    me_id = me.get("id")
    me_name = me.get("pushName")

    engine_ok = bool(live_engine) and live_engine.upper() == expected_engine.upper()
    tier_ok = (expected_tier is None) or ((tier or "").upper() == expected_tier.upper())

    uptime_note = f", up {round(uptime_ms / 3600000, 1)}h" if uptime_ms else ""
    checks = [
        {"item": "server", "ok": True,
         "detail": f"version {version.get('version') or '?'}{uptime_note}"},
        {"item": "engine", "ok": engine_ok,
         "detail": (live_engine or "?") + ("" if engine_ok else f" (expected {expected_engine})")},
        {"item": "session", "ok": sess_status == SESSION_READY,
         "detail": f"{session}: {sess_status}"},
        {"item": "account", "ok": bool(me_id),
         "detail": f"{me_name or '?'} ({me_id})" if me_id else "not connected"},
    ]
    if expected_tier is not None:
        checks.insert(2, {"item": "tier", "ok": tier_ok,
                          "detail": (tier or "?") + ("" if tier_ok else f" (expected {expected_tier})")})
    elif tier:
        checks.insert(2, {"item": "tier", "ok": True, "detail": tier})

    ready = all(c["ok"] for c in checks)
    out = {
        "ready": ready,
        "base_url": config["base_url"],
        "engine": live_engine,
        "expected_engine": expected_engine,
        "tier": tier,
        "session": session,
        "status": sess_status,
        "account": {"id": me_id, "name": me_name},
        "checks": checks,
    }
    if config.get("profile"):
        out["profile"] = config["profile"]
        out["mode"] = config.get("mode")
    _emit(out)
    if not ready:
        failed = "; ".join(f"{c['item']}: {c['detail']}" for c in checks if not c["ok"])
        _refuse(2, "not_ready", "WAHA is not in the expected ready mode", failed)
    return None


def _waha_chats(cfg, args):
    config = cfg
    session = config["session"]
    data = make_request(f"/api/{session}/chats?limit=500", config)

    if not isinstance(data, list):
        msg = data.get("message", "unexpected response") if isinstance(data, dict) else str(data)
        _refuse(5, "unexpected_response", f"chats: {msg}")

    search = (args.search or "").lower()

    results = []
    for chat in data:
        cid = chat.get("id", {})
        serialized = cid.get("_serialized", "") if isinstance(cid, dict) else str(cid)
        name = chat.get("name", "") or ""
        # GOWS chat objects are {id, name, conversationTimestamp} — derive the
        # rest: isGroup from the id suffix, activity from conversationTimestamp.
        is_group = chat.get("isGroup", serialized.endswith("@g.us"))
        unread = chat.get("unreadCount", 0)
        ts = chat.get("conversationTimestamp") or chat.get("timestamp", 0)

        if search and search not in name.lower() and search not in serialized.lower():
            continue

        results.append({
            "id": serialized,
            "name": name,
            "group": is_group,
            "unread": unread,
            "last_activity": ts,
        })

    results.sort(key=lambda x: x["last_activity"], reverse=True)
    if args.limit:
        results = results[:args.limit]

    if getattr(args, "json", False):
        return results

    if not results:
        return "No chats found." + (f" (search: '{args.search}')" if args.search else "")

    lines = ["| # | Name | ID | Group | Unread | Last Activity |",
             "|---|------|-----|-------|--------|---------------|"]
    for i, r in enumerate(results, 1):
        group_str = "Yes" if r["group"] else "—"
        unread_str = str(r["unread"]) if r["unread"] else "—"
        last = format_dt(r["last_activity"])
        lines.append(f"| {i} | {r['name']} | `{r['id']}` | {group_str} | {unread_str} | {last} |")
    suffix = f" (filtered by '{args.search}')" if args.search else ""
    lines.append(f"\n{len(results)} chat(s) shown{suffix}")
    return "\n".join(lines)


def _waha_messages(cfg, args):
    config = cfg
    session = config["session"]
    chat_id = args.chat_id
    limit = args.limit

    # Validate inputs before any network call.
    from_ts = parse_date(args.from_date) if args.from_date else None
    to_ts = parse_date(args.to_date) + 86400 if args.to_date else None

    encoded_chat_id = urllib.parse.quote(chat_id, safe="")

    chat_name = None
    if "@c.us" in chat_id:
        chat_info = make_request(f"/api/{session}/contacts/{encoded_chat_id}",
                                 config, soft=True)
        if isinstance(chat_info, dict):
            chat_name = chat_info.get("name") or chat_info.get("pushname") or None

    url = f"/api/{session}/chats/{encoded_chat_id}/messages?limit={limit}"
    data = make_request(url, config)

    if not isinstance(data, list):
        msg = data.get("message", "unexpected response") if isinstance(data, dict) else str(data)
        _refuse(5, "unexpected_response", f"messages: {msg}")

    filtered = []
    for msg in data:
        ts = msg.get("timestamp", 0)
        if from_ts and ts < from_ts:
            continue
        if to_ts and ts >= to_ts:
            continue
        filtered.append(msg)

    filtered.sort(key=lambda m: m.get("timestamp", 0))
    is_group = "@g.us" in chat_id

    if getattr(args, "json", False):
        return filtered
    if not filtered:
        return "No messages found." if not (args.from_date or args.to_date) \
            else "No messages in the specified date range."
    if args.format == "table":
        return _render_messages_table(filtered, is_group, chat_name)
    return _render_messages_conversation(filtered, is_group, chat_name)


def _resolve_sender(msg, is_group, chat_name=None):
    if msg.get("fromMe"):
        return "You"

    data = msg.get("_data") or {}
    info = data.get("Info") or {}
    # Push name: GOWS exposes _data.Info.PushName; WEBJS used _data.notifyName.
    notify_name = info.get("PushName") or data.get("notifyName") or ""
    if notify_name:
        return notify_name

    if is_group:
        # GOWS: the sender is `participant` (top-level `from` is the group id).
        # WEBJS: `author`. Never fall back to `from` for groups — that's the group.
        return (msg.get("participant") or msg.get("author")
                or info.get("Sender") or "Group member")

    if chat_name:
        return chat_name

    return msg.get("from", "Contact")


def _render_messages_conversation(messages, is_group, chat_name=None):
    current_date = None
    lines = []

    for msg in messages:
        ts = msg.get("timestamp", 0)
        dt = ts_to_dt(ts)
        date_str = dt.strftime("%Y-%m-%d") if dt else "—"
        time_str = dt.strftime("%H:%M") if dt else "—"

        if date_str != current_date:
            current_date = date_str
            lines.append(f"\n── {date_str} ──\n")

        sender = _resolve_sender(msg, is_group, chat_name)
        body = msg.get("body", "") or ""
        msg_type = _msg_type(msg)

        if not body:
            placeholder = {
                "image": "[Image]",
                "video": "[Video]",
                "audio": "[Voice message]",
                "ptt": "[Voice message]",
                "document": "[Document]",
                "sticker": "[Sticker]",
                "location": "[Location]",
                "vcard": "[Contact card]",
                "ciphertext": "[Encrypted/pending]",
            }.get(msg_type)
            body = placeholder or (f"[{msg_type}]" if msg_type else "[Empty]")

        body_lines = body.split("\n")
        if len(body_lines) > 1:
            indent = " " * (len(time_str) + 2 + len(sender) + 2)
            body = body_lines[0] + "\n" + "\n".join(indent + line for line in body_lines[1:])

        lines.append(f"[{time_str}] {sender}: {body}")

    lines.append(f"\n--- {len(messages)} message(s) ---")
    return "\n".join(lines)


def _render_messages_table(messages, is_group, chat_name=None):
    lines = ["| # | Time | Sender | Type | Message |",
             "|---|------|--------|------|---------|"]

    for i, msg in enumerate(messages, 1):
        ts = msg.get("timestamp", 0)
        time_str = format_dt(ts)
        sender = _resolve_sender(msg, is_group, chat_name)
        body = (msg.get("body", "") or "")[:120].replace("\n", " ").replace("|", "\\|")
        msg_type = _msg_type(msg)
        if not body and msg_type:
            body = f"[{msg_type}]"
        lines.append(f"| {i} | {time_str} | {sender} | {msg_type} | {body} |")

    lines.append(f"\n{len(messages)} message(s)")
    return "\n".join(lines)


def _waha_contact(cfg, args):
    config = cfg
    session = config["session"]
    contact_id = urllib.parse.quote(args.contact_id, safe="")
    data = make_request(f"/api/{session}/contacts/{contact_id}", config)

    if not isinstance(data, dict):
        return data

    name = data.get("name") or data.get("pushname") or None
    number = data.get("number") or None
    cid = data.get("id", {})
    serialized = cid.get("_serialized", "") if isinstance(cid, dict) else str(cid)
    is_business = bool(data.get("isBusiness", False))
    is_blocked = bool(data.get("isBlocked", False))

    if getattr(args, "json", False):
        return {
            "id": serialized,
            "name": name,
            "number": number,
            "business": is_business,
            "blocked": is_blocked,
        }

    return "\n".join([
        f"Name:      {name or '—'}",
        f"Number:    {number or '—'}",
        f"ID:        {serialized}",
        f"Business:  {'Yes' if is_business else 'No'}",
        f"Blocked:   {'Yes' if is_blocked else 'No'}",
    ])


def _msg_type(msg):
    """Resolve canonical message type. GOWS leaves top-level `type` (and often
    _data.Info.MediaType) empty, so fall back to inferring from the media
    mimetype; WEBJS populated `type`/_data.type directly."""
    data = msg.get("_data") or {}
    explicit = (msg.get("type")
                or (data.get("Info") or {}).get("MediaType")
                or data.get("type"))
    if explicit:
        return explicit
    mime = ((msg.get("media") or {}).get("mimetype") or "").lower()
    if mime:
        major = mime.split("/", 1)[0]
        if major == "audio":
            return "ptt" if ("ogg" in mime or "opus" in mime) else "audio"
        return {"image": "image", "video": "video",
                "application": "document"}.get(major, "media")
    return "text"


def _msg_author(msg, is_group):
    """Sender id of a single message. For groups the real sender is in
    `participant` (GOWS) or _data.author (WEBJS); top-level `from` is the group id."""
    if msg.get("fromMe"):
        return None
    if is_group:
        # GOWS: top-level `participant`. WEBJS: _data.author (dict or str).
        participant = msg.get("participant")
        if participant:
            return participant
        author = msg.get("_data", {}).get("author")
        if isinstance(author, dict):
            return author.get("_serialized") or author.get("user")
        if isinstance(author, str):
            return author
        return (msg.get("_data", {}).get("Info", {}) or {}).get("Sender") or msg.get("author")
    return msg.get("from")


def _msg_author_name(msg, is_group, chat_name):
    data = msg.get("_data") or {}
    notify = (data.get("Info") or {}).get("PushName") or data.get("notifyName") or ""
    if notify:
        return notify
    if msg.get("fromMe"):
        return "You"
    if not is_group and chat_name:
        return chat_name
    return None


def _media_ext(mimetype, filename):
    if filename and "." in filename:
        return "." + filename.rsplit(".", 1)[-1].lower()
    return {
        "audio/ogg": ".ogg",
        "audio/ogg; codecs=opus": ".ogg",
        "audio/opus": ".opus",
        "audio/mpeg": ".mp3",
        "audio/mp4": ".m4a",
        "audio/webm": ".webm",
        "audio/wav": ".wav",
        "audio/flac": ".flac",
        "image/jpeg": ".jpg",
        "image/png": ".png",
        "image/webp": ".webp",
        "image/gif": ".gif",
        "video/mp4": ".mp4",
        "video/webm": ".webm",
        "video/quicktime": ".mov",
        "application/pdf": ".pdf",
    }.get((mimetype or "").lower(), ".bin")


def _safe_id_for_filename(message_id):
    """WAHA message IDs contain '@'. Strip to make a safe filename."""
    return message_id.replace("/", "_").replace("@", "_at_")


def _find_existing_media(media_dir, message_id):
    safe = _safe_id_for_filename(message_id)
    for p in media_dir.glob(f"{safe}.*"):
        if p.is_file():
            return p
    return None


def _slugify(text):
    """Kebab-case slug for a chat folder name (e.g. 'Project Team' →
    'project-team')."""
    return re.sub(r"[^a-z0-9]+", "-", (text or "").lower()).strip("-")[:60]


def _waha_send(cfg, args):
    """Hand the text to the bridge and report what it minted."""
    text = _require_text(args)
    chat_id = _normalize_chat_id(args.chat_id)
    data = api_request("POST", "/api/sendText", cfg, json_body={
        "session": cfg["session"], "chatId": chat_id, "text": text})
    minted = data.get("id") if isinstance(data, dict) else None
    if isinstance(minted, dict):
        minted = minted.get("_serialized") or minted.get("id")
    return {"ok": True, "connection": cfg["id"], "chat": chat_id,
            "message_id": minted, "length": len(text)}


def _wm_send(cfg, args):
    """Send one text message and report the id the account minted for it.

    The message goes out on a live session, so this opens one under the same
    lock every other connected verb takes. What comes back is the account's own
    id for the message, which is what a later read will carry: an answer that
    said only "sent" could not be joined to anything.

    The copy that lands in the store is not written here. A linked device sees
    its own outbound message the way it sees any other -- it arrives back on the
    wire -- so it is captured by the same path as everything else rather than by
    a second writer that would have to agree with it.
    """
    text = _require_text(args)
    chat_id = _normalize_chat_id(args.chat_id)
    engine = _engine()
    user, _, server = chat_id.partition("@")
    with _session(cfg) as session:
        try:
            response = session._client.send_message(
                engine["build_jid"](user, server), text)
        except Exception as exc:
            _refuse(5, "send_failed",
                 f"the message was not sent: {type(exc).__name__}: {exc}",
                 "the account must be reachable and the recipient must exist; "
                 "nothing was delivered")
        minted = getattr(response, "ID", None) or None
        stamp = _ts_seconds(getattr(response, "Timestamp", 0)) or 0
        session.drain(timeout=SEND_SETTLE, settle=SEND_SETTLE,
                      ceiling=SEND_SETTLE)
    return {"ok": True, "connection": cfg["id"], "chat": chat_id,
            "message_id": minted, "timestamp": stamp,
            "date": (datetime.datetime.fromtimestamp(stamp).isoformat()
                     if stamp else None),
            "length": len(text)}


def _waha_export(cfg, args):
    config = cfg
    session = config["session"]
    chat_id = args.chat_id
    is_group = "@g.us" in chat_id
    encoded_chat = urllib.parse.quote(chat_id, safe="")

    # Resolve a human-readable chat name first — used for the default slug and
    # the export header.
    chat_name = chat_id
    chats = make_request(f"/api/{session}/chats?limit=500", config, soft=True)
    if isinstance(chats, list):
        for c in chats:
            cid = c.get("id", {})
            serialized = cid.get("_serialized", "") if isinstance(cid, dict) else str(cid)
            if serialized == chat_id:
                chat_name = c.get("name") or chat_id
                break

    # Output path: explicit --out wins; otherwise default to the capability-local
    # store from config — <messages_dir>/<slug>/messages.json (relocate by setting
    # messages_dir on the connection in connections.json).
    if args.out:
        out = Path(args.out).expanduser().resolve()
    elif config.get("messages_dir"):
        slug = _slugify(chat_name) or _slugify(chat_id) or "chat"
        out = Path(config["messages_dir"]).expanduser().resolve() / slug / "messages.json"
    else:
        _refuse(6, "no_output_path",
             "no --out given and no messages_dir resolved",
             "pass --out PATH, or declare a connection in connections.json so the default store applies")
    out.parent.mkdir(parents=True, exist_ok=True)

    media_dir = (Path(args.media_dir).expanduser().resolve()
                 if args.media_dir else out.parent / "media")
    media_dir.mkdir(parents=True, exist_ok=True)

    download_kinds = set(VOICE_TYPES)
    if not args.no_photos:
        download_kinds.add("image")
    if not args.no_stickers:
        download_kinds.add("sticker")
    if args.videos:
        download_kinds.add("video")
    if args.documents:
        download_kinds.add("document")

    # Load prior export (preserve transcriptions, skip already-downloaded media)
    prior_messages_by_id = {}
    if out.exists():
        try:
            prior = json.loads(out.read_text())
            for m in prior.get("messages", []):
                if m.get("id"):
                    prior_messages_by_id[m["id"]] = m
        except Exception:
            pass

    _log(f"Exporting:    {chat_name}  ({chat_id})")
    _log(f"Output:       {out}")
    _log(f"Media dir:    {media_dir}")
    _log(f"Downloading:  {sorted(download_kinds)}")
    if prior_messages_by_id:
        prior_tx = sum(1 for m in prior_messages_by_id.values()
                       if isinstance(m.get("transcription"), dict)
                       and m["transcription"].get("text"))
        _log(f"Prior export: {len(prior_messages_by_id)} messages, "
             f"{prior_tx} transcription(s) preserved")

    # Paginate from newest to oldest. Stop when a page is fully composed of
    # already-seen IDs and the page returns less than page_size.
    all_messages = {}  # id -> raw msg
    seen_in_prior = set(prior_messages_by_id.keys())
    page = 0
    while True:
        if args.max_pages and page >= args.max_pages:
            _log(f"Reached --max-pages={args.max_pages}, stopping.")
            break
        offset = page * args.page_size
        path = (f"/api/{session}/chats/{encoded_chat}/messages"
                f"?limit={args.page_size}&offset={offset}&downloadMedia=true")
        batch = make_request(path, config, timeout=240, soft=True)
        if batch is None:
            _log(f"Page {page+1} (offset={offset}) failed; stopping.")
            break
        if not isinstance(batch, list) or not batch:
            _log(f"Page {page+1}: empty, stopping.")
            break

        new_ids = 0
        for m in batch:
            mid = m.get("id")
            if not mid:
                continue
            if mid not in all_messages:
                all_messages[mid] = m
                if mid not in seen_in_prior:
                    new_ids += 1

        _log(f"Page {page+1} (offset={offset}): fetched {len(batch)}, new {new_ids}")

        # Stop heuristic: short page means we hit the end of history.
        if len(batch) < args.page_size:
            break
        # Incremental stop: if every msg in this page was already in prior export,
        # we're past the cutoff — no need to keep paging.
        if prior_messages_by_id and new_ids == 0:
            _log("All messages in this page already in prior export; stopping.")
            break
        page += 1

    _log(f"Total messages collected: {len(all_messages)}")

    # Process each message into our schema, downloading media as needed
    processed = []
    dl_counts = {}
    dl_errors = 0
    sorted_msgs = sorted(all_messages.values(), key=lambda m: m.get("timestamp", 0))

    for raw in sorted_msgs:
        mid = raw["id"]
        ts = raw.get("timestamp", 0)
        kind = _msg_type(raw)
        body = raw.get("body") or None

        author_id = _msg_author(raw, is_group)
        author_name = _msg_author_name(raw, is_group, chat_name if not is_group else None)

        media_meta = raw.get("media") or {}
        has_media = bool(raw.get("hasMedia") or media_meta)

        prior = prior_messages_by_id.get(mid)
        entry = {
            "id": mid,
            "timestamp": ts,
            "date": (datetime.datetime.fromtimestamp(ts).isoformat() if ts else None),
            "from": {
                "id": author_id,
                "name": author_name,
                "from_me": bool(raw.get("fromMe")),
            },
            "type": kind,
            "text": body,
            "reply_to": raw.get("_data", {}).get("quotedStanzaID")
                        or raw.get("replyTo"),
            "media": None,
            "transcription": (prior or {}).get("transcription"),
        }

        if has_media:
            media_entry = {
                "filename": media_meta.get("filename"),
                "mimetype": media_meta.get("mimetype"),
            }
            if media_meta.get("error"):
                media_entry["fetch_error"] = (
                    media_meta["error"].get("details", "")[:200]
                    if isinstance(media_meta["error"], dict) else str(media_meta["error"])[:200]
                )

            if kind in download_kinds:
                existing = (Path(prior["media"]["file_path"])
                            if prior and prior.get("media", {}).get("file_path")
                               and Path(prior["media"]["file_path"]).exists()
                            else _find_existing_media(media_dir, mid))
                if existing:
                    media_entry["file_path"] = str(existing.resolve())
                elif media_meta.get("url"):
                    ext = _media_ext(media_meta.get("mimetype"), media_meta.get("filename"))
                    dest = media_dir / f"{_safe_id_for_filename(mid)}{ext}"
                    try:
                        download_media(media_meta["url"], config, dest)
                        media_entry["file_path"] = str(dest.resolve())
                        dl_counts[kind] = dl_counts.get(kind, 0) + 1
                    except HttpFailure as e:
                        media_entry["download_error"] = f"{e.code}: {e.message}"
                        dl_errors += 1
                    except Exception as e:
                        media_entry["download_error"] = repr(e)
                        dl_errors += 1
                # If no url and no existing, we can't fetch — leave fetch_error
            entry["media"] = media_entry

        processed.append(entry)

    # Preserve messages that exist in prior export but were not returned by this
    # API call. WAHA's store can rotate after restarts/re-auths; without this
    # merge the file would lose history every time the store thins.
    processed_ids = {p["id"] for p in processed}
    carried_over = 0
    for pid, prior_msg in prior_messages_by_id.items():
        if pid not in processed_ids:
            processed.append(prior_msg)
            carried_over += 1
    if carried_over:
        processed.sort(key=lambda m: m.get("timestamp", 0))
        _log(f"Carried over {carried_over} message(s) from prior export "
             f"not present in current API result.")

    payload = {
        "chat": {
            "id": chat_id,
            "name": chat_name,
            "type": "group" if is_group else "dm",
        },
        "exported_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "exported_via": "whatsapp (WAHA)",
        "message_count": len(processed),
        "media_dir": str(media_dir),
        "media_policy": {
            "voice_audio": True,
            "photos": not args.no_photos,
            "stickers": not args.no_stickers,
            "videos": args.videos,
            "documents": args.documents,
        },
        "schema_version": SCHEMA_VERSION,
        "messages": processed,
    }
    _write_json(out, payload)
    _log(f"Done. {len(processed)} messages written.")
    return {
        "ok": True,
        "chat": payload["chat"],
        "out": str(out),
        "media_dir": str(media_dir),
        "message_count": len(processed),
        "carried_over": carried_over,
        "new_downloads": dl_counts,
        "download_errors": dl_errors,
    }



# ── WAHA pairing ────────────────────────────────────────────────────────────


def _normalize_number(raw):
    """A WhatsApp number for request-code: country code + number, digits only
    (the `+`, spaces, and dashes are stripped — WAHA's examples take bare digits)."""
    digits = re.sub(r"\D", "", raw or "")
    if not (7 <= len(digits) <= 15):
        _refuse(6, "bad_number",
             f"phone number must be 7-15 digits incl. country code, got {raw!r}",
             "pass --number with the full international number (e.g. 15551234567), "
             "or set `number` on the connection in connections.json")
    return digits


# Bounded waits (seconds): drain a DELETE, startup to a pairable state, code-entry to linked.
_PAIR_DELETE_TIMEOUT = 30
_PAIR_READY_TIMEOUT = 90
_PAIR_LINK_TIMEOUT = 180


def _poll_session(config, want, timeout_s):
    """Poll GET /api/sessions/{name} until status is in `want`; _die on FAILED or
    timeout. Returns the session object once it reaches a wanted state."""
    session = config["session"]
    start = time.monotonic()
    last = None
    while time.monotonic() - start < timeout_s:
        sess = make_request(f"/api/sessions/{session}", config, soft=True)
        status = sess.get("status") if isinstance(sess, dict) else None
        if status != last:
            _log(f"  session {session}: {status or 'unreachable'}")
            last = status
        if isinstance(sess, dict) and status in want:
            return sess
        if status == "FAILED":
            _refuse(5, "session_failed", f"session '{session}' entered FAILED",
                 "re-run `whatsapp pair --recreate --yes`, or pair via the WAHA dashboard")
        time.sleep(2)
    _refuse(5, "pair_timeout",
         f"session '{session}' did not reach {sorted(want)} within {timeout_s}s",
         "retry, or pair via the WAHA dashboard")


def _waha_pair(cfg, args):
    """Onboard / link a session via the GOWS phone-number pairing code: pass a
    number, get an XXXX-XXXX code to enter in WhatsApp (Linked Devices) — no QR.
    Connection-level, available to any connection (you link before you can read)."""
    config = cfg
    session = config["session"]
    expected_engine = config.get("expected_engine") or "GOWS"
    number = _normalize_number(args.number or config.get("number") or "")

    existing = make_request(f"/api/sessions/{session}", config, soft=True)
    status = existing.get("status") if isinstance(existing, dict) else None
    me = (existing.get("me") or {}) if isinstance(existing, dict) else {}

    # Refuse to disrupt a live session unless explicitly re-linking.
    if status == "WORKING" and me.get("id") and not args.recreate:
        _refuse(6, "already_paired",
             f"session '{session}' is already WORKING ({me.get('id')})",
             "nothing to do — run `whatsapp doctor`; pass --recreate --yes to re-link")

    if args.recreate and existing is not None:
        if not args.yes:
            detail = f" (currently WORKING as {me.get('id')})" if me.get("id") else ""
            _refuse(6, "confirm_recreate",
                 f"--recreate will DELETE and re-link session '{session}'{detail}",
                 "re-run with --yes to confirm")
        _log(f"Deleting session '{session}' …")
        api_request("DELETE", f"/api/sessions/{session}", config, soft=True)
        # Wait until it's actually gone — DELETE is async; creating too soon races
        # it and the new session gets wiped (a 404 on the next start).
        start = time.monotonic()
        while time.monotonic() - start < _PAIR_DELETE_TIMEOUT:
            if make_request(f"/api/sessions/{session}", config, soft=True) is None:
                break
            time.sleep(1)
        existing, status = None, None

    # Bring the session into existence and start it.
    if existing is None:
        _log(f"Creating session '{session}' (start:true) …")
        api_request("POST", "/api/sessions", config,
                    json_body={"name": session, "start": True, "config": {}})
    elif status in ("STOPPED", "FAILED"):
        _log(f"Starting session '{session}' …")
        api_request("POST", f"/api/sessions/{session}/start", config, soft=True)

    _log("Waiting for the session to be ready to pair …")
    sess = _poll_session(config, {"SCAN_QR_CODE", "WORKING"}, _PAIR_READY_TIMEOUT)

    # Already linked (credentials persisted server-side) — nothing to pair.
    me = sess.get("me") or {}
    if sess.get("status") == "WORKING" and me.get("id"):
        _emit({"ok": True, "session": session, "status": "WORKING",
               "account": {"id": me.get("id"), "name": me.get("pushName")},
               "note": "session linked from existing credentials; no new code needed"})
        return None

    # Engine is the server default captured at session creation — assert, can't set.
    live_engine = _engine_str(sess)
    if not live_engine:
        live_engine = _engine_str(make_request("/api/server/version", config, soft=True) or {})
    if live_engine and live_engine.upper() != expected_engine.upper():
        _refuse(6, "engine_mismatch",
             f"session engine is {live_engine}, expected {expected_engine}",
             f"set WHATSAPP_DEFAULT_ENGINE={expected_engine} on the WAHA server, "
             "then re-run `whatsapp pair --recreate --yes`")

    if args.qr:
        qr = make_request(f"/api/{session}/auth/qr?format=raw", config, soft=True)
        value = qr.get("value") if isinstance(qr, dict) else None
        _emit({"ok": True, "session": session, "method": "qr", "qr_value": value,
               "instructions": "Render qr_value as a QR and scan it in WhatsApp → "
                               "Linked Devices → Link a Device (or scan in the WAHA dashboard)."})
        return None

    _log(f"Requesting a pairing code for +{number} …")
    resp = api_request("POST", f"/api/{session}/auth/request-code", config,
                       json_body={"phoneNumber": number})
    code = resp.get("code") if isinstance(resp, dict) else None
    if not code:
        _refuse(5, "no_code", "WAHA did not return a pairing code",
             "retry, or use --qr / the WAHA dashboard (pairing codes aren't always available)")

    instructions = ("On the phone for this number, in WhatsApp: Settings → Linked "
                    "Devices → Link a Device → 'Link with phone number instead' → "
                    "enter this code")
    _log(f"\n  Pairing code for +{number}:  {code}\n  {instructions}.\n")
    result = {"ok": True, "session": session, "method": "pairing_code",
              "number": number, "code": code, "instructions": f"{instructions}: {code}"}

    if not args.wait:
        result["next"] = "after entering it, run `whatsapp doctor` to confirm WORKING"
        _emit(result)
        return None

    _log("Waiting for the device to link (enter the code on the phone) …")
    sess = _poll_session(config, {"WORKING"}, _PAIR_LINK_TIMEOUT)
    me = sess.get("me") or {}
    result["status"] = "WORKING"
    result["account"] = {"id": me.get("id"), "name": me.get("pushName")}
    _emit(result)
    return None


def _load_deepgram_key():
    key, _, _ = _resolve_env_key("DEEPGRAM_API_KEY")
    if key:
        return key
    _refuse(2, "missing_deepgram_key",
         "DEEPGRAM_API_KEY not resolved",
         f"set it in the project .env(.local), {CREDENTIALS_ENV}, or the environment")


def _content_type_for(path):
    return {
        ".ogg": "audio/ogg",
        ".oga": "audio/ogg",
        ".opus": "audio/ogg",
        ".mp3": "audio/mpeg",
        ".m4a": "audio/mp4",
        ".wav": "audio/wav",
        ".webm": "audio/webm",
        ".flac": "audio/flac",
    }.get(path.suffix.lower(), "application/octet-stream")


def _deepgram_transcribe(audio_path, api_key, model):
    params = (
        f"model={model}&detect_language=true&smart_format=true"
        f"&punctuate=true&paragraphs=true"
    )
    url = f"https://api.deepgram.com/v1/listen?{params}"
    dg = _request(
        "POST", url,
        headers={
            "Authorization": f"Token {api_key}",
            "Content-Type": _content_type_for(audio_path),
        },
        content=audio_path.read_bytes(),
        timeout=300,
        service="Deepgram",
    )
    channels = dg.get("results", {}).get("channels", [])
    if not channels:
        raise RuntimeError(f"Deepgram returned no channels: {json.dumps(dg)[:500]}")
    alt = channels[0].get("alternatives", [{}])[0]
    text = (alt.get("paragraphs", {}) or {}).get("transcript") or alt.get("transcript") or ""

    return {
        "text": text.strip(),
        "language": channels[0].get("detected_language"),
        "confidence": alt.get("confidence"),
        "model": model,
        "provider": "deepgram",
        "transcribed_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    }


def _store_transcript(args, payload: dict, message_id: str, result: dict) -> None:
    """A transcription is enrichment: it belongs beside the message in the store
    as well as in the export that asked for it, so the next export carries it
    without paying for the work twice. A payload from another connection, or one
    served by the bridge, simply has nowhere to put it."""
    chat_id = (payload.get("chat") or {}).get("id")
    if not chat_id:
        return
    try:
        reg, _ = _connections_registry()
        cid, entry = _select_connection(reg, getattr(args, "connection", None))
        cfg, problem = _build_cfg(cid, entry, None)
    except SystemExit:
        return
    if problem or cfg["engine"] != ENGINE_INHOUSE:
        return
    if payload.get("connection") and payload["connection"] != cfg["id"]:
        return
    db = _open_store(cfg)
    try:
        _record_transcript(db, chat_id, message_id, result)
    finally:
        db.close()


def cmd_transcribe(args):
    api_key = _load_deepgram_key()
    p = Path(args.json_path).expanduser().resolve()
    if not p.exists():
        _refuse(3, "file_not_found", f"export JSON does not exist: {p}")
    try:
        payload = json.loads(p.read_text())
    except (json.JSONDecodeError, OSError) as e:
        _refuse(6, "bad_export_json", f"{p} is not valid export JSON: {e}",
             "re-run `whatsapp export` to regenerate it")
    if not isinstance(payload, dict):
        _refuse(6, "bad_export_json", f"{p} is not a messages.json object",
             "re-run `whatsapp export` to regenerate it")
    messages = payload.get("messages", [])

    to_do = []
    for idx, m in enumerate(messages):
        if m.get("type") not in VOICE_TYPES:
            continue
        file_path = (m.get("media") or {}).get("file_path")
        if not file_path:
            continue
        existing = m.get("transcription")
        if not args.force and isinstance(existing, dict) and existing.get("text"):
            continue
        to_do.append((idx, m, Path(file_path)))

    if not to_do:
        _log("Nothing to transcribe (use --force to re-run).")
        return {"ok": True, "transcribed": 0, "failed": 0, "file": str(p)}

    _log(f"Transcribing {len(to_do)} file(s) with Deepgram (model={args.model})...")
    failures = 0
    for n, (idx, m, ap) in enumerate(to_do, 1):
        if not ap.exists():
            _log(f"  [{n}/{len(to_do)}] SKIP missing file: {ap}")
            m["transcription"] = {"error": f"file not found: {ap}"}
            failures += 1
            continue
        size_kb = ap.stat().st_size // 1024
        _log(f"  [{n}/{len(to_do)}] id={m['id']}  {ap.name}  ({size_kb} KB)")
        try:
            result = _deepgram_transcribe(ap, api_key, args.model)
            m["transcription"] = result
            preview = (result["text"][:80] + "…") if len(result["text"]) > 80 else result["text"]
            _log(f"       → [{result.get('language')}] {preview}")
        except Exception as e:
            result = {"error": str(e)}
            m["transcription"] = result
            failures += 1
            _log(f"       → ERROR: {e}")
        _store_transcript(args, payload, m["id"], result)
        # Saved after every file, so an interruption costs one transcription
        # rather than all of them — and replaced whole, so it never costs the
        # export itself.
        _write_json(p, payload)

    _log(f"Done. {len(to_do) - failures}/{len(to_do)} transcribed. File: {p}")
    return {
        "ok": failures == 0,
        "transcribed": len(to_do) - failures,
        "failed": failures,
        "file": str(p),
    }



# ── Render ──────────────────────────────────────────────────────────────────


def _render_export(payload):
    """Convert an exported messages.json payload into a markdown
    conversation log. Returns the rendered string."""
    chat = payload.get("chat", {})
    chat_name = chat.get("name") or chat.get("id") or "Conversation"
    chat_type = chat.get("type") or "chat"
    exported_at = payload.get("exported_at", "")
    messages = payload.get("messages", [])

    lines = []
    header_meta = f"{chat_type}, {len(messages)} messages"
    if exported_at:
        header_meta += f" • exported {exported_at[:10]}"
    lines.append(f"# {chat_name}")
    lines.append(f"_{header_meta}_")
    lines.append("")

    current_date = None
    for m in messages:
        ts = m.get("timestamp", 0)
        dt = datetime.datetime.fromtimestamp(ts) if ts else None
        date_str = dt.strftime("%Y-%m-%d") if dt else "?"
        time_str = dt.strftime("%H:%M") if dt else "?"

        if date_str != current_date:
            current_date = date_str
            lines.append("")
            lines.append(f"## {date_str}")
            lines.append("")

        sender = m.get("from", {}).get("name") or m.get("from", {}).get("id") or "(unknown)"
        msg_type = m.get("type") or "text"
        text = (m.get("text") or "").strip()
        media = m.get("media") or {}
        tx = m.get("transcription") or {}

        if msg_type in VOICE_TYPES:
            if isinstance(tx, dict) and tx.get("text"):
                lang = tx.get("language") or "?"
                lines.append(f"[{time_str}] {sender}: [Voice, {lang}, transcribed]")
                for ln in tx["text"].splitlines():
                    lines.append(f"    > {ln}")
            elif isinstance(tx, dict) and tx.get("error"):
                lines.append(f"[{time_str}] {sender}: [Voice — transcription error: {tx['error']}]")
            else:
                lines.append(f"[{time_str}] {sender}: [Voice — not yet transcribed]")
        elif msg_type == "image":
            label = media.get("filename") or "image"
            lost = media.get("error") or media.get("fetch_error")
            note = f" ({str(lost)[:80]}…)" if lost else ""
            lines.append(f"[{time_str}] {sender}: [Image: {label}]{note}")
            if text:
                for ln in text.splitlines():
                    lines.append(f"    > {ln}")
        elif msg_type == "video":
            label = media.get("filename") or "video"
            lines.append(f"[{time_str}] {sender}: [Video: {label}]")
        elif msg_type == "document":
            label = media.get("filename") or "document"
            lines.append(f"[{time_str}] {sender}: [Document: {label}]")
        elif msg_type == "sticker":
            lines.append(f"[{time_str}] {sender}: [Sticker]")
        elif msg_type in ("gp2", "e2e_notification", "notification_template"):
            label = text or msg_type
            lines.append(f"[{time_str}] _system: {label}_")
        elif text:
            text_lines = text.splitlines()
            lines.append(f"[{time_str}] {sender}: {text_lines[0]}")
            indent = " " * (len(time_str) + 2 + len(sender) + 2)
            for ln in text_lines[1:]:
                lines.append(f"{indent}{ln}")
        else:
            lines.append(f"[{time_str}] {sender}: [{msg_type}]")

    return "\n".join(lines) + "\n"


def cmd_render(args):
    p = Path(args.json_path).expanduser().resolve()
    if not p.exists():
        _refuse(3, "file_not_found", f"export JSON does not exist: {p}")
    try:
        payload = json.loads(p.read_text())
    except (json.JSONDecodeError, OSError) as e:
        _refuse(6, "bad_export_json", f"{p} is not valid export JSON: {e}",
             "re-run `whatsapp export` to regenerate it")
    if not isinstance(payload, dict):
        _refuse(6, "bad_export_json", f"{p} is not a messages.json object",
             "re-run `whatsapp export` to regenerate it")
    rendered = _render_export(payload)
    if args.out:
        out = Path(args.out).expanduser().resolve()
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(rendered)
        _log(f"Wrote {out}")
        return None
    return rendered



# ── Dispatch ────────────────────────────────────────────────────────────────
#
# One verb surface, two engines behind it. Which one a connection runs is the
# connection's declaration, so a consumer never learns that the answer came from
# a bridge rather than from the engine this CLI carries.


def cmd_help(_args):
    return (__doc__ or "").strip()


def cmd_contract(_args=None) -> dict:
    """A valid example of the message envelope every read emits — the shape,
    not live data.

    Built by `_envelope`, the same function the reads and the export go through,
    so the published shape cannot drift from what they actually produce. No
    account, no store, and no network."""
    example = {
        "chat_id": "<group-id>@g.us", "id": "3A0000000000000000EX",
        "sender": "15551234567@s.whatsapp.net", "sender_lid": "100000000000000@lid",
        "from_me": 0, "ts": 1780000000, "kind": "audioMessage",
        "text": None, "push_name": "<PERSON>", "quoted_id": "3A0000000000000000QT",
        "mimetype": "audio/ogg; codecs=opus", "seconds": 12, "is_voice": 1,
        "file_name": None, "file_length": 24576,
        "media_path": "<state>/whatsapp/<connection>/media/3A0000000000000000EX.ogg",
        "media_state": "fetched", "media_error": None,
        "transcript": "the spoken words", "transcript_language": "en",
        "transcript_confidence": 0.98, "transcript_model": "nova-3",
        "transcript_provider": "deepgram",
        "transcript_at": "2026-01-01T00:00:00+00:00", "transcript_error": None,
    }
    index = {"100000000000000@lid": {"name": "<PERSON>",
                                     "jid": "15551234567@s.whatsapp.net"}}
    message = _envelope(example, "<CHAT NAME>", True, index)
    return {
        "schema_version": SCHEMA_VERSION,
        "message": message,
        "emitted_by": [f"{NAME} messages <chat> --json",
                       f"the \"messages\" array of {NAME} export <chat>"],
        "notes": {
            "from.id": "the addressable identity, phone form where one is known",
            "from.lid": "the privacy-preserving form, when the wire carried one",
            "media.state": "fetched | expired | error | unfetchable | absent | "
                           "missing — expired is final, the ciphertext has left "
                           "WhatsApp's content network",
            "transcription": "present with text, or with error, or absent",
        },
    }


# What each engine can be asked for. A flag the answering engine cannot honour
# is refused rather than ignored: a caller that asked for a window and silently
# got whatever the other engine does would be misled about what it received.
_ENGINE_ONLY_FLAGS = {
    ENGINE_INHOUSE: {
        "fresh": "--fresh", "rounds": "--rounds", "days": "--days",
        "full": "--full", "hold": "--hold",
    },
    ENGINE_WAHA: {
        "page_size": "--page-size", "max_pages": "--max-pages", "wait": "--wait",
    },
}
# Flags every engine reads, even though they sit in a per-engine group for one
# verb — `export` takes a window only on the in-house engine.
_INHOUSE_ONLY_EXPORT = {"limit": "--limit", "from_date": "--from",
                        "to_date": "--to"}


def _refuse_foreign_flags(cfg: dict, args, extra: dict | None = None) -> None:
    """Refuse a flag the selected engine has no meaning for."""
    engine = cfg["engine"]
    foreign = dict(_ENGINE_ONLY_FLAGS[ENGINE_WAHA if engine == ENGINE_INHOUSE
                                      else ENGINE_INHOUSE])
    if extra and engine == ENGINE_WAHA:
        foreign.update(extra)
    given = [name for dest, name in foreign.items()
             if getattr(args, dest, None) not in (None, False)]
    if given:
        _refuse(6, "flag_not_supported",
             f"connection {cfg['id']!r} runs the {engine} engine, which does not "
             f"take {', '.join(sorted(given))}",
             f"drop the flag, or select a connection running the other engine "
             f"with --connection")


def _waha_check_connection(cfg: dict) -> dict:
    """The bridge's readiness, reported rather than raised, so `doctor` can
    answer for every connection instead of stopping at the first."""
    version = make_request("/api/server/version", cfg, soft=True)
    if not isinstance(version, dict):
        return {"ok": False, "category": 5, "engine": cfg["engine"],
                "base_url": cfg["base_url"],
                "error": f"{cfg['base_url']} did not answer",
                "hint": "check the instance is up and the API key resolves"}
    session = make_request(f"/api/sessions/{cfg['session']}", cfg, soft=True)
    status = session.get("status", "UNKNOWN") if isinstance(session, dict) else "ABSENT"
    me = (session.get("me") or {}) if isinstance(session, dict) else {}
    ready = status == SESSION_READY and bool(me.get("id"))
    result = {"ok": ready, "engine": cfg["engine"], "base_url": cfg["base_url"],
              "session": cfg["session"], "status": status,
              "account": {"id": me.get("id"), "name": me.get("pushName")},
              "waha_engine": _engine_str(version)}
    if not ready:
        result.update(category=2,
                      error=f"session {cfg['session']!r} is {status}, not linked",
                      hint="pair the session in the WAHA dashboard, then retry")
    return result


def cmd_doctor(args):
    """Readiness, per connection: credentials resolve through the cascade, then
    the engine's own chain proves the session and the identity behind it."""
    _doctor_gate(_connections_report(), getattr(args, "connection", None))
    reg, _ = _connections_registry()
    wanted = getattr(args, "connection", None)
    if wanted:
        targets = [_select_connection(reg, wanted)]
    else:
        targets = list(reg["connections"].items())
    connections: dict = {}
    fail_exit = 0
    for cid, entry in targets:
        cfg, problem = _build_cfg(cid, entry, getattr(args, "session", None))
        if problem:
            result = {"ok": False, "category": problem["exit"],
                      "error": problem["message"]}
            if problem.get("hint"):
                result["hint"] = problem["hint"]
        elif cfg["engine"] == ENGINE_WAHA:
            result = _waha_check_connection(cfg)
        else:
            result = _wm_check_connection(cfg)
        result.setdefault("mode", (cfg or {}).get("mode"))
        if not result.get("ok") and not fail_exit:
            fail_exit = result.get("category") or 5
        # The kind of each failure stays on its own connection: a report that
        # kept only the first one would leave every other failure unclassified.
        connections[cid] = result
    _emit({"ok": fail_exit == 0, "connections": connections})
    if fail_exit:
        sys.exit(fail_exit)
    return None


def cmd_status(args):
    cfg = get_config(args)
    return _waha_status(cfg) if cfg["engine"] == ENGINE_WAHA else _wm_status(cfg)


def cmd_health(args):
    cfg = get_config(args)
    return _waha_health(cfg) if cfg["engine"] == ENGINE_WAHA else _wm_health(cfg)


def cmd_pair(args):
    cfg = get_config(args)
    _refuse_foreign_flags(cfg, args)
    return _waha_pair(cfg, args) if cfg["engine"] == ENGINE_WAHA else _wm_pair(cfg, args)


def cmd_chats(args):
    cfg = get_config(args)
    _refuse_foreign_flags(cfg, args)
    return _waha_chats(cfg, args) if cfg["engine"] == ENGINE_WAHA else _wm_chats(cfg, args)


def cmd_messages(args):
    cfg = get_config(args)
    _refuse_foreign_flags(cfg, args)
    return (_waha_messages(cfg, args) if cfg["engine"] == ENGINE_WAHA
            else _wm_messages(cfg, args))


def cmd_contact(args):
    cfg = get_config(args)
    _refuse_foreign_flags(cfg, args)
    return (_waha_contact(cfg, args) if cfg["engine"] == ENGINE_WAHA
            else _wm_contact(cfg, args))


def cmd_export(args):
    cfg = get_config(args)
    _refuse_foreign_flags(cfg, args, extra=_INHOUSE_ONLY_EXPORT)
    if cfg["engine"] == ENGINE_WAHA:
        args.page_size = args.page_size or PAGE_SIZE_DEFAULT
        return _waha_export(cfg, args)
    return _wm_export(cfg, args)


def cmd_send(args):
    cfg = get_config(args)
    _refuse_foreign_flags(cfg, args)
    return (_waha_send(cfg, args) if cfg["engine"] == ENGINE_WAHA
            else _wm_send(cfg, args))


# ── CLI ─────────────────────────────────────────────────────────────────────


def _selection_flags(parser, *, suppress: bool = False) -> None:
    """`--connection` / `--session` on the program and on every verb. A verb-side
    default of SUPPRESS leaves a value given before the verb standing."""
    default = argparse.SUPPRESS if suppress else None
    parser.add_argument(
        "--connection", "-c", dest="connection", default=default,
        help="connection id (default: the registry's \"default\" pointer, "
             "else the sole declared connection)")
    parser.add_argument(
        "--session", dest="session", default=default,
        help="override a WAHA connection's session name (no effect on the "
             "in-house engine, whose session is the linked device)")


def main():
    _gate()                      # every verb passes the effective policy gate first
    _contract(sys.argv[1:])      # contract verbs; domain verbs fall through
    parser = argparse.ArgumentParser(
        prog="whatsapp",
        description="WhatsApp CLI — link a device, keep its chats in a local "
                    "store, read, deepen, and export them.")
    _selection_flags(parser)

    sub = parser.add_subparsers(dest="command", required=True)

    def _sub(name: str, **kwargs):
        """Selection reads the same before or after the verb, so an agent never
        has to know where argparse wanted the flag."""
        created = sub.add_parser(name, **kwargs)
        _selection_flags(created, suppress=True)
        return created

    _sub("help", help="Print full usage block")
    _sub("contract", help="The message envelope every read emits, as an example")
    _sub("doctor", help="Readiness probe (engine, session, identity)")
    _sub("status", help="Human-readable account / session / store view")
    _sub("health", help="What the capture holds and what is missing")

    pp = _sub("pair", help="Link this machine as a companion device")
    pp.add_argument("--number", help="account phone number incl. country code "
                    "(default: the connection's `number`); digits, `+`/spaces stripped")
    pp.add_argument("--qr", action="store_true",
                    help="return the QR payload instead of requesting a pairing code")
    pp.add_argument("--days", type=int,
                    help="history window for the one-time pairing burst "
                         "(default: the connection's initial_sync_days)")
    pp.add_argument("--full", action="store_true",
                    help="ask for everything the phone still holds, not a window")
    pp.add_argument("--hold", type=int,
                    help="seconds to hold the connection open for the burst "
                         f"(default: {PAIR_HOLD_DEFAULT})")
    pp.add_argument("--wait", action="store_true",
                    help="WAHA connections: poll until the session is WORKING")
    pp.add_argument("--recreate", action="store_true",
                    help="discard the existing session and link again (requires --yes)")
    pp.add_argument("--yes", action="store_true", help="confirm a destructive --recreate")

    pc = _sub("chats", help="List chats held in the store")
    pc.add_argument("--search", "-s", help="filter chats by name (case-insensitive)")
    pc.add_argument("--limit", "-n", type=int, help="max chats to show")
    pc.add_argument("--fresh", action="store_true",
                    help="connect first, so the server's queue is drained before answering")
    pc.add_argument("--json", action="store_true", help="emit JSON instead of a table")

    pm = _sub("messages", help="Read a chat, reaching back when needed")
    pm.add_argument("chat_id", help="chat id (e.g. 15551234567@s.whatsapp.net "
                    "or <group-id>@g.us), or a bare number")
    pm.add_argument("--limit", "-n", type=int, default=50,
                    help="how many messages to return (default: 50)")
    pm.add_argument("--from", dest="from_date", help="start date (YYYY-MM-DD)")
    pm.add_argument("--to", dest="to_date", help="end date (YYYY-MM-DD)")
    pm.add_argument("--rounds", type=int,
                    help=f"cap on history requests when the store cannot cover the "
                         f"window (default: {DEFAULT_ROUNDS}; 0 answers from the "
                         f"store alone)")
    pm.add_argument("--fresh", action="store_true",
                    help="connect even when the store already covers the request")
    pm.add_argument("--format", "-f", choices=["conversation", "table"],
                    default="conversation", help="output format (default: conversation)")
    pm.add_argument("--json", action="store_true", help="emit the message envelopes as JSON")

    pk = _sub("contact", help="Show what is known about a contact")
    pk.add_argument("contact_id", help="contact id (e.g. 15551234567@s.whatsapp.net) "
                    "or a bare number")
    pk.add_argument("--fresh", action="store_true",
                    help="ask the engine to resolve an unknown identity")
    pk.add_argument("--json", action="store_true", help="emit JSON instead of a table")

    pe = _sub("export", help="Render a chat into messages.json + media/")
    pe.add_argument("chat_id", help="chat id (e.g. <group-id>@g.us)")
    pe.add_argument("--out", help="output JSON path (default: the connection's "
                    "messages_dir → <messages_dir>/<slug>/messages.json)")
    pe.add_argument("--media-dir", help="media output dir (default: <out>/../media)")
    pe.add_argument("--limit", "-n", type=int, help="cap on messages exported "
                    "(default: everything held for the chat)")
    pe.add_argument("--from", dest="from_date", help="start date (YYYY-MM-DD)")
    pe.add_argument("--to", dest="to_date", help="end date (YYYY-MM-DD)")
    pe.add_argument("--rounds", type=int,
                    help=f"cap on history requests when the store cannot cover the "
                         f"window (default: {DEFAULT_ROUNDS}; 0 exports the store alone)")
    pe.add_argument("--page-size", type=int,
                    help=f"WAHA connections: messages per page "
                         f"(default: {PAGE_SIZE_DEFAULT})")
    pe.add_argument("--max-pages", type=int,
                    help="WAHA connections: cap on pages fetched")
    pe.add_argument("--no-photos", action="store_true",
                    help="skip photo downloads (default: download photos)")
    pe.add_argument("--no-stickers", action="store_true",
                    help="skip sticker downloads (default: download stickers)")
    pe.add_argument("--videos", action="store_true", help="also download videos")
    pe.add_argument("--documents", action="store_true", help="also download documents")

    pt = _sub("transcribe",
                        help="Fill voice/audio transcription placeholders via Deepgram")
    pt.add_argument("json_path", help="path to a messages.json produced by `whatsapp export`")
    pt.add_argument("--force", action="store_true", help="re-transcribe even if already filled")
    pt.add_argument("--model", default="nova-3", help="Deepgram model (default: nova-3)")

    pr = _sub("render", help="Pretty-print an exported messages.json as markdown")
    pr.add_argument("json_path", help="path to a messages.json produced by `whatsapp export`")
    pr.add_argument("--out", help="write to a file instead of stdout")

    psend = _sub(
        "send", help="Send a text message (write-enabled connections only)")
    psend.add_argument("chat_id", nargs="?", help="recipient chat id")
    psend.add_argument("text", nargs="?", help="message text")

    args = parser.parse_args()

    # The standard write gate: a write verb refuses on a read-only connection,
    # after selection, before any credential resolves. Resolving the selected
    # connection's allow_write costs no network and no secret — it reads the
    # committed registry alone.
    if args.command in WRITE_VERBS:
        reg, _ = _connections_registry()
        cid, entry = _select_connection(reg, args.connection)
        allow_write = bool((entry or {}).get("allow_write", WRITE_DEFAULT))
        _write_gate(cid, allow_write, args.command)

    result = {
        "help": cmd_help,
        "contract": cmd_contract,
        "doctor": cmd_doctor,
        "status": cmd_status,
        "health": cmd_health,
        "pair": cmd_pair,
        "chats": cmd_chats,
        "messages": cmd_messages,
        "contact": cmd_contact,
        "export": cmd_export,
        "transcribe": cmd_transcribe,
        "render": cmd_render,
        "send": cmd_send,
    }[args.command](args)

    if result is not None:
        _emit(result)


def _run() -> NoReturn:
    """One exit for every path.

    The engine's blocking call runs on a thread it does not mark daemon, so an
    interpreter that reached normal shutdown with that thread still alive would
    wait on it for as long as it lived. Every path therefore ends here, and the
    process leaves once its output is flushed."""
    code = 0
    try:
        main()
    except _Refusal as refusal:
        try:
            _die(refusal.exit_code, refusal.code, refusal.message, refusal.hint)
        except SystemExit as exc:
            code = exc.code if isinstance(exc.code, int) else 1
    except SystemExit as exc:
        code = exc.code if isinstance(exc.code, int) else (0 if exc.code is None else 1)
    except BaseException as exc:
        # A bug, not a handled outcome — but it still leaves through the one
        # error envelope, so a caller never has to parse a traceback.
        traceback.print_exc()
        sys.stderr.write(json.dumps({"error": {
            "code": "unhandled", "message": f"{type(exc).__name__}: {exc}",
            "hint": "this is a defect in the capability; the traceback is above"}},
            ensure_ascii=False) + "\n")
        code = 1
    finally:
        for stream in (sys.stdout, sys.stderr):
            try:
                stream.flush()
            except Exception:
                pass
        os._exit(code)


if __name__ == "__main__":
    _run()
