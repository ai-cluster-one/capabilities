        _refuse(6, "flag_not_supported",
                f"connection {cfg['id']!r} runs the {cfg['engine']} engine, which "
                "keeps no legacy store to import",
                "import-legacy applies to in-house connections only")
    return _wm_import_legacy(cfg, args)


def cmd_profiles(args):
    """`profiles list` and `profiles import`, both on the harness runner."""
    if not _runner_importable():
        _rerun_with_runner(sys.argv[1:])
    root = _service_project_root()
    if args.profiles_command == "import":
        return _profiles_import(root, args.apply)
    if args.names:
        reached = {name: [] for name in args.names}
    else:
        reached = _settings_profiles(_service_settings())
    rows = [{**row, "positions": reached.get(row["name"]) or []}
            for row in _profile_rows(root, list(reached))]
    return {"ok": all(r.get("ok") for r in rows), "project": str(root),
            "profiles": rows}


def _profiles_import(root: Path, apply: bool) -> dict:
    """Carry the project's profile files into the store at its scope, all or
    none, then remove them; without `apply`, say what that would do."""
    profiles = _service_module("profiles")
    lib = profiles.runner()
    files = profiles.unimported(root)
    if not files:
        return {"project": str(root), "apply": apply, "files": [],
                "detail": f"no profile files in {profiles.project_folder(root)}"}
    project_id = _service_project_id(root)
    if apply:
        _read_only_gate(f"`{NAME} profiles import --apply`")
    setting = _store_setting(root)
    try:
        conn = connect(application_name=NAME, setting=setting, transaction=True)
    except DbError as exc:
        _store_refusal(exc)
    try:
        plan = profiles.import_plan(root, profiles.stored(conn, project_id, setting.schema),
                                    project_id)
        shown = [{k: v for k, v in row.items() if k != "spec"} for row in plan]
        refused = [row for row in plan if row["action"] == "refused"]
        if refused:
            _refuse(6, "profiles_import_refused",
                    "; ".join(f"{row['file']}: {row['error']}" for row in refused),
                    "nothing was saved; correct or remove the file named, then "
                    "import again")
        if not apply:
            return {"project": str(root), "project_id": project_id, "apply": False,
                    "files": shown,
                    "next": f"`{NAME} profiles import --apply` saves them at this "
                            "project's scope and removes the files"}
        conn.rollback()
        migrate(conn, lib.PROFILE_STORE_OWNER, lib.PROFILE_STORE_STEPS,
                major=lib.PROFILE_STORE_MAJOR, minor=lib.PROFILE_STORE_MINOR)
        try:
            saved = profiles.import_apply(conn, plan, project_id, schema=setting.schema,
                                          created_by=f"{NAME} profiles import")
            conn.commit()
        except ValueError as exc:
            conn.rollback()
            _refuse(6, "conflict", str(exc),
                    f"nothing was saved; run `{NAME} profiles import` again")
        except BaseException:
            conn.rollback()
            raise
    except DbError as exc:
        _store_refusal(exc)
    finally:
        conn.close()
    for row in plan:
        Path(row["file"]).unlink(missing_ok=True)
    return {"project": str(root), "project_id": project_id, "apply": True,
            "imported": saved, "removed": [row["file"] for row in plan]}


def _migrate_files_mover(action: str, mine: dict, answers: dict) -> dict:
    """`capabilities migrate`'s move of the project's profile files into the
    store at its scope, as `profiles import` moves them, leaving the files for
    the manager to archive and remove once the whole move is verified. A file
    the store already holds differently refuses the move, naming it."""
    root = _service_project_root()
    profiles = _service_module("profiles")
    files = profiles.unimported(root)
    if not files:
        return {"items": [], "files": [], **({"verified": True} if action == "verify"
                                             else {})}
    if not _runner_importable():
        _rerun_with_runner(sys.argv[1:])
    lib = profiles.runner()
    project_id = _service_project_id(root)
    setting = _store_setting(root)
    write = action == "write"
    try:
        conn = connect(application_name=NAME, setting=setting, transaction=True)
    except DbError as exc:
        _store_refusal(exc)
    try:
        plan = profiles.import_plan(root, profiles.stored(conn, project_id, setting.schema),
                                    project_id)
        refused = [f"{row['file']}: {row['error']}" for row in plan
                   if row["action"] == "refused"]
        if refused and action != "verify":
            _refuse(6, "profiles_import_refused", "; ".join(refused),
                    "nothing was saved; correct or remove the file named, then run "
                    "`capabilities migrate` again")
        if write:
            conn.rollback()
            migrate(conn, lib.PROFILE_STORE_OWNER, lib.PROFILE_STORE_STEPS,
                    major=lib.PROFILE_STORE_MAJOR, minor=lib.PROFILE_STORE_MINOR)
            try:
                profiles.import_apply(conn, plan, project_id, schema=setting.schema,
                                      created_by=f"migrate@{answers.get('_master') or ''}"
                                      .rstrip("@"))
                conn.commit()
            except ValueError as exc:
                conn.rollback()
                _refuse(6, "conflict", str(exc),
                        "nothing was saved; run `capabilities migrate` again")
            except BaseException:
                conn.rollback()
                raise
        else:
            conn.rollback()
    except DbError as exc:
        _store_refusal(exc)
    finally:
        conn.close()
    outcome = {"save": {"plan": "would_write", "write": "written",
                        "verify": "missing"}[action], "held": "held",
               "refused": "differs"}
    items = [{"kind": "profile", "name": row["name"], "file": row["file"],
              "outcome": outcome[row["action"]],
              **({"version": row["version"]} if row.get("version") else {})}
             for row in plan]
    report = {"items": items, "files": [str(p) for p in files]}
    if action == "verify":
        report["differences"] = [f"profile {item['name']}: {item['outcome']} ({item['file']})"
                                 for item in items if item["outcome"] != "held"]
        report["verified"] = not report["differences"]
    return report


def cmd_send(args):
    cfg = get_config(args)
    _refuse_foreign_flags(cfg, args, {"reply_to": "--reply-to",
                                      "mentions": "--mention",
                                      "typing": "--typing"})
    return (_waha_send(cfg, args) if cfg["engine"] == ENGINE_WAHA
            else _wm_send(cfg, args))


# ── The assistant service ───────────────────────────────────────────────────
#
# One long-running process per account holds the account's connection and
# captures what arrives, through the same Session, capture path, account check
# and store every verb uses. Its control files are machine-local, under the
# account's state home; what it captures goes only to the store.
#
# The service takes the account lock every connected verb takes and keeps it for
# its whole life, so a second client on the device is impossible by the same
# mechanism that already prevents one.

SERVICE_ENVIRONMENT_RE = re.compile(r"[a-z][a-z0-9_-]{0,31}", re.IGNORECASE)
SERVICE_RUNNER_EXEC_ENV = "WHATSAPP_SERVICE_RUNNER_EXEC"
SERVICE_OWNER_SCHEMA = "whatsapp.service-owner.v1"
SERVICE_HEALTH_SCHEMA = "whatsapp.service-health.v1"
SERVICE_NONCE_ENV = "WHATSAPP_SERVICE_LAUNCH_NONCE"
SERVICE_HEARTBEAT = 15.0          # how often a held connection republishes health
SERVICE_STALE_AFTER = 60.0        # health older than this from a live pid is stale
SERVICE_BACKOFF_START = 2.0       # first wait before reconnecting
SERVICE_BACKOFF_CEILING = 60.0    # the longest wait between attempts
SERVICE_STABLE_AFTER = 60.0       # a connection held this long resets the backoff
SERVICE_START_TIMEOUT = 60.0      # `start` waits this long for the daemon's proof
SERVICE_STOP_TIMEOUT = 40.0       # the engine is given ENGINE_STOP_TIMEOUT inside it
SERVICE_TICK = 0.5                # the sender's fallback poll; a queued row wakes it at once
SERVICE_STALL_DEFAULT = 120       # defaults.stall_seconds: no progress this long ends the listener
SERVICE_STALL_EXIT = 9            # how a listener leaves that stalled or could not stop in time
SERVICE_TERM_GRACE = 30.0         # a stop request is honoured within this, blocked or not
SERVICE_WATCH_EVERY = 1.0         # how often the watchdog looks at progress
SERVICE_TAKEOVER_GRACE = 15.0     # a stale holder's time to leave after SIGTERM, before SIGKILL
SERVICE_STALE_CONFIRM = 2.0       # a holder found stale is read again after this, once
SERVICE_STALL_SEAM_ENV = "WHATSAPP_SERVICE_STALL_SEAM"


def _json_file(path: Path):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return None


def _pid_alive(pid) -> bool:
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def _atomic_json(path: Path, value: dict) -> None:
    """Replace one user-only control file in one step."""
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    temporary = path.with_name(
        f".{path.name}.{os.getpid()}.{threading.get_ident()}.tmp")
    temporary.write_text(json.dumps(value, ensure_ascii=False, indent=2,
                                    sort_keys=True) + "\n")
    temporary.chmod(0o600)
    os.replace(temporary, path)


def _epoch_iso(value: float | None) -> str | None:
    if not value:
        return None
    return datetime.datetime.fromtimestamp(
        value, datetime.timezone.utc).isoformat(timespec="seconds")


def _service_paths(cfg: dict) -> dict[str, Path]:
    """The account's lock and the service's control files. They sit under the
    account's home, not the project's, because one account has one connection
    whichever project starts the service."""
    home = Path(cfg["home"]).expanduser()
    state = home / "service"
    return {"home": home, "lock": home / "lock", "state": state,
            "owner": state / "owner.json", "health": state / "health.json",
            "pid": state / "daemon.pid", "log": state / "daemon.log",
            "spool": state / "capture-spool.jsonl"}


def _service_owner(paths: dict[str, Path]) -> dict | None:
    """The owner record of a service that is alive, else None."""
    owner = _json_file(paths["owner"])
    if isinstance(owner, dict) and _pid_alive(owner.get("pid")):
        return owner
    return None


def _owner_stale_for(paths: dict[str, Path], owner: dict | None,
                     limit: float) -> float | None:
    """How long the account's live holder has published no health, when that
    is longer than `limit`; else None. Health published under another launch
    is none of this holder's, so its silence counts from its own start."""
    if not owner:
        return None
    health = _json_file(paths["health"])
    updated = None
    if isinstance(health, dict) and health.get("launch_nonce") == owner.get("launch_nonce"):
        updated = health.get("updated_epoch")
    if not isinstance(updated, (int, float)):
        with contextlib.suppress(OSError):
            updated = paths["owner"].stat().st_mtime
    if not isinstance(updated, (int, float)):
        return None
    age = time.time() - updated
    return age if age > limit else None


def _listener_process(pid) -> bool:
    """Whether a pid is a listener at all, asked of the process table, so an
    owner record whose pid now names something else is never signalled."""
    try:
        out = subprocess.run(["ps", "-o", "command=", "-p", str(int(pid))],
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, ValueError, subprocess.SubprocessError):
        return False
    return " service run" in out


def _try_flock(handle) -> bool:
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return False
    return True


def _account_lock_free(paths: dict[str, Path]) -> bool:
    """Whether nothing holds the account lock right now, asked by taking and
    releasing it at once."""
    paths["home"].mkdir(parents=True, exist_ok=True, mode=0o700)
    with paths["lock"].open("a+") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return False
        fcntl.flock(handle, fcntl.LOCK_UN)
    return True


def _service_bundle_dir() -> Path:
    here = Path(__file__).resolve()
    return here.parent.parent if here.parent.name == "bin" else here.parent


def _service_template(name: str = "settings.json") -> Path:
    return _service_bundle_dir() / "service" / "templates" / name


_SERVICE_MODULES: dict[str, object] = {}


def _service_module(name: str):
    """One of the bundle's service modules, loaded from beside this file. They
    import nothing of the CLI, so loading one costs nothing a verb would notice."""
    if name not in _SERVICE_MODULES:
        import importlib.util
        path = _service_bundle_dir() / "service" / f"{name}.py"
        spec = importlib.util.spec_from_file_location(f"whatsapp_service_{name}", path)
        if spec is None or spec.loader is None or not path.is_file():
            _refuse(3, "service_bundle_missing",
                    f"the bundled service module is missing: {path}",
                    f"reinstall {NAME} from a bundled source")
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        _SERVICE_MODULES[name] = module
    return _SERVICE_MODULES[name]


def _settings_merged(scope: str, document: dict) -> dict | None:
    """The settings the service would load once `document` is written at
    `scope`: the project's over the global one, key by key. None outside a
    project, where there is nothing to merge it into."""
    if _project_root() is None:
        return None
    other = "global" if scope == "project" else "project"
    try:
        held = {key: row["value"] for key, row in
                _records().resolve_scope(NAME, "setting", other).items()
                if key != "connection.default"}
    except StoreError as exc:
        return {"__error__": exc.message}
    return {**held, **document} if scope == "project" else {**document, **held}


def _settings_check(scope: str, document: dict) -> list:
    """What the assistant service's schema finds wrong with this project's
    settings once the contract's `settings` verb writes `document` at `scope`."""
    if scope not in ("project", "global"):
        return []
    merged = _settings_merged(scope, document)
    if merged is None:
        return []
    if "__error__" in merged:
        return [merged["__error__"]]
    try:
        _validate_service_settings(merged)
    except ValueError as exc:
        return [str(exc)]
    return []


def _service_schema():
    return _service_module("settings_schema")


class _CliFacade:
    """The CLI's own functions as the dialogue module reaches them: read live
    from this module, so the store, the outgoing queue and the records the
    dialogue uses are the ones every verb uses."""

    def __getattr__(self, name):
        try:
            return globals()[name]
        except KeyError:
            raise AttributeError(name) from None


def _service_project_root() -> Path:
    root = _project_root()
    if root is None:
        _refuse(6, "no_project", "not inside a project",
                f"run from a project, then `capabilities init` before "
                f"`{NAME} service init`")
    return root


def _require_service_envelope(root: Path) -> None:
    envelope = _project_capabilities_dir(root)
    if not ((envelope / "settings.json").is_file()
            or (envelope / "project.json").is_file()
            or (envelope.is_dir() and _project_id())):
        _refuse(6, "no_envelope", "no capabilities envelope in this project",
                f"run `capabilities init` first, then `{NAME} service init`")


def _service_settings() -> dict:
    """The service's settings records, without the registry's own default."""
    try:
        rows = _records().resolve(NAME, "setting")
    except StoreError as exc:
        _refuse(6, exc.slug, exc.message, exc.hint)
    return {key: row["value"] for key, row in rows.items()
            if key != "connection.default"}


def _validate_service_settings(data) -> dict:
    """The closed settings surface: an unknown key is refused, never ignored.
    The bundle's schema module owns the walk."""
    return _service_schema().validate_settings(data)


def _settings_send_rate(settings: dict) -> int:
    """The account's send rate: `defaults.send_rate`, else the deprecated
    top-level spelling, else the default."""
    settings = settings or {}
    rate = (settings.get("defaults") or {}).get("send_rate")
    if rate is None:
        rate = settings.get("send_rate")
    return int(rate or SEND_RATE_DEFAULT)


def _settings_stall_seconds(settings: dict) -> int:
    """How long the listener may make no progress: `defaults.stall_seconds`,
    else the default."""
    value = ((settings or {}).get("defaults") or {}).get("stall_seconds")
    return int(value or SERVICE_STALL_DEFAULT)


def _checked_service_settings() -> dict:
    data = _service_settings()
    if not data:
        _refuse(6, "service_not_initialized",
                f"the {NAME} assistant service is not initialized in this project",
                f"run `{NAME} service init` to seed its settings")
    try:
        return _validate_service_settings(data)
    except ValueError as exc:
        _refuse(6, "service_settings_invalid", str(exc),
                f"fix the {NAME} service settings record; unsupported keys are "
                "never ignored")


def _service_cfg(settings: dict, connection_flag: str | None) -> dict:
    """The connection the service runs: the flag, else the settings' own, else
    the registry's default. Only the engine this CLI carries can be held."""
    wanted = connection_flag or settings.get("connection") or None
    reg, _ = _connections_registry()
    cid, entry = _select_connection(reg, wanted)
    cfg, problem = _build_cfg(cid, entry)
    if problem:
        _refuse(problem["exit"], problem["code"], problem["message"],
                problem.get("hint"))
    if cfg["engine"] != ENGINE_INHOUSE:
        _refuse(6, "service_engine_unsupported",
                f"connection {cid!r} runs the {cfg['engine']} engine; the "
                f"assistant service holds the engine this CLI carries",
                "select an in-house connection")
    return cfg


# ── The dialogue's prerequisites ─────────────────────────────────────────────
#
# A dialogue turn runs on callva-harness-runner. The CLI does not carry the
# runner in its dependency header: every `send` and `messages` resolves that
# header, and the runner is large. A process that needs it - the listener when
# its settings admit anyone, and the `profiles` verbs - runs again under
# `uv run --with` the runner pinned in the bundle's profiles module; `start`
# and `doctor` ask `profiles list` that way when the runner is not in process.


def _runner_importable() -> bool:
    try:
        import callva.harness_runner  # noqa: F401
    except ImportError:
        return False
    return True


def _service_project_id(root: Path) -> str:
    """The id the register keys this project's rows by (CAPABILITIES_PROJECT_ID)."""
    state = _project_id_state_at(root)
    project_id = (state or {}).get("id")
    if not project_id:
        _refuse(6, "project_id_missing",
                "the dialogue keys what it answered by the project's id, and this "
                "project declares none",
                "run `capabilities init` so the project's id is recorded in its "
                ".env.local")
    return str(project_id)


def _stored_profile_versions(root: Path, project_id: str) -> list:
    """The active profile versions this project reaches, read from the
    project's database by the harness runner. Needs the runner in process."""
    setting = _store_setting(root)
    try:
        conn = connect(application_name=NAME, setting=setting, transaction=True)
    except DbError as exc:
        _store_refusal(exc)
    try:
        return _service_module("profiles").stored(conn, project_id, setting.schema)
    finally:
        conn.close()


def _profile_rows(root: Path, names: list[str]) -> list[dict]:
    """Each name's verdict, resolved from the store as the listener resolves
    it, and fitted. Needs the runner in process."""
    profiles = _service_module("profiles")
    problem = profiles.unimported_problem(root)
    if problem:
        return [{"name": n, "ok": False, "code": "profiles_not_imported",
                 "error": problem} for n in names]
    project_id = _service_project_id(root)
    return profiles.check(names, _stored_profile_versions(root, project_id), project_id)


def _profile_check(root: Path, names: list[str]) -> list[dict]:
    """Each profile name's verdict: resolved from the store - this project's
    version, the global one, the runner's shipped profiles, then the bundle's -
    and fitted. In-process where the runner is importable, else by asking
    `profiles list` of this CLI run again under the runner's pin."""
    if not names:
        return []
    if _runner_importable():
        return _profile_rows(root, names)
    uv = shutil.which("uv")
    if uv is None:
        return [{"name": n, "ok": False,
                 "error": "uv is not on PATH, so the harness runner cannot be "
                          "resolved to check the profile"} for n in names]
    command = [uv, "run", "--quiet", "--with", _service_module_pin(), "--script",
               str(Path(__file__).resolve()), "profiles", "list", *names]
    env = {**os.environ, SERVICE_RUNNER_EXEC_ENV: "1"}
    try:
        done = subprocess.run(command, capture_output=True, text=True, timeout=600,
                              cwd=str(root), env=env)
    except (OSError, subprocess.TimeoutExpired) as exc:
        detail = str(exc)
    else:
        try:
            return json.loads(done.stdout)["profiles"]
        except (ValueError, KeyError, TypeError):
            detail = (done.stderr or done.stdout).strip()[-400:] or f"exit {done.returncode}"
    return [{"name": n, "ok": False,
             "error": f"the profiles could not be checked: {detail}"} for n in names]


def _profile_layer_text(row: dict) -> str:
    """Where a resolved profile came from, as the doctor says it."""
    layer = row.get("layer")
    if layer in ("project", "global"):
        return f"the store, {layer} version {row.get('version')}"
    if layer == "shipped":
        return "the harness runner's shipped profiles"
    return f"the bundle, {row.get('path')}"


def _settings_profiles(settings: dict) -> dict:
    profiles = _service_module("profiles")
    return _service_schema().profile_names(
        settings, profiles.DEFAULT_PROFILE, profiles.DEFAULT_JOB_PROFILE)


def _require_profiles(root: Path, settings: dict) -> None:
    """Refuse settings whose profiles do not resolve or do not fit, naming the
    position, the profile and the problem."""
    problem = _service_module("profiles").unimported_problem(root)
    if problem:
        _refuse(6, "profiles_not_imported", problem,
                f"run `{NAME} profiles import` to see what it would save, then "
                "`--apply`")
    reached = _settings_profiles(settings)
    bad = [r for r in _profile_check(root, list(reached)) if not r.get("ok")]
    if bad:
        first = bad[0]
        _refuse(6, "service_profile_invalid",
                f"{', '.join(reached.get(first['name']) or [first['name']])}: "
                f"{first.get('error')}",
                "name a profile that resolves and fits; `whatsapp service doctor` "
                "lists every one the settings reach")


def _build_dialogue(cfg: dict, root: Path, settings: dict, paths: dict, *,
                    log=None, on_reload=None):
    """The listener's dialogue, its profiles resolved and fitted. Needs the
    runner in this process."""
    if not _runner_importable():
        raise ValueError("the dialogue needs callva-harness-runner in the "
                         "listener; restart the service to enable it")
    dialogue_module = _service_module("dialogue")
    profiles = _service_module("profiles")
    project_id = _service_project_id(root)
    db = _open_store(cfg)
    dialogue = dialogue_module.Dialogue(
        _CliFacade(), cfg=cfg, root=root, settings=settings, project_id=project_id,
        db=db, state_dir=paths["state"], profiles=profiles, log=log,
        on_reload=on_reload)
    try:
        dialogue.prepare()
    except ValueError:
        db.close()
        raise
    # The job runner has a store connection of its own: a job's claim waits
    # on rows another listener holds, and the capture must never wait with it.
    dialogue.jobs = _service_module("jobs").JobRunner(
        _CliFacade(), dialogue=dialogue, db=_open_store(cfg))
    return dialogue


def _rerun_with_runner(argv: list[str]) -> NoReturn:
    """Run this CLI again on `argv` with the harness runner beside its own
    dependencies. The launch nonce and everything else in the environment go
    with it."""
    if os.environ.get(SERVICE_RUNNER_EXEC_ENV):
        _refuse(5, "harness_library_missing",
                "this was started with the harness runner and still cannot "
                "import it", f"check that uv can resolve {_service_module_pin()}")
    uv = shutil.which("uv")
    if uv is None:
        _refuse(5, "harness_library_missing",
                "profiles and the dialogue run on callva-harness-runner, and uv is "
                "not on PATH to resolve it",
                "put uv on PATH, where the CLI's own shebang finds it")
    env = dict(os.environ)
    env[SERVICE_RUNNER_EXEC_ENV] = "1"
    command = [uv, "run", "--quiet", "--with", _service_module_pin(), "--script",
               str(Path(__file__).resolve()), *argv]
    sys.stdout.flush()
    sys.stderr.flush()
    os.execvpe(uv, command, env)


def _service_module_pin() -> str:
    """The runner pin, read from the profiles script's own header, so the
    listener and the script cannot run different runners."""
    text = (_service_bundle_dir() / "service" / "profiles.py").read_text()
    found = re.search(r'"(callva-harness-runner==[^"]+)"', text)
    return found.group(1) if found else "callva-harness-runner"


def _service_prepare(connection_flag: str | None) -> tuple[Path, dict, dict]:
    """Everything a start or a run checks before it touches the account."""
    root = _service_project_root()
    _require_service_envelope(root)
    settings = _checked_service_settings()
    cfg = _service_cfg(settings, connection_flag)
    _pin_store_setting(root)
    _require_linked(cfg)
    return root, settings, cfg


def _service_health(paths: dict[str, Path], running: bool) -> dict:
    raw = _json_file(paths["health"])
    health = dict(raw) if isinstance(raw, dict) else {}
    updated = health.get("updated_epoch")
    age = (time.time() - updated) if isinstance(updated, (int, float)) else None
    state = health.get("state") or ("unknown" if running else "stopped")
    if running and age is not None and age > SERVICE_STALE_AFTER:
        state = "stale"
    if not running and state not in ("logged_out", "failed"):
        state = "stopped"
    health["state"] = state
    health["age_seconds"] = round(age, 1) if age is not None else None
    return health


def _cmd_service_status(connection_flag: str | None) -> dict:
    root = _service_project_root()
    settings = _service_settings()
    cfg = _service_cfg(settings, connection_flag)
    paths = _service_paths(cfg)
    owner = _service_owner(paths)
    running = owner is not None
    health = _service_health(paths, running)
    if running and health.get("launch_nonce") != owner.get("launch_nonce"):
        silent = _owner_stale_for(paths, owner, SERVICE_STALE_AFTER)
        health = ({"state": "stale", "age_seconds": round(silent, 1)}
                  if silent is not None else {"state": "unknown", "age_seconds": None})
    started = health.get("started_epoch")
    return {
        "initialized": bool(settings),
        "running": running,
        "state": health["state"],
        "healthy": running and health["state"] == "healthy",
        "pid": owner.get("pid") if running else None,
        "connected": bool(health.get("connected")) if running else False,
        "uptime_seconds": (round(time.time() - started)
                           if running and isinstance(started, (int, float))
                           else None),
        "started_at": health.get("started_at") if running else None,
        "last_event_at": health.get("last_event_at"),
        "last_message_at": health.get("last_message_at"),
        "messages_captured": health.get("messages_captured"),
        "messages_sent": health.get("messages_sent"),
        "send_failures": health.get("send_failures"),
        "send_rate": (health.get("send_rate") if running
                      else _settings_send_rate(settings)),
        "dialogue": (health.get("dialogue") if running
                     else {"enabled": _service_schema().dialogue_configured(settings)}),
        "spool_depth": _spool_depth(paths["spool"]),
        "store_error": health.get("store_error") if running else None,
        "reconnects": health.get("reconnects"),
        "last_error": health.get("last_error"),
        "environment": health.get("environment") if running
                       else settings.get("environment"),
        "connection": cfg["id"],
        "account": cfg["account_key"],
        "project": str(root),
        "owner_project": owner.get("project_root") if running else None,
        "health_age_seconds": health.get("age_seconds"),
        "stale_after_seconds": SERVICE_STALE_AFTER,
        "progress_age_seconds": (health.get("progress_age_seconds")
                                 if running else None),
        "stall_seconds": _settings_stall_seconds(settings),
        "control_dir": str(paths["state"]),
        "log_file": str(paths["log"]),
    }


def _inventory(_network: bool) -> dict:
    """The assistant service's state on this machine, as `service status` reads
    it, and `service doctor`'s verdict without the store. A project that cannot
    select a connection has no service to be in any state, and says why rather
    than failing the whole report."""
    if _project_root() is None:
        return {"service": {"state": "not configured",
                            "detail": "not inside a project",
                            "ok": False, "problem": "not inside a project"}}
    import io
    try:
        with contextlib.redirect_stderr(io.StringIO()) as refused:
            status = _cmd_service_status(None)
    except _Refusal as refusal:
        return {"service": {"state": "not configured", "detail": refusal.message,
                            "ok": False, "problem": refusal.message}}
    except SystemExit:
        detail = _inventory_refusal(refused.getvalue())
        return {"service": {"state": "not configured", "detail": detail,
                            "ok": False, "problem": detail}}
    if status["running"]:
        return {"service": {"state": "running",
                            "detail": f"pid {status['pid']}, {status['state']}, "
                                      f"connection {status['connection']}",
                            **_inventory_verdict()}}
    return {"service": {"state": status["state"] if status["initialized"]
                        else "not initialized",
                        "detail": f"connection {status['connection']}",
                        **_inventory_verdict()}}


def _inventory_refusal(stderr: str) -> str:
    """The message a refused read left on stderr, as one line."""
    for line in reversed(stderr.strip().splitlines()):
        with contextlib.suppress(ValueError, KeyError, TypeError):
            return json.loads(line)["error"]["message"]
    return "the service status could not be read"


def _inventory_verdict() -> dict:
    """`service doctor`'s verdict from this machine alone, its first failing
    check named."""
    import io
    try:
        with contextlib.redirect_stderr(io.StringIO()) as refused:
            report, fail = _cmd_service_doctor(None, local=True)
    except _Refusal as refusal:
        return {"ok": False, "problem": f"{refusal.code}: {refusal.message}"}
    except SystemExit:
        return {"ok": False, "problem": _inventory_refusal(refused.getvalue())}
    if not fail:
        return {"ok": True}
    first = next(row for row in report["checks"] if not row["ok"])
    return {"ok": False,
            "problem": f"{first.get('code') or first['item']}: {first['detail']}"}


# The service's prose, seeded from the bundle's templates: the dialogue's
# context, what a turn is told about handing work to a job, and the whole of a
# job worker's prompt.
SERVICE_DOCUMENTS = ("context", "delegation", "job-worker")


def _seed_service_context(adapter) -> tuple[list[str], list[str]]:
    """Seed the service's prose where the project has none. It is the
    project's to write, so a document it holds is never overwritten, `--force`
    included. Answers what was written and what was left as it was."""
    written, kept = [], []
    for key in SERVICE_DOCUMENTS:
        template = _service_template(f"{key}.md")
        label = f"{adapter.source}:{NAME}/{key}"
        try:
            if adapter.document_read(NAME, key) is not None or not template.is_file():
                kept.append(label)
                continue
            adapter.document_put(NAME, key, template.read_text(),
                                 author=f"{NAME} service init")
        except StoreError as exc:
            _refuse(6, exc.slug, exc.message, exc.hint)
        written.append(label)
    return written, kept


def _cmd_service_init(connection_flag: str | None, force: bool) -> dict:
    root = _service_project_root()
    _require_service_envelope(root)
    template = _service_template()
    if not template.is_file():
        _refuse(3, "service_bundle_missing",
                f"the bundled settings template is missing: {template}",
                f"reinstall {NAME} from a bundled source")
    adapter = _records()
    existing = _service_settings()
    if existing and not force:
        try:
            _validate_service_settings(existing)
        except ValueError as exc:
            _refuse(6, "service_settings_invalid", str(exc),
                    f"fix the record, or reseed it with `{NAME} service init "
                    "--force`")
        seeded, kept = _seed_service_context(adapter)
        return {"initialized": NAME, "project": str(root), "written": seeded,
                "skipped": [f"{adapter.source}:{NAME}/settings", *kept],
                "settings": existing}
    settings = json.loads(template.read_text())
    if connection_flag:
        settings["connection"] = connection_flag
    try:
        _validate_service_settings(settings)
    except ValueError as exc:
        _refuse(6, "service_settings_invalid", str(exc))
    written = [f"{adapter.source}:{NAME}/settings"]
    skipped = []
    try:
        for key in set(existing) - set(settings):
            adapter.delete(NAME, "setting", key)
        for key, value in settings.items():
            adapter.set(NAME, "setting", key, value,
                        actor=f"{NAME} service init")
        seeded, kept = _seed_service_context(adapter)
        written += seeded
        skipped += kept
    except StoreError as exc:
        _refuse(6, exc.slug, exc.message, exc.hint)
    return {"initialized": NAME, "project": str(root),
            "written": written, "skipped": skipped,
            "settings": settings,
            "next": [f"run `{NAME} service doctor`, then `{NAME} service start`"]}


def _cmd_service_start(connection_flag: str | None) -> dict:
    root, settings, cfg = _service_prepare(connection_flag)
    if _service_schema().dialogue_configured(settings):
        _service_project_id(root)
        _require_profiles(root, settings)
    paths = _service_paths(cfg)
    owner = _service_owner(paths)
    stale = _owner_stale_for(paths, owner, _settings_stall_seconds(settings))
    if owner is not None and stale is None:
        _refuse(8, "service_running",
                f"the {NAME} assistant service already owns account "
                f"{cfg['account_key']} (pid {owner.get('pid')}, project "
                f"{owner.get('project_root')})",
                f"one service holds one account; `{NAME} service status` "
                "reports it")
    # A holder stale beyond stall_seconds is the listener's to take over;
    # anything else holding the lock is waited for.
    if owner is None and not _account_lock_free(paths):
        _refuse(8, "session_busy",
                f"another invocation holds the session for connection "
                f"{cfg['id']!r}",
                "wait for it to finish and start the service again")
    paths["state"].mkdir(parents=True, exist_ok=True, mode=0o700)
    nonce = uuid.uuid4().hex
    env = dict(os.environ)
    env[SERVICE_NONCE_ENV] = nonce
    command = [str(Path(__file__).resolve()), "service", "run",
               "--connection", cfg["id"]]
    with paths["log"].open("a", encoding="utf-8") as log:
        proc = subprocess.Popen(command, cwd=str(root), env=env,
                                stdin=subprocess.DEVNULL, stdout=log,
                                stderr=subprocess.STDOUT, start_new_session=True)
    deadline = time.monotonic() + SERVICE_START_TIMEOUT
    proven = None
    while time.monotonic() < deadline and proc.poll() is None:
        candidate = _service_owner(paths)
        if candidate and candidate.get("launch_nonce") == nonce:
            proven = candidate
            break
        time.sleep(0.2)
    if proven is None:
        if proc.poll() is None:
            with contextlib.suppress(ProcessLookupError):
                os.killpg(proc.pid, 15)
        tail = []
        if paths["log"].exists():
            tail = paths["log"].read_text(errors="replace").splitlines()[-8:]
        _refuse(5, "service_start_failed",
                (f"the service exited with {proc.returncode} before it held the "
                 "account" if proc.poll() is not None else
                 f"the service did not prove ownership within "
                 f"{SERVICE_START_TIMEOUT:g}s"),
                "\n".join(tail) or f"read `{NAME} service logs`")
    out = _cmd_service_status(cfg["id"])
    out["started"] = True
    if owner is not None:
        out["took_over_from"] = owner.get("pid")
    return out


def _cmd_service_run(connection_flag: str | None) -> None:
    root, settings, cfg = _service_prepare(connection_flag)
    dialogue = None
    paths = _service_paths(cfg)
    if _service_schema().dialogue_configured(settings):
        _service_project_id(root)
        if not _runner_importable():
            _rerun_with_runner(["service", "run", "--connection", cfg["id"]])
        try:
            dialogue = _build_dialogue(cfg, root, settings, paths)
        except ValueError as exc:
            _refuse(6, "service_profile_invalid", str(exc),
                    "name a profile that resolves and fits; `whatsapp service "
                    "doctor` lists every one the settings reach")
    daemon = _ServiceDaemon(cfg, root, settings,
                            launch_nonce=os.environ.get(SERVICE_NONCE_ENV)
                            or uuid.uuid4().hex, dialogue=dialogue)
    if dialogue is not None:
        dialogue.log = daemon.log
        dialogue.on_reload = daemon.reload_requested.set
    sys.exit(daemon.run())


def _running_owner(connection_flag: str | None) -> tuple[dict, dict, dict | None]:
    _service_project_root()
    cfg = _service_cfg(_service_settings(), connection_flag)
    paths = _service_paths(cfg)
    return cfg, paths, _service_owner(paths)


def _cmd_service_stop(connection_flag: str | None, timeout: float,
                      force: bool) -> dict:
    cfg, paths, owner = _running_owner(connection_flag)
    if owner is None:
        return {"stopped": False, "running": False, "connection": cfg["id"],
                "pid": None}
    pid = owner["pid"]
    try:
        os.kill(pid, 15)
    except ProcessLookupError:
        pass
    except PermissionError as exc:
        _refuse(6, "service_stop_failed", f"cannot signal the service {pid}: {exc}")
    deadline = time.monotonic() + max(0.0, timeout)
    while time.monotonic() < deadline:
        if not _pid_alive(pid):
            out = {"stopped": True, "running": False, "connection": cfg["id"],
                   "pid": pid, "lock_free": _account_lock_free(paths)}
            if paths["owner"].exists():
                out["warning"] = "the service left its owner record behind"
            return out
        time.sleep(0.2)
    if force:
        with contextlib.suppress(ProcessLookupError):
            os.kill(pid, 9)
        time.sleep(0.5)
        return {"stopped": True, "killed": True, "running": _pid_alive(pid),
                "connection": cfg["id"], "pid": pid}
    _refuse(5, "service_stop_timeout",
            f"the service did not stop within {timeout:g}s",
            f"retry with `{NAME} service stop --force`")


def _cmd_service_reload(connection_flag: str | None, timeout: float) -> dict:
    """Validate first, then ask the running listener to re-read. The signal goes
    to the listener alone, never to its process group."""
    _checked_service_settings()
    cfg, paths, owner = _running_owner(connection_flag)
    if owner is None:
        _refuse(5, "service_not_running",
                f"the {NAME} assistant service is not running for connection "
                f"{cfg['id']!r}", f"run `{NAME} service start`")
    pid = owner["pid"]
    before = _json_file(paths["health"]) or {}
    attempts = int(before.get("settings_reload_attempts") or 0)
    try:
        os.kill(pid, 1)
    except ProcessLookupError:
        _refuse(5, "service_not_running", "the service exited before the reload")
    deadline = time.monotonic() + max(0.0, timeout)
    while time.monotonic() < deadline:
        health = _json_file(paths["health"]) or {}
        if int(health.get("settings_reload_attempts") or 0) > attempts:
            if health.get("settings_reload_error"):
                _refuse(6, "service_reload_refused",
                        str(health["settings_reload_error"]),
                        "the previous settings remain active")
            return {"reloaded": True, "pid": pid, "connection": cfg["id"],
                    "settings_generation": health.get("settings_generation"),
                    "settings_reloaded_at": health.get("settings_reloaded_at"),
                    "environment": health.get("environment")}
        time.sleep(0.1)
    _refuse(5, "service_reload_timeout",
            f"the service did not acknowledge the reload within {timeout:g}s",
            f"read `{NAME} service logs`")


def _cmd_service_logs(connection_flag: str | None, tail: int) -> dict:
    _service_project_root()
    cfg = _service_cfg(_service_settings(), connection_flag)
    log = _service_paths(cfg)["log"]
    if not log.exists():
        _refuse(3, "logs_not_found", f"no service log yet: {log}",
                f"`{NAME} service start` writes it")
    lines = log.read_text(errors="replace").splitlines()
    return {"connection": cfg["id"], "log_file": str(log),
            "lines": lines[-max(0, tail):]}


# The harness tools a sign-in answers for.
_SIGN_IN_HARNESSES = ("claude", "codex")

# A job still to run: written, waiting, running, or stopped by a spent quota,
# which the runner resumes on its own.
_HARNESS_OPEN_JOBS = """
    SELECT id, profile FROM whatsapp_jobs
     WHERE project_id = %s AND environment = %s AND surface = 'whatsapp'
       AND (state IN ('draft', 'waiting', 'running')
            OR (state = 'stopped' AND outcome = 'quota'))
     ORDER BY created_at, id"""
_HARNESS_CHAT_PROFILES = """
    SELECT chat_id, overrides->>'profile' FROM whatsapp_register
     WHERE project_id = %s AND environment = %s AND overrides->>'profile' IS NOT NULL
     ORDER BY chat_id"""


def _configured_in_store(setting, project_id: str, environment: str) -> tuple[list, list]:
    """Every chat's `/set profile` and every open job of this project and
    environment, as (chat, profile) and (job id, profile or None) rows, read on
    one read-only connection. A table the store does not hold yet holds none.
    Writes nothing and migrates nothing."""
    try:
        conn = connect(application_name=NAME, setting=setting, transaction=True)
    except DbError as exc:
        _store_refusal(exc)
    found: list[list] = []
    try:
        conn.rollback()
        conn.read_only = True
        for sql in (_HARNESS_CHAT_PROFILES, _HARNESS_OPEN_JOBS):
            try:
                found.append(conn.execute(sql, (project_id, environment)).fetchall())
            except Exception as exc:
                if type(exc).__name__ != "UndefinedTable":
                    raise
                conn.rollback()
                found.append([])
    finally:
        with contextlib.suppress(Exception):
            conn.rollback()
        conn.close()
    return ([(str(row[0]), str(row[1])) for row in found[0]],
            [(str(row[0]), row[1] or None) for row in found[1]])


def _cmd_service_harness() -> dict:
    """The harness tools of every profile a turn is configured to run on now,
    for the sign-ins a node placing the service needs: each name the settings
    reach, every chat's `/set profile`, and the profile of every open job - a
    job naming none runs on the job default - each resolved and fitted as the
    listener resolves it, with no turn run. Settings that admit nobody run no
    dialogue and no job, so need none. Reads the store and writes nothing. A
    project that resolves no store runs no turn and needs none; a name that
    does not resolve or fit is `unresolved` and needs nothing."""
    root = _service_project_root()
    try:
        setting = resolve_setting(root)
    except DbError as exc:
        if exc.slug != "store_not_configured":
            _store_refusal(exc)
        return {"harness": [], "profiles": [], "unresolved": [], "store": "not_configured"}
    settings = _service_settings()
    if not _service_schema().dialogue_configured(settings):
        return {"harness": [], "profiles": [], "unresolved": [], "dialogue": False}
    project_id = _service_project_id(root)
    named: dict[str, dict] = {}

    def name(profile: str) -> dict:
        return named.setdefault(profile, {"profile": profile, "harness": None,
                                          "settings": [], "chats": [], "jobs": []})

    for profile, where in _settings_profiles(settings).items():
        name(profile)["settings"] = list(where)
    job_default = ((settings.get("defaults") or {}).get("job_profile")
                   or _service_module("profiles").DEFAULT_JOB_PROFILE)
    chats, jobs = _configured_in_store(setting, project_id,
                                       settings.get("environment") or "production")
    for chat, profile in chats:
        name(profile)["chats"].append(chat)
    for job_id, profile in jobs:
        name(profile or job_default)["jobs"].append(job_id)
    unresolved: list[str] = []
    for row in _profile_check(root, list(named)):
        one = named.get(row.get("name"))
        if one is None:
            continue
        if row.get("ok"):
            one["harness"] = row.get("harness")
            continue
        error = str(row.get("error") or "")
        if row.get("code") == "profiles_not_imported":
            _refuse(6, "profiles_not_imported", error,
                    f"run `{NAME} profiles import` to see what it would save, then "
                    "`--apply`")
        if error.startswith("the profiles could not be checked"):
            _refuse(5, "profiles_unreadable", error)
        unresolved.append(one["profile"])
        one["unresolved"] = error
    tools = {one["harness"] for one in named.values()} & set(_SIGN_IN_HARNESSES)
    return {"harness": sorted(tools), "profiles": list(named.values()),
            "unresolved": unresolved}


def _cmd_service_doctor(connection_flag: str | None,
                        local: bool = False) -> tuple[dict, int]:
    """The service's readiness without touching the account: settings, store,
    link, ownership. The listener holds the connection while it runs, so its
    own health is what proves the connection then. `local` leaves out every
    check that would leave this machine or change the account's state - the
    store, a profile check the runner cannot answer in process, and the probe
    of a free account lock, which takes the lock - and reads the link without
    creating the account's home, so `inventory` judges by the rest and writes
    nothing."""
    root = _service_project_root()
    checks: list[dict] = []
    warnings: list[str] = []
    fail = 0

    def check(item: str, ok: bool, detail: str, category: int = 0,
              code: str | None = None) -> None:
        nonlocal fail
        row = {"item": item, "ok": ok, "detail": detail}
        if code:
            row["code"] = code
        checks.append(row)
        if not ok and not fail:
            fail = category or 5

    settings = _service_settings()
    valid = False
    try:
        _validate_service_settings(settings)
        valid = bool(settings)
        notes = _service_schema().deprecations(settings)
        check("settings", bool(settings),
              ("valid" + (f" ({'; '.join(notes)})" if notes else ""))
              if settings else f"not initialized; run `{NAME} service init`",
              6, None if settings else "service_not_initialized")
    except ValueError as exc:
        check("settings", False, str(exc), 6, "service_settings_invalid")
    if valid and _service_schema().dialogue_configured(settings):
        try:
            project_id = _service_project_id(root)
            check("dialogue", True, f"answers admitted messages; register keyed by "
                  f"project {project_id}")
        except _Refusal as refusal:
            check("dialogue", False, refusal.message, refusal.exit_code, refusal.code)
        reached = _settings_profiles(settings)
        problem = _service_module("profiles").unimported_problem(root)
        if problem:
            check("profiles", False, problem, 6, "profiles_not_imported")
        for row in _profile_check(root, list(reached)) if not (local or problem) else []:
            where = ", ".join(reached.get(row["name"]) or [])
            check(f"profile {row['name']}", bool(row.get("ok")),
                  (f"{where}: {row.get('harness')} "
                   f"(model {row.get('model') or 'the harness default'}) from "
                   f"{_profile_layer_text(row)}") if row.get("ok")
                  else f"{where}: {row.get('error')}", 6,
                  None if row.get("ok") else "service_profile_invalid")
        voice = _service_schema().voice_scopes(settings)
        if voice and not _resolve_env_key("DEEPGRAM_API_KEY")[0]:
            warning = (f"no Deepgram key: DEEPGRAM_API_KEY is not set, so a voice "
                       f"note in {', '.join(voice)} is answered as a failed "
                       f"transcription; set the key, or voice_transcription "
                       f"\"off\" there")
            checks.append({"item": "voice transcription", "ok": True,
                           "warning": True, "detail": warning})
            warnings.append(warning)
        elif voice:
            check("voice transcription", True,
                  f"Deepgram key resolved; transcribed in {', '.join(voice)}")
        else:
            check("voice transcription", True, "off in every admitted chat")
    elif valid:
        check("dialogue", True, "off: the settings admit no chat, so the listener "
              "captures and sends and answers nothing")
    try:
        cfg = _service_cfg(settings if isinstance(settings, dict) else {},
                           connection_flag)
    except _Refusal as refusal:
        check("connection", False, refusal.message, refusal.exit_code,
              refusal.code)
        return {"ok": False, "project": str(root), "checks": checks}, fail
    check("connection", True, f"{cfg['id']} (account {cfg['account_key']})")
    try:
        if not local:
            db = _open_store(cfg)
            location = _store_location(db)
            db.close()
            check("store", True, location)
    except _Refusal as refusal:
        check("store", False, refusal.message, refusal.exit_code, refusal.code)
    account_id, _jid, _name = _session_account(
        cfg, Path(cfg["home"]).expanduser() / "session.db" if local else None)
    expected = cfg.get("expected_account_id")
    if account_id is None:
        check("link", False, f"no linked device; run `{NAME} pair`", 7,
              "not_linked")
    elif expected and account_id != expected:
        check("link", False, f"the session belongs to {account_id}, not the "
              f"bound {expected}", 2, "account_identity_mismatch")
    else:
        check("link", True, f"a device is linked for {account_id}")
    status = _cmd_service_status(cfg["id"])
    if status["state"] == "logged_out":
        check("ownership", False, "the device was removed from the account; "
              f"the service stopped reconnecting. Stop it, re-link with `{NAME} "
              "pair --recreate --yes`, and start it again", 7, "logged_out")
    elif status["running"] and status["state"] == "stale":
        check("ownership", False,
              f"pid {status['pid']} holds the account from "
              f"{status['owner_project']} but has published no health for "
              f"{status['health_age_seconds']:.0f}s (stale after "
              f"{SERVICE_STALE_AFTER:g}s): it is not making progress. A stalled "
              f"listener leaves on its own after stall_seconds "
              f"({status['stall_seconds']}s); `{NAME} service start` or `run` "
              "takes over a holder stale beyond it", 5, "service_stale")
    elif status["running"]:
        healthy = status["state"] == "healthy" and status["connected"]
        check("ownership", healthy,
              f"pid {status['pid']} holds the account from "
              f"{status['owner_project']}; {status['state']}, "
              f"{'connected' if status['connected'] else 'not connected'}"
              + (f"; last error: {status['last_error']}"
                 if status.get("last_error") and not healthy else ""),
              5, None if healthy else "service_unhealthy")
    elif not local:
        free = _account_lock_free(_service_paths(cfg))
        check("ownership", free,
              "not running; the account lock is free" if free else
              "not running, and another invocation holds the account lock",
              8, None if free else "session_busy")
    report = {"ok": not fail, "project": str(root), "service": status,
              "checks": checks}
    if warnings:
        report["warnings"] = warnings
    return report, fail


# ── The capture spool ───────────────────────────────────────────────────────
#
# The service acknowledges what WhatsApp hands it as it arrives, and WhatsApp
# does not hand it over again. A capture the store cannot take at that moment is
# therefore appended to a local file, in arrival order, and written into the
# store from there once the store answers. It holds an outage and nothing else:
# while it is not empty every new capture joins the back of it, so the store
# receives everything in the order it arrived, and it is empty again as soon as
# the store is.

SPOOL_RETRY = 5.0                 # how often a store that is down is tried again
_SPOOL_BYTES = ("media_key", "file_enc_sha256", "file_sha256")


def _spool_row(row: dict) -> dict:
    """A captured row as a line of JSON can carry it."""
    out = dict(row)
    for key in _SPOOL_BYTES:
        if out.get(key) is not None:
            out[key] = base64.b64encode(bytes(out[key])).decode("ascii")
    return out


def _unspool_row(row: dict) -> dict:
    out = dict(row)
    for key in _SPOOL_BYTES:
        if out.get(key) is not None:
            out[key] = base64.b64decode(out[key])
    return out


def _apply_spooled(db, home: Path, record: dict, data=None):
    """Write one capture into the store. Each kind is written so that writing
    it a second time adds nothing, which is what lets a replay that stopped
    halfway simply start again."""
    kind = record.get("kind")
    if kind == "live":
        return _write_live(db, _unspool_row(record["row"]))
    if kind == "history":
        if data is None:
            data = _engine()["history_proto"].HistorySync()
            data.ParseFromString((home / "raw" / record["raw_file"]).read_bytes())
        return _ingest_history(db, data, home, record["sync_type"],
                               raw_name=record["raw_file"])
    if kind == "delivery":
        _apply_delivery(db, record["outcome"])
        return None
    raise ValueError(f"unknown spooled capture kind {kind!r}")


def _error_line(exc: BaseException) -> str:
    detail = getattr(exc, "message", None) or str(exc)
    return f"{type(exc).__name__}: {(detail.strip().splitlines() or [''])[0]}"[:300]


def _spool_depth(path: Path) -> int:
    try:
        with path.open("rb") as handle:
            return sum(1 for line in handle if line.strip())
    except OSError:
        return 0


class _CaptureSpool:
    """The append-only buffer for captures the store could not take.

    The engine's thread captures and the service's own thread replays, so both
    go through one lock: a capture never lands between a replay's read of the
    file and its rewrite."""

    def __init__(self, path: Path, home: Path):
        self.path = Path(path)
        self.home = Path(home)
        self.rejected_path = self.path.with_name(self.path.stem + ".rejected.jsonl")
        self.lock = threading.RLock()
        self.store_error: str | None = None
        self._depth = _spool_depth(self.path)

    def depth(self) -> int:
        return self._depth

    def _write_line(self, path: Path, value) -> None:
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        line = json.dumps(value, ensure_ascii=False, sort_keys=True) + "\n"
        fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        try:
            os.write(fd, line.encode("utf-8"))
            os.fsync(fd)
        finally:
            os.close(fd)

    def capture(self, db, record: dict, *, data=None):
        """Write one capture into the store, or keep it here when the store
        cannot be reached or something kept here is still waiting. Answers what
        the write answered, or None when it was kept."""
        with self.lock:
            if self._depth == 0:
                try:
                    result = _apply_spooled(db, self.home, record, data)
                    self.store_error = None
                    return result
                except Exception as exc:
                    if not _store_outage(exc):
                        raise
                    self.store_error = _error_line(exc)
            self._write_line(self.path, {**record, "spooled_at": _iso_now()})
            self._depth += 1
            return None

    def _read(self) -> list:
        try:
            lines = self.path.read_bytes().splitlines()
        except FileNotFoundError:
            return []
        records = []
        for line in lines:
            if not line.strip():
                continue
            try:
                records.append(json.loads(line))
            except ValueError:
                # A line a crash cut short is not a capture anyone can write.
                records.append({"kind": "unreadable",
                                "line": line.decode("utf-8", "replace")})
        return records

    def _rewrite(self, records: list) -> None:
        if not records:
            with contextlib.suppress(FileNotFoundError):
                self.path.unlink()
            self._depth = 0
            return
        temporary = self.path.with_name(f".{self.path.name}.{os.getpid()}.tmp")
        with temporary.open("w", encoding="utf-8") as handle:
            for record in records:
                handle.write(json.dumps(record, ensure_ascii=False,
                                        sort_keys=True) + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        temporary.chmod(0o600)
        os.replace(temporary, self.path)
        self._depth = len(records)

    def replay(self, db) -> dict:
        """Write what is kept into the store, oldest first, until it is empty
        or the store stops answering. A capture the store refuses for what it
        is, rather than for being down, is set aside in the rejected file so it
        cannot hold back everything behind it."""
        with self.lock:
            records = self._read()
            consumed = written = rejected = 0
            try:
                for record in records:
                    try:
                        _apply_spooled(db, self.home, record)
                        written += 1
                    except Exception as exc:
                        if _store_outage(exc):
                            self.store_error = _error_line(exc)
                            break
                        self._write_line(self.rejected_path, {
                            **record, "rejected_at": _iso_now(),
                            "error": _error_line(exc)})
                        rejected += 1
                    consumed += 1
                else:
                    self.store_error = None
            finally:
                self._rewrite(records[consumed:])
            return {"written": written, "rejected": rejected, "left": self._depth}


class _ServiceDaemon:
    """The listener: hold one Session for as long as the wire stays up, rebuild
    it with backoff when it drops, stop for good when the device is removed.

    It never holds the account hostage. A heartbeat thread publishes health on
    its own schedule, whatever the engine and the dialogue are doing; a
    watchdog thread checks that the listener's loop keeps going round and that
    no engine handler runs for ever, and when either stops for longer than
    `stall_seconds` it writes every thread's stack to the log and leaves at
    once with exit 9, for its supervisor to restart. A stop request is honoured
    within a grace period even when the loop is blocked.

    `session_factory` and `sleep` are the seams a test drives it through; the
    process itself always builds the real Session."""

    def __init__(self, cfg: dict, root: Path, settings: dict, *,
                 launch_nonce: str, session_factory=None, dialogue=None):
        self.cfg = cfg
        self.root = root
        self.settings = settings
        self.nonce = launch_nonce
        self.paths = _service_paths(cfg)
        self.session_factory = session_factory or (lambda: Session(cfg))
        self.stop_requested = threading.Event()
        self.reload_requested = threading.Event()
        self.drop_requested = threading.Event()
        self.started = time.time()
        self.health: dict = {}
        self.reconnects = 0
        self.messages = 0
        self.attempts: list[float] = []
        self.stalled = False
        self.last_error: str | None = None
        self.spool = _CaptureSpool(self.paths["spool"], self.paths["home"])
        self.clock = time.monotonic
        self.sent_times: list[float] = []
        self.sent = 0
        self.send_failures = 0
        self.recovered = False
        # The account's outbox version, followed on the session's own store
        # connection: what another process queued wakes the sender.
        self.follower = None
        self.followed_at: float | None = None
        self.follow_reported = False
        self.next_store_attempt = 0.0
        # The dialogue, when the settings admit anyone; None leaves the
        # listener capturing and sending and answering nothing.
        self.dialogue = dialogue
        # Set by whatever wants the loop to look again at once: a queued
        # message, a stop, a reload, a forced drop.
        self.wake = threading.Event()
        # Liveness: where the loop last made progress, the session whose
        # handlers are watched, and what leaving looks like.
        self.health_lock = threading.Lock()
        self.progress_at = time.monotonic()
        self.progress_where = "starting"
        self.session = None
        self.stall_seconds = _settings_stall_seconds(settings)
        self.term_grace = SERVICE_TERM_GRACE
        self.term_timer: threading.Timer | None = None
        self.leaving = threading.Event()
        self.exit_lock = threading.Lock()
        self.hard_exit = os._exit
        self.backstop = True
        self.took_over: int | None = None

    # -- process plumbing ---------------------------------------------------

    def log(self, message: str) -> None:
        stamp = datetime.datetime.now(datetime.timezone.utc).isoformat(
            timespec="seconds")
        sys.stderr.write(f"{stamp} {message}\n")
        sys.stderr.flush()

    def request_stop(self) -> None:
        self.stop_requested.set()
        self.wake.set()

    def install_signals(self) -> None:
        import signal

        def flag(event):
            def handler(*_):
                event.set()
                self.wake.set()
            return handler
        signal.signal(signal.SIGTERM, flag(self.stop_requested))
        signal.signal(signal.SIGINT, flag(self.stop_requested))
        signal.signal(signal.SIGHUP, flag(self.reload_requested))
        # Drop the socket and go through the reconnect path: the forced
        # disconnect a reconnect is proven with.
        signal.signal(signal.SIGUSR1, flag(self.drop_requested))
        if os.environ.get(SERVICE_STALL_SEAM_ENV) == "1":
            # Block the loop for good, the way a lock never released would:
            # how the stall rule is exercised.
            signal.signal(signal.SIGUSR2, lambda *_: self.stall_seam())
        # The interpreter runs a handler only on the main thread, between two
        # of its steps, so a main thread that is blocked never runs one. The
        # signal itself writes to the wakeup descriptor, so a thread of its
        # own sees a stop request whatever the main thread is doing.
        read_fd, write_fd = os.pipe()
        os.set_blocking(write_fd, False)
        signal.set_wakeup_fd(write_fd, warn_on_full_buffer=False)
        threading.Thread(target=self.watch_signals, args=(read_fd,),
                         name="service-signals", daemon=True).start()

    def watch_signals(self, read_fd: int) -> None:
        import signal
        stops = {int(signal.SIGTERM), int(signal.SIGINT)}
        while True:
            try:
                data = os.read(read_fd, 64)
            except OSError:
                return
            if not data:
                return
            if stops & set(data):
                self.request_stop()
                self.honour_stop()

    def honour_stop(self) -> None:
        """Leave within the grace period of a stop request, however it is
        going: a listener asked to stop that cannot is as stuck as one that
        stalled."""
        if self.term_timer is not None:
            return
        timer = threading.Timer(self.term_grace, lambda: self.leave_stalled(
            f"the stop request was not honoured within {self.term_grace:g}s"))
        timer.daemon = True
        self.term_timer = timer
        timer.start()

    def stall_seam(self) -> None:
        self.log("stall seam: blocking the listener's loop on purpose")
        never = threading.Lock()
        never.acquire()
        never.acquire()

    # -- liveness -------------------------------------------------------------

    def beat(self, where: str) -> None:
        """The loop made progress, here."""
        self.progress_at = time.monotonic()
        self.progress_where = where

    def stalled_on(self) -> str | None:
        """What has made no progress for longer than `stall_seconds`, or None.
        The clock is the monotonic one, which stands still while the machine
        sleeps, so a sleep is never a stall."""
        now = time.monotonic()
        idle = now - self.progress_at
        if idle > self.stall_seconds:
            return (f"the listener's loop made no progress for {idle:.0f}s (last "
                    f"at: {self.progress_where})")
        inflight = getattr(self.session, "inflight", None) or {}
        for name, began in list(inflight.values()):
            if now - began > self.stall_seconds:
                return f"the engine handler {name} has run for {now - began:.0f}s"
        return None

    def watch_progress(self) -> None:
        import faulthandler
        while not self.leaving.wait(SERVICE_WATCH_EVERY):
            if self.backstop:
                # Should this thread itself never run again - the interpreter
                # held for good - the interpreter's own watchdog dumps and exits.
                faulthandler.dump_traceback_later(2 * self.stall_seconds, exit=True)
            stalled = self.stalled_on()
            if stalled:
                self.leave_stalled(stalled)
                return
        if self.backstop:
            faulthandler.cancel_dump_traceback_later()

    def heartbeat(self) -> None:
        """Publish health on a schedule of its own. The wall clock decides
        when, so the first look after the machine wakes publishes at once."""
        last = 0.0
        while not self.leaving.wait(1.0):
            if time.time() - last >= SERVICE_HEARTBEAT:
                last = time.time()
                with contextlib.suppress(Exception):
                    self.write_health(None, {}, timeout=5.0)

    def dump_stacks(self, reason: str) -> None:
        """Every thread's stack, into the daemon log and onto stderr, written
        straight to the descriptors so no lock a stuck thread holds is needed."""
        import faulthandler
        stamp = datetime.datetime.now(datetime.timezone.utc).isoformat(
            timespec="seconds")
        header = f"{stamp} stalled: {reason}; the stack of every thread follows\n"
        targets = [2]
        log_fd = None
        with contextlib.suppress(OSError):
            self.paths["state"].mkdir(parents=True, exist_ok=True, mode=0o700)
            log_fd = os.open(self.paths["log"],
                             os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
            mine, theirs = os.fstat(log_fd), None
            with contextlib.suppress(OSError):
                theirs = os.fstat(2)
            if theirs is None or (mine.st_dev, mine.st_ino) != (theirs.st_dev,
                                                                 theirs.st_ino):
                targets.append(log_fd)
        for fd in targets:
            with contextlib.suppress(Exception):
                os.write(fd, header.encode())
                faulthandler.dump_traceback(file=fd, all_threads=True)
        if log_fd is not None:
            os.close(log_fd)

    def leave_stalled(self, reason: str) -> None:
        """Leave now, for the supervisor to start a listener that works:
        stacks to the log, health marked stalled, exit 9. Nothing is released
        gracefully - a graceful release may wait on what is stuck - and the
        account lock goes with the process."""
        if not self.exit_lock.acquire(blocking=False):
            return
        if self.backstop:
            import faulthandler
            faulthandler.cancel_dump_traceback_later()
        self.dump_stacks(reason)
        with contextlib.suppress(Exception):
            self.write_health("stalled", {"connected": False, "last_error": reason,
                                          "stalled_at": _epoch_iso(time.time())},
                              timeout=1.0)
        envelope = {"error": {
            "code": "service_stalled", "message": reason,
            "hint": f"the listener left with exit {SERVICE_STALL_EXIT} to be "
                    "restarted; the stacks above say where it stood"}}
        with contextlib.suppress(OSError):
            os.write(2, (json.dumps(envelope, ensure_ascii=False) + "\n").encode())
        self.hard_exit(SERVICE_STALL_EXIT)

    def owner_record(self) -> dict:
        return {"schema": SERVICE_OWNER_SCHEMA, "launch_nonce": self.nonce,
                "pid": os.getpid(), "cli_path": str(Path(__file__).resolve()),
                "mode": ("development" if os.environ.get("CAPABILITIES_DEV_SESSION")
                         else "canonical"),
                "dev_session_id": os.environ.get("CAPABILITIES_DEV_SESSION"),
                "project_root": str(self.root), "connection": self.cfg["id"],
                "account": self.cfg["account_key"],
                "health_file": str(self.paths["health"]),
                "started_at": _epoch_iso(self.started)}

    def publish(self, state: str | None = None, **updates) -> None:
        dialogue = (self.dialogue.summary() if self.dialogue is not None
                    else {"enabled": False})
        self.write_health(state, {"dialogue": dialogue, **updates})

    def write_health(self, state: str | None, updates: dict, *,
                     timeout: float = -1) -> bool:
        """Write the health file. The heartbeat calls this alone, with nothing
        the engine or the dialogue holds, so health keeps its own time."""
        if not self.health_lock.acquire(timeout=timeout):
            return False
        try:
            now = time.time()
            self.health.update({
                "schema": SERVICE_HEALTH_SCHEMA, "pid": os.getpid(),
                "launch_nonce": self.nonce, "connection": self.cfg["id"],
                "account": self.cfg["account_key"],
                "environment": self.settings.get("environment"),
                "started_at": _epoch_iso(self.started), "started_epoch": self.started,
                "updated_at": _epoch_iso(now), "updated_epoch": now,
                "reconnects": self.reconnects, "messages_captured": self.messages,
                "messages_sent": self.sent, "send_failures": self.send_failures,
                "send_rate": self.send_rate(), "spool_depth": self.spool.depth(),
                "store_error": self.spool.store_error,
                "progress_age_seconds": round(time.monotonic() - self.progress_at, 1),
                "progress_at": self.progress_where,
                "stall_seconds": self.stall_seconds,
                "stale_after_seconds": SERVICE_STALE_AFTER, **updates})
            if state is not None:
                self.health["state"] = state
            _atomic_json(self.paths["health"], self.health)
            return True
        finally:
            self.health_lock.release()

    def wait(self, seconds: float) -> None:
        """Sleep that a stop request cuts short. Waiting is what the loop is
        meant to be doing, so it counts as progress."""
        deadline = time.monotonic() + seconds
        while not self.stop_requested.is_set():
            self.beat("waiting to reconnect")
            left = deadline - time.monotonic()
            if left <= 0:
                return
            self.stop_requested.wait(min(left, 1.0))

    def start_jobs(self) -> None:
        """Start the dialogue's job runner. It looks at the register on its own
        thread, whether or not the connection is up, so its leases are renewed
        through a reconnect and its results queue for the next connection."""
        jobs = getattr(self.dialogue, "jobs", None) if self.dialogue is not None else None
        if jobs is not None:
            jobs.start()
            self.log(f"job runner started (owner {jobs.owner_id}, at most "
                     f"{jobs.max_parallel()} at once, recovery {jobs.recovery()})")

    # -- settings -----------------------------------------------------------

    def apply_reload(self) -> None:
        self.reload_requested.clear()
        attempts = int(self.health.get("settings_reload_attempts") or 0) + 1
        try:
            data = _validate_service_settings(_service_settings())
            wanted = data.get("connection")
            if wanted and wanted != self.cfg["id"]:
                raise ValueError(
                    f"settings.connection {wanted!r} differs from the running "
                    f"{self.cfg['id']!r}; a connection change takes effect on "
                    "restart")
            if self.dialogue is not None:
                self.dialogue.update_settings(data)
            elif _service_schema().dialogue_configured(data):
                self.dialogue = _build_dialogue(self.cfg, self.root, data,
                                                self.paths, log=self.log,
                                                on_reload=self.reload_requested.set)
                self.start_jobs()
        except (ValueError, _Refusal) as exc:
            message = exc.message if isinstance(exc, _Refusal) else str(exc)
            self.log(f"reload refused: {message}")
            self.publish(settings_reload_attempts=attempts,
                         settings_reload_error=message)
            if self.dialogue is not None:
                self.dialogue.after_reload(message)
            return
        self.settings = data
        self.stall_seconds = _settings_stall_seconds(data)
        if self.dialogue is not None:
            self.dialogue.after_reload(None)
        generation = int(self.health.get("settings_generation") or 0) + 1
        self.log(f"settings reloaded (generation {generation})")
        self.publish(settings_reload_attempts=attempts, settings_reload_error=None,
                     settings_generation=generation,
                     settings_reloaded_at=_epoch_iso(time.time()))

    # -- the store and what is sent through it -------------------------------

    def send_rate(self) -> int:
        return _settings_send_rate(self.settings)

    def maintain_store(self, db) -> None:
        """Bring the store back into step: reconnect a dropped connection,
        write what the spool kept, and close out sends a previous run left
        unanswered. A store that is still down is tried again after a pause."""
        now = self.clock()
        waiting = self.spool.depth() or db.broken() or not self.recovered
        if not waiting or now < self.next_store_attempt:
            return
        before = self.spool.depth()
        try:
            if db.broken():
                db.reconnect()
            if before:
                result = self.spool.replay(db)
                if result["written"] or result["rejected"]:
                    self.log(f"spool replayed: {result['written']} written, "
                             f"{result['rejected']} rejected, {result['left']} left")
            if not self.spool.depth() and not self.recovered:
                interrupted = _recover_interrupted(db)
                self.recovered = True
                for local_id in interrupted:
                    self.log(f"send {local_id} was interrupted with its delivery "
                             f"unknown; failed as {DELIVERY_INTERRUPTED}, not resent")
        except Exception as exc:
            if not _store_outage(exc):
                raise
            self.spool.store_error = _error_line(exc)
        if self.spool.depth() or db.broken():
            self.next_store_attempt = now + SPOOL_RETRY
        if before or self.spool.depth():
            self.publish()

    def deliver_pending(self, session, db) -> int:
        """Send what is waiting for this account, oldest first, within the
        account's rate. Answers how many went out."""
        if self.spool.depth() or db.broken() or not self.recovered:
            return 0
        window = 60.0
        now = self.clock()
        self.sent_times = [t for t in self.sent_times if now - t < window]
        delivered = 0
        while len(self.sent_times) < self.send_rate() \
                and not self.stop_requested.is_set():
            try:
                row = _claim_outgoing(db)
            except Exception as exc:
                if not _store_outage(exc):
                    raise
                self.spool.store_error = _error_line(exc)
                break
            if row is None:
                break
            self.sent_times.append(self.clock())
            outcome = _deliver(session, row)
            # Through the spool, so an answer the store cannot take now is
            # written once it can, rather than leaving the row unanswered.
            self.spool.capture(db, {"kind": "delivery", "outcome": outcome})
            if outcome["state"] == "sent":
                self.sent += 1
                delivered += 1
                waited = ""
                with contextlib.suppress(Exception):
                    queued = datetime.datetime.fromisoformat(str(row["requested_at"]))
                    waited = (f", {1000 * (time.time() - queued.timestamp()):.0f} ms "
                              "after it was queued")
                self.log(f"sent {row['local_id']} as {outcome['message_id']}{waited}")
            else:
                self.send_failures += 1
                self.log(f"send {row['local_id']} failed: {outcome['error']}")
            self.publish()
        return delivered

    def follow_outbox(self, db) -> float:
        """Wake the sender when another process queued a message for this
        account: poll the account's `whatsapp_outbox` version on the session's
        own store connection, at most once every FOLLOW_INTERVAL_SECONDS, and
        answer how long until the next poll is due. A poll that fails is taken
        again at the next; the sender's tick stands behind it. Where the store
        names its two addresses apart, the loop's wait also listens for the
        version's notification, and a notified wait polls at once."""
        now = time.monotonic()
        if self.followed_at is not None \
                and now - self.followed_at < FOLLOW_INTERVAL_SECONDS:
            return FOLLOW_INTERVAL_SECONDS - (now - self.followed_at)
        self.followed_at = now
        if db.broken():
            return FOLLOW_INTERVAL_SECONDS
        try:
            if self.follower is None:
                self.follower = Follower([(OUTBOX_CHANNEL, db.account)],
                                         application_name=NAME, setting=db.setting)
            with db.write_lock:
                moved = self.follower.poll(db.conn)
        except Exception as exc:
            if not self.follow_reported:
                self.log(f"outbox versions unavailable ({_error_line(exc)}); "
                         "the sender polls")
                self.follow_reported = True
            return FOLLOW_INTERVAL_SECONDS
        self.follow_reported = False
        if moved:
            self.wake.set()
        return FOLLOW_INTERVAL_SECONDS

    # -- the connection -----------------------------------------------------

    def track(self, session) -> dict:
        captured = getattr(session, "live_messages", 0) or 0
        return {"last_event_at": _epoch_iso(getattr(session, "last_event_at", None))
                or self.health.get("last_event_at"),
                "last_message_at": _epoch_iso(getattr(session, "last_message_at", None))
                or self.health.get("last_message_at"),
                "session_messages": captured}

    def offer_live(self, message: dict) -> None:
        """Hand one live capture to the dialogue. Runs on the engine's thread,
        so nothing it raises may reach the engine."""
        dialogue = self.dialogue
        if dialogue is None:
            return
        try:
            dialogue.offer(message)
        except Exception as exc:
            self.log(f"dialogue: {message.get('chat_id')} #{message.get('id')} "
                     f"failed: {type(exc).__name__}: {exc}")

    def hold(self) -> str:
        """One session from open to drop. Answers why it ended: `stopped`,
        `logged_out`, `fatal` or `disconnected`."""
        session = None
        base = self.messages
        try:
            self.beat("opening a session")
            session = self.session_factory()
            self.session = session
            self.attempts.append(time.monotonic())
            session.spool = self.spool
            if self.dialogue is not None:
                self.dialogue.attach(session)
                session.on_live = self.offer_live
            db = getattr(session, "db", None)
            if db is not None:
                # What a previous run kept goes in before anything new arrives.
                self.next_store_attempt = 0.0
                self.maintain_store(db)
            session.open()
            deadline = time.monotonic() + CONNECT_TIMEOUT
            while not session.wait_connected(1.0):
                self.beat("connecting")
                if self.stop_requested.is_set():
                    return "stopped"
                if session._logged_out.is_set():
                    return "logged_out"
                if time.monotonic() >= deadline:
                    self.last_error = f"no connection within {CONNECT_TIMEOUT}s"
                    return "disconnected"
            session.require_account()
            # The offline queue drains by the act of connecting, through the
            # same handlers as everything live; nothing here waits for it.
            session.refresh_identities()
            self.log(f"connected as account {self.cfg['account_key']}")
            self.publish("healthy", connected=True, last_error=None,
                         connected_at=_epoch_iso(time.time()),
                         **self.track(session))
            drained_reported = False
            beat = time.monotonic()
            errors_seen = len(session.errors)
            while True:
                self.beat("holding the connection")
                if self.stop_requested.is_set():
                    return "stopped"
                if session._logged_out.is_set():
                    return "logged_out"
                if self.drop_requested.is_set():
                    self.drop_requested.clear()
                    self.last_error = "forced disconnect"
                    self.log("forced disconnect: dropping the socket")
                    with contextlib.suppress(Exception):
                        session._client.disconnect()
                    return "disconnected"
                if session._disconnected.is_set():
                    self.last_error = (f"connection dropped "
                                       f"({session.disconnect_reason})")
                    return "disconnected"
                if self.reload_requested.is_set():
                    self.apply_reload()
                if len(session.errors) > errors_seen:
                    for error in session.errors[errors_seen:]:
                        self.log(f"capture handler failed: {error}")
                    errors_seen = len(session.errors)
                    self.publish(last_error=session.errors[-1])
                self.messages = base + (session.live_messages or 0)
                if self.dialogue is not None:
                    try:
                        self.dialogue.tick(session)
                    except Exception as exc:
                        self.log(f"dialogue: tick failed: {type(exc).__name__}: {exc}")
                follow_in = SERVICE_TICK
                if db is not None:
                    self.maintain_store(db)
                    self.deliver_pending(session, db)
                    follow_in = self.follow_outbox(db)
                if not drained_reported and session.offline_count is not None:
                    drained_reported = True
                    self.log(f"offline queue drained: {session.offline_count} "
                             "item(s)")
                    self.publish(offline_drained=session.offline_count,
                                 **self.track(session))
                if time.monotonic() - beat >= SERVICE_HEARTBEAT:
                    beat = time.monotonic()
                    connected = True
                    with contextlib.suppress(Exception):
                        connected = bool(session._client.is_connected)
                    self.publish(connected=connected, **self.track(session))
                wait = min(SERVICE_TICK, follow_in)
                if self.follower is not None and db is not None \
                        and db.setting.has_transaction_address:
                    # The store's notification cuts the wait short too, and
                    # the outbox is polled at once rather than at its interval.
                    if self.follower.wait(wait, self.wake):
                        self.followed_at = None
                        self.wake.set()
                    wait = 0
                if self.wake.wait(wait):
                    self.wake.clear()
        except _Refusal as refusal:
            self.last_error = f"{refusal.code}: {refusal.message}"
            if refusal.code in ("not_linked", "logged_out"):
                return "logged_out"
            if refusal.code in ("account_identity_mismatch",
                                "store_account_mismatch", "engine_unavailable"):
                return "fatal"
            return "disconnected"
        except Exception as exc:
            self.last_error = f"{type(exc).__name__}: {exc}"
            return "disconnected"
        finally:
            self.beat("closing the session")
            if self.dialogue is not None:
                self.dialogue.attach(None)
            if session is not None:
                self.messages = base + (getattr(session, "live_messages", 0) or 0)
                with contextlib.suppress(Exception):
                    self.health.update(self.track(session))
                session.close()
                self.stalled = bool(getattr(session, "stalled", False))
            self.session = None

    def loop(self) -> int:
        backoff = SERVICE_BACKOFF_START
        self.last_error = None
        while not self.stop_requested.is_set():
            self.beat("starting a connection")
            began = time.monotonic()
            outcome = self.hold()
            if self.stalled:
                self.log("the engine did not release the connection; leaving "
                         "rather than risk a second client on the device")
                self.publish("failed", connected=False,
                             last_error="engine did not stop")
                return 5
            if outcome == "stopped" or self.stop_requested.is_set():
                return 0
            if outcome in ("logged_out", "fatal"):
                state = "logged_out" if outcome == "logged_out" else "failed"
                self.log(f"{state}: {self.last_error or 'device removed'}; "
                         "not reconnecting")
                self.publish(state, connected=False, last_error=self.last_error
                             or "the device was removed from the account")
                while not self.stop_requested.is_set():
                    self.beat("logged out, waiting to be stopped")
                    if self.reload_requested.is_set():
                        self.apply_reload()
                    self.stop_requested.wait(SERVICE_TICK)
                return 0
            if time.monotonic() - began >= SERVICE_STABLE_AFTER:
                backoff = SERVICE_BACKOFF_START
            self.reconnects += 1
            self.log(f"disconnected ({self.last_error}); reconnecting in "
                     f"{backoff:g}s")
            self.publish("reconnecting", connected=False,
                         last_error=self.last_error, next_attempt_in=backoff)
            self.wait(backoff)
            backoff = min(backoff * 2, SERVICE_BACKOFF_CEILING)
        return 0

    def take_over(self, handle, owner: dict) -> bool:
        """End a holder that has stopped making progress and take the account
        from it. A holder is taken over only when it is a listener, its health
        is older than `stall_seconds` and still is a moment later; it is asked
        to leave first and killed only when it does not."""
        import signal
        stale = _owner_stale_for(self.paths, owner, self.stall_seconds)
        if stale is None:
            return False
        time.sleep(SERVICE_STALE_CONFIRM)
        stale = _owner_stale_for(self.paths, owner, self.stall_seconds)
        pid = owner.get("pid")
        if stale is None or not _listener_process(pid):
            return False
        self.log(f"the account's holder, pid {pid}, has published no health for "
                 f"{stale:.0f}s (limit {self.stall_seconds}s); ending it and taking "
                 "over")
        for sig, grace in ((signal.SIGTERM, SERVICE_TAKEOVER_GRACE),
                           (signal.SIGKILL, 5.0)):
            with contextlib.suppress(ProcessLookupError, PermissionError):
                os.kill(pid, sig)
            deadline = time.monotonic() + grace
            while time.monotonic() < deadline:
                if _try_flock(handle):
                    self.log(f"took the account over from pid {pid}"
                             + (" after killing it" if sig == signal.SIGKILL else ""))
                    self.took_over = pid
                    return True
                time.sleep(0.1)
        return False

    def run(self) -> int:
        """Own the account for the life of the process, or refuse to start."""
        self.paths["state"].mkdir(parents=True, exist_ok=True, mode=0o700)
        self.paths["home"].mkdir(parents=True, exist_ok=True, mode=0o700)
        handle = self.paths["lock"].open("a+")
        with contextlib.suppress(OSError):
            self.paths["lock"].chmod(0o600)
        if not _try_flock(handle):
            owner = _service_owner(self.paths)
            if owner is None or not self.take_over(handle, owner):
                handle.close()
                _refuse(8, "service_running" if owner else "session_busy",
                        (f"the {NAME} assistant service already owns account "
                         f"{self.cfg['account_key']} (pid {owner.get('pid')})"
                         if owner else
                         f"another invocation holds the session for connection "
                         f"{self.cfg['id']!r}"),
                        "one listener holds one account")
        self.install_signals()
        global _OUTBOX_WAKE
        _OUTBOX_WAKE = self.wake
        self.beat("starting")
        code = 0
        try:
            _atomic_json(self.paths["owner"], self.owner_record())
            self.paths["pid"].write_text(f"{os.getpid()}\n")
            self.log(f"assistant service starting: connection {self.cfg['id']}, "
                     f"account {self.cfg['account_key']}, project {self.root}")
            self.publish("starting", connected=False, last_error=None)
            for target, name in ((self.heartbeat, "service-heartbeat"),
                                 (self.watch_progress, "service-watchdog")):
                threading.Thread(target=target, name=name, daemon=True).start()
            self.start_jobs()
            code = self.loop()
            return code
        finally:
            if self.follower is not None:
                # Its listener, where it holds one.
                self.follower.close()
            if self.dialogue is not None:
                if getattr(self.dialogue, "jobs", None) is not None:
                    with contextlib.suppress(Exception):
                        self.dialogue.jobs.shutdown()
                with contextlib.suppress(Exception):
                    self.dialogue.shutdown()
            with contextlib.suppress(Exception):
                state = self.health.get("state")
                self.publish(state if state in ("logged_out", "failed")
                             else "stopped", connected=False,
                             stopped_at=_epoch_iso(time.time()))
            self.log("assistant service stopped")
            with contextlib.suppress(Exception):
                owner = _json_file(self.paths["owner"])
                if isinstance(owner, dict) and owner.get("launch_nonce") == self.nonce:
                    self.paths["owner"].unlink()
            with contextlib.suppress(Exception):
                if self.paths["pid"].read_text().strip() == str(os.getpid()):
                    self.paths["pid"].unlink()
            self.leaving.set()
            if self.backstop:
                import faulthandler
                faulthandler.cancel_dump_traceback_later()
            if _OUTBOX_WAKE is self.wake:
                _OUTBOX_WAKE = None
            if not self.stalled:
                # A stalled engine thread may still be on the wire; the lock
                # then goes only with the process, which leaves at once.
                with contextlib.suppress(Exception):
                    fcntl.flock(handle, fcntl.LOCK_UN)
                    handle.close()


# ── Jobs ────────────────────────────────────────────────────────────────────
#
# The register of work a dialogue turn hands over, read and moved from the
# command line. A worker the service started reaches it through the shim on its
# PATH, which fixes the chat, the requester and the origin message; this verb
# checks them again against the environment the service set, so a worker that
# reached the CLI some other way is held to the same scope.

JOBS_HELP = """whatsapp jobs — the register of work that outlives a conversation

  jobs list [--state S] [--outcome O] [--limit N]   jobs in this project, newest first
  jobs active [--limit N]                           only what is waiting or running
  jobs show <id>                                    one job, staged amendments included
  jobs register "<one-line outcome>"                write a draft; nothing runs it yet
  jobs submit <id> --confirm-active-jobs-checked    hand a draft to the runner
  jobs amend <id> "<what changed>"                  continue a job with added context
  jobs discard <id>                                 drop a draft nobody will submit
  jobs stop <id>                                    stop the work; it keeps its session
  jobs resume <id>                                  continue a stopped job

A job runs in arrival order within defaults.max_parallel_jobs, on the profile
named by defaults.job_profile, and answers into the chat it was registered
from, quoting the message that asked for it. States: draft, waiting, running,
stopped; a stopped job's outcome is succeeded, failed, cancelled, interrupted,
quota or model_refused. Outside a worker, --chat narrows to one chat and
register takes --chat and --requested-by."""


def _jobs_environment(settings: dict) -> str:
    """The environment a job is filed under: the one the listener runs, which
    it hands its workers, else the settings' own."""
    return (os.environ.get("WHATSAPP_ENVIRONMENT", "").strip()
            or settings.get("environment") or "production")


def _job_scope(args) -> None:
    """Hold a worker the service started to the chat, requester and origin it
    was started for. A terminal call is a maintainer's and stays unscoped."""
    if not os.environ.get("WHATSAPP_DAEMON_CHILD", "").strip():
        return
    chat = os.environ.get("WHATSAPP_AUTHORIZED_CHAT_ID", "").strip()
    actor = os.environ.get("WHATSAPP_AUTHORIZED_REQUESTER", "").strip()
    if not chat or not actor:
        _refuse(4, "job_scope_missing",
                "a worker the WhatsApp service started reached the job register "
                "without the chat and requester it acts for",
                "the service hands its workers WHATSAPP_AUTHORIZED_CHAT_ID and "
                "WHATSAPP_AUTHORIZED_REQUESTER")
    for name, given, wanted in (("chat", args.chat, chat), ("actor", args.actor, actor)):
        if given and str(given) != wanted:
            _refuse(4, "job_scope_denied",
                    f"a worker's job {name} differs from the one its turn was started for")
    args.chat, args.actor = chat, actor
    if args.jobs_command == "register":
        origin = os.environ.get("WHATSAPP_AUTHORIZED_ORIGIN_MESSAGE_ID", "").strip()
        profile = os.environ.get("WHATSAPP_AUTHORIZED_JOB_PROFILE", "").strip()
        for name, given, wanted in (("requester", args.requested_by, actor),
                                    ("origin message", args.origin_message_id, origin),
                                    ("profile", args.profile, profile)):
            if given and wanted and str(given) != wanted:
                _refuse(4, "job_scope_denied",
                        f"a worker's job {name} differs from the one its turn was "
                        "started for")
        args.requested_by = actor
        args.origin_message_id = origin or None
        args.profile = profile or args.profile


def _open_jobs(args):
    """The project's job register on this account, and the module it lives in."""
    root = _service_project_root()
    settings = _service_settings()
    connection = (os.environ.get("WHATSAPP_AUTHORIZED_CONNECTION", "").strip()
                  if os.environ.get("WHATSAPP_DAEMON_CHILD") else None) or args.connection
    cfg = _service_cfg(settings, connection)
    project_id = _service_project_id(root)
    module = _service_module("jobs")
    db = _open_store(cfg)
    return module, module.JobRegister(_CliFacade(), db, project_id,
                                      _jobs_environment(settings)), settings


def _job_row(row: dict) -> dict:
    out = {k: v for k, v in row.items()
           if k not in ("attempt_token", "lease_owner", "project_id", "surface")}
    out["stopping"] = bool(out.pop("stop_requested", False))
    return out


def _require_job(register, job_id: str, chat: str | None, actor: str | None) -> dict:
    row = register.get(job_id, actor_id=actor)
    if row is None:
        _refuse(2, "job_not_found", f"no job {job_id} in this project's register",
                f"run `{NAME} jobs list` to see the ids")
    if chat and row["chat_id"] != chat:
        _refuse(4, "job_scope_denied", f"job {job_id} belongs to chat {row['chat_id']}, "
                f"not {chat}")
    return row


def cmd_jobs(args):
    action = args.jobs_command
    if action == "help":
        sys.stdout.write(JOBS_HELP + "\n")
        return None
    _job_scope(args)
    chat = _normalize_chat_id(args.chat) if args.chat else None
    actor = args.actor
    module, register, settings = _open_jobs(args)
    try:
        if action in ("list", "active"):
            if action == "active":
                rows = register.open_jobs(chat, actor_id=actor)[:args.limit]
            else:
                rows = register.list(limit=args.limit, state=args.state,
                                     outcome=args.outcome, chat_id=chat, actor_id=actor)
            return {"environment": register.environment, "account": register.account,
                    "chat_id": chat, "counts": register.counts(actor_id=actor),
                    "slots_in_use": register.slots_in_use(),
                    "jobs": [_job_row(r) for r in rows]}
        if action == "register":
            if not chat:
                _refuse(6, "no_chat", "a job needs the chat it reports into",
                        "pass --chat <chat-id>")
            if not args.requested_by:
                _refuse(6, "no_requester", "a job needs the person whose authority "
                        "it carries", "pass --requested-by <phone number>")
            profile = (args.profile or (settings.get("defaults") or {}).get("job_profile")
                       or _service_module("profiles").DEFAULT_JOB_PROFILE)
            row = register.register(chat_id=chat, requested_by=args.requested_by,
                                    description=args.description,
                                    origin_message_id=args.origin_message_id,
                                    profile=profile)
            out = _job_row(row)
            out["next"] = (f"submit it with `{NAME} jobs submit {row['id']} "
                           "--confirm-active-jobs-checked` once its outcome line says "
                           "what will be delivered")
            return out
        row = _require_job(register, args.id, chat, actor)
        if action == "show":
            out = _job_row(row)
            out["pending_amendment"] = register.pending_amendment(args.id)
            return out
        if action == "submit":
            if not args.confirm_active_jobs_checked:
                _refuse(6, "active_jobs_unconfirmed",
                        "submitting needs confirmation that the active jobs were read",
                        f"read `{NAME} jobs active`, and if this outcome is not already "
                        "among them pass --confirm-active-jobs-checked")
            return _job_row(register.submit(args.id, actor_id=actor))
        if action == "amend":
            register.stage_amendment(args.id, args.text, actor_id=actor)
            register.amend(args.id, actor_id=actor)
            return {"id": args.id, "amendment": "staged",
                    "pending_amendment": register.pending_amendment(args.id),
                    "instruction": "Say the correction is folded into the job that "
                                   "already exists. Do not register a new one."}
        if action == "discard":
            if row["state"] != module.DRAFT:
                _refuse(6, "job_not_a_draft", f"job {args.id} is {row['state']}, not a "
                        "draft", f"work that has started is stopped with `{NAME} jobs "
                        "stop` and stays continuable")
            register.discard(args.id, actor_id=actor)
            return {"id": args.id, "discarded": True, "description": row["description"]}
        if action == "stop":
            if register.request_stop(args.id, actor_id=actor) is None:
                _refuse(6, "job_not_running", f"job {args.id} is {row['state']}, so "
                        "there is nothing to stop", f"`{NAME} jobs resume` continues a "
                        "stopped job")
            return {"id": args.id, "stopping": True,
                    "instruction": "The listener ends the work on its next look at the "
                                   "register. The job keeps its session and its place."}
        if action == "resume":
            return _job_row(register.resume(args.id, actor_id=actor))
    except module.JobError as exc:
        _refuse(6, exc.slug, exc.message, exc.hint)
    finally:
        register.db.close()
    return None


def cmd_service(args):
    action = args.service_command
    connection = getattr(args, "connection", None)
    if action == "init":
        return _cmd_service_init(connection, args.force)
    if action == "start":
        return _cmd_service_start(connection)
    if action == "run":
        return _cmd_service_run(connection)
    if action == "stop":
        return _cmd_service_stop(connection, args.timeout, args.force)
    if action == "reload":
        return _cmd_service_reload(connection, args.timeout)
    if action == "status":
        return _cmd_service_status(connection)
    if action == "logs":
        return _cmd_service_logs(connection, args.tail)
    if action == "harness":
        return _cmd_service_harness()
    report, fail = _cmd_service_doctor(connection)
    _emit(report)
    if fail:
        sys.exit(fail)
    return None


# ── CLI ─────────────────────────────────────────────────────────────────────


def _selection_flags(parser, *, suppress: bool = False) -> None:
    """`--connection` / `--session` on the program and on every verb. A verb-side
    default of SUPPRESS leaves a value given before the verb standing."""
    default = argparse.SUPPRESS if suppress else None
    parser.add_argument(
        "--connection", "-c", dest="connection", default=default,
        help="connection id (default: the registry's \"default\" pointer, "
             "else the sole declared connection)")
    parser.add_argument(
        "--session", dest="session", default=default,
        help="override a WAHA connection's session name (no effect on the "
             "in-house engine, whose session is the linked device)")


def main():
    _gate()                      # every verb passes the effective policy gate first
    if (sys.argv[1:2] or [""])[0] == "manifest":
        # The contract's manifest plus the bundled service it declares. A
        # connection is a device linked to the account, not a portable value.
        core = _manifest_core()
        _emit({**core, "connections": {**core["connections"], "device_bound": True},
               "service": SERVICE})
        sys.exit(0)
    _contract(sys.argv[1:])      # contract verbs; domain verbs fall through
    parser = argparse.ArgumentParser(
        prog="whatsapp",
        description="WhatsApp CLI — link a device, keep its chats in a local "
                    "store, read, deepen, and export them.")
    _selection_flags(parser)

    sub = parser.add_subparsers(dest="command", required=True)

    def _sub(name: str, **kwargs):
        """Selection reads the same before or after the verb, so an agent never
        has to know where argparse wanted the flag."""
        created = sub.add_parser(name, **kwargs)
        _selection_flags(created, suppress=True)
        return created

    _sub("help", help="Print full usage block")
    _sub("contract", help="The message envelope every read emits, as an example")
    _sub("doctor", help="Readiness probe (engine, session, identity)")
    _sub("status", help="Human-readable account / session / store view")
    _sub("health", help="What the capture holds and what is missing")

    pp = _sub("pair", help="Link this machine as a companion device")
    pp.add_argument("--number", help="account phone number incl. country code "
                    "(default: the connection's `number`); digits, `+`/spaces stripped")
    pp.add_argument("--qr", action="store_true",
                    help="paint a scannable QR code instead of requesting a pairing code")
    pp.add_argument("--days", type=int,
                    help="history window for the one-time pairing burst "
                         "(default: the connection's initial_sync_days)")
    pp.add_argument("--full", action="store_true",
                    help="ask for everything the phone still holds, not a window")
    pp.add_argument("--hold", type=int,
                    help="seconds to hold the connection open for the burst "
                         f"(default: {PAIR_HOLD_DEFAULT})")
    pp.add_argument("--wait", action="store_true",
                    help="WAHA connections: poll until the session is WORKING")
    pp.add_argument("--recreate", action="store_true",
                    help="discard the existing session and link again (requires --yes)")
    pp.add_argument("--yes", action="store_true", help="confirm a destructive --recreate")
    pp.add_argument("--events", action="store_true",
                    help="speak JSON lines on stdout (qr, pairing_code, phone_needed, "
                         "linked, progress, done, error) and read the phone number "
                         "from stdin when asked")

    pc = _sub("chats", help="List chats held in the store")
    pc.add_argument("--search", "-s", help="filter chats by name (case-insensitive)")
    pc.add_argument("--limit", "-n", type=int, help="max chats to show")
    pc.add_argument("--fresh", action="store_true",
                    help="connect first, so the server's queue is drained before answering")
    pc.add_argument("--json", action="store_true", help="emit JSON instead of a table")

    pm = _sub("messages", help="Read a chat, reaching back when needed")
    pm.add_argument("chat_id", help="chat id (e.g. 15551234567@s.whatsapp.net "
                    "or <group-id>@g.us), or a bare number")
    pm.add_argument("--limit", "-n", type=int, default=50,
                    help="how many messages to return (default: 50)")
    pm.add_argument("--from", dest="from_date", help="start date (YYYY-MM-DD)")
    pm.add_argument("--to", dest="to_date", help="end date (YYYY-MM-DD)")
    pm.add_argument("--rounds", type=int,
                    help=f"cap on history requests when the store cannot cover the "
                         f"window (default: {DEFAULT_ROUNDS}; 0 answers from the "
                         f"store alone)")
    pm.add_argument("--fresh", action="store_true",
                    help="connect even when the store already covers the request")
    pm.add_argument("--format", "-f", choices=["conversation", "table"],
                    default="conversation", help="output format (default: conversation)")
    pm.add_argument("--json", action="store_true", help="emit the message envelopes as JSON")

    pk = _sub("contact", help="Show what is known about a contact")
    pk.add_argument("contact_id", help="contact id (e.g. 15551234567@s.whatsapp.net) "
                    "or a bare number")
    pk.add_argument("--fresh", action="store_true",
                    help="ask the engine to resolve an unknown identity")
    pk.add_argument("--json", action="store_true", help="emit JSON instead of a table")

    pe = _sub("export", help="Render a chat into messages.json + media/")
    pe.add_argument("chat_id", help="chat id (e.g. <group-id>@g.us)")
    pe.add_argument("--out", help="output JSON path (default: the connection's "
                    "messages_dir → <messages_dir>/<slug>/messages.json)")
    pe.add_argument("--media-dir", help="media output dir (default: <out>/../media)")
    pe.add_argument("--limit", "-n", type=int, help="cap on messages exported "
                    "(default: everything held for the chat)")
    pe.add_argument("--from", dest="from_date", help="start date (YYYY-MM-DD)")
    pe.add_argument("--to", dest="to_date", help="end date (YYYY-MM-DD)")
    pe.add_argument("--rounds", type=int,
                    help=f"cap on history requests when the store cannot cover the "
                         f"window (default: {DEFAULT_ROUNDS}; 0 exports the store alone)")
    pe.add_argument("--page-size", type=int,
                    help=f"WAHA connections: messages per page "
                         f"(default: {PAGE_SIZE_DEFAULT})")
    pe.add_argument("--max-pages", type=int,
                    help="WAHA connections: cap on pages fetched")
    pe.add_argument("--no-photos", action="store_true",
                    help="skip photo downloads (default: download photos)")
    pe.add_argument("--no-stickers", action="store_true",
                    help="skip sticker downloads (default: download stickers)")
    pe.add_argument("--videos", action="store_true", help="also download videos")
    pe.add_argument("--documents", action="store_true", help="also download documents")

    pt = _sub("transcribe",
                        help="Fill voice/audio transcription placeholders via Deepgram")
    pt.add_argument("json_path", help="path to a messages.json produced by `whatsapp export`")
    pt.add_argument("--force", action="store_true", help="re-transcribe even if already filled")
    pt.add_argument("--model", default=DEEPGRAM_MODEL,
                    help=f"Deepgram model (default: {DEEPGRAM_MODEL})")

    pr = _sub("render", help="Pretty-print an exported messages.json as markdown")
    pr.add_argument("json_path", help="path to a messages.json produced by `whatsapp export`")
    pr.add_argument("--out", help="write to a file instead of stdout")

    pil = _sub("import-legacy",
               help="Import the account's pre-Postgres messages.db once")
    pil.add_argument("--file", help="the legacy store to read (default: "
                     "messages.db in the account's state home)")

    pprof = _sub("profiles", help="The harness profiles the assistant service runs on")
    prof = pprof.add_subparsers(dest="profiles_command", required=True)
    plist = prof.add_parser("list", help="Each profile as it resolves from the store")
    plist.add_argument("names", nargs="*",
                       help="profile names (default: every one the settings reach)")
    pimport = prof.add_parser("import", help="Move the project's profile files into the store")
    pimport.add_argument("--apply", action="store_true",
                         help="save them and remove the files (default: say what it would do)")

    psend = _sub(
        "send", help="Send a text message (write-enabled connections only)")
    psend.add_argument("chat_id", nargs="?", help="recipient chat id")
    psend.add_argument("text", nargs="?", help="message text")
    psend.add_argument("--reply-to", dest="reply_to", metavar="MESSAGE_ID",
                       help="quote this message of the same chat, by its id")
    psend.add_argument("--mention", dest="mentions", action="append",
                       metavar="PHONE",
                       help="mention this number (repeatable); its @number "
                            "leads the text unless the text already carries it")
    psend.add_argument("--typing", action="store_true",
                       help="show composing for a short, jittered moment first")

    psvc = _sub("service", help="Operate the bundled assistant listener")
    svc = psvc.add_subparsers(dest="service_command", required=True)

    def _svc(name: str, **kwargs):
        created = svc.add_parser(name, **kwargs)
        _selection_flags(created, suppress=True)
        return created

    sinit = _svc("init", help="Seed the service settings records")
    sinit.add_argument("--force", action="store_true",
                       help="reseed settings that already exist")
    _svc("start", help="Start the listener detached")
    _svc("run", help="Run the listener in the foreground")
    sstop = _svc("stop", help="Stop the listener")
    sstop.add_argument("--timeout", type=float, default=SERVICE_STOP_TIMEOUT)
    sstop.add_argument("--force", action="store_true",
                       help="kill it when it does not stop within the timeout")
    sreload = _svc("reload", help="Re-read and validate settings in the listener")
    sreload.add_argument("--timeout", type=float, default=10.0)
    _svc("status", help="State, pid, connection, uptime, last event")
    slogs = _svc("logs", help="Tail the listener's log")
    slogs.add_argument("--tail", type=int, default=50)
    _svc("doctor", help="Settings, store, link and ownership")
    _svc("harness", help="The harness tools of every profile a turn is configured to "
         "run on; writes nothing").add_argument("--json", action="store_true")

    pjobs = _sub("jobs", help="The register of work that outlives a conversation")
    jobs_sub = pjobs.add_subparsers(dest="jobs_command", required=True)

    def _job(name: str, *, needs_id: bool = True, **kwargs):
        created = jobs_sub.add_parser(name, **kwargs)
        _selection_flags(created, suppress=True)
        if needs_id:
            created.add_argument("id", help="the job id, from `jobs list`")
        created.add_argument("--chat", help="only this chat's jobs")
        created.add_argument("--actor", help=argparse.SUPPRESS)
        return created

    jobs_sub.add_parser("help", help="Every jobs verb and its flags")
    jlist = _job("list", needs_id=False, help="Jobs in this project, newest first")
    jlist.add_argument("--state", choices=["draft", "waiting", "running", "stopped"])
    jlist.add_argument("--outcome", choices=["succeeded", "failed", "cancelled",
                                             "interrupted", "quota", "model_refused"])
    jlist.add_argument("--limit", type=int, default=50)
    jactive = _job("active", needs_id=False, help="Only what is waiting or running")
    jactive.add_argument("--limit", type=int, default=50)
    _job("show", help="One job, staged amendments included")
    jreg = _job("register", needs_id=False, help="Write a draft; nothing runs it yet")
    jreg.add_argument("description", help="one line: the outcome, in the requester's terms")
    jreg.add_argument("--requested-by", dest="requested_by",
                      help="the phone number whose authority the job carries")
    jreg.add_argument("--origin-message-id", dest="origin_message_id",
                      help="the message the job answers, quoted with its result")
    jreg.add_argument("--profile", help="the job profile (default: defaults.job_profile)")
    jsubmit = _job("submit", help="Hand a draft to the runner")
    jsubmit.add_argument("--confirm-active-jobs-checked", action="store_true",
                         dest="confirm_active_jobs_checked",
                         help="you read `jobs active` and this outcome is not there")
    jamend = _job("amend", help="Continue a job with added context, keeping its session")
    jamend.add_argument("text", help="what changed, in the requester's terms")
    _job("discard", help="Drop a draft nobody will submit")
    _job("stop", help="Stop the work; it keeps its session and its place")
    _job("resume", help="Continue a stopped job")

    args = parser.parse_args()
    # A linking verb asked for events speaks them from here on, refusals included.
    if getattr(args, "events", False):
        _events_begin()

    # The standard write gate: a write verb refuses on a read-only connection,
    # after selection, before any credential resolves. Resolving the selected
    # connection's allow_write costs no network and no secret — it reads the
    # committed registry alone.
    if args.command in WRITE_VERBS:
        reg, _ = _connections_registry()
        cid, entry = _select_connection(reg, args.connection)
        allow_write = bool((entry or {}).get("allow_write", WRITE_DEFAULT))
        _write_gate(cid, allow_write, args.command)

    # Pairing changes the account: the phone gains a linked device, and on a
    # WAHA connection the bridge's session is created, started or discarded.
    # It is still not a write verb, because a connection's grant is about
    # sending and a connection that may not send is paired all the same to be
    # read. So the read-only switch refuses it here on its own, before any
    # request is made and before the engine starts.
    if args.command == "pair":
        _read_only_gate(f"`{NAME} pair`")

    result = {
        "help": cmd_help,
        "contract": cmd_contract,
        "doctor": cmd_doctor,
        "status": cmd_status,
        "health": cmd_health,
        "pair": cmd_pair,
        "chats": cmd_chats,
        "messages": cmd_messages,
        "contact": cmd_contact,
        "export": cmd_export,
        "transcribe": cmd_transcribe,
        "render": cmd_render,
        "import-legacy": cmd_import_legacy,
        "profiles": cmd_profiles,
        "send": cmd_send,
        "service": cmd_service,
        "jobs": cmd_jobs,
    }[args.command](args)

    if result is not None:
        _emit(result)


def _die_with_fields(refusal: _Refusal) -> NoReturn:
    """`_die` for a refusal that carries fields beside its code, written into
    the same envelope (deviations.md)."""
    err: dict = {"code": refusal.code, "message": refusal.message}
    if refusal.hint:
        err["hint"] = refusal.hint
    err.update(refusal.fields)
    if _EVENTS_ON[0]:
        sys.stdout.write(json.dumps({"event": "error", "exit": refusal.exit_code,
                                     "error": err}, ensure_ascii=False) + "\n")
        sys.stdout.flush()
    sys.stderr.write(json.dumps({"error": err}, ensure_ascii=False) + "\n")
    sys.exit(refusal.exit_code)


def _run() -> NoReturn:
    """One exit for every path.

    The engine's blocking call runs on a thread it does not mark daemon, so an
    interpreter that reached normal shutdown with that thread still alive would
    wait on it for as long as it lived. Every path therefore ends here, and the
    process leaves once its output is flushed."""
    code = 0
    try:
        main()
    except _Refusal as refusal:
        try:
            if refusal.fields:
                _die_with_fields(refusal)
            _die(refusal.exit_code, refusal.code, refusal.message, refusal.hint)
        except SystemExit as exc:
            code = exc.code if isinstance(exc.code, int) else 1
    except SystemExit as exc:
        code = exc.code if isinstance(exc.code, int) else (0 if exc.code is None else 1)
    except BaseException as exc:
        # A bug, not a handled outcome — but it still leaves through the one
        # error envelope, so a caller never has to parse a traceback.
        traceback.print_exc()
        sys.stderr.write(json.dumps({"error": {
            "code": "unhandled", "message": f"{type(exc).__name__}: {exc}",
            "hint": "this is a defect in the capability; the traceback is above"}},
            ensure_ascii=False) + "\n")
        code = 1
    finally:
        for stream in (sys.stdout, sys.stderr):
            try:
                stream.flush()
            except Exception:
                pass
        os._exit(code)


if __name__ == "__main__":
    _run()
