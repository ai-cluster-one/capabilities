#!/usr/bin/env python3
"""The `whatsapp` a worker of the assistant service finds first on its PATH.

The listener puts this directory ahead of everything else for each turn and
job it starts. A `jobs` call goes through here so that where the work reports
is fixed by the turn rather than by the model: the chat, the message the job
answers, the person whose authority it carries and the job profile come from
the environment the listener set, and a call that names any of them itself is
refused. Everything else passes to the real CLI unchanged, which applies its
own gates.
"""

import json
import os
import sys

# Flags a worker's `jobs` call may not carry: each names something the turn
# already fixed.
SCOPE_FLAGS = ("--chat", "--requested-by", "--origin-message-id", "--actor",
               "--profile", "--connection", "-c", "--session")


def fail(code, message, hint=None, exit_code=4):
    error = {"code": code, "message": message}
    if hint:
        error["hint"] = hint
    sys.stderr.write(json.dumps({"error": error}, ensure_ascii=False) + "\n")
    raise SystemExit(exit_code)


def verb_index(args):
    """Where the verb is: the first argument that is not a flag."""
    for index, item in enumerate(args):
        if not item.startswith("-"):
            return index
    return None


def is_help(args, at):
    return (args[at + 1:at + 2] in (["help"], [])
            or any(item in ("-h", "--help") for item in args[at + 1:at + 3]))


def scoped_jobs(args, at):
    """The `jobs` call with the turn's scope put right after its sub-verb,
    ahead of any `--` a description may need."""
    for item in args:
        name = item.split("=", 1)[0]
        if name in SCOPE_FLAGS:
            fail("worker_scope_denied",
                 f"{name} cannot be set inside a WhatsApp worker; the turn fixes it",
                 "leave it out: the job reports into this chat, for this request")
    if is_help(args, at):
        return args
    chat = os.environ.get("WHATSAPP_AUTHORIZED_CHAT_ID", "").strip()
    requester = os.environ.get("WHATSAPP_AUTHORIZED_REQUESTER", "").strip()
    if not chat or not requester:
        fail("worker_authority_missing",
             "the service did not hand this worker the chat and requester it acts for")
    scope = ["--chat", chat, "--actor", requester]
    if args[at + 1:at + 2] == ["register"]:
        scope += ["--requested-by", requester]
        origin = os.environ.get("WHATSAPP_AUTHORIZED_ORIGIN_MESSAGE_ID", "").strip()
        if origin:
            scope += ["--origin-message-id", origin]
        profile = os.environ.get("WHATSAPP_AUTHORIZED_JOB_PROFILE", "").strip()
        if profile:
            scope += ["--profile", profile]
    return args[:at + 2] + scope + args[at + 2:]


def main():
    args = list(sys.argv[1:])
    at = verb_index(args)
    if at is not None and args[at] == "jobs":
        if at:
            fail("worker_scope_denied", "a worker's `jobs` call takes no flags before it",
                 "call it as `whatsapp jobs <verb> ...`")
        args = scoped_jobs(args, at)
    real = os.environ.get("WHATSAPP_REAL_WHATSAPP", "").strip()
    if not real:
        fail("worker_cli_missing", "the service did not name the CLI this worker runs",
             exit_code=5)
    os.execv(real, [real] + args)


if __name__ == "__main__":
    main()
