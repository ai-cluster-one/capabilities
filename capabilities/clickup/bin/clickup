        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("help", help="print the full usage contract, "
                                    "or `help <command>` for one subcommand's syntax")
    sp.add_argument("topic", nargs="?", default=None,
                    help="subcommand name; prints its --help instead of the full contract")
    sub.add_parser("doctor", help="health check — resolve token, confirm identity")
    sub.add_parser("whoami", help="confirm token and return identity")
