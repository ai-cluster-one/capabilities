           'minimum': 1,
           'scope': 'project',
           'apply': 'reload'},
          {'key': 'defaults.job_recovery',
           'label': 'Job recovery',
           'help': 'What becomes of work a restart interrupted.',
           'type': 'enum',
           'choices': ['inspect', 'requeue'],
           'default': 'requeue',
           'scope': 'project',
           'apply': 'reload'},
          {'key': 'direct_messages.mode',
           'label': 'Direct messages',
           'help': 'Who may message the assistant directly.',
           'type': 'enum',
           'choices': ['allowed_users', 'anyone', 'all', 'open', 'public'],
           'scope': 'project',
           'apply': 'reload'},
          {'key': 'defaults.profile',
           'label': 'Profile',
           'help': 'The harness profile a dialogue turn runs on.',
           'type': 'string',
           'default': 'stub',
           'scope': 'project',
           'apply': 'reload'}]}
WRITE_VERBS = {"send", "send-media", "react"}
WRITE_DEFAULT = False    # outbound messages and reactions need an explicit connection grant
MACHINE_READS = ("connections", "doctor", "app-check")   # outside any project, read-only on the machine's connections
DOCS_BASE = ("https://raw.githubusercontent.com/ai-cluster-one/capabilities/"
             "main/capabilities/telegram/guides/")
STATE = True       # True when the capability writes session/cache state
TABLES = True      # telegram_* tables in the project's database, built by _tables()
INVENTORY = {"network": "none"}   # the daemon's state is pid and health files on this machine
SERVICE_STATE_VERSION = 1
POST_INSTALL: list = []
SERVICE = {
    # How many nodes run it at once (service.placement). One Telegram account is one
    # MTProto session: one node runs it at a time.
    "placement": "exclusive",
    "name": "assistant",
    "summary": "Project-local Telegram assistant daemon using the bundled service engine.",
    "verbs": ["init", "doctor", "run", "start", "reload", "stop", "status", "logs",
              "migrate-ownership", "migrate-profiles", "schema", "validate", "harness"],
    # The sign-ins a node needs for it: the harness of every profile a turn is
    # configured to run on, which `service harness` answers.
    "sign_ins": {"harness": ["telegram", "service", "harness", "--json"]},
    "config": "capabilities/telegram/service",
    "state": "<connection-state>/service",
    "deploy": {
        "schema": "capabilities.service.deploy.v1",
        "default_policy": "auto",
        "command": ["telegram", "service", "run"],
        "environment": {
