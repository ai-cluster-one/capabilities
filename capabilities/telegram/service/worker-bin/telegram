#!/usr/bin/env python3
import json
import os
import sys
import time


def fail(code, message, hint=None, exit_code=6):
    error = {"code": code, "message": message}
    if hint:
        error["hint"] = hint
    sys.stderr.write(json.dumps({"error": error}, ensure_ascii=False) + "\n")
    raise SystemExit(exit_code)


def worker_scope():
    chat = os.environ.get("TELEGRAM_AUTHORIZED_CHAT_ID", "").strip()
    topic = os.environ.get("TELEGRAM_AUTHORIZED_TOPIC_ID", "").strip() or None
    connection = os.environ.get("TELEGRAM_AUTHORIZED_CONNECTION", "").strip()
    return chat, topic, connection


def parse_progress_send(argv):
    """The complete worker-send grammar: send CHAT TEXT, exactly."""
    args = list(argv[1:])
    if not args or args[0] != "send":
        return None
    for forbidden in ("--connection", "--session"):
        if forbidden in args or any(item.startswith(forbidden + "=") for item in args):
            fail("worker_scope_denied",
                 f"{forbidden} cannot be overridden inside a Telegram worker request",
                 exit_code=4)
    if len(args) != 3:
        fail("worker_send_invalid",
             "worker send syntax is: telegram send <authorized-chat> <one text argument>",
             "quote the complete message; flags and extra arguments are unsupported")
    _, chat, message = args
    if chat.startswith("-") and not chat.lstrip("-").isdigit():
        fail("worker_send_invalid", f"invalid chat argument: {chat!r}")
    if message.startswith("--"):
        fail("worker_send_invalid",
             f"unsupported or misplaced flag in worker send: {message!r}")
    text = sys.stdin.read().strip() if message == "-" else message.strip()
    return chat, text


def write_progress(argv):
    if argv[1:2] != ["send"]:
        return False
    outbox = os.environ.get("TELEGRAM_PROGRESS_OUTBOX")
    if not outbox:
        return False
    parsed = parse_progress_send(argv)
    chat, text = parsed
    allowed_chat, allowed_topic, allowed_connection = worker_scope()
    if not allowed_chat:
        fail("worker_authority_missing",
             "the daemon did not provide an authorized Telegram chat scope",
             exit_code=4)
    if chat in ("current", "$current"):
        chat = allowed_chat
    if str(chat) != allowed_chat:
        fail("chat_scope_denied",
             "worker send destination differs from the authorized chat",
             f"requested={chat}; authorized_chat_id={allowed_chat}", exit_code=4)
    if not text:
        fail("worker_send_invalid", "worker send text must not be empty")
    if text in ("-", ".", "..."):
        fail("worker_send_invalid", "worker send text must contain a useful message")
    os.makedirs(os.path.dirname(outbox), exist_ok=True)
    record = {
        "time": time.time(),
        "chat": allowed_chat,
        "topic_id": allowed_topic,
        "connection": allowed_connection,
        "text": text,
        "reply_to": os.environ.get("TELEGRAM_PROGRESS_REPLY_TO") or None,
        "chat_type": os.environ.get("TELEGRAM_PROGRESS_CHAT_TYPE") or None,
    }
    with open(outbox, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(record, ensure_ascii=False) + "\n")
    print(json.dumps({"ok": True, "queued": "telegram-service-progress"}))
    return True


def enforce_job_scope(argv):
    """A worker reads and moves the jobs of its own channel, and no others.

    `jobs` is a store surface rather than an outbox one: the register is a
    table, so the real CLI answers a read directly and records an ask directly,
    and nothing has to round-trip through the daemon to be seen. What the shim
    still owns is the scope — the authorized chat and topic are pinned here so
    a turn cannot list or touch another room's work.
    """
    args = list(argv[1:])
    if args[:1] != ["jobs"]:
        return
    allowed_chat, allowed_topic, allowed_connection = worker_scope()
    if not allowed_chat:
        fail("worker_authority_missing",
             "the daemon did not provide an authorized Telegram chat scope",
             exit_code=4)
    for forbidden in ("--chat", "--channel", "--all-channels",
                      "--requested-by", "--origin-message-id"):
        if forbidden in args or any(item.startswith(forbidden + "=") for item in args):
            fail("worker_scope_denied",
                 f"{forbidden} cannot be overridden inside a Telegram worker request",
                 f"this turn is scoped to chat {allowed_chat}", exit_code=4)


def job_scope_arguments(argv):
    """The scope and attribution the shim adds to a worker `jobs` call."""
    allowed_chat, allowed_topic, _ = worker_scope()
    args = ["--chat", allowed_chat]
    if allowed_topic:
        args += ["--topic-id", allowed_topic]
    if list(argv[1:3]) == ["jobs", "register"]:
        requester = os.environ.get("TELEGRAM_AUTHORIZED_REQUESTER_ID", "").strip()
        if not requester:
            fail("worker_authority_missing",
                 "the daemon did not provide the authorized job requester",
                 exit_code=4)
        args += ["--requested-by", requester]
        origin = os.environ.get(
            "TELEGRAM_AUTHORIZED_ORIGIN_MESSAGE_ID", "").strip()
        if origin:
            args += ["--origin-message-id", origin]
    return args


def auth_context():
    raw = os.environ.get("CAPABILITIES_AUTH_CONTEXT")
    if not raw:
        return None
    try:
        if raw.lstrip().startswith("{"):
            return json.loads(raw)
        with open(raw, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError) as exc:
        fail("worker_authority_invalid",
             f"cannot read the daemon authority context: {exc}", exit_code=4)


def telegram_rule(ctx):
    caps = ctx.get("allowed_capabilities") or {}
    if caps is True or caps == "*":
        return True
    if isinstance(caps, list):
        return True if ("telegram" in caps or "*" in caps) else False
    if not isinstance(caps, dict):
        return None
    return caps.get("telegram", caps.get("*"))


def rule_scope(rule):
    if rule is True or rule == "*":
        return None
    if isinstance(rule, dict):
        return rule.get("scope")
    return None


def flag_value(argv, flag):
    """(present, value) for `--flag V` and `--flag=V`."""
    args = list(argv[1:])
    for index, item in enumerate(args):
        if item == flag:
            return True, args[index + 1] if index + 1 < len(args) else None
        if item.startswith(flag + "="):
            return True, item.split("=", 1)[1]
    return False, None


def names_another_connection(argv):
    """Whether this command is aimed at a connection other than the one that
    received the message. Whether it may be is the CLI's own decision: it owns
    the grant and is the last thing standing between a request and an account.
    """
    present, requested = flag_value(argv, "--connection")
    if not present or not requested:
        return False
    authorized = os.environ.get("TELEGRAM_AUTHORIZED_CONNECTION", "").strip()
    return bool(authorized) and requested != authorized


def parse_command_and_chat(argv):
    chat_commands = {"read", "search", "topics", "send", "send-media", "react",
                     "download", "export"}
    takes_value = {"--session", "--connection", "--chat"}
    args = list(argv[1:])
    i = 0
    while i < len(args):
        item = args[i]
        if item in takes_value:
            i += 2
            continue
        if item.startswith("--"):
            i += 1
            continue
        cmd = item
        if cmd not in chat_commands:
            return cmd, None
        j = i + 1
        while j < len(args) and args[j].startswith("--"):
            j += 2 if args[j] in takes_value else 1
        return cmd, args[j] if j < len(args) else None
    return None, None


def enforce_current_chat_scope(argv):
    ctx = auth_context()
    if ctx is None:
        return
    rule = telegram_rule(ctx)
    if rule in (None, False):
        return
    if rule_scope(rule) != "current_chat":
        return
    cmd, chat = parse_command_and_chat(argv)
    if not chat:
        return
    current = str(ctx.get("chat_id") or "")
    if str(chat) in (current, "current", "$current"):
        return
    sys.stderr.write(json.dumps({
        "error": {
            "code": "chat_scope_denied",
            "message": "telegram is limited to the current chat for this request",
            "hint": f"requested={chat}; current_chat_id={current}"
        }
    }, ensure_ascii=False) + "\n")
    raise SystemExit(4)


def main():
    daemon_turn = bool(os.environ.get("TELEGRAM_PROGRESS_OUTBOX")
                       or os.environ.get("TELEGRAM_AUTHORIZED_CONNECTION"))
    # A session path names a file rather than a declared connection, so it
    # reaches any account on the machine: it is refused for the whole of a
    # daemon-launched turn, and no grant lifts it.
    if daemon_turn:
        for forbidden in ("--session",):
            if forbidden in sys.argv[1:] or any(
                    item.startswith(forbidden + "=") for item in sys.argv[1:]):
                fail("worker_scope_denied",
                     f"{forbidden} cannot be overridden inside a Telegram worker request",
                     exit_code=4)
    cross_connection = names_another_connection(sys.argv) if daemon_turn else False
    if os.environ.get("TELEGRAM_PROGRESS_OUTBOX") and not cross_connection:
        for forbidden in ("--topic", "--thread"):
            if forbidden in sys.argv[1:] or any(
                    item.startswith(forbidden + "=") for item in sys.argv[1:]):
                fail("worker_scope_denied",
                     f"{forbidden} cannot be overridden inside a Telegram worker request",
                     exit_code=4)
    elif os.environ.get("TELEGRAM_AUTHORIZED_TOPIC_ID") and not cross_connection:
        # A daemon-authorized worker inherits the topic from its authority
        # context, so naming another one is a destination substitution even
        # when the chat matches.
        for forbidden in ("--topic", "--thread"):
            if forbidden in sys.argv[1:] or any(
                    item.startswith(forbidden + "=") for item in sys.argv[1:]):
                fail("worker_scope_denied",
                     f"{forbidden} cannot be overridden inside a Telegram worker request",
                     exit_code=4)
    # A send on the receiving account is a progress/final-delivery write owned by
    # the daemon. A send on a granted second connection is a real capability
    # action; the CLI applies the role grant and the connection write gate.
    if not cross_connection and write_progress(sys.argv):
        return 0
    enforce_job_scope(sys.argv)
    enforce_current_chat_scope(sys.argv)
    real = os.environ.get("TELEGRAM_REAL_TELEGRAM")
    if not real:
        real = "telegram"
    args = [real]
    worker_session = os.environ.get("TELEGRAM_WORKER_SESSION")
    # The worker session belongs to the account that received the message.
    # Handing it to a command aimed at another connection would read one
    # account through the other's session, so it is left out entirely.
    if worker_session and "--session" not in sys.argv[1:] and not cross_connection:
        args.extend(["--session", worker_session])
    passthrough = list(sys.argv[1:])
    if passthrough[:1] == ["jobs"]:
        passthrough += job_scope_arguments(sys.argv)
    os.execvp(real, args + passthrough)


if __name__ == "__main__":
    raise SystemExit(main())
