#!/usr/bin/env python3
"""A stand-in Claude Code for the tasks suite, speaking the stream-json protocol
claude-agent-sdk speaks, so callva-harness-runner starts it exactly as it starts
the real CLI.

It answers the SDK's control requests, and answers the user message with an
init event and a result document. It does no work.

  FAKE_ENGINE_RECORD   append {"argv", "cwd", "env", "prompt"} per turn (JSONL)
  FAKE_ENGINE_TASKS    a tasks executable: finish the task the prompt names the
                       way a worker does, with an activity and `complete`, under
                       the raise the turn was started with
  FAKE_ENGINE_SLEEP    seconds to hold the turn open before answering
  FAKE_ENGINE_FAIL     `idle`: answer with an error at once, having written
                       nothing; `ordinary`: write an activity through
                       FAKE_ENGINE_TASKS, then answer with an error
"""
import json
import os
import re
import subprocess
import sys
import time

argv = sys.argv[1:]
if argv in (["-v"], ["--version"]):
    print("2.1.280 (Claude Code)")
    sys.exit(0)


def arg(name):
    for index, item in enumerate(argv):
        if item == name and index + 1 < len(argv):
            return argv[index + 1]
    return None


def emit(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


session = arg("--session-id") or arg("--resume") or "learned-session"
model = arg("--model") or "claude-fake"

for line in sys.stdin:
    try:
        message = json.loads(line)
    except ValueError:
        continue
    if message.get("type") == "control_request":
        emit({"type": "control_response", "response": {
            "subtype": "success", "request_id": message["request_id"], "response": {}}})
        continue
    if message.get("type") != "user":
        continue
    content = message.get("message", {}).get("content")
    prompt = content if isinstance(content, str) else json.dumps(content)
    record = os.environ.get("FAKE_ENGINE_RECORD")
    if record:
        with open(record, "a") as fh:
            fh.write(json.dumps({"argv": argv, "cwd": os.getcwd(),
                                 "env": dict(os.environ), "prompt": prompt}) + "\n")
    if os.environ.get("FAKE_ENGINE_SLEEP"):
        time.sleep(float(os.environ["FAKE_ENGINE_SLEEP"]))
    tasks = os.environ.get("FAKE_ENGINE_TASKS")
    named = re.search(r"tasks activity ([0-9a-f-]{36})", prompt)
    failing = os.environ.get("FAKE_ENGINE_FAIL")
    if tasks and named and failing == "ordinary":
        subprocess.run([tasks, "activity", named.group(1), "tried and failed"],
                       capture_output=True, timeout=120)
    elif tasks and named and not failing:
        subprocess.run([tasks, "activity", named.group(1), "done by the stand-in"],
                       capture_output=True, timeout=120)
        subprocess.run([tasks, "set", named.group(1), "--status", "complete"],
                       capture_output=True, timeout=120)
    emit({"type": "system", "subtype": "init", "session_id": session,
          "apiKeySource": "none", "model": model, "claude_code_version": "2.1.280",
          "tools": [], "cwd": os.getcwd(),
          "permissionMode": arg("--permission-mode") or "default"})
    emit({"type": "result", "subtype": "error_during_execution" if failing else "success",
          "is_error": bool(failing),
          "duration_ms": 5, "duration_api_ms": 4, "num_turns": 1,
          "result": "the stand-in failed" if failing else "done",
          "session_id": session, "total_cost_usd": 0.01,
          "usage": {"input_tokens": 4, "output_tokens": 3,
                    "cache_read_input_tokens": 0, "cache_creation_input_tokens": 0},
          "modelUsage": {model: {"outputTokens": 3}}, "permission_denials": []})
sys.exit(0)
