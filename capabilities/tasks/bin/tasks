STATUSES = ("draft", "todo", "in_progress", "waiting", "complete", "closed")


def _homes() -> tuple[Path, Path, Path]:
    """The machine's config home, this capability's user credentials file in
    it, and the machine's state home, as the environment names them now."""
    config = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
    return (config, config / NAME / "credentials.env",
            Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state")))


_CONFIG_HOME, CREDENTIALS_ENV, _STATE_HOME = _homes()

