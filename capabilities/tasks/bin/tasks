# >>> contract: capability core (generated — edit contract/preamble.py, run `capabilities sync-contract`) >>>

# --- Error reporting ---------------------------------------------------------

def _die(exit_code: int, code: str, message: str,
         hint: str | None = None, status: int | None = None) -> NoReturn:
    err: dict = {"code": code, "message": message}
    if hint:
        err["hint"] = hint
    if status is not None:
        err["status"] = status
    sys.stderr.write(json.dumps({"error": err}, ensure_ascii=False) + "\n")
    sys.exit(exit_code)


def _emit(value) -> None:
    if isinstance(value, str):
        sys.stdout.write(value)
        if value and not value.endswith("\n"):
            sys.stdout.write("\n")
    else:
        sys.stdout.write(json.dumps(value, ensure_ascii=False, indent=2) + "\n")


# --- Project / file plumbing -------------------------------------------------

def _parse_env_file(path: Path) -> dict:
    """Parse a KEY=VALUE env/dotenv file. Missing/unreadable file -> {}."""
    out: dict = {}
    try:
        text = path.read_text()
    except OSError:
        return out
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        k = k.strip()
        if k.startswith("export "):
            k = k[len("export "):].strip()
        out[k] = v.strip().strip('"').strip("'")
    return out


def _project_root() -> Path | None:
    """Nearest project root, walking up from $CLAUDE_PROJECT_DIR (else cwd):
    the first directory holding capabilities/, legacy .capabilities/,
    .contextkit/config.toml, .env(.local), or .git.
    Markers are read from the filesystem alone: the root is what the envelope
    location is resolved against, so resolving one cannot depend on the other.
    $HOME is never a project root (the machine registry lives there)."""
    start = os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
    here = Path(start).resolve()
    home = Path.home().resolve()
    for d in (here, *here.parents):
        if d == home:
            return None
        # Either marker names a project. `settings.json` is the gate and
        # `project.json` the identity; a project keeping its records in the
        # store needs the second and may eventually stop carrying the first,
        # so neither is required while both worlds are in use.
        if ((d / "capabilities" / "settings.json").is_file()
                or (d / "capabilities" / "project.json").is_file()
                or (d / ".contextkit" / "config.toml").is_file()
                or (d / ".capabilities").is_dir()
                or (d / ".env").exists()
                or (d / ".env.local").exists() or (d / ".git").is_dir()):
            return d
    return None


_ENVELOPE_HOME: dict = {}


def _validated_project_envelope(root: Path, raw, provider: str) -> Path:
    """Validate the manager/context-owner answer without selecting a fallback."""
    value = str(raw or "").strip()
    if not value:
        _die(6, "project_envelope_empty",
             f"{provider} returned an empty capabilities envelope path")
    candidate = Path(value).expanduser()
    if not candidate.is_absolute():
        _die(6, "project_envelope_relative",
             f"{provider} returned a relative capabilities envelope path: {value!r}")
    try:
        resolved = candidate.resolve()
        resolved.relative_to(root.resolve())
    except (OSError, ValueError):
        _die(6, "project_envelope_outside_project",
             f"{provider} returned a capabilities envelope outside the project: {candidate}")
    return resolved


def _handed_off_envelope(root: Path) -> str:
    """The handoff meant for THIS project root, or "" when there is none.

    `CAPABILITIES_PROJECT_ENVELOPE` is inherited by every descendant process, and
    a descendant does not always stand in the project its parent stood in: a peer
    spawned in another project, or a worker whose cwd sits under a different root,
    must resolve its own envelope. `CAPABILITIES_PROJECT_ENVELOPE_ROOT` names the
    root the handed value answers for, so a handoff that crossed a project
    boundary is passed over instead of being applied to the wrong project. A
    handoff supplied without that companion belongs to whoever launched the
    process and is honored as given, which is how a context owner hands its answer
    over in advance.
    """
    override = os.environ.get("CAPABILITIES_PROJECT_ENVELOPE", "").strip()
    if not override:
        return ""
    scope = os.environ.get("CAPABILITIES_PROJECT_ENVELOPE_ROOT", "").strip()
    if not scope:
        return override
    try:
        if Path(scope).expanduser().resolve() != root.resolve():
            return ""
    except OSError:
        return ""
    return override


ENVELOPE_CACHE_VERSION = 1


def _envelope_cache_file(key: str) -> Path:
    """Where the manager records its answer for one absolute project root.

    The file name only buckets roots apart; the entry's own `root` field is what
    proves identity, so two roots landing in one bucket cost a miss rather than
    a wrong answer.
    """
    import zlib

    base = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache"))
    return (base / "capabilities" / "envelope"
            / f"{format(zlib.crc32(key.encode()), '08x')}.json")


def _envelope_witness(path) -> dict:
    """One input the envelope answer rests on, as that input stands right now."""
    try:
        seen = os.stat(path)
    except OSError:
        return {"path": str(path), "present": False}
    return {"path": str(path), "present": True,
            "size": seen.st_size, "mtime_ns": seen.st_mtime_ns}


def _cached_envelope(root: Path):
    """The recorded answer for this root while every input it rests on holds.

    The manager writes the record and names the inputs its answer consulted; a
    reader re-observes each of them and compares it whole. Anything at all in
    doubt — an unreadable file, an unexpected shape, an input that moved, an
    expiry already behind the clock or a write ahead of it — returns None and
    costs a full resolution, so the failure mode is slow and never wrong.
    """
    import time

    key = str(root.resolve())
    try:
        entry = json.loads(_envelope_cache_file(key).read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(entry, dict):
        return None
    if entry.get("version") != ENVELOPE_CACHE_VERSION or entry.get("root") != key:
        return None
    written, expires = entry.get("written_at"), entry.get("expires_at")
    if not isinstance(written, (int, float)) or not isinstance(expires, (int, float)):
        return None
    now = time.time()
    if now < written or now >= expires:
        return None
    witness = entry.get("witness")
    if not isinstance(witness, list):
        return None
    for observed in witness:
        if (not isinstance(observed, dict)
                or _envelope_witness(observed.get("path")) != observed):
            return None
    envelope = Path(str(entry.get("envelope") or ""))
    if not envelope.is_absolute():
        return None
    try:
        envelope.resolve().relative_to(key)
    except (OSError, ValueError):
        return None
    return envelope


def _manager_project_envelope(root: Path) -> Path:
    """Consume the capabilities manager's one authoritative project answer."""
    override = _handed_off_envelope(root)
    if override:
        return _validated_project_envelope(root, override, "environment handoff")

    import subprocess

    env = dict(os.environ)
    env["CLAUDE_PROJECT_DIR"] = str(root)
    manager = os.environ.get("CAPABILITIES_MANAGER_BIN", "").strip()
    if not manager:
        source_manager = Path(__file__).resolve().parents[3] / "bin" / "capabilities"
        manager = str(source_manager) if source_manager.is_file() else "capabilities"
    try:
        proc = subprocess.run(
            [manager, "path", "--json"], cwd=root, env=env,
            capture_output=True, text=True, timeout=10)
    except FileNotFoundError:
        _die(6, "capabilities_manager_unavailable",
             "the capabilities manager is required to resolve the project envelope",
             "install or repair the `capabilities` command")
    except subprocess.TimeoutExpired:
        _die(6, "capabilities_path_timeout",
             "the capabilities manager did not resolve the project envelope within 10 seconds")
    except OSError as exc:
        _die(6, "capabilities_manager_unavailable",
             f"could not run the capabilities manager: {exc}")
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip()
        try:
            error = json.loads(detail).get("error", {})
        except (AttributeError, ValueError):
            error = {}
        _die(proc.returncode if proc.returncode in (3, 4, 5, 6) else 6,
             str(error.get("code") or "capabilities_path_failed"),
             str(error.get("message") or "the capabilities manager could not resolve the project envelope"),
             str(error.get("hint") or detail or "run `capabilities path --json` for details"))
    try:
        answer = json.loads(proc.stdout)
    except ValueError as exc:
        _die(6, "capabilities_path_malformed",
             f"the capabilities manager returned invalid JSON: {exc}")
    if not isinstance(answer, dict):
        _die(6, "capabilities_path_malformed",
             "the capabilities manager path answer must be a JSON object")
    manager_root = Path(str(answer.get("project_root") or ""))
    if not manager_root.is_absolute() or manager_root.resolve() != root.resolve():
        _die(6, "capabilities_project_mismatch",
             "the capabilities manager resolved a different project root")
    provider = str(answer.get("provider") or "capabilities manager")
    return _validated_project_envelope(
        root, answer.get("project_envelope"), provider)


def _envelope_home(root: Path) -> Path:
    """The project's envelope root, resolved once per invocation.

    The capabilities manager owns project-envelope discovery, including any
    delegation to ContextKit. Capability CLIs consume that answer and never
    duplicate context-owner detection.

    The answer is then handed to this process's descendants, scoped to the root
    it answers for. Asking for it costs two interpreter starts — the manager and
    the context owner it delegates to — so a worker, a peer, or a nested
    capability call that would otherwise repeat the whole chain under whatever
    load the machine is under by then reads it instead.

    A fresh top-level call has no such handoff, and reads the manager's recorded
    answer for this root instead, which stands only while every input that answer
    rests on is unchanged. A live handoff outranks the record, and any doubt about
    the record asks the manager again.
    """
    cached = _ENVELOPE_HOME.get(root)
    if cached is not None:
        return cached
    home = None if _handed_off_envelope(root) else _cached_envelope(root)
    if home is None:
        home = _manager_project_envelope(root)
    _ENVELOPE_HOME[root] = home
    os.environ["CAPABILITIES_PROJECT_ENVELOPE"] = str(home)
    os.environ["CAPABILITIES_PROJECT_ENVELOPE_ROOT"] = str(root)
    return home


def _project_capabilities_dir(root: Path) -> Path:
    """The active project envelope root.

    The resolved envelope is canonical. A legacy `.capabilities/` remains
    readable until `capabilities init` migrates it. If both exist, the canonical
    tree wins once it carries either the legacy file gate or the project identity;
    otherwise the legacy configured tree remains active so merely creating an
    empty visible directory loses no gate.
    """
    current = _envelope_home(root)
    legacy = root / ".capabilities"
    if ((current / "settings.json").is_file()
            or (current / "project.json").is_file()
            or not legacy.is_dir()):
        return current
    return legacy


def _project_env() -> dict:
    """Project .env(.local) at the project root. .env.local overrides .env."""
    root = _project_root()
    if root is None:
        return {}
    merged = _parse_env_file(root / ".env")
    merged.update(_parse_env_file(root / ".env.local"))  # .local wins
    return merged


def _auth_context() -> dict | None:
    """Optional runtime authority envelope passed by an ingress/service.

    Absence means the ordinary project gate is the whole policy. Presence means
    a request-scoped authority layer exists and must fail closed before any
    credential or network work happens.
    """
    raw = os.environ.get("CAPABILITIES_AUTH_CONTEXT")
    if not raw:
        return None
    try:
        if raw.lstrip().startswith("{"):
            data = json.loads(raw)
        else:
            data = json.loads(Path(raw).read_text())
    except (OSError, ValueError) as e:
        _die(4, "auth_context_unreadable",
             "runtime authority context could not be read",
             f"{raw}: {e}")
    if not isinstance(data, dict):
        _die(4, "auth_context_invalid",
             "runtime authority context is not an object")
    return data


def _auth_capability_allowed(rule) -> bool:
    if rule is True or rule == "*":
        return True
    if rule in (False, None):
        return False
    if isinstance(rule, dict):
        if rule.get("deny") is True:
            return False
        if rule.get("enabled") is False or rule.get("allow") is False:
            return False
        return True
    return False


def _auth_gate() -> None:
    ctx = _auth_context()
    if ctx is None:
        return
    allowed = ctx.get("allowed_capabilities")
    if allowed is None:
        return
    if allowed is True or allowed == "*":
        return
    if isinstance(allowed, list):
        if NAME in allowed or "*" in allowed:
            return
    elif isinstance(allowed, dict):
        if _auth_capability_allowed(allowed.get(NAME, allowed.get("*"))):
            return
    else:
        _die(4, "auth_context_invalid",
             "runtime authority context has invalid allowed_capabilities")
    source = ctx.get("source") or "runtime"
    role = ctx.get("sender_role") or ctx.get("role") or "unknown"
    chat = ctx.get("chat_id") or "unknown"
    _die(4, "capability_not_authorized",
         f"{NAME} is not authorized for this {source} request",
         f"role={role}; chat_id={chat}; adjust runtime authority policy instead of bypassing the gate")


def _policy_row():
    """The effective policy row from the same records adapter as everything else."""
    try:
        row = _records().resolve("capabilities", "policy").get(NAME)
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)
    if row is None:
        return None
    entry = row.get("value")
    if (not isinstance(entry, dict) or set(entry) != {"enabled"}
            or not isinstance(entry.get("enabled"), bool)):
        _die(6, "bad_policy",
             f"invalid {NAME} policy entry in {_records().source}",
             'expected {"enabled": true|false}')
    return row


def _project_enabled_explicitly() -> bool:
    """True only for an explicit project enabled entry; global inheritance is
    deliberately insufficient for project-owned service activation."""
    row = _policy_row()
    return bool(row and row.get("scope") == "project"
                and row["value"].get("enabled") is True)


def _require_project_enabled_for_service() -> Path:
    root = _project_root()
    if root is None or not _project_enabled_explicitly():
        _die(4, "project_enable_required",
             f"{NAME} service activation requires an explicit project enable",
             f"ask the user, then run `capabilities enable {NAME} --project` "
             "before service init/start/run")
    return root


def _gate() -> None:
    """Project policy overrides global policy; absence inherits, and absence at
    both scopes is default deny. Safe local discovery verbs remain available so
    a disabled capability can be understood and configured before use.

    If an ingress supplied CAPABILITIES_AUTH_CONTEXT, that request-scoped gate
    is stricter and runs first, before credentials or network calls.
    """
    _auth_gate()
    verb = sys.argv[1] if len(sys.argv) > 1 else "help"
    service_action = sys.argv[2] if len(sys.argv) > 2 else None
    service_contract = globals().get("SERVICE")
    if isinstance(service_contract, dict) and verb == "service" \
            and service_action in {"init", "start", "run"}:
        _require_project_enabled_for_service()
    if verb in {"help", "stub", "manifest", "connections"}:
        return
    row = _policy_row()
    entry = row.get("value") if row else None
    scope = row.get("scope") if row else None
    if isinstance(entry, dict) and entry.get("enabled") is True:
        return
    if isinstance(entry, dict) and entry.get("enabled") is False and scope == "project":
        _die(4, "disabled",
             f"{NAME} is disabled in this project ({_records().source})",
             f"ask the user whether to enable {NAME} for this project; if yes, "
             f"run `capabilities enable {NAME} --project`")
    if isinstance(entry, dict) and entry.get("enabled") is False:
        message = f"{NAME} is disabled globally ({_records().source})"
    else:
        message = f"{NAME} is not enabled by project or global policy"
    _die(4, "not_enabled", message,
         f"ask the user whether to enable {NAME} only for this project or "
         f"globally for every project; then run `capabilities enable {NAME} "
         "--project` or `--global` exactly as requested")


def _env_dir() -> Path | None:
    """The capability's envelope dir in the project's active capabilities/."""
    root = _project_root()
    return (_project_capabilities_dir(root) / NAME) if root is not None else None


_RECORDS = None


def _store_source_label() -> str:
    """A credential-free label for the store that answered.

    Core-only capabilities need this just as much as connection-bearing ones,
    so it belongs with the records adapter rather than in the connections tier.
    """
    url = os.environ.get("CAPABILITIES_STORE_URL") or "?"
    if "://" not in url:
        return f"store(sqlite:{url})"
    scheme, rest = url.split("://", 1)
    if "@" in rest:
        rest = rest.split("@", 1)[1]
    return f"store({scheme}://{rest.split('?', 1)[0]})"


def _records():
    """The adapter this project's records are read and written through.

    Everything below takes what this returns and none of it can tell which it
    got. That is the whole of the arrangement: a call site that can tell where
    a record lives is a call site that will eventually decide for itself, and
    then there are two answers to a question that has one."""
    global _RECORDS
    if _RECORDS is None:
        root = _project_root()
        envelope = (_project_capabilities_dir(root) if root is not None
                    else _CONFIG_HOME / "no-project")
        try:
            project_only = os.environ.get("CAPABILITIES_RECORDS_PROJECT_ONLY", "") \
                .strip().lower() in ("1", "true", "yes", "on")
            _RECORDS = open_records(
                envelope, _CONFIG_HOME, project_only=project_only)
        except StoreError as e:
            _die(6, e.slug, e.message, e.hint)
        if _RECORDS.mode == "db":
            _RECORDS.source = _store_source_label()
    return _RECORDS


def _store_mode() -> tuple[str, str]:
    """Where this project keeps its records, as a report rather than a fork.

    Nothing branches on this any more; it is here because a status surface may
    still want to say which source answered. One project may be moved without moving any other, so the answer is
    per project and lives beside the project's identity — it has to be readable
    before the store is reachable.

    The declaration itself is read in one place, `records_mode`, and acted on
    in one place, `open_records`."""
    adapter = _records()
    return (adapter.mode, adapter.source)


def _project_identity() -> dict:
    root = _project_root()
    if root is None:
        _die(6, "no_project", "no project here to resolve records for")
    identity_file = _project_capabilities_dir(root) / "project.json"
    try:
        identity = json.loads(identity_file.read_text())
    except (OSError, ValueError) as e:
        _die(6, "no_project_identity", f"cannot read {identity_file}: {e}",
             "run `capabilities init` in the project")
    if not identity.get("slug"):
        _die(6, "no_project_identity", f"{identity_file} declares no slug")
    return identity


def _state_dir() -> Path:
    """State follows the scope of the credentials that minted it; project state
    lands inside the envelope only where capabilities/ already exists."""
    if SCOPE == "project":
        root = _project_root()
        if root is not None:
            envelope = _project_capabilities_dir(root)
            if ((envelope / "project.json").is_file()
                    or (envelope / "settings.json").is_file()):
                return envelope / NAME / "state"
    return _STATE_HOME / NAME


# --- Capability contract — the declaration surface --------------------------

def _docs_base() -> str:
    key = f"{NAME.upper()}_DOCS_BASE"
    return (_project_env().get(key)
            or _parse_env_file(CREDENTIALS_ENV).get(key)
            or os.environ.get(key)
            or DOCS_BASE)


def _guide_dir() -> Path:
    executable = Path(__file__).resolve()
    bundle = (executable.parent.parent
              if executable.parent.name == "bin" else executable.parent)
    return bundle / "guides"


def _guide_menu() -> list[dict[str, str]]:
    menu = []
    guide_dir = _guide_dir()
    files = sorted(guide_dir.glob("*.md")) if guide_dir.is_dir() else []
    for path in files:
        lines = path.read_text().splitlines()
        title = ""
        title_index = -1
        for index, line in enumerate(lines):
            if line.startswith("# "):
                title = line[2:].strip()
                title_index = index
                break
        paragraph = []
        for line in lines[title_index + 1:]:
            stripped = line.strip()
            if not stripped:
                if paragraph:
                    break
                continue
            if stripped.startswith("#"):
                break
            paragraph.append(stripped)
        topic = path.stem
        menu.append({
            "topic": topic,
            "title": title,
            "preview": " ".join(paragraph),
            "command": f"{NAME} guide {topic}",
        })
    return menu


def _cmd_guide(argv: list[str]) -> None:
    menu = _guide_menu()
    if not argv:
        _emit(menu); return
    topic = argv[0]
    topics = {entry["topic"] for entry in menu}
    if topic not in topics:
        _die(3, "not_found", f"no guide topic {topic!r}",
             f"run `{NAME} guide` to list available guides")
    import urllib.error as _ue
    import urllib.request as _ur
    url = _docs_base().rstrip("/") + "/" + topic + ".md"
    cache_dir = _STATE_HOME / NAME / "guides"
    cache, etag_f = cache_dir / f"{topic}.md", cache_dir / f"{topic}.etag"
    headers = {}
    if cache.exists() and etag_f.exists():
        headers["If-None-Match"] = etag_f.read_text().strip()
    try:
        req = _ur.Request(url, headers=headers)
        with _ur.urlopen(req, timeout=10.0) as resp:
            text = resp.read().decode(resp.headers.get_content_charset() or "utf-8")
            cache_dir.mkdir(parents=True, exist_ok=True)
            cache.write_text(text)
            if resp.headers.get("etag"):
                etag_f.write_text(resp.headers["etag"])
            _emit(text); return
    except _ue.HTTPError as e:
        if e.code == 304 and cache.exists():
            _emit(cache.read_text()); return
        if e.code == 404:
            _die(3, "not_found", f"guide {topic!r} missing upstream", url)
        err = f"upstream returned {e.code}"
    except _ue.URLError as e:
        err = str(e.reason)
    except OSError as e:
        err = str(e)
    if cache.exists():
        sys.stderr.write(json.dumps(
            {"warning": f"upstream unreachable; serving cached copy ({err})"},
            ensure_ascii=False) + "\n")
        _emit(cache.read_text()); return
    _die(5, "network_error", f"could not fetch guide {topic!r}; no cache exists", url)


def _render_ids_markdown(data: dict) -> str:
    """Render the {label: {value, note}} envelope as the labelled markdown
    list the manager's `capabilities ids <NAME>` also produces — one shared
    format across the ids surface and the identifiers section of `help`."""
    lines: list[str] = []
    for label, entry in sorted(data.items()):
        entry = entry if isinstance(entry, dict) else {"value": entry}
        v = entry.get("value")
        vs = f"`{v}`" if isinstance(v, str) else "`" + json.dumps(v, ensure_ascii=False) + "`"
        line = f"- **{label}**: {vs}"
        note = entry.get("note")
        if note:
            line += f" — {note}"
        lines.append(line)
    return "\n".join(lines)


def _identifiers_scopes() -> "Scopes":
    identity = _project_identity()
    return Scopes(project=identity["slug"])


def _identifiers_load() -> dict:
    """The identifiers envelope, from wherever this project keeps its records.

    The shape is the same either way — `{label: {value, note}}` — so the help
    section, the report and `ids get` never learn which answered."""
    try:
        resolved = _records().resolve(NAME, "identifier")
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)
    return {label: {"note": row["note"] or "", "value": row["value"]}
            for label, row in sorted(resolved.items())}


def _identifiers_write(label: str, value, note: str) -> None:
    """Rule 15 holds either way: a capability is the sole writer of its own
    identifiers, addressed by (capability, collection) rather than by path."""
    kept = note or (_identifiers_load().get(label) or {}).get("note", "")
    try:
        _records().set(NAME, "identifier", label, value,
                       actor=f"{NAME} ids set", note=kept or None)
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)


def _identifiers_remove(label: str) -> None:
    try:
        _records().delete(NAME, "identifier", label)
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)


def _identifiers_section() -> str:
    """The Identifiers block appended to the bare top-level help — deterministic
    first-touch surfacing of `capabilities/<NAME>/identifiers.json` so an
    agent following the `<NAME> help` startup protocol loads the discovered
    labels/values/notes into context at once. Empty when no project envelope
    or nothing recorded (do not bloat help with an empty section)."""
    data = _identifiers_load()
    if not data:
        return ""
    header = (
        "\n═══ Identifiers ═════════════════════════════════════════════════════════════\n\n"
        f"Structural lookups discovered for `{NAME}` in this project. Fetch a single\n"
        f"raw value with `{NAME} ids get <label>`; the full envelope is also at\n"
        f"`capabilities ids {NAME}`.\n\n"
    )
    return header + _render_ids_markdown(data) + "\n"


def _cmd_help() -> None:
    """Bare top-level help: the CLI's HELP body (module-level `HELP` if
    defined, else the module docstring), then the project's Identifiers
    section. Only fires when no extra args follow — per-verb help stays
    untouched so `<NAME> help <subcommand>` is not intercepted."""
    g = globals()
    text = g.get("HELP") or g.get("__doc__") or ""
    if text.startswith("\n"):
        text = text.lstrip("\n")
    sys.stdout.write(text)
    if text and not text.endswith("\n"):
        sys.stdout.write("\n")
    section = _identifiers_section()
    if section:
        sys.stdout.write(section)


def _cmd_ids(argv: list[str]) -> None:
    sub = argv[0] if argv else "list"
    data = _identifiers_load()
    if sub == "list":
        _emit(data); return
    if sub == "get":
        if len(argv) < 2 or argv[1] not in data:
            _die(3, "not_found", "unknown identifier label",
                 f"`{NAME} ids list` shows the labels")
        _emit((data[argv[1]] or {}).get("value")); return
    if sub == "set":
        if len(argv) < 3:
            _die(6, "input", f"usage: {NAME} ids set <label> <value> [--note <text>]")
        label, raw = argv[1], argv[2]
        try:
            value = json.loads(raw)
        except ValueError:
            value = raw
        note = ""
        if "--note" in argv:
            ni = argv.index("--note")
            if ni + 1 >= len(argv):
                _die(6, "input", "--note needs a value")
            note = argv[ni + 1]
        _identifiers_write(label, value, note)
        _emit({"set": label}); return
    if sub == "rm":
        if len(argv) < 2 or argv[1] not in data:
            _die(3, "not_found", "unknown identifier label",
                 f"`{NAME} ids list` shows the labels")
        _identifiers_remove(argv[1])
        _emit({"removed": argv[1]}); return
    _die(6, "input", f"unknown ids subcommand {sub!r}", f"{NAME} ids list|get|set|rm")


REFERENCE_PREFIX = "reference."


def _front_matter(body: str) -> tuple[str | None, str | None]:
    """`name` and `description` out of a reference's leading front matter."""
    lines = body.splitlines()
    if not lines or lines[0].strip() != "---":
        return None, None
    name = desc = None
    for line in lines[1:30]:
        if line.strip() == "---":
            break
        if line.startswith("name:"):
            name = line.split(":", 1)[1].strip()
        elif line.startswith("description:"):
            desc = line.split(":", 1)[1].strip()
    return name, desc


def _reference_bodies() -> dict[str, str]:
    """Every reference this project can see, keyed by its document key.

    In the store a reference is a pinned document like any other long text, so
    an edit reaches every host at once and an unpinned draft reaches none."""
    out: dict[str, str] = {}
    try:
        adapter = _records()
        for key in adapter.document_keys(NAME):
            if not key.startswith(REFERENCE_PREFIX):
                continue
            doc = adapter.document_read(NAME, key)
            if doc:
                out[key] = doc["body"]
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)
    return out


def _cmd_refs(argv: list[str] | None = None) -> None:
    """`refs` lists what this project can load; `refs show <name>` prints one.

    The listing carries a `source` rather than a path, because a reference kept
    in the store has no path to open — `refs show` is the one way to read a
    body that works whichever source answered."""
    argv = argv or []
    bodies = _reference_bodies()
    adapter = _records()
    entries = []
    for key, body in sorted(bodies.items()):
        name, desc = _front_matter(body)
        if not name:
            continue
        entry = {"name": name, "description": desc or "", "key": key}
        # A path when there is one to open, a source when there is not. The
        # adapter answers that; the listing does not ask where it lives.
        path = adapter.document_path(NAME, key)
        if path is None:
            entry["source"] = adapter.source
        else:
            entry["path"] = str(path)
        entries.append((name, entry, body))

    if argv and argv[0] == "show":
        if len(argv) < 2:
            _die(6, "input", f"usage: {NAME} refs show <name>")
        wanted = argv[1]
        for name, entry, body in entries:
            if wanted in (name, entry["key"], entry["key"][len(REFERENCE_PREFIX):]):
                sys.stdout.write(body if body.endswith("\n") else body + "\n")
                return
        _die(3, "not_found", f"no reference named {wanted!r}",
             f"`{NAME} refs` lists them")
    if argv:
        _die(6, "input", f"unknown refs subcommand {argv[0]!r}", f"{NAME} refs [show <name>]")
    _emit([entry for _name, entry, _body in entries])


def _context_edit_files(key: str) -> tuple[Path, Path]:
    token = hashlib.sha256(f"{NAME}\0{key}".encode()).hexdigest()[:16]
    root = _state_dir() / "record-edits"
    return root / f"{token}.md", root / f"{token}.json"


def _cmd_context(argv: list[str]) -> None:
    """Read or edit project long text without exposing its backend."""
    sub = argv[0] if argv else "list"
    adapter = _records()
    if sub == "list":
        _emit({"documents": adapter.document_keys(NAME),
               "records": {"mode": adapter.mode, "source": adapter.source}})
        return
    if len(argv) < 2:
        _die(6, "input", f"usage: {NAME} context show|edit|put <key>")
    key = argv[1]
    if sub == "show":
        doc = adapter.document_read(NAME, key)
        if doc is None:
            _die(3, "not_found", f"no context document {key!r}",
                 f"`{NAME} context list` shows the keys")
        sys.stdout.write(doc["body"] if doc["body"].endswith("\n")
                         else doc["body"] + "\n")
        return
    work, meta = _context_edit_files(key)
    if sub == "edit":
        doc = adapter.document_read(NAME, key)
        direct = adapter.document_path(NAME, key)
        base = doc["hash"] if doc else None
        path = direct or work
        if direct is None:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(doc["body"] if doc else "")
        meta.parent.mkdir(parents=True, exist_ok=True)
        meta.write_text(json.dumps({"key": key, "path": str(path),
                                    "base": base, "direct": direct is not None},
                                   ensure_ascii=False, indent=2) + "\n")
        _emit({"key": key, "path": str(path), "base": base,
               "records": {"mode": adapter.mode, "source": adapter.source},
               "next": f"edit the path, then run `{NAME} context put {key}`"})
        return
    if sub == "put":
        try:
            checkout = json.loads(meta.read_text())
        except (OSError, ValueError) as exc:
            _die(6, "edit_not_started",
                 f"no valid edit checkout for {key!r}: {exc}",
                 f"run `{NAME} context edit {key}` first")
        if checkout.get("key") != key:
            _die(6, "edit_mismatch", f"edit checkout does not belong to {key!r}")
        path = Path(str(checkout.get("path") or ""))
        try:
            body = path.read_text()
            version = adapter.document_put(
                NAME, key, body, author=f"{NAME} context put",
                media_type="text/markdown", base=checkout.get("base"))
        except OSError as exc:
            _die(6, "edit_unreadable", f"cannot read edit path {path}: {exc}")
        except StoreError as exc:
            _die(6, exc.slug, exc.message, exc.hint)
        meta.unlink(missing_ok=True)
        if not checkout.get("direct"):
            path.unlink(missing_ok=True)
        _emit({"put": key, "version": version,
               "records": {"mode": adapter.mode, "source": adapter.source}})
        return
    _die(6, "input", f"unknown context subcommand {sub!r}",
         f"{NAME} context list|show|edit|put")


def _contract(argv: list[str]) -> None:
    """Dispatch the contract verbs; domain verbs fall through to the CLI's own
    parser. Runs after _gate(), before any credential is resolved.

    `help` is a contract verb only when bare (no extra args) — the top-level
    dump plus the Identifiers section. `<NAME> help <subcommand>` falls
    through to the CLI so per-verb help stays clean."""
    cmd = argv[0] if argv else ""
    if cmd == "stub":
        _emit(f"{SUMMARY} Run `{NAME} help`.")
    elif cmd == "manifest":
        _emit({"name": NAME, "summary": SUMMARY,
               "credentials": {"scope": SCOPE, "keys": CRED_KEYS},
               "docs": {"base": DOCS_BASE,
                        "topics": [entry["topic"] for entry in _guide_menu()]},
               "state": STATE, "post_install": POST_INSTALL})
    elif cmd == "guide":
        _cmd_guide(argv[1:])
    elif cmd == "ids":
        _cmd_ids(argv[1:])
    elif cmd == "refs":
        _cmd_refs(argv[1:])
    elif cmd == "context":
        _cmd_context(argv[1:])
    elif cmd == "connections":
        _cmd_connections()
    elif cmd == "help" and len(argv) == 1:
        _cmd_help()
    else:
        return
    sys.exit(0)

# <<< contract: capability core <<<

# >>> contract: store (generated — edit contract/store.py, run `capabilities sync-contract`) >>>
# A region carries what it needs. Relying on the host file to have imported
# the right names is a coupling nothing checks and nothing reports: it works in
# whichever capability happened to import them and fails at import time in the
# rest. Re-importing a name the host already has costs nothing.
import json
import os
import hashlib
import re
import sqlite3
import time
from collections.abc import Iterator, Sequence
from contextlib import contextmanager
from datetime import datetime as _store_datetime
from datetime import timedelta as _store_timedelta
from datetime import timezone as _store_timezone
from pathlib import Path
from typing import Any
from urllib.parse import urlparse
from uuid import uuid4


SCHEMA_VERSION = 4

# Two scopes and no more: a record either belongs to one project or to
# every project. `project_id` is null in the second case, which is what
# "global" means and the only thing it means.
SCOPE_KINDS = ("global", "project")

FIRST = "first"
MERGE = "merge"
EXACT = "exact"

# The collection registry: how each resolves, and who is allowed to write it.
# Adding a collection here is the only place a new record class is declared.
#
# `connection` and `grant` are the same fact split along the seam that matters:
# an entry's identity — where the thing is and how to reach it — is a fact about
# the world, the same in every project forever. What a project may DO with that
# identity is a decision, different per project by definition. Glued together,
# the second cannot be overridden without restating the first; apart, a project
# that needs write access writes one grant row and repeats no address, no host,
# no secret.
#
# An identity is atomic: it merges by entry, never by field, so no connection is
# ever assembled from two scopes. That is what rule 18's "never merged" was
# protecting, and it survives; what it gives up is refusing to let a project add
# to the global set at all.
COLLECTIONS: dict[str, dict[str, str]] = {
    "connection": {"resolve": MERGE, "writer": "human"},
    "grant": {"resolve": MERGE, "writer": "human"},
    "identifier": {"resolve": MERGE, "writer": "capability"},
    "setting": {"resolve": MERGE, "writer": "human"},
    "policy": {"resolve": MERGE, "writer": "manager"},
    # A document row holds no text — it holds the hash of the version currently
    # in force. Keeping the pin here rather than in the documents table is what
    # makes it scoped and merged like everything else, so a project may run a
    # different version of a globally declared prompt without copying it.
    "document": {"resolve": MERGE, "writer": "human"},
}

# Grant fields and what they mean when nothing declares them. `allow_write`
# falls back to the capability's own WRITE_DEFAULT rather than to a value here,
# because "does a write leave the system" is the capability's fact.
GRANT_FIELDS = ("enabled", "allow_write")

# A document version is named by the first twelve hex characters of its sha256.
# Forty-eight bits is far more than a project's worth of prose needs, and a name
# a person can read at a glance is worth more than headroom nobody will reach.
# What makes the truncation safe is not the arithmetic but `document_put`, which
# refuses a hash that already names different text rather than keeping the older
# body and serving it under the newer name.
HASH_LENGTH = 12

# A key is a label a human chose, and for a mailbox that label is naturally an
# email address — so `@` and `+` belong here. What stays out is whitespace,
# separators and anything that would make a key ambiguous to address.
KEY_RE = re.compile(r"[a-z0-9][a-z0-9._@+-]{0,127}", re.IGNORECASE)
CAPABILITY_RE = re.compile(r"[a-z][a-z0-9-]{0,63}")


class StoreError(Exception):
    """Every failure this tier reports. Carries a slug the caller maps to an
    exit code, so the CLI's error envelope stays the capability's own."""

    def __init__(self, slug: str, message: str, hint: str | None = None):
        super().__init__(message)
        self.slug = slug
        self.message = message
        self.hint = hint


def _now() -> str:
    return _store_datetime.now(_store_timezone.utc).isoformat(timespec="seconds")


def _now_exact() -> str:
    """Microsecond resolution, for the one place order matters. A revision log
    read newest-first used to break ties on a monotonic integer id; a uuid does
    not order, so the timestamp has to carry the ordering itself."""
    return _store_datetime.now(_store_timezone.utc).isoformat(timespec="microseconds")


def _store_check(name: str, value: str, pattern: re.Pattern) -> str:
    if not isinstance(value, str) or not pattern.fullmatch(value):
        raise StoreError("bad_name", f"{name} {value!r} must match {pattern.pattern}")
    return value


def _check_scope(kind: str, name: str) -> tuple[str, str]:
    if kind not in SCOPE_KINDS:
        raise StoreError("bad_scope", f"scope kind {kind!r} must be one of {', '.join(SCOPE_KINDS)}")
    if kind == "global":
        if name:
            raise StoreError("bad_scope", "the global scope takes no name")
        return kind, ""
    if not name:
        raise StoreError("bad_scope", f"the {kind} scope requires a name")
    return kind, name


class Scopes:
    """Which scopes a capability resolves against, highest precedence first.

    Carries the project's SLUG, because that is the handle a person and a
    project file both use. The store turns it into the project's id once and
    everything downstream joins on that: the name is the way in, the id is what
    rows hold."""

    def __init__(self, project: str | None = None, include_global: bool = True):
        self.project = project or None
        self.include_global = bool(include_global)

    @classmethod
    def from_env(cls, project: str | None = None,
                 include_global: bool = True) -> "Scopes":
        return cls(project=project or os.environ.get("CAPABILITIES_PROJECT") or None,
                   include_global=include_global)

    def write_target(self, scope: str | None) -> tuple[str, str | None]:
        """Where a write lands, as (scope, project slug). A write never guesses
        a scope it was given no name for."""
        kind = scope or "project"
        if kind == "global":
            return ("global", None)
        if kind == "project":
            if not self.project:
                raise StoreError("no_project_scope", "no project scope is in effect",
                                 "set CAPABILITIES_PROJECT or pass --scope global")
            return ("project", self.project)
        raise StoreError("bad_scope", f"scope {kind!r} must be one of {', '.join(SCOPE_KINDS)}")

    def __repr__(self) -> str:
        return (f"Scopes(project={self.project!r}, "
                f"include_global={self.include_global!r})")



# --- Schema ------------------------------------------------------------------

# Portable DDL. `{json}` and `{now}` are the only dialect substitutions; every
# other construct below is common to SQLite >= 3.35 and PostgreSQL >= 12.
_DDL = [
    """
    CREATE TABLE IF NOT EXISTS store_meta (
        namespace   TEXT PRIMARY KEY,
        version     INTEGER NOT NULL,
        updated_at  TEXT NOT NULL
    )
    """,
    # A project is looked up by the slug it declares for itself; everything
    # else refers to it by id. The slug is the handle a person types, the id is
    # what a row holds, and neither has to do the other's job.
    """
    CREATE TABLE IF NOT EXISTS projects (
        id          TEXT PRIMARY KEY,
        slug        TEXT NOT NULL UNIQUE,
        name        TEXT,
        created_at  TEXT NOT NULL
    )
    """,
    # Where a project sits is a fact about a machine, not about the project.
    """
    CREATE TABLE IF NOT EXISTS project_paths (
        id          TEXT PRIMARY KEY,
        project_id  TEXT NOT NULL REFERENCES projects(id),
        instance    TEXT NOT NULL,
        path        TEXT NOT NULL,
        updated_at  TEXT NOT NULL,
        UNIQUE (project_id, instance)
    )
    """,
    """
    CREATE TABLE IF NOT EXISTS config (
        id          TEXT PRIMARY KEY,
        scope       TEXT NOT NULL,
        project_id  TEXT REFERENCES projects(id),
        capability  TEXT NOT NULL,
        collection  TEXT NOT NULL,
        key         TEXT NOT NULL,
        value       {json} NOT NULL,
        note        TEXT,
        updated_at  TEXT NOT NULL,
        updated_by  TEXT
    )
    """,
    # NULL compares unequal to NULL in a UNIQUE constraint, in both engines, so
    # a global row would not collide with another global row. The COALESCE makes
    # the absence of a project a value like any other.
    """
    CREATE UNIQUE INDEX IF NOT EXISTS config_identity_idx ON config (
        scope, COALESCE(project_id, ''), capability, collection, key
    )
    """,
    """
    CREATE INDEX IF NOT EXISTS config_lookup_idx
        ON config (capability, collection, scope, project_id)
    """,
    """
    CREATE TABLE IF NOT EXISTS state (
        id          TEXT PRIMARY KEY,
        scope       TEXT NOT NULL,
        project_id  TEXT REFERENCES projects(id),
        capability  TEXT NOT NULL,
        key         TEXT NOT NULL,
        value       {json} NOT NULL,
        updated_at  TEXT NOT NULL,
        expires_at  TEXT
    )
    """,
    """
    CREATE UNIQUE INDEX IF NOT EXISTS state_identity_idx ON state (
        scope, COALESCE(project_id, ''), capability, key
    )
    """,
    """
    CREATE INDEX IF NOT EXISTS state_expiry_idx ON state (expires_at)
    """,
    """
    CREATE TABLE IF NOT EXISTS revisions (
        id          TEXT PRIMARY KEY,
        scope       TEXT NOT NULL,
        project_id  TEXT REFERENCES projects(id),
        capability  TEXT NOT NULL,
        collection  TEXT NOT NULL,
        key         TEXT NOT NULL,
        old_value   {json},
        new_value   {json},
        actor       TEXT,
        written_at  TEXT NOT NULL
    )
    """,
    """
    CREATE INDEX IF NOT EXISTS revisions_target_idx
        ON revisions (capability, collection, key, written_at)
    """,
    # Long text of any kind — a prompt, a reference, an automation's script.
    # Versions accumulate and are named by the hash of their own content; which
    # one is in force is the `active` flag on the row itself, so the answer sits
    # in the table anyone would look in rather than in a pin somewhere else.
    """
    CREATE TABLE IF NOT EXISTS context (
        id          TEXT PRIMARY KEY,
        scope       TEXT NOT NULL,
        project_id  TEXT REFERENCES projects(id),
        capability  TEXT NOT NULL,
        key         TEXT NOT NULL,
        hash        TEXT NOT NULL,
        body        TEXT NOT NULL,
        media_type  TEXT,
        active      INTEGER NOT NULL DEFAULT 0,
        author      TEXT,
        created_at  TEXT NOT NULL
    )
    """,
    """
    CREATE UNIQUE INDEX IF NOT EXISTS context_version_idx ON context (
        scope, COALESCE(project_id, ''), capability, key, hash
    )
    """,
    # At most one version of one item is in force in one scope, and the database
    # is what says so — not a convention the writers are trusted to keep.
    """
    CREATE UNIQUE INDEX IF NOT EXISTS context_one_active_idx ON context (
        scope, COALESCE(project_id, ''), capability, key
    ) WHERE active = 1
    """,
    """
    CREATE INDEX IF NOT EXISTS context_history_idx
        ON context (capability, key, created_at)
    """,
]


def _uuid() -> str:
    return str(uuid4())


# --- The repository ----------------------------------------------------------

class Store:
    """The persistence interface every capability sees. Two adapters implement
    it; no capability ever writes SQL, which is the single discipline that keeps
    both backends honest."""

    dialect = "abstract"

    # -- lifecycle ------------------------------------------------------------

    def __init__(self, conn: Any):
        self._conn = conn

    @property
    def connection(self) -> Any:
        return self._conn

    def close(self) -> None:
        self._conn.close()

    def __enter__(self) -> "Store":
        return self

    def __exit__(self, *exc: object) -> None:
        self.close()

    # -- dialect hooks --------------------------------------------------------

    def _sql(self, sql: str) -> str:
        raise NotImplementedError

    def _encode(self, value: Any) -> Any:
        raise NotImplementedError

    def _decode(self, raw: Any) -> Any:
        raise NotImplementedError

    def _execute(self, sql: str, params: Sequence[Any] = ()) -> Any:
        cur = self._conn.cursor()
        cur.execute(self._sql(sql), tuple(params))
        return cur

    @contextmanager
    def transaction(self) -> Iterator[None]:
        try:
            yield
        except Exception:
            self._conn.rollback()
            raise
        self._conn.commit()

    # -- schema ---------------------------------------------------------------

    def migrate(self, namespace: str = "core", version: int = SCHEMA_VERSION,
                steps: Sequence[str] | None = None) -> int:
        """Bring `namespace` up to `version`. The core namespace owns the tables
        above; a capability passes its own namespace and additive steps.

        Refuses a step that drops or narrows, because two hosts on different
        capability versions share this database and the older one must survive
        the newer one's migration."""
        _store_check("namespace", namespace, CAPABILITY_RE)
        with self.transaction():
            self._execute(_DDL[0].format(**self._ddl_subs()))
            cur = self._execute("SELECT version FROM store_meta WHERE namespace = ?", (namespace,))
            row = cur.fetchone()
            have = int(row[0]) if row else 0
            if have >= version:
                return have
            body = list(_DDL[1:]) if namespace == "core" and steps is None else list(steps or [])
            for step in body:
                self._guard_additive(step)
                self._execute(step.format(**self._ddl_subs()))
            if row:
                self._execute("UPDATE store_meta SET version = ?, updated_at = ? WHERE namespace = ?",
                              (version, _now(), namespace))
            else:
                self._execute("INSERT INTO store_meta (namespace, version, updated_at) VALUES (?, ?, ?)",
                              (namespace, version, _now()))
        return version

    @staticmethod
    def _guard_additive(step: str) -> None:
        head = " ".join(step.split()).upper()
        for banned in ("DROP TABLE", "DROP COLUMN", "ALTER COLUMN", "DROP INDEX", "RENAME "):
            if banned in head:
                raise StoreError(
                    "destructive_migration",
                    f"migration step contains {banned.strip()!r}",
                    "expand in one release and contract in a later one; a host "
                    "running the previous version still reads this database",
                )

    def _ddl_subs(self) -> dict[str, str]:
        raise NotImplementedError

    def schema_version(self, namespace: str = "core") -> int:
        cur = self._execute("SELECT version FROM store_meta WHERE namespace = ?", (namespace,))
        row = cur.fetchone()
        return int(row[0]) if row else 0

    def health(self) -> dict[str, Any]:
        """What `doctor` reports: reachable, which dialect, which versions."""
        started = time.monotonic()
        self._execute("SELECT 1").fetchone()
        rtt = round((time.monotonic() - started) * 1000, 1)
        cur = self._execute("SELECT namespace, version FROM store_meta ORDER BY namespace")
        return {
            "dialect": self.dialect,
            "roundtrip_ms": rtt,
            "namespaces": {n: int(v) for n, v in cur.fetchall()},
        }

    # -- scope resolution ------------------------------------------------------

    def _project_id(self, slug: str | None) -> str | None:
        """A slug in, an id out. Looked up once and remembered, because every
        query in a session asks the same question about the same project."""
        if not slug:
            return None
        cache = getattr(self, "_project_ids", None)
        if cache is None:
            cache = self._project_ids = {}
        if slug not in cache:
            cur = self._execute("SELECT id FROM projects WHERE slug = ?", (slug,))
            row = cur.fetchone()
            cache[slug] = row[0] if row else None
        return cache[slug]

    def _chain(self, scopes: Scopes) -> list[tuple[str, str | None]]:
        """The scopes to read, highest first. A project nobody registered
        contributes nothing rather than matching everything."""
        project_id = self._project_id(scopes.project)
        out: list[tuple[str, str | None]] = []
        if project_id:
            out.append(("project", project_id))
        if scopes.include_global:
            out.append(("global", None))
        return out

    def _target(self, scope: tuple) -> tuple[str, str | None]:
        """A write target as (scope, project id), from a scope and a slug."""
        kind, slug = (list(scope) + [None])[:2]
        if kind not in SCOPE_KINDS:
            raise StoreError("bad_scope",
                             f"scope {kind!r} must be one of {', '.join(SCOPE_KINDS)}")
        if kind == "global":
            if slug:
                raise StoreError("bad_scope", "the global scope takes no project")
            return ("global", None)
        project_id = self._project_id(slug)
        if not project_id:
            raise StoreError("unknown_project", f"no project registered as {slug!r}",
                             "register it before writing records scoped to it")
        return ("project", project_id)

    @staticmethod
    def _chain_clause(chain: list) -> tuple[str, list]:
        if not chain:
            return "0", []
        clause = " OR ".join(["(scope = ? AND COALESCE(project_id,'') = ?)"] * len(chain))
        params: list[Any] = []
        for kind, pid in chain:
            params += [kind, pid or ""]
        return clause, params

    # -- config: read ---------------------------------------------------------

    def config_get(self, capability: str, collection: str, key: str,
                   scopes: Scopes) -> Any:
        """One resolved value, or None. Follows the collection's semantics."""
        entry = self.config_resolve(capability, collection, scopes).get(key)
        return entry["value"] if entry else None

    def config_layers(self, capability: str, collection: str,
                      scopes: Scopes) -> list[dict[str, dict[str, Any]]]:
        """Each scope's own rows, highest scope first, uncollapsed.

        `config_resolve` answers what this project sees; this answers what each
        scope said. A record whose *fields* are decided one at a time needs the
        second question, and asking it here keeps one query behind both."""
        _store_check("capability", capability, CAPABILITY_RE)
        if self._semantics(collection) == EXACT:
            raise StoreError("bad_collection",
                             f"collection {collection!r} is state, not config",
                             "read it with state_get")
        chain = self._chain(scopes)
        clause, params = self._chain_clause(chain)
        cur = self._execute(
            "SELECT id, scope, project_id, capability, collection, key, value, "
            f"note, updated_at, updated_by FROM config WHERE capability = ? AND collection = ? "
            f"AND ({clause})", [capability, collection] + params)
        rows = [self._row(r) for r in cur.fetchall()]
        by_scope: dict[tuple, dict[str, dict[str, Any]]] = {}
        for row in rows:
            by_scope.setdefault(
                (row["scope"], row["project_id"] or ""), {}
            )[row["key"]] = row
        return [by_scope[(kind, pid or "")] for kind, pid in chain
                if by_scope.get((kind, pid or ""))]

    def config_resolve(self, capability: str, collection: str,
                       scopes: Scopes) -> dict[str, dict[str, Any]]:
        """The whole collection as the capability should see it, each entry
        carrying the scope it came from so `connections` can report resolution
        without a second query."""
        semantics = self._semantics(collection)
        out: dict[str, dict[str, Any]] = {}
        for entries in self.config_layers(capability, collection, scopes):
            if semantics == FIRST:
                return entries
            for key, row in entries.items():
                out.setdefault(key, row)
        return out

    def config_origin(self, capability: str, collection: str, key: str,
                      scopes: Scopes) -> tuple[str, str | None] | None:
        entry = self.config_resolve(capability, collection, scopes).get(key)
        return (entry["scope"], entry["project_id"]) if entry else None

    def config_list(self, capability: str, collection: str,
                    scope: tuple | None = None) -> list[dict[str, Any]]:
        """Every stored row, unresolved — the view for editing rather than use."""
        _store_check("capability", capability, CAPABILITY_RE)
        self._semantics(collection)
        sql = ("SELECT id, scope, project_id, capability, collection, key, value, "
               "note, updated_at, updated_by FROM config WHERE capability = ? AND collection = ?")
        params: list[Any] = [capability, collection]
        if scope:
            kind, pid = self._target(scope)
            sql += " AND scope = ? AND COALESCE(project_id,'') = ?"
            params += [kind, pid or ""]
        cur = self._execute(sql + " ORDER BY scope, key", params)
        return [self._row(r) for r in cur.fetchall()]

    def _row(self, r: Sequence[Any]) -> dict[str, Any]:
        return {
            "id": r[0], "scope": r[1], "project_id": r[2],
            "capability": r[3], "collection": r[4], "key": r[5],
            "value": self._decode(r[6]), "note": r[7],
            "updated_at": r[8], "updated_by": r[9],
        }

    @staticmethod
    def _semantics(collection: str) -> str:
        spec = COLLECTIONS.get(collection)
        if not spec:
            raise StoreError("bad_collection", f"unknown collection {collection!r}",
                             f"known: {', '.join(sorted(COLLECTIONS))}")
        return spec["resolve"]

    # -- config: write --------------------------------------------------------

    def config_set(self, capability: str, collection: str, key: str, value: Any,
                   scope: tuple, actor: str | None = None,
                   note: str | None = None) -> str:
        """Write one entry at one scope and record the revision. Returns the
        row's id. A write always names its scope; nothing infers one."""
        _store_check("capability", capability, CAPABILITY_RE)
        _store_check("key", key, KEY_RE)
        self._semantics(collection)
        kind, pid = self._target(scope)
        with self.transaction():
            cur = self._execute(
                "SELECT id, value FROM config WHERE scope = ? AND COALESCE(project_id,'') = ? "
                "AND capability = ? AND collection = ? AND key = ?",
                (kind, pid or "", capability, collection, key))
            existing = cur.fetchone()
            before = self._decode(existing[1]) if existing else None
            if existing:
                row_id = existing[0]
                self._execute(
                    "UPDATE config SET value = ?, note = ?, updated_at = ?, updated_by = ? "
                    "WHERE id = ?",
                    (self._encode(value), note, _now(), actor, row_id))
            else:
                row_id = _uuid()
                self._execute(
                    "INSERT INTO config (id, scope, project_id, capability, "
                    "collection, key, value, note, updated_at, updated_by) "
                    "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
                    (row_id, kind, pid, capability, collection, key,
                     self._encode(value), note, _now(), actor))
            self._revise(kind, pid, capability, collection, key, before, value, actor)
        return row_id

    def config_delete(self, capability: str, collection: str, key: str,
                      scope: tuple, actor: str | None = None) -> bool:
        _store_check("capability", capability, CAPABILITY_RE)
        self._semantics(collection)
        kind, pid = self._target(scope)
        with self.transaction():
            cur = self._execute(
                "SELECT id, value FROM config WHERE scope = ? AND COALESCE(project_id,'') = ? "
                "AND capability = ? AND collection = ? AND key = ?",
                (kind, pid or "", capability, collection, key))
            existing = cur.fetchone()
            if not existing:
                return False
            self._execute("DELETE FROM config WHERE id = ?", (existing[0],))
            self._revise(kind, pid, capability, collection, key,
                         self._decode(existing[1]), None, actor)
        return True

    def _revise(self, scope: str, project_id: str | None, capability: str, collection: str, key: str,
                old: Any, new: Any, actor: str | None) -> None:
        self._execute(
            "INSERT INTO revisions (id, scope, project_id, capability, collection, "
            "key, old_value, new_value, actor, written_at) "
            "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
            (_uuid(), scope, project_id, capability, collection, key,
             self._encode(old), self._encode(new), actor, _now_exact()))

    def revisions(self, capability: str, collection: str | None = None,
                  key: str | None = None, limit: int = 50) -> list[dict[str, Any]]:
        """What the repository's history used to answer: who changed this, when,
        and what it was before."""
        sql = ("SELECT scope, project_id, collection, key, old_value, new_value, "
               "actor, written_at FROM revisions WHERE capability = ?")
        params: list[Any] = [capability]
        if collection:
            sql += " AND collection = ?"
            params.append(collection)
        if key:
            sql += " AND key = ?"
            params.append(key)
        cur = self._execute(sql + " ORDER BY written_at DESC LIMIT ?", params + [limit])
        return [{"scope": r[0], "project_id": r[1], "collection": r[2],
                 "key": r[3], "old_value": self._decode(r[4]),
                 "new_value": self._decode(r[5]), "actor": r[6], "written_at": r[7]}
                for r in cur.fetchall()]

    # -- connections, with their grants applied --------------------------------

    def connections_effective(self, capability: str, scopes: Scopes,
                              write_default: bool = False,
                              include_disabled: bool = False) -> dict[str, dict[str, Any]]:
        """Every connection this project may use, already carrying the decision
        made about it — the one read a capability needs before it acts."""
        identities = self.config_resolve(capability, "connection", scopes)
        layers = self.config_layers(capability, "grant", scopes)
        out: dict[str, dict[str, Any]] = {}
        for cid, entry in identities.items():
            rows = [layer[cid] for layer in layers if cid in layer]
            # Named through the class: this method also runs with a
            # FileRecords `self`, which carries no store internals.
            decided, decided_at = Store._grant_decisions(cid, rows)
            # Where the identity resolves decides whether it is this project's
            # to use at all. A project that declares an identity locally has
            # already said yes by declaring it; an identity inherited from the
            # global scope is withheld until a grant *resolving at project
            # scope* says `enabled: true`. A global `enabled: true` can never be
            # the blessing — one global line would otherwise hand every project
            # on the machine the same connection back.
            declared = decided.get("enabled")
            identity_is_project = entry["scope"] == "project"
            blessed_here = decided_at.get("enabled") == "project"
            if declared is None:
                enabled = identity_is_project
            else:
                enabled = bool(declared) and (identity_is_project or blessed_here)
            if not enabled and not include_disabled:
                continue
            grant = rows[0] if rows else None
            out[cid] = {
                "id": cid,
                "value": entry["value"],
                "scope": (entry["scope"], entry["project_id"]),
                "enabled": enabled,
                "allow_write": bool(decided.get("allow_write", write_default)),
                "grant_scope": (grant["scope"], grant["project_id"]) if grant else None,
            }
        return out

    @staticmethod
    def _grant_decisions(cid: str, rows: Sequence[dict[str, Any]]) -> tuple[dict, dict]:
        """One grant assembled field by field, highest scope first.

        This is the line COLLECTIONS already draws between the two records. An
        identity is a fact about the world, so it is atomic: taken whole from
        one scope, never assembled out of two. A grant is a decision, and a
        decision a lower scope made about one field stands until some higher
        scope decides that same field — so a machine-wide `allow_write: false`
        survives a project that only says `enabled: true`, and write permission
        is never acquired by saying something else.

        Returns the decided fields and, per field, the scope that decided it."""
        decided: dict[str, Any] = {}
        decided_at: dict[str, str] = {}
        for row in rows:
            value = row["value"]
            if not isinstance(value, dict):
                raise StoreError("bad_grant",
                                 f"grant {cid!r} must be a table, got {type(value).__name__}")
            unknown = set(value) - set(GRANT_FIELDS)
            if unknown:
                raise StoreError("bad_grant",
                                 f"grant {cid!r} has unknown field(s): {', '.join(sorted(unknown))}",
                                 f"known: {', '.join(GRANT_FIELDS)}")
            for field, decision in value.items():
                if field not in decided:
                    decided[field] = decision
                    decided_at[field] = row["scope"]
        return decided, decided_at

    def grant_orphans(self, capability: str, scopes: Scopes) -> list[dict[str, Any]]:
        """Grants naming a connection that does not resolve. A grant is the only
        record that refers to another, so it is the only one that can be aimed at
        nothing, and dropping it quietly would read exactly like permission
        deliberately withheld."""
        identities = self.config_resolve(capability, "connection", scopes)
        grants = self.config_resolve(capability, "grant", scopes)
        return [{"key": key, "scope": (row["scope"], row["project_id"]),
                 "value": row["value"]}
                for key, row in sorted(grants.items()) if key not in identities]

    # -- context: long text, versioned by content, one version in force --------

    def context_put(self, capability: str, key: str, body: str, scope: tuple,
                    author: str | None = None, media_type: str | None = None,
                    activate: bool = False) -> str:
        """Record a version and return its hash. Saving is not deploying: this
        changes nothing that runs unless `activate` says so, or until
        `context_activate` names the hash later."""
        _store_check("capability", capability, CAPABILITY_RE)
        _store_check("key", key, KEY_RE)
        kind, pid = self._target(scope)
        if not isinstance(body, str):
            raise StoreError("bad_context", "a context body must be text")
        digest = hashlib.sha256(body.encode("utf-8")).hexdigest()[:HASH_LENGTH]
        with self.transaction():
            cur = self._execute(
                "SELECT id, body FROM context WHERE scope = ? AND COALESCE(project_id,'') = ? "
                "AND capability = ? AND key = ? AND hash = ?",
                (kind, pid or "", capability, key, digest))
            existing = cur.fetchone()
            if existing and existing[1] != body:
                raise StoreError(
                    "hash_collision",
                    f"version {digest} of {capability}/{key} already names different text",
                    "this is what the truncated hash is checked for; report it")
            if not existing:
                self._execute(
                    "INSERT INTO context (id, scope, project_id, capability, key, "
                    "hash, body, media_type, active, author, created_at) "
                    "VALUES (?, ?, ?, ?, ?, ?, ?, ?, 0, ?, ?)",
                    (_uuid(), kind, pid, capability, key, digest, body,
                     media_type, author, _now()))
            if activate:
                self._activate(kind, pid, capability, key, digest, author)
        return digest

    def context_activate(self, capability: str, key: str, digest: str, scope: tuple,
                         actor: str | None = None) -> None:
        """Put one version in force — the deploy step. At most one version of one
        item is active in one scope, and the unique index is what says so rather
        than a convention the writers are trusted to keep."""
        kind, pid = self._target(scope)
        with self.transaction():
            self._activate(kind, pid, capability, key, digest, actor)

    def _activate(self, kind: str, pid: str | None, capability: str, key: str, digest: str, actor: str | None) -> None:
        cur = self._execute(
            "SELECT id, hash FROM context WHERE scope = ? AND COALESCE(project_id,'') = ? "
            "AND capability = ? AND key = ? AND active = 1",
            (kind, pid or "", capability, key))
        current = cur.fetchone()
        target = self._execute(
            "SELECT id FROM context WHERE scope = ? AND COALESCE(project_id,'') = ? "
            "AND capability = ? AND key = ? AND hash = ?",
            (kind, pid or "", capability, key, digest)).fetchone()
        if not target:
            raise StoreError("unknown_version",
                             f"no recorded version {digest} of {capability}/{key} in this scope",
                             "record it with context_put first")
        if current and current[0] == target[0]:
            return
        # Clear first: the partial unique index would otherwise refuse the second
        # active row before the old one is stood down.
        if current:
            self._execute("UPDATE context SET active = 0 WHERE id = ?", (current[0],))
        self._execute("UPDATE context SET active = 1 WHERE id = ?", (target[0],))
        self._revise(kind, pid, capability, "context", key,
                     current[1] if current else None, digest, actor)

    def context_read(self, capability: str, key: str,
                     scopes: Scopes) -> dict[str, Any] | None:
        """The version in force here, found at the highest scope that has one."""
        for kind, pid in self._chain(scopes):
            cur = self._execute(
                "SELECT id, hash, body, media_type, author, created_at, scope, project_id "
                "FROM context WHERE scope = ? AND COALESCE(project_id,'') = ? "
                "AND capability = ? AND key = ? AND active = 1",
                (kind, pid or "", capability, key))
            row = cur.fetchone()
            if row:
                return {"id": row[0], "key": key, "hash": row[1], "body": row[2],
                        "media_type": row[3], "author": row[4], "created_at": row[5],
                        "scope": (row[6], row[7])}
        return None

    def context_versions(self, capability: str, key: str,
                         scopes: Scopes) -> list[dict[str, Any]]:
        """Every version this project can see, newest first — its own chain and
        nothing else. Bodies are omitted; a listing should not carry the whole of
        what it lists."""
        clause, params = self._chain_clause(self._chain(scopes))
        cur = self._execute(
            "SELECT id, hash, media_type, author, created_at, length(body), active, scope "
            f"FROM context WHERE capability = ? AND key = ? AND ({clause}) "
            "ORDER BY created_at DESC, hash", [capability, key] + params)
        return [{"id": r[0], "hash": r[1], "media_type": r[2], "author": r[3],
                 "created_at": r[4], "bytes": r[5], "active": bool(r[6]), "scope": r[7]}
                for r in cur.fetchall()]

    def context_keys(self, capability: str, scopes: Scopes) -> list[str]:
        clause, params = self._chain_clause(self._chain(scopes))
        cur = self._execute(
            f"SELECT DISTINCT key FROM context WHERE capability = ? AND ({clause}) ORDER BY key",
            [capability] + params)
        return [r[0] for r in cur.fetchall()]

    # -- the project registry --------------------------------------------------

    def project_register(self, project_id: str, slug: str, name: str | None = None) -> None:
        """Claim a slug for a project id. Re-registering the same id is how a
        second machine joins a project it already belongs to. A slug held by a
        different id is refused: that is another project, and taking its label
        would take its rows."""
        _store_check("slug", slug, CAPABILITY_RE)
        if not isinstance(project_id, str) or not project_id.strip():
            raise StoreError("bad_project_id", "a project id is required",
                             "generate one once and keep it in the project's own config")
        with self.transaction():
            self._refuse_held_slug(slug, project_id)
            existing = self._execute(
                "SELECT slug FROM projects WHERE id = ?", (project_id,)).fetchone()
            if existing and existing[0] != slug:
                raise StoreError(
                    "slug_immutable",
                    f"project {project_id} is already labelled {existing[0]!r}",
                    "rows are scoped by the id, but the label is how it is found, "
                    "so renaming one is `capabilities relabel <slug>` in the "
                    "project, which moves the label on both sides at once")
            if existing:
                self._execute("UPDATE projects SET name = ? WHERE id = ?", (name, project_id))
            else:
                self._execute(
                    "INSERT INTO projects (id, slug, name, created_at) VALUES (?, ?, ?, ?)",
                    (project_id, slug, name, _now()))
        getattr(self, "_project_ids", {}).pop(slug, None)

    def _refuse_held_slug(self, slug: str, project_id: str) -> None:
        """The one reason a label is unavailable, stated once for whoever wants
        it: another project holds it, and a label is how rows are found."""
        holder = self._execute("SELECT id FROM projects WHERE slug = ?", (slug,)).fetchone()
        if holder and holder[0] != project_id:
            raise StoreError(
                "slug_taken", f"the label {slug!r} belongs to project {holder[0]}",
                "pick another label; this is a different project, and sharing "
                "the label would share its rows")

    def project_relabel(self, project_id: str, slug: str) -> str:
        """Move a known project's label, keeping its id and therefore its rows.

        This is the migration `project_register` refuses to perform silently.
        Registration declares who a project is and so must not quietly answer
        to a second name; relabelling says the project is the same one under a
        new label, which is a different request and is made deliberately.

        Nothing is re-scoped, because nothing was ever scoped by the label: the
        id is the column every row carries. Returns the label given up, so a
        caller can say what changed rather than assume."""
        _store_check("slug", slug, CAPABILITY_RE)
        with self.transaction():
            current = self._execute(
                "SELECT slug FROM projects WHERE id = ?", (project_id,)).fetchone()
            if not current:
                raise StoreError(
                    "unknown_project", f"no project registered with id {project_id!r}",
                    "a relabel moves a label a project already holds; there is "
                    "nothing here to move, and inventing the project instead "
                    "would claim the label for rows that do not exist")
            self._refuse_held_slug(slug, project_id)
            if current[0] != slug:
                self._execute("UPDATE projects SET slug = ? WHERE id = ?",
                              (slug, project_id))
        cache = getattr(self, "_project_ids", {})
        cache.pop(current[0], None)
        cache.pop(slug, None)
        return current[0]

    def project_get(self, slug: str) -> dict[str, Any] | None:
        row = self._execute(
            "SELECT id, slug, name, created_at FROM projects WHERE slug = ?", (slug,)).fetchone()
        return {"id": row[0], "slug": row[1], "name": row[2], "created_at": row[3]} if row else None

    def project_by_id(self, project_id: str) -> dict[str, Any] | None:
        row = self._execute(
            "SELECT id, slug, name, created_at FROM projects WHERE id = ?",
            (project_id,)).fetchone()
        return {"id": row[0], "slug": row[1], "name": row[2], "created_at": row[3]} if row else None

    def project_list(self) -> list[dict[str, Any]]:
        cur = self._execute("SELECT id, slug, name, created_at FROM projects ORDER BY slug")
        return [{"id": r[0], "slug": r[1], "name": r[2], "created_at": r[3]}
                for r in cur.fetchall()]

    def project_bind_path(self, slug: str, instance: str, path: str) -> None:
        """Record where this project sits on this machine."""
        project_id = self._project_id(slug)
        if not project_id:
            raise StoreError("unknown_project", f"no project registered as {slug!r}",
                             "register it first")
        with self.transaction():
            existing = self._execute(
                "SELECT id FROM project_paths WHERE project_id = ? AND instance = ?",
                (project_id, instance)).fetchone()
            if existing:
                self._execute("UPDATE project_paths SET path = ?, updated_at = ? WHERE id = ?",
                              (path, _now(), existing[0]))
            else:
                self._execute(
                    "INSERT INTO project_paths (id, project_id, instance, path, updated_at) "
                    "VALUES (?, ?, ?, ?, ?)", (_uuid(), project_id, instance, path, _now()))

    def project_path(self, slug: str, instance: str) -> str | None:
        project_id = self._project_id(slug)
        if not project_id:
            return None
        row = self._execute(
            "SELECT path FROM project_paths WHERE project_id = ? AND instance = ?",
            (project_id, instance)).fetchone()
        return row[0] if row else None

    # -- state ----------------------------------------------------------------

    def state_get(self, capability: str, key: str, scope: tuple) -> Any:
        """Rule 16: state is read at exactly the scope that minted it. A
        project's state is not a fallback for an instance's, so no cascade."""
        _store_check("capability", capability, CAPABILITY_RE)
        kind, pid = self._target(scope)
        row = self._execute(
            "SELECT value, expires_at FROM state WHERE scope = ? AND COALESCE(project_id,'') = ? "
            "AND capability = ? AND key = ?",
            (kind, pid or "", capability, key)).fetchone()
        if not row or (row[1] and row[1] <= _now()):
            return None
        return self._decode(row[0])

    def state_set(self, capability: str, key: str, value: Any, scope: tuple,
                  ttl_seconds: int | None = None) -> None:
        _store_check("capability", capability, CAPABILITY_RE)
        _store_check("key", key, KEY_RE)
        kind, pid = self._target(scope)
        expires = None
        if ttl_seconds is not None:
            expires = (_store_datetime.now(_store_timezone.utc)
                       + _store_timedelta(seconds=ttl_seconds)).isoformat(timespec="seconds")
        with self.transaction():
            existing = self._execute(
                "SELECT id FROM state WHERE scope = ? AND COALESCE(project_id,'') = ? "
                "AND capability = ? AND key = ?",
                (kind, pid or "", capability, key)).fetchone()
            if existing:
                self._execute(
                    "UPDATE state SET value = ?, updated_at = ?, expires_at = ? WHERE id = ?",
                    (self._encode(value), _now(), expires, existing[0]))
            else:
                self._execute(
                    "INSERT INTO state (id, scope, project_id, capability, key, "
                    "value, updated_at, expires_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
                    (_uuid(), kind, pid, capability, key,
                     self._encode(value), _now(), expires))

    def state_delete(self, capability: str, key: str, scope: tuple) -> bool:
        kind, pid = self._target(scope)
        with self.transaction():
            cur = self._execute(
                "DELETE FROM state WHERE scope = ? AND COALESCE(project_id,'') = ? "
                "AND capability = ? AND key = ?",
                (kind, pid or "", capability, key))
        return bool(cur.rowcount)

    def state_sweep(self) -> int:
        """Drop what has expired. Cheap enough to call on a daemon tick."""
        with self.transaction():
            cur = self._execute(
                "DELETE FROM state WHERE expires_at IS NOT NULL AND expires_at <= ?", (_now(),))
        return cur.rowcount or 0


# --- Adapters ----------------------------------------------------------------

class SQLiteStore(Store):
    """The single-user local floor. Honest about being that: one writer, no
    `SKIP LOCKED`, JSON stored as text and unindexed. A project that never
    leaves one machine needs nothing more."""

    dialect = "sqlite"

    @classmethod
    def open(cls, path: str) -> "SQLiteStore":
        conn = sqlite3.connect(path, isolation_level=None, timeout=15.0)
        conn.execute("PRAGMA journal_mode=WAL")
        conn.execute("PRAGMA foreign_keys=ON")
        conn.execute("PRAGMA busy_timeout=15000")
        return cls(conn)

    def _sql(self, sql: str) -> str:
        return sql

    def _encode(self, value: Any) -> Any:
        return None if value is None else json.dumps(value, ensure_ascii=False, sort_keys=True)

    def _decode(self, raw: Any) -> Any:
        return None if raw is None else json.loads(raw)

    def _ddl_subs(self) -> dict[str, str]:
        return {"json": "TEXT", "serial": "INTEGER PRIMARY KEY AUTOINCREMENT"}

    @contextmanager
    def transaction(self) -> Iterator[None]:
        # BEGIN IMMEDIATE is SQLite's stand-in for the row locks Postgres gives
        # us: it takes the write lock up front rather than discovering the
        # conflict at commit.
        self._conn.execute("BEGIN IMMEDIATE")
        try:
            yield
        except Exception:
            self._conn.execute("ROLLBACK")
            raise
        self._conn.execute("COMMIT")


class PostgresStore(Store):
    """The shared backend. Everything the local floor cannot do — concurrent
    writers, real jsonb, `SKIP LOCKED` for the run queue that lands next — is
    here, and one host's outage is every host's outage, which is the trade."""

    dialect = "postgres"
    _PLACEHOLDER = re.compile(r"\?")

    @classmethod
    def open(cls, url: str) -> "PostgresStore":
        try:
            import psycopg2  # imported lazily: a SQLite-only host never pays
        except ImportError as exc:  # pragma: no cover - depends on host wheels
            raise StoreError("driver_missing", "psycopg2 is not installed",
                             "add psycopg2-binary to the capability's script "
                             "dependencies") from exc
        try:
            conn = psycopg2.connect(url, connect_timeout=10)
        except psycopg2.OperationalError as exc:
            raise StoreError("store_unreachable", f"cannot reach the store: {exc}",
                             "the daemon holds rather than fires while the store "
                             "is unreachable") from exc
        conn.autocommit = False
        return cls(conn)

    def _sql(self, sql: str) -> str:
        return self._PLACEHOLDER.sub("%s", sql)

    def _encode(self, value: Any) -> Any:
        from psycopg2.extras import Json
        return None if value is None else Json(value)

    def _decode(self, raw: Any) -> Any:
        # psycopg2 already adapts jsonb into Python objects.
        return raw

    def _ddl_subs(self) -> dict[str, str]:
        return {"json": "JSONB", "serial": "BIGSERIAL PRIMARY KEY"}


# --- Resolution --------------------------------------------------------------

def default_store_path() -> str:
    """Where records live when nothing says otherwise.

    A store is not optional the way a config source is. A queue, a ledger, a
    cursor have to go somewhere, and letting each capability invent its own
    database for them is how they came to be scattered in the first place. So
    there is always one, and the first caller to ask for it creates it.

    The fenced body cannot ask the manager where that is — it may not import a
    sibling, and a subprocess per open would be absurd — so both compute the
    same XDG convention independently. That is one convention arrived at twice,
    not one value stored twice, but the two must agree: `capabilities path
    store` is the authority, and anything that overrides the location does it
    through `CAPABILITIES_STORE_URL`, which both read first."""
    home = os.environ.get("XDG_STATE_HOME") or os.path.join(
        os.path.expanduser("~"), ".local", "state")
    return os.path.join(home, "capabilities", "store.db")


def open_store(url: str | None = None) -> "Store":
    """The one entry point. `CAPABILITIES_STORE_URL` is the root pointer that
    cannot itself live in the store, which is why it is an environment variable
    beside the secrets the cascade already resolves that way.

    Absent, the local floor is opened at the default path, and created there if
    nothing has created it yet."""
    url = url or os.environ.get("CAPABILITIES_STORE_URL") or default_store_path()
    scheme = urlparse(url).scheme
    if scheme in ("", "sqlite"):
        path = urlparse(url).path if scheme == "sqlite" else url
        if path and path != ":memory:":
            os.makedirs(os.path.dirname(os.path.abspath(path)) or ".", exist_ok=True)
    if scheme in ("postgres", "postgresql"):
        return PostgresStore.open(url)
    if scheme == "sqlite":
        return SQLiteStore.open(urlparse(url).path or ":memory:")
    if not scheme:
        return SQLiteStore.open(url)
    raise StoreError("unknown_store", f"unsupported store scheme {scheme!r}",
                     "expected sqlite:// or postgresql://")


# --- records: the two places a project may keep its configuration ------------
#
# Tracking is not on this axis. Runs, queues and cursors live in the store
# always, because a ledger with a files mode is a ledger nothing can query.
# What a project chooses is where its CONFIGURATION is read and written, and
# these two answer that. A capability calls the same verbs either way and is
# never told which answered, which is the whole point: a call site that can
# tell is a call site that will eventually decide.

DOCUMENT_LOCATIONS: tuple[tuple[str | None, str, str], ...] = (
    ("reference", "{cap}/reference", ".md"),
    ("context", "{cap}/service/context", ".md"),
    ("script", "automations/scripts", ".py"),
    (None, "{cap}/service", ".md"),
)


def _document_key(prefix: str | None, stem: str) -> str:
    """The key a file answers to. Underscores fold to hyphens and case is lost,
    so the map from file to key is one-way — which is why finding a document
    searches rather than computes."""
    slug = stem.replace("_", "-").lower()
    return f"{prefix}.{slug}" if prefix else slug


class Records:
    """The surface a capability reads and writes its configuration through.

    Every verb here is answered by both a directory of files and a database.
    Neither is asked which it is."""

    mode = "?"
    source = "?"

    def __enter__(self) -> "Records":
        return self

    def __exit__(self, *exc: object) -> None:
        self.close()

    def close(self) -> None:
        pass

    def resolve_scope(self, capability: str, collection: str,
                      scope: str) -> dict[str, dict[str, Any]]:
        """Resolve exactly one scope, without inheritance."""
        raise NotImplementedError


class StoreRecords(Records):
    """Configuration kept as rows. Thin, because the store already does this —
    what this adds is a fixed project, so no call site carries a scope it could
    forget."""

    mode = "db"

    def __init__(self, store: "Store", scopes: "Scopes", write_scope: tuple):
        self.store, self.scopes, self.write_scope = store, scopes, write_scope
        self.source = getattr(store, "label", "store")

    def close(self) -> None:
        self.store.close()

    def resolve(self, capability: str, collection: str) -> dict[str, dict[str, Any]]:
        return self.store.config_resolve(capability, collection, self.scopes)

    def resolve_scope(self, capability: str, collection: str,
                      scope: str) -> dict[str, dict[str, Any]]:
        if scope == "project":
            scopes = Scopes(project=self.scopes.project, include_global=False)
        elif scope == "global":
            scopes = Scopes(project=None, include_global=True)
        else:
            raise StoreError("bad_scope",
                             f"scope {scope!r} must be one of {', '.join(SCOPE_KINDS)}")
        return self.store.config_resolve(capability, collection, scopes)

    def get(self, capability: str, collection: str, key: str) -> Any:
        return self.store.config_get(capability, collection, key, self.scopes)

    def set(self, capability: str, collection: str, key: str, value: Any,
            actor: str | None = None, note: str | None = None,
            scope: str | None = None) -> None:
        target = self.write_scope if scope is None else (
            ("global", "") if scope == "global"
            else ("project", self.scopes.project) if scope == "project"
            else None)
        if target is None:
            raise StoreError("bad_scope",
                             f"scope {scope!r} must be one of {', '.join(SCOPE_KINDS)}")
        self.store.config_set(capability, collection, key, value,
                              target, actor=actor, note=note)

    def delete(self, capability: str, collection: str, key: str,
               scope: str | None = None) -> bool:
        target = self.write_scope if scope is None else (
            ("global", "") if scope == "global"
            else ("project", self.scopes.project) if scope == "project"
            else None)
        if target is None:
            raise StoreError("bad_scope",
                             f"scope {scope!r} must be one of {', '.join(SCOPE_KINDS)}")
        return self.store.config_delete(capability, collection, key, target)

    def connections(self, capability: str, write_default: bool = False,
                    include_disabled: bool = False) -> dict[str, dict[str, Any]]:
        return self.store.connections_effective(
            capability, self.scopes, write_default=write_default,
            include_disabled=include_disabled)

    def document_read(self, capability: str, key: str) -> dict[str, Any] | None:
        return self.store.context_read(capability, key, self.scopes)

    def document_keys(self, capability: str) -> list[str]:
        return self.store.context_keys(capability, self.scopes)

    def collection_source(self, capability: str, collection: str) -> str:
        """What answered. A row has no path, so the store says so as itself."""
        return self.source

    def scope_source(self, capability: str, collection: str, scope: str) -> str:
        """What answered, for one scope. A row has no path at any scope, so
        every scope answers as the store itself does."""
        return self.source

    def document_path(self, capability: str, key: str) -> Path | None:
        """Nothing to open: a version in the store is not a file anywhere. The
        working copy an edit needs is the caller's to make, and `put` is what
        makes it land."""
        return None

    def document_put(self, capability: str, key: str, body: str,
                     author: str | None = None, media_type: str | None = None,
                     base: str | None = None) -> str:
        if base is not None:
            current = self.store.context_read(capability, key, self.scopes)
            live = current["hash"] if current else None
            if live != base:
                raise StoreError(
                    "stale_edit",
                    f"{capability}/{key} was {live or 'absent'} when this landed, "
                    f"not {base} as it was when the edit began",
                    "re-read it and apply the change again")
        return self.store.context_put(capability, key, body, self.write_scope,
                                      author=author, media_type=media_type,
                                      activate=True)


class FileRecords(Records):
    """Configuration kept as the files the envelope has always held.

    The layout is not invented here — it is the one the capabilities already
    read, described in one place instead of re-derived at each call site. Two
    directories with that layout make the scope chain: the project's envelope,
    then the user's config home."""

    mode = "files"

    def __init__(self, envelope: Path, global_dir: Path,
                 project_id: str | None = None, project: str | None = None,
                 include_global: bool = True):
        self.envelope, self.global_dir = Path(envelope), Path(global_dir)
        self.project_id, self.project = project_id, project
        self.include_global = bool(include_global)
        self.source = str(self.envelope)

    # -- where a record lives --------------------------------------------------

    def _chain(self) -> list[tuple[str, str | None, Path]]:
        chain = [("project", self.project_id, self.envelope)]
        if self.include_global:
            chain.append(("global", None, self.global_dir))
        return chain

    @staticmethod
    def _load(path: Path) -> Any:
        try:
            return json.loads(path.read_text())
        except FileNotFoundError:
            return None
        except (OSError, ValueError) as exc:
            raise StoreError("bad_config", f"cannot read {path}: {exc}") from None

    @staticmethod
    def _save(path: Path, body: Any, sort: bool = False) -> None:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(body, indent=2, ensure_ascii=False,
                                   sort_keys=sort) + "\n")

    def _policy_file(self, root: Path) -> Path:
        """The gate. A project keeps it at the envelope root; the config home
        keeps it under the manager's own name, which is the same rule seen from
        outside -- there, `capabilities` is a capability like any other."""
        return (root / "settings.json" if root == self.envelope
                else root / "capabilities" / "settings.json")

    def _file(self, root: Path, capability: str, collection: str,
              key: str | None = None) -> Path:
        if collection == "policy":
            return self._policy_file(root)
        if collection == "identifier":
            return root / capability / "identifiers.json"
        if collection in ("connection", "grant"):
            return root / capability / "connections.json"
        if collection == "setting":
            if key == "connection.default":
                return root / capability / "connections.json"
            return root / capability / "service" / "settings.json"
        raise StoreError("bad_collection",
                         f"collection {collection!r} is not kept in files",
                         "it exists only where the project keeps records in the store")

    # -- reading ---------------------------------------------------------------

    def _entries(self, root: Path, capability: str, collection: str) -> dict[str, Any]:
        """Every entry of one collection held at one scope, keyed as the store
        keys them, so the two agree on what a record is called."""
        if collection == "policy":
            body = self._load(self._policy_file(root)) or {}
            return dict((body.get("capabilities") or {}))
        if collection == "identifier":
            body = self._load(root / capability / "identifiers.json") or {}
            raw = body.get("identifiers") if isinstance(body.get("identifiers"), dict) else body
            out = {}
            for label, entry in raw.items():
                out[label] = entry["value"] if isinstance(entry, dict) and "value" in entry else entry
            return out
        registry = self._load(root / capability / "connections.json") or {}
        if collection in ("connection", "grant"):
            declared = registry.get("connections")
            if not isinstance(declared, dict):
                return {}
            out = {}
            for cid, entry in declared.items():
                if not isinstance(entry, dict):
                    continue
                if collection == "connection":
                    out[cid] = {k: v for k, v in entry.items() if k not in GRANT_FIELDS}
                else:
                    grant = {k: entry[k] for k in GRANT_FIELDS if k in entry}
                    if grant:
                        out[cid] = grant
            return out
        if collection == "setting":
            out = {}
            if registry.get("default"):
                out["connection.default"] = registry["default"]
            service = self._load(root / capability / "service" / "settings.json")
            if isinstance(service, dict):
                out.update(service)
            return out
        raise StoreError("bad_collection", f"unknown collection {collection!r}",
                         f"known: {', '.join(sorted(COLLECTIONS))}")

    def _note(self, root: Path, capability: str, collection: str, key: str) -> str | None:
        if collection != "identifier":
            return None
        body = self._load(root / capability / "identifiers.json") or {}
        raw = body.get("identifiers") if isinstance(body.get("identifiers"), dict) else body
        entry = raw.get(key)
        return entry.get("note") if isinstance(entry, dict) else None

    def config_layers(self, capability: str, collection: str,
                      _scopes: Any = None) -> list[dict[str, dict[str, Any]]]:
        """Each scope's own rows, highest scope first, uncollapsed — the same
        question `Store.config_layers` answers, asked of the two directories."""
        _store_check("capability", capability, CAPABILITY_RE)
        Store._semantics(collection)
        layers: list[dict[str, dict[str, Any]]] = []
        for scope, pid, root in self._chain():
            entries = self._entries(root, capability, collection)
            if not entries:
                continue
            layers.append({
                key: {"id": f"{scope}:{capability}/{collection}/{key}", "scope": scope,
                      "project_id": pid, "capability": capability,
                      "collection": collection, "key": key, "value": value,
                      "note": self._note(root, capability, collection, key),
                      "updated_at": None, "updated_by": None}
                for key, value in entries.items()
            })
        return layers

    def resolve(self, capability: str, collection: str) -> dict[str, dict[str, Any]]:
        semantics = Store._semantics(collection)
        out: dict[str, dict[str, Any]] = {}
        for rows in self.config_layers(capability, collection):
            if semantics == FIRST:
                return rows
            for key, row in rows.items():
                prior = out.get(key)
                if prior is None:
                    out[key] = row
                elif (collection == "connection" and not prior["value"]
                        and row["value"]):
                    # One file holds both records here, so an entry carrying
                    # only grant fields yields an identity with no fields. That
                    # is a decision about an inherited connection, never a
                    # replacement for it: it must not blank the identity the
                    # lower scope declared. Where nothing is inherited the
                    # fieldless identity stands, which is the only reading a
                    # glued file leaves for it.
                    out[key] = row
        return out

    def _scope_root(self, scope: str) -> tuple[Path, str | None]:
        """The directory one named scope keeps its records in, and the project
        it answers for. Named once so asking a scope for its rows and asking it
        for its file can never land in different trees."""
        if scope == "project":
            return self.envelope, self.project_id
        if scope == "global":
            return self.global_dir, None
        raise StoreError("bad_scope",
                         f"scope {scope!r} must be one of {', '.join(SCOPE_KINDS)}")

    def resolve_scope(self, capability: str, collection: str,
                      scope: str) -> dict[str, dict[str, Any]]:
        _store_check("capability", capability, CAPABILITY_RE)
        root, pid = self._scope_root(scope)
        return {
            key: {"id": f"{scope}:{capability}/{collection}/{key}",
                  "scope": scope, "project_id": pid,
                  "capability": capability, "collection": collection,
                  "key": key, "value": value,
                  "note": self._note(root, capability, collection, key),
                  "updated_at": None, "updated_by": None}
            for key, value in self._entries(root, capability, collection).items()
        }

    def get(self, capability: str, collection: str, key: str) -> Any:
        entry = self.resolve(capability, collection).get(key)
        return entry["value"] if entry else None

    def collection_source(self, capability: str, collection: str) -> str:
        """The file that answered, named exactly. A report that says only
        "files" makes the reader go and find out which one, and the scope a
        record resolved at is half of what they came to learn."""
        for _scope, _pid, root in self._chain():
            if self._entries(root, capability, collection):
                return str(self._file(root, capability, collection))
        return str(self._file(self.envelope, capability, collection))

    def scope_source(self, capability: str, collection: str, scope: str) -> str:
        """The file one named scope keeps this collection in. What a record
        resolved *to* is a question about that record, so the caller that knows
        which scope answered asks here rather than for the collection's own
        file: one file per scope, and the chain is not walked again."""
        _store_check("capability", capability, CAPABILITY_RE)
        root, _pid = self._scope_root(scope)
        return str(self._file(root, capability, collection))

    def connections(self, capability: str, write_default: bool = False,
                    include_disabled: bool = False) -> dict[str, dict[str, Any]]:
        """Assembled exactly as the store assembles it, from the same two
        collections, so a project changing where it keeps records does not
        change which connection answers."""
        return Store.connections_effective(
            self, capability, None, write_default=write_default,
            include_disabled=include_disabled)

    def config_resolve(self, capability: str, collection: str, _scopes: Any) -> dict:
        """`connections_effective` reaches for this name; the scopes it passes
        are already fixed here."""
        return self.resolve(capability, collection)

    # -- writing ---------------------------------------------------------------

    def set(self, capability: str, collection: str, key: str, value: Any,
            actor: str | None = None, note: str | None = None,
            scope: str | None = None) -> None:
        _store_check("capability", capability, CAPABILITY_RE)
        _store_check("key", key, KEY_RE)
        Store._semantics(collection)
        target_scope = scope or "project"
        if target_scope not in SCOPE_KINDS:
            raise StoreError("bad_scope",
                             f"scope {target_scope!r} must be one of {', '.join(SCOPE_KINDS)}")
        root = self.envelope if target_scope == "project" else self.global_dir
        if target_scope == "project" and not self.envelope.is_dir():
            raise StoreError("no_envelope", "no capabilities/ envelope in this project",
                             "run `capabilities init` first")
        path = self._file(root, capability, collection, key)
        body = self._load(path)
        body = body if isinstance(body, dict) else {}
        if collection == "policy":
            body.setdefault("capabilities", {})[key] = value
        elif collection == "identifier":
            # Flat at the top level, which is the shape the envelope has always
            # had and the shape `audit` holds this to. A file already carrying
            # the wrapper keeps it: reshaping someone's file on an unrelated
            # write is not this writer's business.
            holder = (body["identifiers"] if isinstance(body.get("identifiers"), dict)
                      else body)
            holder[key] = {"value": value, "note": note or ""}
        elif collection in ("connection", "grant"):
            entry = body.setdefault("connections", {}).setdefault(key, {})
            if collection == "connection":
                for field in list(entry):
                    if field not in GRANT_FIELDS:
                        entry.pop(field)
                entry.update(value if isinstance(value, dict) else {})
            else:
                entry.update({k: v for k, v in (value or {}).items() if k in GRANT_FIELDS})
        elif key == "connection.default":
            body["default"] = value
        else:
            body[key] = value
        self._save(path, body, sort=collection == "identifier")

    def delete(self, capability: str, collection: str, key: str,
               scope: str | None = None) -> bool:
        target_scope = scope or "project"
        if target_scope not in SCOPE_KINDS:
            raise StoreError("bad_scope",
                             f"scope {target_scope!r} must be one of {', '.join(SCOPE_KINDS)}")
        root = self.envelope if target_scope == "project" else self.global_dir
        path = self._file(root, capability, collection, key)
        body = self._load(path)
        if not isinstance(body, dict):
            return False
        if collection == "policy":
            gone = (body.get("capabilities") or {}).pop(key, None) is not None
        elif collection == "identifier":
            holder = body.get("identifiers") if isinstance(body.get("identifiers"), dict) else body
            gone = holder.pop(key, None) is not None
        elif collection in ("connection", "grant"):
            entry = (body.get("connections") or {}).get(key)
            if not isinstance(entry, dict):
                return False
            if collection == "connection":
                gone = body["connections"].pop(key, None) is not None
            else:
                gone = any(entry.pop(field, None) is not None for field in GRANT_FIELDS)
        elif key == "connection.default":
            gone = body.pop("default", None) is not None
        else:
            gone = body.pop(key, None) is not None
        if gone:
            self._save(path, body, sort=collection == "identifier")
        return gone

    # -- documents -------------------------------------------------------------

    def _documents(self, root: Path, capability: str) -> dict[str, Path]:
        """Every long-text file this scope holds, by the key it answers to. The
        map is built by walking rather than by computing a path from a key,
        because the key loses case and underscores on the way in."""
        found: dict[str, Path] = {}
        for prefix, shape, suffix in DOCUMENT_LOCATIONS:
            if prefix == "script" and capability != "automations":
                continue
            folder = root / shape.format(cap=capability)
            if not folder.is_dir():
                continue
            for path in sorted(folder.glob(f"*{suffix}")):
                if path.is_file():
                    found.setdefault(_document_key(prefix, path.stem), path)
        return found

    def document_path(self, capability: str, key: str) -> Path | None:
        """The file this key names. It is the truth here, not a copy of it, so
        an edit to what this returns is the edit — which is why `put` validates
        rather than transports."""
        for _scope, _pid, root in self._chain():
            path = self._documents(root, capability).get(key)
            if path:
                return path
        return None

    def document_read(self, capability: str, key: str) -> dict[str, Any] | None:
        for scope, pid, root in self._chain():
            path = self._documents(root, capability).get(key)
            if not path:
                continue
            body = path.read_text()
            return {"id": str(path), "key": key,
                    "hash": hashlib.sha256(body.encode()).hexdigest()[:HASH_LENGTH],
                    "body": body, "media_type": None, "author": None,
                    "created_at": None, "scope": (scope, pid), "path": str(path)}
        return None

    def document_keys(self, capability: str) -> list[str]:
        keys: set[str] = set()
        for _scope, _pid, root in self._chain():
            keys.update(self._documents(root, capability))
        return sorted(keys)

    def document_put(self, capability: str, key: str, body: str,
                     author: str | None = None, media_type: str | None = None,
                     base: str | None = None) -> str:
        path = self._documents(self.envelope, capability).get(key)
        if path is None:
            path = self._new_document_path(capability, key)
        if base is not None and path.is_file():
            current = path.read_text()
            live = hashlib.sha256(current.encode()).hexdigest()[:HASH_LENGTH]
            # In files mode `context edit` deliberately hands out the truth,
            # not a copy. By put-time the live hash is therefore expected to
            # differ from the checkout hash; equality of the submitted body and
            # the file proves the edit landed at the path the adapter named.
            if live != base and current != body:
                raise StoreError(
                    "stale_edit",
                    f"{path} is {live} now, not {base} as it was when the edit began",
                    "re-read it and apply the change again")
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(body)
        return hashlib.sha256(body.encode()).hexdigest()[:HASH_LENGTH]

    def _new_document_path(self, capability: str, key: str) -> Path:
        """Where a document this project does not have yet would go. The prefix
        chooses the folder; what follows it is the file."""
        for prefix, shape, suffix in DOCUMENT_LOCATIONS:
            if prefix and key.startswith(prefix + "."):
                return self.envelope / shape.format(cap=capability) / (key[len(prefix) + 1:] + suffix)
        prefix, shape, suffix = DOCUMENT_LOCATIONS[-1]
        return self.envelope / shape.format(cap=capability) / (key + suffix)

    # -- what a directory cannot answer ---------------------------------------

    def _refuse(self, what: str) -> None:
        raise StoreError("files_mode", f"{what} needs records kept in the store",
                         "this project keeps them in files, where there is no history")

    def revisions(self, *_a: Any, **_k: Any) -> list:
        self._refuse("a record's history")
        return []

    def document_versions(self, *_a: Any, **_k: Any) -> list:
        self._refuse("a document's earlier versions")
        return []


def records_mode(envelope: Path | str) -> tuple[str, str]:
    """Where this project keeps its configuration, and what said so.

    This is the only place the choice is read. Everything downstream takes an
    adapter and cannot tell which it got, because a call site that can tell is
    a call site that will eventually decide for itself."""
    override = os.environ.get("CAPABILITIES_STORE_MODE")
    if override:
        if override not in ("files", "db"):
            raise StoreError("bad_store_mode",
                             f"CAPABILITIES_STORE_MODE must be files or db, got {override!r}")
        return (override, "CAPABILITIES_STORE_MODE")
    identity_file = Path(envelope) / "project.json"
    try:
        identity = json.loads(identity_file.read_text())
    except (OSError, ValueError):
        return ("files", "no project identity")
    mode = identity.get("store", "files")
    if mode not in ("files", "db"):
        raise StoreError("bad_store_mode", f"{identity_file} declares store {mode!r}",
                         'expected "files" or "db"')
    return (mode, str(identity_file))


def open_records(envelope: Path | str, global_dir: Path | str,
                 url: str | None = None, project_only: bool = False) -> Records:
    """The adapter this project's configuration is read and written through."""
    envelope, global_dir = Path(envelope), Path(global_dir)
    mode, source = records_mode(envelope)
    identity = {}
    try:
        identity = json.loads((envelope / "project.json").read_text())
    except (OSError, ValueError):
        pass
    slug, project_id = identity.get("slug"), identity.get("id")
    if mode == "files":
        adapter = FileRecords(envelope, global_dir, project_id, slug,
                              include_global=not project_only)
        adapter.source = source if source == "CAPABILITIES_STORE_MODE" else str(envelope)
        return adapter
    if not slug:
        raise StoreError("no_project_identity",
                         f"{envelope / 'project.json'} keeps this project's records "
                         "in the store but declares no slug to read them under",
                         "run `capabilities init` in the project")
    store = open_store(url)
    return StoreRecords(store, Scopes(project=slug, include_global=not project_only),
                        ("project", slug))

# <<< contract: store <<<

# >>> contract: connections (generated — edit contract/preamble.py, run `capabilities sync-contract`) >>>

def _resolve_env_key(key: str) -> tuple[str | None, str | None, Path | None]:
    """Resolve one env key through cascade tiers 2-4: project .env(.local) →
    user credentials.env → process env. Returns (value, tier, source)."""
    root = _project_root()
    if root is not None:
        for fname in (".env.local", ".env"):
            val = _parse_env_file(root / fname).get(key)
            if val:
                return val, "project", root / fname
    val = _parse_env_file(CREDENTIALS_ENV).get(key)
    if val:
        return val, "user", CREDENTIALS_ENV
    val = os.environ.get(key)
    if val:
        return val, "env", None
    return None, None, None


def _mask(value: str) -> str:
    return ("…" + value[-4:]) if len(value) >= 8 else "****"


def _grant_hint(cid: str) -> str:
    """One wording for the one way a project grants an inherited connection.

    Same shape as `_write_gate`'s: the gate is the human's to lift, never the
    agent's, and the hint carries the exact command rather than a description
    of one. Where no project resolves there is no scope to grant in, so the
    hint names the command that makes one and then the grant, in the order they
    have to happen."""
    grant = f"`capabilities set {NAME} grant {cid} '{{\"enabled\": true}}'`"
    if _project_root() is None:
        return ("Do not lift the gate yourself — ask the user; run "
                f"`capabilities init` in the project that should use {NAME}, "
                f"then {grant} there.")
    return ("Do not lift the gate yourself — ask the user; granting is "
            f"{grant} run inside this project.")


def _grant_gate(reg: dict, cid: str) -> None:
    """Refuse a connection this project may not use, for read as for write.

    A connection declared outside the project is not the project's to use until
    the project itself says so, and one the project switched off is off;
    nothing in the cascade lifts either. Outside a project there is no scope in
    which anything could have said so, which is a different situation and says
    so rather than asserting a project that is not there."""
    entry = (reg.get("withheld") or {}).get(cid)
    if entry is None:
        return
    if entry.get("scope") == "project":
        message = f"connection {cid!r} is disabled in this project"
    elif _project_root() is None:
        message = (f"connection {cid!r} is declared globally and there is no "
                   f"project here to grant it in")
    else:
        message = (f"connection {cid!r} is declared outside this project and "
                   f"this project has not granted it")
    _die(4, "connection_not_granted", message, _grant_hint(cid))


def _connections_composed() -> dict:
    """The connections envelope shape, composed out of resolved records.

    Deliberately reconstituted rather than returned in some store-shaped form:
    selection, the write gate and the `connections` report all read the envelope
    shape, and they should not learn where the rows came from. What changes here
    is the source, never the shape.

    The permission a project was granted is folded back onto the entry as
    `allow_write`, which is where the rest of the contract looks for it.

    A connection this project may not use is kept apart under `withheld`, not
    dropped: `connections` holds exactly what may be acted on — which is what
    every capability's own report iterates — while selection still has the name
    it needs to explain a refusal instead of pretending the connection was
    never declared.

    `sources` names, per connection, the file its identity was read out of. An
    identity is taken whole from one scope, so each connection has exactly one
    origin, and a project that merely granted an inherited connection is not
    where that connection's values are written. It is kept beside the entries
    rather than folded into them because it describes a record rather than
    configuring one: nothing resolves through it, and its one reader is each
    capability's own report, naming the origin of its `connection`-tier keys."""
    adapter = _records()
    try:
        effective = adapter.connections(NAME, write_default=WRITE_DEFAULT,
                                        include_disabled=True)
        default = adapter.get(NAME, "setting", "connection.default")
    except StoreError as e:
        _die(6, e.slug, e.message, e.hint)
    if not effective:
        _die(6, "connections_required",
             f"{NAME} requires an explicit connections registry and "
             f"{adapter.source} holds none",
             'expected {"default": "<id>", "connections": {"<id>": { ... }}}')
    usable = {cid: e for cid, e in effective.items() if e["enabled"]}
    withheld = {cid: e for cid, e in effective.items() if not e["enabled"]}
    if not usable:
        named = ", ".join(sorted(withheld))
        if _project_root() is None:
            refusal = (f"there is no project here to use a {NAME} connection in, "
                       f"so every connection declared globally stays "
                       f"withheld: {named}")
        else:
            refusal = (f"no {NAME} connection is usable in this project; every "
                       f"one it can see is withheld: {named}")
        _die(4, "connection_not_granted", refusal, _grant_hint("<id>"))
    return {
        "default": default,
        "connections": {cid: {**entry["value"], "allow_write": entry["allow_write"]}
                        for cid, entry in usable.items()},
        "sources": {cid: adapter.scope_source(NAME, "connection", entry["scope"][0])
                    for cid, entry in usable.items()},
        "withheld": {cid: {"scope": entry["scope"][0]}
                     for cid, entry in withheld.items()},
    }


def _connections_registry() -> tuple[dict | None, Path | str | None]:
    """The connections envelope and where it came from.

    Composed from the two records a connection is kept as -- who it is, and
    what this project may do with it -- and handed on in the shape the rest of
    the contract already reads, so selection, the write gate and the report
    never learn which source answered.

    The path returned beside it answers for the collection -- where this project
    reads connections from. Where one connection's own values came from is a
    question about that connection, and `reg["sources"][cid]` is what answers
    it."""
    return _connections_composed(), _records().collection_source(NAME, "connection")


def _select_connection(reg: dict | None, wanted: str | None) -> tuple[str, dict | None]:
    """flag → default pointer → sole entry → die 6. A connection's own
    `address` field selects it too (used where a
    connection carries a human-recognizable address; absent fields never match).

    A connection the project was never granted is refused here rather than
    reported missing, so the one enforcement point every capability already
    routes through is also the one that answers "why not"."""
    if reg is None:
        _die(6, "connections_required",
             f"{NAME} requires an explicit connections registry")
    conns = reg["connections"]
    if wanted:
        if wanted in conns:
            return wanted, conns[wanted]
        for cid, entry in conns.items():
            if (entry or {}).get("address", "").lower() == wanted.lower():
                return cid, entry
        _grant_gate(reg, wanted)
        _die(6, "unknown_connection", f"no connection matches {wanted!r}",
             f"known: {', '.join(conns)}")
    default = reg.get("default")
    if default:
        if default not in conns:
            _grant_gate(reg, default)
            _die(6, "bad_default", f"default points to unknown connection {default!r}",
                 f"known: {', '.join(conns)}")
        return default, conns[default]
    if len(conns) == 1:
        cid = next(iter(conns))
        return cid, conns[cid]
    _die(6, "ambiguous_connection",
         f"registry defines {len(conns)} connections and no default; "
         f"pass --connection <id>",
         f"known: {', '.join(conns)}")


def _write_gate(conn_id: str, allow_write: bool, verb: str) -> None:
    """Policy from the committed registry; nothing in the cascade lifts it."""
    if verb in WRITE_VERBS and not allow_write:
        _die(4, "read_only",
             f"connection {conn_id!r} does not allow writes",
             "Do not lift the gate yourself — ask the user; granting is "
             "`allow_write: true` on this connection in connections.json.")


def _key_report(key: str, secret: bool, required: bool,
                value: str | None, tier: str | None, source) -> dict:
    return {"key": key, "secret": secret, "required": required,
            "set": bool(value), "tier": tier if value else None,
            "source": str(source) if (value and source) else None,
            "value": (_mask(value) if secret else value) if value else None}


def _missing_required(keys: list) -> list:
    """Required report rows (from _key_report) that did not resolve through the
    cascade — empty ⇒ credentials present. The primitive behind doctor's
    network-free readiness gate, read from the same per-key resolution
    `connections` reports, so the gate and the report can never disagree."""
    return [k["key"] for k in keys if k["required"] and not k["set"]]


def _doctor_gate(report: dict, wanted: str | None) -> None:
    """doctor's network-free readiness gate. Refuse with exit 2 — naming the
    unresolved required keys, before any round-trip — when a connection under
    test cannot resolve its required config through the cascade, so readiness is
    judged by the same resolution `connections` reports, never a parallel check.
    Checks the selected connection, else every connection in the report."""
    conns = report.get("connections") or {}
    targets = [wanted] if (wanted and wanted in conns) else list(conns)
    problems: dict = {}
    for cid in targets:
        miss = _missing_required((conns.get(cid) or {}).get("keys") or [])
        if miss:
            problems[cid] = miss
    if problems:
        detail = "; ".join(f"{c}: {', '.join(ks)}" for c, ks in sorted(problems.items()))
        _die(2, "credentials_missing",
             f"unresolved required config — {detail}",
             f"set each in the project .env/.env.local, the user credentials.env, "
             f"or process env; `{NAME} connections` shows where every value resolves")

# <<< contract: connections <<<


def _connections_report() -> dict:
    reg, _reg_file = _connections_registry()
    out: dict = {"default": None, "connections": {}}
    conns = reg["connections"]
    out["default"] = reg.get("default") or (next(iter(conns)) if len(conns) == 1 else None)
    for cid, raw in conns.items():
        entry = raw if isinstance(raw, dict) else {}
        rows = []
        for spec in CRED_KEYS:
            key = spec["key"]
            if key == DEFAULT_SECRET_ENV:
                key = entry.get("secret_env") or key
            if entry.get(key) not in (None, ""):
                value, tier, source = str(entry[key]), "connection", _reg_file
            else:
                value, tier, source = _resolve_env_key(key)
            rows.append(_key_report(key, bool(spec.get("secret")),
                                    bool(spec.get("required")), value, tier, source))
        out["connections"][cid] = {
            "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT)),
            "keys": rows}
    return out


def _cmd_connections() -> None:
    _emit(_connections_report())


# --- Connection --------------------------------------------------------------

def _conf(entry: dict | None, key: str, default: str | None = None) -> str | None:
    """Connection entry first, then the cascade. A per-machine value therefore
    lives in .env.local while what every machine shares stays in the registry."""
    if entry and entry.get(key) not in (None, ""):
        return str(entry[key])
    value, _tier, _source = _resolve_env_key(key)
    return value if value else default


def _secret_key(entry: dict | None) -> str:
    return (entry or {}).get("secret_env") or DEFAULT_SECRET_ENV


def _connect(entry: dict | None):
    try:
        import psycopg
        from psycopg.rows import dict_row
    except ImportError:  # pragma: no cover - the shebang installs it
        _die(1, "dependency_missing", "psycopg is not available",
             "this script runs under `uv run --script`; invoke it through its shebang")
    password, _t, _s = _resolve_env_key(_secret_key(entry))
    try:
        return psycopg.connect(
            host=_conf(entry, "db_host"), port=int(_conf(entry, "db_port", "5432")),
            user=_conf(entry, "db_user"), dbname=_conf(entry, "db_name"),
            password=password, sslmode=_conf(entry, "db_sslmode", "prefer"),
            connect_timeout=10, row_factory=dict_row)
    except Exception as exc:
        _die(5, "unreachable", f"cannot reach the store: {exc}",
             f"`{NAME} connections` shows where every value resolves")


SCHEMA = "tasks"          # replaced per run from the selected connection
_IDENT = __import__("re").compile(r"^[A-Za-z_][A-Za-z0-9_]*$")


def _schema(entry) -> str:
    """Which schema holds the two tables.

    A schema is an identifier, not a value, so it cannot travel as a query
    parameter and has to be interpolated. That makes validating it the only
    thing standing between a config file and SQL injection, so anything that is
    not a plain identifier is refused rather than quoted and hoped for."""
    name = _conf(entry, "db_schema", "tasks")
    if not _IDENT.match(name or ""):
        _die(6, "input", f"{name!r} is not a usable schema name",
             "letters, digits and underscore, not starting with a digit")
    return name


def _zone(entry) -> "ZoneInfo":
    from zoneinfo import ZoneInfo, ZoneInfoNotFoundError
    name = _conf(entry, "timezone", "UTC")
    try:
        return ZoneInfo(name)
    except (ZoneInfoNotFoundError, ValueError):
        _die(2, "bad_timezone", f"unknown timezone {name!r}",
             "use an IANA name such as Europe/Moscow")


# --- Value plumbing ----------------------------------------------------------

def _jsonable(v):
    import datetime, decimal, uuid as _uuid
    if isinstance(v, (datetime.datetime, datetime.date)):
        return v.isoformat()
    if isinstance(v, decimal.Decimal):
        return float(v)
    if isinstance(v, _uuid.UUID):
        return str(v)
    return v


def _rows(cur) -> list[dict]:
    """One converter for every column, so a type the store returns natively - a
    timestamp, a uuid - never reaches the encoder raw."""
    return [{k: _jsonable(v) for k, v in row.items()} for row in cur.fetchall()]


def _one_of(value: str, allowed: tuple, label: str) -> None:
    if value not in allowed:
        _die(6, "input", f"unknown {label} {value!r}", f"one of: {', '.join(allowed)}")


def _flags(args: list[str], names: tuple, multi: tuple = (), bools: tuple = (), *,
           takes: int = 0) -> dict:
    """--key value and --key=value; a key in `multi` accumulates instead of
    overwriting.

    A token that is neither a flag nor a flag's value is positional, and a verb
    declares how many it takes. Anything past that is refused rather than
    dropped: an unquoted value with a space in it arrives as two tokens, and
    swallowing the second loses half of what the caller wrote while reporting
    success."""
    out: dict = {}
    loose: list[str] = []
    i = 0
    while i < len(args):
        a = args[i]
        if a.startswith("--"):
            key, _, inline = a[2:].partition("=")
            if key == "activities" and not inline:
                # An optional count. The next token is the count only when it is
                # an integer, so `--activities --full` cannot swallow the flag
                # after it and report success.
                nxt = args[i + 1] if i + 1 < len(args) else None
                if nxt is not None and nxt.lstrip("-").isdigit() and not nxt.startswith("--"):
                    out[key] = nxt; i += 2
                else:
                    out[key] = True; i += 1
                continue
            if key in bools and not inline:
                out[key] = True; i += 1; continue
            if key not in names:
                _die(6, "input", f"unknown flag --{key}",
                     f"accepted: {', '.join('--' + n for n in sorted(set(names) | set(bools)))}")
            if inline:
                value = inline; i += 1
            elif i + 1 < len(args):
                value = args[i + 1]; i += 2
            else:
                _die(6, "input", f"--{key} needs a value")
            if key in multi:
                out.setdefault(key, []).append(value)
            else:
                out[key] = value
            continue
        loose.append(a); i += 1
    out["_loose"] = loose[:takes]
    if len(loose) > takes:
        _die(6, "input", f"unexpected argument {loose[takes]!r}",
             "quote a value that contains spaces")
    return out


def _moment(v: str, tz) -> str:
    """A bare date means midnight in the capability's zone; a full ISO 8601
    moment is taken as given, and a naive one is read in that same zone."""
    import datetime
    text = v.strip()
    if " " in text:
        text = text.replace(" ", "T", 1)
    try:
        if len(text) == 10:
            d = datetime.date.fromisoformat(text)
            return datetime.datetime(d.year, d.month, d.day, tzinfo=tz).isoformat()
        stamp = datetime.datetime.fromisoformat(text)
    except ValueError:
        _die(6, "input", f"cannot read {v!r} as a date or a moment",
             "use 2026-09-10, or 2026-09-10T14:30+03:00 when the hour matters")
    if stamp.tzinfo is None:
        stamp = stamp.replace(tzinfo=tz)
    return stamp.isoformat()


def _task_id(cur, ref: str) -> str:
    """A task is addressed by its uuid or by its unique key. Both are exact:
    guessing which task a person meant is not a service this offers."""
    cur.execute(f"select id from {SCHEMA}.tasks where id::text = %s or unique_key = %s",
                (ref, ref))
    hit = cur.fetchall()
    if not hit:
        _die(3, "not_found", f"no task for {ref!r}",
             "address a task by its uuid or by its unique_key")
    return str(hit[0]["id"])


def _task_row(cur, tid: str) -> dict:
    cur.execute(f"select * from {SCHEMA}.tasks where id = %s", (tid,))
    return _rows(cur)[0]


def _page(opts: dict, total: int) -> tuple[int, int, dict]:
    per = int(opts.get("per-page") or opts.get("limit") or 50)
    page = max(1, int(opts.get("page") or 1))
    last = max(1, -(-total // per)) if total else 1
    offset = (page - 1) * per
    shown = max(0, min(per, total - offset))
    return per, offset, {"current_page": page, "last_page": last, "per_page": per,
                         "total": total, "from": offset + 1 if shown else None,
                         "to": offset + shown if shown else None}


# --- Reading -----------------------------------------------------------------

_DATE_FILTERS = {
    "pickup-after": ("pickup_at", ">="), "pickup-before": ("pickup_at", "<"),
    "created-after": ("created_at", ">="), "created-before": ("created_at", "<"),
    "updated-after": ("updated_at", ">="), "updated-before": ("updated_at", "<"),
}
_LIST_FLAGS = (("type", "status", "tag", "assignee", "per-page", "page", "limit",
                "activities") + tuple(_DATE_FILTERS))

# What a scan needs to choose where to look next. `objective` and `description`
# are the expensive half of a task and stay out until asked for: a list is read
# to pick one row, not to read every row's reasoning.
_LEAN = ("id, type, unique_key, title, status, assignee, tags, pickup_at, "
         "created_at, updated_at")
_LIST_BOOLS = ("pickup-set", "pickup-unset", "full")


def _where(opts: dict, tz=None) -> tuple[str, list]:
    """Every filter narrows; none widens. A moment filter reads a bare date as
    midnight in the connection's zone, so `--created-before 2026-09-03` means
    everything up to the end of the second."""
    clauses, params = [], []
    for flag, (column, op) in _DATE_FILTERS.items():
        if opts.get(flag):
            clauses.append(f"{column} {op} %s")
            params.append(_moment(opts[flag], tz) if tz else opts[flag])
    if opts.get("pickup-set"):
        clauses.append("pickup_at is not null")
    if opts.get("pickup-unset"):
        clauses.append("pickup_at is null")
    if opts.get("type"):
        clauses.append("type = %s"); params.append(opts["type"])
    if opts.get("status"):
        _one_of(opts["status"], STATUSES, "status")
        clauses.append("status = %s"); params.append(opts["status"])
    if opts.get("assignee"):
        clauses.append("assignee = %s"); params.append(opts["assignee"])
    for tag in opts.get("tag", []):
        clauses.append("%s = any(tags)"); params.append(tag)
    return (" where " + " and ".join(clauses)) if clauses else "", params


def _attach_activities(cur, tasks: list[dict], opts: dict, *, embed: bool) -> list[dict]:
    """Every collection carries how much happened and when it last did, because
    that is what a scan needs to choose a row. The trail itself is embedded only
    when asked for, and `--activities N` keeps the last N: a trail is
    append-only and otherwise has no upper bound, which paging cannot fix.

    One extra query for the whole page, never one per row."""
    if not tasks:
        return tasks
    want = opts.get("activities")
    depth = int(want) if isinstance(want, str) else None
    if depth is not None and depth < 0:
        _die(6, "input", "--activities takes a count of zero or more",
             "--activities 5 keeps the last five; --activities 0 keeps none")
    # `--activities 0` asks for the counts and nothing else. Slicing would not
    # say that: rows[-0:] is the whole list, which is the opposite of the ask.
    embed = (embed if want is None else True) and depth != 0
    ids = [t["id"] for t in tasks]
    cur.execute(f"""select id, task_id, description, actor, created_at
                      from {SCHEMA}.task_activities where task_id = any(%s::uuid[])
                     order by created_at asc""", (ids,))
    trail: dict = {}
    for row in _rows(cur):
        trail.setdefault(str(row.pop("task_id")), []).append(row)
    for task in tasks:
        rows = trail.get(str(task["id"]), [])
        task["activities_count"] = len(rows)
        task["last_activity_at"] = rows[-1]["created_at"] if rows else None
        if embed:
            task["activities"] = rows[-depth:] if depth else rows
    return tasks


def _address(task: dict) -> str:
    """How to name one task back to the CLI. `unique_key` is nullable by design,
    so a task raised here rather than seeded from a source is named by its id."""
    return task.get("unique_key") or str(task["id"])


def _waiting_on(tasks: list[dict]) -> dict:
    """The waiting tasks in this answer, under the name each one waits for.

    Grouped from the rows the answer already carries rather than from a second
    question, so the grouping can never disagree with the page beside it."""
    groups: dict = {}
    for task in tasks:
        if task.get("status") == "waiting":
            groups.setdefault(task.get("assignee") or "", []).append(_address(task))
    return groups


def cmd_list(entry, args: list[str]) -> None:
    """A scan, plus who is waited on. `waiting_on` reads the answer's own rows,
    so a page that carries no waiting task carries an empty one."""
    opts = _flags(args, _LIST_FLAGS, multi=("tag",), bools=_LIST_BOOLS)
    where, params = _where(opts, _zone(entry))
    with _connect(entry) as conn, conn.cursor() as cur:
        cur.execute(f"select count(*) as n from {SCHEMA}.tasks{where}", params)
        total = cur.fetchone()["n"]
        per, offset, pagination = _page(opts, total)
        cur.execute(f"""select {'*' if opts.get('full') else _LEAN} from {SCHEMA}.tasks{where}
                         order by pickup_at asc nulls last, created_at asc
                         limit %s offset %s""", params + [per, offset])
        tasks = _attach_activities(cur, _rows(cur), opts, embed=False)
        _emit({"pagination": pagination, "tasks": tasks,
               "waiting_on": _waiting_on(tasks)})


def cmd_ready(entry, args: list[str]) -> None:
    """What may be picked up now: an open status, and no pickup moment still in
    the future. Two statuses are never ready, and by being what they are rather
    than by any moment: `draft`, which nobody has released, and `waiting`, which
    is over to its assignee until something returns it.

    This is the one collection that answers in full - every field and the whole
    trail - because it is the queue a worker consumes to act, and it is short by
    construction. `list` and `search` are scans and stay lean."""
    opts = _flags(args, _LIST_FLAGS, multi=("tag",), bools=_LIST_BOOLS)
    where, params = _where(opts, _zone(entry))
    joiner = " and " if where else " where "
    where = where + joiner + "status in ('todo','in_progress') and (pickup_at is null or pickup_at <= now())"
    with _connect(entry) as conn, conn.cursor() as cur:
        cur.execute(f"select count(*) as n from {SCHEMA}.tasks{where}", params)
        total = cur.fetchone()["n"]
        per, offset, pagination = _page(opts, total)
        cur.execute(f"""select * from {SCHEMA}.tasks{where}
                         order by pickup_at asc nulls last, created_at asc
                         limit %s offset %s""", params + [per, offset])
        _emit({"pagination": pagination,
               "tasks": _attach_activities(cur, _rows(cur), opts, embed=True)})


def cmd_show(entry, args: list[str]) -> None:
    """One task in full, with its whole trail. `--activities N` keeps the last N
    when the trail is long."""
    opts = _flags(args, ("activities",), takes=1)
    if not opts["_loose"]:
        _die(6, "input", "show needs a task", f"{NAME} show <uuid|unique_key>")
    with _connect(entry) as conn, conn.cursor() as cur:
        tid = _task_id(cur, opts["_loose"][0])
        task = _task_row(cur, tid)
        cur.execute(f"""select id, description, actor, created_at
                          from {SCHEMA}.task_activities where task_id = %s
                         order by created_at asc""", (tid,))
        trail = _rows(cur)
        want = opts.get("activities")
        if isinstance(want, str):
            depth = int(want)
            if depth < 0:
                _die(6, "input", "--activities takes a count of zero or more",
                     "--activities 5 keeps the last five; --activities 0 keeps none")
            trail = trail[-depth:] if depth else []
        _emit({"task": task, "activities": trail})


def cmd_search(entry, args: list[str]) -> None:
    """Substring across every text a person writes, plus the metadata JSON. The
    same filters `list` takes narrow it, so a query can be scoped to one type."""
    opts = _flags(args, _LIST_FLAGS, multi=("tag",), bools=_LIST_BOOLS, takes=1)
    if not opts["_loose"]:
        _die(6, "input", "search needs a query", f"{NAME} search <text> [filters]")
    q = f"%{opts['_loose'][0]}%"
    where, params = _where(opts, _zone(entry))
    joiner = " and " if where else " where "
    where = where + joiner + """(title ilike %s or objective ilike %s
                                  or description ilike %s or unique_key ilike %s
                                  or assignee ilike %s or metadata::text ilike %s)"""
    with _connect(entry) as conn, conn.cursor() as cur:
        cur.execute(f"""select {'*' if opts.get('full') else _LEAN} from {SCHEMA}.tasks{where}
                         order by created_at asc""", params + [q] * 6)
        _emit({"query": opts["_loose"][0],
               "tasks": _attach_activities(cur, _rows(cur), opts, embed=False)})


# --- Writing -----------------------------------------------------------------

_SCALARS = ("type", "title", "objective", "description", "status", "assignee", "pickup")
_CLEARABLE = ("objective", "description", "assignee", "pickup", "unique-key")
_COLUMN = {"type": "type", "title": "title", "objective": "objective",
           "description": "description", "status": "status", "assignee": "assignee",
           "pickup": "pickup_at",
           "unique-key": "unique_key"}


def _scalar_updates(opts: dict, tz) -> dict:
    out: dict = {}
    for flag in _SCALARS + ("unique-key",):
        if flag not in opts:
            continue
        value = opts[flag]
        if flag == "status":
            _one_of(value, STATUSES, "status")
        if flag == "pickup":
            value = _moment(value, tz)
        out[_COLUMN[flag]] = value
    return out


def _wait_has_a_name(status: str | None, assignee: str | None) -> None:
    """Refuse a write that would leave a task waiting on nobody.

    Asked of the task as it would stand after the write and not of the flags
    that were passed, so naming the assignee in the same call is permitted and
    emptying the name of a task already waiting is not. One rule either way: a
    task in `waiting` says whom it waits for, or it is not in `waiting`."""
    if status != "waiting" or (assignee or "").strip():
        return
    _die(6, "input", "a task that waits on nobody is a stall with a name missing",
         "name whom it waits for in the same call: --status waiting --assignee <who>")


def _spent_blockers(cur, task: dict) -> list[str]:
    """The tasks a wait names when every one of them has already ended.

    A `blocked_by` is spent once nothing it names is still open: it cannot be
    what a wait beginning now is for, and left in place the next claim reads it
    and returns the task within the minute. One name still open is a live reason
    to wait, so this answers with nothing and the key is left exactly as it is."""
    named = _blocked_by(task)
    if not named:
        return []
    ended = _ended_among(cur, sorted(set(named)))
    return named if all(key in ended for key in named) else []


def _settle_the_wait(cur, status: str | None, before: dict,
                     pickup_named: bool) -> tuple[list[str], list[str]]:
    """What a transition into `waiting` lets go of: assignments to splice into
    the write, and the blockers it found spent.

    Two fields already mean "do not raise this yet" to somebody else: a
    `pickup_at` a runner set as a hold, and a `blocked_by` naming other tasks.
    `waiting` gives both a second meaning - the moment the wait ends - and a hold
    written before the wait is no answer to when the wait is over, so the sweep
    inside the next claim reads a lapsed pickup or a spent list and returns the
    task within the minute. A decision asked for would evaporate unanswered.

    So a wait begins clean. The pickup is dropped unless this same call appoints
    one, which is a moment chosen for the wait rather than inherited, and the
    spent `blocked_by` goes with it. Both are visible where a field move always
    is: the dropped pickup as a change row, the removed key in the verb's own
    answer."""
    if status != "waiting":
        return [], []
    assignments = []
    if not pickup_named and before.get("pickup_at") is not None:
        assignments.append("pickup_at = null")
    spent = _spent_blockers(cur, before)
    if spent:
        assignments.append("metadata = metadata - 'blocked_by'")
    return assignments, spent


def _os_user() -> str:
    """The account this process runs as, read from the system rather than
    from a variable somebody may have set."""
    try:
        import pwd
        return pwd.getpwuid(os.getuid()).pw_name
    except (ImportError, KeyError, AttributeError, OSError):
        import getpass
        return getpass.getuser()


def _worker_execution(env: Mapping[str, str] | None = None) -> str:
    """The raise this process is working under, or empty when it is not a worker.

    One reading of TASKS_EXECUTION, because it answers two questions at once:
    who a write is signed by, and what that write is allowed to reach. An empty
    value is an unset one."""
    env = os.environ if env is None else env
    return (env.get("TASKS_EXECUTION") or "").strip()


def _actor(flag: str | None = None, env: Mapping[str, str] | None = None) -> str:
    """Who is making this write.

    A raise wins over everything: a runner sets TASKS_EXECUTION once, and every
    write its worker makes is attributed to that raise whatever the worker
    passes, so a claim's trail cannot be signed by someone else. Below it, the
    caller's word (`--actor`), then the shell's (TASKS_ACTOR), then the account
    the process runs as, which is never empty. An empty value is an unset one."""
    env = os.environ if env is None else env
    execution = _worker_execution(env)
    if execution:
        return f"execution:{execution}"
    if flag and flag.strip():
        return flag.strip()
    named = (env.get("TASKS_ACTOR") or "").strip()
    if named:
        return named
    return _os_user()


# --- Worker scope ------------------------------------------------------------

# Where a worker may land the task it holds. These are the states a run ends in:
# it finished, it goes back to the queue, it goes over to somebody it names, it
# is over without having been done, or it goes back to a person. `in_progress`
# is absent because claiming is what puts a task there and releasing is what
# takes it out.
WORKER_STATUSES = ("draft", "todo", "waiting", "complete", "closed")

# What a worker may do to any task: add to it. Answered before the raise is even
# read, because no state of the raise takes these away.
_WORKER_ADDITIVE = ("tag", "meta-set", "activity")

# What only the holder may do, and the sentence each refusal is owed. Every one
# of these takes something away from a task or writes over what is already on
# it, which is exactly what a worker passing by must not do to somebody's work.
_WORKER_HELD_ONLY = {
    "set": "a worker may not write a field on a task it does not hold; another "
           "task's fields belong to whoever released the work",
    "untag": "a worker may not remove a tag from a task it does not hold",
    "meta-rm": "a worker may not remove metadata from a task it does not hold",
    "meta-overwrite": "a worker may not write over a metadata key a task it does "
                      "not hold already carries",
}

_WORKER_HINT = ("a worker records what it found on the task - an activity, a tag, "
                "or a metadata key not already there - and leaves the rest to "
                "whoever released the work")


def _worker_refusal(op: str, target: str, lookup,
                    env: Mapping[str, str] | None = None) -> str | None:
    """Whether worker scope refuses this write, and why in one sentence.

    TASKS_EXECUTION is what applies the scope, and it applies whether or not the
    raise it names is still open: a raise that lapsed or was closed holds
    nothing, so it narrows what a worker may write rather than widening it. That
    matters because the variable outlives the claim - a turn keeps running after
    its lease passes - and the wrong way round would make a dead lease the moment
    a worker gained authority over the whole ledger.

    `op` is the write being attempted: `status:<value>`, `type`, `set` for any
    other field the verb edits, or one of the annotation verbs. `target` is the
    task it lands on. `lookup` answers with the raise for an id, or with None
    when there is none; it is asked only when the answer depends on it, so an
    additive write costs no query."""
    execution = _worker_execution(env)
    if not execution:
        return None
    if op in _WORKER_ADDITIVE:
        return None
    if op == "type":
        return ("a worker may not change a task's type; which pipeline work "
                "belongs to is not a worker's decision")
    row = lookup(execution)
    held = str(row["task_id"]) if row and row.get("status") == "running" else None
    if op.startswith("status:"):
        wanted = op.split(":", 1)[1]
        if held is None:
            return ("a worker whose raise is no longer open may not write a "
                    "status, on its own former task or on any other")
        if target != held:
            return (f"a worker may not move another task to {wanted}; it holds "
                    "only the task its raise names")
        if wanted not in WORKER_STATUSES:
            return (f"a worker may not set its own task to {wanted}; it lands "
                    f"that task on {', '.join(WORKER_STATUSES)}")
        return None
    if op not in _WORKER_HELD_ONLY:
        raise ValueError(f"unknown worker-scope operation {op!r}")
    return None if target == held else _WORKER_HELD_ONLY[op]


def _worker_gate(op: str, target: str, lookup) -> None:
    """Refuse, with the policy code, a write worker scope does not permit."""
    message = _worker_refusal(op, target, lookup)
    if message:
        _die(4, "policy", message, _WORKER_HINT)


def _execution_lookup(cur):
    """A raise by id, read at most once per command however often it is asked
    for. `id::text` compares rather than casts, so an id that is not a uuid is
    simply no raise instead of an error from the store."""
    seen: dict = {}

    def lookup(execution_id: str) -> dict | None:
        if execution_id not in seen:
            cur.execute(f"""select id, task_id, status from {SCHEMA}.task_executions
                             where id::text = %s""", (execution_id,))
            rows = _rows(cur)
            seen[execution_id] = rows[0] if rows else None
        return seen[execution_id]

    return lookup


def cmd_add(entry, args: list[str]) -> None:
    """Create one task. `--key` makes it re-runnable: a key already present
    creates nothing, changes nothing, and reports the task that holds it."""
    opts = _flags(args, _SCALARS + ("key", "actor"))
    if not opts.get("type") or not opts.get("title"):
        _die(6, "input", "add needs --type and --title",
             "the goal belongs in --objective, the reasoning in --description")
    tz = _zone(entry)
    if "key" in opts:
        opts["unique-key"] = opts.pop("key")
    values = _scalar_updates(opts, tz)
    values.setdefault("status", "draft")
    coerced: dict = {}
    if _worker_execution() and values["status"] != "draft":
        # A worker creates, it does not release. The status it asked for is not
        # refused - refusing would lose the task it was writing down - it simply
        # does not reach the store, and the answer says so rather than letting
        # the caller believe what it sent.
        values["status"] = coerced["status"] = "draft"
    # After the coercion, so a worker's `waiting` that became a draft is not
    # refused for the assignee a draft does not need.
    _wait_has_a_name(values["status"], values.get("assignee"))
    values["created_by"] = _actor(opts.get("actor"))
    with _connect(entry) as conn, conn.cursor() as cur:
        key = values.get("unique_key")
        if key:
            cur.execute(f"select id from {SCHEMA}.tasks where unique_key = %s", (key,))
            found = cur.fetchall()
            if found:
                _emit({"exists": str(found[0]["id"]), "unique_key": key})
                return
        cols = list(values)
        cur.execute(f"""insert into {SCHEMA}.tasks ({', '.join(cols)})
                        values ({', '.join(['%s'] * len(cols))})
                        returning id, type, unique_key, title, status""",
                    [values[c] for c in cols])
        row = _rows(cur)[0]
        conn.commit()
        answer = {"created": row["id"], **{k: row[k] for k in ("type", "title", "status")}}
        if coerced:
            answer["coerced"] = coerced
        _emit(answer)


def cmd_set(entry, args: list[str]) -> None:
    """Edit scalar fields. A field not named is left alone; `--clear` is the only
    thing that empties one. Tags and metadata are not editable here on purpose -
    they have their own verbs, so a call meaning to change a title can never
    drop a tag.

    Naming no field at all is a save and not a mistake: it moves `updated_at`
    and nothing else, which is how a caller says it took the task into work
    without putting anything in the trail. The answer reports `fields: []`, so a
    save meant to change something and missing its flag is visible rather than
    silent."""
    opts = _flags(args, _SCALARS + ("unique-key", "clear", "actor"),
                  multi=("clear",), takes=1)
    if not opts["_loose"]:
        _die(6, "input", "set needs a task", f"{NAME} set <uuid|unique_key> [fields]")
    tz = _zone(entry)
    values = _scalar_updates(opts, tz)
    for field in opts.get("clear", []):
        if field not in _CLEARABLE:
            _die(6, "input", f"cannot clear {field!r}",
                 f"clearable: {', '.join(_CLEARABLE)}")
        values[_COLUMN[field]] = None
    with _connect(entry) as conn, conn.cursor() as cur:
        tid = _task_id(cur, opts["_loose"][0])
        lookup = _execution_lookup(cur)
        if "status" in values:
            _worker_gate(f"status:{values['status']}", tid, lookup)
        if "type" in values:
            _worker_gate("type", tid, lookup)
        # Every other field, and the bare save that moves nothing but the moment,
        # is the holder's alone: the two gates above name their own rule, and
        # this one answers for the rest of the verb rather than leaving a field
        # nobody asked about open on somebody else's task.
        _worker_gate("set", tid, lookup)
        before = _task_row(cur, tid)
        _wait_has_a_name(values.get("status", before.get("status")),
                         values["assignee"] if "assignee" in values
                         else before.get("assignee"))
        # Only a call that names the status is a transition into the wait, and
        # naming `--pickup` - or clearing it - is what says the moment was chosen
        # for this wait rather than inherited from whatever held the task before.
        settled, spent = _settle_the_wait(cur, values.get("status"), before,
                                          "pickup_at" in values)
        cols = list(values)
        assignments = [c + " = %s" for c in cols] + settled + ["updated_at = now()"]
        cur.execute(f"""update {SCHEMA}.tasks set {', '.join(assignments)}
                         where id = %s returning *""", [values[c] for c in cols] + [tid])
        row = _rows(cur)[0]
        # The move is recorded here, under the verb that made it, rather than by
        # whoever remembered to write it down afterwards.
        moved = _record_moves(cur, tid, before, row,
                              execution_id=(_open_execution(cur, tid) or {}).get("id"),
                              actor=_actor(opts.get("actor")))
        conn.commit()
        answer = {"updated": row["id"], "fields": cols, "moved": moved, "task": row}
        if spent:
            answer["blocked_by_spent"] = spent
        _emit(answer)


def cmd_tag(entry, args: list[str], remove: bool = False) -> None:
    """Tags are added and removed by name, one at a time, and never assigned as
    a whole list. There is no flag here that could overwrite what is already
    there."""
    opts = _flags(args, ("actor",), takes=99)
    loose = opts["_loose"]
    if len(loose) < 2:
        verb = "untag" if remove else "tag"
        _die(6, "input", f"{verb} needs a task and at least one tag",
             f"{NAME} {verb} <uuid|unique_key> <tag> [tag...]")
    ref, names = loose[0], loose[1:]
    with _connect(entry) as conn, conn.cursor() as cur:
        tid = _task_id(cur, ref)
        _worker_gate("untag" if remove else "tag", tid, _execution_lookup(cur))
        if remove:
            cur.execute(f"""update {SCHEMA}.tasks
                               set tags = array(select unnest(tags) except select unnest(%s::text[]))
                             where id = %s returning tags""", (names, tid))
        else:
            cur.execute(f"""update {SCHEMA}.tasks
                               set tags = array(select distinct unnest(tags || %s::text[]))
                             where id = %s returning tags""", (names, tid))
        tags = _rows(cur)[0]["tags"]
        conn.commit()
        _emit({"task": tid, "removed" if remove else "added": names, "tags": tags})


def cmd_meta(entry, args: list[str]) -> None:
    """Metadata is edited one key at a time. No verb takes a whole object, so a
    call meaning to set one key cannot drop the others."""
    opts = _flags(args, ("actor",), takes=99)
    loose = opts["_loose"]
    if not loose:
        _die(6, "input", "meta needs an action",
             f"{NAME} meta set <task> <key> <value> | {NAME} meta rm <task> <key>...")
    action, rest = loose[0], loose[1:]
    if action not in ("set", "rm", "show"):
        _die(6, "input", f"unknown meta action {action!r}", "one of: set, rm, show")
    if action == "set" and len(rest) != 3:
        _die(6, "input", "meta set needs a task, a key and a value",
             "quote a value that contains spaces")
    if action in ("rm", "show") and not rest:
        _die(6, "input", f"meta {action} needs a task")
    with _connect(entry) as conn, conn.cursor() as cur:
        tid = _task_id(cur, rest[0])
        if action == "show":
            _emit({"task": tid, "metadata": _task_row(cur, tid)["metadata"]})
            return
        lookup = _execution_lookup(cur)
        if action == "rm":
            _worker_gate("meta-rm", tid, lookup)
        if action == "set":
            key, raw = rest[1], rest[2]
            # Adding a key and writing over one are different acts to a worker,
            # and only the store knows which this is. Asked only when there is a
            # worker to answer for, so an ordinary caller pays nothing for it.
            over = bool(_worker_execution()) and key in (_task_row(cur, tid)["metadata"] or {})
            _worker_gate("meta-overwrite" if over else "meta-set", tid, lookup)
            try:
                value = json.loads(raw)
            except json.JSONDecodeError:
                value = raw
            cur.execute(f"""update {SCHEMA}.tasks
                               set metadata = metadata || jsonb_build_object(%s::text, %s::jsonb)
                             where id = %s returning metadata""",
                        (key, json.dumps(value), tid))
        else:
            cur.execute(f"""update {SCHEMA}.tasks set metadata = metadata - %s::text[]
                             where id = %s returning metadata""", (rest[1:], tid))
        meta = _rows(cur)[0]["metadata"]
        conn.commit()
        _emit({"task": tid, "metadata": meta})


def _add_activity(cur, tid: str, text: str, actor: str) -> dict:
    """One entry on the trail. Every caller writes it the same way, so what an
    entry is - a moment, a sentence and who recorded it - stays one fact."""
    cur.execute(f"""insert into {SCHEMA}.task_activities (task_id, description, actor)
                    values (%s, %s, %s) returning id, created_at""", (tid, text, actor))
    return _rows(cur)[0]


def cmd_activity(entry, args: list[str]) -> None:
    """Record work that actually happened, in plain words. Creating a task,
    changing a field or thinking about one are not activity and do not belong
    here.

    An entry has no shape beyond its text on purpose: we cannot name the kinds
    before we can see, from real entries, what kinds there are."""
    opts = _flags(args, ("actor",), takes=2)
    loose = opts["_loose"]
    if len(loose) < 2 or not loose[1].strip():
        # An empty entry is worse than no entry: the trail is append-only, so a
        # blank line stays there forever looking like something was recorded.
        _die(6, "input", "activity needs a task and what happened",
             f'{NAME} activity <task> "what happened"')
    with _connect(entry) as conn, conn.cursor() as cur:
        tid = _task_id(cur, loose[0])
        _worker_gate("activity", tid, _execution_lookup(cur))
        row = _add_activity(cur, tid, loose[1], _actor(opts.get("actor")))
        conn.commit()
        _emit({"task": tid, "activity": row["id"], "created_at": row["created_at"]})


# --- Execution ---------------------------------------------------------------

class Refusal(Exception):
    """A refusal a caller inside this process may decide to survive.

    `_die` is the right ending for a verb answering a person: one error shape on
    stderr and the exit code that says which kind. It is the wrong ending for a
    step inside a longer act, where the caller has something left to do and
    ending the process would throw that away. So the store's own refusals are
    raised here and turned into `_die` by whichever verb is the outermost."""

    def __init__(self, exit_code: int, code: str, message: str, hint: str | None = None):
        super().__init__(message)
        self.exit_code, self.code, self.message, self.hint = exit_code, code, message, hint


# What an outcome means for the task itself. Stated here rather than left to the
# caller so that two workers reporting the same outcome leave the task in the
# same place; `--status` overrides it in the open, for the case the table does
# not cover.
_OUTCOMES = {"ok": "complete", "failed": "todo", "handback": "waiting"}
_LEASE_DEFAULT = 3600


def _duration(text: str) -> int:
    """A lease is written as 45m, 3h, 2d, or bare seconds."""
    raw = str(text).strip().lower()
    match = re.fullmatch(r"(\d+)([smhd]?)", raw)
    if not match:
        _die(6, "input", f"cannot read {text!r} as a duration",
             "write it as 900, 45m, 3h or 2d")
    n = int(match.group(1))
    if n <= 0:
        _die(6, "input", "a lease of zero leaves the task claimable while it is worked",
             "give a duration longer than the work itself can take")
    return n * {"": 1, "s": 1, "m": 60, "h": 3600, "d": 86400}[match.group(2)]


def _record_change(cur, tid: str, field: str, old, new,
                   execution_id: str | None = None, actor: str | None = None) -> bool:
    """One row per move that actually moved. Writing a row for a save that
    changed nothing would make the count of moves useless, and counting moves is
    what this table exists for."""
    before = None if old is None else str(old)
    after = None if new is None else str(new)
    if before == after:
        return False
    cur.execute(f"""insert into {SCHEMA}.task_changes
                      (task_id, field, old_value, new_value, execution_id, actor)
                    values (%s, %s, %s, %s, %s, %s)""",
                (tid, field, before, after, execution_id, actor))
    return True


_TRACKED = (("status", "status"), ("pickup", "pickup_at"),
            ("type", "type"), ("assignee", "assignee"))


def _record_moves(cur, tid: str, before: dict, after: dict,
                  execution_id: str | None = None, actor: str | None = None) -> list[str]:
    moved = []
    for field, column in _TRACKED:
        if _record_change(cur, tid, field, before.get(column), after.get(column),
                          execution_id, actor):
            moved.append(field)
    return moved


def _sweep_leases(cur) -> list[dict]:
    """Close every claim whose lease has passed, and free the task it held.

    A worker that dies renews nothing; the moment simply arrives. Doing this
    inside `claim` rather than on a schedule of its own means there is one
    mechanism for recovering abandoned work, and it runs exactly when something
    is looking for work to do."""
    cur.execute(f"""update {SCHEMA}.task_executions
                       set status = 'abandoned', ended_at = now(),
                           detail = coalesce(detail, 'lease lapsed before release')
                     where status = 'running' and lease_until is not null
                       and lease_until < now()
                 returning id, task_id, attempt""")
    swept = _rows(cur)
    for row in swept:
        tid = str(row["task_id"])
        before = _task_row(cur, tid)
        cur.execute(f"""update {SCHEMA}.tasks set status = 'todo', updated_at = now()
                         where id = %s and status = 'in_progress' returning *""", (tid,))
        freed = _rows(cur)
        if freed:
            _record_moves(cur, tid, before, freed[0], execution_id=str(row["id"]))
    return swept


# Who an automatic return is recorded as. A change row carrying neither a raise
# nor an actor reads as somebody's move, and the one thing a reader of an
# automatic return has to be able to see is that nobody made it.
SWEEP_ACTOR = "tasks:sweep"


def _blocked_by(task: dict) -> list[str]:
    """The tasks this one says it is waiting on, as it names them. Anything that
    is not a list of names is no list of blockers at all, and a task carrying one
    waits on its assignee like any other."""
    named = (task.get("metadata") or {}).get("blocked_by")
    if not isinstance(named, list):
        return []
    return [str(k).strip() for k in named if str(k).strip()]


def _ended_among(cur, names: list[str]) -> set:
    """Which of these names belong to a task that has already ended.

    A name is matched as a key and as an id, because a blocker is written either
    way, and a name matching no task is simply absent from the answer: wherever
    this is read, an unknown name holds the wait rather than freeing it."""
    if not names:
        return set()
    cur.execute(f"""select id, unique_key from {SCHEMA}.tasks
                     where status in ('complete','closed')
                       and (unique_key = any(%s) or id::text = any(%s))""",
                (names, names))
    ended: set = set()
    for row in _rows(cur):
        ended.update(k for k in (str(row["id"]), row["unique_key"]) if k)
    return ended


def _wait_over(task: dict, ended: set) -> str | None:
    """Why this waiting task's wait is over, or None while it still waits.

    Two things end a wait and neither of them needs a person: the appointed
    moment passing, and everything the task named having ended. A task that
    named neither is waiting on the assignee it carries, and no clock answers
    for a person - so nothing here moves it, which is the whole of the third
    case."""
    if task.get("due"):
        return "its pickup moment has passed"
    blockers = _blocked_by(task)
    if blockers and all(key in ended for key in blockers):
        return "every task it was waiting on has ended"
    return None


def _sweep_waiting(cur) -> list[dict]:
    """Return to the queue every waiting task whose wait is over.

    Run from `claim` for the reason the lapsed-lease sweep is: one mechanism
    puts work back, and it runs exactly when something is looking for work to do
    rather than on a schedule of its own.

    The store decides whether the moment has come, as it does everywhere else; a
    second opinion computed here would disagree with it the one time the two
    machines differ. Which blockers have ended is read from the store too, and a
    name matching no task has not ended - so an unknown blocker holds the task
    rather than freeing it."""
    cur.execute(f"""select *, (pickup_at is not null and pickup_at <= now()) as due
                      from {SCHEMA}.tasks where status = 'waiting'
                     for update skip locked""")
    waiting = _rows(cur)
    if not waiting:
        return []
    ended = _ended_among(cur, sorted({key for task in waiting
                                      for key in _blocked_by(task)}))
    returned = []
    for task in waiting:
        why = _wait_over(task, ended)
        if not why:
            continue
        tid = str(task["id"])
        cur.execute(f"""update {SCHEMA}.tasks set status = 'todo', updated_at = now()
                         where id = %s returning *""", (tid,))
        after = _rows(cur)[0]
        _record_moves(cur, tid, task, after, actor=SWEEP_ACTOR)
        cur.execute(f"""insert into {SCHEMA}.task_activities (task_id, description, actor)
                        values (%s, %s, %s)""",
                    (tid, f"Returned to the queue from waiting: {why}.", SWEEP_ACTOR))
        returned.append(after)
    return returned


def _open_execution(cur, tid: str) -> dict | None:
    cur.execute(f"""select * from {SCHEMA}.task_executions
                     where task_id = %s and status = 'running'""", (tid,))
    rows = _rows(cur)
    return rows[0] if rows else None


def cmd_claim(entry, args: list[str]) -> None:
    """Take one task that may be picked up now, and hold it for the length of a
    lease. The answer is the task in full with its whole trail, exactly as
    `ready` reports one, plus the execution that now holds it.

    Nothing is returned when nothing is claimable, and that is an answer rather
    than a failure: a worker on a timer asks often and finds nothing most times.

    The lease must outlast the work. A lease that passes while the work is still
    running frees the task for someone else, and the first worker then finds its
    claim gone when it comes to release."""
    opts = _flags(args, ("type", "assignee", "tag", "lease", "worker", "handler", "key"),
                  multi=("tag",))
    _emit(_claim(entry, opts))


def _claim(entry, opts: dict) -> dict:
    """The claim itself, answered rather than printed, so `run` takes a task the
    same way a caller of the verb does and there is one transaction either way.

    The flags arrive already parsed: what a claim is remains here, and how a
    caller spells it belongs to whoever parsed it."""
    lease = _duration(opts.get("lease") or _LEASE_DEFAULT)
    where, params = _where({k: v for k, v in opts.items() if k in ("type", "assignee", "tag")},
                           _zone(entry))
    joiner = " and " if where else " where "
    with _connect(entry) as conn, conn.cursor() as cur:
        swept = _sweep_leases(cur)
        # Before the selection, so a wait that ended is work this same call can
        # take rather than work the next call finds.
        returned = _sweep_waiting(cur)
        if opts.get("key"):
            # Naming a task asks a different question from asking for work, and
            # it deserves a different answer. Finding nothing is the ordinary
            # reply to "is there anything"; it is never the reply to "take this
            # one", where silence would leave the caller believing it ran.
            tid = _task_id(cur, opts["key"])
            # The store decides whether the moment has come, not this process:
            # a pickup is compared against the database clock everywhere else,
            # and a second opinion computed here would disagree with it the one
            # time the two machines differ.
            cur.execute(f"""select *, (pickup_at is null or pickup_at <= now()) as due
                              from {SCHEMA}.tasks where id = %s
                            for update skip locked""", (tid,))
            rows = _rows(cur)
            if not rows:
                _die(6, "conflict", f"{opts['key']} is being claimed by somebody else",
                     "another claimer holds the row; try again")
            task = rows.pop()
            due = task.pop("due")
            if task["status"] != "todo":
                _die(6, "conflict", f"{opts['key']} is {task['status']}, not todo",
                     "a draft has not been released, one waiting is over to its "
                     "assignee, and one in progress is already held")
            if not due:
                _die(6, "conflict", f"{opts['key']} is held until {task['pickup_at']}",
                     "clear the pickup to take it now")
            rows = [task]
        else:
            cur.execute(f"""select * from {SCHEMA}.tasks{where}{joiner}
                              status = 'todo'
                              and (pickup_at is null or pickup_at <= now())
                            order by pickup_at asc nulls last, created_at asc
                            limit 1 for update skip locked""", params)
            rows = _rows(cur)
            if not rows:
                conn.commit()
                return {"claimed": None, "swept": [str(r["id"]) for r in swept],
                        "returned": [_address(t) for t in returned]}
        before = rows[0]
        tid = str(before["id"])
        cur.execute(f"select count(*) as n from {SCHEMA}.task_executions where task_id = %s",
                    (tid,))
        attempt = cur.fetchone()["n"] + 1
        cur.execute(f"""insert into {SCHEMA}.task_executions
                          (task_id, attempt, worker, handler, lease_until)
                        values (%s, %s, %s, %s, now() + make_interval(secs => %s))
                        returning *""",
                    (tid, attempt, opts.get("worker"), opts.get("handler"), lease))
        execution = _rows(cur)[0]
        cur.execute(f"""update {SCHEMA}.tasks set status = 'in_progress', updated_at = now()
                         where id = %s returning *""", (tid,))
        after = _rows(cur)[0]
        _record_moves(cur, tid, before, after,
                      execution_id=str(execution["id"]), actor=opts.get("worker"))
        cur.execute(f"""select id, description, actor, created_at
                          from {SCHEMA}.task_activities where task_id = %s
                         order by created_at asc""", (tid,))
        trail = _rows(cur)
        conn.commit()
        return {"claimed": tid, "attempt": attempt, "execution": execution,
                "task": after, "activities": trail,
                "swept": [str(r["id"]) for r in swept],
                "returned": [_address(t) for t in returned]}


def cmd_release(entry, args: list[str]) -> None:
    """Close one claim and say what came of it. One transaction, so the raise and
    the task can never disagree about whether the work is over.

    The raise is named, not the task. A lease that lapsed frees the task for
    somebody else, and a release addressed by task would then close whatever
    claim it found - finishing another worker's work in its name. The claim
    printed this id; `runs` shows it again.

    `--outcome` decides where the task lands; `--status` overrides that landing
    in the open, for the case the outcome does not describe it. A handback goes
    over to the task's assignee, in `waiting`; a task naming nobody lands in
    `draft` instead and the answer says so, because a runner cannot invent whom
    the task waits for."""
    opts = _flags(args, ("outcome", "status", "detail", "run", "metrics"), takes=1)
    if not opts["_loose"]:
        _die(6, "input", "release needs the raise it is closing",
             f"{NAME} release <execution-id> --outcome ok|failed|handback — "
             f"the id `claim` printed, or `{NAME} runs <task>`")
    outcome = opts.get("outcome")
    if outcome not in _OUTCOMES:
        _die(6, "input", "release needs an outcome", f"one of: {', '.join(_OUTCOMES)}")
    status = opts.get("status") or _OUTCOMES[outcome]
    _one_of(status, STATUSES, "status")
    metrics = "{}"
    if opts.get("metrics"):
        try:
            parsed = json.loads(opts["metrics"])
        except ValueError:
            parsed = None
        if not isinstance(parsed, dict):
            _die(6, "input", "--metrics takes a JSON object",
                 '--metrics \'{"cost_usd": 1.25, "turns": 40}\'')
        metrics = json.dumps(parsed)
    run_system = run_ref = None
    if opts.get("run"):
        run_system, _, run_ref = str(opts["run"]).partition(":")
        if not run_system or not run_ref:
            _die(6, "input", "--run names the system and the handle",
                 "--run automations:0f1c2b, --run <system>:<handle>")
    ref = opts["_loose"][0]
    try:
        answer = _release(entry, ref, outcome, status, opts.get("detail"),
                          run_system, run_ref, metrics)
    except Refusal as refused:
        _die(refused.exit_code, refused.code, refused.message, refused.hint)
    _emit(answer)


def _release(entry, ref: str, outcome: str, status: str, detail: str | None,
             run_system: str | None, run_ref: str | None, metrics: str) -> dict:
    """Closing the raise itself, answered rather than printed, and refusing by
    exception rather than by exit.

    `run` closes the raise it opened, and a lapse is exactly the case where it
    must go on: the task may already be with somebody else, and saying so on the
    trail is the last useful thing that turn can do. A refusal that ended the
    process would take that with it."""
    with _connect(entry) as conn, conn.cursor() as cur:
        cur.execute(f"""select * from {SCHEMA}.task_executions where id::text = %s""", (ref,))
        found = _rows(cur)
        if not found:
            raise Refusal(3, "not_found", f"no raise for {ref!r}",
                          f"`{NAME} runs <task>` lists the raises of one task")
        execution = found[0]
        if execution["status"] != "running":
            hint = ("the lease lapsed and this claim was swept, so the task may "
                    "already be with someone else - claim it again to continue"
                    if execution["status"] == "abandoned" else
                    f"it was already closed as {execution['status']}")
            raise Refusal(6, "conflict", "that raise is not open", hint)
        tid = str(execution["task_id"])
        landing = _task_row(cur, tid)
        instead = None
        if status == "waiting" and not (landing.get("assignee") or "").strip():
            status = "draft"
            instead = ("the task names no assignee, so it landed in draft: a "
                       "runner cannot invent whom the task waits for")
        cur.execute(f"""update {SCHEMA}.task_executions
                           set status = %s, ended_at = now(), detail = %s,
                               run_system = %s, run_ref = %s, metrics = %s::jsonb
                         where id = %s returning *""",
                    (outcome, detail, run_system, run_ref, metrics,
                     execution["id"]))
        closed = _rows(cur)[0]
        before = _task_row(cur, tid)
        # `release` appoints no moment of its own, so a pickup it finds on the
        # way into `waiting` is always one from before the wait.
        settled, spent = _settle_the_wait(cur, status, before, False)
        extra = "".join(f", {one}" for one in settled)
        cur.execute(f"""update {SCHEMA}.tasks set status = %s{extra}, updated_at = now()
                         where id = %s returning *""", (status, tid))
        after = _rows(cur)[0]
        moved = _record_moves(cur, tid, before, after, execution_id=str(closed["id"]),
                              actor=execution.get("worker"))
        conn.commit()
        answer = {"released": tid, "outcome": outcome, "moved": moved,
                  "execution": closed, "task": after}
        if instead:
            answer["instead_of_waiting"] = instead
        if spent:
            answer["blocked_by_spent"] = spent
        return answer


# --- The conveyor ------------------------------------------------------------

# What a worker's declaration leaves unsaid. Each is a number one turn is run
# by, and a project with no opinion about one gets this capability's rather than
# nothing at all.
_LIMIT_DEFAULTS = {"attempts": 3, "lease_seconds": 11400,
                   "hold_seconds_on_exhaustion": 1200, "idle_failure_seconds": 120}

# Marks on a raise that say it was never an attempt at the work, so the count
# that parks a task does not spend it. A turn stopped by the account's own limit
# happened and keeps its row; a turn told to wait on somebody and holding the
# task until tomorrow did exactly what it was told. Neither is the task's fault,
# and parking on the third of either would punish the work for the weather.
_UNSPENT_MARKS = ("exhausted", "waiting")


def _agentworker():
    """The engine library, imported at the moment a turn is about to run.

    Every other verb here works without it, and a reading verb should not wait
    on a dependency it never reaches."""
    try:
        from callva import agentworker
    except ImportError as exc:  # pragma: no cover - a broken install, not a path
        _die(5, "engine_library_missing",
             f"the engine library is not importable: {exc}",
             "reinstall the capability; its script header declares "
             "callva-agentworker and uv resolves it")
    return agentworker


def _project_here() -> Path:
    """The project whose queue and declarations this is. A worker belongs to a
    project; there is nowhere else for one to be declared."""
    root = _project_root()
    if root is None:
        _die(6, "input", "worker declarations live in a project, and this is not one",
             "run this where the project that declares the worker is")
    return root


def _workers_file() -> Path:
    return _project_capabilities_dir(_project_here()) / NAME / "workers.toml"


def _instruction_dir() -> Path:
    return _project_capabilities_dir(_project_here()) / NAME / "instructions"


def _routine_dir() -> Path:
    return _project_here() / "routines"


_VARIABLE = re.compile(r"\$\{([A-Za-z_][A-Za-z0-9_]*)\}")


def _expand(value: str, where: str) -> str:
    """`${VAR}` read from the environment, then from the project's own .env files.

    A machine-local path belongs in local environment configuration rather than
    in a versioned declaration, so the declaration names it instead of carrying
    it. A name nothing answers for is refused rather than expanded to nothing:
    an empty expansion would quietly drop the directory a fenced turn was meant
    to be able to reach, and the turn would fail at something else."""
    def one(match) -> str:
        found = (os.environ.get(match.group(1))
                 or _project_env().get(match.group(1)) or "").strip()
        if not found:
            raise Refusal(6, "worker_invalid",
                          f"{where} names ${{{match.group(1)}}} and nothing sets it",
                          f"set {match.group(1)} in the environment or in the "
                          "project's .env.local")
        return found
    return _VARIABLE.sub(one, value)


def _expanded(value, where: str):
    if isinstance(value, str):
        return _expand(value, where)
    if isinstance(value, list):
        return [_expanded(v, where) for v in value]
    if isinstance(value, dict):
        return {k: _expanded(v, where) for k, v in value.items()}
    return value


def _declarations() -> dict:
    """Every worker this project declares.

    A project that declares none is not an error until something asks for one,
    so an absent file answers with nothing rather than refusing. A file that is
    there and unreadable is refused, because it was meant to say something."""
    import tomllib
    path = _workers_file()
    if not path.is_file():
        return {}
    try:
        data = tomllib.loads(path.read_text())
    except (OSError, tomllib.TOMLDecodeError) as exc:
        _die(6, "worker_invalid", f"{path} could not be read: {exc}",
             "one table per worker, under [workers.<name>]")
    workers = data.get("workers")
    if not isinstance(workers, dict):
        _die(6, "worker_invalid", f"{path} declares no [workers] table",
             "one table per worker, under [workers.<name>]")
    return workers


def _handler(profile) -> str:
    """What held the task, in the words that would start it again."""
    parts = [profile.engine]
    if profile.model:
        parts += ["--model", profile.model]
    if profile.effort:
        parts += ["--effort", profile.effort]
    return " ".join(parts)


def _read_worker(name: str, table) -> tuple[dict | None, list[tuple]]:
    """One worker as this capability reads it, and everything wrong with it.

    Answering with the problems rather than raising on the first is what lets
    `doctor` report a whole file in one pass. `run` refuses on the first, because
    a turn is the expensive thing and a worker that is half declared should never
    reach one."""
    problems: list[tuple] = []

    def wrong(sentence: str, exit_code: int = 6) -> None:
        problems.append((exit_code, "worker_invalid" if exit_code == 6 else "not_found",
                         sentence))

    if not isinstance(table, dict):
        return None, [(6, "worker_invalid", "its declaration is not a table")]
    try:
        table = _expanded(table, f"worker {name!r}")
    except Refusal as refused:
        return None, [(refused.exit_code, refused.code, refused.message)]

    selector = table.get("selector")
    types: list[str] = []
    tags: list[str] = []
    assignee = None
    if not isinstance(selector, dict):
        wrong("it declares no selector table")
    else:
        declared = selector.get("types")
        if (not isinstance(declared, list) or not declared
                or not all(isinstance(t, str) and t.strip() for t in declared)):
            wrong("its selector needs `types`, an ordered list of task types")
        else:
            types = [t.strip() for t in declared]
        tags = selector.get("tags") or []
        if not isinstance(tags, list) or not all(isinstance(t, str) for t in tags):
            wrong("its selector's `tags` is a list of tag names")
            tags = []
        assignee = selector.get("assignee") or None
        if assignee is not None and not isinstance(assignee, str):
            wrong("its selector's `assignee` is one name")
            assignee = None
        for unknown in sorted(set(selector) - {"types", "tags", "assignee"}):
            wrong(f"its selector names {unknown!r}, which nothing reads")

    profile = None
    declared_profile = table.get("profile")
    if not isinstance(declared_profile, dict):
        wrong("it declares no profile table")
    else:
        try:
            profile = _agentworker().Profile.from_dict(declared_profile)
        except (ValueError, TypeError, KeyError) as exc:
            wrong(f"its profile is refused by the engine schema: {exc}")

    routines = table.get("routines") or {}
    if not isinstance(routines, dict):
        wrong("its `routines` is a table keyed by task type")
        routines = {}
    for key, named in routines.items():
        if (not isinstance(named, list) or not named
                or not all(isinstance(n, str) and n.strip() for n in named)):
            wrong(f"its routines for {key!r} must be a list of routine names")
            continue
        for one in named:
            path = _routine_dir() / f"{one}.md"
            if not path.is_file():
                wrong(f"the routine {one!r} it names for {key!r} is not at {path}", 3)

    instructions = table.get("instructions") or {}
    if not isinstance(instructions, dict):
        wrong("its `instructions` is a table keyed by task type")
        instructions = {}
    for key, named in instructions.items():
        named = [named] if isinstance(named, str) else named
        if (not isinstance(named, list) or not named
                or not all(isinstance(n, str) and n.strip() for n in named)):
            wrong(f"its instruction for {key!r} must name a file, or several")
            continue
        for one in named:
            path = _instruction_dir() / one
            if not path.is_file():
                wrong(f"the instruction file it names for {key!r} is not at {path}", 3)

    limits = dict(_LIMIT_DEFAULTS)
    declared_limits = table.get("limits") or {}
    if not isinstance(declared_limits, dict):
        wrong("its `limits` is a table of whole numbers")
        declared_limits = {}
    for key, value in declared_limits.items():
        if key not in _LIMIT_DEFAULTS:
            wrong(f"its limits name {key!r}, which nothing reads")
        elif isinstance(value, bool) or not isinstance(value, int) or value <= 0:
            wrong(f"its limit {key} must be a whole number above zero")
        else:
            limits[key] = value

    # Every type the selector takes has to have somewhere to send the turn. A
    # type declared in one table and not the other is a hole that would only
    # show when a task of that type was already claimed and holding a raise.
    for kind in types:
        if not _for_pair(routines, kind, None):
            wrong(f"its selector takes {kind!r} and its routines name none for it")
        if not _for_pair(instructions, kind, None):
            wrong(f"its selector takes {kind!r} and its instructions name none for it")

    hint = table.get("park_hint") or ""
    if not isinstance(hint, str):
        wrong("its `park_hint` is one sentence")
        hint = ""
    for unknown in sorted(set(table) - {"selector", "profile", "routines",
                                        "instructions", "limits", "park_hint"}):
        wrong(f"it names {unknown!r}, which nothing reads")

    if problems:
        return None, problems
    return {"name": name, "types": types, "tags": tags, "assignee": assignee,
            "profile": profile, "routines": routines, "instructions": instructions,
            "limits": limits, "park_hint": hint.strip(),
            "handler": _handler(profile)}, []


def _worker(name: str) -> dict:
    """The named worker, or the refusal that says why there is no turn to run."""
    declared = _declarations()
    if name not in declared:
        _die(3, "not_found", f"no worker named {name!r} in {_workers_file()}",
             f"declared here: {', '.join(sorted(declared)) or 'none'}")
    worker, problems = _read_worker(name, declared[name])
    if problems:
        exit_code, code, sentence = problems[0]
        _die(exit_code, code, f"worker {name!r}: {sentence}",
             f"`{NAME} doctor` reports every worker this project declares")
    return worker


def _workers_report() -> tuple[list[dict], list[str]]:
    """Every declared worker and what is wrong with it, for `doctor`."""
    rows, broken = [], []
    for name, table in sorted(_declarations().items()):
        worker, problems = _read_worker(name, table)
        row = {"worker": name, "ok": not problems}
        if worker:
            row["types"] = worker["types"]
            row["engine"] = worker["profile"].engine
            row["fence"] = worker["profile"].fence
        if problems:
            row["problems"] = [sentence for _code, _slug, sentence in problems]
            broken += [f"{name}: {sentence}" for _code, _slug, sentence in problems]
        rows.append(row)
    return rows, broken


# --- What the turn is told ---------------------------------------------------

# The frame this capability puts around the project's own instructions. It
# carries what is true of every worker on every queue - who it is, what it
# holds, where the procedure is, how to report, and what the store will refuse -
# and nothing about what the work is or how this project wants it done. That is
# the instruction file's, and nothing here reads it.

_OPENING = """You are the worker `{worker}` for one task in this project's queue.

You hold exactly the task below, for the length of a lease, and nothing else holds it while you do."""

_RESUMED = """This task was raised before and the previous turn did not finish. Read the trail below for what has already happened and continue from there rather than starting again."""

_AT_STAGE = """This task is at stage `{stage}`. The entry that set it is on the trail below, and it is the state you start from."""

_LOAD_ROUTINES = """LOAD THESE ROUTINES

Load each of these from this project's `routines/` and follow it. Do not work from memory of them and do not ask for them. Each says when it applies; the first is the procedure for this work, and the rest apply at the moments they name."""

_WRITE_BACK = """THE TRAIL IS HOW YOU REPORT

Write to the task's trail with `{cli} activity {key} "..."` as work happens, not once at the end. If this turn dies, the trail is all that survives, and the next turn reads it to continue.

Write for that next agent, not for a person reading a story. Name the session, the commit, the verdict, the file and the line. "Investigated and found problems" is worthless to the reader it is for.

Act first, then record, then move the status. Never record an intention: if the record is written before the act and the act fails, the trail claims something that did not happen and the next turn believes it.

The trail is append-only. Correct a wrong entry with a later entry saying so; there is no verb that edits one, and the record of having been wrong is part of what the next turn needs.

Creating a task, editing a field, and thinking about the work are not activity and do not belong in the trail."""

_STORE_AUTHORITY = """WHAT THE STORE WILL LET YOU WRITE

This is enforced by the ledger rather than asked of you. `TASKS_EXECUTION` is set for this turn and everything it starts; it signs every write you make and it bounds them.

On this task, the one your raise holds, you write as anyone does, with two limits: you land it on `draft`, `todo`, `waiting`, `complete` or `closed` and nowhere else, and you never change its type.

On every other task you add and never take away: an activity, a tag, a metadata key that is not already there. You cannot remove a tag or a key, write over a key already present, or move another task's status. A task you create is created in `draft` whatever you asked for.

`waiting` says the task is over to somebody and names whom: set it with an assignee in the same call, or the store refuses it.

Do not close your own raise. Whatever started this turn opened it and closes it from wherever you leave the task, so the measurement and the landing cannot disagree.

A refusal exits 4 and names the rule it enforces. That is the rule, not an obstacle to route around."""


def _prompt(worker: dict, task: dict, trail: list, routines: list[str],
            instruction: str, attempt: int, stage: str | None) -> str:
    """What the turn is given: this capability's frame around the project's text.

    The trail is lifted out of the task and printed as its own section. Left
    inside, what has already been done would bury the statement of what to do,
    and it is the half that grows without bound. The raise log goes entirely:
    it is bookkeeping for somebody auditing the queue and the worker can act on
    none of it."""
    task = dict(task)
    task.pop("activities", None)
    task["metadata"] = {k: v for k, v in (task.get("metadata") or {}).items()
                        if k != "raises"}
    opening = _OPENING.format(worker=worker["name"])
    if attempt > 1:
        opening += "\n\n" + _RESUMED
    if stage:
        opening += "\n\n" + _AT_STAGE.format(stage=stage)
    return "\n\n".join([
        opening,
        _LOAD_ROUTINES,
        "\n".join(f"- `{one}`" for one in routines),
        "THE TASK",
        json.dumps(task, indent=2, ensure_ascii=False),
        "WHAT HAS ALREADY HAPPENED, oldest first",
        json.dumps(trail, indent=2, ensure_ascii=False) if trail else "(empty)",
        instruction.strip(),
        _WRITE_BACK.format(cli=NAME, key=_address(task)),
        _STORE_AUTHORITY,
    ]) + "\n"


# --- One turn ----------------------------------------------------------------

def _stage_of(task: dict) -> str | None:
    """The boundary a routine left this task at, if it named one. Anything that
    is not a plain name is no stage: the runner reads this key and nothing else
    in the task's metadata."""
    value = (task.get("metadata") or {}).get("stage")
    return str(value).strip() or None if isinstance(value, (str, int)) else None


def _for_pair(table: dict, kind: str, stage: str | None):
    """What is declared for this task's type, or for its type at this stage when
    the file names one. A stage nothing is declared for is the type's own work
    carrying on, so it falls back rather than refusing."""
    if stage and f"{kind}:{stage}" in table:
        return table[f"{kind}:{stage}"]
    return table.get(kind)


def _selector_filters(worker: dict) -> dict:
    opts: dict = {}
    if worker["tags"]:
        opts["tag"] = list(worker["tags"])
    if worker["assignee"]:
        opts["assignee"] = worker["assignee"]
    return opts


def _take(entry, worker: dict, key: str | None) -> dict:
    """Take the next task this worker matches, or exactly the one named.

    One claim per type, in the order the selector lists them, stopping at the
    first that yields: the order is the whole of the arbitration, and a claim
    takes one type per call, so asking in order is the only way to express a
    priority at all. A sweep can happen on a call that claims nothing, so what
    each attempt swept is carried forward rather than lost with the empty answer
    that reported it."""
    base = {"lease": str(worker["limits"]["lease_seconds"]),
            "worker": worker["name"], "handler": worker["handler"]}
    base.update(_selector_filters(worker))
    if key:
        return _claim(entry, {**base, "key": key})
    swept: list = []
    answer: dict = {"claimed": None, "swept": [], "returned": []}
    for kind in worker["types"]:
        answer = _claim(entry, {**base, "type": kind})
        swept += answer.get("swept") or []
        if answer.get("claimed") is not None:
            break
    answer["swept"] = swept
    return answer


def _would_take(entry, worker: dict, key: str | None) -> dict:
    """The task a claim would take, asked in the order the claim asks in, and
    writing nothing: no sweep, no raise, no status move."""
    tz = _zone(entry)
    with _connect(entry) as conn, conn.cursor() as cur:
        take = None
        if key:
            tid = _task_id(cur, key)
            cur.execute(f"""select *, (pickup_at is null or pickup_at <= now()) as due
                              from {SCHEMA}.tasks where id = %s""", (tid,))
            row = _rows(cur)[0]
            take = row if row.pop("due") and row["status"] == "todo" else None
        else:
            for kind in worker["types"]:
                where, params = _where({**_selector_filters(worker), "type": kind}, tz)
                joiner = " and " if where else " where "
                cur.execute(f"""select * from {SCHEMA}.tasks{where}{joiner}
                                  status = 'todo'
                                  and (pickup_at is null or pickup_at <= now())
                                order by pickup_at asc nulls last, created_at asc
                                limit 1""", params)
                rows = _rows(cur)
                if rows:
                    take = rows[0]
                    break
    return {"worker": worker["name"], "would_claim": _address(take) if take else None,
            "applied": False}


def _spent(rows: list[dict]) -> int:
    """How many of these raises got as far as doing something. The row says so
    itself, so this is counted rather than tracked."""
    return sum(1 for row in rows
               if not any((row.get("metrics") or {}).get(mark) for mark in _UNSPENT_MARKS))


def _spent_attempts(entry, tid: str) -> int:
    with _connect(entry) as conn, conn.cursor() as cur:
        cur.execute(f"select metrics from {SCHEMA}.task_executions where task_id = %s",
                    (tid,))
        return _spent(_rows(cur))


def _state(entry, tid: str) -> tuple[dict, int]:
    """Where the task stands and how long its trail is, in one look."""
    with _connect(entry) as conn, conn.cursor() as cur:
        task = _task_row(cur, tid)
        cur.execute(f"select count(*) as n from {SCHEMA}.task_activities where task_id = %s",
                    (tid,))
        grown = cur.fetchone()["n"]
    return task, grown


def _note(entry, tid: str, text: str) -> None:
    with _connect(entry) as conn, conn.cursor() as cur:
        _add_activity(cur, tid, text, _actor())
        conn.commit()


def _hold_off(entry, tid: str, seconds: int) -> str:
    """Hold the task for a while rather than leave it at the head of the queue,
    so the next tick does not hand the same task straight back into a limit that
    has not lifted. The moment is the store's, as every other moment is."""
    with _connect(entry) as conn, conn.cursor() as cur:
        before = _task_row(cur, tid)
        cur.execute(f"""update {SCHEMA}.tasks
                           set pickup_at = now() + make_interval(secs => %s),
                               updated_at = now()
                         where id = %s returning *""", (seconds, tid))
        after = _rows(cur)[0]
        _record_moves(cur, tid, before, after, actor=_actor())
        conn.commit()
    return after["pickup_at"]


def _accumulate_cost(entry, tid: str, cost: float) -> float:
    """What the task has cost so far, kept beside what each raise cost rather
    than instead of it: the raise answers what this turn cost, and this answers
    the question a queue-wide scan asks."""
    with _connect(entry) as conn, conn.cursor() as cur:
        prior = (_task_row(cur, tid)["metadata"] or {}).get("cost_total") or 0
        total = round(float(prior) + float(cost), 4)
        cur.execute(f"""update {SCHEMA}.tasks
                           set metadata = metadata || jsonb_build_object('cost_total', %s::jsonb)
                         where id = %s""", (json.dumps(total), tid))
        conn.commit()
    return total


def _held_ahead(task: dict) -> bool:
    """Whether the store is holding this task until a moment still to come.

    A pickup already passed is not a hold: the claim does not clear the field,
    so a task that waited yesterday still carries yesterday's moment today."""
    import datetime
    stamp = task.get("pickup_at")
    if not stamp:
        return False
    try:
        moment = datetime.datetime.fromisoformat(str(stamp))
    except ValueError:
        return False
    if moment.tzinfo is None:
        moment = moment.replace(tzinfo=datetime.timezone.utc)
    return moment > datetime.datetime.now(datetime.timezone.utc)


def _settle(landed: str, held_ahead: bool, stage_moved: bool,
            unspent: bool) -> tuple[str, str, dict]:
    """Where the task ends up, what the raise is scored, and the marks that say
    why - decided by where the task stands and never by what the turn said.

    A turn that reports success and moved nothing is not believed, and a turn
    that says nothing while the task is finished is not doubted."""
    if unspent:
        # The account is out of quota, or the engine never got to the work. Not
        # an attempt at it, so the task goes back and the raise says so.
        return "todo", "failed", {"exhausted": True}
    if landed in ("complete", "closed"):
        # Both are endings reached on purpose: `complete` says the work was
        # done, `closed` that it was decided against. Scoring the second a
        # failure would send a settled question back to be re-decided.
        return landed, "ok", {}
    if landed in ("todo", "in_progress") and held_ahead:
        # A hold still ahead when the turn is over was set inside the turn, and
        # only a turn waiting on somebody sets one. Whether it also moved the
        # status or left the claim's `in_progress` is the same wait.
        return "todo", "ok", {"waiting": True}
    if landed == "todo" and stage_moved:
        # It ended at a boundary it named and handed on. The next claim starts a
        # fresh turn at the new stage with the handoff already on the trail.
        return "todo", "ok", {"handoff": True}
    if landed in ("waiting", "draft"):
        # `waiting` is where a turn stopping at a gate leaves the task, over to
        # whoever must answer. `draft` is scored the same: a handback the store
        # could hand to nobody lands there, and so does a turn that put the task
        # back without naming a name.
        return landed, "handback", {}
    if landed == "in_progress":
        # Nobody moved it, so the turn never reached an ending of its own. Left
        # alone the task would hold a status no live raise backs: no claim would
        # take it, and no lease would free it.
        return "todo", "failed", {}
    return "todo", "failed", {}


def _boot(worker: dict, prompt: str, execution: str, cwd: Path):
    """One engine turn, and the wall time it took. The only thing here that
    knows how a turn is started.

    The raise goes down with it: `TASKS_EXECUTION` signs every write the turn
    makes and bounds what those writes may reach. The fence cannot do that - it
    decides which commands may run, not which rows one of them may move. It is
    passed rather than exported, so it reaches the turn and its children and
    nothing else in this process.

    The time is measured here rather than read from the result, because a turn
    that never reported carries no duration of its own, and telling a turn that
    died in seconds from one that worked for an hour is exactly what the caller
    needs in order to decide whether an attempt was spent."""
    import time
    import uuid
    engine = _agentworker()
    profile = worker["profile"]
    # A pinned id makes the transcript addressable before the turn starts, so a
    # turn that is killed still has one. Only claude takes it; codex learns its
    # own from the stream, and the pointer is then whatever came back.
    pinned = str(uuid.uuid4())
    session = (engine.Session.pinned(pinned) if profile.engine == "claude"
               else engine.Session.fresh())
    started = time.monotonic()
    result = engine.run(prompt, profile, str(cwd), session=session,
                        environ=os.environ, extra_env={"TASKS_EXECUTION": execution})
    return result, pinned, int((time.monotonic() - started) * 1000)


def _close(entry, execution: str, outcome: str, status: str, detail: str | None,
           system: str, pointer: str, metrics: dict, tid: str, report: dict) -> None:
    """Close the raise, and say on the trail when it could not be closed.

    A lease that lapsed under the turn frees the task for somebody else, and the
    sweep closes the claim. Failing quietly there would hide that the work of
    this turn may already have been redone."""
    try:
        _release(entry, execution, outcome, status, detail or None,
                 system, pointer, json.dumps(metrics))
    except Refusal as refused:
        _note(entry, tid, f"This raise could not be closed: {refused.message}")
        report["release_refused"] = refused.message


def _park(entry, worker: dict, tid: str, execution: str, why: str) -> None:
    """Hand a task back to a person, carrying why it came back. The project's own
    sentence goes with it: what a person about to read a parked task needs to
    check is the project's knowledge, not this capability's."""
    if worker["park_hint"]:
        why = f"{why} {worker['park_hint']}"
    _note(entry, tid, why)
    try:
        _release(entry, execution, "handback", _OUTCOMES["handback"], why[:200],
                 None, None, "{}")
    except Refusal as refused:
        _note(entry, tid, f"This raise could not be closed: {refused.message}")


def cmd_run(entry, args: list[str]) -> None:
    """One turn of the conveyor: claim, boot, settle.

    This holds no opinion about the work. It selects by the worker's selector,
    stamps, boots exactly one turn, and stamps what that turn cost. It never
    reads the turn's answer and decides nothing about the task: the worker moves
    the status and writes the trail itself, through these same verbs.

    Selection is the store's. `claim` takes the next task, holds it for a lease,
    opens the raise and moves the status in one transaction, and refuses a
    second claim on a row that already has one. A turn that dies renews nothing,
    so the lease lapses and the next claim sweeps it: there is no window here to
    invent and no stranded run to detect."""
    opts = _flags(args, ("key",), bools=("apply",), takes=1)
    if not opts["_loose"]:
        _die(6, "input", "run needs a worker",
             f"{NAME} run <worker> [--key KEY] [--apply]")
    worker = _worker(opts["_loose"][0])
    if not opts.get("apply"):
        # Nothing is claimed without --apply, so this says which task a claim
        # would find rather than pretending to have taken it.
        _emit(_would_take(entry, worker, opts.get("key")))
        return

    held = _take(entry, worker, opts.get("key"))
    report = {"worker": worker["name"], "claimed": None,
              "swept": held.get("swept") or [], "applied": True}
    if held.get("claimed") is None:
        _emit(report)
        return

    task = held["task"]
    tid = held["claimed"]
    execution = str(held["execution"]["id"])
    attempt = held["attempt"]
    report.update(claimed=_address(task), attempt=attempt, execution=execution)

    # Counted after the claim, because the claim is what made this raise exist.
    if _spent_attempts(entry, tid) > worker["limits"]["attempts"]:
        _park(entry, worker, tid, execution,
              f"Raised {worker['limits']['attempts']} times without finishing; handed "
              "back for a decision rather than dispatched again.")
        report["parked"] = True
        _emit(report)
        return

    stage = _stage_of(task)
    kind = task.get("type") or ""
    routines = _for_pair(worker["routines"], kind, stage)
    named = _for_pair(worker["instructions"], kind, stage)
    pair = f"{kind}:{stage}" if stage else kind
    if not routines or not named:
        _park(entry, worker, tid, execution,
              f"Worker {worker['name']!r} declares no "
              f"{'routines' if not routines else 'instruction file'} for {pair}, so "
              "there was nothing to give a turn; handed back rather than dispatched "
              "with half a prompt.")
        report["parked"] = True
        _emit(report)
        return
    # Several files are read in the order they are named. A standing rule that
    # holds for every pair this worker takes then has one home, rather than a
    # copy per pair that rots from whichever copy is edited first.
    named = [named] if isinstance(named, str) else named
    instruction = "\n\n".join((_instruction_dir() / one).read_text().strip()
                              for one in named)

    prompt = _prompt(worker, task, held.get("activities") or [], routines,
                     instruction, attempt, stage)
    _before, grew_from = _state(entry, tid)
    result, pinned, elapsed_ms = _boot(worker, prompt, execution, _project_here())
    landing, grew_to = _state(entry, tid)

    engine = _agentworker()
    detail = result.failure.message[:300] if result.failure else ""
    # Two ways of recognising a turn that never got to the work, because one is
    # exact and the other covers what the exact one cannot name. The engine
    # saying it ran out is the fact, and the library names it from the engine's
    # own answer rather than from how long the turn lasted. Failing in seconds
    # while writing nothing is the shape of a turn that never started, whatever
    # it was.
    idle = (not result.ok and grew_to == grew_from
            and elapsed_ms < worker["limits"]["idle_failure_seconds"] * 1000)
    unspent = idle or (result.failure is not None
                       and result.failure.kind == engine.FailureKind.QUOTA)

    landed, outcome, marks = _settle(landing["status"], _held_ahead(landing),
                                     _stage_of(landing) != stage, unspent)
    # What the turn cost is kept whenever the engine reported it, on every path:
    # a turn stopped by the account's limit after real work still spent that.
    measured = (("cost_usd", result.cost_usd), ("duration_ms", result.duration_ms),
                ("num_turns", result.num_turns), ("elapsed_ms", elapsed_ms),
                ("model", result.model))
    metrics = {k: v for k, v in measured if v is not None}
    metrics.update(marks)
    pointer = pinned if result.engine == "claude" else (result.session_id or pinned)
    # A returned id that is not the one the turn was given means it did not
    # honour the pin, and the pointer would otherwise name a transcript that was
    # never written.
    if result.session_id and result.session_id != pointer:
        metrics["session_id_actual"] = result.session_id
    report.update({k: True for k in marks if k in ("waiting", "handoff")})
    if unspent:
        report["returned_unspent"] = True

    _close(entry, execution, outcome, landed, detail if not result.ok else None,
           result.engine, pointer, metrics, tid, report)
    if unspent:
        report["held_until"] = _hold_off(entry, tid,
                                         worker["limits"]["hold_seconds_on_exhaustion"])
    if result.cost_usd is not None:
        report["cost_total"] = _accumulate_cost(entry, tid, result.cost_usd)
    # Every raise leaves exactly one entry, including a raise that did nothing. A
    # task picked up that left no trace is indistinguishable from one never
    # picked up, and telling those apart is how a stalled queue is noticed.
    if grew_to == grew_from:
        _note(entry, tid,
              "Raised and left no record: the turn ended without writing to the trail "
              f"({'no answer' if not result.ok else 'answered but recorded nothing'}"
              f"{': ' + detail if detail else ''}).")
    # The reading of the turn, not the turn itself: the answer and the engine's
    # raw report are the worker's, and this verb reads neither.
    turn = {k: v for k, v in result.to_dict().items()
            if k not in ("answer", "structured", "raw")}
    turn["elapsed_ms"] = elapsed_ms
    report["turn"] = turn
    report["trail_grew_by"] = grew_to - grew_from
    _emit(report)


def cmd_runs(entry, args: list[str]) -> None:
    """Every raise of one task, oldest first: what held it, how long, and what
    came of it. Kept out of `show` on purpose - a worker reading a task to act on
    it needs the trail, and bookkeeping in the same payload competes with it."""
    opts = _flags(args, (), takes=1)
    if not opts["_loose"]:
        _die(6, "input", "runs needs a task", f"{NAME} runs <uuid|unique_key>")
    with _connect(entry) as conn, conn.cursor() as cur:
        tid = _task_id(cur, opts["_loose"][0])
        cur.execute(f"""select * from {SCHEMA}.task_executions where task_id = %s
                         order by started_at asc""", (tid,))
        rows = _rows(cur)
    _emit({"task": tid, "attempts": len(rows), "executions": rows})


def cmd_history(entry, args: list[str]) -> None:
    """How the task's state moved, oldest first, and what caused each move.

    The table starts where the capability started recording, so a task older
    than that shows nothing before its first move rather than a reconstruction."""
    opts = _flags(args, ("field",), takes=1)
    if not opts["_loose"]:
        _die(6, "input", "history needs a task", f"{NAME} history <uuid|unique_key>")
    clause, params = "", []
    if opts.get("field"):
        clause = " and field = %s"
        params = [opts["field"]]
    with _connect(entry) as conn, conn.cursor() as cur:
        tid = _task_id(cur, opts["_loose"][0])
        cur.execute(f"""select * from {SCHEMA}.task_changes
                         where task_id = %s{clause} order by changed_at asc""",
                    [tid] + params)
        rows = _rows(cur)
    _emit({"task": tid, "changes": rows})


# --- Store schema ------------------------------------------------------------

_TABLES = ("tasks", "task_activities", "task_executions", "task_changes")

# Columns a later version added to a table an earlier one created. `migrate`
# names the ones a store lacks, so a store that has every table and is still a
# column behind reads as behind rather than as current.
_COLUMNS = (("task_executions", "metrics"), ("tasks", "created_by"),
            ("task_activities", "actor"))

# Values a later version added to a check constraint an earlier one created.
# `create table if not exists` never revisits the constraint it created, so a
# store with every table and every column can still refuse a status this version
# writes. Named the way a missing column is, so a store one value behind reads as
# behind rather than as current.
_CONSTRAINTS = (("tasks", "tasks_status_check", "waiting"),)


def _bundle_dir() -> Path:
    executable = Path(__file__).resolve()
    return (executable.parent.parent
            if executable.parent.name == "bin" else executable.parent)


def _schema_ddl(target: str) -> str:
    """The packaged schema, addressed to the schema this connection names.

    `schema.sql` is written against the default name so that it stays runnable
    by hand through psql, which is why the name is rewritten here rather than
    carried as a placeholder. Only the leading qualifier moves: `tasks.` in
    `comment on column tasks.tasks.type` occurs twice and the second one is a
    table, not a schema."""
    path = _bundle_dir() / "schema.sql"
    if not path.is_file():
        _die(3, "not_found", f"the packaged schema is missing at {path}",
             "reinstall the capability, or apply the schema from its source repository")
    sql = path.read_text()
    if target == "tasks":
        return sql
    sql = re.sub(r"(?<![.\w])tasks\.", f"{target}.", sql)
    return sql.replace("create schema if not exists tasks;",
                       f"create schema if not exists {target};")


def _tables_present(cur, schema: str) -> list[str]:
    cur.execute("""select table_name from information_schema.tables
                    where table_schema = %s order by table_name""", (schema,))
    return [r["table_name"] for r in cur.fetchall()]


def _columns_absent(cur, schema: str, tables: list[str]) -> list[str]:
    """Later columns missing from tables that are present, as table.column. A
    table that is absent is reported as a table, not as each of its columns."""
    cur.execute("""select table_name, column_name from information_schema.columns
                    where table_schema = %s""", (schema,))
    present = {(r["table_name"], r["column_name"]) for r in cur.fetchall()}
    return [f"{t}.{c}" for t, c in _COLUMNS if t in tables and (t, c) not in present]


def _constraints_behind(cur, schema: str, tables: list[str]) -> list[str]:
    """Check constraints on tables that are present which do not admit a value a
    later version added, as table.constraint. A table that is absent is reported
    as a table, not as its constraints; a constraint that is absent outright is
    behind too, since applying the schema is what creates it."""
    cur.execute("""select t.relname as table_name, c.conname as name,
                          pg_get_constraintdef(c.oid) as definition
                     from pg_constraint c
                     join pg_class t on t.oid = c.conrelid
                     join pg_namespace n on n.oid = t.relnamespace
                    where n.nspname = %s and c.contype = 'c'""", (schema,))
    defined = {(r["table_name"], r["name"]): r["definition"] for r in cur.fetchall()}
    return [f"{table}.{name}" for table, name, value in _CONSTRAINTS
            if table in tables
            and f"'{value}'" not in (defined.get((table, name)) or "")]


def cmd_migrate(entry, args: list[str]) -> None:
    """Create what this connection's schema is missing, and nothing else.

    Every statement either says `if not exists` or replaces what it writes with
    the same thing, so a store that is already current is left exactly as it is
    and running this again costs a round trip. That is
    what makes it safe to run on a consumer that has been live for months, and
    it is how a consumer picks up tables a later version of the capability adds.

    Without `--apply` it reports what it would create and touches nothing.

    What is created is verified by reading the schema back afterwards rather
    than by trusting that the statements ran, because a partially applied
    schema and a fully applied one both return without error from a batch of
    `if not exists`."""
    opts = _flags(args, (), bools=("apply",))
    schema = _schema(entry)
    ddl = _schema_ddl(schema)
    with _connect(entry) as conn, conn.cursor() as cur:
        before = _tables_present(cur, schema)
        missing = [t for t in _TABLES if t not in before]
        lacking = (_columns_absent(cur, schema, before)
                   + _constraints_behind(cur, schema, before))
        if not opts.get("apply"):
            _emit({"schema": schema, "present": before, "would_create": missing,
                   "would_add": lacking, "applied": False})
            return
        # Applied whole even when every table is present. The file carries
        # additive `alter ... add column if not exists` for columns a later
        # version introduced, and a constraint that replaces itself for values a
        # later version admits; running only when a table is missing would leave
        # a store that has all four tables a column or a status behind forever.
        cur.execute(ddl)
        conn.commit()
        after = _tables_present(cur, schema)
        still = ([t for t in _TABLES if t not in after]
                 + _columns_absent(cur, schema, after)
                 + _constraints_behind(cur, schema, after))
    if still:
        _die(5, "schema_incomplete",
             f"schema {schema} is still missing {', '.join(still)} after applying",
             "the connection's role may not be allowed to create objects in that schema")
    _emit({"schema": schema, "present": after, "created": missing, "added": lacking,
           "applied": True})


# --- Doctor ------------------------------------------------------------------

def cmd_doctor(wanted: str | None) -> None:
    report = _connections_report()
    _doctor_gate(report, wanted)
    reg, _f = _connections_registry()
    conn_id, entry = _select_connection(reg, wanted)
    schema = _schema(entry)
    with _connect(entry) as conn, conn.cursor() as cur:
        cur.execute("select version() as v")
        server = cur.fetchone()["v"].split(" (")[0]
        cur.execute("""select table_name from information_schema.tables
                        where table_schema = %s order by table_name""", (schema,))
        tables = [r["table_name"] for r in cur.fetchall()]
    missing = [t for t in _TABLES if t not in tables]
    if missing:
        _die(5, "schema_missing",
             f"schema {schema} is incomplete: missing {', '.join(missing)}",
             f"`{NAME} migrate --apply` creates them in {schema}")
    # A worker that cannot be read is a turn that will not run, and finding that
    # out here costs nothing while finding it out from a claim costs a task
    # sitting in `in_progress` holding a raise.
    workers, broken = _workers_report()
    if broken:
        _die(6, "worker_invalid",
             f"{len(broken)} problem(s) in {_workers_file()}: " + "; ".join(broken),
             "the file's shape is this capability's contract; `tasks help` states it")
    _emit({"ok": True, "connection": conn_id, "server": server,
           "schema": schema, "tables": tables, "workers": workers})


def _guarded(handler, entry, rest) -> None:
    """A store that refuses a statement is an error to report, not a traceback to
    print. The contract promises structured failure on stderr, and a stack trace
    is neither structured nor actionable."""
    import psycopg
    try:
        handler(entry, rest)
    except psycopg.errors.CheckViolation as exc:
        _die(6, "input", f"the store refused the value: {exc.diag.message_primary}",
             f"statuses are: {', '.join(STATUSES)}")
    except psycopg.errors.UniqueViolation as exc:
        _die(6, "conflict", f"that value is already taken: {exc.diag.message_detail or exc}",
             "unique_key identifies exactly one task")
    except psycopg.Error as exc:
        _die(5, "store_error", f"{type(exc).__name__}: {str(exc).strip()}",
             f"`{NAME} doctor` proves the store is reachable and the schema is present")


def main() -> None:
    _gate()
    argv = sys.argv[1:]
    _contract(argv)
    wanted = None
    cleaned = []
    i = 0
    while i < len(argv):
        if argv[i] == "--connection" and i + 1 < len(argv):
            wanted = argv[i + 1]; i += 2; continue
        if argv[i].startswith("--connection="):
            wanted = argv[i].split("=", 1)[1]; i += 1; continue
        cleaned.append(argv[i]); i += 1
    if not cleaned:
        _cmd_help(); return
    verb, rest = cleaned[0], cleaned[1:]
    if verb == "doctor":
        cmd_doctor(wanted); return
    reg, _f = _connections_registry()
    conn_id, entry = _select_connection(reg, wanted)
    globals()["SCHEMA"] = _schema(entry)
    if verb in WRITE_VERBS:
        _write_gate(conn_id, bool((entry or {}).get("allow_write", WRITE_DEFAULT)), verb)
    handlers = {
        "list": cmd_list, "ready": cmd_ready, "show": cmd_show, "search": cmd_search,
        "add": cmd_add, "set": cmd_set, "meta": cmd_meta, "activity": cmd_activity,
        "claim": cmd_claim, "release": cmd_release, "run": cmd_run,
        "runs": cmd_runs, "history": cmd_history, "migrate": cmd_migrate,
    }
    if verb == "tag":
        cmd_tag(entry, rest); return
    if verb == "untag":
        cmd_tag(entry, rest, remove=True); return
    handler = handlers.get(verb)
    if not handler:
        _die(6, "input", f"unknown command {verb!r}", f"run `{NAME} help`")
    _guarded(handler, entry, rest)


if __name__ == "__main__":
    main()
