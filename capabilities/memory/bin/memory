#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "capabilities-contract>=0.45,<1",
#     "psycopg[binary]>=3.2",
#     "callva-harness-runner==0.10.2",
# ]
# ///
"""memory — the project's memory, one entry at a time, in the project's store.

An entry is one conclusion that should govern work not yet done: a one-line
title, which is the line the index shows, and its text. Entries are appended
and never edited. A conclusion that changed is superseded by a new entry; one
that no longer holds is dropped with the reason; every change is an event in
the entry's trail, which nothing rewrites. The project's context carries a
constant block that says how to record and how to search; no entry is in it,
and every one is one search away.
Agent-invoked: every answer is JSON or plain lines on stdout.

Memory lives in the PostgreSQL the project resolves (STORE). Without a store
there is no memory: every verb that reads or writes it exits 6
`store_not_configured`, and nothing is kept aside to send later.

WRITING  (exit 4 `read_only_switch` under CAPABILITIES_READ_ONLY)
  memory add <text|-> --title TEXT [--pin] [--scope NAME]
      Record one entry; `-` reads the text from stdin. The title is one line of
      at most 200 characters; the text at most 20000. --pin keeps it out of
      every grooming pass, never merged or dropped by one; a rule every
      session must hold belongs in the project's doctrine, since a session
      reaches an entry through search. --scope names a narrower audience (a
      room, a person); the window and grooming take project-wide entries
      only. Safe to repeat: an active entry with the same title, text and scope is
      answered with `"created": false`.
  memory supersede <id> [<id>...] --with <text|-> --title TEXT
                   [--with <text> --title TEXT ...] [--reason TEXT] [--pin]
      Replace entries with new ones, paired --with/--title in order. Each
      replaced entry turns `superseded` and points at the first new entry. A
      replaced pin carries over to the new entries; --pin pins them anyway.
      Not idempotent: a repeat finds the old entries already superseded and
      exits 6 `not_active`.
  memory drop <id> --reason TEXT [--to REF] [--purge]
      Retire an entry that no longer holds; --to names where its content went
      (a doctrine file, a routine, a task) when it was promoted. It stays in
      the store and in `list --status dropped`. --purge is the one hard
      delete, for a secret written by mistake: it takes the whole id, never a
      prefix, removes the text for good and leaves the trail an event without
      it.
  memory pin <id> | memory unpin <id>
      Pin or unpin an active entry, which keeps it out of grooming passes or
      returns it to them; repeating it changes nothing.

  An entry's text is never edited in place; the store refuses it. An id is the
  whole id or its first six or more characters, as `list` shows it. A write
  touches only this project's memory: an entry of another project exits 4
  `foreign_project`.

READING  (plain lines by default; --json gives the stable structured answer)
  memory list [--status active|superseded|dropped|all] [--pinned|--unpinned]
              [--scope NAME|-] [--since WHEN] [--limit N] [--project ID] [--json]
      Index lines, newest first: `[id] date · title`, with (pinned), a scope,
      or what replaced it. Active entries by default; --scope - is the
      project-wide ones. --limit defaults to 50; a capped answer says how many
      matched.
  memory show <id> [--project ID] [--json]
      One entry whole, with its trail.
  memory search <terms> [--all] [--limit N] [--project ID] [--json]
      Index lines for every active entry matching the terms, best match first:
      PostgreSQL full-text search over title and text in the `simple`
      configuration (no stemming, any language; quoted phrases, `or` and `-`
      exclusion work as in a web search), plus a plain substring match. --all
      includes superseded and dropped entries.
  memory log [--since WHEN] [--limit N] [--project ID] [--json]
      The trail, newest first: every add, supersede, drop, reactivation, pin,
      purge, grooming pass and its undo, with who, on which node, and why.
  memory status [--json]
      Counts by status, writes in the last 7 and 30 days (so a drop in writing
      shows), and grooming passes.

  WHEN is a date (2026-10-01), a moment (2026-10-01T12:00:00Z), or an age:
  30m, 12h, 7d, 2w. --project reads another project's memory by its id; it is
  refused on every write.

THE BLOCK
  The manifest's `contribution` carries the block itself, and the capabilities
  manager composes it after this capability's stub line where memory is
  enabled, from the manifest it recorded at install. The block is constant:
  no entry, title, count or moment is in it, nothing renders it, and every
  session of every project carries the same bytes. In this order:
    1. A directive: this memory takes the place of the harness's built-in
       memory in the project.
    2. How to record, with `memory add`, and what belongs in an entry and
       what does not.
    3. How to search, with `memory search`, before relying on what seems
       known.
    4. How to search deeply: a broad question handed to a subagent that
       returns only its conclusion.
    5. Reading one entry with `memory show`, and `memory help` for every
       command.

CONSOLIDATION
  memory groom [--apply | --if-due | --undo <pass>] [--trigger TEXT]
      One grooming pass over the active, unpinned project-wide entries of the
      window, through one agent turn on the harness runner with the project's
      groom_profile, groom_budget_usd, groom_max_turns and
      groom_timeout_seconds. The turn reads the entries and answers a plan; it
      has no tools and writes nothing. The plan merges related or
      contradicting entries into one entry that supersedes its sources, and
      drops what no longer holds. Every operation is checked before anything
      is applied: a merge takes two or more sources, keeps every quotation of
      its sources word for word, and touches no pinned entry; a drop names an
      entry the pass may touch; nothing is in two operations. What fails a
      check is refused and said; nothing is ever deleted and no single entry
      is rewritten. Bare, the pass is a dry run: it prints the plan and
      changes nothing, and still spends the model turn. --apply applies the
      checked plan in one transaction under one pass id, holding the store's
      lease that keeps a second pass for the project out on every machine
      (exit 7 `groom_running`); it needs no session connection, and a store
      reached through a transaction pooler alone serves it. --undo <pass> drops what the pass made and
      reactivates what it superseded or dropped, unless a later change
      overtook it (exit 6 `pass_overtaken`, naming the pass to undo first).
      A model that is not logged in exits 2 `model_not_authenticated`.
      --trigger TEXT records why the pass ran on its trail event.
  memory groom --if-due
      The scheduled form: a pass applied as --apply applies it, run only when
      one is due, and otherwise exit 0 with {"due": false, "why", "window"}
      naming the reason and the window's measure. A pass is due when
      consolidate is true, the window no longer fits (SETTINGS), no pass ran
      for the project within groom_interval_hours on any machine, nothing was
      written for quiet_minutes, no other pass holds the project, and the
      profile's harness is installed and logged in headless. A run that is
      not due spends no model turn. Its trail event says "scheduled: the
      window no longer fits" unless --trigger names another reason. Entries
      that age out of the window are not touched: they stay active and
      searchable.

  Schedule the scheduled form as an automation of the project, hourly for
  instance; `memory guide service` walks it through:
    printf '#!/bin/sh\\nexec memory groom --if-due\\n' > memory-groom.sh
    automations set memory-groom --body memory-groom.sh \\
        --schedule "0 * * * *" --timezone UTC \\
        --description "consolidate memory when its window no longer fits"
  Every machine may run it: the store's lease keeps a second pass out, and
  the interval counts passes on every machine.

MOVING IN AND OUT
  memory adopt [ROOT...] [--apply] [--pin-titles REGEX] [--timezone ZONE]
      Carry existing memory folders into the store. ROOTs are project roots;
      with none, the project roots named by the machine service opt-in lists
      under $XDG_CONFIG_HOME/*/service/projects.{json,toml}. A root's memory
      folder is `memory` inside the body root `capabilities path --json` names
      in a folder with a legacy binding, else <root>/memory. Every file is one day of
      `## [HH:MM — ]title` sections. The day and the HH:MM are read in the
      machine's local zone, or in the IANA zone --timezone names (each date
      taking that zone's offset on it), and every entry's dated_from says which.
      A `<!-- contextkit-memory-id: <hex> -->`
      line names the id of the section after it: it is never an entry nor part
      of one, and the id, recorded on the carried entry, is what makes it the
      same entry on every machine whatever its heading says by then. The
      answer gives every parse decision per entry, every file not read, and
      what it carried, and claims nothing more. A project whose
      policy disables memory is skipped; one without a durable id is skipped
      naming `capabilities init`. Bare, a dry run. --apply enables memory for
      each other project with `capabilities enable memory --project` and
      carries each entry with its original date. Idempotent across machines:
      an entry carried once is answered `already` everywhere after.
      --pin-titles pins the entries whose title matches. The folder itself is
      left as it is.
  memory export [--out PATH] [--project ID]
      Every entry of the project, in every status, with the whole trail, as
      one JSON document; --out writes it to PATH instead.

SETTINGS  (capabilities/memory/service/settings.json, project over global
           $XDG_CONFIG_HOME/memory/service/settings.json, key by key; for an
           agent whose records moved into the store, its rows and the global
           rows, read and written with `memory settings`)
  The window is the active, unpinned project-wide entries of the last
  window_days, topped up to min_entries with older ones; it fits while it
  holds at most max_entries and, each entry written out at entry_chars, at
  most block_chars characters. A window that no longer fits is what a
  grooming pass is for.
  window_days 30 (1-3650)       entries this recent are the window
  min_entries 5 (0-200)         a dormant project's window still holds its newest five
  max_entries 30 (1-500)        the most entries the window holds and still fits
  block_chars 12000 (2000-16000)  the most characters the window takes and still fits
  entry_chars 1200 (200-8000, at most half of block_chars)  one entry's text, as measured
  consolidate true              grooming passes by `memory groom --if-due`
  quiet_minutes 30 (0-1440)     no pass until the project is this quiet
  groom_interval_hours 24 (1-720)  at most one pass per project in this time
  groom_profile "claude-read"   the harness profile a pass runs on
  groom_budget_usd 1.0 (0.01-50), groom_max_turns 4 (1-50) on claude
  groom_timeout_seconds 900 (60-7200)
  "version": 1 may stand beside them; any other key is refused (exit 6
  `settings_invalid`).

STORE
  The tables are memory_entries and memory_events in the schema the
  project's store setting names, migrated under the `memory` ledger: the
  AGENTKIT_DB_* keys in the project's .env.local and .env, then the same keys
  in the environment, then the machine's store setting that `capabilities
  store set` writes; the first level that answers is used whole. The store
  refuses an edit of an entry's text, a status move other than active to
  superseded or dropped and back, any change to the trail, and a delete other
  than `drop --purge`. Every change raises the project's version of the
  channel `memory_changed` in the store's change versions (schema_channel,
  scope the project id) in the writer's own transaction, so a reader follows
  the version rather than listening. For a reader of an earlier release the
  store also sends the notification `memory_changed` as the change commits,
  with the payload {"schema", "agent_id", "kind", "entry", "event"} - ids
  only, never text.

CONTRACT VERBS
  memory help                  this text
  memory doctor                store, tables, identity, settings and
                               consolidation, in this project;
                               until 2027-01-05 it warns (`earlier_release`,
                               exit unchanged) of an earlier release grooming
                               against the store, naming its machine
  memory connections           none: memory reaches no system of its own
  memory stub                  the one-line awareness text
  memory manifest --json       the declaration, with `contribution`
  memory guide [<topic>]       how-to guides
  memory ids list|get|set|rm   this project's identifiers
  memory refs                  this project's references
  memory inventory [--network] the empty answer: memory keeps nothing on
                               this machine; the entries are the store's
                               (`memory status`)
  memory migrate [status]      bring the tables up to this version / report

I/O
  Success is JSON on stdout, or plain lines for a read without --json;
  failure is {"error": {"code", "message", "hint"?}} on stderr.

EXIT CODES
  0 success
  2 the model a grooming pass runs on is not logged in
  3 not found - no entry, pass or project of that id
  4 policy - memory not enabled, the read-only switch, or a write to another
    project's entry
  5 store or harness - unreachable, busy, or a model turn that failed
  6 input - a malformed argument, invalid settings, no store configured, no
    project identity, an entry not in the state the verb needs
  7 busy - another grooming pass holds the project
"""

import argparse
import contextlib
import dataclasses
import importlib.util
import json
import os
import re
import socket
import subprocess
import sys
import time
from pathlib import Path
from typing import Any, NoReturn
from zoneinfo import ZoneInfo, ZoneInfoNotFoundError

NAME = "memory"
SUMMARY = ("Project memory over a PostgreSQL store - conclusions recorded one entry at a "
           "time and searched on demand, a constant block in every session's context that says "
           "how to record and search them, and a grooming pass, run on a schedule, that "
           "consolidates the entries.")
SCOPE = "project"
CRED_KEYS: list = []

# Where this capability's settings live, and the keys it declares; `settings` reads and writes them.
SETTINGS = {'homes': [{'scope': 'project',
            'path': 'service/settings.json',
            'format': 'json',
            'inherits': 'global'},
           {'scope': 'global', 'path': 'service/settings.json', 'format': 'json'}],
 'keys': [{'key': 'window_days',
           'label': 'Window',
           'help': 'Entries this recent are the window.',
           'type': 'integer',
           'default': 30,
           'minimum': 1,
           'maximum': 3650,
           'scope': 'project',
           'apply': 'next_call'},
          {'key': 'max_entries',
           'label': 'Window entries',
           'help': 'The most entries the window holds and still fits.',
           'type': 'integer',
           'default': 30,
           'minimum': 1,
           'maximum': 500,
           'scope': 'project',
           'apply': 'next_call'},
          {'key': 'block_chars',
           'label': 'Window characters',
           'help': 'The most characters the window takes and still fits.',
           'type': 'integer',
           'default': 12000,
           'minimum': 2000,
           'maximum': 16000,
           'scope': 'project',
           'apply': 'next_call'},
          {'key': 'consolidate',
