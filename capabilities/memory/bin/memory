# Every verb that changes the store's record of a project's memory; each is
# refused under the read-only switch. `groom` and `adopt` write only with
# --apply or --undo.
WRITE_VERBS = {"add", "supersede", "drop", "pin", "unpin", "groom", "adopt"}
WRITE_DEFAULT = True
DOCS_BASE = ("https://raw.githubusercontent.com/ai-cluster-one/capabilities/"
             "main/capabilities/memory/guides/")
STATE = False       # nothing of memory's own is kept on this machine; entries are the store's
TABLES = True       # memory_* tables in the project's store, built by _tables()
INVENTORY = None    # what memory holds is in the store; reading it is `memory status`
POST_INSTALL: list[dict] = []
# The block the manager composes after the stub line in every session's
# context, carried whole in the declaration. It is constant - no entry, count
# or moment is in it - so a context built from it is the same in every session
# and the prompt cache holds; every entry is one search away.
BLOCK = "\n\n".join([
    "This is the project's memory, and it takes the place of the harness's built-in "
    "memory: record here what should outlast this session, and look here before relying "
    "on what seems known. Do not keep memory in the harness's own memory files or memory "
    "tool in this project.",
    "Record first, the moment a conclusion is reached: "
    "`memory add \"<the conclusion, its reason and its evidence>\" "
    "--title \"<the conclusion in one line>\"`. An entry is one conclusion that should "
    "govern work not yet done and has no other home yet - a decision, a correction, a "
    "fact learned the hard way. It is not an account of what a run did, which belongs "
    "in that run's own record; not a procedure or a settled rule, which belong in the "
    "project's routines and doctrine; not what the code or a tool already answers; and "
    "never a secret.",
    "Search before relying on what seems known: `memory search \"<terms>\"` gives the "
    "index line of every active entry that matches.",
    "Search deeply by handing a broad question to a subagent: it searches, lists and "
    "reads the entries and returns only its conclusion, so the reading does not crowd "
    "this session.",
    "`memory show <id>` reads one entry whole, with its trail; `memory help` gives every "
    "command.",
]) + "\n"
CONTRIBUTION = {"markdown": BLOCK}

_CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
CREDENTIALS_ENV = _CONFIG_HOME / NAME / "credentials.env"

# The shared capability code is the capabilities-contract library's, bound here
# into this script's namespace (SHEBANG.md, "The contract verbs").
from capabilities_contract.capability import bind as _contract_bind

_contract_bind(globals(), "core")

_contract_bind(globals(), "store")


def _cmd_connections() -> None:
    """Memory reaches no system of its own: the store is the project's, resolved
    through the shared library, so there is nothing to resolve here."""
    _emit({"default": None, "connections": {}})


# ── the engine, the project, the store ──────────────────────────────────────

_PROJECT_POINTERS = ("CLAUDE_PROJECT_DIR", "CAPABILITIES_PROJECT_ID",
                     "CAPABILITIES_PROJECT_ID_ROOT", "CAPABILITIES_PROJECT_ENVELOPE",
                     "CAPABILITIES_PROJECT_ENVELOPE_ROOT")
_SETTING_SLUGS = frozenset({
    "store_not_configured", "store_not_postgres", "store_setting_unreadable",
    "store_setting_too_new", "bad_store_setting", "sslmode_too_weak",
    "bad_schema_name", "driver_missing", "transaction_pooler"})
_STORE_HINT = ("set AGENTKIT_DB_URL (or AGENTKIT_DB_HOST, AGENTKIT_DB_NAME, AGENTKIT_DB_USER, "
               "AGENTKIT_DB_PASSWORD) in the project's .env.local or the environment, or run "
               "`capabilities store set`")


def _bundle_dir() -> Path:
    here = Path(__file__).resolve()
    return here.parent.parent if here.parent.name == "bin" else here.parent


_ENGINE = None


def _engine():
    """The bundled engine, loaded once from the installed bundle."""
    global _ENGINE
    if _ENGINE is None:
        path = _bundle_dir() / "engine.py"
        spec = importlib.util.spec_from_file_location("memory_engine", path)
        module = importlib.util.module_from_spec(spec)
        sys.modules["memory_engine"] = module
        spec.loader.exec_module(module)
        _ENGINE = module
    return _ENGINE


def _tables():
    engine = _engine()
    return engine.LEDGER_STEPS, engine.LEDGER_MAJOR, engine.LEDGER_MINOR


def _refused(exc) -> NoReturn:
    _die(exc.exit_code, exc.code, exc.message, exc.hint)


def _store_refused(exc) -> NoReturn:
    if exc.slug == "store_not_configured":
        _die(6, "store_not_configured",
             f"{NAME} keeps a project's memory in a store, and none is configured here",
             _STORE_HINT)
    _die(6 if exc.slug in _SETTING_SLUGS else 5, exc.slug, exc.message, exc.hint)


def _manifest() -> dict:
    """The contract's manifest, with the context contribution this capability
    declares."""
    return {**_manifest_core(), "contribution": CONTRIBUTION}


def _root() -> Path:
    root = _project_root()
    if root is None:
        _die(6, "no_project", f"{NAME} keeps a project's memory; run it inside a project",
             "cd into the project, or set CLAUDE_PROJECT_DIR")
    return root


def _project(write: bool) -> str:
    """The id of the project this command stands in: verified for a write,
    as recorded for a read."""
    _root()
    project = _project_id(write=write)
    if not project:
        _die(6, "no_project_identity", "this project has no durable id",
             "run `capabilities init` in the project")
    return str(project)


def _reading(named: str | None) -> str:
    if named is not None:
        named = named.strip()
        if not named:
            _die(6, "input", "--project names a project id")
        return named
    return _project(write=False)


def _actor() -> str:
    named = os.environ.get("MEMORY_ACTOR", "").strip()
    if named:
        return named[:200]
    user = os.environ.get("USER") or os.environ.get("LOGNAME")
    if not user:
        with contextlib.suppress(Exception):
            import pwd
            user = pwd.getpwuid(os.getuid()).pw_name
    return f"{user or 'unknown'}@{node_name()}"


def _utc_now() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def _settings() -> dict:
    """The settings in force for this project: its service/settings.json over
    the global one, key by key, checked whole."""
    try:
        rows = _records().resolve(NAME, "setting")
    except StoreError as exc:
        _die(6, exc.slug, exc.message, exc.hint)
    raw = {key: row["value"] for key, row in rows.items() if key != "connection.default"}
    root = _project_root()
    where = (_settings_where(root) if root is not None else "settings") + (
        " over the global rows" if root is not None and _records_in_store()
        else f" over {_CONFIG_HOME / NAME / 'service' / 'settings.json'}")
    try:
        return _engine().read_settings(raw, where)
    except _engine().Refusal as exc:
        _refused(exc)


def _settings_merged(scope: str, document: dict) -> dict | None:
    """The settings memory would load once `document` is written at
    `scope`: the project's over the global one, key by key. None outside a
    project, where there is nothing to merge it into."""
    if _project_root() is None:
        return None
    other = "global" if scope == "project" else "project"
    try:
        held = {key: row["value"] for key, row in
                _records().resolve_scope(NAME, "setting", other).items()
                if key != "connection.default"}
    except StoreError as exc:
        return {"__error__": exc.message}
    return {**held, **document} if scope == "project" else {**document, **held}


def _settings_check(scope: str, document: dict) -> list:
    """What memory finds wrong with this project's settings once the
    contract's `settings` verb writes `document` at `scope`."""
    if scope not in ("project", "global"):
        return []
    merged = _settings_merged(scope, document)
    if merged is None:
        return []
    if "__error__" in merged:
        return [merged["__error__"]]
    home = _settings_homes(scope)[0]
    where = (_records().collection_source(NAME, "setting") if _settings_in_rows(home)
             else _settings_home_path(home))
    try:
        _engine().read_settings(merged, str(where))
    except _engine().Refusal as exc:
        return [getattr(exc, "message", None) or str(exc)]
    return []


def _settings_path(root: Path) -> Path:
    return _project_capabilities_dir(root) / NAME / "service" / "settings.json"


def _settings_where(root: Path) -> str:
    """Where this project's settings are kept, as a person reads it: the file,
    or the store's rows for an agent whose records moved there."""
    home = _settings_homes("project")[0]
    if _settings_in_rows(home):
        return str(_settings_read(home)[0])
    return str(_settings_path(root))


def _open_store(root: Path | None, session: bool = False):
    engine = _engine()
    try:
        return engine.Store(engine.resolve_store(root), session=session).open()
    except engine.StoreUnavailable as exc:
        _store_refused(exc)


@contextlib.contextmanager
def _guarded():
    """Turn a refusal, an unusable store, or a lost connection into the error
    envelope."""
    engine = _engine()
    try:
        yield
    except engine.Refusal as exc:
        _refused(exc)
    except engine.StoreUnavailable as exc:
        _store_refused(exc)
    except Exception as exc:
        import psycopg
        if isinstance(exc, (psycopg.OperationalError, psycopg.InterfaceError)):
            _die(5, "store_unreachable", f"the store stopped answering: {exc}",
                 "`memory doctor` proves the store")
        if isinstance(exc, psycopg.errors.CheckViolation):
            _die(6, "refused_by_store", str(exc).splitlines()[0])
        raise


def _text_arg(value: str) -> str:
    if value == "-":
        return sys.stdin.read()
    return value


_AGE = re.compile(r"(\d+)\s*([mhdw])")


def _when(value: str | None):
    import datetime as dt
    if value is None:
        return None
    text = value.strip()
    age = _AGE.fullmatch(text)
    if age:
        unit = {"m": "minutes", "h": "hours", "d": "days", "w": "weeks"}[age.group(2)]
        return dt.datetime.now(dt.timezone.utc) - dt.timedelta(**{unit: int(age.group(1))})
    try:
        moment = dt.datetime.fromisoformat(text.replace("Z", "+00:00"))
    except ValueError:
        _die(6, "input", f"--since {value!r} is no date, moment or age",
             "a date (2026-10-01), a moment (2026-10-01T12:00:00Z) or an age (30m, 12h, 7d, 2w)")
    if moment.tzinfo is None:
        moment = moment.replace(tzinfo=dt.timezone.utc)
    return moment


# ── the lines a read prints ──────────────────────────────────────────────────

def _index_line(entry: dict) -> str:
    engine = _engine()
    line = f"[{entry['short']}] {entry['created_at'][:10]} · {entry['title']}"
    marks = []
    if entry.get("pinned"):
        marks.append("pinned")
    if entry.get("scope"):
        marks.append(f"scope {entry['scope']}")
    if entry.get("merged"):
        merged = entry["merged"]
        span = merged.get("from") or ""
        if merged.get("to") and merged.get("to") != span:
            span += f"..{merged['to']}"
        marks.append(f"merged {merged['count']}, {span}")
    if entry.get("status") == "superseded":
        marks.append(f"superseded by {engine.short(entry['superseded_by'])}")
    elif entry.get("status") == "dropped":
        marks.append("dropped" + (f" to {entry['destination']}" if entry.get("destination")
                                  else ""))
    return line + (f" ({'; '.join(marks)})" if marks else "")


def _event_line(event: dict) -> str:
    engine = _engine()
    line = f"{event['at']} {event['kind']}"
    if event.get("entry_id"):
        line += f" [{engine.short(event['entry_id'])}]"
        if event.get("title"):
            line += f" {event['title']}"
    line += f" - {event['actor']} on {event['node']}"
    if event.get("reason"):
        line += f": {event['reason']}"
    if event.get("pass_id"):
        line += f" (pass {event['pass_id']})"
    return line


def _lines(lines: list[str]) -> None:
    sys.stdout.write("".join(line + "\n" for line in lines))


# ── writing ──────────────────────────────────────────────────────────────────

def cmd_add(args) -> None:
    engine = _engine()
    project = _project(write=True)
    root = _root()
    with _guarded():
        title = engine.check_title(args.title)
        body = engine.check_body(_text_arg(args.text))
        scope = (args.scope or "").strip() or None
        with _open_store(root) as store:
            row, created = store.add(project, title, body, scope=scope, pinned=args.pin,
                                     actor=_actor(), node=node_name())
            out = {"created": created, "entry": engine.entry_out(row, with_body=False)}
    _emit(out)


def cmd_supersede(args) -> None:
    engine = _engine()
    if len(args.with_) != len(args.title):
        _die(6, "input", f"{len(args.with_)} --with and {len(args.title)} --title: each new "
             "entry is one --with and one --title, in order")
    project = _project(write=True)
    root = _root()
    with _guarded():
        news = [(engine.check_title(title), engine.check_body(_text_arg(text)))
                for text, title in zip(args.with_, args.title)]
        with _open_store(root) as store:
            out = store.supersede(project, args.ids, news, reason=args.reason, pin=args.pin,
                                  actor=_actor(), node=node_name())
    _emit(out)


def cmd_drop(args) -> None:
    project = _project(write=True)
    root = _root()
    reason = (args.reason or "").strip()
    if not reason:
        _die(6, "input", "a drop says why the entry no longer holds", "pass --reason TEXT")
    with _guarded():
        with _open_store(root) as store:
            out = store.drop(project, args.id, reason=reason, to=(args.to or None),
                             purge=args.purge, actor=_actor(), node=node_name())
    _emit(out)


def cmd_pin(args, pinned: bool) -> None:
    project = _project(write=True)
    root = _root()
    with _guarded():
        with _open_store(root) as store:
            out = store.set_pin(project, args.id, pinned, actor=_actor(), node=node_name())
    _emit(out)


# ── reading ──────────────────────────────────────────────────────────────────

def cmd_list(args) -> None:
    engine = _engine()
    project = _reading(args.project)
    pinned = True if args.pinned else (False if args.unpinned else None)
    with _guarded(), _open_store(_project_root()) as store:
        rows, total = store.listing(project, status=args.status, pinned=pinned,
                                    scope=args.scope, since=_when(args.since), limit=args.limit)
    entries = [engine.entry_out(r, with_body=False) for r in rows]
    if args.json:
        _emit({"project": project, "status": args.status, "total": total,
               "shown": len(entries), "entries": entries})
        return
    lines = [_index_line(e) for e in entries]
    if total > len(entries):
        lines.append(f"(showing {len(entries)} of {total}; --limit raises it)")
    if not entries:
        lines.append(f"(no {'' if args.status == 'all' else args.status + ' '}entries)")
    _lines(lines)


def cmd_show(args) -> None:
    engine = _engine()
    project = _reading(args.project)
    with _guarded(), _open_store(_project_root()) as store:
        row = store.resolve(project, args.id)
        row = store._with_merged([row])[0]
        trail = [engine.event_out(e) for e in store.trail(row["id"])]
    entry = engine.entry_out(row)
    if args.json:
        _emit({"entry": entry, "trail": trail})
        return
    head = [f"[{entry['short']}] {entry['title']}",
            f"id {entry['id']} · {entry['status']}" + (" · pinned" if entry["pinned"] else "")
            + f" · {entry['created_at']} by {entry['created_by']} on {entry['node']}"
            + f" · {entry['origin']}" + (f" · scope {entry['scope']}" if entry["scope"] else "")]
    if entry.get("superseded_by"):
        head.append(f"superseded by {entry['superseded_by']}")
    if entry.get("destination"):
        head.append(f"went to {entry['destination']}")
    if entry.get("merged"):
        merged = entry["merged"]
        head.append(f"merged {merged['count']}, {merged.get('from')}..{merged.get('to')}")
    _lines(head + ["", entry["body"], "", "Trail:"]
           + ["- " + _event_line(e) for e in trail])


def cmd_search(args) -> None:
    engine = _engine()
    project = _reading(args.project)
    query = " ".join(args.terms).strip()
    if not query:
        _die(6, "input", "search takes the terms to look for", 'memory search "<terms>"')
    with _guarded(), _open_store(_project_root()) as store:
        rows, total = store.search(project, query, everything=args.all, limit=args.limit)
    entries = [engine.entry_out(r, with_body=False) for r in rows]
    if args.json:
        _emit({"project": project, "query": query, "total": total, "shown": len(entries),
               "entries": entries})
        return
    lines = [_index_line(e) for e in entries]
    if total > len(entries):
        lines.append(f"(showing {len(entries)} of {total} matches; --limit raises it)")
    if not entries:
        lines.append(f"(nothing matches {query!r}"
                     + (")" if args.all else "; --all looks in superseded and dropped too)"))
    _lines(lines)


def cmd_log(args) -> None:
    engine = _engine()
    project = _reading(args.project)
    with _guarded(), _open_store(_project_root()) as store:
        rows, total = store.log(project, since=_when(args.since), limit=args.limit)
    events = [engine.event_out(r) for r in rows]
    if args.json:
        _emit({"project": project, "total": total, "shown": len(events), "events": events})
        return
    lines = [_event_line(e) for e in events]
    if total > len(events):
        lines.append(f"(showing {len(events)} of {total} events; --limit raises it)")
    if not events:
        lines.append("(no events)")
    _lines(lines)


def cmd_status(args) -> None:
    project = _project(write=False)
    root = _root()
    with _guarded(), _open_store(root) as store:
        counts = store.counts(project)
        label = _engine().store_label(store.setting)
    _emit({"project": project, "store": label, **counts})


# ── grooming ─────────────────────────────────────────────────────────────────

_MODEL_READY: dict = {}
_MODEL_READY_SECONDS = 3600.0


def _harness():
    from callva import harness_runner
    return harness_runner


def _groom_profile(settings: dict):
    """The profile a pass runs on: the named one, with no tools, the plan's
    schema, and the project's budget, turns and deadline."""
    hr = _harness()
    try:
        profile = hr.find_profile(settings["groom_profile"])
    except hr.ProfileError as exc:
        _die(6, "groom_profile", f"profile {settings['groom_profile']!r}: {exc}",
             "name a profile the harness runner resolves in groom_profile")
    changes: dict = {"output_schema": _engine().GROOM_SCHEMA,
                     "timeout_seconds": settings["groom_timeout_seconds"]}
    if profile.harness == "claude":
        extra = dict(getattr(profile, "claude_extra_args", None) or {})
        extra["max-turns"] = str(settings["groom_max_turns"])
        changes.update(tools=[], budget_usd=float(settings["groom_budget_usd"]),
                       claude_extra_args=extra)
    try:
        return dataclasses.replace(profile, **changes)
    except hr.ProfileError as exc:
        _die(6, "groom_profile", f"profile {settings['groom_profile']!r} cannot run a pass: "
             f"{exc}", "name a claude or codex profile in groom_profile")


def _model_ready(settings: dict) -> tuple[bool, str | None]:
    """Whether a pass can run here: the profile resolves, its harness is
    installed, and it is logged in headless. Asked of the harness's own CLI,
    remembered for an hour; no model turn is spent on it."""
    name = settings["groom_profile"]
    held = _MODEL_READY.get(name)
    if held and time.monotonic() - held[0] < _MODEL_READY_SECONDS:
        return held[1], held[2]
    answer = _ask_model_ready(name)
    _MODEL_READY[name] = (time.monotonic(), *answer)
    return answer


def _ask_model_ready(name: str) -> tuple[bool, str | None]:
    try:
        hr = _harness()
        harness = hr.find_profile(name).harness
    except Exception as exc:
        return False, f"profile {name!r} does not resolve: {exc}"
    path = hr.find_binary(harness)
    if not path:
        return False, f"no {harness} executable on this machine"
    argv = [path, "auth", "status", "--json"] if harness == "claude" else \
        [path, "login", "status"]
    try:
        done = subprocess.run(argv, capture_output=True, text=True, timeout=20,
                              stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return False, f"cannot ask {harness} whether it is logged in: {exc}"
    if harness == "claude":
        try:
            logged = bool(json.loads(done.stdout).get("loggedIn"))
        except (ValueError, AttributeError):
            logged = False
    else:
        logged = done.returncode == 0
    if not logged:
        return False, (f"{harness} is not logged in on this machine; log it in headless "
                       f"(`{harness} {'auth login' if harness == 'claude' else 'login'}`) "
                       "for grooming passes to run")
    return True, None


def _run_model(root: Path, settings: dict, prompt: str):
    """One agent turn answering the plan, in the project's root, under the
    read-only switch so nothing it starts writes through a capability."""
    hr = _harness()
    profile = _groom_profile(settings)
    result = hr.run(prompt, profile, cwd=str(root),
                    extra_env={"CAPABILITIES_READ_ONLY": "1"})
    if not result.ok:
        kind = str(getattr(result.failure.kind, "value", result.failure.kind))
        if kind == "not_authenticated":
            _die(2, "model_not_authenticated",
                 f"the {profile.harness} harness is not logged in: {result.failure.message}",
                 f"log {profile.harness} in headless on this machine, then run it again")
        _die(5, "groom_turn_failed", f"the grooming turn ended {kind}: "
             f"{result.failure.message}", "nothing was changed; run it again later")
    return result, profile


def _groom_due(store, project: str, settings: dict) -> tuple[str | None, dict]:
    """Why no pass is due for the project now, or None when one is, and the
    window's measure. Due is consolidation on, the window no longer fitting,
    no pass within groom_interval_hours on any machine, no write for
    quiet_minutes, and the profile's harness installed and logged in; the
    model readiness is asked last, since it starts the harness's own CLI."""
    import datetime as dt
    engine = _engine()
    now = engine.now_utc()
    window = engine.measure_window(store.render_rows(project), settings, now=now)
    if not settings["consolidate"]:
        return "consolidate is false in the project's settings", window
    if window["fits"]:
        return (f"the window fits: {window['window']} entries of {window['window_chars']} "
                f"characters, within max_entries {settings['max_entries']} and block_chars "
                f"{settings['block_chars']}"), window
    last_pass = store.last_pass_at(project)
    if last_pass and now - last_pass < dt.timedelta(hours=settings["groom_interval_hours"]):
        return (f"a pass ran at {engine.iso(last_pass)}, within groom_interval_hours "
                f"({settings['groom_interval_hours']})"), window
    last_write = store.last_write_at(project)
    if last_write and now - last_write < dt.timedelta(minutes=settings["quiet_minutes"]):
        return (f"the memory was written at {engine.iso(last_write)}, within quiet_minutes "
                f"({settings['quiet_minutes']})"), window
    ready, why = _model_ready(settings)
    if not ready:
        return why, window
    return None, window


def cmd_groom(args) -> None:
    engine = _engine()
    if args.undo and (args.apply or args.if_due):
        _die(6, "input", "--undo applies itself; leave --apply and --if-due out")
    apply = bool(args.apply or args.if_due)
    if apply or args.undo:
        _read_only_gate(f"`{NAME} groom "
                        f"{'--undo' if args.undo else '--if-due' if args.if_due else '--apply'}`")
    project = _project(write=bool(apply or args.undo))
    root = _root()
    settings = _settings()
    # A session connection where the store has a session address: the pass's
    # lease is held across its transactions, beside the session lock an
    # earlier release keeps passes out by until 2027-01-05. A transaction-only
    # store gets a transaction connection and the lease alone.
    with _guarded(), _open_store(root, session=True) as store:
        if args.undo:
            _emit(store.undo_pass(project, args.undo, actor=_actor(), node=node_name()))
            return
        if args.if_due:
            why, window = _groom_due(store, project, settings)
            if why is not None:
                _emit({"project": project, "due": False, "why": why, "window": window})
                return
        if apply and not store.try_groom_lock(
                project, settings["groom_timeout_seconds"] + engine.GROOM_LEASE_GRACE_SECONDS,
                node=node_name()):
            if args.if_due:
                _emit({"project": project, "due": False,
                       "why": "another grooming pass holds this project's memory"})
                return
            _die(7, "groom_running", "another grooming pass holds this project's memory",
                 "it ends on its own; run it again afterwards")
        try:
            movable, pinned = store.candidates(project, settings["window_days"])
            base = {"project": project, "mode": "apply" if apply else "dry-run",
                    **({"due": True} if args.if_due else {}),
                    "candidates": len(movable), "pinned": len(pinned)}
            if len(movable) < 2:
                _emit({**base, "nothing_to_do": "fewer than two unpinned entries in the "
                       "window; a pass merges two or more"})
                return
            result, profile = _run_model(root, settings,
                                         engine.groom_prompt(movable, pinned))
            accepted, refused = engine.check_plan(result.structured, movable, pinned)
            model = {"harness": profile.harness, "model": result.model,
                     "cost_usd": result.cost_usd, "duration_ms": result.duration_ms}
            out = {**base, "model": model, "plan": engine.describe_plan(accepted, movable),
                   "refused": refused}
            if apply:
                trigger = args.trigger or ("scheduled: the window no longer fits"
                                           if args.if_due else "by hand")
                summary = {"trigger": trigger, "model": model,
                           "profile": settings["groom_profile"], "refused": refused,
                           "candidates": len(movable)}
                out["applied"] = store.apply_pass(project, accepted, actor=_actor(),
                                                  node=node_name(), summary=summary)
            else:
                out["next"] = "`memory groom --apply` runs a pass and applies what it checks"
        finally:
            if apply:
                store.groom_unlock(project)
    _emit(out)


# ── adopt and export ─────────────────────────────────────────────────────────

def _manager_bin() -> str:
    return os.environ.get("CAPABILITIES_MANAGER_BIN", "").strip() or "capabilities"


def _memory_folder(root: Path) -> tuple[Path, str]:
    """A project's memory folder: in a folder with a legacy binding, `memory`
    in the body root the manager's `path --json` names for it, else
    <root>/memory."""
    if (root / ".contextkit" / "config.toml").is_file():
        env = {k: v for k, v in os.environ.items() if k not in _PROJECT_POINTERS}
        try:
            done = subprocess.run([_manager_bin(), "path", "--json"], cwd=root, env=env,
                                  capture_output=True, text=True, timeout=30,
                                  stdin=subprocess.DEVNULL)
            body = json.loads(done.stdout).get("body_root") if done.returncode == 0 else None
            if isinstance(body, str) and body.strip():
                folder = root / body.strip() / "memory"
                folder.resolve().relative_to(root.resolve())
                return folder, "the body root named by `capabilities path --json`"
        except (OSError, subprocess.TimeoutExpired, ValueError, AttributeError):
            pass
        return root / "memory", "<root>/memory; `capabilities path --json` named no body root"
    return root / "memory", "<root>/memory"


def _adopt_roots(given: list[str]) -> tuple[list[Path], list[dict]]:
    if given:
        return [Path(r).expanduser().resolve() for r in given], []
    roots: list[Path] = []
    lists: dict = {}
    for source, root in _engine().iter_listed_roots(_CONFIG_HOME):
        lists.setdefault(source, {"list": source, "roots": 0})
        if not root:
            lists[source]["error"] = "it does not read"
            continue
        lists[source]["roots"] += 1
        path = Path(root)
        if path not in roots:
            roots.append(path)
    return roots, list(lists.values())


def _adopt_one(root: Path, apply: bool, pin_titles, zone=None) -> dict:
    engine = _engine()
    row: dict = {"root": str(root)}
    if not root.is_dir():
        return {**row, "decision": "skip", "why": "no such folder"}

    def question():
        project = _project_id(write=True, refuse=False)
        return {"project": project, "policy": _policy_state(),
                "explicit": _project_policy_scope()}

    try:
        found = _ask_in_project(root, question)
    except engine.Refusal as exc:
        return {**row, "decision": "skip", "why": f"{exc.code}: {exc.message}"}
    project = found["project"]
    row["project_id"] = project
    if found["explicit"] is False:
        return {**row, "decision": "skip", "why": f"{NAME} is disabled in this project"}
    if not project:
        return {**row, "decision": "skip", "why": "the project has no durable id it may be "
                "written under; run `capabilities init` there"}
    folder, named = _memory_folder(root)
    row["memory_folder"] = str(folder)
    row["folder_from"] = named
    parsed = engine.parse_memory_folder(folder, zone)
    row["not_read"] = parsed["not_read"]
    entries = parsed["entries"]
    if not folder.is_dir():
        return {**row, "decision": "skip", "why": "no memory folder", "entries": []}
    store = None
    try:
        store = engine.Store(engine.resolve_store(root)).open()
    except engine.StoreUnavailable as exc:
        if apply:
            return {**row, "decision": "skip", "why": f"{exc.slug}: {exc.message}"}
        row["store"] = f"{exc.slug}: cannot tell what is already carried"
    try:
        out_entries = []
        carried = already = skipped = 0
        if apply and found["explicit"] is not True:
            enabled = _enable_project(root)
            row["enabled"] = enabled
            if not enabled.get("ok"):
                return {**row, "decision": "skip", "why": "enabling memory failed: "
                        + str(enabled.get("error"))}
        for entry in entries:
            item = {k: entry[k] for k in ("source", "title", "dated_from", "chars", "decision")}
            item["created_at"] = engine.iso(entry["created_at"])
            for key in ("why", "decision_note", "memory_id"):
                if key in entry:
                    item[key] = entry[key]
            if entry["decision"] == "carry":
                pin = bool(pin_titles and pin_titles.search(entry["title"]))
                item["pinned"] = pin
                key = engine.adopt_key(project, entry["title"], entry["body"],
                                       entry.get("memory_id"))
                if apply:
                    made, created = store.adopt(project, entry["title"], entry["body"],
                                                created_at=entry["created_at"], key=key,
                                                source=entry["source"], pinned=pin,
                                                actor=_actor(), node=node_name(),
                                                memory_id=entry.get("memory_id"))
                    item["decision"] = "carried" if created else "already"
                    item["entry"] = engine.short(made["id"])
                elif store is not None:
                    hit = store.one("SELECT entry_id FROM memory_events WHERE agent_id = %s "
                                    "AND kind = 'add' AND detail ? 'adopt_key' AND "
                                    "detail->>'adopt_key' = %s", (project, key))
                    if hit:
                        item["decision"] = "already"
                        item["entry"] = engine.short(hit["entry_id"])
                carried += item["decision"] in ("carry", "carried")
                already += item["decision"] == "already"
            else:
                skipped += 1
            out_entries.append(item)
        row.update(decision="adopted" if apply else "would adopt", entries=out_entries,
                   counts={"carry" if not apply else "carried": carried, "already": already,
                           "skipped": skipped, "not_read": len(parsed["not_read"])})
        if apply:
            store.adopted(project, carried, already, str(root), actor=_actor(),
                          node=node_name())
        return row
    finally:
        if store is not None:
            store.close()


def _project_policy_scope():
    """The project's own policy entry for memory: True, False, or None when the
    project says nothing and inherits."""
    row = _policy_row()
    if row and row.get("scope") == "project":
        return bool(row["value"].get("enabled"))
    return None


def _enable_project(root: Path) -> dict:
    env = {k: v for k, v in os.environ.items() if k not in _PROJECT_POINTERS}
    env["CLAUDE_PROJECT_DIR"] = str(root)
    try:
        done = subprocess.run([_manager_bin(), "enable", NAME, "--project"], cwd=root, env=env,
                              capture_output=True, text=True, timeout=120,
                              stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"ok": False, "error": str(exc)}
    if done.returncode != 0:
        return {"ok": False, "error": (done.stderr or done.stdout).strip()[-400:]}
    return {"ok": True, "by": f"`capabilities enable {NAME} --project`"}


def cmd_adopt(args) -> None:
    if args.apply:
        _read_only_gate(f"`{NAME} adopt --apply`")
    pin_titles = None
    if args.pin_titles:
        try:
            pin_titles = re.compile(args.pin_titles)
        except re.error as exc:
            _die(6, "input", f"--pin-titles is no regular expression: {exc}")
    zone = None
    if args.timezone is not None:
        try:
            zone = ZoneInfo(args.timezone)
        except (ZoneInfoNotFoundError, ValueError) as exc:
            _die(6, "input", f"--timezone names no IANA zone: {args.timezone!r} ({exc})")
    roots, lists = _adopt_roots(args.roots)
    projects = []
    with _guarded():
        for root in roots:
            projects.append(_adopt_one(root, args.apply, pin_titles, zone))
    out = {"mode": "apply" if args.apply else "dry-run",
           "roots_from": "the arguments" if args.roots else "the machine's service opt-in lists",
           "projects": projects}
    if lists:
        out["lists"] = lists
    if not roots:
        out["note"] = ("no project root was given and no opt-in list names one; pass the "
                       "project roots to adopt")
    if not args.apply:
        out["next"] = "`memory adopt --apply` with the same roots carries what this shows"
    _emit(out)


def cmd_export(args) -> None:
    project = _reading(args.project)
    with _guarded(), _open_store(_project_root()) as store:
        body = store.export(project)
        label = _engine().store_label(store.setting)
    document = {"capability": NAME, "project": project, "exported_at": _utc_now(),
                "store": label, **body}
    if args.out:
        path = Path(args.out).expanduser()
        try:
            _engine().write_atomic(path, json.dumps(document, indent=2, ensure_ascii=False) + "\n")
        except OSError as exc:
            _die(6, "input", f"cannot write {path}: {exc}")
        _emit({"written": str(path), "entries": len(body["entries"]),
               "events": len(body["events"])})
        return
    _emit(document)


# ── answering inside another project ─────────────────────────────────────────

@contextlib.contextmanager
def _project_scope(root: Path):
    """Stand in one project for the length of a block: the environment points at
    that project alone and its records adapter is opened afresh; both are put
    back on the way out."""
    global _RECORDS
    saved_env, saved_records = dict(os.environ), _RECORDS
    for key in _PROJECT_POINTERS:
        os.environ.pop(key, None)
    os.environ["CLAUDE_PROJECT_DIR"] = str(root)
    _RECORDS = None
    try:
        yield
    finally:
        if _RECORDS is not None and _RECORDS is not saved_records:
            with contextlib.suppress(Exception):
                _RECORDS.close()
        os.environ.clear()
        os.environ.update(saved_env)
        _RECORDS = saved_records


def _ask_in_project(root: Path, question):
    """Answer `question` inside the project's scope; a refusal it would have
    exited with is raised as a Refusal, so one project never ends the process."""
    import io
    engine = _engine()
    said = io.StringIO()
    try:
        with contextlib.redirect_stderr(said), _project_scope(root):
            return question()
    except SystemExit as stop:
        error: dict = {}
        for line in reversed(said.getvalue().strip().splitlines()):
            with contextlib.suppress(ValueError, AttributeError):
                error = json.loads(line).get("error") or {}
                break
        raise engine.Refusal(stop.code if isinstance(stop.code, int) else 6,
                             error.get("code") or "refused",
                             error.get("message") or "the check exited without saying why",
                             error.get("hint")) from None


# ── doctor ───────────────────────────────────────────────────────────────────

def _doctor_store(root: Path | None) -> dict:
    engine = _engine()
    try:
        setting = engine.resolve_store(root)
    except engine.StoreUnavailable as exc:
        return {"ok": False, "category": 6 if exc.slug in _SETTING_SLUGS else 5,
                "code": exc.slug, "error": exc.message,
                "hint": _STORE_HINT if exc.slug == "store_not_configured" else exc.hint}
    db = engine.database()
    conn = None
    try:
        conn = db.connect(application_name=NAME, setting=setting, transaction=True)
        found = db.status(conn, NAME, engine.LEDGER_STEPS, major=engine.LEDGER_MAJOR,
                          minor=engine.LEDGER_MINOR)
    except db.DbError as exc:
        return {"ok": False, "category": 6 if exc.slug in _SETTING_SLUGS else 5,
                "code": exc.slug, "error": exc.message, "setting": setting.report()}
    finally:
        if conn is not None:
            conn.close()
    row = {"ok": found.state in ("current", "pending"), "setting": setting.report(),
           "tables": found.state, "pending": found.pending}
    if found.state == "pending":
        row["note"] = "the next call that needs the tables migrates them; `memory migrate` now"
    if not row["ok"]:
        row.update(category=6, error=f"the tables are {found.state}",
                   hint=f"update {NAME}" if found.state == "schema_too_new" else None)
    return row


# The day the groom advisory lock an earlier release keeps passes out by is
# retired; until then `doctor` warns of a pass of such a release.
GROOM_LOCK_RETIRED = "2027-01-05"


def _doctor_earlier_release(root: Path | None, project: str) -> dict | None:
    """A warning, never a failure: an earlier memory release grooming against
    this store, seen as a holder of the groom advisory lock that no
    `memory_groom_leases` row names by `lock_pid`, with the machine named as
    precisely as the store tells it. None when there is none, or the store
    cannot say."""
    engine = _engine()
    try:
        with engine.Store(engine.resolve_store(root)).open(migrate=False) as store:
            holders = [h for h in store.groom_lock_holders(project, every_project=True)
                       if h["lease_project"] is None]
    except Exception:
        return None
    if not holders:
        return None
    seen = []
    for h in holders:
        machine = h["client_hostname"] or h["client_addr"] or "a local socket"
        started = h["backend_start"].isoformat() if h["backend_start"] else None
        seen.append({"pid": h["pid"], "this_project": h["this_project"],
                     "client_hostname": h["client_hostname"], "client_addr": h["client_addr"],
                     "application_name": h["application_name"], "user": h["usename"],
                     "backend_start": started,
                     "machine": f"{machine}" + (f" ({h['application_name']})"
                                                if h["application_name"] else "")
                                + (f", connected since {started}" if started else "")})
    where = "; ".join(h["machine"] for h in seen)
    return {"ok": True, "holders": seen, "retires": GROOM_LOCK_RETIRED,
            "warning": f"an earlier {NAME} release is grooming against this store from {where}: "
                       f"it keeps a second pass out by a session lock that is retired on "
                       f"{GROOM_LOCK_RETIRED}, and must be updated on that machine before then",
            "hint": f"update {NAME} on that machine (`capabilities update {NAME}`)"}


def _doctor_consolidation(settings: dict | None) -> dict:
    if settings is None:
        return {"ok": True, "on": None, "reason": "the settings do not load"}
    if not settings["consolidate"]:
        return {"ok": True, "on": False, "reason": "consolidate is false in the settings"}
    ready, why = _model_ready(settings)
    return {"ok": True, "on": ready, "profile": settings["groom_profile"],
            **({"reason": why} if why else {})}


def cmd_doctor() -> None:
    """Whether memory works in this project now: its identity, settings, store
    and tables, and consolidation."""
    findings: dict = {}
    fail = 0

    def note(key: str, row: dict) -> None:
        nonlocal fail
        findings[key] = row
        if not row.get("ok") and not fail:
            fail = row.get("category") or 6
        row.pop("category", None)

    root = _root()
    project = _project_id(write=True, refuse=False)
    state = _project_id_state() or {}
    if project:
        note("project", {"ok": True, "id": project, "identity": state.get("state")})
    else:
        note("project", {"ok": False, "category": 6, "identity": state.get("state"),
                         "error": "this project has no durable id a write may stamp",
                         "hint": "run `capabilities init` in the project"
                         if state.get("state") == "undeclared" else
                         (state.get("error") or {}).get("hint")
                         or "`capabilities doctor` names what to reconcile"})
    try:
        settings = _settings()
        note("settings", {"ok": True, "path": _settings_where(root),
                          "values": settings})
    except SystemExit:
        settings = None
        note("settings", {"ok": False, "category": 6, "path": _settings_where(root),
                          "error": "the settings do not load; the refusal on stderr names the "
                                   "key"})
    store_row = _doctor_store(root)
    note("store", store_row)
    if store_row.get("ok") and project:
        earlier = _doctor_earlier_release(root, project)
        if earlier:
            findings["earlier_release"] = earlier
    findings["consolidation"] = _doctor_consolidation(settings)
    _emit({"ok": fail == 0, **findings})
    if fail:
        sys.exit(fail)


# ── the command line ─────────────────────────────────────────────────────────

class _Parser(argparse.ArgumentParser):
    """Usage errors leave through the envelope at exit 6."""

    def __init__(self, *args, **kwargs):
        kwargs.setdefault("allow_abbrev", False)
        kwargs.setdefault("add_help", False)
        super().__init__(*args, **kwargs)

    def error(self, message: str) -> NoReturn:
        _die(6, "invalid_arguments", f"{self.prog}: {message}", f"run `{NAME} help`")


def _limit(value: str) -> int:
    try:
        n = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError(f"{value!r} is not a whole number")
    if not 1 <= n <= 1000:
        raise argparse.ArgumentTypeError(f"{value!r} is not between 1 and 1000")
    return n


def _parser() -> _Parser:
    parser = _Parser(prog=NAME)
    sub = parser.add_subparsers(dest="cmd", required=True, parser_class=_Parser)
    sub.add_parser("help").add_argument("topic", nargs="*")
    sub.add_parser("doctor")

    add = sub.add_parser("add")
    add.add_argument("text")
    add.add_argument("--title", required=True)
    add.add_argument("--pin", action="store_true")
    add.add_argument("--scope")
    sup = sub.add_parser("supersede")
    sup.add_argument("ids", nargs="+")
    sup.add_argument("--with", dest="with_", action="append", required=True)
    sup.add_argument("--title", action="append", required=True)
    sup.add_argument("--reason")
    sup.add_argument("--pin", action="store_true")
    drop = sub.add_parser("drop")
    drop.add_argument("id")
    drop.add_argument("--reason", required=True)
    drop.add_argument("--to")
    drop.add_argument("--purge", action="store_true")
    for verb in ("pin", "unpin"):
        sub.add_parser(verb).add_argument("id")

    listed = sub.add_parser("list")
    listed.add_argument("--status", choices=("active", "superseded", "dropped", "all"),
                        default="active")
    pins = listed.add_mutually_exclusive_group()
    pins.add_argument("--pinned", action="store_true")
    pins.add_argument("--unpinned", action="store_true")
    listed.add_argument("--scope")
    listed.add_argument("--since")
    listed.add_argument("--limit", type=_limit, default=50)
    listed.add_argument("--project")
    listed.add_argument("--json", action="store_true")
    show = sub.add_parser("show")
    show.add_argument("id")
    show.add_argument("--project")
    show.add_argument("--json", action="store_true")
    search = sub.add_parser("search")
    search.add_argument("terms", nargs="+")
    search.add_argument("--all", action="store_true")
    search.add_argument("--limit", type=_limit, default=20)
    search.add_argument("--project")
    search.add_argument("--json", action="store_true")
    log = sub.add_parser("log")
    log.add_argument("--since")
    log.add_argument("--limit", type=_limit, default=50)
    log.add_argument("--project")
    log.add_argument("--json", action="store_true")
    sub.add_parser("status").add_argument("--json", action="store_true")

    groom = sub.add_parser("groom")
    groom.add_argument("--apply", action="store_true")
    groom.add_argument("--if-due", dest="if_due", action="store_true")
    groom.add_argument("--undo")
    groom.add_argument("--trigger")
    adopt = sub.add_parser("adopt")
    adopt.add_argument("roots", nargs="*")
    adopt.add_argument("--apply", action="store_true")
    adopt.add_argument("--pin-titles", dest="pin_titles")
    adopt.add_argument("--timezone")
    export = sub.add_parser("export")
    export.add_argument("--out")
    export.add_argument("--project")

    return parser


def main() -> None:
    _gate()
    argv = sys.argv[1:]
    if argv[:1] == ["manifest"]:
        _emit(_manifest())
        return
    _contract(argv)
    if not argv:
        _cmd_help()
        return
    args = _parser().parse_args(argv)
    cmd = args.cmd
    if cmd == "help":
        _cmd_help()
        return
    if cmd in WRITE_VERBS - {"groom", "adopt"}:
        _read_only_gate(f"`{NAME} {cmd}`")
    handlers = {
        "add": cmd_add, "supersede": cmd_supersede, "drop": cmd_drop,
        "pin": lambda a: cmd_pin(a, True), "unpin": lambda a: cmd_pin(a, False),
        "list": cmd_list, "show": cmd_show, "search": cmd_search, "log": cmd_log,
        "status": cmd_status, "groom": cmd_groom,
        "adopt": cmd_adopt, "export": cmd_export,
    }
    if cmd == "doctor":
        cmd_doctor()
    else:
        handlers[cmd](args)


if __name__ == "__main__":
    main()
