# The shared capability code is the capabilities-contract library's, bound here
# into this script's namespace (SHEBANG.md, "The contract verbs").
from capabilities_contract.capability import bind as _contract_bind

_contract_bind(globals(), "core")

_contract_bind(globals(), "store")


def _cmd_connections() -> None:
    """Memory reaches no system of its own: the store is the project's, resolved
    through the shared library, so there is nothing to resolve here."""
    _emit({"default": None, "connections": {}})


# ── the engine, the project, the store ──────────────────────────────────────

_PROJECT_POINTERS = ("CLAUDE_PROJECT_DIR", "CAPABILITIES_PROJECT_ID",
                     "CAPABILITIES_PROJECT_ID_ROOT", "CAPABILITIES_PROJECT_ENVELOPE",
                     "CAPABILITIES_PROJECT_ENVELOPE_ROOT")
_PROJECT_ENTRY_KEYS = ("root", "slug", "joined_at", "joined_by")
_SETTING_SLUGS = frozenset({
    "store_not_configured", "store_not_postgres", "store_setting_unreadable",
    "store_setting_too_new", "bad_store_setting", "sslmode_too_weak",
    "bad_schema_name", "driver_missing", "transaction_pooler"})
_STORE_HINT = ("set AGENTKIT_DB_URL (or AGENTKIT_DB_HOST, AGENTKIT_DB_NAME, AGENTKIT_DB_USER, "
               "AGENTKIT_DB_PASSWORD) in the project's .env.local or the environment, or run "
               "`capabilities store set`")


def _bundle_dir() -> Path:
    here = Path(__file__).resolve()
    return here.parent.parent if here.parent.name == "bin" else here.parent


_ENGINE = None


def _engine():
    """The bundled engine, loaded once from the installed bundle."""
    global _ENGINE
    if _ENGINE is None:
        path = _bundle_dir() / "service" / "engine.py"
        spec = importlib.util.spec_from_file_location("memory_engine", path)
        module = importlib.util.module_from_spec(spec)
        sys.modules["memory_engine"] = module
        spec.loader.exec_module(module)
        _ENGINE = module
    return _ENGINE


def _tables():
    engine = _engine()
    return engine.LEDGER_STEPS, engine.LEDGER_MAJOR, engine.LEDGER_MINOR


def _refused(exc) -> NoReturn:
    _die(exc.exit_code, exc.code, exc.message, exc.hint)


def _store_refused(exc) -> NoReturn:
    if exc.slug == "store_not_configured":
        _die(6, "store_not_configured",
             f"{NAME} keeps a project's memory in a store, and none is configured here",
             _STORE_HINT)
    _die(6 if exc.slug in _SETTING_SLUGS else 5, exc.slug, exc.message, exc.hint)


def _manifest() -> dict:
    """The contract's manifest, with the service and the context contribution
    this capability declares."""
    return {**_manifest_core(), "service": SERVICE, "contribution": CONTRIBUTION}


def _root() -> Path:
    root = _project_root()
    if root is None:
        _die(6, "no_project", f"{NAME} keeps a project's memory; run it inside a project",
             "cd into the project, or set CLAUDE_PROJECT_DIR")
    return root


def _project(write: bool) -> str:
    """The id of the project this command stands in: verified for a write,
    as recorded for a read."""
    _root()
    project = _project_id(write=write)
    if not project:
        _die(6, "no_project_identity", "this project has no durable id",
             "run `capabilities init` in the project")
    return str(project)


def _reading(named: str | None) -> str:
    if named is not None:
        named = named.strip()
        if not named:
            _die(6, "input", "--project names a project id")
        return named
    return _project(write=False)


def _actor() -> str:
    named = os.environ.get("MEMORY_ACTOR", "").strip()
    if named:
        return named[:200]
    user = os.environ.get("USER") or os.environ.get("LOGNAME")
    if not user:
        with contextlib.suppress(Exception):
            import pwd
            user = pwd.getpwuid(os.getuid()).pw_name
    return f"{user or 'unknown'}@{node_name()}"


def _utc_now() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def _settings() -> dict:
    """The settings in force for this project: its service/settings.json over
    the global one, key by key, checked whole."""
    try:
        rows = _records().resolve(NAME, "setting")
    except StoreError as exc:
        _die(6, exc.slug, exc.message, exc.hint)
    raw = {key: row["value"] for key, row in rows.items() if key != "connection.default"}
    root = _project_root()
    where = (_settings_where(root) if root is not None else "settings") + (
        " over the global rows" if root is not None and _records_in_store()
        else f" over {_CONFIG_HOME / NAME / 'service' / 'settings.json'}")
    try:
        return _engine().read_settings(raw, where)
    except _engine().Refusal as exc:
        _refused(exc)


def _settings_merged(scope: str, document: dict) -> dict | None:
    """The settings the service would load once `document` is written at
    `scope`: the project's over the global one, key by key. None outside a
    project, where there is nothing to merge it into."""
    if _project_root() is None:
        return None
    other = "global" if scope == "project" else "project"
    try:
        held = {key: row["value"] for key, row in
                _records().resolve_scope(NAME, "setting", other).items()
                if key != "connection.default"}
    except StoreError as exc:
        return {"__error__": exc.message}
    return {**held, **document} if scope == "project" else {**document, **held}


def _settings_check(scope: str, document: dict) -> list:
    """What the service finds wrong with this project's settings once the
    contract's `settings` verb writes `document` at `scope`."""
    if scope not in ("project", "global"):
        return []
    merged = _settings_merged(scope, document)
    if merged is None:
        return []
    if "__error__" in merged:
        return [merged["__error__"]]
    home = _settings_homes(scope)[0]
    where = (_records().collection_source(NAME, "setting") if _settings_in_rows(home)
             else _settings_home_path(home))
    try:
        _engine().read_settings(merged, str(where))
    except _engine().Refusal as exc:
        return [getattr(exc, "message", None) or str(exc)]
    return []


def _context_path(root: Path) -> Path:
    """The contribution file: the declared path under this capability's folder
    in the project's envelope, wherever the envelope resolves."""
    return _project_capabilities_dir(root) / NAME / CONTRIBUTION["path"]


def _settings_path(root: Path) -> Path:
    return _project_capabilities_dir(root) / NAME / "service" / "settings.json"


def _settings_where(root: Path) -> str:
    """Where this project's settings are kept, as a person reads it: the file,
    or the store's rows for an agent whose records moved there."""
    home = _settings_homes("project")[0]
    if _settings_in_rows(home):
        return str(_settings_read(home)[0])
    return str(_settings_path(root))


def _open_store(root: Path | None, session: bool = False):
    engine = _engine()
    try:
        return engine.Store(engine.resolve_store(root), session=session).open()
    except engine.StoreUnavailable as exc:
        _store_refused(exc)


@contextlib.contextmanager
def _guarded():
    """Turn a refusal, an unusable store, or a lost connection into the error
    envelope."""
    engine = _engine()
    try:
        yield
    except engine.Refusal as exc:
        _refused(exc)
    except engine.StoreUnavailable as exc:
        _store_refused(exc)
    except Exception as exc:
        import psycopg
        if isinstance(exc, (psycopg.OperationalError, psycopg.InterfaceError)):
            _die(5, "store_unreachable", f"the store stopped answering: {exc}",
                 "`memory doctor` proves the store")
        if isinstance(exc, psycopg.errors.CheckViolation):
            _die(6, "refused_by_store", str(exc).splitlines()[0])
        raise


def _settings_ahead() -> dict | None:
    """The settings a write renders the block with, read before the store is
    opened, so the render asks nothing on a second connection; None when they
    do not load, which the render then says."""
    try:
        return _settings()
    except SystemExit:
        return None


def _render_here(store, project: str, root: Path, by: str,
                 settings: dict | None = None) -> dict:
    """Render this project's block after a write; a failure is said and leaves
    the write standing."""
    try:
        return {"rendered": True, **_engine().render_project(
            store, project, settings if settings is not None else _settings(),
            _context_path(root), rendered_by=by)}
    except SystemExit:
        return {"rendered": False, "error": "the settings do not load; `memory doctor` says why"}
    except Exception as exc:
        return {"rendered": False, "error": f"{type(exc).__name__}: {exc}",
                "hint": "`memory render` renders it again"}


def _text_arg(value: str) -> str:
    if value == "-":
        return sys.stdin.read()
    return value


_AGE = re.compile(r"(\d+)\s*([mhdw])")


def _when(value: str | None):
    import datetime as dt
    if value is None:
        return None
    text = value.strip()
    age = _AGE.fullmatch(text)
    if age:
        unit = {"m": "minutes", "h": "hours", "d": "days", "w": "weeks"}[age.group(2)]
        return dt.datetime.now(dt.timezone.utc) - dt.timedelta(**{unit: int(age.group(1))})
    try:
        moment = dt.datetime.fromisoformat(text.replace("Z", "+00:00"))
    except ValueError:
        _die(6, "input", f"--since {value!r} is no date, moment or age",
             "a date (2026-10-01), a moment (2026-10-01T12:00:00Z) or an age (30m, 12h, 7d, 2w)")
    if moment.tzinfo is None:
        moment = moment.replace(tzinfo=dt.timezone.utc)
    return moment


# ── the lines a read prints ──────────────────────────────────────────────────

def _index_line(entry: dict) -> str:
    engine = _engine()
    line = f"[{entry['short']}] {entry['created_at'][:10]} · {entry['title']}"
    marks = []
    if entry.get("pinned"):
        marks.append("pinned")
    if entry.get("scope"):
        marks.append(f"scope {entry['scope']}")
    if entry.get("merged"):
        merged = entry["merged"]
        span = merged.get("from") or ""
        if merged.get("to") and merged.get("to") != span:
            span += f"..{merged['to']}"
        marks.append(f"merged {merged['count']}, {span}")
    if entry.get("status") == "superseded":
        marks.append(f"superseded by {engine.short(entry['superseded_by'])}")
    elif entry.get("status") == "dropped":
        marks.append("dropped" + (f" to {entry['destination']}" if entry.get("destination")
                                  else ""))
    return line + (f" ({'; '.join(marks)})" if marks else "")


def _event_line(event: dict) -> str:
    engine = _engine()
    line = f"{event['at']} {event['kind']}"
    if event.get("entry_id"):
        line += f" [{engine.short(event['entry_id'])}]"
        if event.get("title"):
            line += f" {event['title']}"
    line += f" - {event['actor']} on {event['node']}"
    if event.get("reason"):
        line += f": {event['reason']}"
    if event.get("pass_id"):
        line += f" (pass {event['pass_id']})"
    return line


def _lines(lines: list[str]) -> None:
    sys.stdout.write("".join(line + "\n" for line in lines))


# ── writing ──────────────────────────────────────────────────────────────────

def cmd_add(args) -> None:
    engine = _engine()
    project = _project(write=True)
    root = _root()
    with _guarded():
        title = engine.check_title(args.title)
        body = engine.check_body(_text_arg(args.text))
        scope = (args.scope or "").strip() or None
        settings = _settings_ahead()
        with _open_store(root) as store:
            row, created = store.add(project, title, body, scope=scope, pinned=args.pin,
                                     actor=_actor(), node=node_name())
            out = {"created": created, "entry": engine.entry_out(row, with_body=False)}
            if created:
                out["context"] = _render_here(store, project, root, "`memory add`", settings)
    _emit(out)


def cmd_supersede(args) -> None:
    engine = _engine()
    if len(args.with_) != len(args.title):
        _die(6, "input", f"{len(args.with_)} --with and {len(args.title)} --title: each new "
             "entry is one --with and one --title, in order")
    project = _project(write=True)
    root = _root()
    with _guarded():
        news = [(engine.check_title(title), engine.check_body(_text_arg(text)))
                for text, title in zip(args.with_, args.title)]
        settings = _settings_ahead()
        with _open_store(root) as store:
            out = store.supersede(project, args.ids, news, reason=args.reason, pin=args.pin,
                                  actor=_actor(), node=node_name())
            out["context"] = _render_here(store, project, root, "`memory supersede`", settings)
    _emit(out)


def cmd_drop(args) -> None:
    project = _project(write=True)
    root = _root()
    reason = (args.reason or "").strip()
    if not reason:
        _die(6, "input", "a drop says why the entry no longer holds", "pass --reason TEXT")
    with _guarded():
        settings = _settings_ahead()
        with _open_store(root) as store:
            out = store.drop(project, args.id, reason=reason, to=(args.to or None),
                             purge=args.purge, actor=_actor(), node=node_name())
            out["context"] = _render_here(store, project, root, "`memory drop`", settings)
    _emit(out)


def cmd_pin(args, pinned: bool) -> None:
    project = _project(write=True)
    root = _root()
    with _guarded():
        settings = _settings_ahead()
        with _open_store(root) as store:
            out = store.set_pin(project, args.id, pinned, actor=_actor(), node=node_name())
            if out["changed"]:
                out["context"] = _render_here(store, project, root,
                                              f"`memory {'pin' if pinned else 'unpin'}`",
                                              settings)
    _emit(out)


# ── reading ──────────────────────────────────────────────────────────────────

def cmd_list(args) -> None:
    engine = _engine()
    project = _reading(args.project)
    pinned = True if args.pinned else (False if args.unpinned else None)
    with _guarded(), _open_store(_project_root()) as store:
        rows, total = store.listing(project, status=args.status, pinned=pinned,
                                    scope=args.scope, since=_when(args.since), limit=args.limit)
    entries = [engine.entry_out(r, with_body=False) for r in rows]
    if args.json:
        _emit({"project": project, "status": args.status, "total": total,
               "shown": len(entries), "entries": entries})
        return
    lines = [_index_line(e) for e in entries]
    if total > len(entries):
        lines.append(f"(showing {len(entries)} of {total}; --limit raises it)")
    if not entries:
        lines.append(f"(no {'' if args.status == 'all' else args.status + ' '}entries)")
    _lines(lines)


def cmd_show(args) -> None:
    engine = _engine()
    project = _reading(args.project)
    with _guarded(), _open_store(_project_root()) as store:
        row = store.resolve(project, args.id)
        row = store._with_merged([row])[0]
        trail = [engine.event_out(e) for e in store.trail(row["id"])]
    entry = engine.entry_out(row)
    if args.json:
        _emit({"entry": entry, "trail": trail})
        return
    head = [f"[{entry['short']}] {entry['title']}",
            f"id {entry['id']} · {entry['status']}" + (" · pinned" if entry["pinned"] else "")
            + f" · {entry['created_at']} by {entry['created_by']} on {entry['node']}"
            + f" · {entry['origin']}" + (f" · scope {entry['scope']}" if entry["scope"] else "")]
    if entry.get("superseded_by"):
        head.append(f"superseded by {entry['superseded_by']}")
    if entry.get("destination"):
        head.append(f"went to {entry['destination']}")
    if entry.get("merged"):
        merged = entry["merged"]
        head.append(f"merged {merged['count']}, {merged.get('from')}..{merged.get('to')}")
    _lines(head + ["", entry["body"], "", "Trail:"]
           + ["- " + _event_line(e) for e in trail])


def cmd_search(args) -> None:
    engine = _engine()
    project = _reading(args.project)
    query = " ".join(args.terms).strip()
    if not query:
        _die(6, "input", "search takes the terms to look for", 'memory search "<terms>"')
    with _guarded(), _open_store(_project_root()) as store:
        rows, total = store.search(project, query, everything=args.all, limit=args.limit)
    entries = [engine.entry_out(r, with_body=False) for r in rows]
    if args.json:
        _emit({"project": project, "query": query, "total": total, "shown": len(entries),
               "entries": entries})
        return
    lines = [_index_line(e) for e in entries]
    if total > len(entries):
        lines.append(f"(showing {len(entries)} of {total} matches; --limit raises it)")
    if not entries:
        lines.append(f"(nothing matches {query!r}"
                     + (")" if args.all else "; --all looks in superseded and dropped too)"))
    _lines(lines)


def cmd_log(args) -> None:
    engine = _engine()
    project = _reading(args.project)
    with _guarded(), _open_store(_project_root()) as store:
        rows, total = store.log(project, since=_when(args.since), limit=args.limit)
    events = [engine.event_out(r) for r in rows]
    if args.json:
        _emit({"project": project, "total": total, "shown": len(events), "events": events})
        return
    lines = [_event_line(e) for e in events]
    if total > len(events):
        lines.append(f"(showing {len(events)} of {total} events; --limit raises it)")
    if not events:
        lines.append("(no events)")
    _lines(lines)


def _context_report(root: Path, last_event: int | None) -> dict:
    """What the rendered block on this machine holds, against the store."""
    path = _context_path(root)
    out: dict = {"path": str(path), "exists": path.is_file()}
    try:
        sidecar = json.loads(path.with_suffix(".json").read_text())
    except (OSError, ValueError):
        sidecar = {}
    if out["exists"]:
        out["bytes"] = path.stat().st_size
    for key in ("rendered_at", "rendered_by", "last_event", "active", "newest", "window",
                "fits", "chars"):
        if key in sidecar:
            out[key] = sidecar[key]
    out["current"] = bool(out["exists"] and sidecar.get("last_event") == last_event)
    return out


def cmd_status(args) -> None:
    project = _project(write=False)
    root = _root()
    with _guarded(), _open_store(root) as store:
        counts = store.counts(project)
        label = _engine().store_label(store.setting)
    _emit({"project": project, "store": label, **counts,
           "context": _context_report(root, counts["last_event"]),
           "service": _service_here()})


# ── the block ────────────────────────────────────────────────────────────────

def cmd_render(args) -> None:
    engine = _engine()
    project = _project(write=False)
    root = _root()
    settings = _settings()
    with _guarded(), _open_store(root) as store:
        if args.fragment:
            now = engine.now_utc()
            text, _report = engine.render_block(
                store.render_rows(project), settings, now=now,
                provenance=(f"_Rendered {now.strftime('%Y-%m-%d %H:%M')} UTC by "
                            f"`memory render --fragment` from the "
                            f"{engine.store_label(store.setting)}._"),
                max_bytes=CONTRIBUTION["max_bytes"])
            sys.stdout.write(text)
            return
        try:
            out = engine.render_project(store, project, settings, _context_path(root),
                                        rendered_by="`memory render`",
                                        max_bytes=CONTRIBUTION["max_bytes"])
        except OSError as exc:
            _die(6, "context_unwritable", f"cannot write {_context_path(root)}: {exc}",
                 "the project's envelope must be writable by this user")
    _emit(out)


# ── grooming ─────────────────────────────────────────────────────────────────

_MODEL_READY: dict = {}
_MODEL_READY_SECONDS = 3600.0


def _harness():
    from callva import harness_runner
    return harness_runner


def _groom_profile(settings: dict):
    """The profile a pass runs on: the named one, with no tools, the plan's
    schema, and the project's budget, turns and deadline."""
    hr = _harness()
    try:
        profile = hr.find_profile(settings["groom_profile"])
    except hr.ProfileError as exc:
        _die(6, "groom_profile", f"profile {settings['groom_profile']!r}: {exc}",
             "name a profile the harness runner resolves in groom_profile")
    changes: dict = {"output_schema": _engine().GROOM_SCHEMA,
                     "timeout_seconds": settings["groom_timeout_seconds"]}
    if profile.harness == "claude":
        extra = dict(getattr(profile, "claude_extra_args", None) or {})
        extra["max-turns"] = str(settings["groom_max_turns"])
        changes.update(tools=[], budget_usd=float(settings["groom_budget_usd"]),
                       claude_extra_args=extra)
    try:
        return dataclasses.replace(profile, **changes)
    except hr.ProfileError as exc:
        _die(6, "groom_profile", f"profile {settings['groom_profile']!r} cannot run a pass: "
             f"{exc}", "name a claude or codex profile in groom_profile")


def _model_ready(settings: dict) -> tuple[bool, str | None]:
    """Whether a pass can run here: the profile resolves, its harness is
    installed, and it is logged in headless. Asked of the harness's own CLI,
    remembered for an hour; no model turn is spent on it."""
    name = settings["groom_profile"]
    held = _MODEL_READY.get(name)
    if held and time.monotonic() - held[0] < _MODEL_READY_SECONDS:
        return held[1], held[2]
    answer = _ask_model_ready(name)
    _MODEL_READY[name] = (time.monotonic(), *answer)
    return answer


def _ask_model_ready(name: str) -> tuple[bool, str | None]:
    try:
        hr = _harness()
        harness = hr.find_profile(name).harness
    except Exception as exc:
        return False, f"profile {name!r} does not resolve: {exc}"
    path = hr.find_binary(harness)
    if not path:
        return False, f"no {harness} executable on this machine"
    argv = [path, "auth", "status", "--json"] if harness == "claude" else \
        [path, "login", "status"]
    try:
        done = subprocess.run(argv, capture_output=True, text=True, timeout=20,
                              stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return False, f"cannot ask {harness} whether it is logged in: {exc}"
    if harness == "claude":
        try:
            logged = bool(json.loads(done.stdout).get("loggedIn"))
        except (ValueError, AttributeError):
            logged = False
    else:
        logged = done.returncode == 0
    if not logged:
        return False, (f"{harness} is not logged in on this machine; log it in headless "
                       f"(`{harness} {'auth login' if harness == 'claude' else 'login'}`) "
                       "for grooming passes to run")
    return True, None


def _run_model(root: Path, settings: dict, prompt: str):
    """One agent turn answering the plan, in the project's root, under the
    read-only switch so nothing it starts writes through a capability."""
    hr = _harness()
    profile = _groom_profile(settings)
    result = hr.run(prompt, profile, cwd=str(root),
                    extra_env={"CAPABILITIES_READ_ONLY": "1"})
    if not result.ok:
        kind = str(getattr(result.failure.kind, "value", result.failure.kind))
        if kind == "not_authenticated":
            _die(2, "model_not_authenticated",
                 f"the {profile.harness} harness is not logged in: {result.failure.message}",
                 f"log {profile.harness} in headless on this machine, then run it again")
        _die(5, "groom_turn_failed", f"the grooming turn ended {kind}: "
             f"{result.failure.message}", "nothing was changed; run it again later")
    return result, profile


def cmd_groom(args) -> None:
    engine = _engine()
    if args.undo and args.apply:
        _die(6, "input", "--undo applies itself; leave --apply out")
    if args.apply or args.undo:
        _read_only_gate(f"`{NAME} groom {'--undo' if args.undo else '--apply'}`")
    project = _project(write=bool(args.apply or args.undo))
    root = _root()
    settings = _settings()
    # A session connection: the pass's lock is held across its transactions.
    with _guarded(), _open_store(root, session=True) as store:
        if args.undo:
            out = store.undo_pass(project, args.undo, actor=_actor(), node=node_name())
            out["context"] = _render_here(store, project, root, "`memory groom --undo`")
            _emit(out)
            return
        if args.apply and not store.try_groom_lock(project):
            _die(7, "groom_running", "another grooming pass holds this project's memory",
                 "it ends on its own; run it again afterwards")
        try:
            movable, pinned = store.candidates(project, settings["window_days"])
            base = {"project": project, "mode": "apply" if args.apply else "dry-run",
                    "candidates": len(movable), "pinned": len(pinned)}
            if len(movable) < 2:
                _emit({**base, "nothing_to_do": "fewer than two unpinned entries in the "
                       "window; a pass merges two or more"})
                return
            result, profile = _run_model(root, settings,
                                         engine.groom_prompt(movable, pinned))
            accepted, refused = engine.check_plan(result.structured, movable, pinned)
            model = {"harness": profile.harness, "model": result.model,
                     "cost_usd": result.cost_usd, "duration_ms": result.duration_ms}
            out = {**base, "model": model, "plan": engine.describe_plan(accepted, movable),
                   "refused": refused}
            if args.apply:
                summary = {"trigger": args.trigger or "by hand", "model": model,
                           "profile": settings["groom_profile"], "refused": refused,
                           "candidates": len(movable)}
                out["applied"] = store.apply_pass(project, accepted, actor=_actor(),
                                                  node=node_name(), summary=summary)
                out["context"] = _render_here(store, project, root, "`memory groom --apply`")
            else:
                out["next"] = "`memory groom --apply` runs a pass and applies what it checks"
        finally:
            if args.apply:
                store.groom_unlock(project)
    _emit(out)


# ── adopt and export ─────────────────────────────────────────────────────────

def _manager_bin() -> str:
    return os.environ.get("CAPABILITIES_MANAGER_BIN", "").strip() or "capabilities"


def _memory_folder(root: Path) -> tuple[Path, str]:
    """A project's memory folder: `memory` in the body root its context owner
    names, else <root>/memory."""
    if (root / ".contextkit" / "config.toml").is_file():
        env = {k: v for k, v in os.environ.items() if k not in _PROJECT_POINTERS}
        try:
            done = subprocess.run(["contextkit", "path", "--json"], cwd=root, env=env,
                                  capture_output=True, text=True, timeout=10,
                                  stdin=subprocess.DEVNULL)
            body = json.loads(done.stdout).get("body_root") if done.returncode == 0 else None
            if isinstance(body, str) and body.strip():
                folder = root / body.strip() / "memory"
                folder.resolve().relative_to(root.resolve())
                return folder, "the body root named by `contextkit path --json`"
        except (OSError, subprocess.TimeoutExpired, ValueError, AttributeError):
            pass
        return root / "memory", "<root>/memory; `contextkit path --json` named no body root"
    return root / "memory", "<root>/memory"


def _adopt_roots(given: list[str]) -> tuple[list[Path], list[dict]]:
    if given:
        return [Path(r).expanduser().resolve() for r in given], []
    roots: list[Path] = []
    lists: dict = {}
    for source, root in _engine().iter_listed_roots(_CONFIG_HOME):
        lists.setdefault(source, {"list": source, "roots": 0})
        if not root:
            lists[source]["error"] = "it does not read"
            continue
        lists[source]["roots"] += 1
        path = Path(root)
        if path not in roots:
            roots.append(path)
    return roots, list(lists.values())


def _adopt_one(root: Path, apply: bool, pin_titles, zone=None) -> dict:
    engine = _engine()
    row: dict = {"root": str(root)}
    if not root.is_dir():
        return {**row, "decision": "skip", "why": "no such folder"}

    def question():
        project = _project_id(write=True, refuse=False)
        return {"project": project, "policy": _policy_state(),
                "explicit": _project_policy_scope()}

    try:
        found = _ask_in_project(root, question)
    except engine.Refusal as exc:
        return {**row, "decision": "skip", "why": f"{exc.code}: {exc.message}"}
    project = found["project"]
    row["project_id"] = project
    if found["explicit"] is False:
        return {**row, "decision": "skip", "why": f"{NAME} is disabled in this project"}
    if not project:
        return {**row, "decision": "skip", "why": "the project has no durable id it may be "
                "written under; run `capabilities init` there"}
    folder, named = _memory_folder(root)
    row["memory_folder"] = str(folder)
    row["folder_from"] = named
    parsed = engine.parse_memory_folder(folder, zone)
    row["not_read"] = parsed["not_read"]
    entries = parsed["entries"]
    if not folder.is_dir():
        return {**row, "decision": "skip", "why": "no memory folder", "entries": []}
    store = None
    try:
        store = engine.Store(engine.resolve_store(root)).open()
    except engine.StoreUnavailable as exc:
        if apply:
            return {**row, "decision": "skip", "why": f"{exc.slug}: {exc.message}"}
        row["store"] = f"{exc.slug}: cannot tell what is already carried"
    try:
        out_entries = []
        carried = already = skipped = 0
        if apply and found["explicit"] is not True:
            enabled = _enable_project(root)
            row["enabled"] = enabled
            if not enabled.get("ok"):
                return {**row, "decision": "skip", "why": "enabling memory failed: "
                        + str(enabled.get("error"))}
        for entry in entries:
            item = {k: entry[k] for k in ("source", "title", "dated_from", "chars", "decision")}
            item["created_at"] = engine.iso(entry["created_at"])
            for key in ("why", "decision_note", "memory_id"):
                if key in entry:
                    item[key] = entry[key]
            if entry["decision"] == "carry":
                pin = bool(pin_titles and pin_titles.search(entry["title"]))
                item["pinned"] = pin
                key = engine.adopt_key(project, entry["title"], entry["body"],
                                       entry.get("memory_id"))
                if apply:
                    made, created = store.adopt(project, entry["title"], entry["body"],
                                                created_at=entry["created_at"], key=key,
                                                source=entry["source"], pinned=pin,
                                                actor=_actor(), node=node_name(),
                                                memory_id=entry.get("memory_id"))
                    item["decision"] = "carried" if created else "already"
                    item["entry"] = engine.short(made["id"])
                elif store is not None:
                    hit = store.one("SELECT entry_id FROM memory_events WHERE project_id = %s "
                                    "AND kind = 'add' AND detail ? 'adopt_key' AND "
                                    "detail->>'adopt_key' = %s", (project, key))
                    if hit:
                        item["decision"] = "already"
                        item["entry"] = engine.short(hit["entry_id"])
                carried += item["decision"] in ("carry", "carried")
                already += item["decision"] == "already"
            else:
                skipped += 1
            out_entries.append(item)
        row.update(decision="adopted" if apply else "would adopt", entries=out_entries,
                   counts={"carry" if not apply else "carried": carried, "already": already,
                           "skipped": skipped, "not_read": len(parsed["not_read"])})
        if apply:
            store.adopted(project, carried, already, str(root), actor=_actor(),
                          node=node_name())
            try:
                row["joined"] = _ask_in_project(root, _join_here)
            except engine.Refusal as exc:
                row["joined"] = {"joined": False, "why": f"{exc.code}: {exc.message}"}
            try:
                row["context"] = _ask_in_project(
                    root, lambda: _render_here(store, project, root, "`memory adopt`"))
            except engine.Refusal as exc:
                row["context"] = {"rendered": False, "error": exc.message}
        return row
    finally:
        if store is not None:
            store.close()


def _project_policy_scope():
    """The project's own policy entry for memory: True, False, or None when the
    project says nothing and inherits."""
    row = _policy_row()
    if row and row.get("scope") == "project":
        return bool(row["value"].get("enabled"))
    return None


def _enable_project(root: Path) -> dict:
    env = {k: v for k, v in os.environ.items() if k not in _PROJECT_POINTERS}
    env["CLAUDE_PROJECT_DIR"] = str(root)
    try:
        done = subprocess.run([_manager_bin(), "enable", NAME, "--project"], cwd=root, env=env,
                              capture_output=True, text=True, timeout=120,
                              stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"ok": False, "error": str(exc)}
    if done.returncode != 0:
        return {"ok": False, "error": (done.stderr or done.stdout).strip()[-400:]}
    return {"ok": True, "by": f"`capabilities enable {NAME} --project`"}


def cmd_adopt(args) -> None:
    if args.apply:
        _read_only_gate(f"`{NAME} adopt --apply`")
    pin_titles = None
    if args.pin_titles:
        try:
            pin_titles = re.compile(args.pin_titles)
        except re.error as exc:
            _die(6, "input", f"--pin-titles is no regular expression: {exc}")
    zone = None
    if args.timezone is not None:
        try:
            zone = ZoneInfo(args.timezone)
        except (ZoneInfoNotFoundError, ValueError) as exc:
            _die(6, "input", f"--timezone names no IANA zone: {args.timezone!r} ({exc})")
    roots, lists = _adopt_roots(args.roots)
    projects = []
    with _guarded():
        for root in roots:
            projects.append(_adopt_one(root, args.apply, pin_titles, zone))
    out = {"mode": "apply" if args.apply else "dry-run",
           "roots_from": "the arguments" if args.roots else "the machine's service opt-in lists",
           "projects": projects}
    if lists:
        out["lists"] = lists
    if not roots:
        out["note"] = ("no project root was given and no opt-in list names one; pass the "
                       "project roots to adopt")
    if not args.apply:
        out["next"] = "`memory adopt --apply` with the same roots carries what this shows"
    _emit(out)


def cmd_export(args) -> None:
    project = _reading(args.project)
    with _guarded(), _open_store(_project_root()) as store:
        body = store.export(project)
        label = _engine().store_label(store.setting)
    document = {"capability": NAME, "project": project, "exported_at": _utc_now(),
                "store": label, **body}
    if args.out:
        path = Path(args.out).expanduser()
        try:
            _engine().write_atomic(path, json.dumps(document, indent=2, ensure_ascii=False) + "\n")
        except OSError as exc:
            _die(6, "input", f"cannot write {path}: {exc}")
        _emit({"written": str(path), "entries": len(body["entries"]),
               "events": len(body["events"])})
        return
    _emit(document)


# ── the service: files, settings, the opt-in list ────────────────────────────

MACHINE_KEYS = ("version", "max_grooms")
DEFAULT_MAX_GROOMS = 1


def _machine_service_dir() -> Path:
    return _CONFIG_HOME / NAME / "service"


def _machine_projects_path() -> Path:
    return _machine_service_dir() / "projects.json"


def _machine_config_path() -> Path:
    return _machine_service_dir() / "config.json"


def _machine_state_dir() -> Path:
    return _STATE_HOME / "capabilities" / "machine" / NAME


def _project_state_dir(slug: str) -> Path:
    return _STATE_HOME / "capabilities" / "projects" / slug / NAME


def _read_bytes(path: Path) -> bytes:
    try:
        return path.read_bytes()
    except OSError:
        return b"absent"


def _load_machine_settings() -> dict:
    engine = _engine()
    path = _machine_config_path()

    def refuse(sentence: str) -> NoReturn:
        raise engine.Refusal(6, "machine_settings_invalid", f"{path}: {sentence}",
                             f"`{NAME} service init --machine --force` writes the template")

    settings = {"version": 1, "max_grooms": DEFAULT_MAX_GROOMS}
    if not path.is_file():
        return settings
    try:
        raw = json.loads(path.read_text())
    except (OSError, ValueError) as exc:
        refuse(f"it does not read as JSON: {exc}")
    if not isinstance(raw, dict):
        refuse("it is one JSON object")
    unknown = sorted(set(raw) - set(MACHINE_KEYS))
    if unknown:
        refuse(f"it names {', '.join(map(repr, unknown))}, which nothing reads")
    if raw.get("version") != 1 or isinstance(raw.get("version"), bool):
        refuse("its `version` is 1")
    if "max_grooms" in raw:
        value = raw["max_grooms"]
        if isinstance(value, bool) or not isinstance(value, int) or not 1 <= value <= 16:
            refuse("its `max_grooms` is a whole number from 1 to 16")
        settings["max_grooms"] = value
    return settings


def _machine_fingerprint() -> str:
    return _engine().fingerprint_of(b"machine", _read_bytes(_machine_config_path()))


def _read_projects() -> dict:
    """The opt-in list, every project on it by its id. No file is an empty list."""
    engine = _engine()
    path = _machine_projects_path()

    def refuse(sentence: str) -> NoReturn:
        raise engine.Refusal(6, "projects_invalid", f"{path}: {sentence}",
                             f"`{NAME} service join` and `{NAME} service leave` write it; "
                             "repair it, or remove it and join the projects again")

    if not path.exists():
        return {}
    try:
        raw = json.loads(path.read_text())
    except (OSError, ValueError) as exc:
        refuse(f"it does not read as JSON: {exc}")
    if not isinstance(raw, dict) or raw.get("version") != 1:
        refuse('it is {"version": 1, "projects": {...}}')
    projects = raw.get("projects") or {}
    if not isinstance(projects, dict):
        refuse("its `projects` maps project ids to entries")
    listed = {}
    for project, entry in projects.items():
        if not isinstance(entry, dict) or not isinstance(entry.get("root"), str) \
                or not Path(entry["root"]).is_absolute() or not entry.get("slug"):
            refuse(f"its entry {project!r} is {{root, slug, joined_at, joined_by}}")
        listed[str(project)] = {k: entry.get(k) for k in _PROJECT_ENTRY_KEYS}
    return listed


def _write_projects(listed: dict) -> None:
    path = _machine_projects_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    spare = path.with_name(f".{path.name}.{os.getpid()}")
    spare.write_text(json.dumps({"version": 1, "projects": dict(sorted(listed.items()))},
                                indent=2) + "\n")
    os.replace(spare, path)


@contextlib.contextmanager
def _list_lock():
    import fcntl
    state = _machine_state_dir()
    state.mkdir(parents=True, exist_ok=True)
    with (state / "projects.lock").open("a+") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        yield


def _listed() -> dict:
    try:
        return _read_projects()
    except _engine().Refusal as exc:
        _refused(exc)


@contextlib.contextmanager
def _project_scope(root: Path):
    """Stand in one project for the length of a block: the environment points at
    that project alone and its records adapter is opened afresh; both are put
    back on the way out."""
    global _RECORDS
    saved_env, saved_records = dict(os.environ), _RECORDS
    for key in _PROJECT_POINTERS:
        os.environ.pop(key, None)
    os.environ["CLAUDE_PROJECT_DIR"] = str(root)
    _RECORDS = None
    try:
        yield
    finally:
        if _RECORDS is not None and _RECORDS is not saved_records:
            with contextlib.suppress(Exception):
                _RECORDS.close()
        os.environ.clear()
        os.environ.update(saved_env)
        _RECORDS = saved_records


def _ask_in_project(root: Path, question):
    """Answer `question` inside the project's scope; a refusal it would have
    exited with is raised as a Refusal, so one project never ends the process."""
    import io
    engine = _engine()
    said = io.StringIO()
    try:
        with contextlib.redirect_stderr(said), _project_scope(root):
            return question()
    except SystemExit as stop:
        error: dict = {}
        for line in reversed(said.getvalue().strip().splitlines()):
            with contextlib.suppress(ValueError, AttributeError):
                error = json.loads(line).get("error") or {}
                break
        raise engine.Refusal(stop.code if isinstance(stop.code, int) else 6,
                             error.get("code") or "refused",
                             error.get("message") or "the check exited without saying why",
                             error.get("hint")) from None


def _identity_here() -> tuple[str, str]:
    """This project's id and slug, or the refusal that says why it has none."""
    root = _root()
    project = _project_id(write=True, refuse=False)
    if not project:
        raise _engine().Refusal(6, "no_project_identity",
                                f"{root} is bound to no durable id (CAPABILITIES_PROJECT_ID)",
                                "run `capabilities init` in the project")
    try:
        slug = _project_slug(root)
    except StoreError as exc:
        raise _engine().Refusal(5 if exc.slug in STORE_ENVIRONMENT_SLUGS else 6,
                                exc.slug, exc.message, exc.hint) from None
    return str(project), str(slug or project)


def _joined_here() -> dict | None:
    root = _project_root()
    if root is None:
        return None
    try:
        project, _slug = _identity_here()
        entry = _read_projects().get(project)
    except _engine().Refusal:
        return None
    return {**entry, "id": project} if entry else None


def _project_entry_here() -> dict:
    root = _root()
    try:
        project, slug = _identity_here()
    except _engine().Refusal as exc:
        _refused(exc)
    return {"id": project, "root": str(root), "slug": slug}


def _pid_alive(pid: int | None) -> bool:
    if not pid or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def _read_pid(state: Path) -> int | None:
    try:
        return int((state / "daemon.pid").read_text().strip())
    except (OSError, ValueError):
        return None


def _read_status(state: Path) -> dict:
    try:
        found = json.loads((state / "daemon.json").read_text())
    except (OSError, ValueError):
        return {}
    return found if isinstance(found, dict) else {}


class _Host:
    """What the engine asks of this executable, every project question answered
    inside that project's own resolution, one at a time."""

    def __init__(self, mode: str, entry: dict | None = None):
        import threading
        self.mode = mode
        self.entry = entry
        self.lock = threading.RLock()

    def node(self) -> str:
        return node_name()

    def tag(self) -> str:
        return (self.entry or {}).get("slug") or "machine"

    def entries(self) -> dict:
        if self.mode == "project":
            return {self.entry["id"]: self.entry}
        with self.lock:
            listed = _read_projects()
        return {pid: {**entry, "id": pid} for pid, entry in listed.items()}

    def list_witness(self):
        if self.mode == "project":
            return "project"
        try:
            seen = os.stat(_machine_projects_path())
        except OSError:
            return None
        return (seen.st_mtime_ns, seen.st_size, seen.st_ino)

    def machine_settings(self) -> dict:
        return _load_machine_settings()

    def fingerprint(self) -> str:
        return _machine_fingerprint()

    def _refusal(self, project_id: str, entry: dict):
        """Why this process may not act for the project now, or None."""
        if _machine_state() == "quarantined":
            return ("refused", f"{NAME} is quarantined on this machine")
        if not _project_enabled_explicitly():
            return ("refused", f"{NAME} is not enabled explicitly for this project; "
                    f"`capabilities enable {NAME} --project` there")
        project, slug = _identity_here()
        if project != project_id:
            return ("refused", f"the project's id is now {project}, not the {project_id} "
                    "it joined with; leave and join again")
        if self.mode == "machine" and project_id not in _read_projects():
            return ("refused", "the project left the machine service")
        return None

    def admit(self, project_id: str, entry: dict):
        engine = _engine()
        root = Path(entry["root"])
        if not root.is_dir():
            return None, ("error", f"the project folder {root} is gone")

        def question():
            refusal = self._refusal(project_id, entry)
            if refusal:
                return None, refusal
            settings = _settings()
            plan = {"settings": settings, "fingerprint": engine.settings_fingerprint(settings),
                    "context": str(_context_path(root)), "setting": engine.resolve_store(root),
                    "lock": (str(_project_state_dir(entry["slug"]) / engine.LOCK_FILE)
                             if self.mode == "machine" else None)}
            return plan, None

        with self.lock:
            try:
                return _ask_in_project(root, question)
            except engine.Refusal as exc:
                return None, ("refused" if exc.exit_code == 4 else "error",
                              f"{exc.code}: {exc.message}")
            except engine.StoreUnavailable as exc:
                return None, ("refused", f"{exc.slug}: {exc.message}")
            except Exception as exc:
                return None, ("error", f"{type(exc).__name__}: {exc}")

    def check(self, entry: dict):
        engine = _engine()
        root = Path(entry["root"])
        if not root.is_dir():
            return ("error", f"the project folder {root} is gone")
        with self.lock:
            try:
                return _ask_in_project(root, lambda: self._refusal(entry["id"], entry))
            except engine.Refusal as exc:
                return ("refused", f"{exc.code}: {exc.message}")
            except Exception as exc:
                return ("error", f"{type(exc).__name__}: {exc}")

    def log_project(self, slug: str, line: str) -> None:
        state = _project_state_dir(slug)
        with contextlib.suppress(OSError):
            state.mkdir(parents=True, exist_ok=True)
            with (state / "daemon.log").open("a", encoding="utf-8") as handle:
                handle.write(line)

    def model_ready(self, settings: dict):
        return _model_ready(settings)

    def groom_command(self, entry: dict) -> tuple[list[str], str, dict]:
        """A pass runs as the project would run it: this executable, in the
        project's root, with the project's .env and .env.local over the
        machine's environment."""
        root = Path(entry["root"])
        env = {k: v for k, v in os.environ.items() if k not in _PROJECT_POINTERS}
        env.update(_parse_env_file(root / ".env"))
        env.update(_parse_env_file(root / ".env.local"))
        env["CLAUDE_PROJECT_DIR"] = str(root)
        env["MEMORY_ACTOR"] = f"{NAME} service on {node_name()}"
        return ([str(Path(__file__).resolve()), "groom", "--apply", "--trigger",
                 "service: the window no longer fits block_chars"], str(root), env)


# ── the service verbs ────────────────────────────────────────────────────────

def _serving_state(entry: dict) -> tuple[Path, bool]:
    joined = _joined_here()
    return (_machine_state_dir(), True) if joined else (_project_state_dir(entry["slug"]), False)


def _service_here() -> dict:
    """This project's service as this machine's files say, for `status`."""
    try:
        view = _status_view(False)
    except SystemExit:
        return {"running": None, "reason": "the project has no durable id and slug"}
    project = view.get("project") or {}
    return {"mode": view["mode"], "running": view["running"], "pid": view["pid"],
            "state": project.get("state"), "rendered_at": project.get("rendered_at"),
            "consolidation": project.get("consolidation")}


def cmd_service_init(force: bool) -> dict:
    root = _root()
    home = _settings_homes("project")[0]
    if _settings_in_rows(home):
        # The settings are rows: the seed is written there, once.
        where, document, _error = _settings_read(home)
        if document is not None and not force:
            _die(6, "settings_exist", f"{where} holds this project's {NAME} settings",
                 f"`{NAME} service init --force` writes them anew")
        _settings_rows_write(home, "project", lambda _current: {"version": 1})
        return {"written": str(where), "settings": _settings(),
                "next": f"set any key `{NAME} help` SETTINGS names with `{NAME} settings "
                        f"set`; `{NAME} service reload` hands a running service the change"}
    path = _settings_path(root)
    if path.exists() and not force:
        _die(6, "settings_exist", f"{path} exists", f"`{NAME} service init --force` writes it anew")
    _engine().write_atomic(path, json.dumps({"version": 1}, indent=2) + "\n")
    return {"written": str(path), "settings": _settings(),
            "next": f"set any key `{NAME} help` SETTINGS names in it; `{NAME} service "
                    "reload` hands a running service the change"}


def cmd_service_init_machine(force: bool) -> dict:
    path = _machine_config_path()
    if path.exists() and not force:
        _die(6, "settings_exist", f"{path} exists", f"`{NAME} service init --machine --force`")
    _engine().write_atomic(path, json.dumps({"version": 1, "max_grooms": DEFAULT_MAX_GROOMS},
                                            indent=2) + "\n")
    return {"written": str(path)}


def _join_here() -> dict:
    root = _require_project_enabled_for_service()
    try:
        project, slug = _identity_here()
    except _engine().Refusal as exc:
        _refused(exc)
    with _list_lock():
        listed = _listed()
        if project in listed:
            return {"joined": False, "reason": "already on the machine service's list",
                    "project": {"id": project, "slug": slug},
                    "list": str(_machine_projects_path())}
        taken = [p for p, e in listed.items() if e.get("slug") == slug]
        if taken:
            _die(6, "slug_taken", f"project {taken[0]} at {listed[taken[0]]['root']} is joined "
                 f"with slug {slug!r}", "give one of them another slug, or leave the other with "
                 f"`{NAME} service leave --machine --project {taken[0]}`")
        listed[project] = {"root": str(root), "slug": slug, "joined_at": _utc_now(),
                           "joined_by": _actor()}
        _write_projects(listed)
    out = {"joined": True, "project": {"id": project, "slug": slug, "root": str(root)},
           "list": str(_machine_projects_path())}
    pid = _read_pid(_project_state_dir(slug))
    if _pid_alive(pid):
        out["next"] = (f"a project-mode process, pid {pid}, still serves this project; "
                       f"`{NAME} service stop` here hands it to the machine service")
    return out


def cmd_service_leave(machine: bool, named: str | None) -> dict:
    if machine:
        if not named:
            _die(6, "input", "leave --machine names the project it takes off the list",
                 f"`{NAME} service leave --machine --project <id-or-slug>`")
        here = None
    else:
        if named:
            _die(6, "input", "--project goes with --machine")
        try:
            here, _slug = _identity_here()
        except _engine().Refusal as exc:
            _refused(exc)
        named = here
    with _list_lock():
        listed = _listed()
        found = [p for p, e in listed.items()
                 if p == named or (here is None and e.get("slug") == named)]
        if not found:
            return {"left": False, "reason": "not on the machine service's list",
                    "project": named, "list": str(_machine_projects_path())}
        entry = listed.pop(found[0])
        _write_projects(listed)
    return {"left": True, "project": {"id": found[0], "slug": entry.get("slug"),
                                      "root": entry.get("root")},
            "list": str(_machine_projects_path())}


def _prepare_run(machine: bool):
    engine = _engine()
    try:
        _load_machine_settings()
    except engine.Refusal as exc:
        _refused(exc)
    if machine:
        return _Host("machine"), _machine_state_dir()
    root = _root()
    if _joined_here():
        _die(4, "joined_to_machine_service",
             f"this project is joined to the machine {NAME} service, which serves it",
             f"`{NAME} service leave` takes it back to project mode first")
    entry = _project_entry_here()
    _settings()
    try:
        engine.resolve_store(root)
    except engine.StoreUnavailable as exc:
        _store_refused(exc)
    return _Host("project", entry), _project_state_dir(entry["slug"])


def cmd_service_run(machine: bool) -> None:
    engine = _engine()
    host, state = _prepare_run(machine)
    runner = engine.Engine(host, mode="machine" if machine else "project", state_dir=state)
    try:
        runner.run()
    except RuntimeError as exc:
        if str(exc) == "busy":
            _die(8, "service_running", f"another {NAME} service process holds {state}",
                 f"`{NAME} service status{' --machine' if machine else ''}` names it")
        raise


def cmd_service_start(machine: bool, timeout: float) -> dict:
    _host, state = _prepare_run(machine)
    pid = _read_pid(state)
    if _pid_alive(pid):
        return {"started": False, "reason": "already running", "pid": pid,
                "state_dir": str(state)}
    state.mkdir(parents=True, exist_ok=True)
    argv = [str(Path(__file__).resolve()), "service", "run"] + (["--machine"] if machine else [])
    with open(os.devnull, "rb") as nothing, (state / "start.log").open("ab") as out:
        child = subprocess.Popen(argv, stdin=nothing, stdout=out, stderr=out,
                                 start_new_session=True, cwd=os.getcwd())
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if child.poll() is not None:
            _die(5, "start_failed", f"the service exited {child.returncode} as it started",
                 f"{state / 'start.log'} holds what it said")
        # The executable runs through its interpreter launcher, so the process
        # that serves is the launcher's child: the one the pid file names.
        served = _read_pid(state)
        if _pid_alive(served) and _read_status(state).get("pid") == served:
            return {"started": True, "pid": served, "state_dir": str(state),
                    "mode": "machine" if machine else "project"}
        time.sleep(0.2)
    _die(5, "start_timeout", f"pid {child.pid} did not publish its status within {timeout:g}s",
         f"{state / 'start.log'} and `{NAME} service logs` say what it did")


def _service_target(machine: bool) -> tuple[Path, dict | None, bool]:
    """(state root, this project's entry or None, whether the machine serves it)."""
    if machine:
        return _machine_state_dir(), None, True
    entry = _project_entry_here()
    state, by_machine = _serving_state(entry)
    return state, entry, by_machine


def cmd_service_stop(machine: bool, timeout: float) -> dict:
    state, _entry, by_machine = _service_target(machine)
    if by_machine and not machine:
        _die(4, "joined_to_machine_service", "the machine service serves this project",
             f"`{NAME} service leave` stops it serving this project; `{NAME} service stop "
             "--machine` stops the machine process")
    pid = _read_pid(state)
    if not _pid_alive(pid):
        return {"stopped": False, "reason": "not running", "state_dir": str(state)}
    os.kill(pid, signal.SIGTERM)
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline and _pid_alive(pid):
        time.sleep(0.2)
    if _pid_alive(pid):
        _die(5, "stop_timeout", f"pid {pid} did not stop within {timeout:g}s",
             "a grooming pass may still be ending; ask again, or wait")
    return {"stopped": True, "pid": pid}


def cmd_service_reload(machine: bool, timeout: float) -> dict:
    engine = _engine()
    state, entry, by_machine = _service_target(machine)
    if machine:
        try:
            _load_machine_settings()
        except engine.Refusal as exc:
            _refused(exc)
        expected = _machine_fingerprint()
        read = lambda status: status.get("fingerprint")  # noqa: E731
        error = lambda status: status.get("reload_error")  # noqa: E731
    else:
        expected = engine.settings_fingerprint(_settings())

        def row(status):
            return next((p for p in status.get("projects") or []
                         if p.get("project_id") == entry["id"]), {})
        read = lambda status: row(status).get("fingerprint")  # noqa: E731
        error = lambda status: row(status).get("reload_error")  # noqa: E731
    pid = _read_pid(state)
    if not _pid_alive(pid):
        _die(3, "not_running", f"no {NAME} service process serves this here",
             f"start it with `{NAME} service start{' --machine' if by_machine else ''}`")
    if read(_read_status(state)) == expected:
        return {"reloaded": False, "reason": "the running process already holds these settings",
                "fingerprint": expected, "pid": pid}
    os.kill(pid, signal.SIGHUP)
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        status = _read_status(state)
        if read(status) == expected:
            return {"reloaded": True, "fingerprint": expected, "pid": pid}
        if error(status):
            _die(6, "reload_rejected", f"the running process kept its settings: {error(status)}")
        time.sleep(0.3)
    _die(5, "reload_timeout", f"pid {pid} did not publish fingerprint {expected} within "
         f"{timeout:g}s", f"`{NAME} service logs` shows what it did")


def _status_view(machine: bool) -> dict:
    state, entry, by_machine = _service_target(machine)
    pid = _read_pid(state)
    running = _pid_alive(pid)
    status = _read_status(state) if running else {}
    if machine:
        try:
            listed, list_error = _read_projects(), None
        except _engine().Refusal as exc:
            listed, list_error = {}, exc.message
        rows = {p.get("project_id"): p for p in status.get("projects") or []}
        projects = []
        for project, joined in sorted(listed.items(), key=lambda kv: kv[1].get("slug") or ""):
            row = {"project": joined.get("slug"), "project_id": project,
                   "root": joined.get("root"), "joined_at": joined.get("joined_at"),
                   "joined_by": joined.get("joined_by"),
                   "present": Path(joined["root"]).is_dir()}
            row.update(rows.get(project) or {
                "state": None, "reason": "the machine service is not running"
                if not running else "not yet taken up"})
            projects.append(row)
        return {"mode": "machine", "running": running, "pid": pid if running else None,
                "state_dir": str(state), "started_at": status.get("started_at"),
                "published_at": status.get("published_at"),
                "fingerprint": status.get("fingerprint"),
                "current": (status.get("fingerprint") == _machine_fingerprint())
                if running else None,
                "reload_error": status.get("reload_error"), "cap": status.get("cap"),
                "stores": status.get("stores"),
                "list": {"path": str(_machine_projects_path()), "joined": len(listed),
                         **({"error": list_error} if list_error else {})},
                "projects": projects,
                **({} if running else {"hint": f"`{NAME} service start --machine` starts it"})}
    row = next((p for p in status.get("projects") or []
                if p.get("project_id") == entry["id"]), None)
    current = None
    if running and row:
        with contextlib.suppress(SystemExit):
            current = row.get("fingerprint") == _engine().settings_fingerprint(_settings())
    return {"mode": "machine" if by_machine else "project", "joined": by_machine,
            "running": running, "pid": pid if running else None, "state_dir": str(state),
            "current": current,
            "project": row or {"state": None, "reason": "no process serves this project"
                               if not running else "not yet taken up"}}


def cmd_service_logs(machine: bool, tail: int) -> dict:
    state, entry, by_machine = _service_target(machine)
    path = state / "daemon.log"
    try:
        lines = path.read_text().splitlines()
    except OSError:
        lines = []
    if entry is not None and by_machine:
        lines = [line for line in lines if f"[{entry['slug']}]" in line]
    return {"log": str(path), "lines": lines[-tail:] if tail > 0 else lines}


def _doctor_store(root: Path | None) -> dict:
    engine = _engine()
    try:
        setting = engine.resolve_store(root)
    except engine.StoreUnavailable as exc:
        return {"ok": False, "category": 6 if exc.slug in _SETTING_SLUGS else 5,
                "code": exc.slug, "error": exc.message,
                "hint": _STORE_HINT if exc.slug == "store_not_configured" else exc.hint}
    db = engine.database()
    conn = None
    try:
        conn = db.connect(application_name=NAME, setting=setting, transaction=True)
        found = db.status(conn, NAME, engine.LEDGER_STEPS, major=engine.LEDGER_MAJOR,
                          minor=engine.LEDGER_MINOR)
    except db.DbError as exc:
        return {"ok": False, "category": 6 if exc.slug in _SETTING_SLUGS else 5,
                "code": exc.slug, "error": exc.message, "setting": setting.report()}
    finally:
        if conn is not None:
            conn.close()
    row = {"ok": found.state in ("current", "pending"), "setting": setting.report(),
           "tables": found.state, "pending": found.pending}
    if found.state == "pending":
        row["note"] = "the next call that needs the tables migrates them; `memory migrate` now"
    if not row["ok"]:
        row.update(category=6, error=f"the tables are {found.state}",
                   hint=f"update {NAME}" if found.state == "schema_too_new" else None)
    return row


def _doctor_consolidation(settings: dict | None) -> dict:
    if settings is None:
        return {"ok": True, "on": None, "reason": "the settings do not load"}
    if not settings["consolidate"]:
        return {"ok": True, "on": False, "reason": "consolidate is false in the settings"}
    ready, why = _model_ready(settings)
    return {"ok": True, "on": ready, "profile": settings["groom_profile"],
            **({"reason": why} if why else {})}


def cmd_service_doctor(machine: bool) -> None:
    findings: dict = {}
    fail = 0

    def note(key: str, row: dict) -> None:
        nonlocal fail
        findings[key] = row
        if not row.get("ok") and not fail:
            fail = row.get("category") or 6
        row.pop("category", None)

    engine = _engine()
    if machine:
        try:
            settings = _load_machine_settings()
            note("settings", {"ok": True, "path": str(_machine_config_path()), **settings})
        except engine.Refusal as exc:
            note("settings", {"ok": False, "category": 6, "code": exc.code, "error": exc.message})
        view = _status_view(True)
        if not view["running"]:
            note("process", {"ok": False, "category": 7,
                             "error": "the machine service is not running",
                             "hint": f"its supervisor runs `{NAME} service run --machine`; "
                                     f"`{NAME} service start --machine` starts it by hand"})
        elif not view["current"]:
            note("process", {"ok": False, "category": 7, "error": "the running process holds "
                             "older machine settings", "hint": f"`{NAME} service reload --machine`"})
        else:
            stores = view.get("stores") or []
            connected = [s for s in stores if s.get("connected")]
            if stores and not connected:
                note("process", {"ok": False, "category": 5, "pid": view["pid"],
                                 "error": "no store the projects resolve is reachable",
                                 "stores": stores})
            else:
                note("process", {"ok": True, "pid": view["pid"], "stores": stores})
        findings["projects"] = view["projects"]
    else:
        root = _root()
        try:
            settings = _settings()
            note("settings", {"ok": True, "path": _settings_where(root), **settings})
        except SystemExit:
            settings = None
            note("settings", {"ok": False, "category": 6, "error": "the settings do not load; "
                              "`memory doctor` names the key"})
        note("store", _doctor_store(root))
        findings["consolidation"] = _doctor_consolidation(settings)
        view = _status_view(False)
        if not view["running"]:
            note("process", {"ok": False, "category": 7, "error": "no process serves this project",
                             "hint": f"`{NAME} service start`, or `{NAME} service join` with "
                                     "the machine service running"})
        elif view["current"] is False:
            note("process", {"ok": False, "category": 7, "error": "the running process holds "
                             "older settings of this project",
                             "hint": f"`{NAME} service reload`"})
        else:
            project = view["project"] or {}
            ok = project.get("state") == "served"
            note("process", {"ok": ok, "category": 7, "pid": view["pid"], "mode": view["mode"],
                             "state": project.get("state"), "reason": project.get("reason"),
                             "rendered_at": project.get("rendered_at")})
    _emit({"ok": fail == 0, **findings})
    if fail:
        sys.exit(fail)


# ── doctor and inventory ─────────────────────────────────────────────────────

def cmd_doctor() -> None:
    """Whether memory works in this project now: its identity, settings, store
    and tables, the rendered block against the store, consolidation, and the
    service."""
    findings: dict = {}
    fail = 0

    def note(key: str, row: dict) -> None:
        nonlocal fail
        findings[key] = row
        if not row.get("ok") and not fail:
            fail = row.get("category") or 6
        row.pop("category", None)

    root = _root()
    project = _project_id(write=True, refuse=False)
    state = _project_id_state() or {}
    if project:
        note("project", {"ok": True, "id": project, "identity": state.get("state")})
    else:
        note("project", {"ok": False, "category": 6, "identity": state.get("state"),
                         "error": "this project has no durable id a write may stamp",
                         "hint": "run `capabilities init` in the project"
                         if state.get("state") == "undeclared" else
                         (state.get("error") or {}).get("hint")
                         or "`capabilities doctor` names what to reconcile"})
    try:
        settings = _settings()
        note("settings", {"ok": True, "path": _settings_where(root),
                          "values": settings})
    except SystemExit:
        settings = None
        note("settings", {"ok": False, "category": 6, "path": _settings_where(root),
                          "error": "the settings do not load; run `memory render` to see the key "
                                   "refused"})
    store_row = _doctor_store(root)
    note("store", store_row)
    if store_row.get("ok") and project:
        last = None
        with contextlib.suppress(Exception):
            with _engine().Store(_engine().resolve_store(root)).open(migrate=False) as store:
                last = store.last_event(project)
        context = _context_report(root, last)
        context["store_last_event"] = last
        if not context["exists"]:
            context.update(ok=False, category=7, error="no rendered block in this envelope",
                           hint="`memory render` writes it; `memory service join` keeps it "
                                "rendered")
        elif not context["current"]:
            context.update(ok=False, category=7, error="the rendered block is behind the store",
                           hint="`memory render`; a running service renders it on its own")
        else:
            context["ok"] = True
        note("context", context)
    findings["consolidation"] = _doctor_consolidation(settings)
    findings["service"] = _service_here()
    _emit({"ok": fail == 0, **findings})
    if fail:
        sys.exit(fail)


def _inventory(_network: bool) -> dict:
    """Local only, and nothing more than the service: the entries are the
    store's, and reading them is `memory status`."""
    root = _project_root()
    service: dict = {"state": "stopped"}
    if root is None:
        return {"service": service}
    try:
        slug = _project_slug(root)
    except StoreError:
        slug = None
    if slug:
        joined = None
        with contextlib.suppress(Exception):
            joined = _read_projects().get(str(_project_id_state_at(root)["id"]))
        state = _machine_state_dir() if joined else _project_state_dir(slug)
        pid = _read_pid(state)
        if _pid_alive(pid):
            service = {"state": "running",
                       "detail": f"pid {pid}" + (" (machine service)" if joined else "")}
    context = _project_capabilities_dir(root) / NAME / CONTRIBUTION["path"]
    if context.is_file():
        service["ok"] = True
    else:
        service.update(ok=False, problem="no rendered memory block in this envelope; "
                                         "`memory render` writes it")
    return {"service": service}


# ── the command line ─────────────────────────────────────────────────────────

class _Parser(argparse.ArgumentParser):
    """Usage errors leave through the envelope at exit 6."""

    def __init__(self, *args, **kwargs):
        kwargs.setdefault("allow_abbrev", False)
        kwargs.setdefault("add_help", False)
        super().__init__(*args, **kwargs)

    def error(self, message: str) -> NoReturn:
        _die(6, "invalid_arguments", f"{self.prog}: {message}", f"run `{NAME} help`")


def _limit(value: str) -> int:
    try:
        n = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError(f"{value!r} is not a whole number")
    if not 1 <= n <= 1000:
        raise argparse.ArgumentTypeError(f"{value!r} is not between 1 and 1000")
    return n


def _parser() -> _Parser:
    parser = _Parser(prog=NAME)
    sub = parser.add_subparsers(dest="cmd", required=True, parser_class=_Parser)
    sub.add_parser("help").add_argument("topic", nargs="*")
    sub.add_parser("doctor")

    add = sub.add_parser("add")
    add.add_argument("text")
    add.add_argument("--title", required=True)
    add.add_argument("--pin", action="store_true")
    add.add_argument("--scope")
    sup = sub.add_parser("supersede")
    sup.add_argument("ids", nargs="+")
    sup.add_argument("--with", dest="with_", action="append", required=True)
    sup.add_argument("--title", action="append", required=True)
    sup.add_argument("--reason")
    sup.add_argument("--pin", action="store_true")
    drop = sub.add_parser("drop")
    drop.add_argument("id")
    drop.add_argument("--reason", required=True)
    drop.add_argument("--to")
    drop.add_argument("--purge", action="store_true")
    for verb in ("pin", "unpin"):
        sub.add_parser(verb).add_argument("id")

    listed = sub.add_parser("list")
    listed.add_argument("--status", choices=("active", "superseded", "dropped", "all"),
                        default="active")
    pins = listed.add_mutually_exclusive_group()
    pins.add_argument("--pinned", action="store_true")
    pins.add_argument("--unpinned", action="store_true")
    listed.add_argument("--scope")
    listed.add_argument("--since")
    listed.add_argument("--limit", type=_limit, default=50)
    listed.add_argument("--project")
    listed.add_argument("--json", action="store_true")
    show = sub.add_parser("show")
    show.add_argument("id")
    show.add_argument("--project")
    show.add_argument("--json", action="store_true")
    search = sub.add_parser("search")
    search.add_argument("terms", nargs="+")
    search.add_argument("--all", action="store_true")
    search.add_argument("--limit", type=_limit, default=20)
    search.add_argument("--project")
    search.add_argument("--json", action="store_true")
    log = sub.add_parser("log")
    log.add_argument("--since")
    log.add_argument("--limit", type=_limit, default=50)
    log.add_argument("--project")
    log.add_argument("--json", action="store_true")
    sub.add_parser("status").add_argument("--json", action="store_true")

    render = sub.add_parser("render")
    render.add_argument("--fragment", action="store_true")
    groom = sub.add_parser("groom")
    groom.add_argument("--apply", action="store_true")
    groom.add_argument("--undo")
    groom.add_argument("--trigger")
    adopt = sub.add_parser("adopt")
    adopt.add_argument("roots", nargs="*")
    adopt.add_argument("--apply", action="store_true")
    adopt.add_argument("--pin-titles", dest="pin_titles")
    adopt.add_argument("--timezone")
    export = sub.add_parser("export")
    export.add_argument("--out")
    export.add_argument("--project")

    service = sub.add_parser("service")
    ssub = service.add_subparsers(dest="action", required=True, parser_class=_Parser)
    init = ssub.add_parser("init")
    init.add_argument("--force", action="store_true")
    init.add_argument("--machine", action="store_true")
    for verb in ("run", "status", "doctor"):
        ssub.add_parser(verb).add_argument("--machine", action="store_true")
    for verb, wait in (("start", 30.0), ("stop", 30.0), ("reload", 30.0)):
        one = ssub.add_parser(verb)
        one.add_argument("--machine", action="store_true")
        one.add_argument("--timeout", type=float, default=wait)
    logs = ssub.add_parser("logs")
    logs.add_argument("--machine", action="store_true")
    logs.add_argument("--tail", type=int, default=100)
    ssub.add_parser("join")
    leave = ssub.add_parser("leave")
    leave.add_argument("--machine", action="store_true")
    leave.add_argument("--project")
    return parser


def _service(args) -> None:
    action = args.action
    machine = bool(getattr(args, "machine", False))
    if action == "init":
        _emit(cmd_service_init_machine(args.force) if machine else cmd_service_init(args.force))
    elif action == "join":
        _emit(_join_here())
    elif action == "leave":
        _emit(cmd_service_leave(machine, args.project))
    elif action == "run":
        cmd_service_run(machine)
    elif action == "start":
        _emit(cmd_service_start(machine, args.timeout))
    elif action == "stop":
        _emit(cmd_service_stop(machine, args.timeout))
    elif action == "reload":
        _emit(cmd_service_reload(machine, args.timeout))
    elif action == "status":
        _emit(_status_view(machine))
    elif action == "logs":
        _emit(cmd_service_logs(machine, args.tail))
    elif action == "doctor":
        cmd_service_doctor(machine)


def main() -> None:
    _gate()
    argv = sys.argv[1:]
    if argv[:1] == ["manifest"]:
        _emit(_manifest())
        return
    _contract(argv)
    if not argv:
        _cmd_help()
        return
    args = _parser().parse_args(argv)
    cmd = args.cmd
    if cmd == "help":
        _cmd_help()
        return
    if cmd in WRITE_VERBS - {"groom", "adopt"}:
        _read_only_gate(f"`{NAME} {cmd}`")
    handlers = {
        "add": cmd_add, "supersede": cmd_supersede, "drop": cmd_drop,
        "pin": lambda a: cmd_pin(a, True), "unpin": lambda a: cmd_pin(a, False),
        "list": cmd_list, "show": cmd_show, "search": cmd_search, "log": cmd_log,
        "status": cmd_status, "render": cmd_render, "groom": cmd_groom,
        "adopt": cmd_adopt, "export": cmd_export,
    }
    if cmd == "doctor":
        cmd_doctor()
    elif cmd == "service":
        try:
            _service(args)
        except _engine().Refusal as exc:
            _refused(exc)
    else:
        handlers[cmd](args)


if __name__ == "__main__":
    main()
