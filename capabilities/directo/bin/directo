CONFIG_DIR = _CONFIG_HOME / "directo"
CREDENTIALS_ENV = CONFIG_DIR / "credentials.env"
# Resolved by the cascade; COOKIE/KOHT are minted by `login` into the state home.
CASCADE_KEYS = ("DIRECTO_USERNAME", "DIRECTO_PASSWORD", "DIRECTO_DB", "DIRECTO_KOHT", "DIRECTO_COOKIE")
