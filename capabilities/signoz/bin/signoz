# >>> contract: connections (generated — edit contract/preamble.py, run `capabilities sync-contract`) >>>

def _resolve_env_key(key: str) -> tuple[str | None, str | None, Path | None]:
    """Resolve one env key through cascade tiers 2-4: project .env(.local) →
    user credentials.env → process env. Returns (value, tier, source)."""
    root = _project_root()
    if root is not None:
        for fname in (".env.local", ".env"):
            val = _parse_env_file(root / fname).get(key)
            if val:
                return val, "project", root / fname
    val = _parse_env_file(CREDENTIALS_ENV).get(key)
    if val:
        return val, "user", CREDENTIALS_ENV
    val = os.environ.get(key)
    if val:
        return val, "env", None
    return None, None, None


def _mask(value: str) -> str:
    return ("…" + value[-4:]) if len(value) >= 8 else "****"


def _connections_registry() -> tuple[dict | None, Path | None]:
    """The connections envelope and its path: project envelope first, else the
    user config home. First found wins, never merged; (None, None) when neither
    declares one (the implicit default connection applies)."""
    envdir = _env_dir()
    candidates = ([envdir / "connections.json"] if envdir else []) + \
                 [_CONFIG_HOME / NAME / "connections.json"]
    for reg_file in candidates:
        if not reg_file.is_file():
            continue
        try:
            raw = json.loads(reg_file.read_text())
        except (ValueError, OSError) as e:
            _die(6, "bad_config", f"cannot read {reg_file}: {e}")
        if not isinstance(raw, dict) or not isinstance(raw.get("connections"), dict) \
                or not raw["connections"]:
            _die(6, "bad_config", f"{reg_file} is not a connections envelope",
                 'expected {"default": "<id>", "connections": { ... }}')
        return raw, reg_file
    return None, None


def _select_connection(reg: dict | None, wanted: str | None) -> tuple[str, dict | None]:
    """flag → default pointer → sole entry → die 6. No registry → the implicit
    default. A connection's own `address` field selects it too (used where a
    connection carries a human-recognizable address; absent fields never match)."""
    if reg is None:
        if wanted and wanted != "default":
            _die(6, "unknown_connection",
                 "no connections registry; the sole connection is 'default'",
                 "the implicit default resolves from the credential cascade")
        return "default", None
    conns = reg["connections"]
    if wanted:
        if wanted in conns:
            return wanted, conns[wanted]
        for cid, entry in conns.items():
            if (entry or {}).get("address", "").lower() == wanted.lower():
                return cid, entry
        _die(6, "unknown_connection", f"no connection matches {wanted!r}",
             f"known: {', '.join(conns)}")
    default = reg.get("default")
    if default:
        if default not in conns:
            _die(6, "bad_default", f"default points to unknown connection {default!r}",
                 f"known: {', '.join(conns)}")
        return default, conns[default]
    if len(conns) == 1:
        cid = next(iter(conns))
        return cid, conns[cid]
    _die(6, "ambiguous_connection",
         f"registry defines {len(conns)} connections and no default; "
         f"pass --connection <id>",
         f"known: {', '.join(conns)}")


def _write_gate(conn_id: str, allow_write: bool, verb: str) -> None:
    """Policy from the committed registry; nothing in the cascade lifts it."""
    if verb in WRITE_VERBS and not allow_write:
        _die(4, "read_only",
             f"connection {conn_id!r} does not allow writes",
             "Do not lift the gate yourself — ask the user; granting is "
             "`allow_write: true` on this connection in connections.json.")


def _key_report(key: str, secret: bool, required: bool,
                value: str | None, tier: str | None, source) -> dict:
    return {"key": key, "secret": secret, "required": required,
            "set": bool(value), "tier": tier if value else None,
            "source": str(source) if (value and source) else None,
            "value": (_mask(value) if secret else value) if value else None}


def _missing_required(keys: list) -> list:
    """Required report rows (from _key_report) that did not resolve through the
    cascade — empty ⇒ credentials present. The primitive behind doctor's
    network-free readiness gate, read from the same per-key resolution
    `connections` reports, so the gate and the report can never disagree."""
    return [k["key"] for k in keys if k["required"] and not k["set"]]


def _doctor_gate(report: dict, wanted: str | None) -> None:
    """doctor's network-free readiness gate. Refuse with exit 2 — naming the
    unresolved required keys, before any round-trip — when a connection under
    test cannot resolve its required config through the cascade, so readiness is
    judged by the same resolution `connections` reports, never a parallel check.
    Checks the selected connection, else every connection in the report."""
    conns = report.get("connections") or {}
    targets = [wanted] if (wanted and wanted in conns) else list(conns)
    problems: dict = {}
    for cid in targets:
        miss = _missing_required((conns.get(cid) or {}).get("keys") or [])
        if miss:
            problems[cid] = miss
    if problems:
        detail = "; ".join(f"{c}: {', '.join(ks)}" for c, ks in sorted(problems.items()))
        _die(2, "credentials_missing",
             f"unresolved required config — {detail}",
             f"set each in the project .env/.env.local, the user credentials.env, "
             f"or process env; `{NAME} connections` shows where every value resolves")

# <<< contract: connections <<<

_ALIASES = {
    "SIGNOZ_URL": ("SIGNOZ_URL", "SIGNOZ_API_URL"),
    "SIGNOZ_API_KEY": ("SIGNOZ_API_KEY", "SIGNOZ_SERVICE_KEY"),
    "SIGNOZ_OTLP_ENDPOINT": ("SIGNOZ_OTLP_ENDPOINT", "SIGNOZ_ENDPOINT"),
    "SIGNOZ_INGESTION_KEY": ("SIGNOZ_INGESTION_KEY",),
    "SIGNOZ_CUSTOM_HEADERS": ("SIGNOZ_CUSTOM_HEADERS",),
}

_DEFAULT_DIMENSIONS = {
    "agent": {"logs": "agent_id", "traces": "agent_id"},
    "call": {"logs": "call_id", "traces": "call_id"},
    "room": {"logs": "room_id", "traces": "room_id"},
}

_ENVIRONMENT_FIELDS = ("deployment.environment", "deployment.environment.name")


def _resolve_first(keys: tuple[str, ...]) -> tuple[str | None, str | None,
                                                    Path | None, str | None]:
    for key in keys:
        value, tier, source = _resolve_env_key(key)
        if value:
            return value, tier, source, key
    return None, None, None, None


def _resolved_key_report(key: str, secret: bool, required: bool,
                         value: str | None, tier: str | None, source,
                         env_key: str | None = None) -> dict:
    row = _key_report(key, secret, required, value, tier, source)
    if env_key and env_key != key:
        row["resolved_from_key"] = env_key
    return row


def _deployment(url: str | None, otlp: str | None, explicit: str | None) -> str:
    if explicit:
        normalized = explicit.lower().replace("-", "_")
        if normalized not in {"cloud", "self_hosted"}:
            _die(6, "bad_config",
                 f"deployment must be 'cloud' or 'self_hosted', got {explicit!r}")
        return normalized
    hosts = " ".join(filter(None, [
        urlparse(url or "").hostname, urlparse(otlp or "").hostname,
    ]))
    return "cloud" if ".signoz.cloud" in hosts else "self_hosted"


def _entry_value(entry: dict, literal_key: str, canonical_key: str,
                 env_pointer: str | None = None,
                 legacy_pointer: str | None = None
                 ) -> tuple[str | None, str | None, object, str | None]:
    literal = entry.get(literal_key)
    if literal is not None:
        if not isinstance(literal, str) or not literal.strip():
            _die(6, "bad_config", f"{literal_key} must be a non-empty string")
        return literal.strip(), "registry", None, literal_key
    pointer = entry.get(env_pointer) if env_pointer else None
    if pointer is None and legacy_pointer:
        pointer = entry.get(legacy_pointer)
    if pointer is not None:
        if not isinstance(pointer, str) or not pointer.strip():
            _die(6, "bad_config", f"{env_pointer} must name an environment key")
        value, tier, source = _resolve_env_key(pointer.strip())
        return value, tier, source, pointer.strip()
    return _resolve_first(_ALIASES[canonical_key])


def _validate_environment(value: str) -> str:
    import re
    value = value.strip()
    if not value:
        _die(6, "bad_config", "environment cannot be empty")
    if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.-]*", value):
        _die(6, "bad_config",
             f"environment {value!r} has invalid characters",
             "use alphanumerics, underscores, dots, and hyphens")
    return value


def _validate_scope_filter(value: str) -> str:
    value = value.strip()
    if not value:
        _die(6, "bad_config", "scope_filter cannot be empty or whitespace-only")
    if len(value) > 10_000:
        _die(6, "bad_config",
             f"scope_filter is too long ({len(value)} characters)",
             "maximum length is 10000 characters")
    return value


def _dimension_fields(entry: dict) -> dict[str, dict[str, str]]:
    import re

    configured = entry.get("dimensions", {})
    if not isinstance(configured, dict):
        _die(6, "bad_config", "dimensions must be an object")
    unknown = sorted(set(configured) - set(_DEFAULT_DIMENSIONS))
    if unknown:
        _die(6, "bad_config",
             f"unknown dimensions: {', '.join(unknown)}",
             "supported dimensions: agent, call, room")

    result = {
        name: dict(fields) for name, fields in _DEFAULT_DIMENSIONS.items()
    }
    for name, value in configured.items():
        if isinstance(value, str):
            result[name] = {"logs": value, "traces": value}
        elif isinstance(value, dict):
            invalid_signals = sorted(set(value) - {"logs", "traces"})
            if invalid_signals:
                _die(6, "bad_config",
                     f"dimension {name!r} has unknown signals: "
                     f"{', '.join(invalid_signals)}")
            for signal, field in value.items():
                result[name][signal] = field
        else:
            _die(6, "bad_config",
                 f"dimension {name!r} must be a field name or signal map")

    for name, signals in result.items():
        for signal, field in signals.items():
            if not isinstance(field, str) or not re.fullmatch(
                    r"[A-Za-z_][A-Za-z0-9_.]*", field):
                _die(6, "bad_config",
                     f"dimension {name!r} for {signal} has invalid field "
                     f"name {field!r}",
                     "use a simple attribute name such as call_id or voice.call_id")
    return result


def _resolve_connection(wanted: str | None) -> dict:
    reg, reg_file = _connections_registry()
    cid, raw = _select_connection(reg, wanted)
    entry = raw if isinstance(raw, dict) else {}
    if raw is not None and not isinstance(raw, dict):
        _die(6, "bad_config", f"connection {cid!r} must be an object")

    url, url_tier, url_source, url_key = _entry_value(
        entry, "url", "SIGNOZ_URL")
    api_key, api_tier, api_source, api_env = _entry_value(
        entry, "_never_literal_api_key", "SIGNOZ_API_KEY",
        "api_key_env", "secret_env")
    otlp, otlp_tier, otlp_source, otlp_key = _entry_value(
        entry, "otlp_endpoint", "SIGNOZ_OTLP_ENDPOINT")
    ingestion_key, ingestion_tier, ingestion_source, ingestion_env = _entry_value(
        entry, "_never_literal_ingestion_key", "SIGNOZ_INGESTION_KEY",
        "ingestion_key_env")
    custom_headers, headers_tier, headers_source, headers_env = _entry_value(
        entry, "_never_literal_custom_headers", "SIGNOZ_CUSTOM_HEADERS",
        "custom_headers_env")

    if url:
        url = url.rstrip("/")
        parsed = urlparse(url)
        if parsed.scheme not in {"http", "https"} or not parsed.netloc:
            _die(6, "bad_config",
                 f"connection {cid!r} has invalid management URL {url!r}",
                 "use an absolute http(s) URL without an /api suffix")
        if parsed.path not in {"", "/"}:
            _die(6, "bad_config",
                 f"connection {cid!r} URL must be the instance root, got {url!r}")

    environment_raw = entry.get("environment")
    environment = None
    if environment_raw is not None:
        if not isinstance(environment_raw, str):
            _die(6, "bad_config", "environment must be a string")
        environment = _validate_environment(environment_raw)

    scope_filter_raw = entry.get("scope_filter")
    scope_filter = None
    if scope_filter_raw is not None:
        if not isinstance(scope_filter_raw, str):
            _die(6, "bad_config", "scope_filter must be a string")
        scope_filter = _validate_scope_filter(scope_filter_raw)

    return {
        "id": cid,
        "registry": str(reg_file) if reg_file else None,
        "url": url,
        "url_resolution": (url_tier, url_source, url_key),
        "api_key": api_key,
        "api_resolution": (api_tier, api_source, api_env),
        "otlp_endpoint": otlp.rstrip("/") if otlp else None,
        "otlp_resolution": (otlp_tier, otlp_source, otlp_key),
        "ingestion_key": ingestion_key,
        "ingestion_resolution": (ingestion_tier, ingestion_source, ingestion_env),
        "custom_headers": custom_headers,
        "headers_resolution": (headers_tier, headers_source, headers_env),
        "deployment": _deployment(url, otlp, entry.get("deployment")),
        "environment": environment,
        "scope_filter": scope_filter,
        "dimensions": _dimension_fields(entry),
        "verify_tls": bool(entry.get("verify_tls", True)),
        "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT)),
    }


def _connection_report(conn: dict) -> dict:
    def row(key: str, value, resolution, *, secret: bool, required: bool) -> dict:
        tier, source, env_key = resolution
        return _resolved_key_report(
            key, secret, required, value, tier, source, env_key)

    report = {
        "allow_write": conn["allow_write"],
        "deployment": conn["deployment"],
        "dimensions": conn["dimensions"],
        "verify_tls": conn["verify_tls"],
        "keys": [
            row("SIGNOZ_URL", conn["url"], conn["url_resolution"],
                secret=False, required=True),
            row("SIGNOZ_API_KEY", conn["api_key"], conn["api_resolution"],
                secret=True, required=True),
            row("SIGNOZ_OTLP_ENDPOINT", conn["otlp_endpoint"],
                conn["otlp_resolution"], secret=False, required=False),
            row("SIGNOZ_INGESTION_KEY", conn["ingestion_key"],
                conn["ingestion_resolution"], secret=True, required=False),
            row("SIGNOZ_CUSTOM_HEADERS", conn["custom_headers"],
                conn["headers_resolution"], secret=True, required=False),
        ],
    }
    if conn.get("environment") is not None:
        report["environment"] = conn["environment"]
    if conn.get("scope_filter") is not None:
        report["scope_filter"] = conn["scope_filter"]
    return report


def _connections_report() -> dict:
    reg, _ = _connections_registry()
    if reg is None:
        conn = _resolve_connection("default")
        return {"default": "default",
                "connections": {"default": _connection_report(conn)}}
    conns = reg["connections"]
    default = reg.get("default") or (next(iter(conns)) if len(conns) == 1 else None)
    return {
        "default": default,
        "connections": {
            cid: _connection_report(_resolve_connection(cid))
            for cid in conns
        },
    }


def _cmd_connections() -> None:
    _emit(_connections_report())


def _require_url(conn: dict) -> None:
    if not conn.get("url"):
        _die(2, "credentials_missing",
             f"connection {conn['id']!r} has no SIGNOZ_URL",
             "`signoz connections` shows the resolution cascade")


def _require_api(conn: dict) -> None:
    _require_url(conn)
    if not conn.get("api_key"):
        _die(2, "credentials_missing",
             f"connection {conn['id']!r} has no SIGNOZ_API_KEY",
             "create a SigNoz API key/PAT; an ingestion key cannot query data")


def _parse_custom_headers(raw: str | None) -> dict[str, str]:
    if not raw:
        return {}
    try:
        if raw.lstrip().startswith("{"):
            parsed = json.loads(raw)
            if not isinstance(parsed, dict):
                raise ValueError("JSON must be an object")
            headers = {str(k).strip(): str(v) for k, v in parsed.items()}
        else:
            headers = {}
            for item in raw.split(","):
                if ":" not in item:
                    raise ValueError("expected K:V,K2:V2")
                key, value = item.split(":", 1)
                headers[key.strip()] = value.strip()
    except (ValueError, json.JSONDecodeError) as exc:
        _die(6, "bad_config", f"SIGNOZ_CUSTOM_HEADERS is invalid: {exc}")
    forbidden = {"host", "content-length", "signoz-api-key"}
    if any(key.lower() in forbidden for key in headers):
        _die(6, "bad_config",
             "SIGNOZ_CUSTOM_HEADERS cannot override Host, Content-Length, or SIGNOZ-API-KEY")
    return headers


def _error_message(response: httpx.Response) -> str:
    try:
        payload = response.json()
        if isinstance(payload, dict):
            error = payload.get("error")
            if isinstance(error, dict):
                return str(error.get("message") or error.get("code") or error)[:1000]
            return str(payload.get("message") or payload.get("error") or payload)[:1000]
    except ValueError:
        pass
    text = response.text.strip()
    return text[:1000] if text else response.reason_phrase


def _request(conn: dict, method: str, path: str, *,
             params: dict | None = None, json_body=None,
             require_auth: bool = True, expect_json: bool = True):
    if require_auth:
        _require_api(conn)
    else:
        _require_url(conn)
    if not path.startswith("/api/"):
        _die(6, "input", f"SigNoz API path must start with /api/, got {path!r}")
    headers = {"Accept": "application/json"}
    if conn.get("api_key"):
        headers["SIGNOZ-API-KEY"] = conn["api_key"]
    headers.update(_parse_custom_headers(conn.get("custom_headers")))

    replay_safe = method in {"GET", "PUT", "DELETE"} or path.endswith("/query_range")
    response = None
    try:
        with httpx.Client(timeout=TIMEOUT, verify=conn["verify_tls"],
                          follow_redirects=True) as client:
            for attempt in range(MAX_RETRIES):
                response = client.request(
                    method, conn["url"] + path, params=params,
                    json=json_body, headers=headers)
                if response.status_code not in {429, 502, 503, 504} \
                        or not replay_safe or attempt == MAX_RETRIES - 1:
                    break
                time.sleep(0.25 * (2 ** attempt))
    except (httpx.TimeoutException, httpx.NetworkError, httpx.InvalidURL) as exc:
        _die(5, "network_error",
             f"{method} {path} failed for connection {conn['id']!r}: {exc}")
    if response is None:
        _die(5, "protocol_error",
             f"{method} {path} completed without a response")

    if response.status_code in {401, 403}:
        _die(2, "authentication_failed",
             f"SigNoz rejected SIGNOZ_API_KEY for connection {conn['id']!r}",
             "use a management API key/PAT, not SIGNOZ_INGESTION_KEY",
             response.status_code)
    if response.status_code == 404:
        _die(3, "not_found", f"SigNoz endpoint/resource not found: {path}",
             "the endpoint may require a newer SigNoz version", 404)
    if response.status_code == 429 or response.status_code >= 500:
        _die(5, "server_error",
             f"SigNoz returned {response.status_code}: {_error_message(response)}",
             status=response.status_code)
    if response.status_code >= 400:
        _die(6, "api_error",
             f"SigNoz returned {response.status_code}: {_error_message(response)}",
             status=response.status_code)
    if response.status_code == 204 or not response.content:
        return {"ok": True, "status": response.status_code}
    try:
        return response.json()
    except ValueError:
        if expect_json:
            _die(5, "protocol_error",
                 f"SigNoz returned non-JSON content for {path}",
                 f"content-type: {response.headers.get('content-type', 'unknown')}")
        return {
            "status": response.status_code,
            "content_type": response.headers.get("content-type"),
            "body": response.text[:1_000_000],
            "truncated": len(response.text) > 1_000_000,
        }


def _server_info(conn: dict) -> dict:
    payload = _request(conn, "GET", "/api/v1/version", require_auth=False)
    data = payload.get("data") if isinstance(payload, dict) else None
    source = data if isinstance(data, dict) else payload
    if not isinstance(source, dict):
        _die(5, "protocol_error", "SigNoz version response is not an object")
    version = source.get("version") or payload.get("version")
    if not version:
        _die(5, "protocol_error", "SigNoz version response has no version")
    return {
        "version": str(version).lstrip("v"),
        "edition": "enterprise" if bool(source.get("ee", payload.get("ee"))) else "community",
        "setup_completed": source.get("setupCompleted", payload.get("setupCompleted")),
    }


def _version_at_least(version: str, wanted: tuple[int, int, int]) -> bool:
    import re
    numbers = [int(x) for x in re.findall(r"\d+", version)[:3]]
    numbers += [0] * (3 - len(numbers))
    return tuple(numbers) >= wanted


def _dashboard_path(info: dict, ident: str | None = None) -> str:
    base = "/api/v2/dashboards" if _version_at_least(
        info["version"], (0, 135, 0)) else "/api/v1/dashboards"
    return base + (f"/{ident}" if ident else "")


def _rules_path(info: dict, ident: str | None = None) -> str:
    base = "/api/v2/rules" if _version_at_least(
        info["version"], (0, 120, 0)) else "/api/v1/rules"
    return base + (f"/{ident}" if ident else "")


class _Parser(argparse.ArgumentParser):
    def error(self, message):
        _die(6, "input", message, self.format_usage().strip())


def _parser(prog: str) -> _Parser:
    return _Parser(prog=f"signoz {prog}", add_help=False)


def _add_time_args(parser: argparse.ArgumentParser, default: str = "1h") -> None:
    parser.add_argument("--since", default=default)
    parser.add_argument("--start", type=int)
    parser.add_argument("--end", type=int)


def _duration_ms(raw: str) -> int:
    import re
    match = re.fullmatch(r"(\d+)([smhdw])", raw.strip().lower())
    if not match:
        _die(6, "input", f"invalid duration {raw!r}",
             "use an integer plus s/m/h/d/w, for example 30m or 7d")
    units = {"s": 1_000, "m": 60_000, "h": 3_600_000,
             "d": 86_400_000, "w": 604_800_000}
    return int(match.group(1)) * units[match.group(2)]


def _window(args) -> tuple[int, int]:
    if (args.start is None) != (args.end is None):
        _die(6, "input", "--start and --end must be supplied together")
    if args.start is not None:
        if args.start >= args.end:
            _die(6, "input", "--start must be less than --end")
        return args.start, args.end
    end = int(time.time() * 1000)
    return end - _duration_ms(args.since), end


def _bounded_limit(value: int, maximum: int = 10_000) -> int:
    if value < 1 or value > maximum:
        _die(6, "input", f"--limit must be between 1 and {maximum}")
    return value


def _qb_quote(value: str) -> str:
    return value.replace("\\", "\\\\").replace("'", "\\'")


def _identifier(value: str) -> str:
    value = value.strip()
    if not value:
        raise argparse.ArgumentTypeError("identifier cannot be empty")
    return value


def _add_dimension_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--agent-id", type=_identifier)
    parser.add_argument("--call-id", type=_identifier)
    parser.add_argument("--room-id", type=_identifier)


def _add_environment_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--environment", type=_identifier,
                        help="override connection environment or query a specific environment")
    parser.add_argument("--all-environments", action="store_true",
                        help="query all environments (ignore connection environment)")
    parser.add_argument("--legacy-unscoped", action="store_true",
                        help="query legacy data without deployment.environment attributes")


def _dimension_filter(conn: dict, signal: str, dimension: str,
                      value: str) -> str:
    field = conn["dimensions"][dimension][signal]
    return f"{field} = '{_qb_quote(value)}'"


def _environment_filter(environment: str | None) -> list[str]:
    if environment is None:
        return []
    quoted = _qb_quote(environment)
    return [
        f"({_ENVIRONMENT_FIELDS[0]} = '{quoted}' OR "
        f"{_ENVIRONMENT_FIELDS[1]} = '{quoted}')"
    ]


def _resolve_effective_scope(conn: dict, args) -> tuple[str | None, str | None]:
    """Resolve the effective base scope filter with exact precedence.
    
    Returns (scope_type, scope_value) where:
    - scope_type: "environment", "filter", or None
    - scope_value: the environment name or filter expression, or None
    
    Precedence:
    1. --all-environments or --legacy-unscoped → (None, None)
    2. CLI --environment → ("environment", value)
    3. connection scope_filter → ("filter", expression)
    4. connection environment → ("environment", value)
    5. no scope → (None, None)
    """
    if getattr(args, "all_environments", False):
        if getattr(args, "environment", None):
            _die(6, "input",
                 "--all-environments and --environment are mutually exclusive")
        if getattr(args, "legacy_unscoped", False):
            _die(6, "input",
                 "--all-environments and --legacy-unscoped are mutually exclusive")
        return None, None
    if getattr(args, "legacy_unscoped", False):
        if getattr(args, "environment", None):
            _die(6, "input",
                 "--legacy-unscoped and --environment are mutually exclusive")
        return None, None
    if getattr(args, "environment", None):
        return "environment", args.environment
    if conn.get("scope_filter"):
        return "filter", conn["scope_filter"]
    if conn.get("environment"):
        return "environment", conn["environment"]
    return None, None


def _build_scope_filter(scope_type: str | None, scope_value: str | None) -> list[str]:
    """Build the base scope filter from resolved scope type and value.
    
    Returns:
    - For scope_type="environment": dual-field OR filter
    - For scope_type="filter": raw filter expression as-is
    - For scope_type=None: empty list (no scope)
    """
    if scope_type is None or scope_value is None:
        return []
    if scope_type == "environment":
        return _environment_filter(scope_value)
    if scope_type == "filter":
        return [scope_value]
    return []


def _query_payload(signal: str, start: int, end: int, expression: str,
                   limit: int, offset: int) -> dict:
    spec: dict = {
        "name": "A",
        "signal": signal,
        "disabled": False,
        "filter": {"expression": expression},
        "limit": limit,
        "offset": offset,
        "order": [{"key": {"name": "timestamp"}, "direction": "desc"}],
        "having": {"expression": ""},
    }
    if signal == "logs":
        spec["order"].append(
            {"key": {"name": "id"}, "direction": "desc"})
    else:
        spec["selectFields"] = [
            {"name": "trace_id", "fieldDataType": "string",
             "signal": "traces", "fieldContext": "span"},
            {"name": "span_id", "fieldDataType": "string",
             "signal": "traces", "fieldContext": "span"},
            {"name": "parent_span_id", "fieldDataType": "string",
             "signal": "traces", "fieldContext": "span"},
            {"name": "name", "fieldDataType": "string",
             "signal": "traces", "fieldContext": "span"},
            {"name": "duration_nano", "fieldDataType": "number",
             "signal": "traces", "fieldContext": "span"},
            {"name": "timestamp", "fieldDataType": "number",
             "signal": "traces", "fieldContext": "span"},
            {"name": "has_error", "fieldDataType": "bool",
             "signal": "traces", "fieldContext": "span"},
            {"name": "status_code_string", "fieldDataType": "string",
             "signal": "traces", "fieldContext": "span"},
            {"name": "service.name", "fieldDataType": "string",
             "signal": "traces", "fieldContext": "resource"},
        ]
    return {
        "schemaVersion": "v1",
        "start": start,
        "end": end,
        "requestType": "raw",
        "compositeQuery": {
            "queries": [{"type": "builder_query", "spec": spec}]},
        "formatOptions": {
            "formatTableResultForUI": False, "fillGaps": False},
        "variables": {},
    }


def _read_json_input(source: str):
    try:
        text = sys.stdin.read() if source == "-" else Path(source).read_text()
    except OSError as exc:
        _die(6, "input", f"cannot read {source!r}: {exc}")
    try:
        return json.loads(text)
    except ValueError as exc:
        _die(6, "input", f"{source!r} is not valid JSON: {exc}")


def _ingestion_plan(conn: dict) -> dict:
    endpoint = conn.get("otlp_endpoint")
    protocol = None
    if endpoint:
        parsed = urlparse(endpoint)
        protocol = "http/protobuf" if parsed.port == 4318 else "grpc"
    env = {
        "OTEL_EXPORTER_OTLP_ENDPOINT": endpoint,
        "OTEL_EXPORTER_OTLP_PROTOCOL": protocol,
    }
    if conn["deployment"] == "cloud":
        env["OTEL_EXPORTER_OTLP_HEADERS"] = (
            "signoz-ingestion-key=${SIGNOZ_INGESTION_KEY}"
            if conn.get("ingestion_key") else None)
    
    resource_attributes = None
    if conn.get("environment"):
        resource_attributes = (
            f"{_ENVIRONMENT_FIELDS[0]}={conn['environment']},"
            f"{_ENVIRONMENT_FIELDS[1]}={conn['environment']}"
        )
        env["OTEL_RESOURCE_ATTRIBUTES"] = resource_attributes
    
    plan = {
        "connection": conn["id"],
        "deployment": conn["deployment"],
        "configured": bool(endpoint),
        "ingestion_auth": (
            "signoz-ingestion-key" if conn["deployment"] == "cloud" else "none"),
        "ingestion_key_set": bool(conn.get("ingestion_key")),
        "env": env,
        "note": (
            "Cloud requires an ingestion key."
            if conn["deployment"] == "cloud"
            else "Self-hosted Community normally accepts OTLP without an ingestion key."),
    }
    if conn.get("environment"):
        plan["environment"] = conn["environment"]
        plan["environment_note"] = (
            f"Connection specifies environment={conn['environment']!r}. "
            "Both deployment.environment and deployment.environment.name will be set. "
            "Merge with existing OTEL_RESOURCE_ATTRIBUTES if needed, separated by commas."
        )
    return plan


def cmd_doctor(wanted: str | None) -> None:
    report = _connections_report()
    _doctor_gate(report, wanted)
    targets = [wanted] if wanted else list(report["connections"])
    results = {}
    for cid in targets:
        conn = _resolve_connection(cid)
        info = _server_info(conn)
        # A protected endpoint proves that the management key, not merely the
        # public health/version route, is accepted.
        _request(conn, "GET", "/api/v1/dashboards")
        results[cid] = {
            "ok": True,
            "url": conn["url"],
            **info,
            "deployment": conn["deployment"],
            "allow_write": conn["allow_write"],
            "ingestion": _ingestion_plan(conn),
        }
    _emit({"ok": True, "connections": results})


def _cmd_services(conn: dict, argv: list[str]):
    parser = _parser("services")
    _add_time_args(parser)
    args = parser.parse_args(argv)
    start, end = _window(args)
    info = _server_info(conn)
    # v0.97's legacy service parser feeds the values to time.Unix(0, value)
    # and therefore expects nanoseconds. Newer service APIs use milliseconds,
    # matching Query Builder v5 and the official MCP client.
    if not _version_at_least(info["version"], (0, 100, 0)):
        start, end = start * 1_000_000, end * 1_000_000
    return _request(conn, "POST", "/api/v1/services",
                    json_body={"start": str(start), "end": str(end)})


def _cmd_metrics(conn: dict, argv: list[str]):
    parser = _parser("metrics")
    parser.add_argument("--search", default="")
    parser.add_argument("--limit", type=int, default=50)
    _add_time_args(parser)
    args = parser.parse_args(argv)
    limit = _bounded_limit(args.limit, 1_000)
    start, end = _window(args)
    info = _server_info(conn)
    if _version_at_least(info["version"], (0, 120, 0)):
        return _request(conn, "GET", "/api/v2/metrics", params={
            "start": start, "end": end, "limit": limit,
            "searchText": args.search or None,
        })
    payload = {
        "offset": 0,
        "limit": limit,
        "start": start,
        "end": end,
        "orderBy": {"columnName": "timeseries", "order": "desc"},
        "filters": {"op": "AND", "items": []},
    }
    result = _request(conn, "POST", "/api/v1/metrics", json_body=payload)
    if args.search and isinstance(result, dict):
        data = result.get("data")
        target = data if isinstance(data, dict) else result
        metrics = target.get("metrics") if isinstance(target, dict) else None
        if isinstance(metrics, list):
            needle = args.search.lower()
            target["metrics"] = [
                item for item in metrics
                if needle in str((item or {}).get("metric_name")
                                 or (item or {}).get("name") or "").lower()
            ]
            target["client_side_search"] = args.search
    return result


def _cmd_fields(conn: dict, argv: list[str]):
    if not argv or argv[0] not in {"keys", "values"}:
        _die(6, "input", "usage: signoz fields keys|values [options]")
    verb = argv[0]
    parser = _parser(f"fields {verb}")
    parser.add_argument("--signal", required=True,
                        choices=["logs", "traces", "metrics"])
    parser.add_argument("--search", default="")
    parser.add_argument("--context", dest="field_context", default="")
    parser.add_argument("--metric", default="")
    if verb == "values":
        parser.add_argument("--name", required=True)
    args = parser.parse_args(argv[1:])
    params = {
        "signal": args.signal,
        "searchText": args.search or None,
        "fieldContext": args.field_context or None,
        "metricName": args.metric or None,
    }
    if verb == "values":
        params["name"] = args.name
    return _request(conn, "GET", f"/api/v1/fields/{verb}", params=params)


def _cmd_signal_search(conn: dict, signal: str, argv: list[str]):
    if not argv or argv[0] != "search":
        _die(6, "input", f"usage: signoz {signal} search [options]")
    parser = _parser(f"{signal} search")
    parser.add_argument("--service", default="")
    parser.add_argument("--filter", default="")
    parser.add_argument("--limit", type=int, default=100)
    parser.add_argument("--offset", type=int, default=0)
    _add_dimension_args(parser)
    _add_environment_args(parser)
    if signal == "logs":
        parser.add_argument("--severity", default="")
        parser.add_argument("--search", default="")
    else:
        parser.add_argument("--operation", default="")
        parser.add_argument("--error", choices=["yes", "no"])
    _add_time_args(parser)
    args = parser.parse_args(argv[1:])
    if args.offset < 0:
        _die(6, "input", "--offset cannot be negative")
    parts = [args.filter] if args.filter else []
    scope_type, scope_value = _resolve_effective_scope(conn, args)
    parts.extend(_build_scope_filter(scope_type, scope_value))
    if args.service:
        parts.append(f"service.name = '{_qb_quote(args.service)}'")
    for dimension in ("agent", "call", "room"):
        value = getattr(args, f"{dimension}_id")
        if value:
            parts.append(_dimension_filter(conn, signal, dimension, value))
    if signal == "logs":
        if args.severity:
            parts.append(f"severity_text = '{_qb_quote(args.severity)}'")
        if args.search:
            parts.append(f"body CONTAINS '{_qb_quote(args.search)}'")
    else:
        if args.operation:
            parts.append(f"name = '{_qb_quote(args.operation)}'")
        if args.error:
            parts.append(f"has_error = {'true' if args.error == 'yes' else 'false'}")
    start, end = _window(args)
    payload = _query_payload(
        signal, start, end, " AND ".join(parts),
        _bounded_limit(args.limit), args.offset)
    return _request(conn, "POST", "/api/v5/query_range", json_body=payload)


def _cmd_correlated(conn: dict, dimension: str, argv: list[str]):
    parser = _parser(dimension)
    parser.add_argument(f"{dimension}_id", type=_identifier)
    parser.add_argument("--signal", choices=["logs", "traces", "both"],
                        default="both")
    parser.add_argument("--service", default="")
    parser.add_argument("--filter", default="")
    parser.add_argument("--limit", type=int, default=100)
    _add_environment_args(parser)
    _add_time_args(parser, "24h")
    args = parser.parse_args(argv)
    limit = _bounded_limit(args.limit)
    start, end = _window(args)
    identifier = getattr(args, f"{dimension}_id")
    signals = ["logs", "traces"] if args.signal == "both" else [args.signal]

    scope_type, scope_value = _resolve_effective_scope(conn, args)

    filters = {}
    data = {}
    for signal in signals:
        parts = [args.filter] if args.filter else []
        parts.extend(_build_scope_filter(scope_type, scope_value))
        if args.service:
            parts.append(f"service.name = '{_qb_quote(args.service)}'")
        parts.append(_dimension_filter(
            conn, signal, dimension, identifier))
        expression = " AND ".join(parts)
        filters[signal] = expression
        data[signal] = _request(
            conn, "POST", "/api/v5/query_range",
            json_body=_query_payload(
                signal, start, end, expression, limit, 0))

    result = {
        "entity": dimension,
        "id": identifier,
        "window": {"start": start, "end": end},
        "filters": filters,
        "data": data,
    }
    if scope_type == "environment":
        result["environment_scope"] = scope_value
    elif scope_type == "filter":
        result["scope_filter"] = scope_value
    return result


def _cmd_trace(conn: dict, argv: list[str]):
    parser = _parser("trace")
    parser.add_argument("trace_id")
    _add_time_args(parser, "6h")
    args = parser.parse_args(argv)
    start, end = _window(args)
    payload = _query_payload(
        "traces", start, end,
        f"trace_id = '{_qb_quote(args.trace_id)}'", 1_000, 0)
    return _request(conn, "POST", "/api/v5/query_range", json_body=payload)


def _cmd_views(conn: dict, argv: list[str]):
    parser = _parser("views")
    parser.add_argument("id", nargs="?")
    parser.add_argument("--source-page",
                        choices=["traces", "logs", "metrics"])
    args = parser.parse_args(argv)
    path = "/api/v1/explorer/views" + (f"/{args.id}" if args.id else "")
    params = {"sourcePage": args.source_page} if args.source_page else None
    return _request(conn, "GET", path, params=params)


def _cmd_api(conn: dict, argv: list[str]):
    parser = _parser("api")
    parser.add_argument("method", choices=["GET", "POST", "PUT", "PATCH", "DELETE"])
    parser.add_argument("path")
    parser.add_argument("--data")
    args = parser.parse_args(argv)
    if not args.path.startswith("/api/") or "://" in args.path:
        _die(6, "input", "api path must be a relative /api/... path")
    if args.method != "GET":
        _write_gate(conn["id"], conn["allow_write"], "api")
    elif args.data:
        _die(6, "input", "--data is not accepted with GET")
    body = _read_json_input(args.data) if args.data else None
    return _request(conn, args.method, args.path, json_body=body,
                    expect_json=False)


def _extract_connection(argv: list[str]) -> tuple[str | None, list[str]]:
    wanted = None
    cleaned = []
    i = 0
    while i < len(argv):
        if argv[i] == "--connection":
            if i + 1 >= len(argv):
                _die(6, "input", "--connection needs an id")
            wanted = argv[i + 1]
            i += 2
            continue
        if argv[i].startswith("--connection="):
            wanted = argv[i].split("=", 1)[1]
            i += 1
            continue
        cleaned.append(argv[i])
        i += 1
    return wanted, cleaned


def main() -> None:
    _gate()
    argv = sys.argv[1:]
    _contract(argv)
    wanted, args = _extract_connection(argv)
    if args == ["doctor"]:
        cmd_doctor(wanted)
        return
    if not args:
        _die(6, "input", "missing command", f"run `{NAME} help`")
    conn = _resolve_connection(wanted)
    command, rest = args[0], args[1:]

    if command == "version":
        if rest:
            _die(6, "input", "version takes no arguments")
        result = {"connection": conn["id"], **_server_info(conn)}
    elif command == "ingestion":
        if rest:
            _die(6, "input", "ingestion takes no arguments")
        result = _ingestion_plan(conn)
    elif command == "services":
        result = _cmd_services(conn, rest)
    elif command == "metrics":
        result = _cmd_metrics(conn, rest)
    elif command == "fields":
        result = _cmd_fields(conn, rest)
    elif command == "logs":
        result = _cmd_signal_search(conn, "logs", rest)
    elif command == "traces":
        result = _cmd_signal_search(conn, "traces", rest)
    elif command in {"call", "agent"}:
        result = _cmd_correlated(conn, command, rest)
    elif command == "trace":
        result = _cmd_trace(conn, rest)
    elif command == "query":
        if len(rest) != 1:
            _die(6, "input", "usage: signoz query <file|->")
        result = _request(conn, "POST", "/api/v5/query_range",
                          json_body=_read_json_input(rest[0]))
    elif command == "dashboards":
        parser = _parser("dashboards")
        parser.add_argument("id", nargs="?")
        parsed = parser.parse_args(rest)
        info = _server_info(conn)
        result = _request(conn, "GET", _dashboard_path(info, parsed.id))
    elif command == "alerts":
        if rest:
            _die(6, "input", "alerts takes no arguments")
        result = _request(conn, "GET", "/api/v1/alerts")
    elif command == "rules":
        parser = _parser("rules")
        parser.add_argument("id", nargs="?")
        parsed = parser.parse_args(rest)
        info = _server_info(conn)
        result = _request(conn, "GET", _rules_path(info, parsed.id))
    elif command == "views":
        result = _cmd_views(conn, rest)
    elif command == "channels":
        parser = _parser("channels")
        parser.add_argument("id", nargs="?")
        parsed = parser.parse_args(rest)
        path = "/api/v1/channels" + (f"/{parsed.id}" if parsed.id else "")
        result = _request(conn, "GET", path)
    elif command == "api":
        result = _cmd_api(conn, rest)
    else:
        _die(6, "input", f"unknown command {command!r}", f"run `{NAME} help`")
    _emit(result)


if __name__ == "__main__":
    main()
