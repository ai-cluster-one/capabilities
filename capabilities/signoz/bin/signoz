#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "httpx>=0.27",
# ]
# ///
"""signoz — agent-first CLI for SigNoz telemetry and configuration APIs.

It supports SigNoz Cloud and self-hosted Community/Enterprise installations.
The management/query API and OTLP ingestion are deliberately separate:
SIGNOZ_API_KEY reads or manages SigNoz, while SIGNOZ_INGESTION_KEY only
authenticates Cloud telemetry ingestion. Self-hosted ingestion normally has no
key. Run `signoz guide connections` for the exact deployment matrix.

CONNECTIONS
  With no registry, the implicit `default` connection resolves:
    SIGNOZ_URL                 Management/query base URL (required).
    SIGNOZ_API_KEY             Service-account/PAT API key (required, secret).
    SIGNOZ_OTLP_ENDPOINT       OTLP endpoint (optional).
    SIGNOZ_INGESTION_KEY       Cloud ingestion key (optional, secret).
    SIGNOZ_CUSTOM_HEADERS      Extra proxy headers as JSON or K:V,K2:V2 (secret).

  Compatibility aliases are accepted for existing setups:
    SIGNOZ_API_URL -> SIGNOZ_URL
    SIGNOZ_SERVICE_KEY -> SIGNOZ_API_KEY
    SIGNOZ_ENDPOINT -> SIGNOZ_OTLP_ENDPOINT

  More than one deployment is declared in
  <project>/capabilities/signoz/connections.json:
    {
      "default": "production",
      "connections": {
        "production": {
          "url": "https://signoz.example.com",
          "api_key_env": "SIGNOZ_PROD_API_KEY",
          "otlp_endpoint": "https://collector.example.com:4318",
          "deployment": "self_hosted",
          "environment": "production",
          "dimensions": {
            "agent": "agent_id",
            "call": "call_id",
            "room": "room_id"
          },
          "allow_write": false
        },
        "cloud": {
          "url": "https://workspace.eu.signoz.cloud",
          "api_key_env": "SIGNOZ_CLOUD_API_KEY",
          "otlp_endpoint": "https://ingest.eu.signoz.cloud:443",
          "ingestion_key_env": "SIGNOZ_CLOUD_INGESTION_KEY",
          "deployment": "cloud",
          "allow_write": false
        }
      }
    }
  Secrets are names of env vars, never literal values. Selection is
  --connection <id>, then the registry default, then the sole entry.
  
  Optional "environment" scopes data queries to deployment.environment or
  deployment.environment.name. Optional "scope_filter" provides a custom
  Query Builder v5 filter expression for legacy or non-standard telemetry.
  When both exist, scope_filter replaces environment-derived scope; CLI
  --environment overrides both. Queries apply the connection's base scope
  unless overridden with --environment, --all-environments, or --legacy-unscoped.

COMMANDS
  signoz doctor [--connection ID]
      Verify version, management API authentication, and OTLP configuration.
      Without a connection flag checks every configured deployment.
  signoz connections
      Local resolution report; secrets are masked and no network is touched.
  signoz version
      Server version and edition metadata (the endpoint is intentionally public).
  signoz ingestion
      Render a secret-free OTLP environment plan for the selected deployment.

  signoz services [--since 1h|--start MS --end MS]
      Services observed in the time window.
  signoz metrics [--search TEXT] [--limit N] [time options]
      Metric catalog with type/unit/last-seen metadata.
  signoz fields keys --signal logs|traces|metrics [--search TEXT]
                    [--context resource|attribute|scope] [--metric NAME]
  signoz fields values --signal ... --name FIELD [same options]
      Discover queryable field names and observed values.
  signoz logs search [--service NAME] [--agent-id ID] [--call-id ID]
                     [--room-id ID] [--severity LEVEL] [--search TEXT]
                     [--filter EXPR] [--environment ENV] [--all-environments]
                     [--legacy-unscoped] [--limit N] [--offset N] [time options]
  signoz traces search [--service NAME] [--agent-id ID] [--call-id ID]
                       [--room-id ID] [--operation NAME] [--error yes|no]
                       [--filter EXPR] [--environment ENV] [--all-environments]
                       [--legacy-unscoped] [--limit N] [--offset N] [time options]
  signoz trace <trace-id> [--since 6h|--start MS --end MS]
      Query raw logs/spans through Query Builder v5. Shortcut filters combine
      with --filter using AND. --environment overrides the connection's scope;
      --all-environments queries all environments; --legacy-unscoped queries
      historical data without deployment.environment attributes.
  signoz call <call-id> [--signal logs|traces|both] [--service NAME]
                        [--filter EXPR] [--environment ENV] [--all-environments]
                        [--legacy-unscoped] [--limit N] [time options]
  signoz agent <agent-id> [same options]
      Fetch correlated logs and traces for one domain identifier. Connection
      dimensions map logical agent/call/room names to project-specific fields.
      Environment scope applies unless overridden.
  signoz query <file|->
      Execute a complete Query Builder v5 JSON request from a file or stdin.

  signoz dashboards [<id>]      List dashboards or fetch one.
  signoz alerts                 Current Alertmanager instances.
  signoz rules [<id>]           Alert-rule definitions (v1/v2 by server version).
  signoz views [<id>] [--source-page traces|logs|metrics]
  signoz channels [<id>]        Saved Explorer views and notification channels.

  signoz api <GET|POST|PUT|PATCH|DELETE> </api/...> [--data <file|->]
      Authenticated escape hatch for a documented API not covered above.
      Non-GET calls require the connection's allow_write=true policy.

Contract commands:
  signoz stub · signoz manifest --json · signoz guide [connections|queries]
  signoz ids list|get|set|rm · signoz refs

EXIT CODES
  0 success · 2 missing/rejected API credentials · 3 not found ·
  4 project/write policy refusal (ask the user; never lift it yourself) ·
  5 network/server/protocol failure · 6 invalid input.
"""

import argparse
import json
import os
import sys
import time
from pathlib import Path
from typing import NoReturn
from urllib.parse import urlparse

import httpx

NAME = 'signoz'
SUMMARY = ("SigNoz CLI over the management and Query Builder APIs — discover "
           "services/metrics/fields, search logs and traces, inspect dashboards/"
           "alerts/views/channels, and execute raw API queries on Cloud or "
           "self-hosted instances.")
SCOPE = "project"
CRED_KEYS = [
    {"key": "SIGNOZ_URL", "secret": False, "required": True,
     "note": "management/query base URL; SIGNOZ_API_URL is accepted as an alias"},
    {"key": "SIGNOZ_API_KEY", "secret": True, "required": True,
     "note": "service-account/PAT key; SIGNOZ_SERVICE_KEY is accepted as an alias"},
    {"key": "SIGNOZ_OTLP_ENDPOINT", "secret": False, "required": False,
     "note": "OTLP gRPC/HTTP endpoint; SIGNOZ_ENDPOINT is accepted as an alias"},
    {"key": "SIGNOZ_INGESTION_KEY", "secret": True, "required": False,
     "note": "Cloud-only telemetry ingestion key; omit for self-hosted"},
    {"key": "SIGNOZ_CUSTOM_HEADERS", "secret": True, "required": False,
     "note": "optional reverse-proxy headers as JSON object or K:V,K2:V2"},
]
WRITE_VERBS = {"api"}
WRITE_DEFAULT = False
DOCS_BASE = ("https://raw.githubusercontent.com/ai-cluster-one/capabilities/"
             "main/capabilities/signoz/guides/")
TOPICS = ["connections", "queries"]
STATE = False
POST_INSTALL: list[dict] = []

TIMEOUT = httpx.Timeout(60.0, connect=10.0)
MAX_RETRIES = 3

_CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
CREDENTIALS_ENV = _CONFIG_HOME / NAME / "credentials.env"
_STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state"))

