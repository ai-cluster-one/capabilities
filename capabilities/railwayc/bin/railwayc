#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "httpx>=0.27",
#     "capabilities-contract>=0.12,<1",
# ]
# ///
"""railwayc — a credential harness around the official `railway` CLI. It resolves a
PROJECT-SCOPED Railway token, injects it, and forwards your command verbatim to
`railway`. railwayc owns auth and readiness; the command surface stays railway's own.

USAGE
  railwayc <command> [args...]   Forward to `railway <command> [args...]`, authenticated
                                 with the resolved project token.
  railwayc connections           Where every connection's values resolve from
                                 (tier, source, secrets masked). Local only.
  railwayc doctor [--connection <id>]
                                 Prove the token resolves and report the project —
                                 every connection, or one — over both paths: the
                                 `railway` CLI and railwayc's own API call.
  railwayc backups [--connection <id>]
                                 Every volume instance in the token's project +
                                 environment with its backup schedules and its
                                 backups. railwayc's own API call, read-only.
  railwayc help                  Print this contract.

Contract commands (the same on every capability; railwayc's own, never forwarded):
  railwayc stub                                 One-line awareness text.
  railwayc manifest --json                      Machine-readable declaration.
  railwayc guide [<topic>]                      Guide topics / one guide body.
  railwayc ids list|get <l>|set <l> <v>|rm <l>  The project identifiers envelope
           [--note <text>]                      (capabilities/railwayc/identifiers.json,
                                                 or store rows once the agent moved).
  railwayc refs                                 Menu of the project's reference files.
  railwayc inventory [--network]                What this capability holds in
                                                this project (--network adds
                                                remote detail).

Agent-invoked. Run `railwayc help` to reload this contract; run `railway help` (the
real CLI) for the full command surface — railwayc does NOT re-document or re-map it.

MODEL
  railwayc is not a wrapper around railway's command surface — it never maps, renames,
  or enumerates railway commands. It is a thin auth shim: it puts a project token in
  front of `railway` and execs it. `railwayc logs -s web` runs `railway logs -s web`
  with RAILWAY_TOKEN set; stdout, stderr, and the exit code are railway's, passed
  through untouched, so streaming, --json, and colors behave exactly as in railway
  itself. Only `help`, `doctor`, `backups`, and the contract commands are railwayc's
  own; every other word forwards (`railwayc help <cmd>` forwards too, so railway's
  own help stays reachable).

  `backups` is the one domain verb railwayc answers itself: the railway CLI has no
  command for volume backups, so railwayc queries Railway's GraphQL API directly
  with the same project token, sent as the `Project-Access-Token` header. It is
  queries only — nothing railwayc calls itself can mutate the project.

  It REQUIRES a project token and never falls back to interactive login or this
  machine's account session — that refusal is the point: access stays scoped to the
  one Railway project + environment the token was minted for, never the whole account.

CONNECTIONS
  Configuration requires an explicit connections registry, even for one
  connection. Its RAILWAY_TOKEN is a Railway PROJECT token (project →
  Settings → Tokens), scoped to ONE project and ONE environment. Because it is
  project-scoped, its home is the CONSUMING PROJECT's .env, not a global file.
  Resolved (first non-empty wins):
    1. project env   .env.local then .env, walking up from $CLAUDE_PROJECT_DIR (else cwd)
    2. user config   $XDG_CONFIG_HOME/railwayc/credentials.env (default ~/.config/railwayc/)
    3. process env   RAILWAY_TOKEN (deployed box, or one-shot `RAILWAY_TOKEN=… railwayc …`)
  There is deliberately no token flag — a secret must not touch argv. A Railway
  PROJECT token is scoped to one project + one environment, so its natural home is
  the consuming project's .env (where install scaffolds it); doctor's expect_project
  check (exit 7) catches a token that points at the wrong project. One token = one
  project + one environment; a project with prod + staging uses one token per
  environment — and declares them as connections as
  connections, kept where "Where connections live" below says:
    {
      "default": "<id>",
      "connections": {
        "<id>": { "secret_env": "RAILWAY_<ID>_TOKEN",
                  "expect_project": "<project name or id>",
                  "allow_write": true }
      }
    }
  Which registry is read, and in what order, depends on the project: see
  "Where connections live" below.

  The entry names the env var holding its token ("secret_env"); the value
  resolves through the same cascade above. "expect_project" is the optional
  per-connection counterpart of RAILWAYC_EXPECT_PROJECT. "allow_write": false
  makes the connection read-only: every forwarded command that mutates the
  Railway project (up, down, redeploy, restart, add, deploy, domain,
  environment, init, service, scale, connect, ssh, shell, `variables --set`,
  and every `volume` subcommand except `volume list`) exits 4, and no flag
  lifts the gate. Reading what protects the project is not a write: `volume
  list` answers whether a volume exists and how full it is, which a read-only
  connection is exactly the right credential to ask. Writes default to allowed
  (a project the consumer owns).

  Selection: --connection <id> (accepted anywhere on the command line; consumed
  by railwayc, never forwarded). Unflagged, the registry's "default" pointer
  applies, else the sole entry; several entries without a pointer is refused
  as ambiguous.

  Outside any project, connections and doctor are machine reads: they use the
  machine's own connections read-only, unless a grant switched one off; every
  other verb that needs a connection is refused there.

  Optional, non-secret — RAILWAYC_EXPECT_PROJECT (project .env): if set, `doctor`
  asserts the token resolves to that project (by name or id) and exits 7 on mismatch.
  The safety net against pasting the wrong project's token into a project's .env.

COMMANDS railwayc owns
  connections
      The resolution report — every connection, every value, its winning tier
      and source, secrets masked. Local only: no network, no token use.

  doctor [--connection <id>]
      Per connection (every configured one bare; one with --connection): resolve
      its token and prove it over both paths railwayc uses. The CLI path runs
      `railway status --json` with the token injected and fills the top-level
      fields; the API path asks Railway's GraphQL API `{ projectToken {
      projectId environmentId } }` under the same token and fills `api`, so a
      reader can tell which of the two paths failed. Emits
      {ok, connections: {<id>: {project:{id,name}, workspace, environments:[…],
      services:[…], api:{ok, project_id, environment_id | error, hint}}}}; a
      failed CLI path carries `error` at the top level, a failed API path
      carries it under `api`. Exit 0 all healthy / 2 token missing or rejected on
      either path / 5 railway not installed, or either path unreachable / 7
      token resolved to a project other than the expected one. Use this for
      health — `railway whoami` does NOT work under a project token, and the
      API's `me` query is refused for every token class, so neither is asked.

  backups [--connection <id>]
      railwayc's own read of Railway's GraphQL API (not a forward): the token's
      project and environment (`projectToken`), the project's volumes, and for
      every volume instance in that environment its backup schedules
      (`volumeInstanceBackupScheduleList`) and its backups
      (`volumeInstanceBackupList`), as JSON:
      {connection, project_id, environment_id, volumes:[{id, name,
      instances:[{id, service_id, environment_id, schedules:[{id, name, kind,
      cron, retention_seconds, created_at}], backups:[{id, external_id, name,
      created_at, expires_at, schedule_id, creator_id, used_mb, referenced_mb,
      volume_instance_size_mb}]}]}]}. Instances in other environments are
      outside the token's scope and are not listed. A read: it runs on a
      connection with allow_write: false. Exit 0 / 2 the token is rejected or
      an id is outside its scope (Railway answers both as "Not Authorized" and
      never as not-found) / 5 network, timeout, rate-limited or 5xx after
      bounded retries / 6 a bad argument, or a query Railway's schema rejects.

  help
      Print this document. (`railway help` is the real CLI's surface, a separate
      thing; railwayc reserves a bare `help` for itself but forwards `help <cmd>`.)

EVERYTHING ELSE — forwarded verbatim to `railway`, token injected, I/O transparent.
  Run `railway <cmd> --help` for each; railwayc adds nothing to them. Common reaches:
    status [--json]                  project + services + deployment state
    logs [-s SVC] [-e ENV] [--json]  deploy / build logs
    variables [-s SVC] [--json]      read service variables
    variables --set "K=V" [-s SVC]   set a variable (triggers a deploy)
    redeploy [-s SVC]  /  restart    redeploy / restart the latest deployment
    up [-c]  /  down                 deploy from cwd / remove the latest deploy
    domain                           add / generate / list domains
    run -- <cmd>                     run a local command with the environment's vars

EXIT CODES (railwayc's own layer)
  0 success · 2 auth (token missing or rejected; for backups also an id outside
  the token's scope, which Railway reports identically) · 4 policy refusal — the
  project gate (capabilities/settings.json) on any verb, or a write verb on a
  read-only connection (allow_write: false); ask the user, never lift a gate
  yourself · 5 environment (railway not on PATH, or unreachable; for backups
  and doctor's API path a network error, timeout, rate limit or 5xx after
  bounded retries) · 6 input (bad use of a railwayc-owned command, an
  unknown/ambiguous connection, or a query Railway's schema rejects) · 7 wrong
  project (doctor: token ≠ the expected project). railwayc's own verbs never
  exit 3: Railway answers an unknown id as "Not Authorized" (2), not not-found.
  Forwarded commands return RAILWAY's own exit code, not these — railwayc is
  transparent for everything it forwards (after the gate).

EXAMPLES
  railwayc doctor
  railwayc backups
  railwayc backups --connection <id>
  railwayc status --json
  railwayc logs -s web --json
  railwayc variables -s web --json
  railwayc variables --set "FEATURE_X=1" -s web
  railwayc redeploy -s web
  RAILWAY_TOKEN=… railwayc status        # one-shot, run from outside a project .env
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import NoReturn

import httpx

# --- Capability declaration — one home for every contract fact ---------------

NAME = "railwayc"
SUMMARY = ("Credential harness around the official `railway` CLI — resolves "
           "a project-scoped Railway token, injects it, and forwards your "
           "command straight to `railway` (everything but railwayc's own "
           "verbs passes through untouched); the command surface is "
           "`railway help`.")
SCOPE = "project"   # credential scope: "project" | "user"
CRED_KEYS = [
    {"key": "RAILWAY_TOKEN", "secret": True, "required": True,
     "note": "project-scoped token; lives in the consuming project's .env"},
    {"key": "RAILWAYC_EXPECT_PROJECT", "secret": False, "required": False,
     "note": "doctor asserts the token resolves to this project (name or id)"},
]

# What a person is asked for (SHEBANG.md, "What a person is asked for"):
# a connection entry's own fields, which `connection add` writes.
CONN_FIELDS = [{'key': 'secret_env',
  'label': 'Project token',
  'help': 'A Railway project token, scoped to one project and one environment.',
  'type': 'string',
  'secret': True,
  'required': True,
  'env': 'RAILWAY_{ID}_TOKEN'},
 {'key': 'expect_project',
  'label': 'Expected project',
  'help': '`doctor` exits 7 when the token points at another project (name or id).',
  'type': 'string',
  'required': False}]
WRITE_VERBS = {     # forwarded railway commands that mutate the Railway project
    "up", "down", "redeploy", "restart", "add", "deploy", "domain",
    "environment", "init", "service", "scale", "connect",
    "ssh", "shell",
}   # `variables` and `volume` are gated by subcommand, not wholesale — see
    # deviations.md and READ_SUBCOMMANDS below.

# A verb that both reads and writes is gated on what it was asked to do. The
# listed subcommand reads; anything else under that verb is a write, so a
# subcommand this tool has not seen is refused rather than waved through.
READ_SUBCOMMANDS = {"volume": {"list"}}
# railwayc's own domain verbs that read the Railway API directly (never
# forwarded, never mutating). Membership here is what lets a verb run on a
# read-only connection; a native verb is declared a read, not assumed one.
READ_VERBS = {"backups"}
assert not (READ_VERBS & WRITE_VERBS), "a verb is a read or a write, never both"
WRITE_DEFAULT = True    # writes stay inside a project the consumer owns
MACHINE_READS = ("connections", "doctor")   # outside any project, read-only on the machine's connections
DOCS_BASE = ""      # upstream guides base URL; "" while no guides ship
STATE = False       # True when the capability writes session/cache state
INVENTORY = None     # or {"network": "none"|"optional"|"required"} with an _inventory(network) builder
POST_INSTALL: list = []

_CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
CREDENTIALS_ENV = _CONFIG_HOME / "railwayc" / "credentials.env"
_STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state"))

TOKEN_NAME = "RAILWAY_TOKEN"
EXPECT_PROJECT = "RAILWAYC_EXPECT_PROJECT"
DOCTOR_TIMEOUT = 60.0

# railwayc's own HTTP path: Railway's public GraphQL API, reached with the same
# project token the forwarded CLI gets, sent as the header a PROJECT token is
# accepted under (a project token under `Authorization: Bearer` is refused).
RAILWAY_GRAPHQL_URL = "https://backboard.railway.com/graphql/v2"
TOKEN_HEADER = "Project-Access-Token"
TIMEOUT = httpx.Timeout(60.0)
MAX_RETRIES = 3


# The shared capability code is the capabilities-contract library's, bound here
# into this script's namespace (SHEBANG.md, "The contract verbs").
from capabilities_contract.capability import bind as _contract_bind

_contract_bind(globals(), "core")

_contract_bind(globals(), "store")


_contract_bind(globals(), "connections")


# ── credentials (cascade: project .env(.local) → user config → process env) ──
# A secret omits the flag tier (it must not touch argv); a Railway project token
# is project-scoped, so install scaffolds it into the consuming project's .env.

# --- Connections (capability-specific) --------------------------------------

def _connections_report() -> dict:
    """The resolution report — every connection, every value, its winning tier
    and source, secrets masked. Local only: no network, no token use."""
    reg, _ = _connections_registry()
    report: dict = {"default": None, "connections": {}}
    if reg is None:
        keys = []
        for k in CRED_KEYS:
            value, tier, source = _resolve_env_key(k["key"])
            keys.append(_key_report(k["key"], k["secret"], k["required"],
                                    value, tier, source))
        report["default"] = "default"
        report["connections"]["default"] = {"allow_write": WRITE_DEFAULT, "keys": keys}
        return report
    conns = reg["connections"]
    report["default"] = reg.get("default") or \
        (next(iter(conns)) if len(conns) == 1 else None)
    for cid, entry in conns.items():
        entry = entry if isinstance(entry, dict) else {}
        origin = reg["sources"][cid]
        keys = []
        value = entry.get("expect_project")
        keys.append(_key_report("expect_project", False, False,
                                str(value) if value is not None else None,
                                "connection", origin))
        secret_env = entry.get("secret_env")
        if secret_env:
            value, tier, source = _resolve_env_key(secret_env)
            keys.append(_key_report(secret_env, True, True, value, tier, source))
        else:
            keys.append(_key_report("secret_env", False, True, None, None, None))
        report["connections"][cid] = {
            "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT)),
            "keys": keys}
    return report


def _cmd_connections() -> None:
    _emit(_connections_report())


def _build_cfg(cid: str, entry: dict | None) -> tuple[dict | None, dict | None]:
    """Materialize one connection. Returns (cfg, problem) — problem is an
    error dict ({"exit", "code", "message", "hint"?}) instead of a die, so
    doctor can report every connection rather than stopping at the first."""
    if entry is None:   # declared entry without overrides — use the flat-key cascade
        token = _resolve_env_key(TOKEN_NAME)[0]
        if not token:
            return None, {
                "exit": 2, "code": "missing_credentials",
                "message": f"{TOKEN_NAME} is required (a project-scoped Railway token)",
                "hint": f"set {TOKEN_NAME} in this project's .env(.local) or export it; "
                        f"create one in Railway → your project → Settings → Tokens"}
        return {"id": cid, "allow_write": WRITE_DEFAULT, "token": token,
                "expect": _resolve_env_key(EXPECT_PROJECT)[0]}, None
    secret_env = entry.get("secret_env")
    if not secret_env:
        return None, {"exit": 6, "code": "no_secret_env",
                      "message": f"connection {cid!r} is missing 'secret_env'"}
    token = _resolve_env_key(secret_env)[0]
    if not token:
        return None, {
            "exit": 2, "code": "missing_secret",
            "message": f"env var {secret_env} (for connection {cid!r}) is unset",
            "hint": f"set {secret_env} in the project's .env / .env.local "
                    f"or the environment"}
    return {"id": cid, "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT)),
            "token": token, "expect": entry.get("expect_project")}, None


# ── railway invocation ──────────────────────────────────────────────────────

def _child_env(token: str) -> dict:
    env = dict(os.environ)
    env[TOKEN_NAME] = token
    # railway errors if both token vars are set; the project token is authoritative here.
    env.pop("RAILWAY_API_TOKEN", None)
    return env


def _edges(obj) -> list:
    return obj.get("edges") or [] if isinstance(obj, dict) else []


# The one classification of "Railway rejected the token" for both paths.
# The CLI answers in prose on stderr; the API answers HTTP 200 with a GraphQL
# error whose message is "Project Token not found" for a bad token and
# "Not Authorized" for an id outside the token's scope (never a not-found of a
# resource). Both paths ask this so the same case cannot be classed two ways.
_AUTH_PHRASES = ("token", "unauthor", "not authorized", "not found",
                 "log in", "login")


def _rejected_token(text: str) -> bool:
    low = (text or "").lower()
    return any(s in low for s in _AUTH_PHRASES)


def _check_connection(cfg: dict) -> dict:
    """One connection's round-trip (`railway status --json` under its token),
    reported rather than died — doctor covers every connection, so a broken
    one becomes a finding, not a stop."""
    try:
        proc = subprocess.run(["railway", "status", "--json"],
                              env=_child_env(cfg["token"]),
                              capture_output=True, text=True, timeout=DOCTOR_TIMEOUT)
    except subprocess.TimeoutExpired:
        return {"ok": False, "category": 5,
                "error": "railway was unresponsive (status timed out)"}
    except OSError as e:
        return {"ok": False, "category": 5, "error": f"could not run railway: {e}"}
    if proc.returncode != 0:
        err = (proc.stderr or proc.stdout or "").strip()
        if _rejected_token(err):
            return {"ok": False, "category": 2,
                    "error": err or "railway rejected the token",
                    "hint": "the token is invalid, revoked, or for a deleted "
                            "project/environment"}
        return {"ok": False, "category": 5, "error": err or "`railway status` failed"}
    try:
        st = json.loads(proc.stdout)
    except ValueError:
        return {"ok": True, "note": "status returned non-JSON", "raw": proc.stdout[:500]}

    project = {"id": st.get("id"), "name": st.get("name")}
    result = {
        "ok": True,
        "project": project,
        "workspace": (st.get("workspace") or {}).get("name"),
        "environments": [e["node"]["name"] for e in _edges(st.get("environments"))
                         if e.get("node") and e["node"].get("name")],
        "services": [e["node"]["name"] for e in _edges(st.get("services"))
                     if e.get("node") and e["node"].get("name")],
    }
    expect = cfg.get("expect")
    if expect:
        if expect not in (project.get("name"), project.get("id")):
            return {"ok": False, "category": 7,
                    "error": f"token resolves to {project.get('name')!r} "
                             f"({project.get('id')}), expected {expect!r}",
                    "hint": "the token for this connection points at the wrong "
                            "Railway project; check the token and the expected project"}
        result["expected"] = expect
    return result


# ── railwayc's own API path (GraphQL, queries only) ─────────────────────────

# Every query railwayc sends. Field names are Railway's schema's, exactly; the
# set is closed so the read-only claim is checkable: a `mutation` never appears.
Q_PROJECT_TOKEN = "query { projectToken { projectId environmentId } }"
Q_VOLUMES = (
    "query ($id: String!) { project(id: $id) { volumes { edges { node { "
    "id name volumeInstances { edges { node { id serviceId environmentId } } } "
    "} } } } }")
Q_SCHEDULES = (
    "query ($id: String!) { volumeInstanceBackupScheduleList(volumeInstanceId: $id) "
    "{ id name kind cron retentionSeconds createdAt } }")
Q_BACKUPS = (
    "query ($id: String!) { volumeInstanceBackupList(volumeInstanceId: $id) "
    "{ id externalId name createdAt expiresAt scheduleId creatorId usedMB "
    "referencedMB volumeInstanceSizeMB } }")


def _graphql_errors(body) -> list[dict]:
    errs = body.get("errors") if isinstance(body, dict) else None
    return [e for e in errs if isinstance(e, dict)] if isinstance(errs, list) else []


def _error_codes(errs: list[dict]) -> set[str]:
    return {str((e.get("extensions") or {}).get("code") or "") for e in errs}


def _graphql_result(token: str, query: str, variables: dict | None = None
                    ) -> tuple[dict | None, dict | None]:
    """One query against Railway's API under the project token. Returns
    (data, problem) — problem is {"category", "code", "error", "hint"?,
    "status"?} rather than a die, so doctor can report it per connection.

    Transport failures follow the standard's resilient loop (bounded retries,
    429 honouring Retry-After, 5xx and timeouts backed off). The auth mapping
    keys on the GraphQL envelope and not only the HTTP status: Railway answers
    a rejected token as HTTP 200 with errors[].message "Project Token not
    found", and an id outside the token's scope (or an unknown id) as HTTP 200
    with "Not Authorized" — never as a not-found of a resource.
    """
    headers = {TOKEN_HEADER: token, "Content-Type": "application/json",
               "Accept": "application/json"}
    payload = {"query": query, "variables": variables or {}}
    resp = None
    try:
        with httpx.Client(timeout=TIMEOUT) as client:
            for attempt in range(1, MAX_RETRIES + 1):
                try:
                    resp = client.post(RAILWAY_GRAPHQL_URL, json=payload,
                                       headers=headers)
                except httpx.TimeoutException:
                    if attempt < MAX_RETRIES:
                        time.sleep(attempt * 1.5); continue
                    return None, {"category": 5, "code": "timeout",
                                  "error": "Railway API request timed out",
                                  "hint": "Railway was unresponsive"}
                if resp.status_code == 429:
                    retry_after = float(resp.headers.get("Retry-After",
                                                         str(attempt * 1.5)))
                    if attempt < MAX_RETRIES:
                        time.sleep(retry_after); continue
                    return None, {"category": 5, "code": "rate_limited",
                                  "error": "Railway API rate-limited the request",
                                  "status": 429}
                if resp.status_code >= 500:
                    if attempt < MAX_RETRIES:
                        time.sleep(attempt * 1.5); continue
                    return None, {"category": 5, "code": "server_error",
                                  "error": f"Railway API returned {resp.status_code}",
                                  "status": resp.status_code}
                break
    except httpx.RequestError as e:
        return None, {"category": 5, "code": "network_error",
                      "error": f"could not reach the Railway API: {e}",
                      "hint": "check connectivity"}
    if resp is None:
        return None, {"category": 5, "code": "protocol_error",
                      "error": "Railway API request completed without a response"}

    try:
        body = resp.json()
    except ValueError:
        body = None
    errs = _graphql_errors(body)
    codes = _error_codes(errs)
    messages = "; ".join(str(e.get("message") or "") for e in errs) or None
    not_authorized = any(_rejected_token(str(e.get("message") or ""))
                         for e in errs) or bool(codes & {"UNAUTHENTICATED",
                                                        "UNAUTHORIZED", "FORBIDDEN"})

    if resp.status_code in (401, 403) or not_authorized:
        return None, {"category": 2, "code": "auth_failed",
                      "error": messages or f"Railway API returned {resp.status_code}",
                      "hint": "the token is invalid, revoked, or for a deleted "
                              "project/environment — or an id lies outside the "
                              "project and environment this token is scoped to; "
                              "Railway reports both identically",
                      "status": resp.status_code}
    if resp.status_code == 404:
        return None, {"category": 3, "code": "not_found",
                      "error": "Railway API endpoint not found", "status": 404}
    if codes & {"GRAPHQL_VALIDATION_FAILED", "GRAPHQL_PARSE_FAILED", "BAD_USER_INPUT"} \
            or (400 <= resp.status_code < 500):
        return None, {"category": 6, "code": "invalid_query",
                      "error": messages or f"Railway API returned {resp.status_code}",
                      "hint": "the query does not match Railway's current schema",
                      "status": resp.status_code}
    if errs:
        return None, {"category": 5, "code": "graphql_error",
                      "error": messages, "status": resp.status_code}
    if not isinstance(body, dict) or not isinstance(body.get("data"), dict):
        return None, {"category": 5, "code": "protocol_error",
                      "error": "Railway API returned no data object",
                      "status": resp.status_code}
    return body["data"], None


def _graphql(token: str, query: str, variables: dict | None = None) -> dict:
    data, problem = _graphql_result(token, query, variables)
    if problem:
        _die(problem["category"], problem["code"], problem["error"],
             problem.get("hint"), problem.get("status"))
    return data


def _check_api(cfg: dict) -> dict:
    """doctor's second probe: the API path under the same token, reported."""
    data, problem = _graphql_result(cfg["token"], Q_PROJECT_TOKEN)
    if problem:
        res = {"ok": False, "category": problem["category"],
               "error": problem["error"]}
        if problem.get("hint"):
            res["hint"] = problem["hint"]
        return res
    tok = data.get("projectToken") or {}
    return {"ok": True, "project_id": tok.get("projectId"),
            "environment_id": tok.get("environmentId")}


def _schedule_row(n: dict) -> dict:
    return {"id": n.get("id"), "name": n.get("name"), "kind": n.get("kind"),
            "cron": n.get("cron"), "retention_seconds": n.get("retentionSeconds"),
            "created_at": n.get("createdAt")}


def _backup_row(n: dict) -> dict:
    return {"id": n.get("id"), "external_id": n.get("externalId"),
            "name": n.get("name"), "created_at": n.get("createdAt"),
            "expires_at": n.get("expiresAt"), "schedule_id": n.get("scheduleId"),
            "creator_id": n.get("creatorId"), "used_mb": n.get("usedMB"),
            "referenced_mb": n.get("referencedMB"),
            "volume_instance_size_mb": n.get("volumeInstanceSizeMB")}


def cmd_backups(cid: str, cfg: dict, args: list[str]) -> None:
    """Every volume instance in the token's project + environment, with its
    backup schedules and backups. Queries only; runs on a read-only connection."""
    if args:
        _die(6, "bad_usage", f"backups takes no arguments (got {' '.join(args)!r})",
             "`railwayc backups [--connection <id>]`")
    token = cfg["token"]
    scope = _graphql(token, Q_PROJECT_TOKEN).get("projectToken") or {}
    project_id, env_id = scope.get("projectId"), scope.get("environmentId")
    if not project_id or not env_id:
        _die(5, "protocol_error", "Railway did not report the token's project "
             "and environment")
    project = _graphql(token, Q_VOLUMES, {"id": project_id}).get("project") or {}
    volumes = []
    for ve in _edges(project.get("volumes")):
        vol = ve.get("node") or {}
        instances = []
        for ie in _edges(vol.get("volumeInstances")):
            inst = ie.get("node") or {}
            if inst.get("environmentId") != env_id:
                continue   # another environment: outside this token's scope
            iid = inst.get("id")
            schedules = _graphql(token, Q_SCHEDULES, {"id": iid}) \
                .get("volumeInstanceBackupScheduleList") or []
            backups = _graphql(token, Q_BACKUPS, {"id": iid}) \
                .get("volumeInstanceBackupList") or []
            instances.append({
                "id": iid, "service_id": inst.get("serviceId"),
                "environment_id": inst.get("environmentId"),
                "schedules": [_schedule_row(x) for x in schedules if isinstance(x, dict)],
                "backups": [_backup_row(x) for x in backups if isinstance(x, dict)]})
        volumes.append({"id": vol.get("id"), "name": vol.get("name"),
                        "instances": instances})
    _emit({"connection": cid, "project_id": project_id, "environment_id": env_id,
           "volumes": volumes})


def cmd_doctor(reg: dict | None, wanted: str | None) -> None:
    """Every connection bare; one with --connection. Exit 0 only when every
    examined connection is healthy on both paths, else the first failure's
    category. The CLI path fills the top-level fields; the API path is `api`."""
    _doctor_gate(_connections_report(), wanted)
    if wanted is not None or reg is None:
        targets = [_select_connection(reg, wanted)]
    else:
        targets = list(reg["connections"].items())
    connections: dict = {}
    fail_exit = 0
    for cid, entry in targets:
        cfg, problem = _build_cfg(cid, entry)
        if problem:
            res = {"ok": False, "category": problem["exit"],
                   "error": problem["message"]}
            if problem.get("hint"):
                res["hint"] = problem["hint"]
        else:
            res = _check_connection(cfg)
            api = _check_api(cfg)
            if not res.get("ok") and not fail_exit:
                fail_exit = res.get("category") or 5
            if not api.get("ok") and not fail_exit:
                fail_exit = api.get("category") or 5
            api.pop("category", None)
            res["api"] = api
            res["ok"] = bool(res.get("ok")) and bool(api.get("ok"))
        if not res.get("ok") and not fail_exit:
            fail_exit = res.get("category") or 5
        res.pop("category", None)
        connections[cid] = res
    _emit({"ok": fail_exit == 0, "connections": connections})
    if fail_exit:
        sys.exit(fail_exit)


def _forward(argv: list[str], token: str) -> NoReturn:
    # Inherit stdio so streaming, prompts, --json, and colors pass straight through;
    # railway's own exit code is the result.
    try:
        proc = subprocess.run(["railway", *argv], env=_child_env(token))
    except OSError as e:
        _die(5, "railway_exec_failed", f"could not run railway: {e}")
    sys.exit(proc.returncode)


# ── dispatch ────────────────────────────────────────────────────────────────

def main() -> None:
    _gate()                      # every verb passes the effective policy gate first

    # `--connection <id>` is railwayc's own selector, accepted anywhere on the
    # line, consumed here and never forwarded to `railway`.
    argv = sys.argv[1:]
    wanted_conn: str | None = None
    cleaned: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--connection" and i + 1 < len(argv):
            wanted_conn = argv[i + 1]; i += 2; continue
        if a.startswith("--connection="):
            wanted_conn = a.split("=", 1)[1]; i += 1; continue
        cleaned.append(a); i += 1

    _contract(cleaned)           # contract verbs; everything else forwards
    if not cleaned or (len(cleaned) == 1 and cleaned[0] in ("help", "-h", "--help")):
        sys.stdout.write((__doc__ or "").lstrip("\n"))
        return

    reg, _ = _connections_registry()
    if cleaned[0] == "doctor":
        cmd_doctor(reg, wanted_conn)     # railway-absence is reported per connection
        return

    # Select and gate BEFORE resolving the token or touching `railway`, so a
    # write verb on a read-only connection refuses (exit 4) and an unknown id
    # refuses (exit 6) regardless of whether the token resolves or railway is
    # installed (the gate is policy, decided before any credential or exec).
    cid, entry = _select_connection(reg, wanted_conn)
    verb = cleaned[0]
    allow_write = WRITE_DEFAULT if entry is None else \
        bool(entry.get("allow_write", WRITE_DEFAULT))
    _write_gate(cid, allow_write, verb)
    if verb in READ_SUBCOMMANDS and not allow_write:
        sub = next((a for a in cleaned[1:] if not a.startswith("-")), None)
        if sub not in READ_SUBCOMMANDS[verb]:
            _read_only_gate(f"`{verb} {sub}`" if sub else f"`{verb}`")
            _die(4, "read_only",
                 f"connection {cid!r} does not allow writes; `{verb} "
                 f"{sub or ''}`".rstrip() + " mutates the project",
                 f"`{verb} " + "`, `".join(sorted(READ_SUBCOMMANDS[verb]))
                 + "` reads, or ask the user; granting is `allow_write: true` "
                   "on this connection in connections.json.")
    if verb == "variables" and "--set" in cleaned and not allow_write:
        _read_only_gate("`variables --set`")
        _die(4, "read_only",
             f"connection {cid!r} does not allow writes; `variables --set` "
             f"mutates the project",
             "drop --set, or ask the user; granting is `allow_write: true` on "
             "this connection in connections.json.")

    cfg, problem = _build_cfg(cid, entry)
    if problem:
        _die(problem["exit"], problem["code"], problem["message"],
             problem.get("hint"))

    if verb in READ_VERBS:       # railwayc's own API read; needs no `railway`
        cmd_backups(cid, cfg, cleaned[1:])
        return

    if not shutil.which("railway"):
        _die(5, "railway_not_found", "the `railway` CLI is not on PATH",
             "install it: `brew install railway` or `npm i -g @railway/cli` "
             "(https://docs.railway.com/cli)")

    _forward(cleaned, cfg["token"])


if __name__ == "__main__":
    main()
